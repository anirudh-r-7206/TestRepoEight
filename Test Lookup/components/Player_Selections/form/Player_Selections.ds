form Player_Selections
{
    Selection_Details
    (
        type = section
        displayname = "Player Selection"
        row = 1
        column = 0
    )
    must have Player
    (
        type = picklist
        values = Players.ID
        displayformat = [Player_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
