form Players
{
    Player_Details
    (
        type = section
        displayname = "Player Details"
        row = 1
        column = 0
    )
    must have unique Player_ID
    (
        type = text
        displayname = "Player ID"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
