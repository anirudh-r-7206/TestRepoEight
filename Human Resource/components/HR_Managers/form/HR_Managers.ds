form HR_Managers
{
    displayname = "HR Managers"

    Manager_Details
    (
        type = section
        displayname = "Manager Details"
        row = 1
        column = 0
    )
    must have Name
    (
        type = text
        personal data = true
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Age
    (
        type = number
        maxchar = 3
        row = 1
        column = 1
        width = medium
    )
    must have Gender
    (
        type = radiobuttons
        personal data = true
        values = {"Male", "Female", "Non-binary", "Prefer not to say"}
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
