application "Human-Resource"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form HR_Managers
		{
		    displayname = "HR Managers"
		
		    Manager_Details
		    (
		        type = section
		        displayname = "Manager Details"
		        row = 1
		        column = 0
		    )
		    must have Name
		    (
		        type = text
		        personal data = true
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Age
		    (
		        type = number
		        maxchar = 3
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Gender
		    (
		        type = radiobuttons
		        personal data = true
		        values = {"Male", "Female", "Non-binary", "Prefer not to say"}
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_HR_Managers
		{
		    displayName = "All HR Managers"
		    show all rows from HR_Managers
		    (
		        Name
		        Age
		        Gender
		    )
		    filters
		    (
		        Gender
		    )
		    sort by
		    (
		        Name ascending
		    )
		}
	}

	customize
	{
	    new theme = 11
	    new theme color = 1
	    font = "lato"
	
	    color options
	    {
	        color = "1"
	    }
	
	    icon
	    {
	        icon = "zc-ab-hr-mgmt1"
	        background color = "#16A263"
	        foreground color = "#ffffff"
	    }
	
	    logo
	    {
	        preference = "none"
	        placement = "left"
	    }
	}

	web
	{
	forms
	{
	    form HR_Managers
	    {
	        label placement = left
	    }
	}
	reports
	{
		report All_HR_Managers
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Name
		                    Age
		                    Gender
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Name
		                    Age
		                    Gender
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	}
	menu
	{
	    space HR_Space
	    {
	        displayname = "HR"
	        icon = "users-multiple-11"
	
	        section HR_Management
	        {
	            displayname = "HR Management"
	            icon = "business-hierarchy-56"
	
	            form HR_Managers
	            {
	                icon = "business-business-contact-89"
	            }
	            report All_HR_Managers
	            {
	                icon = "business-chart-bar-33"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_11"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        color = "1"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	}
	}
}
