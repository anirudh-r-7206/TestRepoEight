application "Widget-Four"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Students
		{
		    title
		    {
		        displayname = "Students"
		        on add = "Add Student"
		        on edit = "Edit Student"
		    }
		    success message = "Student saved successfully."
		
		    Student_Details
		    (
		        type = section
		        displayname = "Student Details"
		        row = 1
		        column = 0
		    )
		    must have Student_Name
		    (
		        type = text
		        displayname = "Student Name"
		        personal data = true
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Age
		    (
		        type = number
		        displayname = "Age"
		        maxchar = 3
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Students
		{
		    displayName = "All Students"
		    show all rows from Students
		    (
		        Student_Name
		        Age
		    )
		    sort by
		    (
		        Student_Name ascending
		    )
		}
	}

	pages
	{
		page Alphabet_Learning
		{
					displayname = "Alphabet Learning"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<widgets elementName='Alphabet Explorer' importedTemplate='false' heightType='custom' heightValue='760px' linkName='AlphabetExplorer' bgColor='#FFF9E8'/>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	customize
	{
	    icon
	    {
	        icon = "zc-ab-education-1"
	        background color = "#FC5A40"
	        foreground color = "#ffffff"
	    }
	}

	web
	{
	forms
	{
	    form Students
	    {
	        label placement = left
	    }
	}
	reports
	{
		report All_Students
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Student_Name
		                    Age
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Student_Name
		                    Age
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	}
	menu
	{
	    space Learning_Space
	    {
	        displayname = "Learning"
	        icon = "education-school"
	
	        section Education_Section
	        {
	            displayname = "Education"
	            icon = "education-book-open"
	
	            form Students
	            {
	                icon = "users-single-body"
	            }
	            report All_Students
	            {
	                icon = "users-multiple-11"
	            }
	            page Alphabet_Learning
	            {
	                icon = "education-abc"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "education-books-46"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	    }
	
	    font = "nunito"
	
	    color options
	    {
	        color = "1"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	}
	}
}
