application "Sample-App-ery-Old"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Students
		{
		    title
		    {
		        displayname = "Students"
		        on add = "Add Student"
		        on edit = "Edit Student"
		    }
		
		    Student_Information
		    (
		        type = section
		        displayname = "Student Information"
		        row = 1
		        column = 0
		    )
		    must have Student_Name
		    (
		        type = text
		        displayname = "Student Name"
		        maxchar = 100
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Age
		    (
		        type = number
		        maxchar = 3
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Gender
		    (
		        type = radiobuttons
		        values = {"Female", "Male", "Non-binary", "Prefer not to say"}
		        layout = 2
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Students
		{
		    displayName = "All Students"
		    show all rows from Students
		    (
		        Student_Name
		        Age
		        Gender
		    )
		    filters
		    (
		        Gender
		        Age
		    )
		    sort by
		    (
		        Student_Name ascending
		    )
		}
	}

	customize
	{
	    new theme color = 5
	
	    icon
	    {
	        icon = "zc-ab-education-1"
	        background color = "#0093FF"
	        foreground color = "#ffffff"
	    }
	}

	web
	{
	forms
	{
	    form Students
	    {
	        label placement = left
	    }
	}
	reports
	{
		report All_Students
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Student_Name
		                    Age
		                    Gender
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Student_Name
		                    Age
		                    Gender
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	}
	menu
	{
	    space Student_Records
	    {
	        displayname = "Student Records"
	        icon = "education-school"
	
	        section Student_Directory
	        {
	            displayname = "Student Directory"
	            icon = "education-books-46"
	
	            form Students
	            {
	                icon = "education-pencil-47"
	            }
	            report All_Students
	            {
	                icon = "education-notepad"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    font = "poppins"
	
	    color options
	    {
	        color = "5"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	}
	}
}
