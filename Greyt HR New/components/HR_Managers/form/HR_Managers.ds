form HR_Managers
{
    title
    {
        displayname = "HR Managers"
        on add = "Add HR Manager"
        on edit = "Edit HR Manager"
    }
    success message = "HR manager saved successfully."

    Manager_Details
    (
        type = section
        displayname = "Manager Details"
        row = 1
        column = 0
    )
    must have Manager_Name
    (
        type = text
        displayname = "Manager Name"
        maxchar = 150
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have unique Email_ID
    (
        type = email
        displayname = "Email ID"
        personal data = true
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
