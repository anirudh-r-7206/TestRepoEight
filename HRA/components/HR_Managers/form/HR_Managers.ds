form HR_Managers
{
    title
    {
        displayname = "HR Managers"
        on add = "Add HR Manager"
        on edit = "Edit HR Manager"
    }

    Manager_Details
    (
        type = section
        displayname = "Manager Details"
        row = 1
        column = 0
    )
    must have Manager_Name
    (
        type = text
        displayname = "Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Age
    (
        type = number
        displayname = "Age"
        maxchar = 3
        personal data = true
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
