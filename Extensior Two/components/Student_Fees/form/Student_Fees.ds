form Student_Fees
{
    displayname = "Student Fees"
    success message = "Student fee record saved successfully."

    Fee_Details
    (
        type = section
        displayname = "Student Fee Details"
        row = 1
        column = 0
    )
    must have Student_Name
    (
        type = text
        displayname = "Student Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Age
    (
        type = number
        displayname = "Age"
        maxchar = 3
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = radiobuttons
        displayname = "Fee Status"
        values = {"Paid", "Not Paid"}
        initial value = "Not Paid"
        layout = 2
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}