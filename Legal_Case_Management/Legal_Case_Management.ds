low: ellipsis; white-space: nowrap; } /* Text Decoration */ .zcs-underline { text-decoration-line: underline; } .zcs-overline { text-decoration-line: overline; } .zcs-line-through { text-decoration-line: line-through; } .zcs-no-underline { text-decoration-line: none; } /* Word Break */ .zcs-break-normal { overflow-wrap: normal; word-break: normal; } .zcs-break-words { overflow-wrap: break-word; } .zcs-break-all { word-break: break-all; } /* Border Radius */ .zcs-rounded-none { border-radius: 0rem; } .zcs-rounded-xs { border-radius: 0.125rem; /* 2px */ } .zcs-rounded-sm { border-radius: 0.25rem; /* 4px */ } .zcs-rounded-md { border-radius: 0.375rem; /* 6px */ } .zcs-rounded-lg { border-radius: 0.5rem; /* 8px */ } .zcs-rounded-xl { border-radius: 0.75rem; /* 12px */ } .zcs-rounded-2xl { border-radius: 1rem; /* 16px */ } .zcs-rounded-half { border-radius: 50%; /* 50% */ } .zcs-rounded-full { border-radius: 100%; /* 100% */ } .zcs-rounded-inherit { border-radius: inherit; } /* Text Alignment (Horizontal) */ .zcs-text-left { text-align: left; } .zcs-text-center { text-align: center; } .zcs-text-right { text-align: right; } .zcs-text-justify { text-align: justify; } /* Text Vertical Alignment (for inline elements) */ .zcs-text-top { vertical-align: top; } .zcs-text-middle { vertical-align: middle; } .zcs-text-bottom { vertical-align: bottom; } .zcs-text-baseline { vertical-align: baseline; } /* Box-sizing */ .zcs-box-border { box-sizing: border-box; } .zcs-box-content { box-sizing: content-box; } /* Cursor Properties */ .zcs-cursor-auto { cursor: auto; } .zcs-cursor-default { cursor: default; } .zcs-cursor-pointer { cursor: pointer; } .zcs-cursor-move { cursor: move; } .zcs-cursor-not-allowed { cursor: not-allowed; } /* Position Properties */ .zcs-static { position: static; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; } .zcs-fixed { position: fixed; } .zcs-sticky { position: sticky; } /* Color Classes */ .zcs-color-theme { color: var(--zcs_b