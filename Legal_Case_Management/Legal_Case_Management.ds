		{
					displayname = "Detail_View_Page"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet1' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet1()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n\t* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t}\n\t:root {\n\t\t--theme-clr: #e6000e;\n\t\t--bgclr: #ffffff;\n\t\t--secondary-clr: #000000;\n\t\t--stoke-clr:#ebebeb;\n\t}\n\t.zc-content-loader div {\n\t display: none !important;\n\t}\n\tdiv#zppagesLive,\n\tdiv#elementsContainer,\n\t.Layout.elemContainment,\n\tdiv#row_1,\n\t.zc-pb-formreport-placeholder {\n\t\theight: 100% !important;\n\t}\n\tdiv::-webkit-scrollbar \n\t{\n\t\tdisplay: none;\n\t}\n\tdiv\n\t{\n\t\t-ms-overflow-style: none;  \n\t\tscrollbar-width: none;  \n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n\t.zc-pb-page-content-wrapper .elemContainment {\n\t\t padding: unset !important; \n\t}\n\t.column-container .zc-pb-tile-container {\n\t\t padding: unset !important; \n\t}\n\t.zpcontent-wrapper div.zpelement-wrapper {\n\t\theight: 100% !important;\n\t}\n\t.zpcontent-wrapper div.zpelement-wrapper {\n\t\theight: 100% !important;\n\t}\n\t.zc_live_adminbar .zc-container-wrapper\n\t{\n\t\theight:100% !important;\n\t}\n\t.zc-pb-tile-card::-webkit-scrollbar {\n\t\tdisplay: none !important;\n\t}\n\t.popupbox {\n\t\twidth: 90%;\n\t\theight: 80%;\n\t}\n\t.detailMainDiv {\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tdisplay: flex;\n\t}\n\t.noDetailDiv {\n\t\tdisplay: flex;\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t\tfont-size: 14px;\n\t\tfont-weight: 600;\n\t\tcolor: #626262;\n\t}\n\t.fa-question-circle:before {\n\t\tdisplay: none !important;\n\t}\n\t.confirmMsg {\n\t\tpadding: unset !important;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 10px;\n\t\talign-items: center;\n\t}\n\t.confirmMsg i.fa-question-circle {\n\t\tbackground: url(&quot;https://static.zohocdn.com/creator/app/images/modern-theme-sprite.28e891f10dc0555a20482177e1b8a9e7.svg&quot;) no-repeat;\n\t\tbackground-position: -9px -1660px;\n\t\twidth: 100px;\n\t\theight: 100px;\n\t\tmargin: 0 auto 8px;\n\t}\n\t.confirmMsg #zc-dialog-label {\n\t\tmargin: unset !important;\n\t\tpadding: unset;\n\t}\n\t.detailIframe {\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tborder: 1px solid #e7e7ee !important;\n\t\tborder-radius: 16px;\n\t\toverflow: hidden;\n\t}\n&lt;/style&gt;\n&lt;div class=&quot;detailMainDiv&quot;&gt;\n&lt;%\n\tif(input.reportName != &quot;&quot; &amp;&amp; input.recID != null)\n\t{\n\t\t%&gt;\n&lt;iframe class=&quot;detailIframe&quot; src=&apos;&lt;%=zoho.appuri%&gt;record-summary/&lt;%=input.reportName%&gt;/&lt;%=input.recID%&gt;/&apos; &gt;&lt;/iframe&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;noDetailDiv&quot;&gt;\n\t&lt;div class=&quot;confirmMsg&quot;&gt;\n\t\t&lt;i class=&quot;fa fa-question-circle&quot;&gt;&lt;/i&gt;\t\n\t\t&lt;p id=&quot;zc-dialog-label&quot;&gt;No Details&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Legal_Dashboard
		{
					displayname = "Legal Dashboard"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Legal_Dashboard_Main' elementName='Legal_Dashboard_Main' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage Legal_Dashboard_Main()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tactiveCases = Create_Case[Case_Status != &quot;Closed&quot; &amp;&amp; Case_Status != &quot;Archived&quot; &amp;&amp; Case_Status != &quot;Rejected&quot;];\n\topenMatterCount = activeCases.count();\n\tnewIntakeCount = Create_Case[Case_Status == &quot;New Intake&quot;].count();\n\tpendingConflictCount = Add_Conflict_Check[Decision == &quot;Pending&quot;].count();\n\tupcomingHearingCount = Add_Hearing[Hearing_DateTime &gt;= zoho.currenttime &amp;&amp; (Hearing_Status == &quot;Scheduled&quot; || Hearing_Status == &quot;Prepared&quot;)].count();\n\turgentDeadlineCount = Add_Deadline[(Deadline_Status == &quot;Open&quot; || Deadline_Status == &quot;Extended&quot;) &amp;&amp; Deadline_Date &gt;= zoho.currentdate &amp;&amp; (Deadline_Date &lt;= zoho.currentdate.addDay(7) || Priority == &quot;Critical&quot;)].count();\n\toverdueTaskCount = Add_Case_Task[Task_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Cancelled&quot;)].count();\n\tunbilledApprovedTime = Add_Time_Entry[Billable == true &amp;&amp; Approval_Status == &quot;Approved&quot; &amp;&amp; Invoice is null].sum(Amount);\n\tif(unbilledApprovedTime == null)\n\t{\n\t\tunbilledApprovedTime = 0;\n\t}\n\tunbilledApprovedExpenses = Add_Expense_Entry[Billable == true &amp;&amp; Approval_Status == &quot;Approved&quot; &amp;&amp; Invoice is null].sum(Amount);\n\tif(unbilledApprovedExpenses == null)\n\t{\n\t\tunbilledApprovedExpenses = 0;\n\t}\n\toverdueInvoiceCount = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)].count();\n\toverdueInvoiceBalance = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)].sum(Balance_Due);\n\tif(overdueInvoiceBalance == null)\n\t{\n\t\toverdueInvoiceBalance = 0;\n\t}\n\trecentMatters = Create_Case[Case_Status != &quot;Closed&quot; &amp;&amp; Case_Status != &quot;Archived&quot; &amp;&amp; Case_Status != &quot;Rejected&quot;] sort by Added_Time desc range from 1 to 8;\n\thearingRows = Add_Hearing[Hearing_DateTime &gt;= zoho.currenttime &amp;&amp; (Hearing_Status == &quot;Scheduled&quot; || Hearing_Status == &quot;Prepared&quot;)] sort by Hearing_DateTime asc range from 1 to 8;\n\tdeadlineRows = Add_Deadline[(Deadline_Status == &quot;Open&quot; || Deadline_Status == &quot;Extended&quot;) &amp;&amp; Deadline_Date &gt;= zoho.currentdate &amp;&amp; (Deadline_Date &lt;= zoho.currentdate.addDay(7) || Priority == &quot;Critical&quot;)] sort by Deadline_Date asc range from 1 to 8;\n\ttaskRows = Add_Case_Task[Task_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Cancelled&quot;)] sort by Due_Date asc range from 1 to 8;\n\tinvoiceRows = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)] sort by Due_Date asc range from 1 to 8;\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility subset included once for this page ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);\n\t--zcs_brand_color: #6147E5;\n\t--zcs_brand_foreground_color: #FFFFFF;\n\t--zcs_brand_dark_color: #4E38C8;\n\t--zcs_brand_light_color: #F1EEFF;\n\t--zcs_primary_text_color: #17142F;\n\t--zcs_secondary_text_color: #4F5873;\n\t--zcs_tertiary_text_color: #7A8094;\n\t--zcs_tertiary_border_color: #E7E8F0;\n\t--zcs_primary_border_color: #E0E2EA;\n\t--zcs_component_hover_color: #F4F1FF;\n\t--zcs_light_grey_color: #F7F8FC;\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-page-bg-color: #F6F7FB;\n\t--ld-primary: #6147E5;\n\t--ld-primary-dark: #4E38C8;\n\t--ld-bg: #F6F7FB;\n\t--ld-surface: #FFFFFF;\n\t--ld-border: #E7E8F0;\n\t--ld-text: #17142F;\n\t--ld-muted: #6B7280;\n\t--ld-soft: #F1EEFF;\n\t--ld-success: #179E6C;\n\t--ld-warning: #B8770D;\n\t--ld-danger: #D92D20;\n\t--ld-info: #2A6FFC;\n\t--ld-gap: 15px;\n\t--ld-radius: 12px;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n\n/* ===== ZCS component CSS: button-primary-button-no-icon ===== */\n.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-text{white-space:nowrap}\n/* ===== ZCS component CSS: badge-outlined-badge ===== */\n.zcs-badge{width:auto}.zcs-badge-outline{border:1px solid}.zcs-badge-outline.zcs-badge-theme{color:var(--zcs_brand_color)}.zcs-badge-outline.zcs-badge-green{color:#179E6C}.zcs-badge-outline.zcs-badge-red{color:#FE455D}.zcs-badge-outline.zcs-badge-yellow{color:#B8770D}.zcs-badge-outline.zcs-badge-blue{color:#2A6FFC}.zcs-badge-outline.zcs-badge-grey{color:#242424}.zcs-badge-outline.zcs-badge-orange{color:#F4660C}\n/* ===== ZCS component CSS: table-simple-table ===== */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table thead tr th.zcs-green,.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table thead tr th.zcs-red,.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#FE455D}.zcs-table-wrapper table thead tr th.zcs-yellow,.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table thead tr th.zcs-blue,.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}.zcs-table-wrapper table thead tr th.zcs-l_blue,.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-l_blue{color:#1094C5}\n/* ===== ZCS layout-dashboard panel subset ===== */\n.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px 0 #F2F2F6;background-color:var(--zcs-white-color)}.zcs-panel-icon-wrapper{width:40px;height:40px}.zcs-panel-icon{width:24px;height:24px;line-height:24px}.zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper{background-color:#E4FCF3;color:#179E6C}.zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper{background-color:#FCF4E6;color:#B8770D}.zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper{background-color:#FDE3E6;color:#FE455D}.zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper{background-color:#EAF2FF;color:#1652BB}.zcs-panel.zcs-panel-l_blue .zcs-panel-icon-wrapper{background-color:#E8EFFF;color:#2A6FFC}.zcs-panel.zcs-panel-violet .zcs-panel-icon-wrapper{background-color:#F1EEFF;color:#6147E5}.zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper{background-color:#FFF3E8;color:#F4660C}.zcs-panel.zcs-panel-grey .zcs-panel-icon-wrapper{background-color:#F5F8FA;color:#092441}\n\n/* ===== Legal Dashboard approved CSS block ===== */\n*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}.legal-dashboard{width:100%;min-height:100%;background:var(--ld-bg);color:var(--ld-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--ld-gap);overflow:auto}.ld-shell{display:flex;flex-direction:column;gap:var(--ld-gap);max-width:1600px;margin:0 auto}.ld-header{display:flex;justify-content:space-between;align-items:center;gap:var(--ld-gap);padding:15px;border:1px solid var(--ld-border);border-radius:var(--ld-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.ld-title-block{min-width:0}.ld-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ld-primary);margin:0 0 4px}.ld-title{font-size:22px;line-height:1.2;font-weight:700;color:var(--ld-text);margin:0}.ld-subtitle{margin:6px 0 0;color:var(--ld-muted)}.ld-action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end}.ld-action-row .zcs-button{border-radius:8px;background:var(--ld-primary);color:#fff}.ld-kpi-grid{display:grid;grid-template-columns:repeat(8,minmax(140px,1fr));gap:var(--ld-gap)}.ld-kpi{min-height:108px;padding:15px;border-radius:var(--ld-radius)}.ld-kpi-label{font-size:12px;color:var(--ld-muted);font-weight:600;text-transform:uppercase;letter-spacing:.02em;margin:0}.ld-kpi-value{font-size:24px;line-height:1.1;font-weight:700;color:var(--ld-text);margin:8px 0 0;word-break:break-word}.ld-kpi-note{font-size:12px;color:var(--ld-muted);margin:6px 0 0}.ld-section-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--ld-gap);align-items:start}.ld-section{grid-column:span 6;background:var(--ld-surface);border:1px solid var(--ld-border);border-radius:var(--ld-radius);overflow:hidden;min-height:390px;display:flex;flex-direction:column}.ld-section.ld-wide{grid-column:span 12}.ld-section-header{display:flex;justify-content:space-between;align-items:center;gap:var(--ld-gap);padding:15px;border-bottom:1px solid var(--ld-border);background:#fff}.ld-section-title{display:flex;flex-direction:column;gap:2px;min-width:0}.ld-section-title h2{font-size:16px;line-height:1.25;font-weight:700;color:var(--ld-text);margin:0}.ld-section-title p{font-size:12px;color:var(--ld-muted);margin:0}.ld-section-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.ld-section-actions .zcs-button{min-height:32px;padding-top:6px;padding-bottom:6px;border-radius:8px}.ld-scroll{height:285px;overflow:auto;padding:15px}.ld-table{min-width:760px}.ld-table.compact{min-width:640px}.ld-table .ld-main{font-weight:600;color:var(--ld-text)}.ld-table .ld-sub{font-size:12px;color:var(--ld-muted);margin-top:2px}.ld-status-pill{font-size:12px;font-weight:600;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:180px}.ld-status-primary{background:#F1EEFF;color:var(--ld-primary)}.ld-status-success{background:#E4FCF3;color:var(--ld-success)}.ld-status-warning{background:#FCF4E6;color:var(--ld-warning)}.ld-status-danger{background:#FDE3E6;color:var(--ld-danger)}.ld-status-info{background:#E8EFFF;color:var(--ld-info)}.ld-billing-grid{display:grid;grid-template-columns:260px 1fr;gap:var(--ld-gap);height:100%}.ld-billing-summary{display:flex;flex-direction:column;gap:var(--ld-gap)}.ld-mini-card{border:1px solid var(--ld-border);border-radius:var(--ld-radius);padding:15px;background:#fff}.ld-mini-card label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--ld-muted);margin-bottom:6px}.ld-mini-card strong{display:block;font-size:20px;line-height:1.2;color:var(--ld-text);word-break:break-word}.ld-mini-card span{display:block;font-size:12px;color:var(--ld-muted);margin-top:5px}.zcs-nodata-wrapper{min-height:180px;border:1px dashed var(--ld-border);border-radius:var(--ld-radius);background:#FCFCFF}.zcs-nodata-header{font-size:15px}.ld-empty-text{color:var(--ld-muted);margin:6px 0 0}.ld-mobile-card-list{display:none}.ld-mobile-card{border:1px solid var(--ld-border);border-radius:var(--ld-radius);padding:12px;background:#fff;margin-bottom:10px}.ld-mobile-card:last-child{margin-bottom:0}.ld-mobile-card-title{font-weight:700;margin:0 0 4px;color:var(--ld-text)}.ld-mobile-card-line{font-size:12px;color:var(--ld-muted);margin:2px 0}.ld-mobile-card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1400px){.ld-kpi-grid{grid-template-columns:repeat(4,minmax(160px,1fr))}}@media (max-width:1024px){.ld-section{grid-column:span 12}.ld-billing-grid{grid-template-columns:1fr}.ld-billing-summary{display:grid;grid-template-columns:repeat(3,1fr)}}@media (max-width:768px){.legal-dashboard{padding:15px}.ld-header{align-items:flex-start;flex-direction:column}.ld-action-row,.ld-section-actions{justify-content:flex-start}.ld-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ld-section{min-height:auto}.ld-scroll{height:320px}.ld-billing-summary{grid-template-columns:1fr}.ld-table-wrapper-mobile{display:none}.ld-mobile-card-list{display:block}}@media (max-width:520px){.ld-kpi-grid{grid-template-columns:1fr}.ld-title{font-size:20px}.ld-section-header{align-items:flex-start;flex-direction:column}}\n&lt;/style&gt;\n\n&lt;div class=&quot;legal-dashboard&quot;&gt;\n\t&lt;div class=&quot;ld-shell&quot;&gt;\n\t\t&lt;section class=&quot;ld-header&quot;&gt;\n\t\t\t&lt;div class=&quot;ld-title-block&quot;&gt;\n\t\t\t\t&lt;p class=&quot;ld-kicker&quot;&gt;Legal Operations&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&quot;ld-title&quot;&gt;Legal Dashboard&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;ld-subtitle&quot;&gt;Live overview of matters, hearings, deadlines, tasks, and billing exposure.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-action-row&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Create_Case?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Create Case&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Client?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Client&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;ld-kpi-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-violet zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;Open Matters&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;&lt;%=openMatterCount%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;Active legal work&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-d_blue zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;New Intakes&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;&lt;%=newIntakeCount%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;Awaiting triage&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-yellow zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;Conflict Checks Pending&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;&lt;%=pendingConflictCount%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;Review required&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-l_blue zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;Upcoming Hearings&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;&lt;%=upcomingHearingCount%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;Scheduled or prepared&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-orange zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;Urgent Deadlines&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;&lt;%=urgentDeadlineCount%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;Next 7 days or critical&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-red zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;Overdue Tasks&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;&lt;%=overdueTaskCount%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;Past due action&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-green zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;Unbilled Approved Time&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;$&lt;%=unbilledApprovedTime%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;Approved and not invoiced&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ld-kpi zcs-panel zcs-panel-grey zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;&lt;p class=&quot;ld-kpi-label&quot;&gt;Overdue Invoices&lt;/p&gt;&lt;strong class=&quot;ld-kpi-value&quot;&gt;&lt;%=overdueInvoiceCount%&gt;&lt;/strong&gt;&lt;span class=&quot;ld-kpi-note&quot;&gt;$&lt;%=overdueInvoiceBalance%&gt; balance due&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;ld-section-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;ld-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ld-section-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ld-section-title&quot;&gt;&lt;h2&gt;Recent Active Matters&lt;/h2&gt;&lt;p&gt;Latest active records across intake, conflict, engagement, and open matter stages.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ld-section-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Create_Case?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Create Case&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Client?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Client&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ld-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(recentMatters.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No active matters yet&lt;/h5&gt;&lt;p class=&quot;ld-empty-text&quot;&gt;Create a case to begin tracking legal work.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper ld-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full ld-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Client&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Owner&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Limitation&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each matter in recentMatters { %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;div class=&quot;ld-main&quot;&gt;&lt;%=ifnull(matter.Case_Title,&quot;Untitled matter&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;ld-sub&quot;&gt;Case &lt;%=ifnull(matter.Case_Number,&quot;Pending number&quot;)%&gt; · &lt;%=ifnull(matter.Priority,&quot;No priority&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(matter.Client.Client_Name,&quot;No client&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(matter.Matter_Manager.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;ld-status-pill ld-status-primary&quot;&gt;&lt;%=ifnull(matter.Case_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(matter.Limitation_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each matterCard in recentMatters { %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card&quot;&gt;&lt;p class=&quot;ld-mobile-card-title&quot;&gt;&lt;%=ifnull(matterCard.Case_Title,&quot;Untitled matter&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;Case &lt;%=ifnull(matterCard.Case_Number,&quot;Pending number&quot;)%&gt; · &lt;%=ifnull(matterCard.Client.Client_Name,&quot;No client&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;Owner: &lt;%=ifnull(matterCard.Matter_Manager.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;ld-mobile-card-meta&quot;&gt;&lt;span class=&quot;ld-status-pill ld-status-primary&quot;&gt;&lt;%=ifnull(matterCard.Case_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;ld-status-pill ld-status-info&quot;&gt;&lt;%=ifnull(matterCard.Priority,&quot;No priority&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ld-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ld-section-header&quot;&gt;&lt;div class=&quot;ld-section-title&quot;&gt;&lt;h2&gt;Upcoming Hearings&lt;/h2&gt;&lt;p&gt;Next scheduled or prepared appearances.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ld-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(hearingRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No upcoming hearings&lt;/h5&gt;&lt;p class=&quot;ld-empty-text&quot;&gt;Scheduled hearings will appear here when added.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper ld-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full ld-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Hearing&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Court / Venue&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Owner&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each hearing in hearingRows { %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;ld-main&quot;&gt;&lt;%=ifnull(hearing.Hearing_Type,&quot;Hearing&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;ld-sub&quot;&gt;&lt;%=ifnull(hearing.Hearing_DateTime,&quot;No date&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(hearing.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;ld-main&quot;&gt;&lt;%=ifnull(hearing.Court.Court_Name,&quot;No court&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;ld-sub&quot;&gt;&lt;%=ifnull(hearing.Venue,&quot;Venue not set&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(hearing.Preparation_Owner.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;ld-status-pill ld-status-info&quot;&gt;&lt;%=ifnull(hearing.Hearing_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each hearingCard in hearingRows { %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card&quot;&gt;&lt;p class=&quot;ld-mobile-card-title&quot;&gt;&lt;%=ifnull(hearingCard.Hearing_Type,&quot;Hearing&quot;)%&gt; · &lt;%=ifnull(hearingCard.Hearing_DateTime,&quot;No date&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;&lt;%=ifnull(hearingCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;&lt;%=ifnull(hearingCard.Court.Court_Name,&quot;No court&quot;)%&gt; · &lt;%=ifnull(hearingCard.Venue,&quot;Venue not set&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;ld-mobile-card-meta&quot;&gt;&lt;span class=&quot;ld-status-pill ld-status-info&quot;&gt;&lt;%=ifnull(hearingCard.Hearing_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ld-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ld-section-header&quot;&gt;&lt;div class=&quot;ld-section-title&quot;&gt;&lt;h2&gt;Urgent Deadlines&lt;/h2&gt;&lt;p&gt;Open or extended deadlines due soon, plus critical priority deadlines.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ld-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(deadlineRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No urgent deadlines&lt;/h5&gt;&lt;p class=&quot;ld-empty-text&quot;&gt;No open critical or near-term deadlines are currently due.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper ld-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full ld-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Deadline&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Responsible&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each deadline in deadlineRows { deadlineClass = if(deadline.Priority == &quot;Critical&quot;,&quot;ld-status-danger&quot;,&quot;ld-status-warning&quot;); %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;ld-main&quot;&gt;&lt;%=ifnull(deadline.Deadline_Type,&quot;Deadline&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;ld-sub&quot;&gt;&lt;%=ifnull(deadline.Deadline_Date,&quot;No date&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(deadline.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(deadline.Responsible_Attorney.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;ld-status-pill &lt;%=deadlineClass%&gt;&quot;&gt;&lt;%=ifnull(deadline.Priority,&quot;No priority&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;ld-status-pill ld-status-primary&quot;&gt;&lt;%=ifnull(deadline.Deadline_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each deadlineCard in deadlineRows { dClass = if(deadlineCard.Priority == &quot;Critical&quot;,&quot;ld-status-danger&quot;,&quot;ld-status-warning&quot;); %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card&quot;&gt;&lt;p class=&quot;ld-mobile-card-title&quot;&gt;&lt;%=ifnull(deadlineCard.Deadline_Type,&quot;Deadline&quot;)%&gt; · &lt;%=ifnull(deadlineCard.Deadline_Date,&quot;No date&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;&lt;%=ifnull(deadlineCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;Responsible: &lt;%=ifnull(deadlineCard.Responsible_Attorney.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;ld-mobile-card-meta&quot;&gt;&lt;span class=&quot;ld-status-pill &lt;%=dClass%&gt;&quot;&gt;&lt;%=ifnull(deadlineCard.Priority,&quot;No priority&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;ld-status-pill ld-status-primary&quot;&gt;&lt;%=ifnull(deadlineCard.Deadline_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ld-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ld-section-header&quot;&gt;&lt;div class=&quot;ld-section-title&quot;&gt;&lt;h2&gt;Overdue Tasks&lt;/h2&gt;&lt;p&gt;Missed or explicitly overdue assignments.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ld-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(taskRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No overdue tasks&lt;/h5&gt;&lt;p class=&quot;ld-empty-text&quot;&gt;There are no missed open assignments.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper ld-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full ld-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Task&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Assigned To&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each task in taskRows { taskClass = if(task.Priority == &quot;Critical&quot;,&quot;ld-status-danger&quot;,if(task.Priority == &quot;High&quot;,&quot;ld-status-warning&quot;,&quot;ld-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;ld-main&quot;&gt;&lt;%=ifnull(task.Task_Title,&quot;Untitled task&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;ld-sub&quot;&gt;&lt;%=ifnull(task.Task_Type,&quot;Task&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(task.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(task.Assigned_To.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(task.Due_Date,&quot;No due date&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;ld-status-pill &lt;%=taskClass%&gt;&quot;&gt;&lt;%=ifnull(task.Priority,&quot;No priority&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each taskCard in taskRows { tClass = if(taskCard.Priority == &quot;Critical&quot;,&quot;ld-status-danger&quot;,if(taskCard.Priority == &quot;High&quot;,&quot;ld-status-warning&quot;,&quot;ld-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card&quot;&gt;&lt;p class=&quot;ld-mobile-card-title&quot;&gt;&lt;%=ifnull(taskCard.Task_Title,&quot;Untitled task&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;&lt;%=ifnull(taskCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;Assigned: &lt;%=ifnull(taskCard.Assigned_To.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt; · Due &lt;%=ifnull(taskCard.Due_Date,&quot;No due date&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;ld-mobile-card-meta&quot;&gt;&lt;span class=&quot;ld-status-pill &lt;%=tClass%&gt;&quot;&gt;&lt;%=ifnull(taskCard.Priority,&quot;No priority&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;ld-status-pill ld-status-danger&quot;&gt;&lt;%=ifnull(taskCard.Task_Status,&quot;Overdue&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ld-section ld-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ld-section-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ld-section-title&quot;&gt;&lt;h2&gt;Billing Snapshot&lt;/h2&gt;&lt;p&gt;Approved work not invoiced and invoices past due.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ld-section-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Time_Entry?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Time Entry&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Expense_Entry?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Expense&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ld-scroll&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ld-billing-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ld-billing-summary&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ld-mini-card&quot;&gt;&lt;label&gt;Unbilled Approved Time&lt;/label&gt;&lt;strong&gt;$&lt;%=unbilledApprovedTime%&gt;&lt;/strong&gt;&lt;span&gt;Billable time entries approved and not tied to an invoice.&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ld-mini-card&quot;&gt;&lt;label&gt;Unbilled Approved Expenses&lt;/label&gt;&lt;strong&gt;$&lt;%=unbilledApprovedExpenses%&gt;&lt;/strong&gt;&lt;span&gt;Billable approved expenses pending invoice capture.&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ld-mini-card&quot;&gt;&lt;label&gt;Overdue Invoice Balance&lt;/label&gt;&lt;strong&gt;$&lt;%=overdueInvoiceBalance%&gt;&lt;/strong&gt;&lt;span&gt;&lt;%=overdueInvoiceCount%&gt; invoice(s) need follow-up.&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;% if(invoiceRows.count() == 0) { %&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No overdue invoices&lt;/h5&gt;&lt;p class=&quot;ld-empty-text&quot;&gt;Past-due invoice balances will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper ld-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full ld-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Client&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Balance&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due Date&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t\t\t&lt;% for each invoice in invoiceRows { %&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;ld-main&quot;&gt;&lt;%=ifnull(invoice.Invoice_Number,&quot;Pending number&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;ld-sub&quot;&gt;&lt;%=ifnull(invoice.Invoice_Status,&quot;No status&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(invoice.Client.Client_Name,&quot;No client&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(invoice.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-red&quot;&gt;$&lt;%=ifnull(invoice.Balance_Due,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(invoice.Due_Date,&quot;No due date&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;% for each invoiceCard in invoiceRows { %&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;ld-mobile-card&quot;&gt;&lt;p class=&quot;ld-mobile-card-title&quot;&gt;Invoice &lt;%=ifnull(invoiceCard.Invoice_Number,&quot;Pending number&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;&lt;%=ifnull(invoiceCard.Client.Client_Name,&quot;No client&quot;)%&gt; · &lt;%=ifnull(invoiceCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;ld-mobile-card-line&quot;&gt;Due &lt;%=ifnull(invoiceCard.Due_Date,&quot;No due date&quot;)%&gt; · Balance $&lt;%=ifnull(invoiceCard.Balance_Due,0)%&gt;&lt;/p&gt;&lt;div class=&quot;ld-mobile-card-meta&quot;&gt;&lt;span class=&quot;ld-status-pill ld-status-danger&quot;&gt;&lt;%=ifnull(invoiceCard.Invoice_Status,&quot;Overdue&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Other_Config(int Tab)
		{
					displayname = "Other Config"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%=thisapp.styles.getReportNavigationTemplate(1,&quot;&quot;,&quot;&quot;,&quot;#818181&quot;,&quot;&quot;,&quot;&quot;)%&gt;\n&lt;div class=&quot;MainDiv&quot;&gt;\n\t&lt;div class=&quot;shiftChart&quot;&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Navigation&apos; class=&quot;dashboard-nav navigation underline-model&quot; params=&apos;zc_Header=false&amp;zc_Focus=false&amp;Page_Name=Other_Config&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; class=&quot;show-div&quot; name=&quot;showFrame&quot;&gt;&lt;/div&gt;\n\t\t\t\t &lt;/div&gt;\n\t\t &lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Preference(string subtab, string tab)
		{
					displayname = "Setup"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet2' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet2()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tpage_link_name = &quot;Preference&quot;;\n\tlanguage = thisapp.Localization.Pages();\n\tcommon = thisapp.Localization.Common();\n\ttab_map = thisapp.Page.Get_Tabs(page_link_name);\n\ttab_keys = tab_map.keys();\n\tinput.tab = if(input.tab == &quot;&quot; || input.tab == null,tab_keys.get(0),input.tab);\n\tinput.tab = if(!tab_keys.contains(input.tab),tab_keys.get(0),input.tab);\n\tif(input.tab != &quot;&quot; &amp;&amp; input.tab != &quot;null&quot; &amp;&amp; input.tab != null)\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*temp*/\n.zcform_Delete_form .form-action.formbutton {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n}\n.zcform_Create_Template .label-left .second-column, .zcform_Create_Template .label-right .second-column {\n\t\twidth: calc(100% - 670px) !important;\n}\n.zcform_Create_Template .second-column .notes-field {\n\t\twidth: 100% !important;\n}\nform[name=&quot;Delete_form&quot;].label-left {\n\t\twidth: 370px !important;\n\t}\n.zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a:hover {\n\t\tbackground: var(--component_hover_color);\n}\n.zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a{\n\tborder-radius: 99px !important;\n}\n.zc-pra-setup .zc-pra-page-container-inner{\n\t    padding: 0px 10px 0 10px !important;\n}\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment {\n\t\tpadding: unset !important;\n}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important; \n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\ndiv#zppagesLive,\ndiv#elementsContainer,\n.Layout.elemContainment,\ndiv#row_1,\n.zc-pb-formreport-placeholder {\n\theight: 100% !important;\n}\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .view-outer-wrapper .view-header .zc-new-report-header{\n\t  height: unset !important; \n\t padding: unset !important; \n}\n .zc-pra-page-container .view-header .zc-new-report-header {\n\t height: unset !important; \n}\n.zc-pra-setup .zc-reporttype-list .list-view-inner {\nborder: unset !important; \nborder-radius: unset !important; \n}\n .zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .view-outer-wrapper .view-header.zc-show-new-menu .view-options.zc-report-newheader {\n\t\ttop: -0.625rem !important;\n}\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .view-outer-wrapper .view-header {\n\tborder: unset !important;}\n/*temp*/\n&lt;%=thisapp.styles.CommonStyles()%&gt;\n&lt;%=thisapp.PageStyles.Setup(input.tab)%&gt;\n/* Active state */\n.zc-pra-vertical-tabpanel .zc-pra-vertical-tabhead li a.&lt;%=if(input.tab.isEmpty() == false &amp;&amp; input.subtab.isEmpty() == false,input.subtab,input.tab)%&gt; {\n\t  background-color: var(--theme_brand_color) !important;\n\t\tcolor: white !important;\n\t\tfont-weight: 600;\n\t \n}\n.zc-content-loader, .zc-content-loader div {\n\t \tdisplay: none !important;\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;zc-pra-page-container zc-pra-setup&apos;&gt;\n\t&lt;div class=&apos;zc-pra-page-container-inner zc-pra-fwh&apos;&gt;\n\t\t&lt;div class=&apos;zc-pra-card zc-pra-fwh&apos;&gt;\n\t\t\t&lt;div class=&apos;zc-pra-page-header&apos;&gt;\n\t\t\t\t&lt;h5&gt; &lt;%=language.get(&quot;zcp.setup.setup.title&quot;)%&gt; &lt;/h5&gt;\n\t\t\t\t&lt;p&gt; &lt;%=language.get(&quot;zcp.setup.setuppending&quot;)%&gt; &lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zc-pra-page-content zc-pra-vertical-tabpanel zc-pra-clearfix zc-pra-fwh&apos;&gt;\n\t\t\t&lt;ul class=&apos;zc-pra-vertical-tabhead zc-pra-flt-left&apos;&gt;\n&lt;%\n\t\tid_index = 1;\n\t\tfor each  tab_id in tab_map\n\t\t{\n\t\t\ttab_key = tab_map.toCollection().getKey(tab_id);\n\t\t\t%&gt;\n&lt;li &lt;%=if(tab_id.get(&quot;sub_menu&quot;) != null,&quot;class=zc-pra-vertical-tab-comp&quot;,null)%&gt;&gt;\n\t\t&lt;input name=&quot;zc-pra-tab&quot; type=&quot;checkbox&quot;  id=&apos;tab&lt;%=id_index%&gt;&apos; &lt;%=if(input.tab == tab_key,&quot;checked&quot;,null)%&gt;&gt; \n\t\t&lt;label for=&quot;tab&lt;%=id_index%&gt;&quot;&gt;\n&lt;%\n\t\t\tif(tab_id.get(&quot;sub_menu&quot;) == null)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a href=&apos;#Page:&lt;%=page_link_name%&gt;?tab=&lt;%=tab_key%&gt;&apos; class=&apos;&lt;%=tab_key%&gt;&apos;&gt; &lt;%=tab_id.get(&quot;Display&quot;)%&gt; &lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a  class=&apos;&lt;%=tab_key%&gt;&apos;&gt; &lt;%=tab_id.get(&quot;Display&quot;)%&gt;&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/label&gt;\n&lt;%\n\t\t\tif(tab_id.get(&quot;sub_menu&quot;) != null)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;ul class=&apos;zc-pra-vertical-tabsubmenu&apos;&gt;\n&lt;%\n\t\t\t\tsub_id_index = 1;\n\t\t\t\tsub_menu = tab_id.get(&quot;sub_menu&quot;);\n\t\t\t\tfor each  sub_item in sub_menu\n\t\t\t\t{\n\t\t\t\t\tsub_menu_key = sub_menu.toCollection().getKey(sub_item);\n\t\t\t\t\t%&gt;\n&lt;li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;input type=&apos;checkbox&apos; name=&apos;zc-pra-subtab&apos; id=&apos;subtab&lt;%=id_index + &quot;&quot; + sub_id_index%&gt;&apos; &lt;%=if(input.subtab == sub_menu_key,&quot;checked&quot;,null)%&gt;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;label for=&apos;subtab&lt;%=id_index + &quot;&quot; + sub_id_index%&gt;&apos;&gt; &lt;a class=&apos;&lt;%=sub_menu_key%&gt;&apos; href=&quot;#Page:&lt;%=page_link_name%&gt;?tab=&lt;%=tab_key%&gt;&amp;subtab=&lt;%=sub_menu_key%&gt;&quot;&gt; &lt;%=sub_item.get(&quot;Display&quot;)%&gt; &lt;/a&gt; &lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\t\tsub_id_index = sub_id_index + 1;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/li&gt;\n&lt;%\n\t\t\tid_index = id_index + 1;\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\n\t\t\t\t&lt;div class=&apos;zc-pra-vertical-tabbody zc-pra-flt-left &lt;%=input.tab%&gt;&apos;&gt;\n&lt;%\n\t\tif(tab_keys.contains(input.tab))\n\t\t{\n\t\t\tparam = &quot;&quot;;\n\t\t\tif(tab_map.get(input.tab).get(&quot;Comp&quot;) == &quot;Form&quot;)\n\t\t\t{\n\t\t\t\tif(tab_map.get(input.tab).get(&quot;Link&quot;) == &quot;Add_Preference&quot;)\n\t\t\t\t{\n\t\t\t\t\tfetchPreference = Add_Preference[ID != null];\n\t\t\t\t\tif(fetchPreference.count() != 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tpreferenceID = fetchPreference.ID;\n\t\t\t\t\t\tif(fetchPreference.Organization_Logo == &quot;&quot; || fetchPreference.Organization_Logo == null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tres = invokeurl\n\t\t\t\t\t\t\t[\n\t\t\t\t\t\t\t\turl :&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/h814669ae0987327a4404804a6236ce5e7438?x-cli-msg=%7B%22linkId%22%3A%226OxchGOzv8B-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;\n\t\t\t\t\t\t\t\ttype :GET\n\t\t\t\t\t\t\t];\n\t\t\t\t\t\t\tres.setParamName(&quot;file&quot;);\n\t\t\t\t\t\t\tres.setFileName(&quot;Creator_Logo&quot; + &quot;.png&quot;);\n\t\t\t\t\t\t\tresponse = invokeurl\n\t\t\t\t\t\t\t[\n\t\t\t\t\t\t\t\turl :&quot;https://www.zohoapis.com/creator/v2.1/data&quot; + zoho.appuri + &quot;report/All_Preferences/&quot; + fetchPreference.ID + &quot;/Organization_Logo/upload&quot;\n\t\t\t\t\t\t\t\ttype :POST\n\t\t\t\t\t\t\t\tfiles:res\n\t\t\t\t\t\t\t\tconnection:&quot;creator&quot;\n\t\t\t\t\t\t\t];\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; name=&apos;embedDiv&apos; formLinkName=&apos;Add_Preference&apos; params=&apos;viewLinkName=All_Preferences&amp;recLinkID=&lt;%=fetchPreference.ID%&gt;&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tinsert into Add_Preference\n\t\t\t\t\t\t[\n\t\t\t\t\t\t\tAdded_User=zoho.loginuser\n\t\t\t\t\t\t\tEmail_Notification=true\n\t\t\t\t\t\t]\n\t\t\t\t\t\topenUrl(&quot;#Script:page.refresh&quot;,&quot;same window&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; name=&apos;embedDiv&apos; formLinkName=&apos;&lt;%=tab_map.get(input.tab).get(&quot;Link&quot;)%&gt;&apos; params=&apos;&lt;%=param%&gt;zc_NextUrl=#Script:page.reload&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tif(input.tab in {&quot;categories&quot;,&quot;brands&quot;,&quot;departments&quot;})\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;style&gt;\n&lt;%=thisapp.PageStyles.Preferences_Report_Filter()%&gt;\n&lt;/style&gt;\n&lt;div class=&apos;zc-pra-filter&apos; elName=&apos;zc-component&apos; formLinkName=&apos;Preferences_Filter&apos; params=&apos;zc_Header=false&amp;Report=&lt;%=tab_map.get(input.tab).get(&quot;Link&quot;)%&gt;&amp;Page=Preferences&amp;zc_Focus=false&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; name=&apos;embedDiv&apos; viewLinkName=&apos;&lt;%=tab_map.get(input.tab).get(&quot;Link&quot;)%&gt;&apos; params=&apos;zc_Footer=false&amp;zc_Search=false&amp;zc_MoreAction=false&amp;zc_ColMenu=false&amp;zc_RecSelect=false&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Hide_Data as "Hide Data"
			{
			
						
										type =  form
										form = Add_Approval_Setup
						
										record event = on add or edit
						
										field rules
										{
											actions  (Approver_Type == "Role" || Approver_Type is null)
											{
												hide users;
											}
											actions  (Approver_Type == "User" || Approver_Type is null)
											{
												hide Approver_Role;
											}
										}
						
									
						
			}

			Hide_Data3 as "Hide Data"
			{
			
						
										type =  form
										form = Add_Approval_Setup
						
										record event = on add or edit
						
										field rules
										{
											actions 
											{
												hide Hidden;
											}
										}
						
									
						
			}

			On_Load_Scripts5 as "On-Load Scripts"
			{
			
						
										type =  form
										form = Add_Approval_Setup
						
										record event = on add or edit
						
										on load
										{
											actions 
											{
												custom deluge script
												(
																	if(input.Approval_Setup_For != null)
																{
																	disable Approval_Setup_For;
																}
												)
											}
										}
						
									
						
			}

			On_success3 as "On success"
			{
			
						
										type =  form
										form = Add_Approval_Setup
						
										record event = on add
						
										on success
										{
											actions 
											{
												custom deluge script
												(
																	for each  flow in Add_Approval_Setup[ID != input.ID && Approval_Setup_For == input.Approval_Setup_For && Sequence_Order >= input.Sequence_Order]
																{
																	flow.Sequence_Order=ifnull(flow.Sequence_Order,0) + 1;
																	flow.Previous_Sequence_Number=ifnull(flow.Previous_Sequence_Number,0) + 1;
																}
																if(input.Previous_Sequence_Number == null)
																{
																	input.Previous_Sequence_Number = 0;
																}
																if(input.Sequence_Order == null)
																{
																	input.Sequence_Order = 0;
																}
																// openUrl("#Script:page.parent.refresh","parent window");
												)
											}
										}
						
									
						
			}

			On_success4 as "On success"
			{
			
						
										type =  form
										form = Add_Approval_Setup
						
										record event = on add or edit
						
										on success
										{
											actions 
											{
												custom deluge script
												(
																	openUrl("#Page:Approval_Setup?zc_LoadIn=embed-embedDiv&recID=" + input.Approval_Setup_For,"same window");
												)
											}
										}
						
									
						
			}

			Validation as "Validation"
			{
			
						
										type =  form
										form = Add_Approval_Setup
						
										record event = on add or edit
						
										on validate
										{
											actions 
											{
												custom deluge script
												(
																	// today = zoho.currentdate;
																// currMonth = today.getMonth();
																// currYear = today.getYear();
																// currentDay = today.getDay();
																// startDate = today.toStartOfMonth();
																// endDate = startDate.addDay(9);
																// if(currentDay < 1 || currentDay > 10)
																// {
																// 	alert "Preference submission is currently closed. Please contact HR for assistance.";
																// 	cancel submit;
																// }
																if(input.Approver_Type == "Role" && input.Approver_Role == null)
																{
																	alert "Please Select Approver Role to Proceed.";
																	cancel submit;
																}
																if(input.Approver_Type == "User" && input.users == null)
																{
																	alert "Please Select User to Proceed.";
																	cancel submit;
																}
												)
											}
										}
						
									
						
			}

			Add_Case_Action_Action_Type_On_User_Input as "Action Type On User Input"
			{
			
						    type = form
						    form = Add_Case_Action
						    record event = on add or edit
						
						    on user input of Action_Type
						    {
						        actions
						        {
						            custom deluge script
						            (
						                input.To_Status = "";
						                if(input.Action_Type == "Submit Conflict Check")
						                {
						                    input.To_Status = "Conflict Check";
						                }
						                else if(input.Action_Type == "Clear Conflict" || input.Action_Type == "Send Engagement")
						                {
						                    input.To_Status = "Engagement Pending";
						                }
						                else if(input.Action_Type == "Mark Engagement Signed" || input.Action_Type == "Open Matter" || input.Action_Type == "Reopen Case")
						                {
						                    input.To_Status = "Open Matter";
						                }
						                else if(input.Action_Type == "Move To Strategy and Pleadings")
						                {
						                    input.To_Status = "Strategy and Pleadings";
						                }
						                else if(input.Action_Type == "Move To Discovery and Diligence")
						                {
						                    input.To_Status = "Discovery and Diligence";
						                }
						                else if(input.Action_Type == "Move To Negotiation and Mediation")
						                {
						                    input.To_Status = "Negotiation and Mediation";
						                }
						                else if(input.Action_Type == "Move To Hearing and Trial")
						                {
						                    input.To_Status = "Hearing and Trial";
						                }
						                else if(input.Action_Type == "Mark Awaiting Order or Execution")
						                {
						                    input.To_Status = "Awaiting Order or Execution";
						                }
						                else if(input.Action_Type == "Send To Billing Review")
						                {
						                    input.To_Status = "Billing Review";
						                }
						                else if(input.Action_Type == "Close Case")
						                {
						                    input.To_Status = "Closed";
						                }
						                else if(input.Action_Type == "Archive Case")
						                {
						                    input.To_Status = "Archived";
						                }
						                else if(input.Action_Type == "Flag Conflict" || input.Action_Type == "Reject Case")
						                {
						                    input.To_Status = "Rejected";
						                }
						            )
						        }
						    }
						
			}

			Add_Case_Action_Case_On_User_Input as "Case On User Input"
			{
			
						    type = form
						    form = Add_Case_Action
						    record event = on add or edit
						
						    on user input of Case
						    {
						        actions
						        {
						            custom deluge script
						            (
						                input.From_Status = "";
						                if(input.Case != null)
						                {
						                    caseRec = Create_Case[ID == input.Case];
						                    if(caseRec.count() > 0)
						                    {
						                        input.From_Status = caseRec.Case_Status;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Case_Action_On_Load as "Add Case Action On Load"
			{
			
						    type = form
						    form = Add_Case_Action
						    record event = on add or edit
						
						    on load
						    {
						        actions
						        {
						            hide System_Info, Action_ID, From_Status, To_Status, Action_Date;
						            disable Action_ID, From_Status, To_Status, Action_Date;
						        }
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Case != null)
						                {
						                    disable Case;
						                    caseRec = Create_Case[ID == input.Case];
						                    if(caseRec.count() > 0)
						                    {
						                        input.From_Status = caseRec.Case_Status;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Case_Action_On_Success as "Add Case Action On Success"
			{
			
						    type = form
						    form = Add_Case_Action
						    record event = on add
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                caseRec = Create_Case[ID == input.Case];
						                if(caseRec.count() > 0)
						                {
						                    oldStatus = caseRec.Case_Status;
						                    caseRec.Case_Status = input.To_Status;
						                    if(input.Action_Type == "Submit Conflict Check")
						                    {
						                        caseRec.Conflict_Status = "In Review";
						                    }
						                    else if(input.Action_Type == "Clear Conflict")
						                    {
						                        caseRec.Conflict_Status = "Cleared";
						                        caseRec.Engagement_Status = "Not Sent";
						                    }
						                    else if(input.Action_Type == "Flag Conflict")
						                    {
						                        caseRec.Conflict_Status = "Conflict Found";
						                    }
						                    else if(input.Action_Type == "Send Engagement")
						                    {
						                        caseRec.Engagement_Status = "Sent";
						                    }
						                    else if(input.Action_Type == "Mark Engagement Signed" || input.Action_Type == "Open Matter")
						                    {
						                        caseRec.Engagement_Status = "Signed";
						                        caseRec.Opened_On = zoho.currentdate;
						                    }
						                    else if(input.Action_Type == "Send To Billing Review")
						                    {
						                        caseRec.Billing_Status = "Ready for Review";
						                    }
						                    else if(input.Action_Type == "Close Case")
						                    {
						                        caseRec.Billing_Status = "Closed";
						                        caseRec.Closed_On = zoho.currentdate;
						                    }
						                    else if(input.Action_Type == "Archive Case")
						                    {
						                        caseRec.Archived_On = zoho.currentdate;
						                    }
						                    else if(input.Action_Type == "Reopen Case")
						                    {
						                        caseRec.Closed_On = null;
						                        caseRec.Archived_On = null;
						                        caseRec.Billing_Status = "Not Ready";
						                    }
						                    insert into Add_Case_History
						                    [
						                        Case = input.Case
						                        Event_Date = zoho.currenttime
						                        Event_Type = "Status Changed"
						                        Previous_Status = oldStatus
						                        New_Status = input.To_Status
						                        Summary = input.Action_Type + ": " + input.Action_Notes
						                        Source_Record_ID = input.ID
						                    ];
						                    notifyTo = "";
						                    if(caseRec.Lead_Attorney != null)
						                    {
						                        leadRec = Add_Employee[ID == caseRec.Lead_Attorney];
						                        if(leadRec.count() > 0)
						                        {
						                            notifyTo = ifnull(leadRec.Email,"");
						                        }
						                    }
						                    if(caseRec.Matter_Manager != null)
						                    {
						                        managerRec = Add_Employee[ID == caseRec.Matter_Manager];
						                        if(managerRec.count() > 0 && ifnull(managerRec.Email,"") != "")
						                        {
						                            notifyTo = notifyTo + "," + managerRec.Email;
						                        }
						                    }
						                    if(caseRec.Billing_Attorney != null && input.Action_Type == "Send To Billing Review")
						                    {
						                        billingRec = Add_Employee[ID == caseRec.Billing_Attorney];
						                        if(billingRec.count() > 0 && ifnull(billingRec.Email,"") != "")
						                        {
						                            notifyTo = notifyTo + "," + billingRec.Email;
						                        }
						                    }
						                    if(notifyTo != "")
						                    {
						                        sendmail
						                        (
						                            from : zoho.adminuserid
						                            to : notifyTo
						                            subject : "Matter action completed"
						                            message : "Action completed for " + caseRec.Case_Title + ": " + input.Action_Type
						                        )
						                    }
						                }
						                openUrl("#Page:Case_Detail?Case_ID=" + input.Case,"same window");
						            )
						        }
						    }
						
			}

			Add_Case_Action_On_Validate as "Add Case Action On Validate"
			{
			
						    type = form
						    form = Add_Case_Action
						    record event = on add or edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Case == null)
						                {
						                    alert "Select a case before running an action.";
						                    cancel submit;
						                }
						                caseRec = Create_Case[ID == input.Case];
						                if(caseRec.count() == 0)
						                {
						                    alert "Selected case could not be found.";
						                    cancel submit;
						                }
						                validAction = false;
						                if(input.Action_Type == "Submit Conflict Check" && caseRec.Case_Status == "New Intake")
						                {
						                    validAction = true;
						                    input.To_Status = "Conflict Check";
						                }
						                else if(input.Action_Type == "Clear Conflict" && caseRec.Case_Status == "Conflict Check" && caseRec.Conflict_Status == "Cleared")
						                {
						                    validAction = true;
						                    input.To_Status = "Engagement Pending";
						                }
						                else if(input.Action_Type == "Flag Conflict" && caseRec.Case_Status == "Conflict Check")
						                {
						                    validAction = true;
						                    input.To_Status = "Rejected";
						                }
						                else if(input.Action_Type == "Reject Case" && (caseRec.Case_Status == "New Intake" || caseRec.Case_Status == "Conflict Check" || caseRec.Case_Status == "Engagement Pending"))
						                {
						                    validAction = true;
						                    input.To_Status = "Rejected";
						                }
						                else if(input.Action_Type == "Send Engagement" && caseRec.Case_Status == "Engagement Pending")
						                {
						                    validAction = true;
						                    input.To_Status = "Engagement Pending";
						                }
						                else if((input.Action_Type == "Mark Engagement Signed" || input.Action_Type == "Open Matter") && caseRec.Case_Status == "Engagement Pending")
						                {
						                    validAction = true;
						                    input.To_Status = "Open Matter";
						                }
						                else if(input.Action_Type == "Move To Strategy and Pleadings" && caseRec.Case_Status == "Open Matter")
						                {
						                    validAction = true;
						                    input.To_Status = "Strategy and Pleadings";
						                }
						                else if(input.Action_Type == "Move To Discovery and Diligence" && caseRec.Case_Status == "Strategy and Pleadings")
						                {
						                    validAction = true;
						                    input.To_Status = "Discovery and Diligence";
						                }
						                else if(input.Action_Type == "Move To Negotiation and Mediation" && caseRec.Case_Status == "Discovery and Diligence")
						                {
						                    validAction = true;
						                    input.To_Status = "Negotiation and Mediation";
						                }
						                else if(input.Action_Type == "Move To Hearing and Trial" && caseRec.Case_Status == "Negotiation and Mediation")
						                {
						                    validAction = true;
						                    input.To_Status = "Hearing and Trial";
						                }
						                else if(input.Action_Type == "Mark Awaiting Order or Execution" && caseRec.Case_Status == "Hearing and Trial")
						                {
						                    validAction = true;
						                    input.To_Status = "Awaiting Order or Execution";
						                }
						                else if(input.Action_Type == "Send To Billing Review" && caseRec.Case_Status == "Awaiting Order or Execution")
						                {
						                    validAction = true;
						                    input.To_Status = "Billing Review";
						                }
						                else if(input.Action_Type == "Close Case" && caseRec.Case_Status == "Billing Review" && caseRec.Billing_Status == "Closed")
						                {
						                    validAction = true;
						                    input.To_Status = "Closed";
						                }
						                else if(input.Action_Type == "Archive Case" && caseRec.Case_Status == "Closed")
						                {
						                    validAction = true;
						                    input.To_Status = "Archived";
						                }
						                else if(input.Action_Type == "Reopen Case" && (caseRec.Case_Status == "Closed" || caseRec.Case_Status == "Archived"))
						                {
						                    validAction = true;
						                    input.To_Status = "Open Matter";
						                }
						                if(validAction == false)
						                {
						                    alert "This action is not available for the current case status.";
						                    cancel submit;
						                }
						                input.From_Status = caseRec.Case_Status;
						            )
						        }
						    }
						
			}

