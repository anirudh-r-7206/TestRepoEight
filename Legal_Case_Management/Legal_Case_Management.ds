						                 			prod_img = "https://creatorapp.zohopublic.com" + zoho.appuri + "report/" + input.reportName + "/" + input.recID + "/" + input.fieldLinkName + "/download-file/" + input.publicLink + "?filepath=/" + input.SignatureName;
						                 		}
						                 		else
						                 		{
						                 			prod_img = thisapp.ImportantFunctions.getImageURL(input.SignatureName,input.fieldLinkName,input.reportName,input.recID);
						                 		}
						                 	}
						                 	else
						                 	{
						                 		prod_img = "https://files-accl.zohoexternal.com/public/workdrive-external/download/1aent25160252f45749d0a527538d0fabb776?x-cli-msg=%7B%22linkId%22%3A%226OxchHwUjPM-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D";
						                 	}
						                 	return prod_img;
						                 
						
			}

