c_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;case-tab-panel&apos; id=&apos;panel-hearing-trial&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-tab-context&apos;&gt;&lt;div class=&apos;case-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline business-scale&apos;&gt;&lt;/i&gt;&lt;span&gt;Hearing and Trial matters&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;case-tab-hint&apos;&gt;Monitor matters currently in hearings, trial preparation, or trial.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Cases_Hearing_and_Trial&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;case-tab-panel&apos; id=&apos;panel-awaiting-order-execution&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-tab-context&apos;&gt;&lt;div class=&apos;case-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Awaiting Order or Execution matters&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;case-tab-hint&apos;&gt;Track matters awaiting final order, enforcement, execution, or billing handoff.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Cases_Awaiting_Order_or_Execution&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;case-tab-panel&apos; id=&apos;panel-billing-review&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-tab-context&apos;&gt;&lt;div class=&apos;case-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Billing Review matters&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;case-tab-hint&