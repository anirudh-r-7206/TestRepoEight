l 14px/20px 'ZC Live Outline'; display: inline-block; vertical-align: top; opacity: 0.5; user-select: none; position: absolute; top: 8px; left: 12px; } .zc-pra-filter .form-group.zc-Search_Key-group .form-field input, .zc-pra-filter .form-group.zc-Search-group .form-field input { padding-left: 30px; padding-right: 30px; } .zc-pra-filter .form-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { display: inline-block; vertical-align: top; } .zc-pra-filter .form-group.zc-Project-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + project + " -'; } .zc-pra-filter .form-group.zc-Status-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + status + " -'; } .zc-pra-filter .form-group.zc-Shipping_Address-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + shipping_address + " -'; } .zc-pra-filter .form-group.zc-Vendor-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + vendor + " -'; } .zc-pra-filter .form-group.zc-Product-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + product + " -'; } .zc-pra-filter .form-group.zc-Category-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + category + " -'; } .zc-pra-filter .form-group.zc-Product_Status-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + common.get("zcp.status") + " -'; } .zc-pra-filter .form-group.zc-Department-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + department + " -'; } .zc-pra-filter .form-group.zc-Brand-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + brand + " -'; } .zc-pra-filter .form-group.zc-Requester-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- Requester -'; } /* Decision box(Search - cancel icon) */ .zc-pra-filter .form-group.zc-decisionbox-field-group { width: auto; height: 36px; position: absolute; right: 7px; top: 0px; z-index: 1; margin: 0px; } .zc-pra-filter .form-group .decision-box-field { display: none; } .zc-pra-filter .form-outer-wrapper .formColumn .zc-decisionbox-field-group .form-label.decision-box-label { height: 36px; font-size: 0px; line-height: 36px; padding: 0px; } .zc-pra-filter .form-label.decision-box-label:before { content: '\ed84'; font-family: 'ZC Live Outline'; font-size: 17px; } .zc-pra-filter .form-label.decision-box-label:hover:before { color: #EE3131; } .zc-pra-filter .form-group .cogLoader { margin: 11px 3px; }";
