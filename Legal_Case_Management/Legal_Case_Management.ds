se-tab-context&apos;&gt;&lt;div class=&apos;case-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-remove&apos;&gt;&lt;/i&gt;&lt;span&gt;Rejected matters&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;case-tab-hint&apos;&gt;Rejected intakes and conflicts are shown for audit and reference.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Cases_Rejected&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Client_Portal
		{
					displayname = "Client Portal"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Client_Portal_Main' elementName='Client_Portal_Main'>\n\t\t\t\t\t<![CDATA[htmlpage Client_Portal_Main()\n\t\t\t\t\t\tcontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = ifnull(zoho.loginuserid,&quot;&quot;);\n\tloginUser = ifnull(zoho.loginuser,&quot;&quot;);\n\tcontactRows = Add_Client_Contact[Email == loginEmail &amp;&amp; Status == &quot;Active&quot;];\n\tif(contactRows.count() == 0 &amp;&amp; loginUser != &quot;&quot; &amp;&amp; loginUser != loginEmail)\n\t{\n\t\tcontactRows = Add_Client_Contact[Email == loginUser &amp;&amp; Status == &quot;Active&quot;];\n\t}\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility subset included once for this page ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);\n\t--zcs_brand_color: #6147E5;\n\t--zcs_brand_foreground_color: #FFFFFF;\n\t--zcs_brand_dark_color: #4E38C8;\n\t--zcs_brand_light_color: #F1EEFF;\n\t--zcs_primary_text_color: #17142F;\n\t--zcs_secondary_text_color: #4F5873;\n\t--zcs_tertiary_text_color: #7A8094;\n\t--zcs_tertiary_border_color: #E7E8F0;\n\t--zcs_primary_border_color: #E0E2EA;\n\t--zcs_component_hover_color: #F4F1FF;\n\t--zcs_light_grey_color: #F7F8FC;\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-page-bg-color: #F6F7FB;\n\t--cp-primary: #6147E5;\n\t--cp-primary-dark: #4E38C8;\n\t--cp-bg: #F6F7FB;\n\t--cp-surface: #FFFFFF;\n\t--cp-border: #E7E8F0;\n\t--cp-text: #17142F;\n\t--cp-muted: #6B7280;\n\t--cp-soft: #F1EEFF;\n\t--cp-success: #179E6C;\n\t--cp-warning: #B8770D;\n\t--cp-danger: #D92D20;\n\t--cp-info: #2A6FFC;\n\t--cp-gap: 15px;\n\t--cp-radius: 12px;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mt-20{margin-top:20px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n/* ===== ZCS component CSS: button-primary-button/header-heading-with-button and no-data-no-data-with-button ===== */\n.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0;transition:background .15s ease,border-color .15s ease,color .15s ease}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-secondary-button:hover,.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus,.zcs-secondary-button.zcs-button:active,.zcs-secondary-button.zcs-button:focus,.zcs-primary-outline-button.zcs-button:active,.zcs-primary-outline-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-button-text{white-space:nowrap}.zcs-nodata-wrapper{min-height:150px}.zcs-nodata-img{width:84px;height:84px}.zcs-nodata-header{font-size:18px}\n/* ===== ZCS component CSS: badge-filled-badge ===== */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n/* ===== ZCS component CSS: table-simple-table ===== */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#FE455D}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-l_blue{color:#1094C5}\n/* ===== Client Portal approved CSS block ===== */\n*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.client-portal{width:100%;min-height:100%;background:var(--cp-bg);color:var(--cp-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--cp-gap);overflow:auto}.cp-shell{display:flex;flex-direction:column;gap:var(--cp-gap);max-width:1680px;margin:0 auto}.cp-header{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--cp-gap);padding:15px;border:1px solid var(--cp-border);border-radius:var(--cp-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.cp-title-block{min-width:0;flex:1}.cp-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--cp-primary);margin:0 0 4px}.cp-title{font-size:24px;line-height:1.2;font-weight:700;color:var(--cp-text);margin:0}.cp-subtitle{margin:6px 0 0;color:var(--cp-muted)}.cp-trust-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.cp-action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end;max-width:560px}.cp-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--cp-gap);align-items:start}.cp-card{grid-column:span 4;background:var(--cp-surface);border:1px solid var(--cp-border);border-radius:var(--cp-radius);overflow:hidden;min-height:100%;display:flex;flex-direction:column}.cp-card.cp-wide{grid-column:span 8}.cp-card.cp-full{grid-column:span 12}.cp-card-header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px;border-bottom:1px solid var(--cp-border);background:#fff}.cp-card-title{display:flex;flex-direction:column;gap:2px;min-width:0}.cp-card-title h2{font-size:16px;line-height:1.25;font-weight:700;color:var(--cp-text);margin:0}.cp-card-title p{font-size:12px;color:var(--cp-muted);margin:0}.cp-card-body{padding:15px}.cp-section-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.cp-metrics{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:var(--cp-gap)}.cp-metric{border:1px solid var(--cp-border);border-radius:var(--cp-radius);padding:15px;background:#fff}.cp-metric label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--cp-muted);margin-bottom:6px}.cp-metric strong{display:block;font-size:20px;line-height:1.2;color:var(--cp-text);word-break:break-word}.cp-list{display:grid;gap:12px}.cp-record{border:1px solid var(--cp-border);border-radius:var(--cp-radius);padding:12px;background:#FCFCFF;min-width:0}.cp-record-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.cp-record-title{font-size:15px;font-weight:700;color:var(--cp-text);margin:0;word-break:break-word}.cp-record-meta{font-size:12px;color:var(--cp-muted);margin:4px 0 0;word-break:break-word}.cp-record-desc{color:var(--cp-text);margin:8px 0 0;word-break:break-word}.cp-record-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.cp-scroll{height:330px;overflow:auto;padding:15px}.cp-tall-scroll{height:430px;overflow:auto;padding:15px}.cp-table{min-width:720px}.cp-table.compact{min-width:560px}.cp-table .cp-main{font-weight:600;color:var(--cp-text)}.cp-table .cp-sub{font-size:12px;color:var(--cp-muted);margin-top:2px}.cp-status-pill{font-size:12px;font-weight:600;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:240px}.cp-status-primary{background:#F1EEFF;color:var(--cp-primary)}.cp-status-success{background:#E4FCF3;color:var(--cp-success)}.cp-status-warning{background:#FCF4E6;color:var(--cp-warning)}.cp-status-danger{background:#FDE3E6;color:var(--cp-danger)}.cp-status-info{background:#E8EFFF;color:var(--cp-info)}.cp-empty{min-height:150px;border:1px dashed var(--cp-border);border-radius:var(--cp-radius);background:#FCFCFF}.cp-empty-text{color:var(--cp-muted);margin:6px 0 0}.cp-alert{display:flex;gap:10px;align-items:flex-start;border:1px solid #D9D2FF;background:#F8F6FF;color:var(--cp-text);border-radius:var(--cp-radius);padding:15px}.cp-alert i{font-size:18px;line-height:1.2;color:var(--cp-primary)}.cp-security-note{display:flex;gap:8px;align-items:flex-start;color:var(--cp-muted);font-size:12px;margin-top:10px}.cp-mobile-list{display:none}.cp-mobile-card{border:1px solid var(--cp-border);border-radius:var(--cp-radius);padding:12px;background:#fff;margin-bottom:10px}.cp-mobile-card:last-child{margin-bottom:0}.cp-mobile-card-title{font-weight:700;margin:0 0 4px;color:var(--cp-text)}.cp-mobile-card-line{font-size:12px;color:var(--cp-muted);margin:2px 0}.cp-mobile-card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1280px){.cp-card,.cp-card.cp-wide{grid-column:span 6}.cp-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}@media (max-width:860px){.client-portal{padding:15px}.cp-header{flex-direction:column}.cp-action-row,.cp-section-actions{justify-content:flex-start;max-width:none}.cp-card,.cp-card.cp-wide,.cp-card.cp-full{grid-column:span 12}.cp-metrics{grid-template-columns:1fr}.cp-scroll,.cp-tall-scroll{height:340px}.cp-table-wrapper-mobile{display:none}.cp-mobile-list{display:block}}@media (max-width:520px){.cp-title{font-size:20px}.cp-card-header{align-items:flex-start;flex-direction:column}.cp-action-row .zcs-button{width:100%}}\n&lt;/style&gt;\n\n&lt;div class=&quot;client-portal&quot;&gt;\n\t&lt;div class=&quot;cp-shell&quot;&gt;\n&lt;%\n\tif(contactRows.count() == 0)\n\t{\n%&gt;\n\t\t&lt;div class=&quot;cp-header&quot;&gt;\n\t\t\t&lt;div class=&quot;cp-title-block&quot;&gt;\n\t\t\t\t&lt;p class=&quot;cp-kicker&quot;&gt;Client Portal&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&quot;cp-title&quot;&gt;We could not match your portal account&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;cp-subtitle&quot;&gt;Your sign-in email is not currently linked to an active client contact record.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-nodata-wrapper cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline users-single-02&quot; style=&quot;font-size:54px;color:var(--cp-primary);&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Please contact the firm to activate portal access&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;cp-empty-text&quot;&gt;Ask your matter team to verify that &lt;strong&gt;&lt;%=loginEmail%&gt;&lt;/strong&gt; is recorded as an active client contact. For privacy, this page shows case and billing information only after the contact match is confirmed.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tcontactRec = contactRows;\n\t\tclientRows = Add_Client[ID == contactRec.Client &amp;&amp; Client_Status != &quot;Blacklisted&quot;];\n\t\tif(clientRows.count() == 0)\n\t\t{\n%&gt;\n\t\t&lt;div class=&quot;cp-header&quot;&gt;\n\t\t\t&lt;div class=&quot;cp-title-block&quot;&gt;\n\t\t\t\t&lt;p class=&quot;cp-kicker&quot;&gt;Client Portal&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&quot;cp-title&quot;&gt;Client account unavailable&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;cp-subtitle&quot;&gt;Your contact is active, but the related client account is not available for portal viewing.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-nodata-wrapper cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot; style=&quot;font-size:54px;color:var(--cp-primary);&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Please contact the firm&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;cp-empty-text&quot;&gt;We are unable to show records for this account at this time. Your legal team can confirm the account status and portal access.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tclientRec = clientRows;\n\t\t\tclientName = ifnull(clientRec.Client_Name,&quot;Client&quot;);\n\t\t\tcaseCount = Create_Case[Client == clientRec.ID &amp;&amp; Case_Status != &quot;New Intake&quot; &amp;&amp; Case_Status != &quot;Conflict Check&quot; &amp;&amp; Case_Status != &quot;Engagement Pending&quot; &amp;&amp; Case_Status != &quot;Rejected&quot;].count();\n\t\t\thearingCount = Add_Hearing[Case.Client == clientRec.ID &amp;&amp; Hearing_DateTime &gt;= zoho.currenttime &amp;&amp; (Hearing_Status == &quot;Scheduled&quot; || Hearing_Status == &quot;Prepared&quot;) &amp;&amp; Case.Case_Status != &quot;New Intake&quot; &amp;&amp; Case.Case_Status != &quot;Conflict Check&quot; &amp;&amp; Case.Case_Status != &quot;Engagement Pending&quot; &amp;&amp; Case.Case_Status != &quot;Rejected&quot;].count();\n\t\t\tdocumentCount = Add_Case_Document[Visible_To_Client == true &amp;&amp; Case.Client == clientRec.ID].count();\n\t\t\thistoryCount = Add_Case_History[Visible_To_Client == true &amp;&amp; Case.Client == clientRec.ID].count();\n\t\t\tinvoiceCount = Create_Invoice[Client == clientRec.ID &amp;&amp; (Invoice_Status == &quot;Sent&quot; || Invoice_Status == &quot;Partially Paid&quot; || Invoice_Status == &quot;Paid&quot; || Invoice_Status == &quot;Overdue&quot;)].count();\n\t\t\tpaymentCount = Add_Payment[Client == clientRec.ID].count();\n\t\t\tinvoiceBalance = Create_Invoice[Client == clientRec.ID &amp;&amp; (Invoice_Status == &quot;Sent&quot; || Invoice_Status == &quot;Partially Paid&quot; || Invoice_Status == &quot;Overdue&quot;)].sum(Balance_Due);\n\t\t\tif(invoiceBalance == null){invoiceBalance = 0;}\n%&gt;\n\t\t&lt;div class=&quot;cp-header&quot;&gt;\n\t\t\t&lt;div class=&quot;cp-title-block&quot;&gt;\n\t\t\t\t&lt;p class=&quot;cp-kicker&quot;&gt;Client Portal&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&quot;cp-title&quot;&gt;Welcome, &lt;%=ifnull(contactRec.Contact_Name,zoho.loginuser)%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;cp-subtitle&quot;&gt;Secure view for &lt;%=clientName%&gt;. Only client-visible matter updates and client billing records are shown.&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;cp-trust-row&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-lock&quot;&gt;&lt;/i&gt; Client-visible records only&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt; &lt;%=caseCount%&gt; matters&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt; &lt;%=documentCount%&gt; shared documents&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cp-security-note&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Internal notes, conflict records, confidential documents, staff-only actions, drafts, and unavailable actions are excluded from this page.&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;cp-metrics&quot;&gt;\n\t\t\t&lt;div class=&quot;cp-metric&quot;&gt;&lt;label&gt;Visible Matters&lt;/label&gt;&lt;strong&gt;&lt;%=caseCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cp-metric&quot;&gt;&lt;label&gt;Upcoming Hearings&lt;/label&gt;&lt;strong&gt;&lt;%=hearingCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cp-metric&quot;&gt;&lt;label&gt;Shared Documents&lt;/label&gt;&lt;strong&gt;&lt;%=documentCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cp-metric&quot;&gt;&lt;label&gt;Client Updates&lt;/label&gt;&lt;strong&gt;&lt;%=historyCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cp-metric&quot;&gt;&lt;label&gt;Sent or Paid Invoices&lt;/label&gt;&lt;strong&gt;&lt;%=invoiceCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cp-metric&quot;&gt;&lt;label&gt;Open Balance&lt;/label&gt;&lt;strong&gt;$&lt;%=invoiceBalance%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;cp-grid&quot;&gt;\n&lt;%\n\t\t\tcaseRows = Create_Case[Client == clientRec.ID &amp;&amp; Case_Status != &quot;New Intake&quot; &amp;&amp; Case_Status != &quot;Conflict Check&quot; &amp;&amp; Case_Status != &quot;Engagement Pending&quot; &amp;&amp; Case_Status != &quot;Rejected&quot;] sort by Opened_On desc range from 1 to 8;\n%&gt;\n\t\t\t&lt;div class=&quot;cp-card cp-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cp-card-header&quot;&gt;&lt;div class=&quot;cp-card-title&quot;&gt;&lt;h2&gt;Case Summaries&lt;/h2&gt;&lt;p&gt;Public matter status and summaries for your client account&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cp-tall-scroll&quot;&gt;\n&lt;%\n\t\t\tif(caseRows.count() == 0)\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot; style=&quot;font-size:38px;color:var(--cp-muted);&quot;&gt;&lt;/i&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No client-visible matters yet&lt;/h5&gt;&lt;p class=&quot;cp-empty-text&quot;&gt;Your legal team will publish case information here when a matter is ready for client portal viewing.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-list&quot;&gt;\n&lt;%\n\t\t\t\tfor each caseRec in caseRows\n\t\t\t\t{\n\t\t\t\t\tcaseStatus = ifnull(caseRec.Case_Status,&quot;Status pending&quot;);\n\t\t\t\t\tcaseClass = &quot;cp-status-primary&quot;;\n\t\t\t\t\tif(caseStatus == &quot;Closed&quot; || caseStatus == &quot;Archived&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tcaseClass = &quot;cp-status-success&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(caseStatus == &quot;Billing Review&quot; || caseStatus == &quot;Awaiting Order or Execution&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tcaseClass = &quot;cp-status-warning&quot;;\n\t\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cp-record&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;cp-record-head&quot;&gt;&lt;div&gt;&lt;p class=&quot;cp-record-title&quot;&gt;&lt;%=ifnull(caseRec.Case_Title,&quot;Untitled matter&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-record-meta&quot;&gt;Case &lt;%=ifnull(caseRec.Case_Number,caseRec.ID)%&gt; · &lt;%=ifnull(caseRec.Practice_Area.Practice_Area_Name,&quot;Practice area not set&quot;)%&gt; · &lt;%=ifnull(caseRec.Case_Type.Case_Type_Name,&quot;Case type not set&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;cp-status-pill &lt;%=caseClass%&gt;&quot;&gt;&lt;%=caseStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;cp-record-desc&quot;&gt;&lt;%=ifnull(caseRec.Summary,&quot;No public summary has been posted yet.&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;cp-record-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Note?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Note_Type=Client%20Communication&amp;amp;Direction=Inbound&amp;amp;Contact_Email=&lt;%=loginEmail%&gt;&amp;amp;Visible_To_Client=true&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-email-85&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Send Message&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n&lt;%\n\t\t\thearingRows = Add_Hearing[Case.Client == clientRec.ID &amp;&amp; Hearing_DateTime &gt;= zoho.currenttime &amp;&amp; (Hearing_Status == &quot;Scheduled&quot; || Hearing_Status == &quot;Prepared&quot;) &amp;&amp; Case.Case_Status != &quot;New Intake&quot; &amp;&amp; Case.Case_Status != &quot;Conflict Check&quot; &amp;&amp; Case.Case_Status != &quot;Engagement Pending&quot; &amp;&amp; Case.Case_Status != &quot;Rejected&quot;] sort by Hearing_DateTime asc range from 1 to 8;\n%&gt;\n\t\t\t&lt;div class=&quot;cp-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cp-card-header&quot;&gt;&lt;div class=&quot;cp-card-title&quot;&gt;&lt;h2&gt;Upcoming Hearings&lt;/h2&gt;&lt;p&gt;Scheduled or prepared hearings for visible matters&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cp-tall-scroll&quot;&gt;\n&lt;%\n\t\t\tif(hearingRows.count() == 0)\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot; style=&quot;font-size:38px;color:var(--cp-muted);&quot;&gt;&lt;/i&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No upcoming hearings&lt;/h5&gt;&lt;p class=&quot;cp-empty-text&quot;&gt;Any scheduled client-visible hearing dates will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-list&quot;&gt;\n&lt;%\n\t\t\t\tfor each hear in hearingRows\n\t\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cp-record&quot;&gt;&lt;div class=&quot;cp-record-head&quot;&gt;&lt;div&gt;&lt;p class=&quot;cp-record-title&quot;&gt;&lt;%=ifnull(hear.Hearing_Type,&quot;Hearing&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-record-meta&quot;&gt;&lt;%=ifnull(hear.Hearing_DateTime,&quot;Date pending&quot;)%&gt; · &lt;%=ifnull(hear.Venue,&quot;Venue to be confirmed&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;cp-status-pill cp-status-info&quot;&gt;&lt;%=ifnull(hear.Hearing_Status,&quot;Scheduled&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;cp-record-desc&quot;&gt;&lt;%=ifnull(hear.Case.Case_Title,&quot;Matter&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-record-meta&quot;&gt;Court: &lt;%=ifnull(hear.Court.Court_Name,&quot;Not specified&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;cp-grid&quot;&gt;\n&lt;%\n\t\t\tdocumentRows = Add_Case_Document[Visible_To_Client == true &amp;&amp; Case.Client == clientRec.ID] sort by Document_Date desc range from 1 to 8;\n%&gt;\n\t\t\t&lt;div class=&quot;cp-card cp-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cp-card-header&quot;&gt;&lt;div class=&quot;cp-card-title&quot;&gt;&lt;h2&gt;Shared Documents&lt;/h2&gt;&lt;p&gt;Documents explicitly marked Visible to Client&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cp-scroll&quot;&gt;\n&lt;%\n\t\t\tif(documentRows.count() == 0)\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-copy-04&quot; style=&quot;font-size:38px;color:var(--cp-muted);&quot;&gt;&lt;/i&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No shared documents&lt;/h5&gt;&lt;p class=&quot;cp-empty-text&quot;&gt;Approved non-confidential documents will appear when your legal team marks them visible to client.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative cp-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full cp-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Document&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\t\tfor each doc in documentRows\n\t\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;cp-main&quot;&gt;&lt;%=ifnull(doc.Document_Title,&quot;Untitled document&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;cp-sub&quot;&gt;&lt;%=ifnull(doc.Document_Type.Document_Type_Name,&quot;Document&quot;)%&gt; · Version &lt;%=ifnull(doc.Version_Number,1)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(doc.Case.Case_Title,&quot;Matter&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(doc.Document_Date,&quot;Not dated&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;cp-status-pill cp-status-success&quot;&gt;&lt;%=ifnull(doc.Document_Status,&quot;Shared&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;cp-mobile-list&quot;&gt;\n&lt;%\n\t\t\t\tfor each doc in documentRows\n\t\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cp-mobile-card&quot;&gt;&lt;p class=&quot;cp-mobile-card-title&quot;&gt;&lt;%=ifnull(doc.Document_Title,&quot;Untitled document&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-mobile-card-line&quot;&gt;&lt;%=ifnull(doc.Case.Case_Title,&quot;Matter&quot;)%&gt; · &lt;%=ifnull(doc.Document_Date,&quot;Not dated&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-mobile-card-line&quot;&gt;&lt;%=ifnull(doc.Document_Type.Document_Type_Name,&quot;Document&quot;)%&gt; · &lt;%=ifnull(doc.Document_Status,&quot;Shared&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n&lt;%\n\t\t\thistoryRows = Add_Case_History[Visible_To_Client == true &amp;&amp; Case.Client == clientRec.ID] sort by Event_Date desc range from 1 to 8;\n%&gt;\n\t\t\t&lt;div class=&quot;cp-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cp-card-header&quot;&gt;&lt;div class=&quot;cp-card-title&quot;&gt;&lt;h2&gt;Recent Updates&lt;/h2&gt;&lt;p&gt;Client-visible matter history&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cp-scroll&quot;&gt;\n&lt;%\n\t\t\tif(historyRows.count() == 0)\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-notification-69&quot; style=&quot;font-size:38px;color:var(--cp-muted);&quot;&gt;&lt;/i&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No public updates&lt;/h5&gt;&lt;p class=&quot;cp-empty-text&quot;&gt;Client-visible updates will be posted here by your matter team.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-list&quot;&gt;\n&lt;%\n\t\t\t\tfor each hist in historyRows\n\t\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cp-record&quot;&gt;&lt;div class=&quot;cp-record-head&quot;&gt;&lt;div&gt;&lt;p class=&quot;cp-record-title&quot;&gt;&lt;%=ifnull(hist.Event_Type,&quot;Update&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-record-meta&quot;&gt;&lt;%=ifnull(hist.Event_Date,&quot;Date pending&quot;)%&gt; · &lt;%=ifnull(hist.Case.Case_Title,&quot;Matter&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;cp-status-pill cp-status-primary&quot;&gt;&lt;%=ifnull(hist.New_Status,&quot;Update&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;cp-record-desc&quot;&gt;&lt;%=ifnull(hist.Summary,&quot;No update details provided.&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;cp-grid&quot;&gt;\n&lt;%\n\t\t\tinvoiceRows = Create_Invoice[Client == clientRec.ID &amp;&amp; (Invoice_Status == &quot;Sent&quot; || Invoice_Status == &quot;Partially Paid&quot; || Invoice_Status == &quot;Paid&quot; || Invoice_Status == &quot;Overdue&quot;)] sort by Invoice_Date desc range from 1 to 8;\n%&gt;\n\t\t\t&lt;div class=&quot;cp-card cp-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cp-card-header&quot;&gt;&lt;div class=&quot;cp-card-title&quot;&gt;&lt;h2&gt;Invoices&lt;/h2&gt;&lt;p&gt;Sent, partially paid, paid, and overdue invoices for your client account&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cp-scroll&quot;&gt;\n&lt;%\n\t\t\tif(invoiceRows.count() == 0)\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-11&quot; style=&quot;font-size:38px;color:var(--cp-muted);&quot;&gt;&lt;/i&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No client invoices&lt;/h5&gt;&lt;p class=&quot;cp-empty-text&quot;&gt;Invoices will appear here after they are sent by the firm or marked paid.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative cp-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full cp-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Total&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Balance&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\t\tfor each inv in invoiceRows\n\t\t\t\t{\n\t\t\t\t\tinvStatus = ifnull(inv.Invoice_Status,&quot;Sent&quot;);\n\t\t\t\t\tinvClass = &quot;cp-status-info&quot;;\n\t\t\t\t\tif(invStatus == &quot;Paid&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tinvClass = &quot;cp-status-success&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(invStatus == &quot;Overdue&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tinvClass = &quot;cp-status-danger&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(invStatus == &quot;Partially Paid&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tinvClass = &quot;cp-status-warning&quot;;\n\t\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;cp-main&quot;&gt;&lt;%=ifnull(inv.Invoice_Number,inv.ID)%&gt;&lt;/div&gt;&lt;div class=&quot;cp-sub&quot;&gt;&lt;%=ifnull(inv.Invoice_Date,&quot;Not dated&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(inv.Case.Case_Title,&quot;Matter&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(inv.Due_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(inv.Total_Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(inv.Balance_Due,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;cp-status-pill &lt;%=invClass%&gt;&quot;&gt;&lt;%=invStatus%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;cp-mobile-list&quot;&gt;\n&lt;%\n\t\t\t\tfor each inv in invoiceRows\n\t\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cp-mobile-card&quot;&gt;&lt;p class=&quot;cp-mobile-card-title&quot;&gt;Invoice &lt;%=ifnull(inv.Invoice_Number,inv.ID)%&gt; · $&lt;%=ifnull(inv.Total_Amount,0)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-mobile-card-line&quot;&gt;&lt;%=ifnull(inv.Case.Case_Title,&quot;Matter&quot;)%&gt; · Due &lt;%=ifnull(inv.Due_Date,&quot;Not set&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cp-mobile-card-line&quot;&gt;&lt;%=ifnull(inv.Invoice_Status,&quot;Sent&quot;)%&gt; · Balance $&lt;%=ifnull(inv.Balance_Due,0)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n&lt;%\n\t\t\tpaymentRows = Add_Payment[Client == clientRec.ID] sort by Payment_Date desc range from 1 to 8;\n%&gt;\n\t\t\t&lt;div class=&quot;cp-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cp-card-header&quot;&gt;&lt;div class=&quot;cp-card-title&quot;&gt;&lt;h2&gt;Payments&lt;/h2&gt;&lt;p&gt;Payments recorded for your client account&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cp-scroll&quot;&gt;\n&lt;%\n\t\t\tif(paymentRows.count() == 0)\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot; style=&quot;font-size:38px;color:var(--cp-muted);&quot;&gt;&lt;/i&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No payments recorded&lt;/h5&gt;&lt;p class=&quot;cp-empty-text&quot;&gt;Payment receipts and reconciliations will appear when posted by the firm.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cp-list&quot;&gt;\n&lt;%\n\t\t\t\tfor each pay in paymentRows\n\t\t\t\t{\n\t\t\t\t\tpayStatus = ifnull(pay.Payment_Status,&quot;Received&quot;);\n\t\t\t\t\tpayClass = &quot;cp-status-success&quot;;\n\t\t\t\t\tif(payStatus == &quot;Bounced&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tpayClass = &quot;cp-status-danger&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(payStatus == &quot;Refunded&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tpayClass = &quot;cp-status-warning&quot;;\n\t\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cp-record&quot;&gt;&lt;div class=&quot;cp-record-head&quot;&gt;&lt;div&gt;&lt;p class=&quot;cp-record-title&quot;&gt;$&lt;%=ifnull(pay.Amount,0)%&gt; payment&lt;/p&gt;&lt;p class=&quot;cp-record-meta&quot;&gt;&lt;%=ifnull(pay.Payment_Date,&quot;Date pending&quot;)%&gt; · &lt;%=ifnull(pay.Payment_Mode,&quot;Mode not set&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;cp-status-pill &lt;%=payClass%&gt;&quot;&gt;&lt;%=payStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;cp-record-desc&quot;&gt;Invoice &lt;%=ifnull(pay.Invoice.Invoice_Number,pay.Invoice)%&gt; · Reference &lt;%=ifnull(pay.Reference_Number,&quot;Not provided&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;cp-alert&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-lock&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;&lt;strong&gt;Privacy notice&lt;/strong&gt;&lt;div&gt;This portal intentionally omits internal notes, confidential evidence, conflict checks, staff-only tasks, draft invoices, and legal team actions. Contact the firm if you believe a client-visible item is missing.&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Compliance_Audit_Dashboard
		{
					displayname = "Compliance Audit Dashboard"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Compliance_Audit_Main' elementName='Compliance_Audit_Main' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage Compliance_Audit_Main()\n\t\t\t\t\t\tcontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tconflictRiskCount = Add_Conflict_Check[Decision == &quot;Conflict Found&quot; || Decision == &quot;Waiver Required&quot;].count();\n\thighConfidentialDocCount = Add_Case_Document[Confidentiality_Level == &quot;Highly Confidential&quot;].count();\n\tmissedDeadlineCount = Add_Deadline[Deadline_Status == &quot;Missed&quot; || (Deadline_Date &lt; zoho.currentdate &amp;&amp; (Deadline_Status == &quot;Open&quot; || Deadline_Status == &quot;Extended&quot;))].count();\n\toverdueTaskCount = Add_Case_Task[Task_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Cancelled&quot;)].count();\n\trejectedWaiverConflictCount = Add_Conflict_Check[Decision == &quot;Waiver Required&quot; || Approval_Status == &quot;Rejected&quot;].count();\n\tcancelledInvoiceCount = Create_Invoice[Invoice_Status == &quot;Cancelled&quot;].count();\n\toverdueInvoiceCount = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)].count();\n\trecentHistoryCount = Add_Case_History[Event_Date &gt;= zoho.currenttime.subDay(14)].count();\n\toverdueInvoiceBalance = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)].sum(Balance_Due);\n\tif(overdueInvoiceBalance == null)\n\t{\n\t\toverdueInvoiceBalance = 0;\n\t}\n\tcancelledInvoiceTotal = Create_Invoice[Invoice_Status == &quot;Cancelled&quot;].sum(Total_Amount);\n\tif(cancelledInvoiceTotal == null)\n\t{\n\t\tcancelledInvoiceTotal = 0;\n\t}\n\tconflictRiskRows = Add_Conflict_Check[Decision == &quot;Conflict Found&quot; || Decision == &quot;Waiver Required&quot;] sort by Checked_On desc range from 1 to 8;\n\thighConfidentialDocRows = Add_Case_Document[Confidentiality_Level == &quot;Highly Confidential&quot;] sort by Document_Date desc range from 1 to 8;\n\tmissedDeadlineRows = Add_Deadline[Deadline_Status == &quot;Missed&quot; || (Deadline_Date &lt; zoho.currentdate &amp;&amp; (Deadline_Status == &quot;Open&quot; || Deadline_Status == &quot;Extended&quot;))] sort by Deadline_Date asc range from 1 to 8;\n\toverdueTaskRows = Add_Case_Task[Task_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Task_Status != &quot;Completed&quot; &amp;&amp; Task_Status != &quot;Cancelled&quot;)] sort by Due_Date asc range from 1 to 8;\n\trejectedWaiverConflictRows = Add_Conflict_Check[Decision == &quot;Waiver Required&quot; || Approval_Status == &quot;Rejected&quot;] sort by Checked_On desc range from 1 to 8;\n\tcancelledInvoiceRows = Create_Invoice[Invoice_Status == &quot;Cancelled&quot;] sort by Invoice_Date desc range from 1 to 8;\n\toverdueInvoiceRows = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)] sort by Due_Date asc range from 1 to 8;\n\thistoryRows = Add_Case_History[ID != 0] sort by Event_Date desc range from 1 to 10;\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility subset included once for this page ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);\n\t--zcs_brand_color: #6147E5;\n\t--zcs_brand_foreground_color: #FFFFFF;\n\t--zcs_brand_dark_color: #4E38C8;\n\t--zcs_brand_light_color: #F1EEFF;\n\t--zcs_primary_text_color: #17142F;\n\t--zcs_secondary_text_color: #4F5873;\n\t--zcs_tertiary_text_color: #7A8094;\n\t--zcs_tertiary_border_color: #E7E8F0;\n\t--zcs_primary_border_color: #E0E2EA;\n\t--zcs_component_hover_color: #F4F1FF;\n\t--zcs_light_grey_color: #F7F8FC;\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-page-bg-color: #F6F7FB;\n\t--audit-primary: #6147E5;\n\t--audit-primary-dark: #4E38C8;\n\t--audit-primary-light: #F1EEFF;\n\t--audit-bg: #F6F7FB;\n\t--audit-surface: #FFFFFF;\n\t--audit-border: #E7E8F0;\n\t--audit-text: #17142F;\n\t--audit-muted: #667085;\n\t--audit-success: #179E6C;\n\t--audit-warning: #B8770D;\n\t--audit-danger: #D92D20;\n\t--audit-info: #2A6FFC;\n\t--audit-gap: 15px;\n\t--audit-radius: 12px;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-10{padding:10px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-8{padding-left:8px;padding-right:8px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-5{padding-top:5px;padding-bottom:5px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-30{font-size:30px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n\n/* ===== ZCS component CSS: card-template adapted without action footer ===== */\n.zcs-template-card{width:auto;height:auto;overflow:hidden}.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-card-content{min-height:0}.zcs-card-content-inner{min-width:0}.zcs-template-card .zcs-card-footer{display:none}\n\n/* ===== ZCS component CSS: badge-badge-with-icon ===== */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#D92D20}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#E8E8E8;border-color:#667085;color:#475467}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#B8770D}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#F4660C}\n\n/* ===== ZCS component CSS: table-simple-table ===== */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table thead tr th.zcs-green,.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table thead tr th.zcs-red,.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#D92D20}.zcs-table-wrapper table thead tr th.zcs-yellow,.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table thead tr th.zcs-blue,.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}\n\n/* ===== Compliance Audit Dashboard approved CSS block ===== */\n*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.compliance-audit-dashboard{width:100%;min-height:100%;background:var(--audit-bg);color:var(--audit-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--audit-gap);overflow:auto}.audit-shell{display:flex;flex-direction:column;gap:var(--audit-gap);max-width:1600px;margin:0 auto}.audit-header{display:flex;justify-content:space-between;align-items:center;gap:var(--audit-gap);padding:15px;border:1px solid var(--audit-border);border-radius:var(--audit-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.audit-title-block{min-width:0}.audit-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--audit-primary);margin:0 0 4px}.audit-title{font-size:22px;line-height:1.2;font-weight:700;color:var(--audit-text);margin:0}.audit-subtitle{margin:6px 0 0;color:var(--audit-muted);max-width:940px}.audit-readonly-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(97,71,229,.18);background:#FFFFFF;color:var(--audit-primary);border-radius:999px;padding:7px 12px;font-size:13px;font-weight:700;white-space:nowrap}.audit-readonly-pill i{font-size:16px}.audit-kpi-grid{display:grid;grid-template-columns:repeat(8,minmax(140px,1fr));gap:var(--audit-gap)}.audit-kpi{min-height:126px;border-color:var(--audit-border);box-shadow:0 2px 8px rgba(23,20,47,.04)}.audit-kpi .zcs-card-header{padding:12px 14px;background:#fff}.audit-kpi .zcs-card-content{padding:14px}.audit-kpi-title{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--audit-muted);font-weight:700;margin:0}.audit-kpi-value{font-size:26px;line-height:1.1;font-weight:800;color:var(--audit-text);margin:0}.audit-kpi-note{font-size:12px;color:var(--audit-muted);margin:5px 0 0}.audit-icon{width:38px;height:38px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.audit-icon.red{background:#FDE3E6;color:var(--audit-danger)}.audit-icon.yellow{background:#FCF4E6;color:var(--audit-warning)}.audit-icon.blue{background:#E8EFFF;color:var(--audit-info)}.audit-icon.violet{background:var(--audit-primary-light);color:var(--audit-primary)}.audit-icon.grey{background:#F2F4F7;color:#475467}.audit-section-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--audit-gap);align-items:start}.audit-section{grid-column:span 6;background:var(--audit-surface);border:1px solid var(--audit-border);border-radius:var(--audit-radius);overflow:hidden;min-height:365px;display:flex;flex-direction:column}.audit-section.audit-wide{grid-column:span 12}.audit-section-header{display:flex;justify-content:space-between;align-items:center;gap:var(--audit-gap);padding:15px;border-bottom:1px solid var(--audit-border);background:#fff}.audit-section-title{display:flex;align-items:flex-start;gap:10px;min-width:0}.audit-section-title h2{font-size:16px;line-height:1.25;font-weight:800;color:var(--audit-text);margin:0}.audit-section-title p{font-size:12px;color:var(--audit-muted);margin:2px 0 0}.audit-section-icon{width:34px;height:34px;border-radius:9px;background:var(--audit-primary-light);color:var(--audit-primary);display:inline-flex;align-items:center;justify-content:center;font-size:16px;flex:0 0 auto}.audit-scroll{height:285px;overflow:auto;padding:15px}.audit-table{min-width:760px}.audit-table.compact{min-width:640px}.audit-table.history{min-width:880px}.audit-main{font-weight:700;color:var(--audit-text)}.audit-sub{font-size:12px;color:var(--audit-muted);margin-top:2px}.audit-link{color:var(--audit-primary);font-weight:700}.audit-link:hover{color:var(--audit-primary-dark);text-decoration:underline}.audit-status-pill{font-size:12px;font-weight:700;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:220px}.audit-status-primary{background:#F1EEFF;color:var(--audit-primary)}.audit-status-success{background:#E4FCF3;color:var(--audit-success)}.audit-status-warning{background:#FCF4E6;color:var(--audit-warning)}.audit-status-danger{background:#FDE3E6;color:var(--audit-danger)}.audit-status-info{background:#E8EFFF;color:var(--audit-info)}.audit-status-grey{background:#F2F4F7;color:#475467}.audit-summary-line{display:flex;gap:8px;align-items:center;color:var(--audit-muted);font-size:12px;margin-top:6px;flex-wrap:wrap}.audit-metric-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--audit-gap);margin-bottom:15px}.audit-mini-card{border:1px solid var(--audit-border);border-radius:var(--audit-radius);padding:15px;background:#fff}.audit-mini-card label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.03em;font-weight:800;color:var(--audit-muted);margin-bottom:5px}.audit-mini-card strong{display:block;font-size:22px;line-height:1.15;color:var(--audit-text);word-break:break-word}.zcs-nodata-wrapper{min-height:180px;border:1px dashed var(--audit-border);border-radius:var(--audit-radius);background:#FCFCFF}.zcs-nodata-header{font-size:15px}.audit-empty-text{color:var(--audit-muted);margin:6px 0 0}.audit-mobile-list{display:none}.audit-mobile-card{border:1px solid var(--audit-border);border-radius:var(--audit-radius);padding:12px;background:#fff;margin-bottom:10px}.audit-mobile-card:last-child{margin-bottom:0}.audit-mobile-title{font-weight:800;margin:0 0 4px;color:var(--audit-text)}.audit-mobile-line{font-size:12px;color:var(--audit-muted);margin:2px 0}.audit-mobile-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1400px){.audit-kpi-grid{grid-template-columns:repeat(4,minmax(160px,1fr))}}@media (max-width:1024px){.audit-section{grid-column:span 12}.audit-metric-row{grid-template-columns:1fr}}@media (max-width:768px){.compliance-audit-dashboard{padding:15px}.audit-header{align-items:flex-start;flex-direction:column}.audit-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.audit-section{min-height:auto}.audit-scroll{height:320px}.audit-table-wrapper-mobile{display:none}.audit-mobile-list{display:block}.audit-section-header{align-items:flex-start;flex-direction:column}.audit-readonly-pill{white-space:normal}}@media (max-width:520px){.audit-kpi-grid{grid-template-columns:1fr}.audit-title{font-size:20px}}\n&lt;/style&gt;\n\n&lt;div class=&quot;compliance-audit-dashboard&quot;&gt;\n\t&lt;div class=&quot;audit-shell&quot;&gt;\n\t\t&lt;section class=&quot;audit-header&quot;&gt;\n\t\t\t&lt;div class=&quot;audit-title-block&quot;&gt;\n\t\t\t\t&lt;p class=&quot;audit-kicker&quot;&gt;Compliance Oversight&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&quot;audit-title&quot;&gt;Compliance Audit Dashboard&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;audit-subtitle&quot;&gt;Read-only oversight for conflicts, confidential documents, lifecycle changes, missed legal obligations, overdue work, and billing exceptions.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;audit-readonly-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span&gt;Read-only audit view&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;audit-kpi-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Conflict or Waiver&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon red&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=conflictRiskCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Conflict found or waiver required&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Highly Confidential&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon violet&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-14&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=highConfidentialDocCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Restricted document oversight&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Missed Deadlines&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon red&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=missedDeadlineCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Missed or past due open items&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Overdue Tasks&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon yellow&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=overdueTaskCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Open tasks past due&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Rejected or Waiver&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon blue&quot;&gt;&lt;i class=&quot;zc-li-outline business-hammer&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=rejectedWaiverConflictCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Waiver or rejected approvals&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Cancelled Invoices&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon grey&quot;&gt;&lt;i class=&quot;zc-li-outline files-paper&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=cancelledInvoiceCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Total $&lt;%=cancelledInvoiceTotal%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Overdue Invoices&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon red&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=overdueInvoiceCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Balance $&lt;%=overdueInvoiceBalance%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi&quot;&gt;&lt;div class=&quot;zcs-card-header zcs-box-border&quot;&gt;&lt;h6 class=&quot;audit-kpi-title&quot;&gt;Recent History&lt;/h6&gt;&lt;/div&gt;&lt;div class=&quot;zcs-card-content zcs-col-common zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;&lt;span class=&quot;audit-icon violet&quot;&gt;&lt;i class=&quot;zc-li-outline files-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;p class=&quot;audit-kpi-value&quot;&gt;&lt;%=recentHistoryCount%&gt;&lt;/p&gt;&lt;p class=&quot;audit-kpi-note&quot;&gt;Events in the last 14 days&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;audit-section-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;audit-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Conflict Found or Waiver Required&lt;/h2&gt;&lt;p&gt;Potential conflicts requiring partner, waiver, or rejection oversight.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=conflictRiskCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(conflictRiskRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No conflict exceptions&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No conflict found or waiver-required checks are currently recorded.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Opposing Party&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Decision&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Severity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Checked&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each conflict in conflictRiskRows { decisionClass = if(conflict.Decision == &quot;Conflict Found&quot;,&quot;audit-status-danger&quot;,&quot;audit-status-warning&quot;); %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;% if(conflict.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=conflict.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(conflict.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(conflict.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(conflict.Client.Client_Name,&quot;No client&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(conflict.Opposing_Party_Name,&quot;Not recorded&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=decisionClass%&gt;&quot;&gt;&lt;%=ifnull(conflict.Decision,&quot;No decision&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-grey&quot;&gt;&lt;%=ifnull(conflict.Conflict_Severity,&quot;No severity&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;%=ifnull(conflict.Checked_On,&quot;No date&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(conflict.Checked_By.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each conflictCard in conflictRiskRows { cClass = if(conflictCard.Decision == &quot;Conflict Found&quot;,&quot;audit-status-danger&quot;,&quot;audit-status-warning&quot;); %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;% if(conflictCard.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=conflictCard.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(conflictCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(conflictCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;%=ifnull(conflictCard.Opposing_Party_Name,&quot;Not recorded&quot;)%&gt; · &lt;%=ifnull(conflictCard.Client.Client_Name,&quot;No client&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=cClass%&gt;&quot;&gt;&lt;%=ifnull(conflictCard.Decision,&quot;No decision&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;audit-status-pill audit-status-grey&quot;&gt;&lt;%=ifnull(conflictCard.Conflict_Severity,&quot;No severity&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-14&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Highly Confidential Documents&lt;/h2&gt;&lt;p&gt;Document records that require strict visibility and sharing oversight.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-folder-14&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=highConfidentialDocCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(highConfidentialDocRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No highly confidential documents&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No documents are currently marked highly confidential.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Document&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Review Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Client Visible&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each doc in highConfidentialDocRows { visibleClass = if(doc.Visible_To_Client == true,&quot;audit-status-danger&quot;,&quot;audit-status-success&quot;); visibleText = if(doc.Visible_To_Client == true,&quot;Client visible&quot;,&quot;Internal only&quot;); %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;%=ifnull(doc.Document_Title,&quot;Untitled document&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(doc.Document_Type.Document_Type_Name,&quot;No type&quot;)%&gt; · Version &lt;%=ifnull(doc.Version_Number,&quot;1&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;% if(doc.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=doc.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(doc.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(doc.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-primary&quot;&gt;&lt;%=ifnull(doc.Document_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(doc.Review_Due_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=visibleClass%&gt;&quot;&gt;&lt;%=visibleText%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each docCard in highConfidentialDocRows { vClass = if(docCard.Visible_To_Client == true,&quot;audit-status-danger&quot;,&quot;audit-status-success&quot;); vText = if(docCard.Visible_To_Client == true,&quot;Client visible&quot;,&quot;Internal only&quot;); %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;%=ifnull(docCard.Document_Title,&quot;Untitled document&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;% if(docCard.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=docCard.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(docCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(docCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-primary&quot;&gt;&lt;%=ifnull(docCard.Document_Status,&quot;No status&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;audit-status-pill &lt;%=vClass%&gt;&quot;&gt;&lt;%=vText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Missed Deadlines&lt;/h2&gt;&lt;p&gt;Deadlines marked missed or past due while still open or extended.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=missedDeadlineCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(missedDeadlineRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No missed deadlines&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No missed or past-due open deadlines are currently visible.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Deadline&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Responsible&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each deadline in missedDeadlineRows { deadlineClass = if(deadline.Priority == &quot;Critical&quot;,&quot;audit-status-danger&quot;,if(deadline.Priority == &quot;High&quot;,&quot;audit-status-warning&quot;,&quot;audit-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;%=ifnull(deadline.Deadline_Type,&quot;Deadline&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(deadline.Deadline_Date,&quot;No date&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;% if(deadline.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=deadline.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(deadline.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(deadline.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(deadline.Responsible_Attorney.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=deadlineClass%&gt;&quot;&gt;&lt;%=ifnull(deadline.Priority,&quot;No priority&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-danger&quot;&gt;&lt;%=ifnull(deadline.Deadline_Status,&quot;Past due&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each deadlineCard in missedDeadlineRows { dClass = if(deadlineCard.Priority == &quot;Critical&quot;,&quot;audit-status-danger&quot;,if(deadlineCard.Priority == &quot;High&quot;,&quot;audit-status-warning&quot;,&quot;audit-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;%=ifnull(deadlineCard.Deadline_Type,&quot;Deadline&quot;)%&gt; · &lt;%=ifnull(deadlineCard.Deadline_Date,&quot;No date&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;% if(deadlineCard.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=deadlineCard.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(deadlineCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(deadlineCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=dClass%&gt;&quot;&gt;&lt;%=ifnull(deadlineCard.Priority,&quot;No priority&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;audit-status-pill audit-status-danger&quot;&gt;&lt;%=ifnull(deadlineCard.Deadline_Status,&quot;Past due&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Overdue Tasks&lt;/h2&gt;&lt;p&gt;Open matter tasks past due or explicitly marked overdue.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=overdueTaskCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(overdueTaskRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No overdue tasks&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No missed open assignments are currently visible.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Task&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Assigned&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each task in overdueTaskRows { taskClass = if(task.Priority == &quot;Critical&quot;,&quot;audit-status-danger&quot;,if(task.Priority == &quot;High&quot;,&quot;audit-status-warning&quot;,&quot;audit-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;%=ifnull(task.Task_Title,&quot;Untitled task&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(task.Task_Type,&quot;Task&quot;)%&gt; · &lt;%=ifnull(task.Priority,&quot;No priority&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;% if(task.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=task.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(task.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(task.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(task.Assigned_To.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(task.Due_Date,&quot;No due date&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=taskClass%&gt;&quot;&gt;&lt;%=ifnull(task.Task_Status,&quot;Overdue&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each taskCard in overdueTaskRows { tClass = if(taskCard.Priority == &quot;Critical&quot;,&quot;audit-status-danger&quot;,if(taskCard.Priority == &quot;High&quot;,&quot;audit-status-warning&quot;,&quot;audit-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;%=ifnull(taskCard.Task_Title,&quot;Untitled task&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;% if(taskCard.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=taskCard.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(taskCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(taskCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;Assigned: &lt;%=ifnull(taskCard.Assigned_To.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt; · Due &lt;%=ifnull(taskCard.Due_Date,&quot;No due date&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=tClass%&gt;&quot;&gt;&lt;%=ifnull(taskCard.Task_Status,&quot;Overdue&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-hammer&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Rejected or Waiver Conflict Checks&lt;/h2&gt;&lt;p&gt;Waiver-needed or rejected approval records requiring compliance follow-up.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-hammer&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=rejectedWaiverConflictCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(rejectedWaiverConflictRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No waiver or rejected conflict checks&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No waiver-needed or rejected conflict approval records are currently visible.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Decision&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Approval&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Checked By&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Checked On&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each waiver in rejectedWaiverConflictRows { approvalClass = if(waiver.Approval_Status == &quot;Rejected&quot;,&quot;audit-status-danger&quot;,if(waiver.Decision == &quot;Waiver Required&quot;,&quot;audit-status-warning&quot;,&quot;audit-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;% if(waiver.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=waiver.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(waiver.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(waiver.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(waiver.Opposing_Party_Name,&quot;No opposing party&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-warning&quot;&gt;&lt;%=ifnull(waiver.Decision,&quot;No decision&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill &lt;%=approvalClass%&gt;&quot;&gt;&lt;%=ifnull(waiver.Approval_Status,&quot;No approval status&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(waiver.Checked_By.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(waiver.Checked_On,&quot;No date&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each waiverCard in rejectedWaiverConflictRows { wClass = if(waiverCard.Approval_Status == &quot;Rejected&quot;,&quot;audit-status-danger&quot;,if(waiverCard.Decision == &quot;Waiver Required&quot;,&quot;audit-status-warning&quot;,&quot;audit-status-info&quot;)); %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;% if(waiverCard.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=waiverCard.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(waiverCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(waiverCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;%=ifnull(waiverCard.Opposing_Party_Name,&quot;No opposing party&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-warning&quot;&gt;&lt;%=ifnull(waiverCard.Decision,&quot;No decision&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;audit-status-pill &lt;%=wClass%&gt;&quot;&gt;&lt;%=ifnull(waiverCard.Approval_Status,&quot;No approval status&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-paper&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Cancelled Invoices&lt;/h2&gt;&lt;p&gt;Invoice cancellations retained for billing exception review.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-paper&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=cancelledInvoiceCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;audit-metric-row&quot;&gt;&lt;div class=&quot;audit-mini-card&quot;&gt;&lt;label&gt;Cancelled invoice count&lt;/label&gt;&lt;strong&gt;&lt;%=cancelledInvoiceCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;audit-mini-card&quot;&gt;&lt;label&gt;Cancelled invoice total&lt;/label&gt;&lt;strong&gt;$&lt;%=cancelledInvoiceTotal%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% if(cancelledInvoiceRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No cancelled invoices&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No invoices are currently cancelled.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Client&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Total&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Invoice Date&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each cancelled in cancelledInvoiceRows { %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Billing_Detail?Invoice_ID=&lt;%=cancelled.ID%&gt;&quot;&gt;Invoice &lt;%=ifnull(cancelled.Invoice_Number,&quot;Pending number&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(cancelled.Invoice_Status,&quot;Cancelled&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(cancelled.Client.Client_Name,&quot;No client&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;% if(cancelled.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=cancelled.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(cancelled.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(cancelled.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;$&lt;%=ifnull(cancelled.Total_Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(cancelled.Invoice_Date,&quot;No date&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each cancelledCard in cancelledInvoiceRows { %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Billing_Detail?Invoice_ID=&lt;%=cancelledCard.ID%&gt;&quot;&gt;Invoice &lt;%=ifnull(cancelledCard.Invoice_Number,&quot;Pending number&quot;)%&gt;&lt;/a&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;%=ifnull(cancelledCard.Client.Client_Name,&quot;No client&quot;)%&gt; · $&lt;%=ifnull(cancelledCard.Total_Amount,0)%&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-grey&quot;&gt;&lt;%=ifnull(cancelledCard.Invoice_Status,&quot;Cancelled&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-section audit-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Overdue Invoices&lt;/h2&gt;&lt;p&gt;Invoices marked overdue or past due with an open balance.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=overdueInvoiceCount%&gt; · $&lt;%=overdueInvoiceBalance%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(overdueInvoiceRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No overdue invoices&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No past-due open balances are currently visible.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Client&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Balance Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each invoice in overdueInvoiceRows { %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Billing_Detail?Invoice_ID=&lt;%=invoice.ID%&gt;&quot;&gt;Invoice &lt;%=ifnull(invoice.Invoice_Number,&quot;Pending number&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(invoice.Invoice_Date,&quot;No invoice date&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(invoice.Client.Client_Name,&quot;No client&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;% if(invoice.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=invoice.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(invoice.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(invoice.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-red&quot;&gt;$&lt;%=ifnull(invoice.Balance_Due,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(invoice.Due_Date,&quot;No due date&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-danger&quot;&gt;&lt;%=ifnull(invoice.Invoice_Status,&quot;Overdue&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each invoiceCard in overdueInvoiceRows { %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Billing_Detail?Invoice_ID=&lt;%=invoiceCard.ID%&gt;&quot;&gt;Invoice &lt;%=ifnull(invoiceCard.Invoice_Number,&quot;Pending number&quot;)%&gt;&lt;/a&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;%=ifnull(invoiceCard.Client.Client_Name,&quot;No client&quot;)%&gt; · Balance $&lt;%=ifnull(invoiceCard.Balance_Due,0)%&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;Due &lt;%=ifnull(invoiceCard.Due_Date,&quot;No due date&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-danger&quot;&gt;&lt;%=ifnull(invoiceCard.Invoice_Status,&quot;Overdue&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-section audit-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-header&quot;&gt;&lt;div class=&quot;audit-section-title&quot;&gt;&lt;span class=&quot;audit-section-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;h2&gt;Recent Case History Events&lt;/h2&gt;&lt;p&gt;Latest Add Case History events across lifecycle, conflict, document, task, deadline, and billing changes.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=recentHistoryCount%&gt; in 14 days&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-scroll&quot;&gt;\n\t\t\t\t\t&lt;% if(historyRows.count() == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No history events&lt;/h5&gt;&lt;p class=&quot;audit-empty-text&quot;&gt;No Add Case History events are currently available.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full audit-table history&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Event&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Matter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status Change&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Changed By&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Summary&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;% for each hist in historyRows { %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;%=ifnull(hist.Event_Type,&quot;Event&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;&lt;%=ifnull(hist.Event_Date,&quot;No date&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;% if(hist.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=hist.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(hist.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(hist.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;audit-main&quot;&gt;&lt;%=ifnull(hist.Previous_Status,&quot;Not recorded&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;audit-sub&quot;&gt;to &lt;%=ifnull(hist.New_Status,&quot;Not recorded&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(hist.Changed_By.Employee_Name.first_name,&quot;System&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(hist.Summary,&quot;No summary&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-list&quot;&gt;\n\t\t\t\t\t\t&lt;% for each histCard in historyRows { %&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-mobile-card&quot;&gt;&lt;p class=&quot;audit-mobile-title&quot;&gt;&lt;%=ifnull(histCard.Event_Type,&quot;Event&quot;)%&gt; · &lt;%=ifnull(histCard.Event_Date,&quot;No date&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;% if(histCard.Case != null) { %&gt;&lt;a class=&quot;audit-link&quot; href=&quot;#Page:Case_Detail?Case_ID=&lt;%=histCard.Case.ID%&gt;&quot;&gt;&lt;%=ifnull(histCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;%=ifnull(histCard.Case.Case_Title,&quot;No matter&quot;)%&gt;&lt;% } %&gt;&lt;/p&gt;&lt;p class=&quot;audit-mobile-line&quot;&gt;&lt;%=ifnull(histCard.Summary,&quot;No summary&quot;)%&gt;&lt;/p&gt;&lt;div class=&quot;audit-mobile-meta&quot;&gt;&lt;span class=&quot;audit-status-pill audit-status-primary&quot;&gt;&lt;%=ifnull(histCard.Previous_Status,&quot;Not recorded&quot;)%&gt; to &lt;%=ifnull(histCard.New_Status,&quot;Not recorded&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Confirmation_Page
		{
					displayname = "Confirmation Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet8' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet8()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.zc-pra-nodata {\n\t\ttext-align: center;\n}\n.zc-pra-nodata-content {\n\t\tposition: absolute;\n\t\ttop: 50%;\n\t\tleft: 50%;\n\t\ttransform: translate(-50%, -50%);\n}\n.zc-pra-nodata svg {\n\t\tmargin-bottom: 20px;\n\twidth:100px;\n\theight:100px;\n}\n.zc-pra-nodata h4, .zc-pra-nodata h5, .zc-pra-nodata h6 {\n\t\tfont-weight: 400;\n\t\tline-height: 1.5;\n\t\tletter-spacing: 0.1px;\n\t\tcolor: #131635;\n}\n.zc-pra-nodata h4 {\n\t\tfont-size: 20px;\n\t\tmargin-bottom: 10px;\n}\n.zc-pra-nodata h6 {\n\t\tfont-size: 16px;\n\t    margin-bottom: 10px;\n}\nzc-pra-nodata-btns {\n\t\tmargin-top: 24px;\n}\n\n@-webkit-keyframes animate-svg-stroke-1 {\n\t0% {\n\t\tstroke-dashoffset: 121.38052083641213px;\n\t\tstroke-dasharray: 121.38052083641213px;\n\t}\n\n\t100% {\n\t\tstroke-dashoffset: 0;\n\t\tstroke-dasharray: 121.38052083641213px;\n\t}\n}\n\n@keyframes animate-svg-stroke-1 {\n\t0% {\n\t\tstroke-dashoffset: 121.38052083641213px;\n\t\tstroke-dasharray: 121.38052083641213px;\n\t}\n\n\t100% {\n\t\tstroke-dashoffset: 0;\n\t\tstroke-dasharray: 121.38052083641213px;\n\t}\n}\n\n@-webkit-keyframes animate-svg-fill-1 {\n\t0% {\n\t\tfill: transparent;\n\t}\n\n\t100% {\n\t\