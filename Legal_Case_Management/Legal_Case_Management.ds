zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(so.Offered_By,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(so.Offer_Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(so.Offer_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\ttimeRows = Add_Time_Entry[Case == caseRec.ID] sort by Entry_Date desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Time Entries&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Time_Entry[Case == caseRec.ID].count()%&gt; time records&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Time_Entry?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Time&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(timeRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No time entries&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Record legal work, review, court appearances, negotiations, and client calls.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Activity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Hours&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each te in timeRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(te.Entry_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(te.Activity_Type,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=ifnull(te.Hours,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(te.Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(te.Approval_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\texpenseRows = Add_Expense_Entry[Case == caseRec.ID] sort by Expense_Date desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Expense Entries&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Expense_Entry[Case == caseRec.ID].count()%&gt; expense records&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Expense_Entry?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Expense&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(expenseRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No expenses&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Add court fees, travel, filing costs, expert fees, or other reimbursable expenses.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Category&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each ex in expenseRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(ex.Expense_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;cd-main&quot;&gt;&lt;%=ifnull(ex.Expense_Category,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;cd-sub&quot;&gt;&lt;%=ifnull(ex.Vendor,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(ex.Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(ex.Approval_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tinvoiceRows = Create_Invoice[Case == caseRec.ID] sort by Invoice_Date desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Invoices&lt;/h2&gt;&lt;p&gt;&lt;%=Create_Invoice[Case == caseRec.ID].count()%&gt; invoices&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Create_Invoice?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Create Invoice&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(invoiceRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No invoices&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Create invoices after time and expenses are approved for billing.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Total&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Balance&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each inv in invoiceRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;a class=&quot;cd-main&quot; href=&quot;#Page:Billing_Detail?Invoice_ID=&lt;%=inv.ID%&gt;&quot;&gt;&lt;%=ifnull(inv.Invoice_Number,inv.ID)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(inv.Invoice_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(inv.Total_Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(inv.Balance_Due,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(inv.Invoice_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tpaymentRows = Add_Payment[Case == caseRec.ID] sort by Payment_Date desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Payments&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Payment[Case == caseRec.ID].count()%&gt; payments&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Payment?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Payment&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(paymentRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No payments&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Record payment receipts, reconciliations, refunds, or bounced payments.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each pay in paymentRows\n\t\t\t{\n\t\t\t\tpayInvoice = &quot;-&quot;;\n\t\t\t\tif(pay.Invoice != null)\n\t\t\t\t{\n\t\t\t\t\tpi = Create_Invoice[ID == pay.Invoice];\n\t\t\t\t\tif(pi.count() &gt; 0){payInvoice = ifnull(pi.Invoice_Number,pi.ID);}\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=payInvoice%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(pay.Payment_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(pay.Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(pay.Payment_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\thistoryRows = Add_Case_History[Case == caseRec.ID] sort by Event_Date desc range from 1 to 50;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related cd-related-full&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Case History&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Case_History[Case == caseRec.ID].count()%&gt; audit events&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-history-scroll&quot;&gt;\n&lt;%\n\t\tif(historyRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No history yet&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Lifecycle changes and related-record events will appear here after workflows run.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Event&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status Change&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Summary&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Client Visible&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each hist in historyRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Event_Type,&quot;System&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Event_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Previous_Status,&quot;-&quot;)%&gt; → &lt;%=ifnull(hist.New_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Summary,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=if(hist.Visible_To_Client == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Case_Workspace
		{
					displayname = "Case Workspace"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Case_Workspace_Main' elementName='Case_Workspace_Main'>\n\t\t\t\t\t<![CDATA[htmlpage Case_Workspace_Main()\n\t\t\t\t\t\tcontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\nnewIntakeCount = Create_Case[Case_Status == &quot;New Intake&quot;].count();\nconflictCheckCount = Create_Case[Case_Status == &quot;Conflict Check&quot;].count();\nengagementPendingCount = Create_Case[Case_Status == &quot;Engagement Pending&quot;].count();\nopenMatterCount = Create_Case[Case_Status == &quot;Open Matter&quot;].count();\nstrategyPleadingsCount = Create_Case[Case_Status == &quot;Strategy and Pleadings&quot;].count();\ndiscoveryDiligenceCount = Create_Case[Case_Status == &quot;Discovery and Diligence&quot;].count();\nnegotiationMediationCount = Create_Case[Case_Status == &quot;Negotiation and Mediation&quot;].count();\nhearingTrialCount = Create_Case[Case_Status == &quot;Hearing and Trial&quot;].count();\nawaitingOrderExecutionCount = Create_Case[Case_Status == &quot;Awaiting Order or Execution&quot;].count();\nbillingReviewCount = Create_Case[Case_Status == &quot;Billing Review&quot;].count();\nclosedCount = Create_Case[Case_Status == &quot;Closed&quot;].count();\narchivedCount = Create_Case[Case_Status == &quot;Archived&quot;].count();\nrejectedCount = Create_Case[Case_Status == &quot;Rejected&quot;].count();\nactiveLifecycleCount = newIntakeCount + conflictCheckCount + engagementPendingCount + openMatterCount + strategyPleadingsCount + discoveryDiligenceCount + negotiationMediationCount + hearingTrialCount + awaitingOrderExecutionCount + billingReviewCount;\ntotalCaseCount = activeLifecycleCount + closedCount + archivedCount + rejectedCount;\n%&gt;\n&lt;style&gt;\n/* ===== ZCS global utility subset for this page (zcs-global included once) ===== */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);\n\t\t--zcs-page-bg-color: var(--zcs_page_bg_color, #F6F5FB);\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color, #1F2433);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color, #5F667A);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7B8192);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color, #E6E3F2);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-brand-color: var(--zcs_brand_color, #6147E5);\n\t\t--zcs-brand-foreground-color: var(--zcs_brand_foreground_color, #FFFFFF);\n\t\t--zcs-component-hover-color: var(--zcs_component_hover_color, #F1EEFF);\n\t\t--case-brand: var(--zcs_brand_color, #6147E5);\n\t\t--case-brand-light: var(--zcs_brand_light_color, #F1EEFF);\n\t\t--case-brand-dark: var(--zcs_brand_dark_color, #4E37C9);\n\t\t--case-text: var(--zcs_primary_text_color, #1F2433);\n\t\t--case-muted: var(--zcs_secondary_text_color, #667085);\n\t\t--case-border: var(--zcs_tertiary_border_color, #E5E1F2);\n\t\t--case-bg: #F7F6FB;\n\t\t--case-card-bg: #FFFFFF;\n\t\t--case-radius: 12px;\n\t\t--case-gap: 15px;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n.zcs-flex { display: flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-px-6 { padding-left: 0.375rem; padding-right: 0.375rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-0 { padding-top: 0; padding-bottom: 0; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-col-common { flex: 1 1 0%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ===== ZCS Header with Button component ===== */\n.zcs-page-header {\n\t\tbackground: var(--case-card-bg);\n\t\tborder: 1px solid var(--case-border);\n\t\tborder-radius: var(--case-radius);\n\t\tbox-shadow: 0 8px 24px rgba(34, 24, 77, 0.06);\n}\n.zcs-button {\n\t\twidth: auto;\n\t\tmin-width: 5rem;\n\t\tmin-height: 36px;\n\t\ttext-decoration: none;\n\t\ttransition: background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;\n}\n.zcs-primary-button {\n\t\tbackground-color: var(--case-brand);\n\t\tcolor: var(--zcs_brand_foreground_color, #FFFFFF);\n}\n.zcs-primary-button.zcs-button:hover {\n\t\tbackground-color: var(--case-brand-dark);\n\t\tcolor: var(--zcs_brand_foreground_color, #FFFFFF);\n}\n.zcs-primary-button.zcs-button:focus {\n\t\toutline: 2px solid var(--case-brand);\n\t\toutline-offset: 2px;\n}\n.zcs-button-icon {\n\t\twidth: 16px;\n\t\tmax-height: 16px;\n}\n\n/* ===== ZCS Horizontal Tab With Count component, adapted to radio labels ===== */\n.zcs-horizontal-tabhead {\n\t\tbox-shadow: 0 -1px 0 0 var(--case-border) inset;\n\t\toverflow-x: auto;\n\t\toverflow-y: hidden;\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none;\n}\n.zcs-horizontal-tabhead::-webkit-scrollbar { display: none; }\n.zcs-horizontal-tabitem {\n\t\tlist-style-type: none;\n\t\tborder-bottom: 2px solid transparent;\n\t\tletter-spacing: 0.1px;\n\t\tflex: 0 0 auto;\n}\n.zcs-horizontal-tablink {\n\t\ttext-decoration: none;\n\t\tcursor: pointer;\n\t\tborder: 0;\n\t\tbackground: transparent;\n\t\tmin-height: 48px;\n}\n.zcs-horizontal-tabtext { white-space: nowrap; }\n.zcs-horizontal-tabcount {\n\t\tmin-width: 24px;\n\t\tbackground-color: var(--case-bg);\n\t\tcolor: var(--case-muted);\n\t\tborder: 1px solid transparent;\n}\n.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--case-brand); }\n.zcs-horizontal-tabitem:hover .zcs-horizontal-tabcount { background-color: var(--case-brand-light); }\n.zcs-horizontal-tabbody { overflow: auto; }\n\n/* ===== Supplied Case Workspace page CSS block ===== */\n.case-workspace-page,\n.case-workspace-page * {\n\t\tbox-sizing: border-box;\n}\n.case-workspace-page {\n\t\twidth: 100%;\n\t\tmin-height: 100%;\n\t\tpadding: var(--case-gap);\n\t\tbackground: var(--case-bg);\n\t\tcolor: var(--case-text);\n\t\tfont-family: Lato, Arial, sans-serif;\n\t\tfont-size: 14px;\n}\n.case-workspace-stack {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: var(--case-gap);\n\t\twidth: 100%;\n}\n.case-header-copy {\n\t\tmin-width: 0;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 4px;\n}\n.case-header-kicker {\n\t\tmargin: 0;\n\t\tcolor: var(--case-muted);\n\t\tfont-size: 12px;\n\t\tline-height: 1.4;\n}\n.case-header-meta {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t\tflex-wrap: wrap;\n\t\tmargin-top: 2px;\n\t\tcolor: var(--case-muted);\n\t\tfont-size: 12px;\n}\n.case-meta-pill {\n\t\tdisplay: inline-flex;\n\t\talign-items: center;\n\t\tgap: 6px;\n\t\tpadding: 4px 8px;\n\t\tborder: 1px solid var(--case-border);\n\t\tborder-radius: 999px;\n\t\tbackground: #FBFAFF;\n\t\tcolor: var(--case-muted);\n}\n.case-tabs-shell {\n\t\tbackground: var(--case-card-bg);\n\t\tborder: 1px solid var(--case-border);\n\t\tborder-radius: var(--case-radius);\n\t\tbox-shadow: 0 8px 24px rgba(34, 24, 77, 0.06);\n\t\toverflow: hidden;\n}\n.case-tab-radio {\n\t\tposition: absolute;\n\t\twidth: 1px;\n\t\theight: 1px;\n\t\topacity: 0;\n\t\tpointer-events: none;\n}\n.case-tab-panels {\n\t\tpadding: var(--case-gap);\n\t\tbackground: #FFFFFF;\n}\n.case-tab-panel {\n\t\tdisplay: none;\n}\n.case-tab-context {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t\tgap: 12px;\n\t\tflex-wrap: wrap;\n\t\tpadding: 0 0 12px 0;\n\t\tborder-bottom: 1px solid var(--case-border);\n\t\tmargin-bottom: 12px;\n}\n.case-tab-title {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t\tmin-width: 0;\n\t\tcolor: var(--case-text);\n\t\tfont-weight: 600;\n}\n.case-tab-title i {\n\t\tcolor: var(--case-brand);\n\t\tfont-size: 16px;\n}\n.case-tab-hint {\n\t\tcolor: var(--case-muted);\n\t\tfont-size: 12px;\n}\n.case-report-frame {\n\t\tmin-height: 650px;\n\t\twidth: 100%;\n\t\tborder: 1px solid var(--case-border);\n\t\tborder-radius: 10px;\n\t\toverflow: auto;\n\t\tbackground: #FFFFFF;\n}\n.case-empty-note {\n\t\tcolor: var(--case-muted);\n\t\tfont-size: 12px;\n}\n\n#cw-tab-new-intake:checked ~ .case-tabs-shell label[for=&apos;cw-tab-new-intake&apos;],\n#cw-tab-conflict-check:checked ~ .case-tabs-shell label[for=&apos;cw-tab-conflict-check&apos;],\n#cw-tab-engagement-pending:checked ~ .case-tabs-shell label[for=&apos;cw-tab-engagement-pending&apos;],\n#cw-tab-open-matter:checked ~ .case-tabs-shell label[for=&apos;cw-tab-open-matter&apos;],\n#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell label[for=&apos;cw-tab-strategy-pleadings&apos;],\n#cw-tab-discovery-diligence:checked ~ .case-tabs-shell label[for=&apos;cw-tab-discovery-diligence&apos;],\n#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell label[for=&apos;cw-tab-negotiation-mediation&apos;],\n#cw-tab-hearing-trial:checked ~ .case-tabs-shell label[for=&apos;cw-tab-hearing-trial&apos;],\n#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell label[for=&apos;cw-tab-awaiting-order-execution&apos;],\n#cw-tab-billing-review:checked ~ .case-tabs-shell label[for=&apos;cw-tab-billing-review&apos;],\n#cw-tab-closed:checked ~ .case-tabs-shell label[for=&apos;cw-tab-closed&apos;],\n#cw-tab-archived:checked ~ .case-tabs-shell label[for=&apos;cw-tab-archived&apos;],\n#cw-tab-rejected:checked ~ .case-tabs-shell label[for=&apos;cw-tab-rejected&apos;] {\n\t\tcolor: var(--case-brand);\n}\n#cw-tab-new-intake:checked ~ .case-tabs-shell label[for=&apos;cw-tab-new-intake&apos;] .zcs-horizontal-tabcount,\n#cw-tab-conflict-check:checked ~ .case-tabs-shell label[for=&apos;cw-tab-conflict-check&apos;] .zcs-horizontal-tabcount,\n#cw-tab-engagement-pending:checked ~ .case-tabs-shell label[for=&apos;cw-tab-engagement-pending&apos;] .zcs-horizontal-tabcount,\n#cw-tab-open-matter:checked ~ .case-tabs-shell label[for=&apos;cw-tab-open-matter&apos;] .zcs-horizontal-tabcount,\n#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell label[for=&apos;cw-tab-strategy-pleadings&apos;] .zcs-horizontal-tabcount,\n#cw-tab-discovery-diligence:checked ~ .case-tabs-shell label[for=&apos;cw-tab-discovery-diligence&apos;] .zcs-horizontal-tabcount,\n#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell label[for=&apos;cw-tab-negotiation-mediation&apos;] .zcs-horizontal-tabcount,\n#cw-tab-hearing-trial:checked ~ .case-tabs-shell label[for=&apos;cw-tab-hearing-trial&apos;] .zcs-horizontal-tabcount,\n#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell label[for=&apos;cw-tab-awaiting-order-execution&apos;] .zcs-horizontal-tabcount,\n#cw-tab-billing-review:checked ~ .case-tabs-shell label[for=&apos;cw-tab-billing-review&apos;] .zcs-horizontal-tabcount,\n#cw-tab-closed:checked ~ .case-tabs-shell label[for=&apos;cw-tab-closed&apos;] .zcs-horizontal-tabcount,\n#cw-tab-archived:checked ~ .case-tabs-shell label[for=&apos;cw-tab-archived&apos;] .zcs-horizontal-tabcount,\n#cw-tab-rejected:checked ~ .case-tabs-shell label[for=&apos;cw-tab-rejected&apos;] .zcs-horizontal-tabcount {\n\t\tbackground: var(--case-brand-light);\n\t\tcolor: var(--case-brand);\n\t\tborder-color: rgba(97, 71, 229, 0.18);\n}\n#cw-tab-new-intake:checked ~ .case-tabs-shell .tabitem-new-intake,\n#cw-tab-conflict-check:checked ~ .case-tabs-shell .tabitem-conflict-check,\n#cw-tab-engagement-pending:checked ~ .case-tabs-shell .tabitem-engagement-pending,\n#cw-tab-open-matter:checked ~ .case-tabs-shell .tabitem-open-matter,\n#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell .tabitem-strategy-pleadings,\n#cw-tab-discovery-diligence:checked ~ .case-tabs-shell .tabitem-discovery-diligence,\n#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell .tabitem-negotiation-mediation,\n#cw-tab-hearing-trial:checked ~ .case-tabs-shell .tabitem-hearing-trial,\n#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell .tabitem-awaiting-order-execution,\n#cw-tab-billing-review:checked ~ .case-tabs-shell .tabitem-billing-review,\n#cw-tab-closed:checked ~ .case-tabs-shell .tabitem-closed,\n#cw-tab-archived:checked ~ .case-tabs-shell .tabitem-archived,\n#cw-tab-rejected:checked ~ .case-tabs-shell .tabitem-rejected {\n\t\tborder-bottom-color: var(--case-brand);\n}\n#cw-tab-new-intake:checked ~ .case-tabs-shell #panel-new-intake,\n#cw-tab-conflict-check:checked ~ .case-tabs-shell #panel-conflict-check,\n#cw-tab-engagement-pending:checked ~ .case-tabs-shell #panel-engagement-pending,\n#cw-tab-open-matter:checked ~ .case-tabs-shell #panel-open-matter,\n#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell #panel-strategy-pleadings,\n#cw-tab-discovery-diligence:checked ~ .case-tabs-shell #panel-discovery-diligence,\n#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell #panel-negotiation-mediation,\n#cw-tab-hearing-trial:checked ~ .case-tabs-shell #panel-hearing-trial,\n#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell #panel-awaiting-order-execution,\n#cw-tab-billing-review:checked ~ .case-tabs-shell #panel-billing-review,\n#cw-tab-closed:checked ~ .case-tabs-shell #panel-closed,\n#cw-tab-archived:checked ~ .case-tabs-shell #panel-archived,\n#cw-tab-rejected:checked ~ .case-tabs-shell #panel-rejected {\n\t\tdisplay: block;\n}\n@media (max-width: 768px) {\n\t\t.case-workspace-page { padding: 10px; }\n\t\t.zcs-page-header { padding: 14px 16px; align-items: flex-start; flex-direction: column; }\n\t\t.case-tab-panels { padding: 10px; }\n\t\t.case-report-frame { min-height: 560px; }\n}\n@media (max-width: 576px) {\n\t\t.zcs-page-header .zcs-button { width: 100%; }\n\t\t.zcs-horizontal-tablink { padding-left: 8px; padding-right: 8px; }\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;case-workspace-page&apos;&gt;\n\t\t&lt;div class=&apos;case-workspace-stack&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;case-header-copy&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Case Workspace&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;case-header-kicker&apos;&gt;Browse legal matters by lifecycle status. Open records from the embedded reports for status-specific work and detail navigation.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;case-header-meta&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;case-meta-pill&apos;&gt;&lt;i class=&apos;zc-li-outline business-law&apos;&gt;&lt;/i&gt; Active lifecycle: &lt;%=activeLifecycleCount%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;case-meta-pill&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-14&apos;&gt;&lt;/i&gt; Total matters: &lt;%=totalCaseCount%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Create_Case?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Create Case&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-new-intake&apos; checked=&apos;checked&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-conflict-check&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-engagement-pending&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-open-matter&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-strategy-pleadings&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-discovery-diligence&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-negotiation-mediation&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-hearing-trial&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-awaiting-order-execution&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apos; id=&apos;cw-tab-billing-review&apos;&gt;\n\t\t\t\t&lt;input class=&apos;case-tab-radio&apos; type=&apos;radio&apos; name=&apos;case_workspace_status&apo