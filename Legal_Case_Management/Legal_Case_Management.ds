			Add_Invoice_Action_Action_Type_On_User_Input as "Action Type On User Input"
			{
			
						    type = form
						    form = Add_Invoice_Action
						    record event = on add or edit
						
						    on user input of Action_Type
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Action_Type == "Submit for Review")
						                {
						                    input.To_Status = "Submitted for Review";
						                }
						                else if(input.Action_Type == "Approve Invoice")
						                {
						                    input.To_Status = "Approved";
						                }
						                else if(input.Action_Type == "Send Invoice")
						                {
						                    input.To_Status = "Sent";
						                }
						                else if(input.Action_Type == "Mark Partially Paid")
						                {
						                    input.To_Status = "Partially Paid";
						                }
						                else if(input.Action_Type == "Mark Paid")
						                {
						                    input.To_Status = "Paid";
						                }
						                else if(input.Action_Type == "Cancel Invoice")
						                {
						                    input.To_Status = "Cancelled";
						                }
						                else if(input.Action_Type == "Reopen Invoice")
						                {
						                    input.To_Status = "Draft";
						                }
						            )
						        }
						    }
						
			}

			Add_Invoice_Action_Invoice_On_User_Input as "Invoice On User Input"
			{
			
						    type = form
						    form = Add_Invoice_Action
						    record event = on add or edit
						
						    on user input of Invoice
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Invoice != null)
						                {
						                    inv = Create_Invoice[ID == input.Invoice];
						                    if(inv.count() > 0)
						                    {
						                        input.From_Status = inv.Invoice_Status;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Invoice_Action_On_Load as "Add Invoice Action On Load"
			{
			
						    type = form
						    form = Add_Invoice_Action
						    record event = on add or edit
						
						    on load
						    {
						        actions
						        {
						            hide System_Info, Invoice_Action_ID, From_Status, To_Status, Action_Date;
						            disable Invoice_Action_ID, From_Status, To_Status, Action_Date;
						        }
						        actions (Invoice != null)
						        {
						            disable Invoice;
						        }
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Invoice != null)
						                {
						                    inv = Create_Invoice[ID == input.Invoice];
						                    if(inv.count() > 0)
						                    {
						                        input.From_Status = inv.Invoice_Status;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Invoice_Action_On_Success as "Add Invoice Action On Success"
			{
			
						    type = form
						    form = Add_Invoice_Action
						    record event = on add or edit
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                inv = Create_Invoice[ID == input.Invoice];
						                if(inv.count() > 0)
						                {
						                    inv.Invoice_Status = input.To_Status;
						                    if(input.Action_Type == "Send Invoice")
						                    {
						                        inv.Sent_On = zoho.currentdate;
						                    }
						                    if(input.Action_Type == "Approve Invoice")
						                    {
						                        inv.Approved_By = input.Action_By;
						                    }
						                    insert into Add_Case_History
						                    [
						                        Case = inv.Case
						                        Event_Date = zoho.currenttime
						                        Event_Type = "Invoice Updated"
						                        Previous_Status = input.From_Status
						                        New_Status = input.To_Status
						                        Summary = input.Action_Type + ": " + input.Action_Notes
						                        Changed_By = input.Action_By
						                        Source_Record_ID = input.ID
						                    ];
						                    caseRec = Create_Case[ID == inv.Case];
						                    if(caseRec.count() > 0 && caseRec.Billing_Attorney != null)
						                    {
						                        billEmp = Add_Employee[ID == caseRec.Billing_Attorney];
						                        if(billEmp.count() > 0 && ifnull(billEmp.Email,"") != "")
						                        {
						                            sendmail
						                            (
						                                from : zoho.adminuserid
						                                to : billEmp.Email
						                                subject : "Invoice status updated"
						                                message : "Invoice status changed from " + input.From_Status + " to " + input.To_Status + "."
						                            )
						                        }
						                    }
						                    openUrl("#Page:Billing_Detail?Invoice_ID=" + input.Invoice,"same window");
						                }
						            )
						        }
						    }
						
			}

			Add_Invoice_Action_On_Validate as "Add Invoice Action On Validate"
			{
			
						    type = form
						    form = Add_Invoice_Action
						    record event = on add or edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                inv = Create_Invoice[ID == input.Invoice];
						                if(inv.count() == 0)
						                {
						                    alert "Select a valid invoice.";
						                    cancel submit;
						                }
						                currentStatus = inv.Invoice_Status;
						                input.From_Status = currentStatus;
						                isValid = false;
						                if(input.Action_Type == "Submit for Review" && currentStatus == "Draft")
						                {
						                    input.To_Status = "Submitted for Review";
						                    isValid = true;
						                }
						                else if(input.Action_Type == "Approve Invoice" && currentStatus == "Submitted for Review")
						                {
						                    input.To_Status = "Approved";
						                    isValid = true;
						                }
						                else if(input.Action_Type == "Send Invoice" && currentStatus == "Approved")
						                {
						                    input.To_Status = "Sent";
						                    isValid = true;
						                }
						                else if(input.Action_Type == "Mark Partially Paid" && currentStatus == "Sent" && ifnull(inv.Amount_Paid,0) > 0 && ifnull(inv.Balance_Due,0) > 0)
						                {
						                    input.To_Status = "Partially Paid";
						                    isValid = true;
						                }
						                else if(input.Action_Type == "Mark Paid" && currentStatus in {"Sent","Partially Paid","Overdue"} && ifnull(inv.Balance_Due,0) <= 0)
						                {
						                    input.To_Status = "Paid";
						                    isValid = true;
						                }
						                else if(input.Action_Type == "Cancel Invoice" && currentStatus in {"Draft","Submitted for Review","Approved","Sent"})
						                {
						                    input.To_Status = "Cancelled";
						                    isValid = true;
						                }
						                else if(input.Action_Type == "Reopen Invoice" && currentStatus == "Cancelled")
						                {
						                    input.To_Status = "Draft";
						                    isValid = true;
						                }
						                if(isValid == false)
						                {
						                    alert "This invoice action is not available for the current invoice status or balance.";
						                    cancel submit;
						                }
						            )
						        }
						    }
						
			}

			Add_Invoice_Item_Invoice_On_User_Input as "Invoice On User Input"
