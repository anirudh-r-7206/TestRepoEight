application "Legal-Case-Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Add_Approval_Setup
		{
		
				
							displayname = "Add Approval Setup"
							success message = "Approval Setup Added Successfully"
							Section
							(
								type = section
					 			row = 1
					 			column = 0   
								width = medium
							)
							Approval_Setup_For
							(
								type = picklist	
								displayname = "Approval Setup For"
								values  = Approval_Setup_For.ID
				    			displayformat = [Approval_Setup_For]
								allow new entries
								[
									displayname = "Add New"
								]
								sortorder = ascending
					 			row = 1
					 			column = 1   
								width = medium
							)
							must have Level_Name
							(
				    			type = text
								displayname = "Level Name"
					 			row = 1
					 			column = 1   
								width = medium
							)
							Approver_Type
							(
								type = picklist
								displayname = "Approver Type"
								maxchar = 100
								values = {"Role","User"}
					 			row = 1
					 			column = 1   
								width = medium
							)
							Approver_Role
							(
								type = picklist	
								displayname = "Approver Role"
								values  = Add_Role.ID
				    			displayformat = [Role]
								sortorder = ascending
					 			row = 1
					 			column = 1   
								width = medium
							)
							users
							(
				    			type = picklist
								displayname = "Users"
								module = users
								displayformat = [username]
					 			row = 1
					 			column = 1   
								width = medium
								personal data = true
							)
							Hidden
							(
								type = section
					 			row = 2
					 			column = 0   
								width = medium
							)
							Type_field
							(
								type = number
								displayname = "Type"
					 			row = 2
					 			column = 1   
								width = medium
							)
							Sequence_Order
							(
								type = number
								displayname = "Sequence Order"
					 			row = 2
					 			column = 1   
								width = medium
							)
							Previous_Sequence_Number
							(
								type = number
								displayname = "Previous Sequence Number"
					 			row = 2
					 			column = 1   
								width = medium
							)
							Is_Last_Step
							(
				    			type = checkbox
								displayname = "Is Last Step"
								initial value = false
					 			row = 2
					 			column = 1   
								width = medium
							)
							Status
							(
								type = picklist
								maxchar = 100
								values = {"Active","Inactive","Deleted"}
								initial value = "Active"
					 			row = 2
					 			column = 1   
								width = medium
							)
							Notes
							(
				    			type = plaintext
								value = "<div> <br /></div>"
					 			row = 2
					 			column = 1   
								width = medium
							)
					
							actions
							{
								on add
								{
									submit
									(
				   						type = submit
				   						displayname = "Add"
									)
								}
								on edit
								{
									update
									(
				   						type = submit
				   						displayname = "Update"
									)
									cancel
									(
				   						type = cancel
				   						displayname = "Cancel"
									)
								}
							}
						
				
		}

		form Add_Case_Action
		{
		
				    displayname = "Add Case Action"
				    success message = "Case action completed successfully"
				
				    Action_Details
				    (
				        type = section
				        displayname = "Action Details"
				        row = 1
				        column = 0
				        width = medium
				    )
				    must have Case
				    (
				        type = picklist
				        displayname = "Case"
				        values = Create_Case.ID
				        displayformat = [Case_Title]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Action_Type
				    (
				        type = picklist
				        displayname = "Action Type"
				        values = {"Submit Conflict Check","Clear Conflict","Flag Conflict","Send Engagement","Mark Engagement Signed","Open Matter","Move To Strategy and Pleadings","Move To Discovery and Diligence","Move To Negotiation and Mediation","Move To Hearing and Trial","Mark Awaiting Order or Execution","Send To Billing Review","Close Case","Archive Case","Reopen Case","Reject Case"}
				        row = 1
				        column = 1
				        width = medium
				    )
				    Action_By
				    (
				        type = picklist
				        displayname = "Action By"
				        values = Add_Employee.ID
				        displayformat = [Employee_Name.first_name]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Action_Notes
				    (
				        type = textarea
				        displayname = "Action Notes"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Attachment
				    (
				        type = upload file
				        displayname = "Attachment"
				        browse = local_drive, google_docs, zoho_docs
				        row = 1
				        column = 1
				        width = medium
				    )
				    Notify_Client
				    (
				        type = checkbox
				        displayname = "Notify Client"
				        initial value = false
				        row = 1
				        column = 1
				        width = medium
				    )
				    System_Info
				    (
				        type = section
				        displayname = "System Info"
				        row = 2
				        column = 1
				        width = medium
				        visibility = true
				    )
				    Action_ID
				    (
				        type = autonumber
				        displayname = "Action ID"
				        start index = 1000
				        row = 2
				        column = 1
				        width = medium
				    )
				    From_Status
				    (
				        type = text
				        displayname = "From Status"
				        row = 2
				        column = 1
				        width = medium
				    )
				    To_Status
				    (
				        type = text
				        displayname = "To Status"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Action_Date
				    (
				        type = datetime
				        displayname = "Action Date"
				        initial value = "${zoho.currenttime}"
				        row = 2
				        column = 1
				        width = medium
				    )
				
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Run Action"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update Action"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Add_Case_Document
		{
		
				    displayname = "Add Case Document"
				    success message = "Case document saved successfully"
				
				    Document_Details
				    (
				        type = section
				        displayname = "Document Details"
				        row = 1
				        column = 0
				        width = medium
				    )
				    must have Case
				    (
				        type = picklist
				        displayname = "Case"
				        values = Create_Case.ID
				        displayformat = [Case_Title]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    Document_Type
				    (
				        type = picklist
				        displayname = "Document Type"
				        values = Add_Document_Type.ID
				        displayformat = [Document_Type_Name]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Document_Title
				    (
				        type = text
				        displayname = "Document Title"
				        maxchar = 200
				        row = 1
				        column = 1
				        width = medium
