/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Cases_Conflict_Check&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;case-tab-panel&apos; id=&apos;panel-engagement-pending&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-tab-context&apos;&gt;&lt;div class=&apos;case-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline files-paper&apos;&gt;&lt;/i&gt;&lt;span&gt;Engagement Pending matters&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;case-tab-hint&apos;&gt;Monitor engagement completion before opening active matter work.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Cases_Engagement_Pending&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;case-tab-panel&apos; id=&apos;panel-open-matter&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-tab-context&apos;&gt;&lt;div class=&apos;case-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-bold&apos;&gt;&lt;/i&gt;&lt;span&gt;Open Matter records&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;case-tab-hint&apos;&gt;Use the report row/detail navigation for individual matter actions.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Cases_Open_Matter&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;case-tab-panel&apos; id=&apos;panel-strategy-pleadings&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;case-tab-context&apos;&gt;&lt;div class=&apos;case-tab-title&apos;&gt;&l