zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Task&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Assigned&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each t in taskRows\n\t\t\t{\n\t\t\t\tassignedName = &quot;Not assigned&quot;;\n\t\t\t\tif(t.Assigned_To != null)\n\t\t\t\t{\n\t\t\t\t\tassignee = Add_Employee[ID == t.Assigned_To];\n\t\t\t\t\tif(assignee.count() &gt; 0){assignedName = ifnull(assignee.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(assignee.Employee_Name.last_name,&quot;&quot;);}\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;cd-main&quot;&gt;&lt;%=ifnull(t.Task_Title,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;cd-sub&quot;&gt;&lt;%=ifnull(t.Task_Type,&quot;&quot;)%&gt; · &lt;%=ifnull(t.Priority,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=assignedName%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(t.Due_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(t.Task_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tdeadlineRows = Add_Deadline[Case == caseRec.ID] sort by Deadline_Date asc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Deadlines&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Deadline[Case == caseRec.ID].count()%&gt; statutory, court, and internal dates&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Deadline?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Deadline&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(deadlineRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No deadlines&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Track limitation, filing, appeal, contractual, payment, and review deadlines.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Deadline&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Responsible&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each dl in deadlineRows\n\t\t\t{\n\t\t\t\trespName = &quot;Not assigned&quot;;\n\t\t\t\tif(dl.Responsible_Attorney != null)\n\t\t\t\t{\n\t\t\t\t\tresp = Add_Employee[ID == dl.Responsible_Attorney];\n\t\t\t\t\tif(resp.count() &gt; 0){respName = ifnull(resp.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(resp.Employee_Name.last_name,&quot;&quot;);}\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;cd-main&quot;&gt;&lt;%=ifnull(dl.Deadline_Type,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;cd-sub&quot;&gt;&lt;%=ifnull(dl.Priority,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(dl.Deadline_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=respName%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(dl.Deadline_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tnoteRows = Add_Case_Note[Case == caseRec.ID] sort by Communication_DateTime desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Notes&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Case_Note[Case == caseRec.ID].count()%&gt; communications and notes&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Note?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-but