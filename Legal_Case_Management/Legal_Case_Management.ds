or_codes.get("zc-pra-secondary-text-color") + "; } /* Table section */ .zc-pra-table-wrapper table thead tr th:nth-last-child(1), .zc-pra-table-wrapper table thead tr th:nth-last-child(2), .zc-pra-table-wrapper table tbody tr td:nth-last-child(1), .zc-pra-table-wrapper table tbody tr td:nth-last-child(2) { width: 140px; } /* Comments section */ .zc-pra-comments-wrapper { width: calc(100% - 300px); height: auto; margin-right: 20px; background-color: #f9f9fb80; padding: 16px; } .zc-pra-comments-wrapper span { font-size: 14px; font-weight: 400; line-height: 21px; display: block; color: " + color_codes.get("zc-pra-primary-text-color") + "; } /* Billing section */ .zc-pra-bill-wrapper { width: 280px; } .zc-pra-bill-wrapper table tbody tr td { width: 140px; font-size: 14px; font-weight: 400; line-height: 21px; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; padding: 8px 16px; text-align: right; } .zc-pra-bill-wrapper table tbody tr:last-child td { font-size: 16px; font-weight: 500; line-height: 24px; } .zc-pra-bill-wrapper table tbody tr:last-child td:first-child { border-radius: 8px 0px 0px 8px; } .zc-pra-bill-wrapper table tbody tr:last-child td:last-child { border-radius: 0px 8px 8px 0px; } ul.zc-pra-li-wrapper.zc-pra-key_value-wrapper { width: 100%; } ul.zc-pra-li-wrapper.zc-pra-key_value-wrapper li {margin: 0px 24px 0px 0px; } .zc-pra-popup-container .zc-pra-table-wrapper table tbody tr td.zc-pra-description-td span { display: block; } .zc-pra-popup-container .zc-pra-table-wrapper table tbody tr td.zc-pra-description-td span:last-child { margin-top: 4px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; } ul.zc-pra-address-wrapper li .zc-pra-tax-wrapper { margin-left: 16px; } .zc-pra-notes-container { width: calc(100% - 300px); margin-right: 20px; } .zc-pra-print-wrapper { display: none; } .zc-pa-notes-wrapper p { font-size: 14px; font-weight: 400; line-height: 1.5; color: " + color_codes.get("zc-pra-secondary-text-col