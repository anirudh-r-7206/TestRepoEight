			}

			string styles.getReportNavigationWithTabCount(int noOfTab, String bgColor, String tableHeadClr, String tableHeadFontClr, string borderclr, string naviPanelBorderClr, list tabCountList)
			{
			
						
						                 	// 	borderclr = "#000000";
						                 	navigtionSytle = "";
						                 	if(input.noOfTab == null || input.noOfTab < 2)
						                 	{
						                 		navigtionSytle = navigtionSytle + ".navigation .form-group .form-field div[type='radio']:has(.choice-table-cell:nth-of-type(2) span input:checked)::after { left: calc(var(--label-width) / 2); }";
						                 	}
						                 	else
						                 	{
						                 		tablengthlist = "".leftPad(input.noOfTab - 1).toList("");
						                 		for each index ind in tablengthlist
						                 		{
						                 			indexValue = ind + 1;
						                 			childNumberValue = 3 * indexValue + 2;
						                 			navigtionSytle = navigtionSytle + ".navigation .form-group .form-field div[type=\"radio\"]:has(.choice-table-cell:nth-of-type(" + childNumberValue + ") span input:checked)::after { left: calc((var(--label-width) * " + indexValue + ") + calc(var(--label-width) / 2)); }";
						                 		}
						                 	}
						                 	if(input.bgColor == "")
						                 	{
						                 		bgColor = "#f8f8f8";
						                 	}
						                 	if(input.borderclr == "")
						                 	{
						                 		borderclr = "#e7e7ee";
						                 	}
						                 	if(input.naviPanelBorderClr == "")
						                 	{
						                 		naviPanelBorderClr = "#e7e7ee";
						                 	}
						                 	if(input.tabCountList.size() != 0)
						                 	{
						                 		indexValue = 0;
						                 		for each  tabCount in tabCountList
						                 		{
						                 			childNumberValue = 3 * indexValue + 2;
						                 			navigtionSytle = navigtionSytle + ".navigation .form-group .form-field div[type='radio'] .choice-table-cell:nth-child(" + childNumberValue + ") label.choice-label-text::before { content: \"" + tabCount + "\";}";
						                 			indexValue = indexValue + 1;
						                 		}
						                 	}
						                 	return "<style>:root{ --page-tab-size: " + input.noOfTab + "; } * { padding: 0; margin: 0; border: none; box-sizing: border-box; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{ height: 100% !important; } .Layout.elemContainment { padding: unset !important; } ul.view-options.pull-right { display: flex; justify-content: space-around; height: 100%; padding: unset !important; gap: 5px; } :root{--nav-bar-height: 65px;	--nav-bg-clr: #ffffff;--nav-border-clr: #EFF0F6;--report-btn-bg-clr: white;--report-btn-clr: black;--report-header-bg-clr: #f8f8f8;--report-header-height: 47px;--report-tr-bottom-border-clr: #E1E1E1;--report-tr-height: 49.73px;--container-content: #F6F6F6;--report-bg-clr: #ffffff;--header-bg-clr: #ffffff;--panel-bg-clr: #ffffff;--svg-bg-clr: #ffffff;--panel-left-line-clr :#FFE4DB;--report-drop-down-border-clr: #E7E7E7;--detail-view-border-clr: #E6E6E6;--detail-view-popup-close-icon-clr: black;--report-group-header-bg-clr: #FFF5F1;--report-group-header-height: 42px;--background-nav-bar-height: 42px;--background-model-label-checked-clr: white;} div#reportTitleDiv { display: none; } .view-outer-wrapper .view-header { height: 75px !important; border: unset !important; background: unset; } .handsontable th, .handsontable td {  border-top: unset !important; } .pane_nav, .inner .page_content_wrapper {border-color:" + input.naviPanelBorderClr + ";}.view-outer-wrapper .view-header .view-options.zc-report-newheader li a, .dashboard-nav.navigation.divEmbedContainer, .view-outer-wrapper .view-header .zc-reportoptionheader ul li a.zc_transition.zc-tooltip-el, .view-outer-wrapper .reportfullwidth, .zc-reporttype-list .list-view-inner .handsontable .wtHolder .wtHider .htCore tbody tr td, .zc-reporttype-list .list-view-inner .htGhostTable .wtHolder .wtHider .htCore tbody tr td, .customCheckbox+label, .customRadio+label, form.form-table .form-header, form.form-table .zc-footer-wrapper .zc-f