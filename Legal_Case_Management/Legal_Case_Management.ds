					displayname = "All Mail Templates"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet3' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet3()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css&quot; /&gt;\n\n&lt;style&gt;\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t div::-webkit-scrollbar, table::-webkit-scrollbar, tr::-webkit-scrollbar, th::-webkit-scrollbar, td::-webkit-scrollbar, ul::-webkit-scrollbar, li::-webkit-scrollbar, a::-webkit-scrollbar, form::-webkit-scrollbar, input::-webkit-scrollbar {\n\t\t display: none;\n\t}\n\tdiv, table, tr, th, td, ul, li, a, form, input {\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none; \n\t}\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight:100% !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\n:root {\n\t--primary-color: #467eee;\n}\n\n/* ===== LAYOUT ===== */\n.innerMainDiv {\n\twidth: 100%;\n\theight: 100%;\n}\n.boxContainer {\n\twidth: 100%;\n\theight: 100%;\n\tdisplay: flex;\n\tflex-direction: column;\n\tborder-radius: 10px;\n\t/*border: 1px solid #ededed;*/\n\tbackground: #fff;\n\toverflow: hidden;\n}\n.boxHeader {\n\tbackground: #ffffff;\n\theight: 50px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 0 20px;\n\tfont-weight: 600;\n\tcolor: #000;\n\tborder-bottom: 1px solid #ededed;\n}\n.boxHeader .ass {\n\ttext-decoration: none;\n\tbackground: var(--primary-color);\n\tcolor: #fff;\n\tpadding: 8px 16px;\n\tborder-radius: 8px;\n\tfont-weight: 500;\n\tfont-size: 14px;\n\ttransition: all 0.3s ease;\n}\n.boxHeader .ass:hover {\n\tbackground: var(--menu_selected_hover_bg_color);\n}\n.boxContent {\n\tflex: 1;\n\tpadding: 20px;\n\toverflow: auto;\n\tdisplay: flex;\n\tgap: 20px;\n\twidth: 100%;\n\theight: 100%;\n\tflex-wrap: wrap;\n\t\n\talign-content: flex-start;\n}\n\n/* ===== MAIL TEMPLATE CARDS ===== */\n\n.mail-card {\n\tbackground: #f8f8f8;\n\t\tborder: 1px solid #ededed;\n\t\tborder-radius: 16px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\tmax-width: 50%;\n\t\twidth: 515px;\n\t\theight: 400px;\n\t\tvertical-align: top;\n\t\ttransition: all 0.3s ease;\n\toverflow: hidden;\n}\n.mail-card:hover {\n\tbackground: #eeebfa;\n}\n\n/* Dashed separator after each card */\n.mail-card:not(:last-child)::after {\n\tcontent: &quot;&quot;;\n\tposition: absolute;\n\ttop: 10px;\n\tright: -10px;\n\twidth: 1px;\n\theight: 95%;\n\t/*border-right: 2px dashed #ccc;*/\n}\n\n/* Header Section */\n.card-header {\n\tpadding: 15px 20px;\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: flex-start;\n\tborder-bottom: 1px solid #ececee;\n}\n.card-header .subject {\n\tfont-size: 17px;\n\tfont-weight: 700;\n\tcolor: #1a202c;\n\tword-break: break-word;\n}\n.card-header .options-container {\n\tposition: relative;\n}\n.options-toggle {\n\tbackground: none;\n\tborder: none;\n\tfont-size: 18px;\n\tcolor: #a0aec0;\n\tcursor: pointer;\n}\n.options-menu {\n\tposition: absolute;\n\ttop: 100%;\n\tright: 0;\n\tbackground: #fff;\n\tborder-radius: 10px;\n\tbox-shadow: 0 10px 30px rgba(0,0,0,0.15);\n\twidth: 180px;\n\tdisplay: none;\n\tborder: 1px solid #e2e8f0;\n\tz-index: 5;\n}\n.options-menu a {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tpadding: 12px 15px;\n\ttext-decoration: none;\n\tcolor: #4a5568;\n\tfont-size: 14px;\n\ttransition: 0.2s;\n}\n.options-menu a:hover {\n\tbackground: #f7fafc;\n\tcolor: var(--primary-color);\n}\n.options-toggle:focus + .options-menu,\n.options-menu:hover {\n\tdisplay: block;\n}\n\n/* Body Section */\n.mail-card:hover .card-body{\n\t\tbackground: #eeebfa;\n}\n.card-body {\n\tpadding: 15px 20px;\n\toverflow: hidden;\n\tdisplay: flex;\n\theight: calc(100% - 53px);\n\tflex-direction: column;\n\tjustify-content: space-between;\n\tbackground: #ffffff;\n}\n.mail-preview {\n\tfont-size: 14px;\n\t\tcolor: #4a5568;\n\t\tline-height: 1.6;\n\t\tword-wrap: break-word;\n\t\theight: calc(100% - 39px);\n\t\toverflow: auto;\n}\n.mail-meta {\n\tmargin-top: 12px;\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tflex-wrap: wrap;\n\t\tgap: 6px;\n}\n.mail-to {\n\tfont-size: 13px;\n\tcolor: #718096;\n\tfont-weight: 500;\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 6px;\n}\n.mail-to i {\n\tcolor: var(--primary-color);\n}\n.status-badge {\n\tpadding: 6px 12px;\n\tborder-radius: 20px;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\ttext-transform: uppercase;\n}\n.status-active {\n\tbackground: #d1fae5;\n\tcolor: #065f46;\n}\n.status-inactive {\n\tbackground: #fee2e2;\n\tcolor: #991b1b;\n}\n\n/* Empty State */\n.noDetailDiv {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 100%;\n\tcolor: #626262;\n\tfont-weight: 500;\n}\n@media (max-width:768px){\n\t.mail-card {\n\t\twidth: 90%;\n\t\tmin-width: 90%;\n\t}\n}\n.boxHeader span {\n\t\tfont-size: 16px;\n\t\tfont-weight: 500;\n\t\tline-height: 22px;\n\t\tcolor: #666D79;\n\t\tmargin: 0px 4px 0px 0px;\n}\n.boxHeader:hover span {\n\t\tcolor: #131635;\n}\n.boxHeader h5 {\n\t\tfont-size: 18px;\n\t\tfont-weight: 500;\n\t\tline-height: 22px;\n\t\tletter-spacing: 0.1px;\n\t\tcolor: #131635;\n}\n.fa-angle-left:before {\n\t\tfont-family: &quot;FontAwesome&quot; !important; \n\t\tcontent: &quot;\\f104&quot;;\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;innerMainDiv&quot;&gt;\n\t&lt;div class=&quot;boxContainer&quot;&gt;\n\t\t&lt;div class=&quot;boxHeader&quot;&gt;\n\t\t &lt;div class=&quot;zc-pra-flt-left zc-pra-clearfix zc-pra-header-title&quot; style=&quot;display: flex; align-items: center;&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Page:All_Mail_Templates1?zc_LoadIn=embed-embedDiv&quot; class=&quot;zc-pra-flt-left zc-pra-back-icon&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;fa fa-angle-left&quot;&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;h5 class=&quot;&quot;&gt;Back&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t \n\t\t\t&lt;a class=&quot;ass&quot; href=&quot;#Form:Create_Template?zc_LoadIn=embed-embedDiv&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&amp;Email_For=&lt;%=input.recID%&gt;&quot;&gt;+ Add Template&lt;/a&gt;\n\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;boxContent&quot;&gt;\n&lt;%\n\tfetchSalesOrder = Create_Template[Email_For == input.recID];\n\tif(fetchSalesOrder.count() != 0)\n\t{\n\t\tfor each  rec in fetchSalesOrder\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;mail-card&quot;&gt;\n\t\t\t&lt;div class=&quot;card-header&quot;&gt;\n\t\t\t\t&lt;div class=&quot;subject&quot;&gt;&lt;%=rec.Title%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;options-container&quot;&gt;\n\t\t\t\t\t&lt;button class=&quot;options-toggle&quot;&gt;&lt;i class=&quot;fas fa-ellipsis-v&quot;&gt;&lt;/i&gt;&lt;/button&gt;\n\t\t\t\t\t&lt;div class=&quot;options-menu&quot;&gt;\n\t\t\t\t\t\t &lt;a href=&quot;#Form:Create_Template?zc_LoadIn=dialog&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&amp;recLinkID=&lt;%=rec.ID%&gt;&amp;viewLinkName=Create_Template_Report&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;fas fa-edit&quot;&gt;&lt;/i&gt; Edit\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t &lt;a href=&quot;#Page:Detail_View_Page?zc_LoadIn=dialog&amp;reportName=Create_Template_Report&amp;recID=&lt;%=rec.ID%&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;fas fa-eye&quot;&gt;&lt;/i&gt; View Details\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&quot;#&quot;&gt;&lt;i class=&quot;fas fa-trash&quot;&gt;&lt;/i&gt;Delete&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;card-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mail-preview&quot;&gt;&lt;%=rec.Template%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mail-meta&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;mail-to&quot;&gt;&lt;i class=&quot;fas fa-envelope&quot;&gt;&lt;/i&gt; Mail For: &lt;%=rec.Email_For%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;status-badge &lt;%=if(!rec.Active,&quot;status-inactive &quot;,&quot;status-active&quot;)%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;%=if(!rec.Active,&quot;Inactive &quot;,&quot;Active&quot;)%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*.zc-content-loader div {\n display: none !important;\n}*/\n\t.main_container_img {\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tdisplay: flex;\n\t\t\t\tjustify-content: center;\n\t\t\t\talign-items: center;\n\t\t\t\tpadding: 15px;\n\t\t}\n\t.img_c {\n\t\t\t\tanimation: fadeInZoom 0.2s ease-in-out forwards;\n\t\t\t\tobject-fit: contain;\n\t\t\t\twidth: 10%;\n\t\t}\n\t\t&lt;/style&gt;\n&lt;div class=&quot;main_container_img&quot;&gt;\n&lt;div style=&quot;display: flex ; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-content: center; align-items: center;&quot;&gt;\n\t\t&lt;img class=&quot;img_c&quot; src=&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/c4yc5f4e45a3a037f4ceeb726dfdca8d7e886?x-cli-msg=%7B%22linkId%22%3A%226OxchGZlnBc-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;&gt;\n\t&lt;div style=&quot;color: #2f305d; font-weight:600;&quot;&gt; No Data Available&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page All_Mail_Templates1
		{
					displayname = "All Mail Templates"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet311' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet311()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css&quot; /&gt;\n\n&lt;style&gt;\n\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t div::-webkit-scrollbar, table::-webkit-scrollbar, tr::-webkit-scrollbar, th::-webkit-scrollbar, td::-webkit-scrollbar, ul::-webkit-scrollbar, li::-webkit-scrollbar, a::-webkit-scrollbar, form::-webkit-scrollbar, input::-webkit-scrollbar {\n\t\t display: none;\n\t}\n\tdiv, table, tr, th, td, ul, li, a, form, input {\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none; \n\t}\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight:100% !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\n:root {\n\t--primary-color: #467eee;\n}\n\n/* ===== LAYOUT ===== */\n.innerMainDiv {\n\twidth: 100%;\n\theight: 100%;\n}\n.boxContainer {\n\twidth: 100%;\n\theight: 100%;\n\tdisplay: flex;\n\tflex-direction: column;\n\tborder-radius: 10px;\n\t/*border: 1px solid #ededed;*/\n\tbackground: #fff;\n\toverflow: hidden;\n}\n.boxHeader {\n\tbackground: #ffffff;\n\theight: 50px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 0 20px;\n\tfont-weight: 600;\n\tcolor: #000;\n\tborder-bottom: 1px solid #ededed;\n}\n.boxHeader a {\n\ttext-decoration: none;\n\tbackground: var(--primary-color);\n\tcolor: #fff;\n\tpadding: 8px 16px;\n\tborder-radius: 8px;\n\tfont-weight: 500;\n\tfont-size: 14px;\n\ttransition: all 0.3s ease;\n}\n.boxHeader a:hover {\n\tbackground: var(--menu_selected_hover_bg_color);\n}\n.boxContent {\n\tflex: 1;\n\tpadding: 20px;\n\toverflow: auto;\n\tdisplay: flex;\n\tgap: 20px;\n\twidth: 100%;\n\theight: 100%;\n\tflex-wrap: wrap;\n\t\n\talign-content: flex-start;\n}\n\n/* ===== MAIL TEMPLATE CARDS ===== */\n\n.mail-card {\n\tbackground: #f8f8f8;\n\t\tborder: 1px solid #ededed;\n\t\tborder-radius: 16px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\tmax-width: 50%;\n\t\twidth: 300px;\n\t\tvertical-align: top;\n\t\ttransition: all 0.3s ease;\n\toverflow: hidden;\n}\n.mail-card:hover {\n\tbackground: #eeebfa;\n}\n\n/* Dashed separator after each card */\n.mail-card:not(:last-child)::after {\n\tcontent: &quot;&quot;;\n\tposition: absolute;\n\ttop: 10px;\n\tright: -10px;\n\twidth: 1px;\n\theight: 95%;\n\t/*border-right: 2px dashed #ccc;*/\n}\n\n/* Header Section */\n.card-header {\n\tpadding: 15px 20px;\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: flex-start;\n\t\n}\n.card-header .subject {\n\tfont-size: 16px;\n\t\tfont-weight: 600;\n\t\tcolor: #6147e5;\n\tword-break: break-word;\n\twhite-space: nowrap;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n}\n.card-header .options-container {\n\tposition: relative;\n\t    transform: rotate(90deg);\n}\n.options-toggle {\n\tbackground: none;\n\tborder: none;\n\tfont-size: 18px;\n\tcolor: #a0aec0;\n\tcursor: pointer;\n}\n.options-menu {\n\tposition: absolute;\n\ttop: 100%;\n\tright: 0;\n\tbackground: #fff;\n\tborder-radius: 10px;\n\tbox-shadow: 0 10px 30px rgba(0,0,0,0.15);\n\twidth: 180px;\n\tdisplay: none;\n\tborder: 1px solid #e2e8f0;\n\tz-index: 5;\n}\n.options-menu a {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tpadding: 12px 15px;\n\ttext-decoration: none;\n\tcolor: #4a5568;\n\tfont-size: 14px;\n\ttransition: 0.2s;\n}\n.options-menu a:hover {\n\tbackground: #f7fafc;\n\tcolor: var(--primary-color);\n}\n.options-toggle:focus + .options-menu,\n.options-menu:hover {\n\tdisplay: block;\n}\n\n/* Body Section */\n.mail-card:hover .card-body{\n\t\tbackground: #eeebfa;\n}\n.card-body {\n\tpadding: 15px 20px;\n\toverflow: hidden;\n\tdisplay: flex;\n\theight: calc(100% - 53px);\n\tflex-direction: column;\n\tjustify-content: space-between;\n\tbackground: #ffffff;\n}\n.mail-preview {\n\tfont-size: 14px;\n\t\tcolor: #4a5568;\n\t\tline-height: 1.6;\n\t\tword-wrap: break-word;\n\t\theight: calc(100% - 39px);\n\t\toverflow: auto;\n}\n.mail-meta {\n\tmargin-top: 12px;\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tflex-wrap: wrap;\n\t\tgap: 6px;\n}\n.mail-to {\n\tfont-size: 13px;\n\tcolor: #718096;\n\tfont-weight: 500;\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 6px;\n}\n.mail-to i {\n\tcolor: var(--primary-color);\n}\n.status-badge {\n\tpadding: 6px 12px;\n\tborder-radius: 20px;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\ttext-transform: uppercase;\n}\n.status-active {\n\tbackground: #d1fae5;\n\tcolor: #065f46;\n}\n.status-inactive {\n\tbackground: #fee2e2;\n\tcolor: #991b1b;\n}\n\n/* Empty State */\n.noDetailDiv {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 100%;\n\tcolor: #626262;\n\tfont-weight: 500;\n\twidth: 100%;\n}\n@media (max-width:768px){\n\t.mail-card {\n\t\twidth: 90%;\n\t\tmin-width: 90%;\n\t}\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;innerMainDiv&quot;&gt;\n\t&lt;div class=&quot;boxContainer&quot;&gt;\n\t\t&lt;div class=&quot;boxHeader&quot;&gt;\n\t\t\t&lt;div&gt;All Mail Templates&lt;/div&gt;\n\t\t\t&lt;a href=&quot;#Form:Create_Template?zc_LoadIn=embed-embedDiv&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&amp;&quot;&gt;+ Add Template&lt;/a&gt;\n\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;boxContent&quot;&gt;\n&lt;%\n\tfetchSalesOrder = Create_Template[ID != null];\n\tif(fetchSalesOrder.count() != 0)\n\t{\n\t\tfetchSalesOrder1 = Create_Template[ID != null].distinct(Email_For);\n\t\tfor each  rec in fetchSalesOrder1\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;mail-card&quot;&gt;\n\t\t\t&lt;a class=&quot;card-header&quot; href=&quot;#Page:All_Mail_Templates?zc_LoadIn=embed-embedDiv&amp;recID=&lt;%=rec%&gt;&quot;&gt;\n\t  &lt;div class=&quot;subject&quot;&gt;&lt;%=rec%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;options-container&quot;&gt;\n\t\t\t\t\t&lt;button class=&quot;options-toggle&quot;&gt;&lt;i class=&quot;fas fa-ellipsis-v&quot;&gt;&lt;/i&gt;&lt;/button&gt;\n\t\t\t\t\t\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t \n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*.zc-content-loader div {\n display: none !important;\n}*/\n\t.main_container_img {\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tdisplay: flex;\n\t\t\t\tjustify-content: center;\n\t\t\t\talign-items: center;\n\t\t\t\tpadding: 15px;\n\t\t}\n\t.img_c {\n\t\t\t\tanimation: fadeInZoom 0.2s ease-in-out forwards;\n\t\t\t\tobject-fit: contain;\n\t\t\t\twidth: 10%;\n\t\t}\n\t\t&lt;/style&gt;\n&lt;div class=&quot;main_container_img&quot;&gt;\n&lt;div style=&quot;display: flex ; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-content: center; align-items: center;&quot;&gt;\n\t\t&lt;img class=&quot;img_c&quot; src=&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/c4yc5f4e45a3a037f4ceeb726dfdca8d7e886?x-cli-msg=%7B%22linkId%22%3A%226OxchGZlnBc-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;&gt;\n\t&lt;div style=&quot;color: #2f305d; font-weight:600;&quot;&gt; No Data Available&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Approval_Setup(string module, int recID)
		{
					displayname = "Approval_Setup"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet4' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet4()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n.zc-content-loader div {\n display: none !important;\n}\n\t* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\t.zcform_Delete_form .first-column .form-label {\n\t\twidth: unset !important;\n}\n.zcform_Delete_form .zcpopup .popupbox form .zc-footer-wrapper .formbutton .zc-live-primary-btn\n{\n\tdisplay: unset !important;\n}\n.zcform_Delete_form .zcpopup .statelessFormWidth .form-action .zc-live-primary-btn {\n\tmargin: 0 10px 0 0 !important;\n}\n.zcform_Delete_form  .zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .form-outer-wrapper form .formContainer {\n\t\tpadding: 0px 30px !important;\n}\n// \t.zc-freezer.zc-freezer-layer {\n// \t\tdisplay: none !important;\n// \t}\n// \t.popupbox-wrapper {\n// \t\tpadding: 14px;\n// \t\tmargin-left: 240px;\n// \t\ttop: 36px;\n// \t\tbottom: 0;\n// \t\tright: 0;\n// \t\tleft: 0;\n// \t\tbackground-color: #f3f4f8;\n// \t\tbox-sizing: border-box;\n// \t\toverflow: hidden;\n// \t\tborder-left: 1px solid rgba(0, 0, 0, 0.05);\n// \t}\n// \t.popupbox {\n// \t\twidth: 100%;\n// \t\theight: 100%;\n// \t\tmax-width: 100% !important;\n// \t\tmax-height: 100% !important;\n// \t\tmargin: unset !important;\n// \t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n// \t.inner .page_content_wrapper.zc-page-content-wrapper {\n// \t\ttop: 40px !important;\n// \t\tbottom: 0 !important;\n// \t\twidth: 100% !important;\n// \t\tmargin: 0 !important;\n// \t}\n\t\n&lt;/style&gt;\n&lt;style&gt;\n/* Decision box(Search - cancel icon) */ .zc-pra-filter .form-group.zc-decisionbox-field-group { width: auto; height: 36px; position: absolute; right: 7px; top: 0px; z-index: 1; margin: 0px; } .zc-pra-filter .form-group .decision-box-field { display: none; } .zc-pra-filter .form-outer-wrapper .formColumn .zc-decisionbox-field-group .form-label.decision-box-label { height: 36px; font-size: 0px; line-height: 36px; padding: 0px; } .zc-pra-filter .form-label.decision-box-label:before { content: &apos;\\ed84&apos;; font-family: &apos;ZC Live Outline&apos;; font-size: 17px; } .zc-pra-filter .form-label.decision-box-label:hover:before { color: #EE3131; } .zc-pra-filter .form-group .cogLoader { margin: 11px 3px; }.zc-rtl-wrapper .zc-pra-filter .formColumn:not(.first-column) .form-group:not(:first-child) { margin-left: 0px; margin-right: 20px; } .zc-rtl-wrapper .zc-pra-filter .formContainer .formColumn.second-column { float: left; } /* Placeholder */ .zc-rtl-wrapper .zc-pra-filter .first-column .form-group label .zc-label-text:after { margin-left: 0px; margin-right: 18px; } .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search_Key-group .form-field:before, .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search-group .form-field:before { left: auto; right: 12px; } /* Decision box(Search - cancel icon) */ .zc-rtl-wrapper .zc-pra-filter .form-group.zc-decisionbox-field-group { right: auto; left: 7px; }.zc-pra-more-options { border: 1px solid; text-align: center; cursor: pointer; position: relative; } .zc-pra-more-options.zc-pra-square { width: 36px; height: 36px; background-color: #FFFFFF; border-color: #EBECF0; border-radius: 6px; color: #666D79; } .zc-pra-more-options.zc-pra-rounded { width: 30px; height: 30px; background-color: transparent; border-color: transparent; border-radius: 50%; color: #666D79; } .zc-pra-more-options .zc-pra-hover-extend { width: calc(160px / 2); height: 20px; position: absolute; z-index: 0; right: 0px; bottom: -7px; display: none; } .zc-pra-more-options .fa.fa-bars, .zc-pra-more-options .fa.fa-ellipsis-h, .zc-pra-more-options .ui-2-menu-dots { vertical-align: top; } .zc-pra-more-options .fa.fa-bars { line-height: 34px; } .zc-pra-more-options .fa.fa-ellipsis-h, .zc-pra-more-options .ui-2-menu-dots { line-height: 28px; } .zc-pra-more-options.zc-pra-square ul { top: 40px; } .zc-pra-more-options.zc-pra-rounded ul { top: 34px; } .zc-pra-more-options ul { width: 160px; background-color: #FFFFFF; box-shadow: 0 2px 9px 0 #d8d8d880; border: 1px solid #EBECF0; border-radius: 6px; padding: 8px; position: absolute; right: 0px; z-index: 2; display: none; } .zc-pra-more-options ul li { list-style-type: none; } .zc-pra-more-options ul li:not(:last-child) { margin-bottom: 4px; } .zc-pra-more-options ul li a { width: 100%; display: inline-block; vertical-align: top; font-size: 14px; font-weight: 400; line-height: 20px; color: #131635; text-align: left; padding: 8px; border-radius: 6px; } .zc-pra-more-options ul li a i, .zc-pra-more-options ul li a span { float: left; } .zc-pra-more-options ul li.zc-pra-color-red a i, .zc-pra-more-options ul li.zc-pra-color-red a span { color: #E71F43; } .zc-pra-more-options ul li a i { width: 14px; line-height: 20px; margin-right: 8px; } .zc-pra-more-options ul li a i+span { width: calc(100% - 22px); } .zc-pra-more-options.zc-pra-square:hover { border-color: var(--theme_brand_color); color: var(--theme_brand_color); } .zc-pra-more-options.zc-pra-rounded:hover { background-color: #EAECF0; color: #131635; } .zc-pra-more-options:hover&gt;.zc-pra-hover-extend, .zc-pra-more-options:hover ul { display: block; } .zc-pra-more-options ul li a:hover { background-color: var(--left_pane_section_selected); } .zc-pra-more-options ul li.zc-pra-color-red a:hover { background-color: #E71F431A; } .zc-pra-more-options i { font-style: normal; }.zc-rtl-wrapper .zc-pra-more-options .zc-pra-hover-extend, .zc-rtl-wrapper .zc-pra-more-options ul { right: auto; left: 0px; } .zc-rtl-wrapper .zc-pra-more-options ul li a { text-align: right; } .zc-rtl-wrapper .zc-pra-more-options ul li a i, .zc-rtl-wrapper .zc-pra-more-options ul li a span { float: right; } .zc-rtl-wrapper .zc-pra-more-options ul li a i { margin-right: 0px; margin-left: 8px; }.zc-pra-custom-detail-content { height: calc(100% - 68px); padding: 30px 0px; overflow-x: hidden; } .zc-pra-filter .select2-container.select2-allowclear .select2-choice abbr { display: none; } ul.zc-pra-zigzag-wrapper { width: 725px; position: relative; margin: 0px auto 20px; display: flex; justify-content: center; } ul.zc-pra-zigzag-wrapper:nth-child(odd) { justify-content: flex-start; } ul.zc-pra-zigzag-wrapper li.zc-pra-zigzag-li { display: flex; flex-direction: row; align-items: center; } ul.zc-pra-zigzag-wrapper li .zc-pra-card { width: 300px; box-shadow: 0 2px 9px 0 #d8d8d880; position: relative; z-index: 1; } .zc-pra-zcard-header { padding: 10px 16px; border-bottom: 1px solid #EBECF0; } .zc-pra-zcard-title { width: calc(100% - 30px); padding: 5px 0px; } .zc-pra-no-wrapper { width: 20px; height: 20px; border-radius: 4px; margin-right: 8px; background-color: var(--section_menu_active_bg_color); color: var(--theme_brand_color); font-size: 14px; font-weight: 500; line-height: 20px; text-align: center; } .zc-pra-zcard-title h6 { width: calc(100% - 28px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-zcard-content { padding: 16px; } .zc-pra-zcard-content ul li { list-style-type: none; } .zc-pra-zcard-content ul li:not(:last-child) { margin-bottom: 8px; } .zc-pra-zcard-content label, .zc-pra-zcard-content span { font-size: 14px; line-height: 29px; display: inline-block; vertical-align: top; } .zc-pra-zcard-content label { width: 80px; font-weight: 400; color: #666D79; padding-right: 8px; } .zc-pra-zcard-badge { display: inline-block; vertical-align: top; } .zc-pra-zcard-content span { color: #131635; font-weight: 500; } .zc-pra-zcard-content span.zc-pra-currency-value { margin: 0px; } .zc-pra-zcard-badge span { background-color: var(--section_menu_active_bg_color); padding: 4px 8px; border-radius: 4px; line-height: 21px; } .zc-pra-zcard-content &gt; ul &gt; li &gt; span, .zc-pra-zcard-content &gt; ul &gt; li &gt; div { width: calc(100% - 80px); } .zc-pra-zcard-content span.zc-pra-color-green { color: #179E6C; } .zc-pra-zcard-content .zc-pra-img-wrapper { width: 30px; height: 30px; border-radius: 50%; margin: 6px 8px 6px 0px; } .zc-pra-zcard-content .zc-pra-img-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: contain; } .zc-pra-zcard-content .zc-pra-img-txt-wrapper { width: calc(100% - 38px); } .zc-pra-img-txt-wrapper span { line-height: 1.5; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-img-txt-wrapper span.zc-pra-sm-txt { font-size: 12px; color: #666D79; margin-top: 3px; } \n.zc-pra-fwh {\n\t\twidth: 100%;\n\t\theight: 100%;\n}\nul.zc-pra-zigzag-wrapper li .zc-pra-card{\n\toverflow: hidden;\n}\n.zc-pra-zcard-header{\n\tbackground: var(--theme_brand_color);\n}\n.zc-pra-page-container h6{\n\tcolor: #ffffff !important;\n}\n.zc-pra-more-options .ui-2-menu-dots{\n\t    color: #ffffff;\n}\n.zc-pra-more-options:hover .ui-2-menu-dots {\n\t\tcolor:  var(--theme_brand_color); \n}\n\n.zc-pra-nodata {\n\t\tposition: relative;\n\t\ttext-align: center;\n}\n.zc-pra-nodata-content {\n\t\tposition: absolute;\n\t\ttop: 50%;\n\t\tleft: 50%;\n\t\ttransform: translate(-50%, -50%);\n}\n.zc-pra-more-options ul li a:hover {\n\t\tbackground-color: #ebf0ff;\n}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100%;\n\t}\n\t.zc-pra-nodata-btns {\n\t\tmargin-top: 24px;\n}\n.zc-pra-no-wrapper {\n\t\tbackground-color: var(--secondary_color) !important;\n}\n.zc-pra-zcard-badge span {\n\t background-color: var(--secondary_color) !important;\n\tcolor: var(--theme_brand_color) !important;\n}\n.zc-pra-page-content{\n\tpadding: unset !important;\n}\n\n&lt;/style&gt;\n&lt;%\n\tapprovalFlows = Add_Approval_Setup[Approval_Setup_For == input.recID &amp;&amp; Status == null || Status == &quot;Active&quot;] sort by Sequence_Order;\n\tflowsList = List();\n\tfor each  flow in approvalFlows\n\t{\n\t\tflowsList.add({&quot;Level_Name&quot;:flow.Level_Name,&quot;Approver_Role&quot;:flow.Approver_Role.Role,&quot;Approver_Type&quot;:flow.Approver_Type,&quot;ID&quot;:flow.ID,&quot;Previous_Sequence_Number&quot;:flow.Sequence_Order,&quot;Is_Last_Step&quot;:flow.Is_Last_Step,&quot;Requester_Role_Param&quot;:flow.Added_User,&quot;users&quot;:flow.users});\n\t}\n\t%&gt;\n&lt;style&gt;\n/*trmp*/\n.zc-pra-setup .divEmbedContainer {\n\theight: calc(100% - 87px) !important;\n}\nul.zc-pra-horizontal-tabhead {\n\t\tdisplay: none !important;\n}\n\n.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .zc-pb-page-content-wrapper {\n\tborder-radius:unset !important;\n}\n.zc-pra-card.zc-pra-horizontal-tabpanel {\n\theight: calc(100% - 70px) ;\n\tborder: unset !important;\n\t}\n\t.zc-pra-page-content, .zc-pra-custom-detail-content, .zc-pra-horizontal-tabbody{\n\t   height: 100% !important;\t\n\t}\n\t\n/*end*/\n&lt;%=thisapp.styles.CommonStyles()%&gt;\n&lt;%=thisapp.PageStyles.Custom_Approval_Template()%&gt;\n&lt;%=thisapp.PageStyles.Custom_Approval_Details()%&gt;\n\n&lt;/style&gt;\n&lt;div class=&apos;zc-pra-page-container zc-pra-system-detail&apos;&gt;\n\t&lt;div class=&apos;zc-pra-page-container-inner zc-pra-fwh&apos;&gt;\n\t\t&lt;div class=&apos;zc-pra-page-header zc-pra-clearfix zc-pra-fw&apos; style=&quot;padding: 10px !important; border-bottom: unset;&quot;&gt;\n\t\t\t&lt;div class=&apos;zc-pra-flt-left zc-pra-clearfix zc-pra-header-title&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zc-pra-flt-left zc-pra-back-icon&apos; href=&apos;#Page:All_Approval_Setup?zc_LoadIn=embed-embedDiv&apos;&gt;\n\t\t\t\t\t&lt;span class=&apos;fa fa-angle-left&apos;&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;h5 class=&apos;zc-pra-flt-left&apos;&gt;Back&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\n&lt;/div&gt;\n\t\t&lt;div class=&apos;zc-pra-page-content&apos;&gt;\n\t\t\t&lt;div class=&apos;zc-pra-card zc-pra-horizontal-tabpanel&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zc-pra-horizontal-tabhead&apos;&gt;\n\t\t\t\t\t&lt;li&gt; \n\t\t\t\t\t\t&lt;a href=&apos;#Page:Approval_Setup?recID=1&amp;module=Purchase-Request&apos; class=&apos;Purchase-Request&apos;&gt; Vendor Onboard Approval&lt;/a&gt; \n\t\t\t  \t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li&gt;\n\t\t\t\t\t\t&lt;a href=&apos;#Page:Approval_Setup?recID=2&amp;module=Purchase-Order&apos; class=&apos;Purchase-Order&apos;&gt;Invoice Approval&lt;/a&gt; \n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;div class=&apos;zc-pra-horizontal-tabbody&apos;&gt;\n\t\t\t\t\t&lt;!--&lt;div class=&apos;zc-pra-filter&apos; elName=&apos;zc-component&apos; formLinkName=&apos;Approval_Filter_Form&apos; params=&apos;&apos;&gt;&lt;/div&gt;--&gt;\n\t\t\t\t\t&lt;div class=&apos;zc-pra-custom-detail-content zc-pra-fwh &apos;&gt;\n&lt;%\n\tif(approvalFlows.count() &gt; 0)\n\t{\n\t\ti = 0;\n\t\tcounter = 1;\n\t\tfor each  item in flowsList\n\t\t{\n\t\t\tif(counter.isOdd())\n\t\t\t{\n\t\t\t\tif(counter &gt; 1)\n\t\t\t\t{\n\t\t\t\t\ti = i + 1;\n\t\t\t\t}\n\t\t\t\tsecondLiIndex = i + 1;\n\t\t\t\tif(i &lt; flowsList.size())\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;ul class=&apos;zc-pra-zigzag-wrapper&apos;&gt;\n\t\n\t\t\t\t\t\t\t&lt;%=thisapp.Components.ApprovalCard({&quot;ID&quot;:flowsList.get(i).get(&quot;ID&quot;),&quot;Sequence_Order&quot;:i + 1,&quot;Level_name&quot;:flowsList.get(i).get(&apos;Level_Name&apos;),&quot;Approval_For_Role&quot;:flowsList.get(i).get(&quot;Approval_For_Role&quot;),&quot;Approver_Type&quot;:flowsList.get(i).get(&apos;Approver_Type&apos;),&quot;Approver_Role&quot;:flowsList.get(i).get(&quot;Approver_Role&quot;),&quot;Previous_Sequence_Number&quot;:flowsList.get(i).get(&quot;Previous_Sequence_Number&quot;),&quot;Show_Add_Before&quot;:if(counter == 1,true,false),&quot;Type_field&quot;:input.recID,&quot;Template_ID&quot;:input.recID,&quot;Approver_User&quot;:flowsList.get(i).get(&apos;Approver_User&apos;),&quot;Is_Preview&quot;:false,&quot;Price_From&quot;:flowsList.get(i).get(&quot;Price_From&quot;),&quot;Price_To&quot;:flowsList.get(i).get(&quot;Price_To&quot;),&quot;Is_Last_Step&quot;:flowsList.get(i).get(&quot;Is_Last_Step&quot;),&quot;Requester_Role_Param&quot;:flowsList.get(i).get(&quot;Requester_Role_Param&quot;),&quot;users&quot;:flowsList.get(i).get(&quot;users&quot;)})%&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\tif(secondLiIndex &lt; flowsList.size())\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;%=thisapp.Components.ApprovalCard({&quot;ID&quot;:flowsList.get(secondLiIndex).get(&quot;ID&quot;),&quot;Sequence_Order&quot;:secondLiIndex + 1,&quot;Level_name&quot;:flowsList.get(secondLiIndex).get(&apos;Level_Name&apos;),&quot;Approval_For_Role&quot;:flowsList.get(secondLiIndex).get(&quot;Approval_For_Role&quot;),&quot;Approver_Type&quot;:flowsList.get(secondLiIndex).get(&apos;Approver_Type&apos;),&quot;Approver_Role&quot;:flowsList.get(secondLiIndex).get(&quot;Approver_Role&quot;),&quot;Previous_Sequence_Number&quot;:flowsList.get(secondLiIndex).get(&quot;Previous_Sequence_Number&quot;),&quot;Show_Add_Before&quot;:false,&quot;Type_field&quot;:input.recID,&quot;Template_ID&quot;:input.recID,&quot;Approver_User&quot;:flowsList.get(secondLiIndex).get(&apos;Approver_User&apos;),&quot;Is_Preview&quot;:false,&quot;Price_From&quot;:flowsList.get(secondLiIndex).get(&quot;Price_From&quot;),&quot;Price_To&quot;:flowsList.get(secondLiIndex).get(&quot;Price_To&quot;),&quot;Is_Last_Step&quot;:flowsList.get(secondLiIndex).get(&quot;Is_Last_Step&quot;),&quot;Requester_Role_Param&quot;:flowsList.get(secondLiIndex).get(&quot;Requester_Role_Param&quot;),&quot;users&quot;:flowsList.get(secondLiIndex).get(&quot;users&quot;)})%&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tsingleIndex = i + 1;\n\t\t\t\tif(singleIndex &lt; flowsList.size())\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;ul class=&apos;zc-pra-zigzag-wrapper&apos;&gt;\n&lt;%=thisapp.Components.ApprovalCard({&quot;ID&quot;:flowsList.get(singleIndex).get(&quot;ID&quot;),&quot;Sequence_Order&quot;:singleIndex + 1,&quot;Level_name&quot;:flowsList.get(singleIndex).get(&apos;Level_Name&apos;),&quot;Approval_For_Role&quot;:flowsList.get(singleIndex).get(&quot;Approval_For_Role&quot;),&quot;Approver_Type&quot;:flowsList.get(singleIndex).get(&apos;Approver_Type&apos;),&quot;Approver_Role&quot;:flowsList.get(singleIndex).get(&quot;Approver_Role&quot;),&quot;Previous_Sequence_Number&quot;:flowsList.get(singleIndex).get(&quot;Previous_Sequence_Number&quot;),&quot;Show_Add_Before&quot;:false,&quot;Type_field&quot;:input.recID,&quot;Template_ID&quot;:input.recID,&quot;Approver_User&quot;:flowsList.get(singleIndex).get(&apos;Approver_User&apos;),&quot;Is_Preview&quot;:false,&quot;Price_From&quot;:flowsList.get(singleIndex).get(&quot;Price_From&quot;),&quot;Price_To&quot;:flowsList.get(singleIndex).get(&quot;Price_To&quot;),&quot;Is_Last_Step&quot;:flowsList.get(singleIndex).get(&quot;Is_Last_Step&quot;),&quot;Requester_Role_Param&quot;:flowsList.get(singleIndex).get(&quot;Requester_Role_Param&quot;),&quot;users&quot;:flowsList.get(singleIndex).get(&quot;users&quot;)})%&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\ti = i + 1;\n\t\t\tcounter = counter + 1;\n\t\t}\n\t}\n\telse\n\t{\n\t\timg_src = &quot;&quot;;\n\t\tlastRec = Add_Approval_Setup[Approval_Setup_For == input.recID] sort by Sequence_Order desc range from 0 to 0;\n\t\tif(lastRec.count() &gt; 0)\n\t\t{\n\t\t\tpreviousSequenceNumber = lastRec.Sequence_Order;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tpreviousSequenceNumber = 0;\n\t\t}\n\t\t%&gt;\n&lt;div class=&apos;zc-pra-nodata zc-pra-fwh&apos;&gt;\n\t\t&lt;div class=&apos;zc-pra-nodata-content&apos;&gt;\n\t\t\t\t&lt;img alt=&quot;No Data&quot; src=&quot;data:image/svg+xml;base64,&quot;&gt;\n\t\t\t\t&lt;h6&gt; No Data &lt;/h6&gt;\n\t\t\t\t&lt;div class=&apos;zc-pra-nodata-btns&apos;&gt;\n\t\t\t\t &lt;a class=&apos;zc-live-primary-btn&apos; href=&apos;#Form:Add_Approval_Setup?Add_Type=Specific&amp;zc_LoadIn=dialog&amp;Type_field=&lt;%=input.recID%&gt;&amp;Sequence_Order=0&amp;Sequence_Order_Display=0&amp;Previous_Sequence_Number=0&apos;&gt; Add Step &lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Billing_Detail(int Invoice_ID)
		{
					displayname = "Billing Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Billing_Detail_Main' elementName='Billing_Detail_Main'>\n\t\t\t\t\t<![CDATA[htmlpage Billing_Detail_Main()\n\t\t\t\t\t\tcontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tinvoiceRows = Create_Invoice[ID == input.Invoice_ID];\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility subset included once for this page ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);\n\t--zcs_brand_color: #6147E5;\n\t--zcs_brand_foreground_color: #FFFFFF;\n\t--zcs_brand_dark_color: #4E38C8;\n\t--zcs_brand_light_color: #F1EEFF;\n\t--zcs_primary_text_color: #17142F;\n\t--zcs_secondary_text_color: #4F5873;\n\t--zcs_tertiary_text_color: #7A8094;\n\t--zcs_tertiary_border_color: #E7E8F0;\n\t--zcs_primary_border_color: #E0E2EA;\n\t--zcs_component_hover_color: #F4F1FF;\n\t--zcs_light_grey_color: #F7F8FC;\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-page-bg-color: #F6F7FB;\n\t--bd-primary: #6147E5;\n\t--bd-primary-dark: #4E38C8;\n\t--bd-bg: #F6F7FB;\n\t--bd-surface: #FFFFFF;\n\t--bd-border: #E7E8F0;\n\t--bd-text: #17142F;\n\t--bd-muted: #6B7280;\n\t--bd-soft: #F1EEFF;\n\t--bd-success: #179E6C;\n\t--bd-warning: #B8770D;\n\t--bd-danger: #D92D20;\n\t--bd-info: #2A6FFC;\n\t--bd-gap: 15px;\n\t--bd-radius: 12px;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n/* ===== ZCS component CSS: button-primary-button and button-secondary-button ===== */\n.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0;transition:background .15s ease,border-color .15s ease,color .15s ease}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-secondary-button:hover,.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus,.zcs-secondary-button.zcs-button:active,.zcs-secondary-button.zcs-button:focus,.zcs-primary-outline-button.zcs-button:active,.zcs-primary-outline-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-button-text{white-space:nowrap}\n/* ===== ZCS component CSS: badge-filled-badge ===== */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n/* ===== ZCS component CSS: table-simple-table ===== */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#FE455D}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-l_blue{color:#1094C5}\n/* ===== Billing Detail approved CSS block ===== */\n*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.billing-detail{width:100%;min-height:100%;background:var(--bd-bg);color:var(--bd-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--bd-gap);overflow:auto}.bd-shell{display:flex;flex-direction:column;gap:var(--bd-gap);max-width:1680px;margin:0 auto}.bd-header{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--bd-gap);padding:15px;border:1px solid var(--bd-border);border-radius:var(--bd-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.bd-title-block{min-width:0;flex:1}.bd-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--bd-primary);margin:0 0 4px}.bd-title{font-size:24px;line-height:1.2;font-weight:700;color:var(--bd-text);margin:0}.bd-subtitle{margin:6px 0 0;color:var(--bd-muted)}.bd-action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end;max-width:820px}.bd-action-row .zcs-button,.bd-section-actions .zcs-button{border-radius:8px}.bd-badge-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.bd-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--bd-gap);align-items:start}.bd-card{grid-column:span 4;background:var(--bd-surface);border:1px solid var(--bd-border);border-radius:var(--bd-radius);overflow:hidden;min-height:100%;display:flex;flex-direction:column}.bd-card.bd-wide{grid-column:span 8}.bd-card.bd-full{grid-column:span 12}.bd-card-header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px;border-bottom:1px solid var(--bd-border);background:#fff}.bd-card-title{display:flex;flex-direction:column;gap:2px;min-width:0}.bd-card-title h2{font-size:16px;line-height:1.25;font-weight:700;color:var(--bd-text);margin:0}.bd-card-title p{font-size:12px;color:var(--bd-muted);margin:0}.bd-card-body{padding:15px}.bd-section-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.bd-kv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.bd-kv-grid.single{grid-template-columns:1fr}.bd-kv{border:1px solid var(--bd-border);border-radius:10px;padding:12px;background:#FCFCFF;min-width:0}.bd-kv label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--bd-muted);margin-bottom:5px}.bd-kv strong,.bd-kv span{display:block;color:var(--bd-text);word-break:break-word}.bd-kv small{display:block;color:var(--bd-muted);font-size:12px;margin-top:4px;word-break:break-word}.bd-metrics{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:var(--bd-gap)}.bd-metric{border:1px solid var(--bd-border);border-radius:var(--bd-radius);padding:15px;background:#fff}.bd-metric label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--bd-muted);margin-bottom:6px}.bd-metric strong{display:block;font-size:20px;line-height:1.2;color:var(--bd-text);word-break:break-word}.bd-metric.balance strong{color:var(--bd-danger)}.bd-metric.balance-paid strong{color:var(--bd-success)}.bd-related-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--bd-gap)}.bd-related{grid-column:span 6;background:var(--bd-surface);border:1px solid var(--bd-border);border-radius:var(--bd-radius);overflow:hidden;display:flex;flex-direction:column;min-height:330px}.bd-related.bd-related-full{grid-column:span 12}.bd-scroll{height:260px;overflow:auto;padding:15px}.bd-history-scroll{height:360px;overflow:auto;padding:15px}.bd-table{min-width:720px}.bd-table.compact{min-width:560px}.bd-table .bd-main{font-weight:600;color:var(--bd-text)}.bd-table .bd-sub{font-size:12px;color:var(--bd-muted);margin-top:2px}.bd-status-pill{font-size:12px;font-weight:600;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:220px}.bd-status-primary{background:#F1EEFF;color:var(--bd-primary)}.bd-status-success{background:#E4FCF3;color:var(--bd-success)}.bd-status-warning{background:#FCF4E6;color:var(--bd-warning)}.bd-status-danger{background:#FDE3E6;color:var(--bd-danger)}.bd-status-info{background:#E8EFFF;color:var(--bd-info)}.zcs-nodata-wrapper{min-height:150px;border:1px dashed var(--bd-border);border-radius:var(--bd-radius);background:#FCFCFF}.zcs-nodata-header{font-size:15px}.bd-empty-text{color:var(--bd-muted);margin:6px 0 0}.bd-alert{display:flex;gap:10px;align-items:flex-start;border:1px solid #F7C7CB;background:#FFF5F6;color:#9E1C2B;border-radius:var(--bd-radius);padding:15px}.bd-alert i{font-size:18px;line-height:1.2}.bd-mobile-list{display:none}.bd-mobile-card{border:1px solid var(--bd-border);border-radius:var(--bd-radius);padding:12px;background:#fff;margin-bottom:10px}.bd-mobile-card:last-child{margin-bottom:0}.bd-mobile-card-title{font-weight:700;margin:0 0 4px;color:var(--bd-text)}.bd-mobile-card-line{font-size:12px;color:var(--bd-muted);margin:2px 0}.bd-mobile-card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1280px){.bd-card,.bd-card.bd-wide{grid-column:span 6}.bd-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.bd-related{grid-column:span 12}}@media (max-width:860px){.billing-detail{padding:15px}.bd-header{flex-direction:column}.bd-action-row,.bd-section-actions{justify-content:flex-start;max-width:none}.bd-card,.bd-card.bd-wide,.bd-card.bd-full{grid-column:span 12}.bd-kv-grid,.bd-metrics{grid-template-columns:1fr}.bd-scroll{height:300px}.bd-table-wrapper-mobile{display:none}.bd-mobile-list{display:block}}@media (max-width:520px){.bd-title{font-size:20px}.bd-card-header{align-items:flex-start;flex-direction:column}.bd-action-row .zcs-button{width:100%}}\n&lt;/style&gt;\n\n&lt;div class=&quot;billing-detail&quot;&gt;\n\t&lt;div class=&quot;bd-shell&quot;&gt;\n&lt;%\n\tif(invoiceRows.count() == 0)\n\t{\n%&gt;\n\t\t&lt;div class=&quot;bd-alert&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;strong&gt;Invoice not found&lt;/strong&gt;\n\t\t\t\t&lt;div&gt;The requested invoice could not be found or you do not have access to it.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tinvoiceRec = invoiceRows;\n\t\tinvoiceStatus = ifnull(invoiceRec.Invoice_Status,&quot;Draft&quot;);\n\t\tsubtotal = ifnull(invoiceRec.Subtotal,0);\n\t\ttaxAmount = ifnull(invoiceRec.Tax_Amount,0);\n\t\tdiscountAmount = ifnull(invoiceRec.Discount_Amount,0);\n\t\ttotalAmount = ifnull(invoiceRec.Total_Amount,0);\n\t\tamountPaid = ifnull(invoiceRec.Amount_Paid,0);\n\t\tbalanceDue = ifnull(invoiceRec.Balance_Due,0);\n\t\tlineTotal = Add_Invoice_Item[Invoice == invoiceRec.ID].sum(Amount);\n\t\tif(lineTotal == null){lineTotal = 0;}\n\t\tpaymentTotal = Add_Payment[Invoice == invoiceRec.ID &amp;&amp; (Payment_Status == &quot;Received&quot; || Payment_Status == &quot;Reconciled&quot;)].sum(Amount);\n\t\tif(paymentTotal == null){paymentTotal = 0;}\n\t\tclientName = &quot;Not set&quot;;\n\t\tclientEmail = &quot;&quot;;\n\t\tclientPhone = &quot;&quot;;\n\t\tclientStatus = &quot;&quot;;\n\t\tif(invoiceRec.Client != null)\n\t\t{\n\t\t\tclientRec = Add_Client[ID == invoiceRec.Client];\n\t\t\tif(clientRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tclientName = ifnull(clientRec.Client_Name,&quot;Not set&quot;);\n\t\t\t\tclientEmail = ifnull(clientRec.Primary_Email,&quot;&quot;);\n\t\t\t\tclientPhone = ifnull(clientRec.Primary_Phone,&quot;&quot;);\n\t\t\t\tclientStatus = ifnull(clientRec.Client_Status,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tcaseTitle = &quot;Not set&quot;;\n\t\tcaseNumber = &quot;&quot;;\n\t\tcaseStatus = &quot;&quot;;\n\t\tbillingAttorney = &quot;Not assigned&quot;;\n\t\tif(invoiceRec.Case != null)\n\t\t{\n\t\t\tcaseRec = Create_Case[ID == invoiceRec.Case];\n\t\t\tif(caseRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tcaseTitle = ifnull(caseRec.Case_Title,&quot;Not set&quot;);\n\t\t\t\tcaseNumber = ifnull(caseRec.Case_Number,caseRec.ID);\n\t\t\t\tcaseStatus = ifnull(caseRec.Case_Status,&quot;&quot;);\n\t\t\t\tif(caseRec.Billing_Attorney != null)\n\t\t\t\t{\n\t\t\t\t\tba = Add_Employee[ID == caseRec.Billing_Attorney];\n\t\t\t\t\tif(ba.count() &gt; 0){billingAttorney = ifnull(ba.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(ba.Employee_Name.last_name,&quot;&quot;);}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tpreparedBy = &quot;Not assigned&quot;;\n\t\tif(invoiceRec.Prepared_By != null)\n\t\t{\n\t\t\tprep = Add_Employee[ID == invoiceRec.Prepared_By];\n\t\t\tif(prep.count() &gt; 0){preparedBy = ifnull(prep.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(prep.Employee_Name.last_name,&quot;&quot;);}\n\t\t}\n\t\tapprovedBy = &quot;Not assigned&quot;;\n\t\tif(invoiceRec.Approved_By != null)\n\t\t{\n\t\t\tappr = Add_Employee[ID == invoiceRec.Approved_By];\n\t\t\tif(appr.count() &gt; 0){approvedBy = ifnull(appr.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(appr.Employee_Name.last_name,&quot;&quot;);}\n\t\t}\n\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\tstatusIcon = &quot;ui-2-time&quot;;\n\t\tif(invoiceStatus == &quot;Paid&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t\t\tstatusIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\telse if(invoiceStatus == &quot;Overdue&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-red&quot;;\n\t\t\tstatusIcon = &quot;ui-2-alert-circle&quot;;\n\t\t}\n\t\telse if(invoiceStatus == &quot;Cancelled&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\tstatusIcon = &quot;ui-1-circle-remove&quot;;\n\t\t}\n\t\telse if(invoiceStatus == &quot;Approved&quot; || invoiceStatus == &quot;Sent&quot; || invoiceStatus == &quot;Partially Paid&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\tstatusIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\telse if(invoiceStatus == &quot;Submitted for Review&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\tstatusIcon = &quot;ui-1-check&quot;;\n\t\t}\n\t\tbalanceMetricClass = &quot;balance&quot;;\n\t\tif(balanceDue &lt;= 0)\n\t\t{\n\t\t\tbalanceMetricClass = &quot;balance-paid&quot;;\n\t\t}\n%&gt;\n\t\t&lt;div class=&quot;bd-header&quot;&gt;\n\t\t\t&lt;div class=&quot;bd-title-block&quot;&gt;\n\t\t\t\t&lt;p class=&quot;bd-kicker&quot;&gt;Billing Detail&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&quot;bd-title&quot;&gt;Invoice &lt;%=ifnull(invoiceRec.Invoice_Number,invoiceRec.ID)%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;bd-subtitle&quot;&gt;&lt;%=clientName%&gt; · &lt;%=caseTitle%&gt; · Due &lt;%=ifnull(invoiceRec.Due_Date,&quot;Not set&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;bd-badge-row&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%=statusIcon%&gt;&quot;&gt;&lt;/i&gt; &lt;%=invoiceStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Balance $&lt;%=balanceDue%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Total $&lt;%=totalAmount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;bd-action-row&quot;&gt;\n&lt;%\n\t\tif(invoiceStatus == &quot;Draft&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Invoice_Action?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;Action_Type=Submit%20for%20Review&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Submit for Review&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(invoiceStatus == &quot;Submitted for Review&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Invoice_Action?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;Action_Type=Approve%20Invoice&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Approve&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(invoiceStatus == &quot;Approved&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Invoice_Action?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;Action_Type=Send%20Invoice&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-share-66&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Send&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(invoiceStatus == &quot;Sent&quot; || invoiceStatus == &quot;Partially Paid&quot; || invoiceStatus == &quot;Overdue&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Payment?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Payment&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(balanceDue &lt;= 0 &amp;&amp; invoiceStatus != &quot;Paid&quot; &amp;&amp; invoiceStatus != &quot;Cancelled&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Invoice_Action?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;Action_Type=Mark%20Paid&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Mark Paid&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(invoiceStatus == &quot;Draft&quot; || invoiceStatus == &quot;Submitted for Review&quot; || invoiceStatus == &quot;Approved&quot; || invoiceStatus == &quot;Sent&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Invoice_Action?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;Action_Type=Cancel%20Invoice&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Cancel&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(invoiceStatus == &quot;Cancelled&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Invoice_Action?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;Action_Type=Reopen%20Invoice&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Reopen&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;bd-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;bd-card bd-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Invoice Header&lt;/h2&gt;&lt;p&gt;Client, matter, dates, terms, and billing ownership&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;bd-kv&quot;&gt;&lt;label&gt;Client&lt;/label&gt;&lt;strong&gt;&lt;%=clientName%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=clientStatus%&gt;&lt;/small&gt;&lt;small&gt;&lt;%=clientEmail%&gt; &lt;%=clientPhone%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;bd-kv&quot;&gt;&lt;label&gt;Case&lt;/label&gt;&lt;strong&gt;&lt;a href=&quot;#Page:Case_Detail?Case_ID=&lt;%=invoiceRec.Case%&gt;&quot; class=&quot;bd-main&quot;&gt;&lt;%=caseTitle%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;small&gt;Case &lt;%=caseNumber%&gt; · &lt;%=caseStatus%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;bd-kv&quot;&gt;&lt;label&gt;Billing Period&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(invoiceRec.Billing_Period_Start,&quot;Not set&quot;)%&gt; to &lt;%=ifnull(invoiceRec.Billing_Period_End,&quot;Not set&quot;)%&gt;&lt;/strong&gt;&lt;small&gt;Invoice date: &lt;%=ifnull(invoiceRec.Invoice_Date,&quot;Not set&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;bd-kv&quot;&gt;&lt;label&gt;Due and Terms&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(invoiceRec.Due_Date,&quot;Not set&quot;)%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=ifnull(invoiceRec.Payment_Terms,&quot;No payment terms recorded&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;bd-kv&quot;&gt;&lt;label&gt;Prepared By&lt;/label&gt;&lt;strong&gt;&lt;%=preparedBy%&gt;&lt;/strong&gt;&lt;small&gt;Billing attorney: &lt;%=billingAttorney%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;bd-kv&quot;&gt;&lt;label&gt;Approved By / Sent&lt;/label&gt;&lt;strong&gt;&lt;%=approvedBy%&gt;&lt;/strong&gt;&lt;small&gt;Sent on: &lt;%=ifnull(invoiceRec.Sent_On,&quot;Not sent&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;bd-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Notes&lt;/h2&gt;&lt;p&gt;Invoice remarks&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-body bd-kv-grid single&quot;&gt;&lt;div class=&quot;bd-kv&quot;&gt;&lt;label&gt;Notes&lt;/label&gt;&lt;span&gt;&lt;%=ifnull(invoiceRec.Notes,&quot;No invoice notes have been recorded.&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;bd-card bd-full&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Totals and Balance&lt;/h2&gt;&lt;p&gt;Amounts are calculated from invoice items and payment workflows&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-body bd-metrics&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-metric&quot;&gt;&lt;label&gt;Subtotal&lt;/label&gt;&lt;strong&gt;$&lt;%=subtotal%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-metric&quot;&gt;&lt;label&gt;Tax&lt;/label&gt;&lt;strong&gt;$&lt;%=taxAmount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-metric&quot;&gt;&lt;label&gt;Discount&lt;/label&gt;&lt;strong&gt;$&lt;%=discountAmount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-metric&quot;&gt;&lt;label&gt;Total Amount&lt;/label&gt;&lt;strong&gt;$&lt;%=totalAmount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-metric&quot;&gt;&lt;label&gt;Amount Paid&lt;/label&gt;&lt;strong&gt;$&lt;%=amountPaid%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-metric &lt;%=balanceMetricClass%&gt;&quot;&gt;&lt;label&gt;Balance Due&lt;/label&gt;&lt;strong&gt;$&lt;%=balanceDue%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;bd-related-grid&quot;&gt;\n&lt;%\n\t\titemRows = Add_Invoice_Item[Invoice == invoiceRec.ID] sort by Source_Type asc range from 1 to 50;\n%&gt;\n\t\t\t&lt;div class=&quot;bd-related bd-related-full&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Line Items&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Invoice_Item[Invoice == invoiceRec.ID].count()%&gt; invoice items · calculated line total $&lt;%=lineTotal%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-scroll&quot;&gt;\n&lt;%\n\t\tif(itemRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No invoice line items&lt;/h5&gt;&lt;p class=&quot;bd-empty-text&quot;&gt;Add time, expenses, fixed fees, or adjustment lines before sending this invoice.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full bd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Source&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Description&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Quantity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Rate&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each item in itemRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(item.Source_Type,&quot;-&quot;)%&gt;&lt;div class=&quot;bd-sub&quot;&gt;Taxable: &lt;%=if(item.Taxable == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;bd-main&quot;&gt;&lt;%=ifnull(item.Description,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=ifnull(item.Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(item.Rate,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(item.Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;bd-status-pill bd-status-primary&quot;&gt;&lt;%=ifnull(item.Line_Status,&quot;Draft&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;bd-mobile-list&quot;&gt;\n&lt;%\n\t\t\tfor each item in itemRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-mobile-card&quot;&gt;&lt;p class=&quot;bd-mobile-card-title&quot;&gt;&lt;%=ifnull(item.Description,&quot;-&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(item.Source_Type,&quot;-&quot;)%&gt; · &lt;%=ifnull(item.Line_Status,&quot;Draft&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;Qty &lt;%=ifnull(item.Quantity,0)%&gt; at $&lt;%=ifnull(item.Rate,0)%&gt;&lt;/p&gt;&lt;div class=&quot;bd-mobile-card-meta&quot;&gt;&lt;span class=&quot;bd-status-pill bd-status-primary&quot;&gt;$&lt;%=ifnull(item.Amount,0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tpaymentRows = Add_Payment[Invoice == invoiceRec.ID] sort by Payment_Date desc range from 1 to 50;\n%&gt;\n\t\t\t&lt;div class=&quot;bd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Payments&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Payment[Invoice == invoiceRec.ID].count()%&gt; payment records · received/reconciled total $&lt;%=paymentTotal%&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;bd-section-actions&quot;&gt;&lt;% if(invoiceStatus == &quot;Sent&quot; || invoiceStatus == &quot;Partially Paid&quot; || invoiceStatus == &quot;Overdue&quot;) { %&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Payment?Invoice=&lt;%=invoiceRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Payment&lt;/span&gt;&lt;/a&gt;&lt;% } %&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-scroll&quot;&gt;\n&lt;%\n\t\tif(paymentRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No payments recorded&lt;/h5&gt;&lt;p class=&quot;bd-empty-text&quot;&gt;Payments are available only after invoices are sent, partially paid, or overdue.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full bd-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Mode&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Reference&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each pay in paymentRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(pay.Payment_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(pay.Payment_Mode,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(pay.Reference_Number,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(pay.Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;bd-status-pill bd-status-success&quot;&gt;&lt;%=ifnull(pay.Payment_Status,&quot;Received&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;bd-mobile-list&quot;&gt;\n&lt;%\n\t\t\tfor each pay in paymentRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-mobile-card&quot;&gt;&lt;p class=&quot;bd-mobile-card-title&quot;&gt;$&lt;%=ifnull(pay.Amount,0)%&gt; · &lt;%=ifnull(pay.Payment_Status,&quot;Received&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(pay.Payment_Date,&quot;-&quot;)%&gt; · &lt;%=ifnull(pay.Payment_Mode,&quot;-&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;Reference: &lt;%=ifnull(pay.Reference_Number,&quot;-&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\ttimeRows = Add_Time_Entry[Invoice == invoiceRec.ID] sort by Entry_Date desc range from 1 to 50;\n%&gt;\n\t\t\t&lt;div class=&quot;bd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Related Time&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Time_Entry[Invoice == invoiceRec.ID].count()%&gt; time entries attached to this invoice&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-scroll&quot;&gt;\n&lt;%\n\t\tif(timeRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No related time entries&lt;/h5&gt;&lt;p class=&quot;bd-empty-text&quot;&gt;Time entries linked through invoice items or billing workflows will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full bd-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Entry&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Employee&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Hours&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Approval&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each t in timeRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;bd-main&quot;&gt;&lt;%=ifnull(t.Activity_Type,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;bd-sub&quot;&gt;&lt;%=ifnull(t.Entry_Date,&quot;-&quot;)%&gt; · ID &lt;%=ifnull(t.Time_Entry_ID,t.ID)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(t.Employee.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=ifnull(t.Hours,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(t.Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;bd-status-pill bd-status-info&quot;&gt;&lt;%=ifnull(t.Approval_Status,&quot;Draft&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;bd-mobile-list&quot;&gt;\n&lt;%\n\t\t\tfor each t in timeRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-mobile-card&quot;&gt;&lt;p class=&quot;bd-mobile-card-title&quot;&gt;&lt;%=ifnull(t.Activity_Type,&quot;-&quot;)%&gt; · $&lt;%=ifnull(t.Amount,0)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(t.Entry_Date,&quot;-&quot;)%&gt; · &lt;%=ifnull(t.Hours,0)%&gt; hours&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(t.Employee.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt; · &lt;%=ifnull(t.Approval_Status,&quot;Draft&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\texpenseRows = Add_Expense_Entry[Invoice == invoiceRec.ID] sort by Expense_Date desc range from 1 to 50;\n%&gt;\n\t\t\t&lt;div class=&quot;bd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Related Expenses&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Expense_Entry[Invoice == invoiceRec.ID].count()%&gt; expense entries attached to this invoice&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-scroll&quot;&gt;\n&lt;%\n\t\tif(expenseRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No related expenses&lt;/h5&gt;&lt;p class=&quot;bd-empty-text&quot;&gt;Expense entries linked through invoice items or billing workflows will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full bd-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Expense&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Employee&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Approval&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each ex in expenseRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;bd-main&quot;&gt;&lt;%=ifnull(ex.Expense_Category,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;bd-sub&quot;&gt;&lt;%=ifnull(ex.Expense_Date,&quot;-&quot;)%&gt; · &lt;%=ifnull(ex.Vendor,&quot;No vendor&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(ex.Employee.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;$&lt;%=ifnull(ex.Amount,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;bd-status-pill bd-status-info&quot;&gt;&lt;%=ifnull(ex.Approval_Status,&quot;Draft&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;bd-mobile-list&quot;&gt;\n&lt;%\n\t\t\tfor each ex in expenseRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-mobile-card&quot;&gt;&lt;p class=&quot;bd-mobile-card-title&quot;&gt;&lt;%=ifnull(ex.Expense_Category,&quot;-&quot;)%&gt; · $&lt;%=ifnull(ex.Amount,0)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(ex.Expense_Date,&quot;-&quot;)%&gt; · &lt;%=ifnull(ex.Vendor,&quot;No vendor&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(ex.Employee.Employee_Name.first_name,&quot;Unassigned&quot;)%&gt; · &lt;%=ifnull(ex.Approval_Status,&quot;Draft&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\thistoryRows = Add_Case_History[Case == invoiceRec.Case &amp;&amp; (Event_Type == &quot;Invoice Updated&quot; || Event_Type == &quot;Payment Received&quot;)] sort by Event_Date desc range from 1 to 50;\n%&gt;\n\t\t\t&lt;div class=&quot;bd-related bd-related-full&quot;&gt;\n\t\t\t\t&lt;div class=&quot;bd-card-header&quot;&gt;&lt;div class=&quot;bd-card-title&quot;&gt;&lt;h2&gt;Invoice and Payment History&lt;/h2&gt;&lt;p&gt;Case history events for invoice updates and payment receipts&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;bd-history-scroll&quot;&gt;\n&lt;%\n\t\tif(historyRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No billing history yet&lt;/h5&gt;&lt;p class=&quot;bd-empty-text&quot;&gt;Invoice and payment workflows will write audit history as actions are submitted.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full bd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Event&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status Change&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Summary&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Changed By&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each hist in historyRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Event_Date,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;bd-status-pill bd-status-primary&quot;&gt;&lt;%=ifnull(hist.Event_Type,&quot;System&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Previous_Status,&quot;-&quot;)%&gt; to &lt;%=ifnull(hist.New_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Summary,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(hist.Changed_By.Employee_Name.first_name,&quot;System&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;bd-mobile-list&quot;&gt;\n&lt;%\n\t\t\tfor each hist in historyRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;bd-mobile-card&quot;&gt;&lt;p class=&quot;bd-mobile-card-title&quot;&gt;&lt;%=ifnull(hist.Event_Type,&quot;System&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(hist.Event_Date,&quot;-&quot;)%&gt; · &lt;%=ifnull(hist.Previous_Status,&quot;-&quot;)%&gt; to &lt;%=ifnull(hist.New_Status,&quot;-&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;bd-mobile-card-line&quot;&gt;&lt;%=ifnull(hist.Summary,&quot;-&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Billing_Workspace
		{
					displayname = "Billing Workspace"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Billing_Workspace_Main' elementName='Billing_Workspace_Main'>\n\t\t\t\t\t<![CDATA[htmlpage Billing_Workspace_Main()\n\t\t\t\t\t\tcontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\ndraftCount = Create_Invoice[Invoice_Status == &quot;Draft&quot;].count();\nsubmittedReviewCount = Create_Invoice[Invoice_Status == &quot;Submitted for Review&quot;].count();\napprovedCount = Create_Invoice[Invoice_Status == &quot;Approved&quot;].count();\nsentCount = Create_Invoice[Invoice_Status == &quot;Sent&quot;].count();\noverdueCount = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)].count();\npaidCount = Create_Invoice[Invoice_Status == &quot;Paid&quot;].count();\ncancelledCount = Create_Invoice[Invoice_Status == &quot;Cancelled&quot;].count();\nallInvoiceCount = Create_Invoice.count();\noutstandingBalance = Create_Invoice[Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;].sum(Balance_Due);\nif(outstandingBalance == null)\n{\n\t\toutstandingBalance = 0;\n}\noverdueBalance = Create_Invoice[Invoice_Status == &quot;Overdue&quot; || (Due_Date &lt; zoho.currentdate &amp;&amp; Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Paid&quot; &amp;&amp; Invoice_Status != &quot;Cancelled&quot;)].sum(Balance_Due);\nif(overdueBalance == null)\n{\n\t\toverdueBalance = 0;\n}\nreviewQueueCount = submittedReviewCount + approvedCount;\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility subset included once for this page ===== */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);\n\t\t--zcs_brand_color: #6147E5;\n\t\t--zcs_brand_foreground_color: #FFFFFF;\n\t\t--zcs_brand_dark_color: #4E38C8;\n\t\t--zcs_brand_light_color: #F1EEFF;\n\t\t--zcs_primary_text_color: #17142F;\n\t\t--zcs_secondary_text_color: #4F5873;\n\t\t--zcs_tertiary_text_color: #7A8094;\n\t\t--zcs_tertiary_border_color: #E7E8F0;\n\t\t--zcs_primary_border_color: #E0E2EA;\n\t\t--zcs_component_hover_color: #F4F1FF;\n\t\t--zcs_light_grey_color: #F7F8FC;\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-page-bg-color: #F6F7FB;\n\t\t--bw-primary: #6147E5;\n\t\t--bw-primary-dark: #4E38C8;\n\t\t--bw-primary-light: #F1EEFF;\n\t\t--bw-bg: #F6F7FB;\n\t\t--bw-surface: #FFFFFF;\n\t\t--bw-border: #E7E8F0;\n\t\t--bw-text: #17142F;\n\t\t--bw-muted: #667085;\n\t\t--bw-success: #179E6C;\n\t\t--bw-warning: #B8770D;\n\t\t--bw-danger: #D92D20;\n\t\t--bw-info: #2A6FFC;\n\t\t--bw-gap: 15px;\n\t\t--bw-radius: 12px;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-p-0{padding:0}.zcs-p-10{padding:10px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-px-6{padding-left:6px;padding-right:6px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-py-0{padding-top:0;padding-bottom:0}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n\n/* ===== ZCS component CSS: button-primary-button and button-secondary-button ===== */\n.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0;transition:background .15s ease,border-color .15s ease,color .15s ease}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-secondary-button:hover,.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus,.zcs-secondary-button.zcs-button:active,.zcs-secondary-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-button-text{white-space:nowrap}\n\n/* ===== ZCS component CSS: horizontal-tab-horizontal-tab-with-count ===== */\n.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style-type:none;border-bottom:2px solid transparent;letter-spacing:.1px;flex:0 0 auto}.zcs-horizontal-tablink{cursor:pointer;min-height:46px}.zcs-horizontal-tabtext{text-wrap:nowrap}.zcs-horizontal-tabcount{min-width:22px;background-color:var(--zcs-page-bg-color);border:1px solid transparent}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabitem:hover .zcs-horizontal-tabcount{background-color:var(--zcs_component_hover_color)}.zcs-horizontal-tabbody{overflow:auto}\n\n/* ===== ZCS component CSS: header-heading-with-actions adapted for this page ===== */\n.zcs-page-header{background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%);border:1px solid var(--bw-border);border-radius:var(--bw-radius);box-shadow:0 2px 8px 0 rgba(23,20,47,.04)}\n\n/* ===== Billing Workspace approved CSS block ===== */\n*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.billing-workspace-page{width:100%;min-height:100%;background:var(--bw-bg);color:var(--bw-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--bw-gap);overflow:auto}.billing-workspace-stack{display:flex;flex-direction:column;gap:var(--bw-gap);max-width:1600px;margin:0 auto}.billing-header-copy{min-width:0;display:flex;flex-direction:column;gap:6px}.billing-header-title-row{display:flex;align-items:center;gap:10px;min-width:0}.billing-header-icon{width:36px;height:36px;border-radius:10px;background:var(--bw-primary-light);color:var(--bw-primary);display:inline-flex;align-items:center;justify-content:center;font-size:18px}.billing-header-kicker{margin:0;color:var(--bw-muted);max-width:860px}.billing-header-meta{display:flex;gap:8px;flex-wrap:wrap}.billing-meta-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(97,71,229,.16);background:#FFFFFF;color:var(--bw-muted);border-radius:999px;padding:5px 10px;font-size:12px}.billing-meta-pill i{color:var(--bw-primary);font-size:14px}.billing-header-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.billing-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(180px,1fr));gap:var(--bw-gap)}.billing-kpi-card{background:#fff;border:1px solid var(--bw-border);border-radius:var(--bw-radius);padding:15px;min-height:96px;display:flex;gap:12px;align-items:flex-start}.billing-kpi-icon{width:38px;height:38px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.billing-kpi-icon.violet{background:var(--bw-primary-light);color:var(--bw-primary)}.billing-kpi-icon.blue{background:#E8EFFF;color:var(--bw-info)}.billing-kpi-icon.red{background:#FDE3E6;color:var(--bw-danger)}.billing-kpi-icon.green{background:#E4FCF3;color:var(--bw-success)}.billing-kpi-copy{min-width:0}.billing-kpi-label{margin:0;color:var(--bw-muted);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}.billing-kpi-value{margin:6px 0 0;color:var(--bw-text);font-size:23px;font-weight:700;line-height:1.1;word-break:break-word}.billing-kpi-note{margin:5px 0 0;color:var(--bw-muted);font-size:12px}.billing-tab-radio{position:absolute;opacity:0;pointer-events:none}.billing-tabs-shell{background:#fff;border:1px solid var(--bw-border);border-radius:var(--bw-radius);overflow:hidden}.billing-tab-panels{padding:15px;background:#fff}.billing-tab-panel{display:none}.billing-tab-context{display:flex;justify-content:space-between;align-items:center;gap:15px;border:1px solid var(--bw-border);border-radius:10px;background:#FCFCFF;padding:12px 15px;margin-bottom:12px}.billing-tab-title{display:flex;align-items:center;gap:8px;min-width:0;color:var(--bw-text);font-weight:700}.billing-tab-title i{color:var(--bw-primary);font-size:16px}.billing-tab-hint{color:var(--bw-muted);font-size:12px}.billing-report-frame{min-height:650px;width:100%;border:1px solid var(--bw-border);border-radius:10px;overflow:auto;background:#FFFFFF}.billing-detail-note{display:inline-flex;align-items:center;gap:6px;color:var(--bw-muted);font-size:12px}.billing-detail-note i{color:var(--bw-primary)}\n\n#bw-tab-draft:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-draft&apos;],#bw-tab-review:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-review&apos;],#bw-tab-approved:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-approved&apos;],#bw-tab-sent:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-sent&apos;],#bw-tab-overdue:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-overdue&apos;],#bw-tab-paid:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-paid&apos;],#bw-tab-all:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-all&apos;]{color:var(--bw-primary)}\n#bw-tab-draft:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-draft&apos;] .zcs-horizontal-tabcount,#bw-tab-review:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-review&apos;] .zcs-horizontal-tabcount,#bw-tab-approved:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-approved&apos;] .zcs-horizontal-tabcount,#bw-tab-sent:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-sent&apos;] .zcs-horizontal-tabcount,#bw-tab-overdue:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-overdue&apos;] .zcs-horizontal-tabcount,#bw-tab-paid:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-paid&apos;] .zcs-horizontal-tabcount,#bw-tab-all:checked ~ .billing-tabs-shell label[for=&apos;bw-tab-all&apos;] .zcs-horizontal-tabcount{background:var(--bw-primary-light);color:var(--bw-primary);border-color:rgba(97,71,229,.18)}\n#bw-tab-draft:checked ~ .billing-tabs-shell .tabitem-draft,#bw-tab-review:checked ~ .billing-tabs-shell .tabitem-review,#bw-tab-approved:checked ~ .billing-tabs-shell .tabitem-approved,#bw-tab-sent:checked ~ .billing-tabs-shell .tabitem-sent,#bw-tab-overdue:checked ~ .billing-tabs-shell .tabitem-overdue,#bw-tab-paid:checked ~ .billing-tabs-shell .tabitem-paid,#bw-tab-all:checked ~ .billing-tabs-shell .tabitem-all{border-bottom-color:var(--bw-primary)}\n#bw-tab-draft:checked ~ .billing-tabs-shell #panel-draft,#bw-tab-review:checked ~ .billing-tabs-shell #panel-review,#bw-tab-approved:checked ~ .billing-tabs-shell #panel-approved,#bw-tab-sent:checked ~ .billing-tabs-shell #panel-sent,#bw-tab-overdue:checked ~ .billing-tabs-shell #panel-overdue,#bw-tab-paid:checked ~ .billing-tabs-shell #panel-paid,#bw-tab-all:checked ~ .billing-tabs-shell #panel-all{display:block}\n@media (max-width:1100px){.billing-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.zcs-page-header{align-items:flex-start;flex-direction:column}.billing-header-actions{justify-content:flex-start}}\n@media (max-width:768px){.billing-workspace-page{padding:10px}.zcs-page-header{padding:14px 16px}.billing-tab-panels{padding:10px}.billing-tab-context{align-items:flex-start;flex-direction:column}.billing-report-frame{min-height:560px}}\n@media (max-width:576px){.billing-kpi-grid{grid-template-columns:1fr}.billing-header-actions,.billing-header-actions .zcs-button{width:100%}.zcs-horizontal-tablink{padding-left:8px;padding-right:8px}.billing-meta-pill{width:100%;justify-content:flex-start}}\n&lt;/style&gt;\n\n&lt;div class=&apos;billing-workspace-page&apos;&gt;\n\t\t&lt;div class=&apos;billing-workspace-stack&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-15 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;billing-header-copy&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-header-title-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-header-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Billing Workspace&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;billing-header-kicker&apos;&gt;Manage invoice queues with status tabs, live counts, and embedded filtered reports. Actions are section-level only; no custom report buttons are added.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-header-meta&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-meta-pill&apos;&gt;&lt;i class=&apos;zc-li-outline files-paper&apos;&gt;&lt;/i&gt; Total invoices: &lt;%=allInvoiceCount%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-meta-pill&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; Review and approval queue: &lt;%=reviewQueueCount%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-meta-pill&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Overdue: &lt;%=overdueCount%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;billing-header-actions&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Create_Invoice?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Create Invoice&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Add_Payment?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-money-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Add Payment&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Add_Time_Entry?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Add Time Entry&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Add_Expense_Entry?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-paper&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Add Expense Entry&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;billing-kpi-grid&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-kpi-icon violet&apos;&gt;&lt;i class=&apos;zc-li-outline files-paper&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-copy&apos;&gt;&lt;p class=&apos;billing-kpi-label&apos;&gt;Draft invoices&lt;/p&gt;&lt;p class=&apos;billing-kpi-value&apos;&gt;&lt;%=draftCount%&gt;&lt;/p&gt;&lt;p class=&apos;billing-kpi-note&apos;&gt;Ready for preparation before review.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-kpi-icon blue&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-copy&apos;&gt;&lt;p class=&apos;billing-kpi-label&apos;&gt;Review queue&lt;/p&gt;&lt;p class=&apos;billing-kpi-value&apos;&gt;&lt;%=reviewQueueCount%&gt;&lt;/p&gt;&lt;p class=&apos;billing-kpi-note&apos;&gt;Submitted and approved invoices.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-kpi-icon red&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-copy&apos;&gt;&lt;p class=&apos;billing-kpi-label&apos;&gt;Overdue balance&lt;/p&gt;&lt;p class=&apos;billing-kpi-value&apos;&gt;&lt;%=overdueBalance%&gt;&lt;/p&gt;&lt;p class=&apos;billing-kpi-note&apos;&gt;Invoices past due or marked overdue.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;billing-kpi-icon green&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-kpi-copy&apos;&gt;&lt;p class=&apos;billing-kpi-label&apos;&gt;Outstanding balance&lt;/p&gt;&lt;p class=&apos;billing-kpi-value&apos;&gt;&lt;%=outstandingBalance%&gt;&lt;/p&gt;&lt;p class=&apos;billing-kpi-note&apos;&gt;Open invoice balance excluding paid/cancelled.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;input class=&apos;billing-tab-radio&apos; type=&apos;radio&apos; name=&apos;billing_workspace_status&apos; id=&apos;bw-tab-draft&apos; checked=&apos;checked&apos;&gt;\n\t\t\t\t&lt;input class=&apos;billing-tab-radio&apos; type=&apos;radio&apos; name=&apos;billing_workspace_status&apos; id=&apos;bw-tab-review&apos;&gt;\n\t\t\t\t&lt;input class=&apos;billing-tab-radio&apos; type=&apos;radio&apos; name=&apos;billing_workspace_status&apos; id=&apos;bw-tab-approved&apos;&gt;\n\t\t\t\t&lt;input class=&apos;billing-tab-radio&apos; type=&apos;radio&apos; name=&apos;billing_workspace_status&apos; id=&apos;bw-tab-sent&apos;&gt;\n\t\t\t\t&lt;input class=&apos;billing-tab-radio&apos; type=&apos;radio&apos; name=&apos;billing_workspace_status&apos; id=&apos;bw-tab-overdue&apos;&gt;\n\t\t\t\t&lt;input class=&apos;billing-tab-radio&apos; type=&apos;radio&apos; name=&apos;billing_workspace_status&apos; id=&apos;bw-tab-paid&apos;&gt;\n\t\t\t\t&lt;input class=&apos;billing-tab-radio&apos; type=&apos;radio&apos; name=&apos;billing_workspace_status&apos; id=&apos;bw-tab-all&apos;&gt;\n\n\t\t\t\t&lt;div class=&apos;zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full billing-tabs-shell&apos;&gt;\n\t\t\t\t\t\t&lt;ul class=&apos;zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border&apos; role=&apos;tablist&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tabitem-draft&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; for=&apos;bw-tab-draft&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Draft&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=draftCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tabitem-review&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; for=&apos;bw-tab-review&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Submitted for Review&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=submittedReviewCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tabitem-approved&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; for=&apos;bw-tab-approved&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Approved&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=approvedCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tabitem-sent&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; for=&apos;bw-tab-sent&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Sent&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=sentCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tabitem-overdue&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; for=&apos;bw-tab-overdue&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Overdue&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=overdueCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tabitem-paid&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; for=&apos;bw-tab-paid&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Paid&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=paidCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem tabitem-all&apos;&gt;&lt;label class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; for=&apos;bw-tab-all&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Cancelled/All&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=cancelledCount%&gt;/&lt;%=allInvoiceCount%&gt;&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n\n\t\t\t\t\t\t&lt;div class=&apos;zcs-horizontal-tabbody zcs-col-common billing-tab-panels&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;billing-tab-panel&apos; id=&apos;panel-draft&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-tab-context&apos;&gt;&lt;div class=&apos;billing-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline files-paper&apos;&gt;&lt;/i&gt;&lt;span&gt;Draft invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;billing-tab-hint&apos;&gt;Prepare invoices for submission without report-level add buttons.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Draft_Invoices&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;billing-tab-panel&apos; id=&apos;panel-review&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-tab-context&apos;&gt;&lt;div class=&apos;billing-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Submitted for Review invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;billing-tab-hint&apos;&gt;Review submitted invoices. Lifecycle actions are handled from billing detail pages where configured.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Invoices_For_Approval&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;billing-tab-panel&apos; id=&apos;panel-approved&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-tab-context&apos;&gt;&lt;div class=&apos;billing-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-bold&apos;&gt;&lt;/i&gt;&lt;span&gt;Approved invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;billing-tab-hint&apos;&gt;Approved invoices are shown through All Invoices with an approved-status embed criterion until a dedicated report is added.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;all_invoices&apos; zc-criteria=&apos;Invoice_Status == &quot;Approved&quot;&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;billing-tab-panel&apos; id=&apos;panel-sent&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-tab-context&apos;&gt;&lt;div class=&apos;billing-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Sent invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;billing-tab-hint&apos;&gt;Track invoices sent to clients and add payments from the section action above.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Sent_Invoices&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;billing-tab-panel&apos; id=&apos;panel-overdue&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-tab-context&apos;&gt;&lt;div class=&apos;billing-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Overdue invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;billing-tab-hint&apos;&gt;Invoices marked overdue or past due with an open balance.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Overdue_Invoices&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;billing-tab-panel&apos; id=&apos;panel-paid&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-tab-context&apos;&gt;&lt;div class=&apos;billing-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Paid invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;billing-tab-hint&apos;&gt;Completed billing records retained for reconciliation and audit review.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Paid_Invoices&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&apos;billing-tab-panel&apos; id=&apos;panel-all&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-tab-context&apos;&gt;&lt;div class=&apos;billing-tab-title&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-14&apos;&gt;&lt;/i&gt;&lt;span&gt;Cancelled and all invoices&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;billing-tab-hint&apos;&gt;&lt;span class=&apos;billing-detail-note&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-link-69&apos;&gt;&lt;/i&gt;Open records through report-native detail links and Billing Detail links where available.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;billing-report-frame&apos; zc-component=&apos;report&apos; zc-linkname=&apos;all_invoices&apos; zc_Header=&apos;false&apos; zc_Search=&apos;false&apos; zc_AddRec=&apos;false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Case_Detail(int Case_ID)
		{
					displayname = "Case Detail"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Case_Detail_Main' elementName='Case_Detail_Main' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage Case_Detail_Main()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tcaseRows = Create_Case[ID == input.Case_ID];\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility subset included once for this page ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);\n\t--zcs_brand_color: #6147E5;\n\t--zcs_brand_foreground_color: #FFFFFF;\n\t--zcs_brand_dark_color: #4E38C8;\n\t--zcs_brand_light_color: #F1EEFF;\n\t--zcs_primary_text_color: #17142F;\n\t--zcs_secondary_text_color: #4F5873;\n\t--zcs_tertiary_text_color: #7A8094;\n\t--zcs_tertiary_border_color: #E7E8F0;\n\t--zcs_primary_border_color: #E0E2EA;\n\t--zcs_component_hover_color: #F4F1FF;\n\t--zcs_light_grey_color: #F7F8FC;\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-page-bg-color: #F6F7FB;\n\t--cd-primary: #6147E5;\n\t--cd-primary-dark: #4E38C8;\n\t--cd-bg: #F6F7FB;\n\t--cd-surface: #FFFFFF;\n\t--cd-border: #E7E8F0;\n\t--cd-text: #17142F;\n\t--cd-muted: #6B7280;\n\t--cd-soft: #F1EEFF;\n\t--cd-success: #179E6C;\n\t--cd-warning: #B8770D;\n\t--cd-danger: #D92D20;\n\t--cd-info: #2A6FFC;\n\t--cd-gap: 15px;\n\t--cd-radius: 12px;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}\n/* ===== ZCS component CSS: button-primary-button ===== */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-secondary-button:hover{background-color:#ECEEF7}.zcs-button-icon{width:16px;max-height:16px}.zcs-button-text{white-space:nowrap}\n/* ===== ZCS component CSS: badge-filled-badge ===== */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n/* ===== ZCS component CSS: table-simple-table ===== */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#FE455D}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-l_blue{color:#1094C5}\n/* ===== Case Detail approved CSS block ===== */\n*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}.case-detail{width:100%;min-height:100%;background:var(--cd-bg);color:var(--cd-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--cd-gap);overflow:auto}.cd-shell{display:flex;flex-direction:column;gap:var(--cd-gap);max-width:1680px;margin:0 auto}.cd-header{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--cd-gap);padding:15px;border:1px solid var(--cd-border);border-radius:var(--cd-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.cd-title-block{min-width:0;flex:1}.cd-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--cd-primary);margin:0 0 4px}.cd-title{font-size:24px;line-height:1.2;font-weight:700;color:var(--cd-text);margin:0}.cd-subtitle{margin:6px 0 0;color:var(--cd-muted)}.cd-action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end;max-width:720px}.cd-action-row .zcs-button,.cd-section-actions .zcs-button{border-radius:8px}.cd-badge-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.cd-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--cd-gap);align-items:start}.cd-card{grid-column:span 4;background:var(--cd-surface);border:1px solid var(--cd-border);border-radius:var(--cd-radius);overflow:hidden;min-height:100%;display:flex;flex-direction:column}.cd-card.cd-wide{grid-column:span 8}.cd-card.cd-full{grid-column:span 12}.cd-card-header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px;border-bottom:1px solid var(--cd-border);background:#fff}.cd-card-title{display:flex;flex-direction:column;gap:2px;min-width:0}.cd-card-title h2{font-size:16px;line-height:1.25;font-weight:700;color:var(--cd-text);margin:0}.cd-card-title p{font-size:12px;color:var(--cd-muted);margin:0}.cd-card-body{padding:15px}.cd-section-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.cd-kv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.cd-kv-grid.single{grid-template-columns:1fr}.cd-kv{border:1px solid var(--cd-border);border-radius:10px;padding:12px;background:#FCFCFF;min-width:0}.cd-kv label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--cd-muted);margin-bottom:5px}.cd-kv strong,.cd-kv span{display:block;color:var(--cd-text);word-break:break-word}.cd-kv small{display:block;color:var(--cd-muted);font-size:12px;margin-top:4px;word-break:break-word}.cd-narrative{white-space:pre-wrap;color:var(--cd-text);margin:0}.cd-muted{color:var(--cd-muted)}.cd-process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--cd-gap)}.cd-finance-grid{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:var(--cd-gap)}.cd-finance-card{border:1px solid var(--cd-border);border-radius:var(--cd-radius);padding:15px;background:#fff}.cd-finance-card label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--cd-muted);margin-bottom:6px}.cd-finance-card strong{display:block;font-size:20px;line-height:1.2;color:var(--cd-text);word-break:break-word}.cd-related-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--cd-gap)}.cd-related{grid-column:span 6;background:var(--cd-surface);border:1px solid var(--cd-border);border-radius:var(--cd-radius);overflow:hidden;display:flex;flex-direction:column;min-height:330px}.cd-related.cd-related-full{grid-column:span 12}.cd-scroll{height:245px;overflow:auto;padding:15px}.cd-history-scroll{height:360px;overflow:auto;padding:15px}.cd-table{min-width:640px}.cd-table.compact{min-width:520px}.cd-table .cd-main{font-weight:600;color:var(--cd-text)}.cd-table .cd-sub{font-size:12px;color:var(--cd-muted);margin-top:2px}.cd-status-pill{font-size:12px;font-weight:600;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:200px}.cd-status-primary{background:#F1EEFF;color:var(--cd-primary)}.cd-status-success{background:#E4FCF3;color:var(--cd-success)}.cd-status-warning{background:#FCF4E6;color:var(--cd-warning)}.cd-status-danger{background:#FDE3E6;color:var(--cd-danger)}.cd-status-info{background:#E8EFFF;color:var(--cd-info)}.zcs-nodata-wrapper{min-height:150px;border:1px dashed var(--cd-border);border-radius:var(--cd-radius);background:#FCFCFF}.zcs-nodata-header{font-size:15px}.cd-empty-text{color:var(--cd-muted);margin:6px 0 0}.cd-alert{display:flex;gap:10px;align-items:flex-start;border:1px solid #F7C7CB;background:#FFF5F6;color:#9E1C2B;border-radius:var(--cd-radius);padding:15px}.cd-alert i{font-size:18px;line-height:1.2}.cd-mobile-list{display:none}.cd-mobile-card{border:1px solid var(--cd-border);border-radius:var(--cd-radius);padding:12px;background:#fff;margin-bottom:10px}.cd-mobile-card:last-child{margin-bottom:0}.cd-mobile-card-title{font-weight:700;margin:0 0 4px;color:var(--cd-text)}.cd-mobile-card-line{font-size:12px;color:var(--cd-muted);margin:2px 0}.cd-mobile-card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1280px){.cd-card,.cd-card.cd-wide{grid-column:span 6}.cd-process-grid{grid-template-columns:1fr}.cd-finance-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.cd-related{grid-column:span 12}}@media (max-width:860px){.case-detail{padding:15px}.cd-header{flex-direction:column}.cd-action-row,.cd-section-actions{justify-content:flex-start;max-width:none}.cd-card,.cd-card.cd-wide,.cd-card.cd-full{grid-column:span 12}.cd-kv-grid,.cd-finance-grid{grid-template-columns:1fr}.cd-scroll{height:300px}.cd-table-wrapper-mobile{display:none}.cd-mobile-list{display:block}}@media (max-width:520px){.cd-title{font-size:20px}.cd-card-header{align-items:flex-start;flex-direction:column}}\n&lt;/style&gt;\n\n&lt;div class=&quot;case-detail&quot;&gt;\n\t&lt;div class=&quot;cd-shell&quot;&gt;\n&lt;%\n\tif(caseRows.count() == 0)\n\t{\n%&gt;\n\t\t&lt;div class=&quot;cd-alert&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;strong&gt;Case not found&lt;/strong&gt;\n\t\t\t\t&lt;div&gt;The requested matter could not be found or you do not have access to it.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tcaseRec = caseRows;\n\t\tclientName = &quot;Not set&quot;;\n\t\tclientEmail = &quot;&quot;;\n\t\tclientPhone = &quot;&quot;;\n\t\tclientStatus = &quot;&quot;;\n\t\tif(caseRec.Client != null)\n\t\t{\n\t\t\tclientRec = Add_Client[ID == caseRec.Client];\n\t\t\tif(clientRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tclientName = ifnull(clientRec.Client_Name,&quot;Not set&quot;);\n\t\t\t\tclientEmail = ifnull(clientRec.Primary_Email,&quot;&quot;);\n\t\t\t\tclientPhone = ifnull(clientRec.Primary_Phone,&quot;&quot;);\n\t\t\t\tclientStatus = ifnull(clientRec.Client_Status,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tcontactName = &quot;Not set&quot;;\n\t\tcontactEmail = &quot;&quot;;\n\t\tcontactPhone = &quot;&quot;;\n\t\tcontactRole = &quot;&quot;;\n\t\tif(caseRec.Client_Contact != null)\n\t\t{\n\t\t\tcontactRec = Add_Client_Contact[ID == caseRec.Client_Contact];\n\t\t\tif(contactRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tcontactName = ifnull(contactRec.Contact_Name,&quot;Not set&quot;);\n\t\t\t\tcontactEmail = ifnull(contactRec.Email,&quot;&quot;);\n\t\t\t\tcontactPhone = ifnull(contactRec.Phone,&quot;&quot;);\n\t\t\t\tcontactRole = ifnull(contactRec.Role_Title,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tpracticeName = &quot;Not set&quot;;\n\t\tif(caseRec.Practice_Area != null)\n\t\t{\n\t\t\tpracticeRec = Add_Practice_Area[ID == caseRec.Practice_Area];\n\t\t\tif(practiceRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tpracticeName = ifnull(practiceRec.Practice_Area_Name,&quot;Not set&quot;);\n\t\t\t}\n\t\t}\n\t\tcaseTypeName = &quot;Not set&quot;;\n\t\tprocessTemplate = &quot;&quot;;\n\t\tif(caseRec.Case_Type != null)\n\t\t{\n\t\t\ttypeRec = Add_Case_Type[ID == caseRec.Case_Type];\n\t\t\tif(typeRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tcaseTypeName = ifnull(typeRec.Case_Type_Name,&quot;Not set&quot;);\n\t\t\t\tprocessTemplate = ifnull(typeRec.Process_Template,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tfeeScheduleName = &quot;Not set&quot;;\n\t\tif(caseRec.Fee_Schedule != null)\n\t\t{\n\t\t\tfeeRec = Add_Fee_Schedule[ID == caseRec.Fee_Schedule];\n\t\t\tif(feeRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tfeeScheduleName = ifnull(feeRec.Schedule_Name,&quot;Not set&quot;);\n\t\t\t}\n\t\t}\n\t\tcourtName = &quot;Not set&quot;;\n\t\tif(caseRec.Court != null)\n\t\t{\n\t\t\tcourtRec = Add_Court[ID == caseRec.Court];\n\t\t\tif(courtRec.count() &gt; 0)\n\t\t\t{\n\t\t\t\tcourtName = ifnull(courtRec.Court_Name,&quot;Not set&quot;);\n\t\t\t}\n\t\t}\n\t\tmanagerName = &quot;Not assigned&quot;;\n\t\tleadName = &quot;Not assigned&quot;;\n\t\tparalegalName = &quot;Not assigned&quot;;\n\t\tbillingName = &quot;Not assigned&quot;;\n\t\tif(caseRec.Matter_Manager != null)\n\t\t{\n\t\t\tmgr = Add_Employee[ID == caseRec.Matter_Manager];\n\t\t\tif(mgr.count() &gt; 0)\n\t\t\t{\n\t\t\t\tmanagerName = ifnull(mgr.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(mgr.Employee_Name.last_name,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tif(caseRec.Lead_Attorney != null)\n\t\t{\n\t\t\tlead = Add_Employee[ID == caseRec.Lead_Attorney];\n\t\t\tif(lead.count() &gt; 0)\n\t\t\t{\n\t\t\t\tleadName = ifnull(lead.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(lead.Employee_Name.last_name,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tif(caseRec.Paralegal != null)\n\t\t{\n\t\t\tpara = Add_Employee[ID == caseRec.Paralegal];\n\t\t\tif(para.count() &gt; 0)\n\t\t\t{\n\t\t\t\tparalegalName = ifnull(para.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(para.Employee_Name.last_name,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tif(caseRec.Billing_Attorney != null)\n\t\t{\n\t\t\tbill = Add_Employee[ID == caseRec.Billing_Attorney];\n\t\t\tif(bill.count() &gt; 0)\n\t\t\t{\n\t\t\t\tbillingName = ifnull(bill.Employee_Name.first_name,&quot;&quot;) + &quot; &quot; + ifnull(bill.Employee_Name.last_name,&quot;&quot;);\n\t\t\t}\n\t\t}\n\t\tcaseStatus = ifnull(caseRec.Case_Status,&quot;New Intake&quot;);\n\t\tconflictStatus = ifnull(caseRec.Conflict_Status,&quot;Not Started&quot;);\n\t\tengagementStatus = ifnull(caseRec.Engagement_Status,&quot;Not Sent&quot;);\n\t\tbillingStatus = ifnull(caseRec.Billing_Status,&quot;Not Ready&quot;);\n\t\tpriority = ifnull(caseRec.Priority,&quot;Medium&quot;);\n\t\tconfLevel = ifnull(caseRec.Confidentiality_Level,&quot;Standard&quot;);\n\t\tcaseStatusClass = &quot;zcs-badge-blue&quot;;\n\t\tif(caseStatus == &quot;Closed&quot; || caseStatus == &quot;Archived&quot;)\n\t\t{\n\t\t\tcaseStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t}\n\t\telse if(caseStatus == &quot;Rejected&quot;)\n\t\t{\n\t\t\tcaseStatusClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(caseStatus == &quot;Billing Review&quot;)\n\t\t{\n\t\t\tcaseStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(caseStatus == &quot;New Intake&quot; || caseStatus == &quot;Conflict Check&quot; || caseStatus == &quot;Engagement Pending&quot;)\n\t\t{\n\t\t\tcaseStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\tconfClass = &quot;zcs-badge-yellow&quot;;\n\t\tif(conflictStatus == &quot;Cleared&quot;)\n\t\t{\n\t\t\tconfClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(conflictStatus == &quot;Conflict Found&quot;)\n\t\t{\n\t\t\tconfClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(conflictStatus == &quot;Waiver Required&quot;)\n\t\t{\n\t\t\tconfClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\tengClass = &quot;zcs-badge-yellow&quot;;\n\t\tif(engagementStatus == &quot;Signed&quot;)\n\t\t{\n\t\t\tengClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(engagementStatus == &quot;Declined&quot;)\n\t\t{\n\t\t\tengClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\tbillClass = &quot;zcs-badge-grey&quot;;\n\t\tif(billingStatus == &quot;Ready for Review&quot; || billingStatus == &quot;Invoicing&quot;)\n\t\t{\n\t\t\tbillClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(billingStatus == &quot;Closed&quot;)\n\t\t{\n\t\t\tbillClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\tconfBadgeClass = &quot;zcs-badge-green&quot;;\n\t\tif(confLevel == &quot;Restricted&quot;)\n\t\t{\n\t\t\tconfBadgeClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(confLevel == &quot;Highly Confidential&quot;)\n\t\t{\n\t\t\tconfBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\ttimeTotal = Add_Time_Entry[Case == caseRec.ID &amp;&amp; Billable == true].sum(Amount);\n\t\tif(timeTotal == null){timeTotal = 0;}\n\t\ttotalHours = Add_Time_Entry[Case == caseRec.ID].sum(Hours);\n\t\tif(totalHours == null){totalHours = 0;}\n\t\texpenseTotal = Add_Expense_Entry[Case == caseRec.ID &amp;&amp; Billable == true].sum(Amount);\n\t\tif(expenseTotal == null){expenseTotal = 0;}\n\t\tinvoiceTotal = Create_Invoice[Case == caseRec.ID].sum(Total_Amount);\n\t\tif(invoiceTotal == null){invoiceTotal = 0;}\n\t\tpaidTotal = Add_Payment[Case == caseRec.ID &amp;&amp; (Payment_Status == &quot;Received&quot; || Payment_Status == &quot;Reconciled&quot;)].sum(Amount);\n\t\tif(paidTotal == null){paidTotal = 0;}\n\t\tbalanceTotal = Create_Invoice[Case == caseRec.ID].sum(Balance_Due);\n\t\tif(balanceTotal == null){balanceTotal = 0;}\n\t\tshowLitigation = false;\n\t\tshowCorporate = false;\n\t\tshowCompliance = false;\n\t\tif(processTemplate == &quot;Litigation&quot; || processTemplate == &quot;Arbitration&quot; || caseRec.Court != null || ifnull(caseRec.Court_Case_Number,&quot;&quot;) != &quot;&quot;)\n\t\t{\n\t\t\tshowLitigation = true;\n\t\t}\n\t\tif(processTemplate == &quot;Corporate Advisory&quot; || ifnull(caseRec.Transaction_Counterparty,&quot;&quot;) != &quot;&quot; || caseRec.Transaction_Value != null || caseRec.Execution_Target_Date != null)\n\t\t{\n\t\t\tshowCorporate = true;\n\t\t}\n\t\tif(processTemplate == &quot;Compliance&quot; || ifnull(caseRec.Regulator,&quot;&quot;) != &quot;&quot; || caseRec.Compliance_Due_Date != null)\n\t\t{\n\t\t\tshowCompliance = true;\n\t\t}\n\t\tcanReopen = true;\n%&gt;\n\t\t&lt;div class=&quot;cd-header&quot;&gt;\n\t\t\t&lt;div class=&quot;cd-title-block&quot;&gt;\n\t\t\t\t&lt;p class=&quot;cd-kicker&quot;&gt;Matter Detail&lt;/p&gt;\n\t\t\t\t&lt;h1 class=&quot;cd-title&quot;&gt;&lt;%=ifnull(caseRec.Case_Title,&quot;Untitled Matter&quot;)%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;cd-subtitle&quot;&gt;Case &lt;%=ifnull(caseRec.Case_Number,caseRec.ID)%&gt; · &lt;%=practiceName%&gt; · &lt;%=caseTypeName%&gt;&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;cd-badge-row&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=caseStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=caseStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=confClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Conflict: &lt;%=conflictStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=engClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Engagement: &lt;%=engagementStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=billClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Billing: &lt;%=billingStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=confBadgeClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-lock&quot;&gt;&lt;/i&gt; &lt;%=confLevel%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cd-action-row&quot;&gt;\n&lt;%\n\t\tif(caseStatus == &quot;New Intake&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Submit%20Conflict%20Check&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Submit Conflict Check&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(caseStatus == &quot;Conflict Check&quot;)\n\t\t{\n\t\t\tif(conflictStatus == &quot;Cleared&quot;)\n\t\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Clear%20Conflict&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Clear Conflict&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Flag%20Conflict&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Flag Conflict&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(caseStatus == &quot;Engagement Pending&quot; &amp;&amp; (conflictStatus == &quot;Cleared&quot; || conflictStatus == &quot;Waiver Required&quot;))\n\t\t{\n\t\t\tif(engagementStatus == &quot;Not Sent&quot;)\n\t\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Send%20Engagement&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-share-66&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Send Engagement&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(engagementStatus == &quot;Sent&quot;)\n\t\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Mark%20Engagement%20Signed&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Mark Engagement Signed&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(engagementStatus == &quot;Signed&quot;)\n\t\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Open%20Matter&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open Matter&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tif(caseStatus == &quot;Open Matter&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Move%20To%20Strategy%20and%20Pleadings&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Move To Strategy&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse if(caseStatus == &quot;Strategy and Pleadings&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Move%20To%20Discovery%20and%20Diligence&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Move To Discovery&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse if(caseStatus == &quot;Discovery and Diligence&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Move%20To%20Negotiation%20and%20Mediation&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Move To Negotiation&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse if(caseStatus == &quot;Negotiation and Mediation&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Move%20To%20Hearing%20and%20Trial&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Move To Hearing&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse if(caseStatus == &quot;Hearing and Trial&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Mark%20Awaiting%20Order%20or%20Execution&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Await Order&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(caseStatus == &quot;Awaiting Order or Execution&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Send%20To%20Billing%20Review&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-money-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Send To Billing Review&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(caseStatus == &quot;Billing Review&quot; &amp;&amp; (billingStatus == &quot;Ready for Review&quot; || billingStatus == &quot;Invoicing&quot; || billingStatus == &quot;Closed&quot;))\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Close%20Case&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Close Case&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif(caseStatus == &quot;Closed&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Archive%20Case&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Archive&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\tif((caseStatus == &quot;Closed&quot; || caseStatus == &quot;Archived&quot;) &amp;&amp; canReopen == true)\n\t\t{\n%&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Action?Case=&lt;%=caseRec.ID%&gt;&amp;amp;Action_Type=Reopen%20Case&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Reopen&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;cd-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;cd-card cd-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Matter Summary&lt;/h2&gt;&lt;p&gt;Core narrative and desired outcome&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Practice Area&lt;/label&gt;&lt;strong&gt;&lt;%=practiceName%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=caseTypeName%&gt; · &lt;%=ifnull(processTemplate,&quot;General&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Priority&lt;/label&gt;&lt;strong&gt;&lt;%=priority%&gt;&lt;/strong&gt;&lt;small&gt;Opened: &lt;%=ifnull(caseRec.Opened_On,&quot;Not opened&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv-grid single&quot; style=&quot;margin-top:12px;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Summary&lt;/label&gt;&lt;p class=&quot;cd-narrative&quot;&gt;&lt;%=ifnull(caseRec.Summary,&quot;No matter summary has been recorded.&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Desired Outcome&lt;/label&gt;&lt;p class=&quot;cd-narrative&quot;&gt;&lt;%=ifnull(caseRec.Desired_Outcome,&quot;No desired outcome has been recorded.&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cd-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Client and Contact&lt;/h2&gt;&lt;p&gt;Authorized client details&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-body cd-kv-grid single&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Client&lt;/label&gt;&lt;strong&gt;&lt;%=clientName%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=clientStatus%&gt;&lt;/small&gt;&lt;small&gt;&lt;%=clientEmail%&gt; &lt;%=clientPhone%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Primary Contact&lt;/label&gt;&lt;strong&gt;&lt;%=contactName%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=contactRole%&gt;&lt;/small&gt;&lt;small&gt;&lt;%=contactEmail%&gt; &lt;%=contactPhone%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cd-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Assignments&lt;/h2&gt;&lt;p&gt;Matter team and billing ownership&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-body cd-kv-grid single&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Matter Manager&lt;/label&gt;&lt;strong&gt;&lt;%=managerName%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Lead Attorney&lt;/label&gt;&lt;strong&gt;&lt;%=leadName%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Paralegal&lt;/label&gt;&lt;strong&gt;&lt;%=paralegalName%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Billing Attorney&lt;/label&gt;&lt;strong&gt;&lt;%=billingName%&gt;&lt;/strong&gt;&lt;small&gt;&lt;%=feeScheduleName%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cd-card cd-wide&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Type-Specific Details&lt;/h2&gt;&lt;p&gt;Litigation, corporate, and compliance information shown when applicable&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-body&quot;&gt;\n&lt;%\n\t\tif(showLitigation == false &amp;&amp; showCorporate == false &amp;&amp; showCompliance == false)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No type-specific details recorded&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Add details on the case form when this matter requires litigation, corporate, or compliance tracking.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-process-grid&quot;&gt;\n&lt;%\n\t\t\tif(showLitigation == true)\n\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cd-kv-grid single&quot;&gt;&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Litigation / Court&lt;/label&gt;&lt;strong&gt;&lt;%=courtName%&gt;&lt;/strong&gt;&lt;small&gt;Case number: &lt;%=ifnull(caseRec.Court_Case_Number,&quot;Not recorded&quot;)%&gt;&lt;/small&gt;&lt;small&gt;Filed: &lt;%=ifnull(caseRec.Filing_Date,&quot;Not recorded&quot;)%&gt;&lt;/small&gt;&lt;small&gt;Limitation: &lt;%=ifnull(caseRec.Limitation_Date,&quot;Not recorded&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(showCorporate == true)\n\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cd-kv-grid single&quot;&gt;&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Corporate / Transaction&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(caseRec.Transaction_Counterparty,&quot;Counterparty not recorded&quot;)%&gt;&lt;/strong&gt;&lt;small&gt;Value: $&lt;%=ifnull(caseRec.Transaction_Value,0)%&gt;&lt;/small&gt;&lt;small&gt;Execution target: &lt;%=ifnull(caseRec.Execution_Target_Date,&quot;Not recorded&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(showCompliance == true)\n\t\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;cd-kv-grid single&quot;&gt;&lt;div class=&quot;cd-kv&quot;&gt;&lt;label&gt;Compliance / Regulatory&lt;/label&gt;&lt;strong&gt;&lt;%=ifnull(caseRec.Regulator,&quot;Regulator not recorded&quot;)%&gt;&lt;/strong&gt;&lt;small&gt;Due date: &lt;%=ifnull(caseRec.Compliance_Due_Date,&quot;Not recorded&quot;)%&gt;&lt;/small&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cd-card cd-full&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Financial Summary&lt;/h2&gt;&lt;p&gt;Estimated value, retainers, billable work, invoices, and payments&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-body cd-finance-grid&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-finance-card&quot;&gt;&lt;label&gt;Estimated Value&lt;/label&gt;&lt;strong&gt;$&lt;%=ifnull(caseRec.Estimated_Value,0)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-finance-card&quot;&gt;&lt;label&gt;Retainer&lt;/label&gt;&lt;strong&gt;$&lt;%=ifnull(caseRec.Retainer_Amount,0)%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-finance-card&quot;&gt;&lt;label&gt;Billable Time&lt;/label&gt;&lt;strong&gt;$&lt;%=timeTotal%&gt;&lt;/strong&gt;&lt;span class=&quot;cd-muted&quot;&gt;&lt;%=totalHours%&gt; hours&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-finance-card&quot;&gt;&lt;label&gt;Billable Expenses&lt;/label&gt;&lt;strong&gt;$&lt;%=expenseTotal%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-finance-card&quot;&gt;&lt;label&gt;Invoiced&lt;/label&gt;&lt;strong&gt;$&lt;%=invoiceTotal%&gt;&lt;/strong&gt;&lt;span class=&quot;cd-muted&quot;&gt;Balance $&lt;%=balanceTotal%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-finance-card&quot;&gt;&lt;label&gt;Payments&lt;/label&gt;&lt;strong&gt;$&lt;%=paidTotal%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;cd-related-grid&quot;&gt;\n&lt;%\n\t\tpartyRows = Add_Case_Party[Case == caseRec.ID] sort by Party_Name asc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Parties&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Case_Party[Case == caseRec.ID].count()%&gt; related party records&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Case_Party?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Party&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(partyRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No parties added&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Add clients, opposing parties, witnesses, or other matter participants.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative cd-table-wrapper-mobile&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Party&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Counsel&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each p in partyRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(p.Party_Type,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;cd-main&quot;&gt;&lt;%=ifnull(p.Party_Name,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;cd-sub&quot;&gt;&lt;%=ifnull(p.Organization,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(p.Counsel_Name,&quot;-&quot;)%&gt;&lt;div class=&quot;cd-sub&quot;&gt;&lt;%=ifnull(p.Counsel_Email,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(p.Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;div class=&quot;cd-mobile-list&quot;&gt;\n&lt;%\n\t\t\tfor each p in partyRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;cd-mobile-card&quot;&gt;&lt;p class=&quot;cd-mobile-card-title&quot;&gt;&lt;%=ifnull(p.Party_Name,&quot;-&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cd-mobile-card-line&quot;&gt;&lt;%=ifnull(p.Party_Type,&quot;-&quot;)%&gt; · &lt;%=ifnull(p.Organization,&quot;&quot;)%&gt;&lt;/p&gt;&lt;p class=&quot;cd-mobile-card-line&quot;&gt;Counsel: &lt;%=ifnull(p.Counsel_Name,&quot;-&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tconflictRows = Add_Conflict_Check[Case == caseRec.ID] sort by Checked_On desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Conflict Checks&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Conflict_Check[Case == caseRec.ID].count()%&gt; checks recorded&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Conflict_Check?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Check&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(conflictRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No conflict checks&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Submit a conflict check before engagement actions are available.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Opposing Party&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Decision&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Severity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Checked On&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each cc in conflictRows\n\t\t\t{\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(cc.Opposing_Party_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(cc.Decision,&quot;Pending&quot;)%&gt;&lt;div class=&quot;cd-sub&quot;&gt;&lt;%=ifnull(cc.Approval_Status,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(cc.Conflict_Severity,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(cc.Checked_On,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tengRows = Add_Engagement_Letter[Case == caseRec.ID] sort by Sent_On desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Engagement Letters&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Engagement_Letter[Case == caseRec.ID].count()%&gt; engagement records&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Engagement_Letter?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Engagement&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(engRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No engagement letters&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Create an engagement letter after conflicts permit engagement.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table compact&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Sent&lt;/th&gt;&lt;th class=&quot;