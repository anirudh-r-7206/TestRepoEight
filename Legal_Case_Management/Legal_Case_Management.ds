												custom deluge script
												(
																	if(input.Select_Template != null)
																{
																	input.Template = input.Select_Template.Template;
																}
																else
																{
																	input.Template = null;
																}
												)
											}
										}
						
									
						
			}

			On_Load_Scripts8 as "On-Load Scripts"
			{
			
						
										type =  form
										form = Create_Template
						
										record event = on add or edit
						
										on load
										{
											actions 
											{
												custom deluge script
												(
																	input.plain1 = thisapp.decisionBoxStyle.getDecisionBoxToggleBtnStyle("All","","#457eee","#dddddd");
																input.plain = thisapp.getNotesContent(input.Email_For);
												)
											}
										}
						
									
						
			}

			On_success7 as "On success"
			{
			
						
										type =  form
										form = Create_Template
						
										record event = on add or edit
						
										on success
										{
											actions 
											{
												custom deluge script
												(
																	if(input.Active)
																{
																	for each  rec in Create_Template[Email_For == input.Email_For && ID != input.ID]
																	{
																		rec.Active=false;
																	}
																}
												)
											}
										}
						
									
						
			}

			Run_Script1 as "Run Script"
			{
			
						
										type =  form
										form = Navigation
						
										record event = on add
						
										on user input of Nav_Options
										{
											actions 
											{
												custom deluge script
												(
																	navOptionMap = Map();
																fetchPreference = Add_Preference[ID != null];
																if(fetchPreference.count() != 0)
																{
																	preferenceID = fetchPreference.ID;
																	if(fetchPreference.Organization_Logo == "" || fetchPreference.Organization_Logo == null)
																	{
																		res = invokeurl
																		[
																			url :"https://files-accl.zohoexternal.com/public/workdrive-external/download/h814669ae0987327a4404804a6236ce5e7438?x-cli-msg=%7B%22linkId%22%3A%226OxchGOzv8B-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D"
																			type :GET
																		];
																		res.setParamName("file");
																		res.setFileName("Creator_Logo" + ".png");
																		response = invokeurl
																		[
																			url :"https://www.zohoapis.com/creator/v2.1/data" + zoho.appuri + "report/All_Preferences/" + fetchPreference.ID + "/Organization_Logo/upload"
																			type :POST
																			files:res
																			connection:"creator"
																		];
																	}
																	navOptionMap.put("Other_Config",{"Preference":{"name":"Add_Preference","type":"Form","criteria":"&viewLinkName=All_Preferences&recLinkID=" + preferenceID}});
																	navOptionMap.put("Free_Cash",{"Pending Free Issue":{"name":"Pending_Free_Issue_Report","type":"Report","criteria":""},"Employee Preference":{"name":"Employee_Preference","type":"Report","criteria":""},"All Free Issue":{"name":"Add_Free_Issue_Report","type":"Report","criteria":""}});
																	if(input.Nav_Options != "" && navOptionMap.containKey(input.Page_Name))
																	{
																		mapp = navOptionMap.get(input.Page_Name);
																		openUrl("#" + if(mapp.get(input.Nav_Options).get("type") != null,mapp.get(input.Nav_Options).get("type"),"Report") + ":" + mapp.get(input.Nav_Options).get("name") + "?zc_LoadIn=embed-showFrame" + if(mapp.get(input.Nav_Options).get("criteria") != null,mapp.get(input.Nav_Options).get("criteria"),""),"same window");
																	}
																}
																else
																{
																	insert into Add_Preference
																	[
																		Added_User=zoho.loginuser
																		Email_Notification=true
																	]
																	openUrl("#Script:page.refresh","same window");
																}
												)
											}
										}
						
									
						
			}

			Hide_Data1 as "Hide Data"
			{
			
						
										type =  form
										form = Navigation
						
										record event = on add
						
										field rules
										{
											actions 
											{
												hide Hidden;
											}
										}
						
									
						
			}

			Run_Script as "Run Script"
			{
			
						
										type =  form
										form = Navigation
						
										record event = on add
						
										on load
										{
											actions 
											{
												custom deluge script
												(
																navOptionMap = Map();
																navOptionMap.put("Other_Config",{"Preference"});
																navOptionMap.put("Free_Cash",{"Pending Free Issue","Employee Preference","All Free Issue"});
																liss = navOptionMap.get(input.Page_Name);
																if(liss != null)
																{
																	input.Nav_Options:ui.add(liss);
																}
												)
											}
										}
						
									
						
			}

			On_success as "On success"
			{
			
						
										type =  form
										form = Request_Access
						
										record event = on add
						
										on success
										{
											actions 
											{
												custom deluge script
												(
																	if(input.Action_Type == "Provide")
																{
																	if(input.Access_Type == "" || input.Access_Type == "User Access")
																	{
																		if(thisapp.permissions.profileForUser(input.Requester_Email) != "Administrator")
																		{
																			thisapp.permissions.assignUserInProfile(input.Requester_Email,"Write");
																		}
																		input.IsOnSuccessCodeExecuted = true;
																	}
																	else if(input.Access_Type == "Portal Access")
																	{
																		thisapp.portal.assignUserInProfile(input.Requester_Email,"Customer");
																		input.IsOnSuccessCodeExecuted = true;
																	}
																}
																else if(input.Action_Type == "Revoke")
																{
																	if(input.Access_Type == "" || input.Access_Type == "User Access")
																	{
																		if(thisapp.permissions.profileForUser(input.Requester_Email) != "Administrator")
																		{
																			thisapp.permissions.deleteUser(input.Requester_Email);
																		}
																		input.IsOnSuccessCodeExecuted = true;
																	}
																	else if(input.Access_Type == "Portal Access")
																	{
																		thisapp.portal.deleteUser(input.Requester_Email);
																		input.IsOnSuccessCodeExecuted = true;
																	}
																}
												)
											}
										}
						
									
						
			}
		}

		schedule
		{
			Add_Case_Task_Schedule as "Add Case Task Schedule"
			{
			
						    type = schedule
						    start = "2026-01-01 08:00:00"
						    frequency = daily
						    time zone = "Asia/Kolkata"
						
						    on start
						    {
						        actions
						        {
						            on load
						            (
						                openTasks = Add_Case_Task[Due_Date < zoho.currentdate && Task_Status != "Completed" && Task_Status != "Cancelled"] range from 1 to 200;
						                for each taskRec in openTasks
						                {
						                    taskRec.Task_Status = "Overdue";
						                    empRec = Add_Employee[ID == taskRec.Assigned_To];
						                    if(empRec.count() > 0 && ifnull(empRec.Email,"") != "")
						                    {
						                        sendmail
						                        (
						                            from : zoho.adminuserid
						                            to : empRec.Email
						                            subject : "Overdue legal task"
						                            message : "Task is overdue: " + taskRec.Task_Title
						                        )
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Deadline_Schedule as "Add Deadline Schedule"
			{
			
						    type = schedule
						    start = "2026-01-01 08:15:00"
						    frequency = daily
						    time zone = "Asia/Kolkata"
						
						    on start
						    {
						        actions
						        {
						            on load
						            (
						                reminderRows = Add_Deadline[Reminder_Date == zoho.currentdate && Deadline_Status != "Met" && Deadline_Status != "Cancelled"] range from 1 to 200;
						                for each dRec in reminderRows
						                {
						                    resp = Add_Employee[ID == dRec.Responsible_Attorney];
						                    if(resp.count() > 0 && ifnull(resp.Email,"") != "")
						                    {
						                        sendmail
						                        (
						                            from : zoho.adminuserid
						                            to : resp.Email
						                            subject : "Legal deadline reminder"
						                            message : "Reminder: " + dRec.Deadline_Type + " deadline is due on " + dRec.Deadline_Date
						                        )
						                    }
						                }
						                missedRows = Add_Deadline[Deadline_Date < zoho.currentdate && Deadline_Status != "Met" && Deadline_Status != "Cancelled" && Deadline_Status != "Missed"] range from 1 to 200;
						                for each mRec in missedRows
						                {
						                    mRec.Deadline_Status = "Missed";
						                    empRec = Add_Employee[ID == mRec.Responsible_Attorney];
						                    notifyTo = "";
						                    if(empRec.count() > 0)
						                    {
						                        notifyTo = ifnull(empRec.Email,"");
						                    }
						                    caseRec = Create_Case[ID == mRec.Case];
						                    if(caseRec.count() > 0 && caseRec.Matter_Manager != null)
						                    {
						                        managerRec = Add_Employee[ID == caseRec.Matter_Manager];
						                        if(managerRec.count() > 0 && ifnull(managerRec.Email,"") != "")
						                        {
						                            if(notifyTo == "")
						                            {
						                                notifyTo = managerRec.Email;
						                            }
						                            else
						                            {
						                                notifyTo = notifyTo + "," + managerRec.Email;
						                            }
						                        }
						                    }
						                    if(notifyTo != "")
						                    {
						                        sendmail
						                        (
						                            from : zoho.adminuserid
						                            to : notifyTo
						                            subject : "Missed legal deadline"
						                            message : "Deadline missed: " + mRec.Deadline_Type + " for case " + mRec.Case
						                        )
						                    }
						                }
						            )
						        }
						    }
						
			}

			Create_Invoice_Schedule as "Create Invoice Schedule"
			{
			
						    type = schedule
						    start = "2026-01-01 08:30:00"
						    frequency = daily
						    time zone = "Asia/Kolkata"
						
						    on start
						    {
						        actions
						        {
						            on load
						            (
						                overdueInvoices = Create_Invoice[Due_Date < zoho.currentdate && Balance_Due > 0 && Invoice_Status != "Paid" && Invoice_Status != "Cancelled" && Invoice_Status != "Overdue"];
						                for each inv in overdueInvoices
						                {
						                    inv.Invoice_Status = "Overdue";
						                    caseRec = Create_Case[ID == inv.Case];
						                    if(caseRec.count() > 0 && caseRec.Billing_Attorney != null)
						                    {
						                        billEmp = Add_Employee[ID == caseRec.Billing_Attorney];
						                        if(billEmp.count() > 0 && ifnull(billEmp.Email,"") != "")
						                        {
						                            sendmail
						                            (
						                                from : zoho.adminuserid
						                                to : billEmp.Email
						                                subject : "Invoice overdue"
						                                message : "Invoice for " + caseRec.Case_Title + " is overdue."
						                            )
						                        }
						                    }
						                }
						            )
						        }
						    }
						
			}
		}

		blueprint
		{
			Invoice_Lifecycle as "Invoice Lifecycle"
			{
			
						    type = blueprint
						    form = Create_Invoice
						
						    start
						    {
						        start stage = "Draft"
						    }
						
						    stages
						    {
						        "Draft" { }
						        "Submitted for Review" { }
						        "Approved" { }
						        "Sent" { }
						        "Partially Paid" { }
						        "Paid" { }
						        "Overdue" { }
						        "Cancelled" { }
						    }
						
						    transitions
						    {
						        Submit_For_Review as "Submit For Review"
						        {
						            type = normal
						            from stage = "Draft"
						            to stage = "Submitted for Review"
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing","Attorney"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Submitted for Review";
						                        insert into Add_Case_History
						                        [
						                            Case = input.Case
						                            Event_Date = zoho.currenttime
						                            Event_Type = "Invoice Submitted"
						                            New_Status = "Submitted for Review"
						                            Summary = "Invoice submitted for review."
						                            Changed_By = input.Prepared_By
						                            Source_Record_ID = input.ID
						                        ];
						                    )
						                }
						            }
						        }
						        Approve_Invoice as "Approve Invoice"
						        {
						            type = normal
						            from stage = "Submitted for Review"
						            to stage = "Approved"
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing","Managing_Partner"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Approved";
						                        insert into Add_Case_History
						                        [
						                            Case = input.Case
						                            Event_Date = zoho.currenttime
						                            Event_Type = "Invoice Approved"
						                            New_Status = "Approved"
						                            Summary = "Invoice approved."
						                            Changed_By = input.Approved_By
						                            Source_Record_ID = input.ID
						                        ];
						                    )
						                }
						            }
						        }
						        Send_Invoice as "Send Invoice"
						        {
						            type = normal
						            from stage = "Approved"
						            to stage = "Sent"
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Sent";
						                        input.Sent_On = zoho.currentdate;
						                        insert into Add_Case_History
						                        [
						                            Case = input.Case
						                            Event_Date = zoho.currenttime
						                            Event_Type = "Invoice Sent"
						                            New_Status = "Sent"
						                            Summary = "Invoice sent to client."
						                            Changed_By = input.Prepared_By
						                            Source_Record_ID = input.ID
						                        ];
						                    )
						                }
						            }
						        }
						        Mark_Partially_Paid as "Mark Partially Paid"
						        {
						            type = normal
						            from stage = "Sent"
						            to stage = "Partially Paid"
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Partially Paid";
						                    )
						                }
						            }
						        }
						        Mark_Paid as "Mark Paid"
						        {
						            type = common
						            from stage = "Sent"
						            to stage = "Paid"
						            common stages = {"Partially Paid","Overdue"}
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Paid";
						                        insert into Add_Case_History
						                        [
						                            Case = input.Case
						                            Event_Date = zoho.currenttime
						                            Event_Type = "Invoice Paid"
						                            New_Status = "Paid"
						                            Summary = "Invoice marked paid."
						                            Changed_By = input.Prepared_By
						                            Source_Record_ID = input.ID
						                        ];
						                    )
						                }
						            }
						        }
						        Mark_Overdue as "Mark Overdue"
						        {
						            type = common
						            from stage = "Sent"
						            to stage = "Overdue"
						            common stages = {"Partially Paid"}
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Overdue";
						                    )
						                }
						            }
						        }
						        Cancel_Invoice as "Cancel Invoice"
						        {
						            type = common
						            from stage = "Draft"
						            to stage = "Cancelled"
						            common stages = {"Submitted for Review","Approved","Sent"}
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing","Managing_Partner"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Cancelled";
						                    )
						                }
						            }
						        }
						        Reopen_Invoice as "Reopen Invoice"
						        {
						            type = normal
						            from stage = "Cancelled"
						            to stage = "Draft"
						            before
						            {
						                transition owner
						                (
						                    permissions = {"Finance_Billing","Managing_Partner"}
						                )
						            }
						            after
						            {
						                actions
						                {
						                    custom deluge script
						                    (
						                        input.Invoice_Status = "Draft";
						                    )
						                }
						            }
						        }
						    }
						
			}
		}
	}

