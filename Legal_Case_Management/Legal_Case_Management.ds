			Source_Type_On_User_Input as "Source Type On User Input"
			{
			
						    type = form
						    form = Add_Invoice_Item
						    record event = on add or edit
						
						    on user input of Source_Type
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Source_Type == "Fixed Fee")
						                {
						                    input.Quantity = 1;
						                    input.Time_Entry = null;
						                    input.Expense_Entry = null;
						                }
						                else if(input.Source_Type == "Adjustment")
						                {
						                    input.Quantity = 1;
						                    input.Time_Entry = null;
						                    input.Expense_Entry = null;
						                    input.Taxable = false;
						                }
						            )
						        }
						    }
						
			}

			Time_Entry_On_User_Input as "Time Entry On User Input"
			{
			
						    type = form
						    form = Add_Invoice_Item
						    record event = on add or edit
						
						    on user input of Time_Entry
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Time_Entry != null)
						                {
						                    te = Add_Time_Entry[ID == input.Time_Entry];
						                    if(te.count() > 0)
						                    {
						                        input.Source_Type = "Time Entry";
						                        input.Case = te.Case;
						                        input.Description = te.Activity_Type + ": " + te.Description;
						                        input.Quantity = te.Hours;
						                        input.Rate = te.Billing_Rate;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Invoice_Item_On_Delete as "Add Invoice Item On Delete"
			{
			
						    type = form
						    form = Add_Invoice_Item
						    record event = on delete
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                inv = Create_Invoice[ID == input.Invoice];
						                if(inv.count() > 0)
						                {
						                    lines = Add_Invoice_Item[Invoice == input.Invoice];
						                    subtotal = 0;
						                    tax = 0;
						                    for each line in lines
						                    {
						                        subtotal = subtotal + ifnull(line.Amount,0);
						                        if(line.Taxable == true)
						                        {
						                            tax = tax + (ifnull(line.Amount,0) * 0.1);
						                        }
						                    }
						                    inv.Subtotal = subtotal;
						                    inv.Tax_Amount = tax;
						                }
						            )
						        }
						    }
						
			}

			Add_Invoice_Item_On_Load as "Add Invoice Item On Load"
			{
			
						    type = form
						    form = Add_Invoice_Item
						    record event = on add or edit
						
						    on load
						    {
						        actions
						        {
						            hide System_Info, Invoice_Item_ID;
						            disable Invoice_Item_ID, Amount;
						        }
						        actions (Invoice != null)
						        {
						            disable Case;
						        }
						    }
						
			}

			Add_Invoice_Item_On_Success as "Add Invoice Item On Success"
			{
			
						    type = form
						    form = Add_Invoice_Item
						    record event = on add or edit
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                inv = Create_Invoice[ID == input.Invoice];
						                if(inv.count() > 0)
						                {
						                    lines = Add_Invoice_Item[Invoice == input.Invoice];
						                    subtotal = 0;
						                    tax = 0;
						                    for each line in lines
						                    {
						                        subtotal = subtotal + ifnull(line.Amount,0);
						                        if(line.Taxable == true)
						                        {
						                            tax = tax + (ifnull(line.Amount,0) * 0.1);
						                        }
						                    }
						                    inv.Subtotal = subtotal;
						                    inv.Tax_Amount = tax;
						                }
						                if(input.Line_Status == "Billed")
						                {
						                    if(input.Time_Entry != null)
						                    {
						                        te = Add_Time_Entry[ID == input.Time_Entry];
						                        if(te.count() > 0)
						                        {
						                            te.Invoice = input.Invoice;
						                            te.Approval_Status = "Invoiced";
						                        }
						                    }
						                    if(input.Expense_Entry != null)
						                    {
						                        exp = Add_Expense_Entry[ID == input.Expense_Entry];
						                        if(exp.count() > 0)
						                        {
						                            exp.Invoice = input.Invoice;
						                            exp.Approval_Status = "Invoiced";
						                        }
						                    }
						                }
						                insert into Add_Case_History
						                [
						                    Case = input.Case
						                    Event_Date = zoho.currenttime
						                    Event_Type = "Invoice Item"
						                    Summary = "Invoice item updated: " + input.Description
						                    Source_Record_ID = input.ID
						                ];
						            )
						        }
						    }
						
			}

			Add_Invoice_Item_On_Validate as "Add Invoice Item On Validate"
			{
			
						    type = form
						    form = Add_Invoice_Item
						    record event = on add or edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Source_Type == "Time Entry")
						                {
						                    if(input.Time_Entry == null)
						                    {
						                        alert "Time Entry is required for a time-entry invoice line.";
						                        cancel submit;
						                    }
						                    else
						                    {
						                        te = Add_Time_Entry[ID == input.Time_Entry];
						                        if(te.count() > 0 && te.Invoice != null && te.Invoice != input.Invoice)
						                        {
						                            alert "This time entry is already linked to another invoice.";
						                            cancel submit;
						                        }
						                    }
						                }
						                if(input.Source_Type == "Expense Entry")
						                {
						                    if(input.Expense_Entry == null)
						                    {
						                        alert "Expense Entry is required for an expense invoice line.";
						                        cancel submit;
						                    }
						                    else
						                    {
						                        exp = Add_Expense_Entry[ID == input.Expense_Entry];
						                        if(exp.count() > 0 && exp.Invoice != null && exp.Invoice != input.Invoice)
						                        {
						                            alert "This expense entry is already linked to another invoice.";
						                            cancel submit;
						                        }
						                    }
						                }
						                if(input.Source_Type != "Adjustment" && ifnull(input.Quantity,0) <= 0)
						                {
						                    alert "Quantity must be greater than zero.";
						                    cancel submit;
						                }
						            )
						        }
						    }
						
			}

			Add_Payment_Invoice_On_User_Input as "Invoice On User Input"
			{
			
						    type = form
						    form = Add_Payment
						    record event = on add or edit
						
						    on user input of Invoice
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Invoice != null)
						                {
						                    inv = Create_Invoice[ID == input.Invoice];
						                    if(inv.count() > 0)
						                    {
						                        input.Case = inv.Case;
						                        input.Client = inv.Client;
						                    }
						                }
						            )
						        }
						    }
						
