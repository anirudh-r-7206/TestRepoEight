			Add_Engagement_Letter_Fee_Schedule_On_User_Input as "Fee Schedule On User Input"
			{
			
						    type = form
						    form = Add_Engagement_Letter
						    record event = on add or edit
						
						    on user input of Fee_Schedule
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Fee_Schedule != null)
						                {
						                    feeRec = Add_Fee_Schedule[ID == input.Fee_Schedule];
						                    if(feeRec.count() > 0)
						                    {
						                        input.Retainer_Required = feeRec.Retainer_Required;
						                        if(feeRec.Retainer_Required == true)
						                        {
						                            input.Retainer_Amount = feeRec.Default_Retainer;
						                        }
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Engagement_Letter_On_Load as "Add Engagement Letter On Load"
			{
			
						    type = form
						    form = Add_Engagement_Letter
						    record event = on add or edit
						
						    on load
						    {
						        actions
						        {
						            hide System_Info, Engagement_ID;
						            disable Engagement_ID;
						        }
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Case != null)
						                {
						                    caseRec = Create_Case[ID == input.Case];
						                    if(caseRec.count() > 0)
						                    {
						                        input.Client = caseRec.Client;
						                        input.Fee_Schedule = caseRec.Fee_Schedule;
						                        input.Retainer_Amount = caseRec.Retainer_Amount;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Engagement_Letter_On_Success as "Add Engagement Letter On Success"
			{
			
						    type = form
						    form = Add_Engagement_Letter
						    record event = on add or edit
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                caseRec = Create_Case[ID == input.Case];
						                if(caseRec.count() > 0)
						                {
						                    previousEngagement = caseRec.Engagement_Status;
						                    if(input.Letter_Status == "Sent")
						                    {
						                        caseRec.Engagement_Status = "Sent";
						                    }
						                    else if(input.Letter_Status == "Client Signed")
						                    {
						                        caseRec.Engagement_Status = "Signed";
						                        if(caseRec.Conflict_Status == "Cleared" || caseRec.Conflict_Status == "Waiver Required")
						                        {
						                            caseRec.Case_Status = "Open Matter";
						                            caseRec.Opened_On = zoho.currentdate;
						                        }
						                    }
						                    else if(input.Letter_Status == "Declined")
						                    {
						                        caseRec.Engagement_Status = "Declined";
						                    }
						                    if(input.Fee_Schedule != null)
						                    {
						                        caseRec.Fee_Schedule = input.Fee_Schedule;
						                    }
						                    caseRec.Retainer_Amount = input.Retainer_Amount;
						                    insert into Add_Case_History
						                    [
						                        Case = input.Case
						                        Event_Date = zoho.currenttime
						                        Event_Type = "Engagement Updated"
						                        Previous_Status = previousEngagement
						                        New_Status = caseRec.Engagement_Status
						                        Summary = "Engagement letter status: " + input.Letter_Status
						                        Source_Record_ID = input.ID
						                    ];
						                    notifyTo = "";
						                    if(caseRec.Matter_Manager != null)
						                    {
						                        mgrRec = Add_Employee[ID == caseRec.Matter_Manager];
						                        if(mgrRec.count() > 0)
						                        {
						                            notifyTo = ifnull(mgrRec.Email,"");
						                        }
						                    }
						                    if(caseRec.Billing_Attorney != null)
						                    {
						                        billRec = Add_Employee[ID == caseRec.Billing_Attorney];
						                        if(billRec.count() > 0 && ifnull(billRec.Email,"") != "")
						                        {
						                            notifyTo = notifyTo + "," + billRec.Email;
						                        }
						                    }
						                    if(notifyTo != "")
						                    {
						                        sendmail
						                        (
						                            from : zoho.adminuserid
						                            to : notifyTo
						                            subject : "Engagement letter updated"
						                            message : "Engagement status for " + caseRec.Case_Title + " is now " + caseRec.Engagement_Status
						                        )
						                    }
						                }
						            )
						        }
						    }
						
			}

			Add_Engagement_Letter_On_Validate as "Add Engagement Letter On Validate"
			{
			
						    type = form
						    form = Add_Engagement_Letter
						    record event = on add or edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Letter_Status == "Sent" && input.Engagement_Document == null)
						                {
						                    alert "Engagement Document is required before marking the letter as Sent.";
						                    cancel submit;
						                }
						                if(input.Letter_Status == "Client Signed")
						                {
						                    if(input.Signed_Copy == null || input.Signed_On == null)
						                    {
						                        alert "Signed Copy and Signed On date are required before marking the letter as Client Signed.";
						                        cancel submit;
						                    }
						                }
						                if(input.Retainer_Required == true && ifnull(input.Retainer_Amount,0) <= 0)
						                {
						                    alert "Retainer Amount must be greater than zero when retainer is required.";
						                    cancel submit;
						                }
						            )
						        }
						    }
						
			}

