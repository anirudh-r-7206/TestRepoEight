	reports
	{
		default list All_Approval_Setups
		{
		
				
							displayName = "All Approval Setups"
							show all rows from Add_Approval_Setup    
							(
								Level_Name as "Level Name"
								Approver_Type as "Approver Type"
								Sequence_Order as "Sequence Order"
								Previous_Sequence_Number as "Previous Sequence Number"
								Status
								Approval_Setup_For as "Approval Setup For"
							)
						
				
		}

		default list All_Case_Actions
		{
		
				    displayName = "All Case Actions"
				    show all rows from Add_Case_Action
				    (
				        Case
				        Action_Type
				        From_Status
				        To_Status
				        Action_Date
				        Action_By
				        Notify_Client
				    )
				    filters
				    (
				        Case
				        Action_Type
				        Action_By
				    )
				    sort by
				    (
				        Action_Date descending
				    )
				
		}

		default list All_Case_Documents
		{
		
				    displayName = "All Case Documents"
				    show all rows from Add_Case_Document
				    (
				        Case
				        Document_Type
				        Document_Title
				        Version_Number
				        Document_Status
				        Confidentiality_Level
				        Review_Required
				        Review_Due_Date
				        Visible_To_Client
				        Document_Date
				    )
				    filters
				    (
				        Case
				        Document_Type
				        Document_Status
				        Confidentiality_Level
				        Visible_To_Client
				    )
				    sort by
				    (
				        Document_Date descending
				    )
				
		}

