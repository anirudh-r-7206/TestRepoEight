		            icon = "business-money-time"
		            page Billing_Workspace { icon = "business-money-time" }
		            report all_invoices { icon = "business-money-time" }
		            report Overdue_Invoices { icon = "files-exclamation" }
		            report All_Payments { icon = "business-money-time" }
		            report All_Time_Entries { icon = "files-time" }
		            report All_Expense_Entries { icon = "business-money-time" }
		        }
		        section Client_Access
		        {
		            displayname = "Client Access"
		            icon = "users-multiple-11"
		            page Client_Portal { icon = "users-multiple-11" }
		            report All_Clients { icon = "users-multiple-11" }
		            report All_Client_Contacts { icon = "users-contacts" }
		        }
		        section Compliance
		        {
		            displayname = "Compliance"
		            icon = "business-hammer"
		            page Compliance_Audit_Dashboard { icon = "business-hammer" }
		            report All_Case_History { icon = "files-time" }
		            report Pending_Conflict_Checks { icon = "business-scale" }
		        }
		        section SharedAnalytics_Section
		        {
		            type = shared_user_report_section
		            displayname = "Reports"
		            icon = "business-chart-bar-33"
		        }
		    }
		    preference
		    {
		        icon
		        {
		            style = outline
		            show = {space,section,component}
		        }
		    }
		
	}
	customize
	{
	
		    layout = slidingpane
		    font = "lato"
		    style = "3"
		    color options
		    {
		        name = "Legal Primary"
		        brand color = "#6147E5"
		        type = "custom"
		        dark mode color = "#8B78FF"
		    }
		    logo
		    {
		        preference = "app_icon"
		    }
		
	}
	}

	translation
	{
	{"Language_Settings":{"LANGAGUE_WITH_LOGIN":"browser"}}
	}

	connections
	{
		creator
		(
		
						displayname = "Creator"
						auth per env = true
						connector = zoho_oauth
						permissions = {"ZohoCreator.bulk.CREATE","ZohoCreator.bulk.READ","ZohoCreator.dashboard.READ","ZohoCreator.form.CREATE","ZohoCreator.meta.application.READ","ZohoCreator.meta.form.READ","ZohoCreator.report.CREATE","ZohoCreator.report.DELETE","ZohoCreator.report.READ","ZohoCreator.report.UPDATE"}
					
		)
	}
}
