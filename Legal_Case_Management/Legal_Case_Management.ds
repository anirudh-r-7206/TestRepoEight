 zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No documents uploaded&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Upload pleadings, correspondence, contracts, evidence, or client-visible documents.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;&lt;table class=&quot;zcs-w-full cd-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Document&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Confidentiality&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Client Visible&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each d in docRows\n\t\t\t{\n\t\t\t\tdocTypeName = &quot;&quot;;\n\t\t\t\tif(d.Document_Type != null)\n\t\t\t\t{\n\t\t\t\t\tdt = Add_Document_Type[ID == d.Document_Type];\n\t\t\t\t\tif(dt.count() &gt; 0){docTypeName = ifnull(dt.Document_Type_Name,&quot;&quot;);}\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;cd-main&quot;&gt;&lt;%=ifnull(d.Document_Title,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;cd-sub&quot;&gt;&lt;%=docTypeName%&gt; · &lt;%=ifnull(d.Document_Date,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(d.Document_Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=ifnull(d.Confidentiality_Level,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=if(d.Visible_To_Client == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tfilingRows = Add_Filing[Case == caseRec.ID] sort by Due_Date asc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Filings&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Filing[Case == caseRec.ID].count()%&gt; filings tracked&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Filing?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Filing&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(filingRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No filings&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Track pleadings, motions, evidence filings, responses, and appeals.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relati