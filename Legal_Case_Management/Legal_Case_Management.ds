			Add_Settlement_Offer_On_Load as "Add Settlement Offer On Load"
			{
			
						    type = form
						    form = Add_Settlement_Offer
						    record event = on add or edit
						
						    on load
						    {
						        actions
						        {
						            hide System_Info, Offer_ID;
						            disable Offer_ID;
						        }
						    }
						
			}

			Add_Settlement_Offer_On_Success as "Add Settlement Offer On Success"
			{
			
						    type = form
						    form = Add_Settlement_Offer
						    record event = on add or edit
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                caseRec = Create_Case[ID == input.Case];
						                notifyTo = "";
						                if(caseRec.count() > 0)
						                {
						                    if(caseRec.Case_Status in {"New Intake","Conflict Check","Engagement Pending","Open Matter","Strategy and Pleadings","Discovery and Diligence"})
						                    {
						                        caseRec.Case_Status = "Negotiation and Mediation";
						                    }
						                    if(caseRec.Lead_Attorney != null)
						                    {
						                        leadRec = Add_Employee[ID == caseRec.Lead_Attorney];
						                        if(leadRec.count() > 0)
						                        {
						                            notifyTo = ifnull(leadRec.Email,"");
						                        }
						                    }
						                    if(caseRec.Matter_Manager != null)
						                    {
						                        mgrRec = Add_Employee[ID == caseRec.Matter_Manager];
						                        if(mgrRec.count() > 0 && ifnull(mgrRec.Email,"") != "")
						                        {
						                            if(notifyTo == "")
						                            {
						                                notifyTo = mgrRec.Email;
						                            }
						                            else
						                            {
						                                notifyTo = notifyTo + "," + mgrRec.Email;
						                            }
						                        }
						                    }
						                }
						                insert into Add_Case_History
						                [
						                    Case = input.Case
						                    Event_Date = zoho.currenttime
						                    Event_Type = "Settlement Updated"
						                    Summary = "Settlement offer " + input.Offer_Status + " from " + input.Offered_By
						                    Changed_By = input.Reviewed_By
						                    Source_Record_ID = input.ID
						                ];
						                if(notifyTo != "")
						                {
						                    sendmail
						                    (
						                        from : zoho.adminuserid
						                        to : notifyTo
						                        subject : "Settlement offer updated"
						                        message : "Settlement offer status: " + input.Offer_Status
						                    )
						                }
						            )
						        }
						    }
						
			}

			Add_Settlement_Offer_On_Validate as "Add Settlement Offer On Validate"
			{
			
						    type = form
						    form = Add_Settlement_Offer
						    record event = on add or edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Offer_Status in {"Accepted","Rejected","Withdrawn"} && ifnull(input.Decision_Notes,"") == "")
						                {
						                    alert "Decision Notes are required for accepted, rejected, or withdrawn offers.";
						                    cancel submit;
						                }
						                if(input.Response_Due_Date != null && input.Offer_Date != null && input.Response_Due_Date < input.Offer_Date)
						                {
						                    alert "Response Due Date cannot be before Offer Date.";
						                    cancel submit;
						                }
						            )
						        }
						    }
						
			}

			Add_Time_Entry_Case_On_User_Input as "Case On User Input"
			{
			
						    type = form
						    form = Add_Time_Entry
						    record event = on add or edit
						
						    on user input of Case
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Case != null)
						                {
						                    caseRec = Create_Case[ID == input.Case];
						                    if(caseRec.count() > 0 && caseRec.Fee_Schedule != null)
						                    {
						                        feeRec = Add_Fee_Schedule[ID == caseRec.Fee_Schedule];
						                        if(feeRec.count() > 0)
						                        {
						                            input.Billing_Rate = feeRec.Attorney_Rate;
						                            if(input.Employee != null)
						                            {
						                                empRec = Add_Employee[ID == input.Employee];
						                                if(empRec.count() > 0 && empRec.Role != null)
						                                {
						                                    roleRec = Add_Role[ID == empRec.Role];
						                                    if(roleRec.count() > 0 && ifnull(roleRec.Role,"").contains("Partner"))
						                                    {
						                                        input.Billing_Rate = feeRec.Partner_Rate;
						                                    }
						                                    else if(roleRec.count() > 0 && ifnull(roleRec.Role,"").contains("Paralegal"))
						                                    {
						                                        input.Billing_Rate = feeRec.Paralegal_Rate;
						                                    }
						                                }
						                            }
						                        }
						                    }
						                }
						            )
						        }
						    }
						
			}

