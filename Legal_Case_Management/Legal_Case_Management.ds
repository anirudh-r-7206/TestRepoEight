			string styles.LogoPreviewer()
			{
			
						
						                 	item = Add_Preference[ID != 0];
						                 	if(item.count() != 0)
						                 	{
						                 		style = "<style>.leftInnerDiv{width: 250px;border-radius: 10px;border: 1px solid #cbcbdc;box-sizing: border-box;overflow: hidden;}.innerHeader{font-size: 16px;border-bottom: 1px solid #cbcbdc;padding: 7.5px 10px;box-sizing: border-box;width: 100%;background: #f8f8f8;}.productImage{width: 100%;height: 100%;padding: 10px;box-sizing: border-box;}.productImgTag{width: 100%;height: 100%;object-fit: contain;box-sizing: border-box;}.itemsDiv{width: 100%;height: 140px;display: flex;flex-direction: column;}</style><div class='leftInnerDiv'><div class='innerHeader'>Logo Preview</div><div class='itemsDiv'>";
						                 		if(item.Organization_Logo != "")
						                 		{
						                 			url = "/file" + zoho.appuri + "All_Preferences/" + item.ID + "/Organization_Logo/image-download?filepath=/" + item.Organization_Logo.getSuffix("fieldName/image/").getPrefix("\" lowqual");
						                 		}
						                 		else
						                 		{
						                 			url = "https://files-accl.zohoexternal.com/public/workdrive-external/download/h814669ae0987327a4404804a6236ce5e7438?x-cli-msg=%7B%22linkId%22%3A%226OxchGOzv8B-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D";
						                 		}
						                 		return style + "<div class='productImage'><img alt='Logo Preview'class='productImgTag' src='" + url + "'></div></div></div>";
						                 	}
						                 	return "";
						                 
						
			}

			string styles.New_Table()
			{
			
						
						                 	color_codes = thisapp.styles.ColorCodes();
						                 	style_txt = ".zc-pra-table-wrapper { background-color: " + color_codes.get("zc-pra-white") + "; border: 1px solid " + color_codes.get("zc-pra-border-color") + "; border-radius: 4px; position: relative; overflow: auto; } .zc-pra-table-wrapper table { width: 100%; line-height: normal; border-collapse: collapse; } .zc-pra-table-wrapper table thead { position: sticky; top: 0px; } .zc-pra-table-wrapper table thead tr th, .zc-pra-table-wrapper table tbody tr td { font-size: 14px; line-height: 1.5; letter-spacing: 0.1px; padding: 8px 16px; text-align: left; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-table-wrapper table thead tr th.zc-pra-align-right, .zc-pra-table-wrapper table tbody tr td.zc-pra-align-right { text-align: right; } .zc-pra-table-wrapper table thead tr th.zc-pra-align-center, .zc-pra-table-wrapper table tbody tr td.zc-pra-align-center { text-align: left; } .zc-pra-table-wrapper table thead tr:first-child th { font-weight: 500; background-color: " + color_codes.get("zc-pra-table-header-bg") + "; box-shadow: 0px -1px 0px 0px " + color_codes.get("zc-pra-border-color") + " inset; white-space: nowrap; } .zc-pra-table-wrapper table thead tr.zc-pra-tspace th { background-color: " + color_codes.get("zc-pra-white") + "; padding: 2px; } .zc-pra-table-wrapper table tbody tr td { font-weight: 400; border-top: 1px solid " + color_codes.get("zc-pra-border-color") + "; word-break: break-all; } .zc-pra-table-wrapper table tbody tr.zc-pra-tgroup td { background-color: #F1F2F8; border-top: 1px solid " + color_codes.get("zc-pra-border-color") + " !important; padding: 5px 16px; font-weight: 600; } .zc-pra-table-wrapper table thead tr:first-child th:first-child { border-radius: 3px 0px 0px 0px; } .zc-pra-table-wrapper table thead tr:first-child th:last-child { border-radius: 0px 3px 0px 0px; } .zc-pra-table-wrapper table tbody tr:last-child td:first-child { border-radius: 0px 0px 0px 3px; } .zc-pra-table-wrapper table tbody tr: