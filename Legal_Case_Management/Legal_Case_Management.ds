						                 		card_dom = card_dom + "</li>";
						                 		card_dom = card_dom + "</ul></div></div>";
						                 	}
						                 	else
						                 	{
						                 		card_dom = card_dom + "</div><div class='zc-pra-zcard-content'><ul><li><label>" + common.get('zcp.approvalcard.approver') + "</label><div class='zc-pra-zcard-badge'>";
						                 		card_dom = card_dom + "<span>" + params.get('Approver_Role') + " </span>";
						                 		card_dom = card_dom + "</div></li>";
						                 		card_dom = card_dom + "<li>";
						                 		card_dom = card_dom + "<label>User</label>" + "<span class='zc-pra-color-green'>" + if(params.get('users') == null || params.get('users') == "","Employee Can Choose",params.get('users')) + "</span>";
						                 		card_dom = card_dom + "</li>";
						                 		card_dom = card_dom + "</ul></div></div>";
						                 		// 		card_dom = card_dom + "</div><div class='zc-pra-zcard-content'><ul>";
						                 		// 		card_dom = card_dom + "<li>";
						                 		// 		card_dom = card_dom + "<label>" + common.get('zcp.approvalcard.approver') + "</label>" + "<span class='zc-pra-color-green'>" + params.get('Approver_Role') + "</span>";
						                 		// 		card_dom = card_dom + "</li>";
						                 		// 		card_dom = card_dom + "</ul></div></div>";
						                 	}
						                 	if(params.get("Is_Preview") == false || params.get("Is_Preview") == null)
						                 	{
						                 		card_dom = card_dom + "<div class='zc-pra-add-card zc-pra-flt-left'><a href='#Form:Add_Approval_Setup?Designation=" + params.get('Type_field') + "&Approval_Template=" + params.get("Template_ID") + "&Previous_Sequence_Number=" + params.get('Previous_Sequence_Number') + "&Requester=" + params.get('Requester_Role_Param') + "&Sequence_Order=" + params.get('Sequence_Order') + "&Add_Type=Specific&zc_LoadIn=dialog'><i class='zc-li-outline ui-1-simple-add'></i></a></div>";
						                 	}
						                 	else
						                 	{
						                 		card_dom = card_dom + "<div class='zc-pra-add-card zc-pra-flt-left'></div>";
						                 	}
						                 	card_dom = card_dom + "</li>";
						                 	return card_dom;
						                 
						
			}

			string ImportantFunctions.getImageURL(string img, string imgFieldLinkName, string reportName, int recID)
			{
			
						
						                 	if(input.img != "")
						                 	{
						                 		if(input.img.contains("lowqual"))
						                 		{
						                 			imagefile = input.img.getSuffix("fieldName/image/").getPrefix("\" lowqual");
						                 			return "/file" + zoho.appuri + input.reportName + "/" + input.recID + "/" + input.imgFieldLinkName + "/image-download?filepath=/" + imagefile;
						                 		}
						                 		else
						                 		{
						                 			return input.img.getSuffix("src = \"").getprefix("\" border");
						                 		}
						                 	}
						                 	else
						                 	{
						                 		return "https://sm.pcmag.com/pcmag_me/review/z/zoho-creat/zoho-creator_1vtu.png";
						                 	}
						                 
						
			}

			string ImportantFunctions.getLogo()
			{
			
						
						                 	fetchPref = Add_Preference[ID != null];
						                 	if(fetchPref.count() != 0)
						                 	{
						                 		if(fetchPref.Organization_Logo == "")
						                 		{
						                 			respImage = invokeurl
						                 			[
						                 				url :"https://www.zohowebstatic.com/sites/zweb/images/productlogos/creator.svg"
						                 				type :GET
						                 			];
						                 			respImage.setParamName("file");
						                 			respImage.setFileName("Creator_Logo.svg");
						                 			resp = invokeurl
						                 			[
						                 				url :"https://www.zohoapis.com/creator/v2.1/data/zc_poc/company-name-app-category-poc-id/report/All_Preferences/" + fetchPref.ID + "/Organization_Logo/upload"
						                 				type :POST
						                 				files:respImage
						                 				connection:"creator"
						                 			];
						                 		}
						                 		returnImage = thisapp.ImportantFunctions.getImageURL(fetchPref.Organization_Logo,"Organization_Logo","All_Preferences",fetchPref.ID);
						                 	}
						                 	else
						                 	{
						                 		insert into Add_Preference
						                 		[
						                 			Added_User=zoho.loginuser
						                 		]
						                 		returnImage = "https://www.zohowebstatic.com/sites/zweb/images/productlogos/creator.svg";
						                 	}
						                 	return returnImage;
						                 
						
			}

			string ImportantFunctions.getSignatureURL(string SignatureName, int recID, string fieldLinkName, string reportName, string publicLink)
			{
			
						
						                 	if(input.SignatureName != "")
						                 	{
