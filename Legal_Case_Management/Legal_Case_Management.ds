	pages
	{
		page All_Approval_Setup
		{
					displayname = "All Approval Setup"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet31' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet31()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css&quot; /&gt;\n\n&lt;style&gt;\n\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n\t\tbox-sizing: border-box;\n\t\t }\n\t div::-webkit-scrollbar, table::-webkit-scrollbar, tr::-webkit-scrollbar, th::-webkit-scrollbar, td::-webkit-scrollbar, ul::-webkit-scrollbar, li::-webkit-scrollbar, a::-webkit-scrollbar, form::-webkit-scrollbar, input::-webkit-scrollbar {\n\t\t display: none;\n\t}\n\tdiv, table, tr, th, td, ul, li, a, form, input {\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none; \n\t}\n\t.zc-pb-embed-placeholder-content {\n\t\toverflow: hidden;\n\t}\n\t.zc-header .header_top_bar {\n\t\theight: 66px !important;\n\t}\n\tdiv#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{\n\t\theight: 100% !important;\n\t\tborder: unset !important;\n\t}\n\t.zc_live_adminbar .zc-container-wrapper {\n\t\theight:100% !important;\n\t}\n\t.Layout.elemContainment {\n\t\tpadding: unset !important;\n\t}\n.zc_live_adminbar .zc-container-wrapper {\n\t\theight: 100% !important;\n\t}\n:root {\n\t--primary-color: #467eee;\n}\n\n/* ===== LAYOUT ===== */\n.innerMainDiv {\n\twidth: 100%;\n\theight: 100%;\n}\n.boxContainer {\n\twidth: 100%;\n\theight: 100%;\n\tdisplay: flex;\n\tflex-direction: column;\n\tborder-radius: 10px;\n\t/*border: 1px solid #ededed;*/\n\tbackground: #fff;\n\toverflow: hidden;\n}\n.boxHeader {\n\tbackground: #ffffff;\n\theight: 50px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 0 20px;\n\tfont-weight: 600;\n\tcolor: #000;\n\tborder-bottom: 1px solid #ededed;\n}\n.boxHeader a {\n\ttext-decoration: none;\n\tbackground: var(--primary-color);\n\tcolor: #fff;\n\tpadding: 8px 16px;\n\tborder-radius: 8px;\n\tfont-weight: 500;\n\tfont-size: 14px;\n\ttransition: all 0.3s ease;\n}\n.boxHeader a:hover {\n\tbackground: var(--menu_selected_hover_bg_color);\n}\n.boxContent {\n\tflex: 1;\n\tpadding: 20px;\n\toverflow: auto;\n\tdisplay: flex;\n\tgap: 20px;\n\twidth: 100%;\n\theight: 100%;\n\tflex-wrap: wrap;\n\t\n\talign-content: flex-start;\n}\n\n/* ===== MAIL TEMPLATE CARDS ===== */\n.mail-preview &gt; div:first-child,\n.mail-preview &gt; div:last-child {\n\t\tdisplay: none !important;\n}\n.mail-card {\n\tbackground: #f8f8f8;\n\t\tborder: 1px solid #ededed;\n\t\tborder-radius: 16px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\tmax-width: 50%;\n\t\twidth: 300px;\n\t\tvertical-align: top;\n\t\ttransition: all 0.3s ease;\n\toverflow: hidden;\n}\n.mail-card:hover {\n\tbackground: #eeebfa;\n}\n\n/* Dashed separator after each card */\n.mail-card:not(:last-child)::after {\n\tcontent: &quot;&quot;;\n\tposition: absolute;\n\ttop: 10px;\n\tright: -10px;\n\twidth: 1px;\n\theight: 95%;\n\t/*border-right: 2px dashed #ccc;*/\n}\n\n/* Header Section */\n.card-header {\n\tpadding: 15px 20px;\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: flex-start;\n\t\n}\n.card-header .subject {\n\tfont-size: 16px;\n\t\tfont-weight: 600;\n\t\tcolor: #6147e5;\n\tword-break: break-word;\n\twhite-space: nowrap;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n}\n.card-header .options-container {\n\tposition: relative;\n\t    transform: rotate(90deg);\n}\n.options-toggle {\n\tbackground: none;\n\tborder: none;\n\tfont-size: 18px;\n\tcolor: #a0aec0;\n\tcursor: pointer;\n}\n.options-menu {\n\tposition: absolute;\n\ttop: 100%;\n\tright: 0;\n\tbackground: #fff;\n\tborder-radius: 10px;\n\tbox-shadow: 0 10px 30px rgba(0,0,0,0.15);\n\twidth: 180px;\n\tdisplay: none;\n\tborder: 1px solid #e2e8f0;\n\tz-index: 5;\n}\n.options-menu a {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tpadding: 12px 15px;\n\ttext-decoration: none;\n\tcolor: #4a5568;\n\tfont-size: 14px;\n\ttransition: 0.2s;\n}\n.options-menu a:hover {\n\tbackground: #f7fafc;\n\tcolor: var(--primary-color);\n}\n.options-toggle:focus + .options-menu,\n.options-menu:hover {\n\tdisplay: block;\n}\n\n/* Body Section */\n.mail-card:hover .card-body{\n\t\tbackground: #eeebfa;\n}\n.card-body {\n\tpadding: 15px 20px;\n\toverflow: hidden;\n\tdisplay: flex;\n\theight: calc(100% - 53px);\n\tflex-direction: column;\n\tjustify-content: space-between;\n\tbackground: #ffffff;\n}\n.mail-preview {\n\tfont-size: 14px;\n\t\tcolor: #4a5568;\n\t\tline-height: 1.6;\n\t\tword-wrap: break-word;\n\t\theight: calc(100% - 39px);\n\t\toverflow: auto;\n}\n.mail-meta {\n\tmargin-top: 12px;\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tflex-wrap: wrap;\n\t\tgap: 6px;\n}\n.mail-to {\n\tfont-size: 13px;\n\tcolor: #718096;\n\tfont-weight: 500;\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 6px;\n}\n.mail-to i {\n\tcolor: var(--primary-color);\n}\n.status-badge {\n\tpadding: 6px 12px;\n\tborder-radius: 20px;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\ttext-transform: uppercase;\n}\n.status-active {\n\tbackground: #d1fae5;\n\tcolor: #065f46;\n}\n.status-inactive {\n\tbackground: #fee2e2;\n\tcolor: #991b1b;\n}\n\n/* Empty State */\n.noDetailDiv {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 100%;\n\tcolor: #626262;\n\tfont-weight: 500;\n\twidth: 100%;\n}\n@media (max-width:768px){\n\t.mail-card {\n\t\twidth: 90%;\n\t\tmin-width: 90%;\n\t}\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;innerMainDiv&quot;&gt;\n\t&lt;div class=&quot;boxContainer&quot;&gt;\n\t\t&lt;div class=&quot;boxHeader&quot;&gt;\n\t\t\t&lt;div&gt;All Approval Setup&lt;/div&gt;\n\t\t\t&lt;a href=&quot;#Form:Add_Approval_Setup?zc_LoadIn=dialog&amp;zc_Header=false&amp;zc_NextUrl=#Script:page.refresh&quot;&gt;+ Add Approval Setup&lt;/a&gt;\n\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;boxContent&quot;&gt;\n&lt;%\n\tfetchSalesOrder = Add_Approval_Setup[Approval_Setup_For != null];\n\tif(fetchSalesOrder.count() != 0)\n\t{\n\t\tfetchSalesOrder1 = Add_Approval_Setup[ID != null].distinct(Approval_Setup_For);\n\t\tfor each  rec in fetchSalesOrder1\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;mail-card&quot;&gt;\n\t\t\t&lt;a class=&quot;card-header&quot; href=&quot;#Page:Approval_Setup?zc_LoadIn=embed-embedDiv&amp;recID=&lt;%=rec%&gt;&quot;&gt;\n\t  &lt;div class=&quot;subject&quot;&gt;&lt;%=Approval_Setup_For[ID == rec].Approval_Setup_For%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;options-container&quot;&gt;\n\t\t\t\t\t&lt;button class=&quot;options-toggle&quot;&gt;&lt;i class=&quot;fas fa-ellipsis-v&quot;&gt;&lt;/i&gt;&lt;/button&gt;\n\t\t\t\t\t\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t \n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n/*.zc-content-loader div {\n display: none !important;\n}*/\n\t.main_container_img {\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tdisplay: flex;\n\t\t\t\tjustify-content: center;\n\t\t\t\talign-items: center;\n\t\t\t\tpadding: 15px;\n\t\t}\n\t.img_c {\n\t\t\t\tanimation: fadeInZoom 0.2s ease-in-out forwards;\n\t\t\t\tobject-fit: contain;\n\t\t\t\twidth: 10%;\n\t\t}\n\t\t&lt;/style&gt;\n&lt;div class=&quot;main_container_img&quot;&gt;\n&lt;div style=&quot;display: flex ; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-content: center; align-items: center;&quot;&gt;\n\t\t&lt;img class=&quot;img_c&quot; src=&quot;https://files-accl.zohoexternal.com/public/workdrive-external/download/c4yc5f4e45a3a037f4ceeb726dfdca8d7e886?x-cli-msg=%7B%22linkId%22%3A%226OxchGZlnBc-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D&quot;&gt;\n\t&lt;div style=&quot;color: #2f305d; font-weight:600;&quot;&gt; No Data Available&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page All_Mail_Templates(string recID)
