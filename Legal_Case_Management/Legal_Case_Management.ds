		form Add_Employee
		{
		
				
							displayname = "Add Employee"
							success message = "Employee Added Successfully"
							Section_Basic_Details
							(
								type = section
								displayname = "Basic Details"
					 			row = 1
					 			column = 0   
								width = medium
							)
							Employee_Name
							(
				    			type = name
								displayname = "Employee Name"
				     			prefix
				     			(
					     			 type = prefix
					     			 displayname ="Prefix"
					     			 visibility = false
					     			 value = {"Mr.","Mrs.","Ms."}
				     			) 
				     			first_name
				     			(
					     			 type = first_name
					     			 displayname ="First Name"
				     			) 
				     			last_name
				     			(
					     			 type = last_name
					     			 displayname ="Last Name"
				     			) 
				     			suffix
				     			(
					     			 type = suffix
					     			 displayname ="Suffix"
					     			 visibility = false
				     			) 
					 			row = 1
					 			column = 1   
								width = medium
								personal data = true
							)
							must have unique Employee_ID
							(
				    			type = text
								displayname = "Employee ID"
					 			row = 1
					 			column = 1   
								width = medium
							)
							Gender
							(
								type = radiobuttons
								maxchar = 100
								values = {"Male","Female"}
								layout = 2
					 			row = 1
					 			column = 1   
								width = medium
							)
							Date_of_Birth
							(
				    			type = date
								displayname = "Date of Birth"
								alloweddays = 0,1,2,3,4,5,6
					 			row = 1
					 			column = 1   
								width = medium
							)
							Email
							(
				    			type = email
					 			row = 1
					 			column = 1   
								width = medium
							)
							Phone
							(
				    			type = phonenumber
								displayname = "Mobile Number"
					 			row = 1
					 			column = 1   
								width = medium
							)
							Profile_Image
							(
				    			type = image
								displayname = "Profile Image"
								source  = file
								aspect ratio = original
								camera = primary
								show gallery = true
								switch camera = true
					 			row = 1
					 			column = 1   
								width = medium
							)
							Role
							(
								type = picklist	
								values  = Add_Role.ID
				    			displayformat = [Role]
								sortorder = ascending
					 			row = 1
					 			column = 1   
								width = medium
							)
							Reporting_Manager
							(
								type = picklist	
								displayname = "Reporting Manager"
								values  = Add_Employee.ID
				    			displayformat = [" " + Employee_Name.prefix + " " + Employee_Name.first_name + " " + Employee_Name.last_name + " " + Employee_Name.suffix]
								sortorder = ascending
					 			row = 1
					 			column = 1   
								width = medium
							)
					
							actions
							{
								on add
								{
									submit
									(
				   						type = submit
				   						displayname = "Add"
									)
								}
								on edit
								{
									update
									(
				   						type = submit
				   						displayname = "Update"
									)
									cancel
									(
				   						type = cancel
				   						displayname = "Cancel"
									)
								}
							}
						
				
		}

