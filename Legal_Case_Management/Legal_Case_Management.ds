8&quot;&gt;&lt;%=ifnull(n.Communication_DateTime,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;%=if(n.Visible_To_Client == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tevidenceRows = Add_Evidence[Case == caseRec.ID] sort by Collected_On desc range from 1 to 20;\n%&gt;\n\t\t\t&lt;div class=&quot;cd-related&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cd-card-header&quot;&gt;&lt;div class=&quot;cd-card-title&quot;&gt;&lt;h2&gt;Evidence&lt;/h2&gt;&lt;p&gt;&lt;%=Add_Evidence[Case == caseRec.ID].count()%&gt; evidence records&lt;/p&gt;&lt;/div&gt;&lt;div class=&quot;cd-section-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Add_Evidence?Case=&lt;%=caseRec.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Evidence&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cd-scroll&quot;&gt;\n&lt;%\n\t\tif(evidenceRows.count() == 0)\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No evidence&lt;/h5&gt;&lt;p class=&quot;cd-empty-text&quot;&gt;Add evidence with source, custodian, files, and chain-of-custody notes.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-round