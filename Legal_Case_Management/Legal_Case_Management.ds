						                 	return style_txt;
						                 
						
			}

			string PageStyles.Preferences_Report_Filter()
			{
			
						
						                 	common = thisapp.Localization.Common();
						                 	add_txt = common.get("zcp.add");
						                 	style_txt = thisapp.styles.Filter() + ".zc-pb-embed-placeholder-content .zc-pra-setup .divEmbedContainer.zc-pra-filter { height: 68px !important; overflow: hidden; position: absolute; z-index: 1; right: 146px; } /* No data style */ .zc-pra-setup .view-outer-wrapper .reportfullwidth .nodata { height: 100%; position: static; transform: none; display: flex; flex-direction: row; align-items: center; justify-content: center; } .zc-pra-setup .nodata .no_record_subtext { font-size: 0px; } .zc-pra-setup .nodata .no_record_subtext:before { content: '" + common.get("zcp.nodataavailable") + "'; font-size: 20px; } .zc-pra-setup .nodata .zc-live-primary-btn.btn-big { position: absolute; top: -52px; right: 15px; /* z-index: 999; */ font-size: 0px; padding: 0px 20px; border-radius: 4px; } .zc-pra-setup .nodata .zc-live-primary-btn.btn-big:before, .zc-pra-setup .nodata .zc-live-primary-btn.btn-big:after { display: inline-block; vertical-align: top; } .zc-pra-setup .nodata .zc-live-primary-btn.btn-big:before { content: '\ed29'; font: normal normal normal 14px / 36px 'ZC Live Outline'; font-size: 12px; font-weight: 600; margin-right: 8px; } .zc-pra-setup .nodata .zc-live-primary-btn.btn-big:after { content: '" + add_txt + "'; font-size: 14px; line-height: 36px; font-weight: 400; } .zc-pra-setup .nodata .zc-importdata-report, .zc-pra-setup .nodata span { display: none; }";
						                 	rtl_txt = ".zc-rtl-wrapper .zc-pb-embed-placeholder-content .zc-pra-setup .divEmbedContainer.zc-pra-filter { right: auto; left: 146px; } .zc-rtl-wrapper .zc-pra-setup .nodata .zc-live-primary-btn.btn-big { right: auto; left: 15px; } .zc-rtl-wrapper .zc-pra-setup .nodata .zc-live-primary-btn.btn-big:before { margin-right: 0px; margin-left: 8px; }";
						                 	style_txt = style_txt + rtl_txt;
						                 	return style_txt;
						                 
						
			}

			string PageStyles.Setup(string tab)
			{
			
						
						                 	color_codes = thisapp.styles.ColorCodes();
						                 	common = thisapp.Localization.Common();
						                 	if(tab == "brands")
						                 	{
						                 		txt = "Brand";
						                 	}
						                 	if(tab == "categories")
						                 	{
						                 		txt = "Category";
						                 	}
						                 	style_txt = thisapp.styles.Vertical_Tab() + thisapp.styles.Report_Header_Customization() + thisapp.styles.Custom_Layout() + ".zc-pra-setup .zc-pra-page-container-inner { padding: 30px; } .zc-pra-setup .zc-pra-page-header { padding: 20px; border-bottom: 1px solid " + color_codes.get("zc-pra-border-color") + "; } .zc-pra-setup .zc-pra-page-header p { font-size: 14px; font-weight: 400; line-height: 21px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 3px; } .zc-pra-setup .zc-pra-page-content { height: calc(100% - 87px); } .zc-pra-setup .zc-pra-vertical-tabbody { border-radius: 0px 0px 12px 0px; } .zc-pra-setup .divEmbedContainer { height: 100% !important; overflow: auto; } .zc-pra-setup /*.email-templates*/ .zc-qv-custom-layout:hover .zc-pb-tile-cnt-wrapper .zc-qv-custom-layout-more+.zcp-row>.zcp-col { background-color: " + color_codes.get("zc-pra-white") + " !important; } /* Form */ .zc-pra-setup .divEmbedContainer .zc-form-fullheight form { width: 100%; } .zc-pra-setup .divEmbedContainer form .form-header { display: inline-block; vertical-align: top; width: 100%; } /* Report */ .zc-pra-setup .zc-reporttype-list { padding: 0px 30px 20px; } .zc-pra-setup .zc-reporttype-list .list-view-inner { background-color: " + color_codes.get("zc-pra-white") + "; border: 1px solid " + color_codes.get("zc-pra-border-color") + "; border-radius: 12px; } .locations .zc-design-switch .zc-pra-setup .zc-reporttype-list .list-view-inner .handsontable .wtHolder .wtHider .htCore thead th { border-top-width: 0px !important; } /* Location */.zc-pra-page-container .locations .view-header .zc-add-record:after { content: '" + common.get("zcp.newlocation") + "'; } /* Email Template */ .zc-pra-setup .group-record-title { font-size: 16px; font-weight: 400; line-height: 1.3; border-bottom-color: " + color_codes.get("zc-pra-border-color") + "; margin: 0px 30px 30px; } .zc-pra-setup .email-templates .zc-qv-custom-layout:hover .zc-pb-tile-cnt-wrapper i.arrows-2-small-right { color: var(--theme_brand_color); }";
						                 	custom_style_rtl = ".zc-rtl-wrapper .zc-qv-custom-layout-more { left: 0px; right: auto; } /* Location */ .zc-rtl-wrapper .locations .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row>.zcp-col { text-align: right !important; } .zc-rtl-wrapper .locations .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row:nth-child(3)>.zcp-col:nth-child(2) { text-align: left !important; } .zc-rtl-wrapper .locations .maplink { margin-left: 4px; } /* Department, Category, Brand */ .zc-rtl-wrapper .categories .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col { text-align: right !important; } .zc-rtl-wrapper .departments .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col { text-align: right !important; } .zc-rtl-wrapper .brands .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col { text-align: right !important; } .zpelement-wrapper .categories .zc-qv-custom-layout:hover .zc-pb-tile-cnt-wrapper .zc-qv-custom-layout-more { opacity: 1; visibility: visible; } /* Email template */ .zc-rtl-wrapper .email-templates .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row>.zcp-col:nth-child(1) { text-align: right !important; } .zc-rtl-wrapper .email-templates .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row>.zcp-col:nth-child(2) { transform: rotate(180deg); }";
						                 	rtl_txt = ".zc-rtl-wrapper .zc-pra-setup .zc-pra-vertical-tabbody { border-radius: 0px 0px 0px 12px; }";
						                 	style_txt = style_txt + custom_style_rtl + rtl_txt + thisapp.PopupStyles.Info_Msg_Creator(txt);
						                 	return style_txt;
						                 
						
			}

			string PopupStyles.DeletePopup()
			{
			
						
						                 	color_codes = thisapp.styles.ColorCodes();
						                 	common_style = thisapp.PopupStyles.Popup();
						                 	override_style = "/* Btn styles */ .zc-footer-wrapper .form-action .zc-live-primary-btn { border: 1px solid " + color_codes.get("zc-pra-red") + "; background-color: " + color_codes.get("zc-pra-red") + "; color: " + color_codes.get("zc-pra-white") + " }";
						                 	popup_style = ".zc-pra-popup-content.zc-pra-inactive-popup .zc-pra-icon-wrapper { background-color: " + color_codes.get("zc-pra-bg_red") + "; color: " + color_codes.get("zc-pra-red") + ";}";
						                 	style_txt = "<style>" + common_style + override_style + popup_style + "</style>";
						                 	return style_txt;
						                 
						
			}

			string PopupStyles.Info_Msg_Creator(String form)
			{
			
						
						                 	common = thisapp.Localization.Common();
						                 	color_codes = thisapp.styles.ColorCodes();
						                 	style_txt = ".popupboxOuter.info-popup .popupConentContainer .infoMsg { padding: 20px; } .zcpopup .popupbox-wrapper .infoMsg i { padding: 0px; margin: 20px; } .zcpopup .popupbox-wrapper .infoMsg i:before { content: '\ed95'; font: normal normal normal 40px / 1 'ZC Live Outline'; color: " + color_codes.get("zc-pra-red") + "; } .zcpopup .popupbox-wrapper .infoMsg span, .zcpopup .popupbox-wrapper .infoMsg span.msgtoshow:before { font-size: 0px !important; } .zcpopup .popupbox-wrapper .infoMsg span:before { content: '" + form + " " + common.get("zcp.deletionfailed") + "'; font-size: 18px !important; font-weight: 500 !important; line-height: 1.3; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; padding: 0; } .zcpopup .popupbox-wrapper .infoMsg span.msgtoshow { font-size: 14px !important; font-weight: 400 !important; line-height: 1.5; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 12px; } .zcpopup .popupbox-wrapper .infoMsg .zc-errdetailsdiv.handsontable { display: none; }";
						                 	return style_txt;
						                 
						
			}

			string PopupStyles.Popup()
			{
			
						
						                 	color_codes = thisapp.styles.ColorCodes();
						                 	override_style = ".zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .form-outer-wrapper form .formContainer { padding: 20px 30px; } .zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .form-outer-wrapper form .zc-footer-wrapper .formbutton { padding: 16px; text-align: center; } .zcpopup .statelessFormWidth .form-action .zc-live-primary-btn { padding: 8px 20px; margin: 0px; } .zcpopup.compact .form-outer-wrapper form.form-table,  .zcpopup.compact .form-outer-wrapper form.form-table .zc-addnote-fld { width: 100%; } .zcpopup .form-group { margin-bottom: 0px; }";
						                 	common_style = ".zc-pra-popup-content { padding: 20px; text-align: center; } .zc-pra-popup-content .zc-pra-icon-wrapper { width: 48px; height: 48px; border-radius: 50%; text-align: center; display: inline-block; vertical-align: top; } .zc-pra-popup-content .zc-pra-icon-wrapper i { font-size: 24px; line-height: 48px; font-style: normal; } .zc-pra-popup-content h4 { font-size: 18px; font-weight: 500; line-height: 1.3; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; margin: 16px 0px 12px; } .zc-pra-popup-content p { font-size: 14px; font-weight: 400; line-height: 1.5; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; }";
						                 	style_txt = override_style + common_style;
						                 	return style_txt;
						                 
						
			}

			string decisionBoxStyle.getDecisionBoxButtonStyle(string type, string fieldLinkName, string btnBgClr, string hoverClr)
			{
			
						
						                 	if(type = "All")
						                 	{
						                 		return "<style>..customCheckbox:checked+label{background: none; border: none;} .decision-box-field .customCheckbox+label { width: 80px; height: 36px; border-radius: 7px; border: none !important; background: " + btnBgClr + "; top: -8px; position: relative; box-shadow: none !important;} label.form-label.decision-box-label { color: #ffffff !important;margin: 0 !important; padding: 0 !important; width: 80px !important; !important;text-align: center !important;} .customCheckbox:checked+label:after{display:none;} .decision-box-field .customCheckbox+label:hover {background: " + hoverClr + ";} input.customCheckbox.zc_decisionbox[readonly]+label.zc_decision_box_label { opacity: 0.6 !important;}</style>";
						                 	}
						                 	else if(type = "Individual")
						                 	{
						                 		return "<style>.zc-" + fieldLinkName + "-group .customCheckbox:checked+label{background: none; border: none;}.zc-" + fieldLinkName + "-group .decision-box-field .customCheckbox+label { width: 80px; height: 36px; border-radius: 7px; border: none !important; background: " + btnBgClr + "; top: -8px; position: relative; box-shadow: none !important;} .zc-" + fieldLinkName + "-group label.form-label.decision-box-label { color: #ffffff !important;margin: 0 !important; padding: 0 !important; width: 80px !important; !important; text-align: center !important;} .zc-" + fieldLinkName + "-group .customCheckbox:checked+label:after{display:none;} .zc-" + fieldLinkName + "-group .decision-box-field .customCheckbox+label:hover {background: " + hoverClr + ";} input.customCheckbox.zc_decisionbox[readonly]+label.zc_decision_box_label { opacity: 0.6 !important;}</style>";
						                 	}
						                 	return "";
						                 
						
			}

			string decisionBoxStyle.getDecisionBoxToggleBtnStyle(string type, string fieldLinkName, string checkedBgClr, String uncheckedBgClr)
			{
			
						
						                 	if(type = "All")
						                 	{
						                 		return "<style>.zc-decisionbox-field-group label.zc_decision_box_label { cursor: pointer; background-color: " + uncheckedBgClr + "; transition: 0.4s; border-radius: 30px; width: 50px; height: 25px; outline: none; border: none !important; box-shadow: none !important; display: flex; align-items: center; padding: 5px; box-sizing: border-box;} label.zc_decision_box_label:before { display: flex; content: \"\"; height: 15px; width: 15px; background-color: white; transition: 0.4s !important; border-radius: 50%; } .customCheckbox:checked+ label.zc_decision_box_label { background: " + checkedBgClr + "; } .customCheckbox:checked+ label.zc_decision_box_label:before { transform: translateX(25px); } .customCheckbox:checked+label.zc_decision_box_label:after { display: none; }  label.form-label.decision-box-label { margin-left: 60px !important; display: flex; align-items: center; height: 25px; }</style>";
						                 	}
						                 	else if(type = "Individual")
						                 	{
						                 		return "<style>.zc-" + fieldLinkName + "-group label.zc_decision_box_label { cursor: pointer; background-color: " + uncheckedBgClr + "; transition: 0.4s; border-radius: 30px; width: 50px; height: 25px; outline: none; border: none !important; box-shadow: none !important; display: flex; align-items: center; padding: 5px; box-sizing: border-box;} .zc-" + fieldLinkName + "-group label.zc_decision_box_label:before { display: flex; content: \"\"; height: 15px; width: 15px; background-color: white; transition: 0.4s !important; border-radius: 50%; } .zc-" + fieldLinkName + "-group .customCheckbox:checked+ label.zc_decision_box_label { background: " + checkedBgClr + "; } .zc-" + fieldLinkName + "-group .customCheckbox:checked+ label.zc_decision_box_label:before { transform: translateX(25px); } .zc-" + fieldLinkName + "-group .customCheckbox:checked+label.zc_decision_box_label:after { display: none; } .zc-" + fieldLinkName + "-group label.form-label.decision-box-label { margin-left: 60px !important; display: flex; align-items: center; height: 25px; }</style>";
						                 	}
						                 	return "";
						                 
						
			}

			string decisionBoxStyle.getRefreshBtnStyle(string type, string fieldLinkName, string refreshImgUrl)
			{
			
						
						                 	if(type == "All")
						                 	{
						                 		return "<style> label.zc_decision_box_label { cursor: pointer; border:none; background-color: #ffffff; transition: 0.4s; width: 30px; height: 30px; outline: none; box-shadow: none !important; display: flex; align-items: center; padding: 5px; background-image:url('" + refreshImgUrl + "'); background-size:100% 100%; } .customCheckbox:checked + label.zc_decision_box_label { transform: rotate(360deg);} .customCheckbox:not(:checked) + label.zc_decision_box_label { transition:0s; transform: rotate(0deg);} label.form-label.decision-box-label {margin-left: 60px !important; display: none; align-items: center; height: 25px;  } #zc-" + fieldLinkName + "-helpText{margin-left:35px !important; margin-top:-2px; font-size:15px;} .customCheckbox:checked+label:after{display:none !important; } </style>";
						                 	}
						                 	else if(type == "Individual")
						                 	{
						                 		return "<style>.zc-" + fieldLinkName + "-group label.zc_decision_box_label { cursor: pointer; border:none; background-color: #ffffff; transition: 0.4s; width: 30px; height: 30px; outline: none; box-shadow: none !important; display: flex; align-items: center; padding: 5px; background-image:url('" + refreshImgUrl + "'); background-size:100% 100%; } .zc-" + fieldLinkName + "-group .customCheckbox:checked + label.zc_decision_box_label { transform: rotate(360deg);} .zc-" + fieldLinkName + "-group .customCheckbox:not(:checked) + label.zc_decision_box_label { transition:0s; transform: rotate(0deg);} .zc-" + fieldLinkName + "-group label.form-label.decision-box-label {margin-left: 60px !important; display: none; align-items: center; height: 25px;  } #zc-" + fieldLinkName + "-helpText{margin-left:35px !important; margin-top:-2px; font-size:15px;} .zc-" + fieldLinkName + "-group .customCheckbox:checked+label:after{display:none !important; } </style>";
						                 	}
						                 	return "";
						                 
						
			}

