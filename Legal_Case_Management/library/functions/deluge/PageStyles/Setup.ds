string PageStyles.Setup(string tab)
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	common = thisapp.Localization.Common();
			                 	if(tab == "brands")
			                 	{
			                 		txt = "Brand";
			                 	}
			                 	if(tab == "categories")
			                 	{
			                 		txt = "Category";
			                 	}
			                 	style_txt = thisapp.styles.Vertical_Tab() + thisapp.styles.Report_Header_Customization() + thisapp.styles.Custom_Layout() + ".zc-pra-setup .zc-pra-page-container-inner { padding: 30px; } .zc-pra-setup .zc-pra-page-header { padding: 20px; border-bottom: 1px solid " + color_codes.get("zc-pra-border-color") + "; } .zc-pra-setup .zc-pra-page-header p { font-size: 14px; font-weight: 400; line-height: 21px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 3px; } .zc-pra-setup .zc-pra-page-content { height: calc(100% - 87px); } .zc-pra-setup .zc-pra-vertical-tabbody { border-radius: 0px 0px 12px 0px; } .zc-pra-setup .divEmbedContainer { height: 100% !important; overflow: auto; } .zc-pra-setup /*.email-templates*/ .zc-qv-custom-layout:hover .zc-pb-tile-cnt-wrapper .zc-qv-custom-layout-more+.zcp-row>.zcp-col { background-color: " + color_codes.get("zc-pra-white") + " !important; } /* Form */ .zc-pra-setup .divEmbedContainer .zc-form-fullheight form { width: 100%; } .zc-pra-setup .divEmbedContainer form .form-header { display: inline-block; vertical-align: top; width: 100%; } /* Report */ .zc-pra-setup .zc-reporttype-list { padding: 0px 30px 20px; } .zc-pra-setup .zc-reporttype-list .list-view-inner { background-color: " + color_codes.get("zc-pra-white") + "; border: 1px solid " + color_codes.get("zc-pra-border-color") + "; border-radius: 12px; } .locations .zc-design-switch .zc-pra-setup .zc-reporttype-list .list-view-inner .handsontable .wtHolder .wtHider .htCore thead th { border-top-width: 0px !important; } /* Location */.zc-pra-page-container .locations .view-header .zc-add-record:after { content: '" + common.get("zcp.newlocation") + "'; } /* Email Template */ .zc-pra-setup .group-record-title { font-size: 16px; font-weight: 400; line-height: 1.3; border-bottom-color: " + color_codes.get("zc-pra-border-color") + "; margin: 0px 30px 30px; } .zc-pra-setup .email-templates .zc-qv-custom-layout:hover .zc-pb-tile-cnt-wrapper i.arrows-2-small-right { color: var(--theme_brand_color); }";
			                 	custom_style_rtl = ".zc-rtl-wrapper .zc-qv-custom-layout-more { left: 0px; right: auto; } /* Location */ .zc-rtl-wrapper .locations .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row>.zcp-col { text-align: right !important; } .zc-rtl-wrapper .locations .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row:nth-child(3)>.zcp-col:nth-child(2) { text-align: left !important; } .zc-rtl-wrapper .locations .maplink { margin-left: 4px; } /* Department, Category, Brand */ .zc-rtl-wrapper .categories .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col { text-align: right !important; } .zc-rtl-wrapper .departments .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col { text-align: right !important; } .zc-rtl-wrapper .brands .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col { text-align: right !important; } .zpelement-wrapper .categories .zc-qv-custom-layout:hover .zc-pb-tile-cnt-wrapper .zc-qv-custom-layout-more { opacity: 1; visibility: visible; } /* Email template */ .zc-rtl-wrapper .email-templates .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row>.zcp-col:nth-child(1) { text-align: right !important; } .zc-rtl-wrapper .email-templates .zc-qv-custom-layout .zc-pb-tile-card .zcp-panel-wrapper>.zcp-row>.zcp-col>.zcp-row>.zcp-col:nth-child(2) { transform: rotate(180deg); }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-pra-setup .zc-pra-vertical-tabbody { border-radius: 0px 0px 0px 12px; }";
			                 	style_txt = style_txt + custom_style_rtl + rtl_txt + thisapp.PopupStyles.Info_Msg_Creator(txt);
			                 	return style_txt;
			                 
			
}