string PageStyles.Custom_Approval_Template()
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	style_txt = ".zc-pra-custom-detail-content { height: calc(100% - 68px); padding: 30px 0px; overflow-x: hidden; } .zc-pra-filter .select2-container.select2-allowclear .select2-choice abbr { display: none; } ul.zc-pra-zigzag-wrapper { width: 725px; position: relative; margin: 0px auto 20px; display: flex; justify-content: center; } ul.zc-pra-zigzag-wrapper:nth-child(odd) { justify-content: flex-start; } ul.zc-pra-zigzag-wrapper li.zc-pra-zigzag-li { display: flex; flex-direction: row; align-items: center; } ul.zc-pra-zigzag-wrapper li .zc-pra-card { width: 300px; box-shadow: " + color_codes.get("zc-pra-box-shadow") + "; position: relative; z-index: 1; } .zc-pra-zcard-header { padding: 10px 16px; border-bottom: 1px solid " + color_codes.get("zc-pra-border-color") + "; } .zc-pra-zcard-title { width: calc(100% - 30px); padding: 5px 0px; } .zc-pra-no-wrapper { width: 20px; height: 20px; border-radius: 4px; margin-right: 8px; background-color: var(--section_menu_active_bg_color); color: var(--theme_brand_color); font-size: 14px; font-weight: 500; line-height: 20px; text-align: center; } .zc-pra-zcard-title h6 { width: calc(100% - 28px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-zcard-content { padding: 16px; } .zc-pra-zcard-content ul li { list-style-type: none; } .zc-pra-zcard-content ul li:not(:last-child) { margin-bottom: 8px; } .zc-pra-zcard-content label, .zc-pra-zcard-content span { font-size: 14px; line-height: 29px; display: inline-block; vertical-align: top; } .zc-pra-zcard-content label { width: 80px; font-weight: 400; color: " + color_codes.get("zc-pra-secondary-text-color") + "; padding-right: 8px; } .zc-pra-zcard-badge { display: inline-block; vertical-align: top; } .zc-pra-zcard-content span { color: " + color_codes.get("zc-pra-primary-text-color") + "; font-weight: 500; } .zc-pra-zcard-content span.zc-pra-currency-value { margin: 0px; } .zc-pra-zcard-badge span { background-color: var(--section_menu_active_bg_color); padding: 4px 8px; border-radius: 4px; line-height: 21px; } .zc-pra-zcard-content > ul > li > span, .zc-pra-zcard-content > ul > li > div { width: calc(100% - 80px); } .zc-pra-zcard-content span.zc-pra-color-green { color: " + color_codes.get("zc-pra-green") + "; } .zc-pra-zcard-content .zc-pra-img-wrapper { width: 30px; height: 30px; border-radius: 50%; margin: 6px 8px 6px 0px; } .zc-pra-zcard-content .zc-pra-img-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: contain; } .zc-pra-zcard-content .zc-pra-img-txt-wrapper { width: calc(100% - 38px); } .zc-pra-img-txt-wrapper span { line-height: 1.5; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-img-txt-wrapper span.zc-pra-sm-txt { font-size: 12px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 3px; } /* Connection styles start */ ul.zc-pra-zigzag-wrapper:before { content: ''; width: 300px; height: calc(100% + 20px); border: 1px dashed var(--theme_brand_color); position: absolute; top: calc((100% + 20px) / 2); } ul.zc-pra-zigzag-wrapper:nth-child(odd):before { border-left-width: 0px; border-radius: 0px 135px 135px 0px; left: calc(50% - (300px / 2) + 300px); } ul.zc-pra-zigzag-wrapper:nth-child(even):before { border-right-width: 0px; border-radius: 135px 0px 0px 135px; right: calc(50% - (300px / 2) + 300px); } ul.zc-pra-zigzag-wrapper:last-child:after { content: ''; width: calc(100% + 300px); height: calc((100% + 20px) / 2); background-color: " + color_codes.get("zc-pra-white") + "; display: block; position: absolute; top: calc((100% + 20px) - (25px / 2) + 25px); } ul.zc-pra-zigzag-wrapper:nth-child(odd) li.zc-pra-zigzag-li:last-child:after { content: ''; width: 300px; height: calc(100% + 20px); border: 1px solid " + color_codes.get("zc-pra-white") + "; background-color: " + color_codes.get("zc-pra-white") + "; position: absolute; top: calc(((100% + 20px) / 2) - 1px); border-left-width: 0px; border-radius: 0px 135px 135px 0px; left: calc(50% - (300px / 2) + 300px - -1px); } /* Connection styles end */ .zc-pra-add-card a { width: 25px; height: 25px; background-color: var(--theme_brand_color); border-radius: 50%; display: inline-block; vertical-align: top; text-align: center; position: relative; cursor: pointer; } .zc-pra-add-card a i { font-size: 12px; line-height: 25px; font-weight: bolder; color: " + color_codes.get("zc-pra-white") + "; } .zc-pra-add-card:before, .zc-pra-add-card:after { content: ''; display: inline-block; vertical-align: top; width: 50px; border-top: 1px dashed var(--theme_brand_color); margin: 12px 0px; } ul.zc-pra-zigzag-wrapper:first-child li:first-child .zc-pra-add-card:first-child:before, ul.zc-pra-zigzag-wrapper:nth-child(odd) li:nth-child(2) .zc-pra-add-card:before, ul.zc-pra-zigzag-wrapper:nth-child(odd) li:nth-child(2) .zc-pra-add-card:after, ul.zc-pra-zigzag-wrapper:nth-child(even) li:last-child .zc-pra-add-card:before, ul.zc-pra-zigzag-wrapper:nth-child(even) li:last-child .zc-pra-add-card:after, ul.zc-pra-zigzag-wrapper:nth-child(odd) li:last-child .zc-pra-add-card:last-child:after, ul.zc-pra-zigzag-wrapper:nth-child(odd) li.zc-pra-zigzag-li:nth-child(2):after, .zc-pra-custom-approval-isPO ul.zc-pra-zigzag-wrapper:last-child:before, .zc-pra-custom-approval-zc-pra-custom-approval-isPO ul.zc-pra-zigzag-wrapper:last-child li:last-child .zc-pra-add-card:before { display: none; } ul.zc-pra-zigzag-wrapper li:last-child .zc-pra-add-card { position: absolute; top: calc((100% + 20px) - (25px / 2)); } ul.zc-pra-zigzag-wrapper:nth-child(odd) li:nth-child(2) .zc-pra-add-card { right: calc(50% - (25px / 2) - 300px - 133px - 15px); } ul.zc-pra-zigzag-wrapper:nth-child(even) li:last-child .zc-pra-add-card { left: calc(50% - (25px / 2) - 300px - 133px - 15px); } ul.zc-pra-zigzag-wrapper:nth-child(1) li:nth-child(1) .zc-pra-add-card:nth-child(1) { position: absolute; left: -75px; top: calc((100% - 25px) / 2); } ul.zc-pra-zigzag-wrapper:nth-child(odd) li:nth-child(1) .zc-pra-add-card { position: static }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-pra-no-wrapper { margin-right: 0px; margin-left: 8px; } .zc-rtl-wrapper .zc-pra-zcard-content label { padding-left: 0px; padding-right: 8px; } .zc-rtl-wrapper .zc-pra-zcard-content .zc-pra-img-wrapper { margin: 6px 0px 6px 8px; } /* Connection styles start */ .zc-rtl-wrapper ul.zc-pra-zigzag-wrapper:nth-child(odd):before { border-width: 1px 0px 1px 1px; border-radius: 135px 0px 0px 135px; left: auto; right: calc(50% - (300px / 2) + 300px); } .zc-rtl-wrapper ul.zc-pra-zigzag-wrapper:nth-child(even):before { border-width: 1px 1px 1px 0px; border-radius: 0px 135px 135px 0px; right: auto; left: calc(50% - (300px / 2) + 300px); } .zc-rtl-wrapper ul.zc-pra-zigzag-wrapper:nth-child(odd) li.zc-pra-zigzag-li:last-child:after { border-width: 1px 0px 1px 1px; border-radius: 135px 0px 0px 135px; left: auto; right: calc(50% - (300px / 2) + 300px - -1px); } /* Connection styles end */ .zc-rtl-wrapper ul.zc-pra-zigzag-wrapper:nth-child(odd) li:nth-child(2) .zc-pra-add-card { right: auto; left: calc(50% - (25px / 2) - 300px - 133px - 15px); } .zc-rtl-wrapper ul.zc-pra-zigzag-wrapper:nth-child(even) li:last-child .zc-pra-add-card { left: auto; right: calc(50% - (25px / 2) - 300px - 133px - 15px); } .zc-rtl-wrapper ul.zc-pra-zigzag-wrapper:nth-child(1) li:nth-child(1) .zc-pra-add-card:nth-child(1) { left: auto; right: -75px; }";
			                 	style_txt = style_txt + rtl_txt;
			                 	return style_txt;
			                 
			
}