string PageStyles.PO_Approval()
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	common_style_txt = ".zc-pra-popup-container ul li { list-style-type: none; } .zc-pra-popup-container .zc-pra-bold-txt { font-weight: 600; } .zc-pra-dflex { display: flex; }";
			                 	style_txt = thisapp.styles.New_Table() + ".zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter { padding: 0px; } .zc-pra-popup-header { padding: 13px 30px; border-bottom: 1px solid " + color_codes.get("zc-pra-border-color") + "; } .zc-pra-po-document .zc-pra-popup-header { padding: 13px 62px 13px 30px; } .zc-pra-popup-header h5 { padding: 7px 0px; } .zc-pra-popup-content { height: calc(100% - 63px); display: inline-block; vertical-align: top; } .zc-pra-po-approval .zc-pra-popup-content>div:nth-child(1) { width: 30%; height: 100%; border-right: 1px solid " + color_codes.get("zc-pra-border-color") + "; overflow: auto; } .zc-pra-po-approval .zc-pra-popup-content>div:nth-child(2) { width: 70%; height: 100%; padding: 20px 30px; display: inline-block; vertical-align: top; position: relative; overflow: auto; } .zc-pra-po-document .zc-pra-popup-content>div:nth-child(1) { padding: 20px 30px; overflow: auto; } /* Form section */ .zc-pra-popup-container .zc-form-fullheight, .zc-pra-popup-container .row, .zc-pra-popup-container form.form-table, .popupbox { width: 100%; height: 100%; } .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter.zc-pb-livePopup-wrapper .zc-pra-popup-container .form-outer-wrapper form .formContainer { height: calc(100% - 77px); background-color: #FDFDFD; overflow: auto; max-height: none; } .zc-pra-popup-content-inner>*:not(:last-child) { margin-bottom: 30px; } /* Common styles */ .zc-pra-preview-tag { position: absolute; background-color: " + color_codes.get("zc-pra-primary-text-color") + "; font-size: 14px; font-weight: 400; line-height: 1.5; color: " + color_codes.get("zc-pra-white") + "; padding: 2px 30px; top: 12px; left: -28px; transform: rotate(315deg); } .zc-pra-popup-content-inner .zc-pra-popup-subheader { text-align: center; margin-bottom: 16px; } .zc-pra-company-detail { width: calc(100% - 320px); } .zc-pra-key_value-wrapper { width: 300px; text-align: right; } .zc-pra-img-wrapper { width: 45px; height: 45px; margin-right: 16px; } .zc-pra-img-wrapper img { width: 100%; height: 100%; border-radius: 8px; border: 1px solid " + color_codes.get("zc-pra-border-color") + "; object-fit: contain; } .zc-pra-img-wrapper span { font-size: 18px !important; border-radius: 8px !important; line-height: 45px !important; } .zc-pra-img-wrapper+div.zc-pra-flt-left { width: calc(100% - 61px); } .zc-pra-popup-container p.zc-pra-sec-text { font-size: 14px; font-weight: 400; line-height: 21px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 4px; } /* Key Value section */ ul.zc-pra-key_value-wrapper li label, ul.zc-pra-key_value-wrapper li span { font-size: 15px; font-weight: 400; line-height: 1.3; display: inline-block; vertical-align: top; } ul.zc-pra-key_value-wrapper label { color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-right: 4px; } ul.zc-pra-key_value-wrapper span { color: " + color_codes.get("zc-pra-primary-text-color") + "; } ul.zc-pra-key_value-wrapper li:not(:first-child) { margin-top: 8px; } /* Address card section */ ul.zc-pra-address-wrapper li { margin-right: 16px; padding: 16px; } ul.zc-pra-address-wrapper li:last-child { margin-right: 0px; } ul.zc-pra-address-wrapper.zc-pra-split-2 li { width: calc((100% - 16px) / 2); height: auto; } ul.zc-pra-address-wrapper.zc-pra-split-3 li { width: calc((100% - 32px) / 3); } ul.zc-pra-address-wrapper li label, ul.zc-pra-address-wrapper li span { display: block; } ul.zc-pra-address-wrapper li label { font-size: 15px; font-weight: 400; line-height: 1.3; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-bottom: 4px; } ul.zc-pra-address-wrapper li span { font-size: 14px; font-weight: 400; line-height: 21px; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; margin-top: 8px; } ul.zc-pra-address-wrapper li span.zc-pra-bold-txt { font-weight: 600; } ul.zc-pra-address-wrapper li i { margin: 12px 8px 0px 0px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; } /* Table section */ .zc-pra-table-wrapper table thead tr th:nth-last-child(1), .zc-pra-table-wrapper table thead tr th:nth-last-child(2), .zc-pra-table-wrapper table tbody tr td:nth-last-child(1), .zc-pra-table-wrapper table tbody tr td:nth-last-child(2) { width: 140px; } /* Comments section */ .zc-pra-comments-wrapper { width: calc(100% - 300px); height: auto; margin-right: 20px; background-color: #f9f9fb80; padding: 16px; } .zc-pra-comments-wrapper span { font-size: 14px; font-weight: 400; line-height: 21px; display: block; color: " + color_codes.get("zc-pra-primary-text-color") + "; } /* Billing section */ .zc-pra-bill-wrapper { width: 280px; } .zc-pra-bill-wrapper table tbody tr td { width: 140px; font-size: 14px; font-weight: 400; line-height: 21px; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; padding: 8px 16px; text-align: right; } .zc-pra-bill-wrapper table tbody tr:last-child td { font-size: 16px; font-weight: 500; line-height: 24px; } .zc-pra-bill-wrapper table tbody tr:last-child td:first-child { border-radius: 8px 0px 0px 8px; } .zc-pra-bill-wrapper table tbody tr:last-child td:last-child { border-radius: 0px 8px 8px 0px; } ul.zc-pra-li-wrapper.zc-pra-key_value-wrapper { width: 100%; } ul.zc-pra-li-wrapper.zc-pra-key_value-wrapper li {margin: 0px 24px 0px 0px; } .zc-pra-popup-container .zc-pra-table-wrapper table tbody tr td.zc-pra-description-td span { display: block; } .zc-pra-popup-container .zc-pra-table-wrapper table tbody tr td.zc-pra-description-td span:last-child { margin-top: 4px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; } ul.zc-pra-address-wrapper li .zc-pra-tax-wrapper { margin-left: 16px; } .zc-pra-notes-container { width: calc(100% - 300px); margin-right: 20px; } .zc-pra-print-wrapper { display: none; } .zc-pa-notes-wrapper p { font-size: 14px; font-weight: 400; line-height: 1.5; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 4px; } .zc-pra-notes-container > div:not(:last-child), .zc-pra-print-wrapper > div:not(:last-child) { margin-bottom: 16px; } @media print { /* .zc-pra-po-document * { page-break-after: avoid; } */ .zc-pra-print-wrapper { display: block; } .zc-pa-notes-wrapper { /* width: 60%; min-width: 450px; */ } .zc-pra-notes-container > div { display: none; } .zc-pra-table-wrapper table thead tr:first-child th { outline: none; } .zc-pra-po-document * { page-break-before: auto !important; page-break-after: auto !important; page-break-inside: auto !important; } } .zc-pra-signature-wrapper {  } .zc-pra-signature-wrapper img { height: 100px; object-fit: contain; display: block; } .zc-pra-signature-wrapper span { font-size: 14px; font-weight: 400; line-height: 21px; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 4px; } div#preloader, #splash-screen { display: none !important; } @media screen and (min-width: 1600px) { .zc-pra-po-approval .zc-pra-popup-content>div:nth-child(1) { width: 350px; } .zc-pra-po-approval .zc-pra-popup-content>div:nth-child(2) { width: calc(100% - 390px); } } .zc-pra-company-detail .zc-pra-key_value-wrapper { text-align: left; margin-top: 8px; } .zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter.alert-popup { height: auto; } .zcpopup.compact .popupbox-wrapper .popupbox { background-color: transparent; }span.zc-pra-left-dist { margin: 0 0 8px 30px !important; } span.zc-pra-left-dist:last-child { margin-bottom: unset !important; }.zc-pra-height-maxcontent { height: max-content !important; }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-pra-po-document .zc-pra-popup-header { padding: 13px 30px 13px 62px; } .zc-rtl-wrapper .zc-pra-po-approval .zc-pra-popup-content>div:nth-child(1) { border-right-width: 0px; border-left: 1px solid " + color_codes.get("zc-pra-border-color") + "; } /* Common styles */ .zc-rtl-wrapper .zc-pra-preview-tag { left: auto; right: -28px; transform: rotate(45deg); } .zc-rtl-wrapper .zc-pra-key_value-wrapper, .zc-rtl-wrapper .zc-pra-bill-wrapper table tbody tr td { text-align: left; } .zc-rtl-wrapper .zc-pra-img-wrapper, .zc-rtl-wrapper ul.zc-pra-address-wrapper li { margin-right: 0px; margin-left: 16px; } /* Key Value section */ .zc-rtl-wrapper ul.zc-pra-key_value-wrapper label { margin-right: 0px; margin-left: 4px; } /* Address card section */ .zc-rtl-wrapper ul.zc-pra-address-wrapper li:last-child { margin: 0px; } .zc-rtl-wrapper ul.zc-pra-address-wrapper li i { margin: 12px 0px 0px 8px; } /* Comments section */ .zc-rtl-wrapper .zc-pra-comments-wrapper { margin-right: 0px; margin-left: 20px; } /* Billing section */ .zc-rtl-wrapper .zc-pra-bill-wrapper table tbody tr:last-child td:first-child { border-radius: 0px 8px 8px 0px; } .zc-rtl-wrapper .zc-pra-bill-wrapper table tbody tr:last-child td:last-child { border-radius: 8px 0px 0px 8px; } .zc-rtl-wrapper .zc-live-primary-outline-btn:last-child { margin-right: 10px; } /* Small table width adjustment */ .zc-rtl-wrapper .zc-pra-table-wrapper table thead tr th:nth-last-child(1), .zc-rtl-wrapper .zc-pra-table-wrapper table tbody tr td:nth-last-child(1), .zc-rtl-wrapper .zc-pra-bill-wrapper table tbody tr td:last-child { width: 185px; } .zc-rtl-wrapper .zc-pra-comments-wrapper { width: calc(100% - 345px); } .zc-rtl-wrapper .zc-pra-bill-wrapper { width: 325px;} .zc-rtl-wrapper ul.zc-pra-li-wrapper.zc-pra-key_value-wrapper li {margin: 0px 0px 0px 24px; } .zc-rtl-wrapper ul.zc-pra-address-wrapper li .zc-pra-tax-wrapper { margin-left: 0px; margin-right: 16px; } .zc-rtl-wrapper .zc-pra-company-detail .zc-pra-key_value-wrapper { text-align: right; }";
			                 	validation_error_popup = "span.zc-popup-first-focus ~ .popupbox { width: auto; height: auto; }";
			                 	page_break_issue_fix = "@media print { .zc-pra-popup-container.zc-pra-po-document, .zc-pra-po-document .zc-pra-table-wrapper table { display: inline-block; } }";
			                 	style_txt = common_style_txt + style_txt + rtl_txt + page_break_issue_fix + validation_error_popup;
			                 	return style_txt;
			                 
			
}