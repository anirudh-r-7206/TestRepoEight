string PageStyles.Custom_Approval_Details()
{

			
			                 	style_txt = thisapp.PageStyles.Custom_Approval_Template() + ".zc-pra-page-header { padding: 20px 30px; } .zc-pra-header-title { padding: 7px 0px; } .zc-pra-page-content { height: calc(100% - 76px); padding: 0px 30px 20px; overflow: auto; } .zc-live-primary-outline-btn i { vertical-align: top; margin-right: 6px; line-height: 17px; }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-live-primary-outline-btn i { margin-right: 0px; margin-left: 6px; }";
			                 	style_txt = style_txt + rtl_txt;
			                 	return style_txt;
			                 
			
}