string styles.CommonStyles()
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	common_txt = "* { margin: 0px; padding: 0px; box-sizing: border-box; } .zc-pra-clearfix { display: inline-block; vertical-align: top; } .zc-pra-flt-left { float: left; } .zc-pra-flt-right { float: right; } .zc-pra-fw { width: 100%; } .zc-pra-fwh { width: 100%; height: 100%; } .zc-pra-page-container { width: 100%; height: 100%; background-color: " + color_codes.get("zc-pra-bg-color") + "; } .zc-pra-card { background-color: " + color_codes.get("zc-pra-white") + "; border: 1px solid " + color_codes.get("zc-pra-border-color") + "; border-radius: 12px; } .zc-pra-table { width: 100%; line-height: normal; border-collapse: collapse; } .zc-pra-page-container h5 { font-size: 18px; font-weight: 500; line-height: 22px; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-page-container h6 { font-size: 16px; line-height: 1.25; font-weight: 400; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-page-container h4 { font-size: 20px; line-height: 1.25; font-weight: 400; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-page-container .zc-pra-bold-txt { font-weight: 600; } .zc-pra-popup-container h5 { font-size: 18px; font-weight: 500; line-height: 22px; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-popup-container h6 { font-size: 16px; line-height: 1.25; font-weight: 400; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-popup-container h4 { font-size: 20px; line-height: 1.25; font-weight: 400; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-primary-text-color") + "; } /* RTL */ .zc-rtl-wrapper .zc-pra-flt-left { float: right; } .zc-rtl-wrapper .zc-pra-flt-right { float: left; }";
			                 	back_icon = ".zc-pra-page-header .zc-pra-back-icon { font-size: 0px; } .zc-pra-page-header .zc-pra-back-icon span { font-size: 22px; font-weight: 500; line-height: 22px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin: 0px 8px 0px 0px; } .zc-pra-page-header .zc-pra-back-icon span:before { display: inline-block; vertical-align: top; } .zc-pra-page-header .zc-pra-back-icon:hover span { color: " + color_codes.get("zc-pra-primary-text-color") + "; } /* RTL */ .zc-rtl-wrapper .zc-pra-page-header .zc-pra-back-icon span { transform: rotate(180deg); margin: 0px 0px 0px 8px; }";
			                 	popup_height = ".zcpopup.compact .popupbox-wrapper .popupbox .zc-form-fullheight .row form .formContainer { max-height: calc(90vh - 142px); overflow: auto; }";
			                 	to_be_removed = ".zc-pra-page-container .zc-pra-pricing-banner+.zc-pra-page-container-inner { height: calc(100% - 77px); } .zc-pra-page-container .zc-pra-pricing-banner { width: calc(100% - 60px); margin: 30px 30px 0px; }";
			                 	style_txt = common_txt + back_icon + popup_height;
			                 	return style_txt;
			                 
			
}