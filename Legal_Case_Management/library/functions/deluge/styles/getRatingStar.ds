string styles.getRatingStar(string ratingStr, string selectedClr, string unselectedClr)
{

			
			                 	if(selectedClr == "")
			                 	{
			                 		selectedClr = "#FFB904";
			                 	}
			                 	if(unselectedClr == "")
			                 	{
			                 		unselectedClr = "#EDEDED";
			                 	}
			                 	ratingNum = if(ratingStr.isNumber(),ratingStr.toLong(),0);
			                 	loopingList = "".leftpad(4).toList(" ");
			                 	str = "<div style='gap: 5px;display: flex;justify-content: flex-end;'>";
			                 	for each index rating in loopingList
			                 	{
			                 		if(rating < ratingNum)
			                 		{
			                 			str = str + "<svg width='14' height='13' viewBox='0 0 14 13' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6.35754 0.927052C6.65689 0.0057416 7.9603 0.00574088 8.25965 0.927052L9.10471 3.52786C9.23858 3.93989 9.62254 4.21885 10.0558 4.21885H12.7904C13.7591 4.21885 14.1619 5.45846 13.3782 6.02786L11.1658 7.63525C10.8153 7.8899 10.6687 8.34127 10.8025 8.75329L11.6476 11.3541C11.947 12.2754 10.8925 13.0415 10.1088 12.4721L7.89638 10.8647C7.54589 10.6101 7.0713 10.6101 6.72081 10.8647L4.50843 12.4721C3.72471 13.0415 2.67023 12.2754 2.96958 11.3541L3.81464 8.75329C3.94851 8.34127 3.80185 7.8899 3.45137 7.63525L1.23899 6.02787C0.455271 5.45846 0.858046 4.21885 1.82677 4.21885H4.56142C4.99465 4.21885 5.37861 3.93989 5.51248 3.52786L6.35754 0.927052Z' fill='" + selectedClr + "'/></svg>";
			                 		}
			                 		else
			                 		{
			                 			str = str + "<svg width='14' height='13' viewBox='0 0 14 13' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6.35754 0.927052C6.65689 0.00574152 7.9603 0.00574078 8.25965 0.927051L9.10471 3.52786C9.23858 3.93989 9.62254 4.21885 10.0558 4.21885H12.7904C13.7591 4.21885 14.1619 5.45846 13.3782 6.02786L11.1658 7.63525C10.8153 7.8899 10.6687 8.34127 10.8025 8.75329L11.6476 11.3541C11.947 12.2754 10.8925 13.0415 10.1088 12.4721L7.89638 10.8647C7.54589 10.6101 7.0713 10.6101 6.72081 10.8647L4.50843 12.4721C3.72471 13.0415 2.67023 12.2754 2.96958 11.3541L3.81464 8.75329C3.94851 8.34127 3.80185 7.8899 3.45137 7.63525L1.23899 6.02787C0.455271 5.45846 0.858046 4.21885 1.82677 4.21885H4.56142C4.99465 4.21885 5.37861 3.93989 5.51248 3.52786L6.35754 0.927052Z' fill='" + unselectedClr + "'/></svg>";
			                 		}
			                 	}
			                 	return str + "</div>";
			                 
			
}