string styles.New_Table()
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	style_txt = ".zc-pra-table-wrapper { background-color: " + color_codes.get("zc-pra-white") + "; border: 1px solid " + color_codes.get("zc-pra-border-color") + "; border-radius: 4px; position: relative; overflow: auto; } .zc-pra-table-wrapper table { width: 100%; line-height: normal; border-collapse: collapse; } .zc-pra-table-wrapper table thead { position: sticky; top: 0px; } .zc-pra-table-wrapper table thead tr th, .zc-pra-table-wrapper table tbody tr td { font-size: 14px; line-height: 1.5; letter-spacing: 0.1px; padding: 8px 16px; text-align: left; color: " + color_codes.get("zc-pra-primary-text-color") + "; } .zc-pra-table-wrapper table thead tr th.zc-pra-align-right, .zc-pra-table-wrapper table tbody tr td.zc-pra-align-right { text-align: right; } .zc-pra-table-wrapper table thead tr th.zc-pra-align-center, .zc-pra-table-wrapper table tbody tr td.zc-pra-align-center { text-align: left; } .zc-pra-table-wrapper table thead tr:first-child th { font-weight: 500; background-color: " + color_codes.get("zc-pra-table-header-bg") + "; box-shadow: 0px -1px 0px 0px " + color_codes.get("zc-pra-border-color") + " inset; white-space: nowrap; } .zc-pra-table-wrapper table thead tr.zc-pra-tspace th { background-color: " + color_codes.get("zc-pra-white") + "; padding: 2px; } .zc-pra-table-wrapper table tbody tr td { font-weight: 400; border-top: 1px solid " + color_codes.get("zc-pra-border-color") + "; word-break: break-all; } .zc-pra-table-wrapper table tbody tr.zc-pra-tgroup td { background-color: #F1F2F8; border-top: 1px solid " + color_codes.get("zc-pra-border-color") + " !important; padding: 5px 16px; font-weight: 600; } .zc-pra-table-wrapper table thead tr:first-child th:first-child { border-radius: 3px 0px 0px 0px; } .zc-pra-table-wrapper table thead tr:first-child th:last-child { border-radius: 0px 3px 0px 0px; } .zc-pra-table-wrapper table tbody tr:last-child td:first-child { border-radius: 0px 0px 0px 3px; } .zc-pra-table-wrapper table tbody tr:last-child td:last-child { border-radius: 0px 0px 3px 0px; } .zc-pra-table-wrapper table tbody tr.zc-pra-tgroup:hover td { background-color: #F1F2F8; } .zc-pra-table-wrapper table tbody tr:hover td { background-color: " + color_codes.get("zc-pra-table-list-hover") + "; } .zc-pra-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zc-pra-table-wrapper table tbody tr:first-child:hover td { border-color: " + color_codes.get("zc-pra-border-color") + "; } .zc-pra-table-wrapper table tbody tr td .zc-pra-img-wrapper { width: 25px; height: 25px; border-radius: 50%; border: 1px solid " + color_codes.get("zc-pra-white") + "; margin-right: 8px; } .zc-pra-table-wrapper table tbody tr td .zc-pra-img-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: contain; } .zc-pra-table-wrapper table tbody tr td .zc-pra-img-wrapper span { font-size: 12px !important; line-height: 23px !important; padding: 0px; } .zc-pra-table-wrapper table tbody tr td .zc-pra-img-wrapper+span { padding: 2px 0px; } .zc-pra-table-wrapper table tbody tr td.zc-pra-green, .zc-pra-table-wrapper table thead tr th.zc-pra-green, .zc-pra-table-wrapper table tbody tr td .zc-pra-green { color: " + color_codes.get("zc-pra-green") + "; } .zc-pra-table-wrapper table tbody tr td.zc-pra-red, .zc-pra-table-wrapper table thead tr th.zc-pra-red, .zc-pra-table-wrapper table tbody tr td .zc-pra-red { color: " + color_codes.get("zc-pra-red") + "; } .zc-pra-table-wrapper table tbody tr td.zc-pra-yellow { color: #b8770d; } .zc-pra-table-wrapper table tbody tr td.zc-pra-d_green { color: #007943; } .zc-pra-table-wrapper table tbody tr td.zc-pra-blue { color: #09598E; } .zc-pra-table-wrapper table tbody tr td.zc-pra-l_blue { color: #1094C5; } .zc-pra-table-wrapper table tbody tr td.zc-pra-d_blue { color: #1328CD; } .zc-pra-table-wrapper table tbody tr td .zc-pra-custom-btn, .zc-pra-table-wrapper table tbody tr td .zc-pra-custom-btn-disable { display: inline-block; vertical-align: top; color: var(--theme_brand_color); padding: 6px 10px; border: 1px solid var(--theme_brand_color); border-radius: 4px; transition: all 0.2s linear; } .zc-pra-table-wrapper table tbody tr td .zc-pra-custom-btn-disable { opacity: 0.3; } .zc-pra-table-wrapper table tbody tr td .zc-pra-custom-btn:hover { background-color: var(--theme_brand_color); color: " + color_codes.get("zc-pra-white") + "; } .zc-pra-table-wrapper table tbody tr:hover td .zc-pra-custom-btn-disable { border-color: " + color_codes.get("zc-pra-border-color") + "; color: " + color_codes.get("zc-pra-secondary-text-color") + "; } .zc-pra-attachment-wrapper i { vertical-align: top; line-height: 21px; margin-right: 6px; } .zc-pra-table-wrapper table tbody tr.zc-pra-bold-tr td { font-weight: 600; padding: 12px 16px; } .zc-pra-table-wrapper table tbody tr td .zc-pra-sm-txt { font-size: 12px; }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-pra-table-wrapper table thead tr th, .zc-rtl-wrapper .zc-pra-table-wrapper table tbody tr td { text-align: right; } .zc-rtl-wrapper .zc-pra-table-wrapper table thead tr th.zc-pra-align-right, .zc-rtl-wrapper .zc-pra-table-wrapper table tbody tr td.zc-pra-align-right { text-align: left; } .zc-rtl-wrapper .zc-pra-table-wrapper table thead tr:first-child th:first-child { border-radius: 0px 3px 0px 0px; } .zc-rtl-wrapper .zc-pra-table-wrapper table thead tr:first-child th:last-child { border-radius: 3px 0px 0px 0px; } .zc-rtl-wrapper .zc-pra-table-wrapper table tbody tr:last-child td:first-child { border-radius: 0px 0px 3px 0px; } .zc-rtl-wrapper .zc-pra-table-wrapper table tbody tr:last-child td:last-child { border-radius: 0px 0px 0px 3px; } .zc-rtl-wrapper .zc-pra-table-wrapper table tbody tr td .zc-pra-img-wrapper { margin-right: 0px; margin-left: 8px; } .zc-rtl-wrapper .zc-pra-attachment-wrapper i { margin-right: 0px; margin-left: 6px; }";
			                 	style_txt = style_txt + rtl_txt;
			                 	return style_txt;
			                 
			
}