string styles.Panel()
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	panel_txt = ".zc-pra-panel-wrapper { display: flex; flex-direction: row; } .zc-pra-panel-wrapper.zc-pra-panel-count-5 .zc-pra-panel { width: calc((100% - (20px * 4)) / 5); } .zc-pra-panel-wrapper.zc-pra-panel-count-4 .zc-pra-panel { width: calc((100% - (20px * 3)) / 4); } .zc-pra-panel-wrapper .zc-pra-panel { list-style-type: none; margin: 0px 10px; } .zc-pra-panel-wrapper .zc-pra-panel:first-child { margin-left: 0px; } .zc-pra-panel-wrapper .zc-pra-panel:last-child { margin-right: 0px; } .zc-pra-panel .zc-pra-card { width: 100%; height: 100%; display: block; padding: 15px; cursor: pointer; box-shadow: 0px 2px 8px 0px #F2F2F6; } .zc-pra-panel .zc-pra-card:hover { border-color: var(--theme_brand_color); background-image: linear-gradient(rgb(253 253 255 / 10%), #f7f9ff); } .zc-pra-panel .zc-pra-icon-wrapper { width: 40px; height: 40px; border-radius: 10px; text-align: center; } .zc-pra-panel .zc-pra-icon-wrapper i { font-size: 24px; line-height: 40px; } .zc-pra-panel .zc-pra-icon-wrapper svg { height: 24px; margin: 8px 0px; } .zc-pra-panel h4 { line-height: 26px; padding: 7px 10px; } .zc-pra-panel span { font-size: 14px; font-weight: 400; line-height: 1.5; letter-spacing: 0.1px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; margin-top: 10px; display: block; }";
			                 	color_txt = ".zc-pra-panel.zc-pra-color-green .zc-pra-icon-wrapper { background-color: #E4FCF3; color: #179E6C; fill: #179E6C; } .zc-pra-panel.zc-pra-color-yellow .zc-pra-icon-wrapper { background-color: #FCF4E6; color: #B8770D; fill: #B8770D; } .zc-pra-panel.zc-pra-color-red .zc-pra-icon-wrapper { background-color: #FDE3E6; color: #FE455D; fill: #FE455D; } .zc-pra-panel.zc-pra-color-d_blue .zc-pra-icon-wrapper { background-color: #EAF2FF; color: #1652BB; fill: #1652BB; } .zc-pra-panel.zc-pra-color-l_blue .zc-pra-icon-wrapper { background-color: #E8EFFF; color: #2A6FFC; fill: #2A6FFC; } .zc-pra-panel.zc-pra-color-violet .zc-pra-icon-wrapper { background-color: #f6f6fb; color: #5c66ff; fill: #5c66ff; } .zc-pra-panel.zc-pra-color-blue .zc-pra-icon-wrapper { background-color: #f2f9ff; color: #2a8bcc; fill: #2a8bcc; } .zc-pra-panel.zc-pra-color-orange .zc-pra-icon-wrapper { background-color: #fdf5f3; color: #ff8b11; fill: #ff8b11; } .zc-pra-panel.zc-pra-color-grey .zc-pra-icon-wrapper { background-color: #f5f8fa; color: #092441; fill: #092441; }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-pra-panel-wrapper .zc-pra-panel:first-child { margin-left: 10px; margin-right: 0px; } .zc-rtl-wrapper .zc-pra-panel-wrapper .zc-pra-panel:last-child { margin-right: 10px; margin-left: 0px; }";
			                 	style_txt = panel_txt + color_txt + rtl_txt;
			                 	return style_txt;
			                 
			
}