string styles.Filter()
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	common = thisapp.Localization.Common();
			                 	project = common.get("zcp.project");
			                 	status = common.get("zcp.status");
			                 	shipping_address = common.get("zcp.shippingaddress");
			                 	vendor = common.get("zcp.vendor");
			                 	product = common.get("zcp.product");
			                 	category = common.get("zcp.category");
			                 	brand = common.get("zcp.brand");
			                 	department = common.get("zcp.department");
			                 	override_style = ".zc-pb-embed-placeholder-content .divEmbedContainer.zc-pra-filter { height: auto; } .zc-pra-filter .zc-form-fullheight { vertical-align: top; } .zc-pra-filter .form-outer-wrapper form.form-table { width: 100%; } .zc-pra-filter .zc-form-fullheight .form-outer-wrapper .formContainer { padding: 16px 20px; } .zc-pra-filter .zc-footer-wrapper { display: none; } .zc-pra-filter .formContainer .formColumn { min-width: auto; width: auto !important; } .zc-pra-filter .form-group { margin-bottom: 0px; } .zc-pra-filter .formColumn:not(.first-column) .form-group:not(:first-child) { margin-left: 20px; } .zc-pra-filter .formContainer .formColumn.first-column { position: relative; } .zc-pra-filter .formContainer .formColumn.second-column { float: right; } .zc-pra-filter .formContainer .formColumn.second-column .form-group, .zc-pra-filter .formContainer .formColumn.first-column .form-group { display: inline-block; vertical-align: top; } .zc-pra-filter .form-group.zc-addnote-fld { width: auto; min-width: inherit;font-size: 14px; font-weight: 400; line-height: 22px; color: " + color_codes.get("zc-pra-secondary-text-color") + "; padding: 7px 0px; } /* Placeholder */ .zc-pra-filter .first-column .form-group label { width: auto; } .zc-pra-filter .form-group label .zc-label-text { font-size: 0px; opacity: 0; } .zc-pra-filter .first-column .form-group label .zc-label-text { opacity: 0.5; user-select: none; } .zc-pra-filter .first-column .form-group label .zc-label-text:after { font-size: 14px; line-height: 20px; margin-left: 18px; } .zc-pra-filter .form-group.zc-label-float label { opacity: 0; transform: translate3d(10px, 8px, 0) scale(1); } .zc-pra-filter .form-group.zc-Search_Key-group .form-field, .zc-pra-filter .form-group.zc-Search-group .form-field { position: relative; } .zc-pra-filter .form-group.zc-Search_Key-group .form-field:before, .zc-pra-filter .form-group.zc-Search-group .form-field:before { content: '\ed38'; font: normal normal normal 14px/20px 'ZC Live Outline'; display: inline-block; vertical-align: top; opacity: 0.5; user-select: none; position: absolute; top: 8px; left: 12px; } .zc-pra-filter .form-group.zc-Search_Key-group .form-field input, .zc-pra-filter .form-group.zc-Search-group .form-field input { padding-left: 30px; padding-right: 30px; } .zc-pra-filter .form-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { display: inline-block; vertical-align: top; } .zc-pra-filter .form-group.zc-Project-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + project + " -'; } .zc-pra-filter .form-group.zc-Status-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + status + " -'; } .zc-pra-filter .form-group.zc-Shipping_Address-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + shipping_address + " -'; } .zc-pra-filter .form-group.zc-Vendor-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + vendor + " -'; } .zc-pra-filter .form-group.zc-Product-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + product + " -'; } .zc-pra-filter .form-group.zc-Category-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + category + " -'; } .zc-pra-filter .form-group.zc-Product_Status-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + common.get("zcp.status") + " -'; } .zc-pra-filter .form-group.zc-Department-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + department + " -'; } .zc-pra-filter .form-group.zc-Brand-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- " + brand + " -'; } .zc-pra-filter .form-group.zc-Requester-group .form-field .select2-container:not(.select2-allowclear) .select2-chosen:before { content: '- Requester -'; } /* Decision box(Search - cancel icon) */ .zc-pra-filter .form-group.zc-decisionbox-field-group { width: auto; height: 36px; position: absolute; right: 7px; top: 0px; z-index: 1; margin: 0px; } .zc-pra-filter .form-group .decision-box-field { display: none; } .zc-pra-filter .form-outer-wrapper .formColumn .zc-decisionbox-field-group .form-label.decision-box-label { height: 36px; font-size: 0px; line-height: 36px; padding: 0px; } .zc-pra-filter .form-label.decision-box-label:before { content: '\ed84'; font-family: 'ZC Live Outline'; font-size: 17px; } .zc-pra-filter .form-label.decision-box-label:hover:before { color: #EE3131; } .zc-pra-filter .form-group .cogLoader { margin: 11px 3px; }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-pra-filter .formColumn:not(.first-column) .form-group:not(:first-child) { margin-left: 0px; margin-right: 20px; } .zc-rtl-wrapper .zc-pra-filter .formContainer .formColumn.second-column { float: left; } /* Placeholder */ .zc-rtl-wrapper .zc-pra-filter .first-column .form-group label .zc-label-text:after { margin-left: 0px; margin-right: 18px; } .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search_Key-group .form-field:before, .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search-group .form-field:before { left: auto; right: 12px; } /* Decision box(Search - cancel icon) */ .zc-rtl-wrapper .zc-pra-filter .form-group.zc-decisionbox-field-group { right: auto; left: 7px; }";
			                 	style_txt = override_style + rtl_txt;
			                 	return style_txt;
			                 
			
}