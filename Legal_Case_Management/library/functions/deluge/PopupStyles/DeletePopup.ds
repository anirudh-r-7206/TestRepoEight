string PopupStyles.DeletePopup()
{

			
			                 	color_codes = thisapp.styles.ColorCodes();
			                 	common_style = thisapp.PopupStyles.Popup();
			                 	override_style = "/* Btn styles */ .zc-footer-wrapper .form-action .zc-live-primary-btn { border: 1px solid " + color_codes.get("zc-pra-red") + "; background-color: " + color_codes.get("zc-pra-red") + "; color: " + color_codes.get("zc-pra-white") + " }";
			                 	popup_style = ".zc-pra-popup-content.zc-pra-inactive-popup .zc-pra-icon-wrapper { background-color: " + color_codes.get("zc-pra-bg_red") + "; color: " + color_codes.get("zc-pra-red") + ";}";
			                 	style_txt = "<style>" + common_style + override_style + popup_style + "</style>";
			                 	return style_txt;
			                 
			
}