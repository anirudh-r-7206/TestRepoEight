form Add_Document_Type
{

		    displayname = "Add Document Type"
		    success message = "Document type added successfully"
		
		    Document_Type_Details
		    (
		        type = section
		        displayname = "Document Type Details"
		        row = 1
		        column = 0
		    )
		    must have unique Document_Type_Name
		    (
		        type = text
		        displayname = "Document Type Name"
		        maxchar = 120
		        row = 1
		        column = 1
		        width = medium
		    )
		    Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = {"Pleading","Evidence","Contract","Correspondence","Court Order","Invoice","Identity","Research","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Requires_Review
		    (
		        type = checkbox
		        displayname = "Requires Review"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Retention_Years
		    (
		        type = number
		        displayname = "Retention Years"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Status_Notes
		    (
		        type = section
		        displayname = "Status Notes"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 120px
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    System_Info
		    (
		        type = section
		        displayname = "System Info"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Document_Type_ID
		    (
		        type = autonumber
		        displayname = "Document Type ID"
		        start index = 1000
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Add"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}