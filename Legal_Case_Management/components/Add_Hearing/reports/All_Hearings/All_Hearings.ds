default list All_Hearings
{

		    displayName = "All Hearings"
		    show all rows from Add_Hearing
		    (
		        Case
		        Court
		        Hearing_Type
		        Hearing_DateTime
		        Venue
		        Preparation_Owner
		        Hearing_Status
		        Next_Hearing_DateTime
		    )
		    filters
		    (
		        Case
		        Court
		        Hearing_Type
		        Hearing_Status
		        Preparation_Owner
		    )
		    sort by
		    (
		        Hearing_DateTime ascending
		    )
		
}