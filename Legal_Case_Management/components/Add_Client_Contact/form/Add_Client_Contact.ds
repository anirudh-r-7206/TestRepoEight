form Add_Client_Contact
{

		    displayname = "Add Client Contact"
		    success message = "Client contact added successfully"
		
		    Contact_Details
		    (
		        type = section
		        displayname = "Contact Details"
		        row = 1
		        column = 0
		    )
		    must have Client
		    (
		        type = picklist
		        displayname = "Client"
		        values = Add_Client.ID
		        displayformat = [Client_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Contact_Name
		    (
		        type = text
		        displayname = "Contact Name"
		        maxchar = 150
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Role_Title
		    (
		        type = text
		        displayname = "Role Title"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Type
		    (
		        type = picklist
		        displayname = "Contact Type"
		        values = {"Primary","Billing","Witness","Authorized Signatory","Other"}
		        initial value = "Primary"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Communication
		    (
		        type = section
		        displayname = "Communication"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Email
		    (
		        type = email
		        displayname = "Email"
		        personal data = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        personal data = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Is_Primary
		    (
		        type = checkbox
		        displayname = "Is Primary"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    System_Info
		    (
		        type = section
		        displayname = "System Info"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Contact_ID
		    (
		        type = autonumber
		        displayname = "Contact ID"
		        start index = 1000
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Add"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}