report All_Client_Contacts
{

		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Client Contact_Name Contact_Type Email Phone Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
		        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Client Contact_Name Contact_Type Email Phone Is_Primary Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		
}