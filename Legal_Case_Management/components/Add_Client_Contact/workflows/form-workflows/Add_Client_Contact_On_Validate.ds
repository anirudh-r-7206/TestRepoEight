Add_Client_Contact_On_Validate as "Add Client Contact On Validate"
{

			    type = form
			    form = Add_Client_Contact
			    record event = on add or edit
			
			    on validate
			    {
			        actions ( Contact_Type in {"Primary","Billing","Authorized Signatory"} )
			        {
			            custom deluge script
			            (
			                if(input.Email == null || input.Email == "")
			                {
			                    alert "Email is required for primary, billing, and authorized signatory contacts.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			
}