form Add_Case_Action
{

		    displayname = "Add Case Action"
		    success message = "Case action completed successfully"
		
		    Action_Details
		    (
		        type = section
		        displayname = "Action Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have Case
		    (
		        type = picklist
		        displayname = "Case"
		        values = Create_Case.ID
		        displayformat = [Case_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Action_Type
		    (
		        type = picklist
		        displayname = "Action Type"
		        values = {"Submit Conflict Check","Clear Conflict","Flag Conflict","Send Engagement","Mark Engagement Signed","Open Matter","Move To Strategy and Pleadings","Move To Discovery and Diligence","Move To Negotiation and Mediation","Move To Hearing and Trial","Mark Awaiting Order or Execution","Send To Billing Review","Close Case","Archive Case","Reopen Case","Reject Case"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Action_By
		    (
		        type = picklist
		        displayname = "Action By"
		        values = Add_Employee.ID
		        displayformat = [Employee_Name.first_name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Action_Notes
		    (
		        type = textarea
		        displayname = "Action Notes"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Attachment
		    (
		        type = upload file
		        displayname = "Attachment"
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notify_Client
		    (
		        type = checkbox
		        displayname = "Notify Client"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    System_Info
		    (
		        type = section
		        displayname = "System Info"
		        row = 2
		        column = 1
		        width = medium
		        visibility = true
		    )
		    Action_ID
		    (
		        type = autonumber
		        displayname = "Action ID"
		        start index = 1000
		        row = 2
		        column = 1
		        width = medium
		    )
		    From_Status
		    (
		        type = text
		        displayname = "From Status"
		        row = 2
		        column = 1
		        width = medium
		    )
		    To_Status
		    (
		        type = text
		        displayname = "To Status"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Action_Date
		    (
		        type = datetime
		        displayname = "Action Date"
		        initial value = "${zoho.currenttime}"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Run Action"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Action"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}