report Active_Clients
{

		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Client_Name Client_Type Primary_Email Primary_Phone Client_Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
		        action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Client_Name Client_Type Primary_Email Primary_Phone Relationship_Manager Client_Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		
}