User_Input as "User-Input"
{

			
							type =  form
							form = Add_Preference
			
							record event = on edit
			
							on user input of App_Notification
							{
								actions 
								{
									custom deluge script
									(
														fetchPreference = Add_Preference[ID != null];
													if(fetchPreference.count() != 0)
													{
														fetchPreference.App_Notification=input.App_Notification;
													}
									)
								}
							}
			
						
			
}