form Add_Court
{

		    displayname = "Add Court"
		    success message = "Court added successfully"
		
		    Court_Details
		    (
		        type = section
		        displayname = "Court Details"
		        row = 1
		        column = 0
		    )
		    must have unique Court_Name
		    (
		        type = text
		        displayname = "Court Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Court_Type
		    (
		        type = picklist
		        displayname = "Court Type"
		        values = {"Supreme Court","High Court","District Court","Tribunal","Arbitration Centre","Regulator","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Jurisdiction
		    (
		        type = text
		        displayname = "Jurisdiction"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Registry_Contact
		    (
		        type = section
		        displayname = "Registry Contact"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Address
		    (
		        type = textarea
		        displayname = "Address"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Registry_Email
		    (
		        type = email
		        displayname = "Registry Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Website
		    (
		        type = url
		        displayname = "Website"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    System_Info
		    (
		        type = section
		        displayname = "System Info"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Court_ID
		    (
		        type = autonumber
		        displayname = "Court ID"
		        start index = 1000
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Add"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}