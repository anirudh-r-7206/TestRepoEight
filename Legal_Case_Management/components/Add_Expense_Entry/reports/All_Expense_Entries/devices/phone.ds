report All_Expense_Entries
{

		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Case Employee Expense_Date Expense_Category Amount Approval_Status Invoice ) ) )
		        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
		        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Case Employee Expense_Date Expense_Category Vendor Amount Billable Approval_Status Invoice ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		
}