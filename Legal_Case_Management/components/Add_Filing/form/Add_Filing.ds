form Add_Filing
{

		    displayname = "Add Filing"
		    success message = "Filing saved successfully"
		
		    Filing_Details
		    (
		        type = section
		        displayname = "Filing Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have Case
		    (
		        type = picklist
		        displayname = "Case"
		        values = Create_Case.ID
		        displayformat = [Case_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Court
		    (
		        type = picklist
		        displayname = "Court"
		        values = Add_Court.ID
		        displayformat = [Court_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Filing_Type
		    (
		        type = picklist
		        displayname = "Filing Type"
		        values = {"Petition","Complaint","Answer","Motion","Affidavit","Evidence","Appeal","Response","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Filing_Title
		    (
		        type = text
		        displayname = "Filing Title"
		        maxchar = 200
		        row = 1
		        column = 1
		        width = medium
		    )
		    Filing_Date
		    (
		        type = date
		        displayname = "Filing Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Filed_By
		    (
		        type = picklist
		        displayname = "Filed By"
		        values = Add_Employee.ID
		        displayformat = [Employee_Name.first_name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Filing_Status
		    (
		        type = picklist
		        displayname = "Filing Status"
		        values = {"Draft","Ready to File","Filed","Accepted","Rejected","Served"}
		        initial value = "Draft"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Filing_Reference
		    (
		        type = section
		        displayname = "Filing Reference"
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Document
		    (
		        type = picklist
		        displayname = "Document"
		        values = Add_Case_Document.ID
		        displayformat = [Document_Title]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Efiling_Reference
		    (
		        type = text
		        displayname = "Efiling Reference"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Next_Action
		    (
		        type = textarea
		        displayname = "Next Action"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 2
		        column = 1
		        width = medium
		    )
		    System_Info
		    (
		        type = section
		        displayname = "System Info"
		        visibility = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    Filing_ID
		    (
		        type = autonumber
		        displayname = "Filing ID"
		        start index = 1000
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Filing"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Filing"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}