list Filed_Filings
{

		    displayName = "Filed Filings"
		    show all rows from Add_Filing [Filing_Status == "Filed" || Filing_Status == "Accepted" || Filing_Status == "Served"]
		    (
		        Case
		        Court
		        Filing_Type
		        Filing_Title
		        Due_Date
		        Filing_Date
		        Filing_Status
		        Filed_By
		        Efiling_Reference
		    )
		    filters
		    (
		        Case
		        Court
		        Filing_Type
		        Filing_Status
		    )
		    sort by
		    (
		        Filing_Date descending
		    )
		
}