list Due_Filings
{

		    displayName = "Due Filings"
		    show all rows from Add_Filing [Filing_Status == "Draft" || Filing_Status == "Ready to File"]
		    (
		        Case
		        Court
		        Filing_Type
		        Filing_Title
		        Due_Date
		        Filing_Date
		        Filing_Status
		        Filed_By
		        Efiling_Reference
		    )
		    filters
		    (
		        Case
		        Court
		        Filing_Type
		        Filing_Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		
}