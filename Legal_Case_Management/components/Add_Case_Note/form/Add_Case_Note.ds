form Add_Case_Note
{

		    displayname = "Add Case Note"
		    success message = "Case note saved successfully"
		
		    Note_Details
		    (
		        type = section
		        displayname = "Note Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have Case
		    (
		        type = picklist
		        displayname = "Case"
		        values = Create_Case.ID
		        displayformat = [Case_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Note_Type
		    (
		        type = picklist
		        displayname = "Note Type"
		        values = {"Internal Note","Client Communication","Court Communication","Opposing Counsel","Research","Meeting"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Communication_DateTime
		    (
		        type = datetime
		        displayname = "Communication DateTime"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Direction
		    (
		        type = picklist
		        displayname = "Direction"
		        values = {"Inbound","Outbound","Internal"}
		        initial value = "Internal"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Person
		    (
		        type = text
		        displayname = "Contact Person"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Subject
		    (
		        type = text
		        displayname = "Subject"
		        maxchar = 200
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Note_Body
		    (
		        type = textarea
		        displayname = "Note Body"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Follow_Up
		    (
		        type = section
		        displayname = "Follow Up"
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Follow_Up_Required
		    (
		        type = checkbox
		        displayname = "Follow Up Required"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Follow_Up_Date
		    (
		        type = date
		        displayname = "Follow Up Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Created_By
		    (
		        type = picklist
		        displayname = "Created By"
		        values = Add_Employee.ID
		        displayformat = [Employee_Name.first_name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Visible_To_Client
		    (
		        type = checkbox
		        displayname = "Visible To Client"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    System_Info
		    (
		        type = section
		        displayname = "System Info"
		        visibility = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    Note_ID
		    (
		        type = autonumber
		        displayname = "Note ID"
		        start index = 1000
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Note"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Note"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}