report All_Case_Notes
{

		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Case Communication_DateTime Note_Type Subject Created_By ) ) )
		        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
		        action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Case Note_Type Communication_DateTime Direction Subject Follow_Up_Required Follow_Up_Date Created_By Visible_To_Client ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		
}