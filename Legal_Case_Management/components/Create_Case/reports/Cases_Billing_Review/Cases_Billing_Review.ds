list Cases_Billing_Review
{

		    displayName = "Cases Billing Review"
		    show all rows from Create_Case [Case_Status == "Billing Review"]
		    (
		        Case_Number
		        Case_Title
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Billing_Status
		        Case_Status
		        Limitation_Date
		    )
		    filters
		    (
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Billing_Status
		    )
		    sort by
		    (
		        Priority descending
		        Limitation_Date ascending
		    )
		
}