list Cases_Conflict_Check
{

		    displayName = "Cases Conflict Check"
		    show all rows from Create_Case [Case_Status == "Conflict Check"]
		    (
		        Case_Number
		        Case_Title
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Conflict_Status
		        Case_Status
		        Limitation_Date
		    )
		    filters
		    (
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Conflict_Status
		    )
		    sort by
		    (
		        Priority descending
		        Limitation_Date ascending
		    )
		
}