list Cases_Archived
{

		    displayName = "Cases Archived"
		    show all rows from Create_Case [Case_Status == "Archived"]
		    (
		        Case_Number
		        Case_Title
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Case_Status
		        Archived_On
		    )
		    filters
		    (
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		    )
		    sort by
		    (
		        Archived_On descending
		    )
		
}