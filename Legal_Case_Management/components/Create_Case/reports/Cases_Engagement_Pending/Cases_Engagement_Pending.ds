list Cases_Engagement_Pending
{

		    displayName = "Cases Engagement Pending"
		    show all rows from Create_Case [Case_Status == "Engagement Pending"]
		    (
		        Case_Number
		        Case_Title
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Engagement_Status
		        Case_Status
		        Limitation_Date
		    )
		    filters
		    (
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Engagement_Status
		    )
		    sort by
		    (
		        Priority descending
		        Limitation_Date ascending
		    )
		
}