list Cases_Strategy_and_Pleadings
{

		    displayName = "Cases Strategy and Pleadings"
		    show all rows from Create_Case [Case_Status == "Strategy and Pleadings"]
		    (
		        Case_Number
		        Case_Title
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		        Case_Status
		        Limitation_Date
		    )
		    filters
		    (
		        Client
		        Practice_Area
		        Case_Type
		        Priority
		        Matter_Manager
		        Lead_Attorney
		    )
		    sort by
		    (
		        Priority descending
		        Limitation_Date ascending
		    )
		
}