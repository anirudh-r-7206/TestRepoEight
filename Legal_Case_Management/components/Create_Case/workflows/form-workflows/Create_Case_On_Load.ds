Create_Case_On_Load as "Create Case On Load"
{

			    type = form
			    form = Create_Case
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            hide System_Status, Case_Number, Case_Status, Conflict_Status, Engagement_Status, Billing_Status, Opened_On, Closed_On, Archived_On;
			            disable Case_Number, Case_Status, Conflict_Status, Engagement_Status, Billing_Status, Opened_On, Closed_On, Archived_On;
			            hide Litigation_Details, Court, Court_Case_Number, Filing_Date, Limitation_Date;
			            hide Corporate_Details, Transaction_Counterparty, Transaction_Value, Execution_Target_Date;
			            hide Compliance_Details, Regulator, Compliance_Due_Date;
			        }
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Case_Type != null)
			                {
			                    caseTypeRec = Add_Case_Type[ID == input.Case_Type];
			                    if(caseTypeRec.count() > 0)
			                    {
			                        if(caseTypeRec.Process_Template in {"Litigation","Arbitration"})
			                        {
			                            show Litigation_Details, Court, Court_Case_Number, Filing_Date, Limitation_Date;
			                        }
			                        if(caseTypeRec.Process_Template == "Corporate Advisory")
			                        {
			                            show Corporate_Details, Transaction_Counterparty, Transaction_Value, Execution_Target_Date;
			                        }
			                        if(caseTypeRec.Process_Template == "Compliance")
			                        {
			                            show Compliance_Details, Regulator, Compliance_Due_Date;
			                        }
			                    }
			                }
			            )
			        }
			    }
			
}