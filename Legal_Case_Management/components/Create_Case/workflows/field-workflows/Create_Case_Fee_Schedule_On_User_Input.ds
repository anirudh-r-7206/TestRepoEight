Create_Case_Fee_Schedule_On_User_Input as "Fee Schedule On User Input"
{

			    type = form
			    form = Create_Case
			    record event = on add or edit
			
			    on user input of Fee_Schedule
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Fee_Schedule != null)
			                {
			                    feeRec = Add_Fee_Schedule[ID == input.Fee_Schedule];
			                    if(feeRec.count() > 0 && feeRec.Retainer_Required == true && ifnull(input.Retainer_Amount,0) == 0)
			                    {
			                        input.Retainer_Amount = feeRec.Default_Retainer;
			                    }
			                }
			            )
			        }
			    }
			
}