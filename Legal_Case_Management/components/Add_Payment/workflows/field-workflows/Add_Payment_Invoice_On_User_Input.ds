Add_Payment_Invoice_On_User_Input as "Invoice On User Input"
{

			    type = form
			    form = Add_Payment
			    record event = on add or edit
			
			    on user input of Invoice
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Invoice != null)
			                {
			                    inv = Create_Invoice[ID == input.Invoice];
			                    if(inv.count() > 0)
			                    {
			                        input.Case = inv.Case;
			                        input.Client = inv.Client;
			                    }
			                }
			            )
			        }
			    }
			
}