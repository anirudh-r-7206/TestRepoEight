form Add_Payment
{

		    displayname = "Add Payment"
		    success message = "Payment saved successfully"
		
		    Payment_Details
		    (
		        type = section
		        displayname = "Payment Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have Invoice
		    (
		        type = picklist
		        displayname = "Invoice"
		        values = Create_Invoice.ID
		        displayformat = [Invoice_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Case
		    (
		        type = picklist
		        displayname = "Case"
		        values = Create_Case.ID
		        displayformat = [Case_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Client
		    (
		        type = picklist
		        displayname = "Client"
		        values = Add_Client.ID
		        displayformat = [Client_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Payment_Date
		    (
		        type = date
		        displayname = "Payment Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Payment_Mode
		    (
		        type = picklist
		        displayname = "Payment Mode"
		        values = {"Bank Transfer","Cheque","Card","Cash","Online","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reference_Number
		    (
		        type = text
		        displayname = "Reference Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Amount
		    (
		        type = USD
		        displayname = "Amount"
		        decimalplace = 2
		        maxchar = 12
		        row = 1
		        column = 1
		        width = medium
		    )
		    Payment_Status
		    (
		        type = picklist
		        displayname = "Payment Status"
		        values = {"Received","Reconciled","Bounced","Refunded"}
		        initial value = "Received"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Receipt
		    (
		        type = upload file
		        displayname = "Receipt"
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 1
		        column = 1
		        width = medium
		    )
		    System_Info
		    (
		        type = section
		        displayname = "System Info"
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Payment_ID
		    (
		        type = autonumber
		        displayname = "Payment ID"
		        start index = 1000
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Payment"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Payment"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}