		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Profile_Image Employee_Name Employee_ID Email Phone Gender Role Reporting_Manager Date_of_Birth ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		
}