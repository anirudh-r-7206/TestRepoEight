report Pending_Conflict_Checks
{

		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Case Client Opposing_Party_Name Potential_Conflict Decision Approval_Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
		        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Case Client Opposing_Party_Name Potential_Conflict Conflict_Severity Decision Approval_Status Checked_By Checked_On ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		
}