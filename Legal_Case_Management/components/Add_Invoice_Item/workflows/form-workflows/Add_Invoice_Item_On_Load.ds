Add_Invoice_Item_On_Load as "Add Invoice Item On Load"
{

			    type = form
			    form = Add_Invoice_Item
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            hide System_Info, Invoice_Item_ID;
			            disable Invoice_Item_ID, Amount;
			        }
			        actions (Invoice != null)
			        {
			            disable Case;
			        }
			    }
			
}