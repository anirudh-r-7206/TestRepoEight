Add_Invoice_Item_On_Success as "Add Invoice Item On Success"
{

			    type = form
			    form = Add_Invoice_Item
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                inv = Create_Invoice[ID == input.Invoice];
			                if(inv.count() > 0)
			                {
			                    lines = Add_Invoice_Item[Invoice == input.Invoice];
			                    subtotal = 0;
			                    tax = 0;
			                    for each line in lines
			                    {
			                        subtotal = subtotal + ifnull(line.Amount,0);
			                        if(line.Taxable == true)
			                        {
			                            tax = tax + (ifnull(line.Amount,0) * 0.1);
			                        }
			                    }
			                    inv.Subtotal = subtotal;
			                    inv.Tax_Amount = tax;
			                }
			                if(input.Line_Status == "Billed")
			                {
			                    if(input.Time_Entry != null)
			                    {
			                        te = Add_Time_Entry[ID == input.Time_Entry];
			                        if(te.count() > 0)
			                        {
			                            te.Invoice = input.Invoice;
			                            te.Approval_Status = "Invoiced";
			                        }
			                    }
			                    if(input.Expense_Entry != null)
			                    {
			                        exp = Add_Expense_Entry[ID == input.Expense_Entry];
			                        if(exp.count() > 0)
			                        {
			                            exp.Invoice = input.Invoice;
			                            exp.Approval_Status = "Invoiced";
			                        }
			                    }
			                }
			                insert into Add_Case_History
			                [
			                    Case = input.Case
			                    Event_Date = zoho.currenttime
			                    Event_Type = "Invoice Item"
			                    Summary = "Invoice item updated: " + input.Description
			                    Source_Record_ID = input.ID
			                ];
			            )
			        }
			    }
			
}