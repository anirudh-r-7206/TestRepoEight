default list All_Engagement_Letters
{

		    displayName = "All Engagement Letters"
		    show all rows from Add_Engagement_Letter
		    (
		        Case
		        Client
		        Fee_Schedule
		        Retainer_Required
		        Retainer_Amount
		        Letter_Status
		        Sent_On
		        Signed_On
		    )
		    filters
		    (
		        Letter_Status
		        Client
		    )
		    sort by
		    (
		        Sent_On descending
		    )
		
}