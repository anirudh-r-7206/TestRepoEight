default list All_Case_Documents
{

		    displayName = "All Case Documents"
		    show all rows from Add_Case_Document
		    (
		        Case
		        Document_Type
		        Document_Title
		        Version_Number
		        Document_Status
		        Confidentiality_Level
		        Review_Required
		        Review_Due_Date
		        Visible_To_Client
		        Document_Date
		    )
		    filters
		    (
		        Case
		        Document_Type
		        Document_Status
		        Confidentiality_Level
		        Visible_To_Client
		    )
		    sort by
		    (
		        Document_Date descending
		    )
		
}