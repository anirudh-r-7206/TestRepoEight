report Active_Practice_Areas
{

		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Practice_Area_Name Category Responsible_Practice_Head Default_Billing_Rate Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
		        action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Practice_Area_Name Category Responsible_Practice_Head Default_Billing_Rate Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		
}