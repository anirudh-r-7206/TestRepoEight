<style>
* {
		padding: 0;
		margin: 0;
		border: none;
		box-sizing: border-box;
		 }
	.zc-pb-embed-placeholder-content {
		overflow: hidden;
	}
	.zc-header .header_top_bar {
		height: 66px !important;
	}

	div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{
		height: 100% !important;
		border: unset !important;
	}
	.zc-pra-nodata {
		text-align: center;
}
.zc-pra-nodata-content {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
}
.zc-pra-nodata svg {
		margin-bottom: 20px;
	width:100px;
	height:100px;
}
.zc-pra-nodata h4, .zc-pra-nodata h5, .zc-pra-nodata h6 {
		font-weight: 400;
		line-height: 1.5;
		letter-spacing: 0.1px;
		color: #131635;
}
.zc-pra-nodata h4 {
		font-size: 20px;
		margin-bottom: 10px;
}
.zc-pra-nodata h6 {
		font-size: 16px;
	    margin-bottom: 10px;
}
zc-pra-nodata-btns {
		margin-top: 24px;
}

@-webkit-keyframes animate-svg-stroke-1 {
	0% {
		stroke-dashoffset: 121.38052083641213px;
		stroke-dasharray: 121.38052083641213px;
	}

	100% {
		stroke-dashoffset: 0;
		stroke-dasharray: 121.38052083641213px;
	}
}

@keyframes animate-svg-stroke-1 {
	0% {
		stroke-dashoffset: 121.38052083641213px;
		stroke-dasharray: 121.38052083641213px;
	}

	100% {
		stroke-dashoffset: 0;
		stroke-dasharray: 121.38052083641213px;
	}
}

@-webkit-keyframes animate-svg-fill-1 {
	0% {
		fill: transparent;
	}

	100% {
		fill: rgb(0, 0, 0);
	}
}

@keyframes animate-svg-fill-1 {
	0% {
		fill: transparent;
	}

	100% {
		fill: rgb(0, 0, 0);
	}
}

.svg-elem-1 {
	-webkit-animation: animate-svg-stroke-1 0.2s cubic-bezier(0.39, 0.575, 0.565, 1) 0s both,
											 animate-svg-fill-1 0.1s cubic-bezier(0.39, 0.575, 0.565, 1) 0s both;
					animation: animate-svg-stroke-1 0.2s cubic-bezier(0.39, 0.575, 0.565, 1) 0s both,
							 animate-svg-fill-1 0.1s cubic-bezier(0.39, 0.575, 0.565, 1) 0s both;
}

