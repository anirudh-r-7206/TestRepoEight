<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>

* {
		padding: 0;
		margin: 0;
		border: none;
		box-sizing: border-box;
		 }
	 div::-webkit-scrollbar, table::-webkit-scrollbar, tr::-webkit-scrollbar, th::-webkit-scrollbar, td::-webkit-scrollbar, ul::-webkit-scrollbar, li::-webkit-scrollbar, a::-webkit-scrollbar, form::-webkit-scrollbar, input::-webkit-scrollbar {
		 display: none;
	}
	div, table, tr, th, td, ul, li, a, form, input {
		-ms-overflow-style: none;
		scrollbar-width: none; 
	}
	.zc-pb-embed-placeholder-content {
		overflow: hidden;
	}
	.zc-header .header_top_bar {
		height: 66px !important;
	}
	div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder{
		height: 100% !important;
		border: unset !important;
	}
	.zc_live_adminbar .zc-container-wrapper {
		height:100% !important;
	}
	.Layout.elemContainment {
		padding: unset !important;
	}
.zc_live_adminbar .zc-container-wrapper {
		height: 100% !important;
	}
:root {
	--primary-color: #467eee;
}

/* ===== LAYOUT ===== */
.innerMainDiv {
	width: 100%;
	height: 100%;
}
.boxContainer {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	border-radius: 10px;
	/*border: 1px solid #ededed;*/
	background: #fff;
	overflow: hidden;
}
.boxHeader {
	background: #ffffff;
	height: 50px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0 20px;
	font-weight: 600;
	color: #000;
	border-bottom: 1px solid #ededed;
}
.boxHeader a {
	text-decoration: none;
	background: var(--primary-color);
	color: #fff;
	padding: 8px 16px;
	border-radius: 8px;
	font-weight: 500;
	font-size: 14px;
	transition: all 0.3s ease;
}
.boxHeader a:hover {
	background: var(--menu_selected_hover_bg_color);
}
.boxContent {
	flex: 1;
	padding: 20px;
	overflow: auto;
	display: flex;
	gap: 20px;
	width: 100%;
	height: 100%;
	flex-wrap: wrap;
	
	align-content: flex-start;
}

/* ===== MAIL TEMPLATE CARDS ===== */
.mail-preview > div:first-child,
.mail-preview > div:last-child {
		display: none !important;
}
.mail-card {
	background: #f8f8f8;
		border: 1px solid #ededed;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
	max-width: 50%;
		width: 300px;
		vertical-align: top;
		transition: all 0.3s ease;
	overflow: hidden;
}
.mail-card:hover {
	background: #eeebfa;
}

/* Dashed separator after each card */
.mail-card:not(:last-child)::after {
	content: "";
	position: absolute;
	top: 10px;
	right: -10px;
	width: 1px;
	height: 95%;
	/*border-right: 2px dashed #ccc;*/
}

/* Header Section */
.card-header {
	padding: 15px 20px;
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	
}
.card-header .subject {
	font-size: 16px;
		font-weight: 600;
		color: #6147e5;
	word-break: break-word;
	white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
}
.card-header .options-container {
	position: relative;
	    transform: rotate(90deg);
}
.options-toggle {
	background: none;
	border: none;
	font-size: 18px;
	color: #a0aec0;
	cursor: pointer;
}
.options-menu {
	position: absolute;
	top: 100%;
	right: 0;
	background: #fff;
	border-radius: 10px;
	box-shadow: 0 10px 30px rgba(0,0,0,0.15);
	width: 180px;
	display: none;
	border: 1px solid #e2e8f0;
	z-index: 5;
}
.options-menu a {
	display: flex;
	align-items: center;
	gap: 10px;
	padding: 12px 15px;
	text-decoration: none;
	color: #4a5568;
	font-size: 14px;
	transition: 0.2s;
}
.options-menu a:hover {
	background: #f7fafc;
	color: var(--primary-color);
}
.options-toggle:focus + .options-menu,
.options-menu:hover {
	display: block;
}

/* Body Section */
.mail-card:hover .card-body{
		background: #eeebfa;
}
.card-body {
	padding: 15px 20px;
	overflow: hidden;
	display: flex;
	height: calc(100% - 53px);
	flex-direction: column;
	justify-content: space-between;
	background: #ffffff;
}
.mail-preview {
	font-size: 14px;
		color: #4a5568;
		line-height: 1.6;
		word-wrap: break-word;
		height: calc(100% - 39px);
		overflow: auto;
}
.mail-meta {
	margin-top: 12px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px;
}
.mail-to {
	font-size: 13px;
	color: #718096;
	font-weight: 500;
	display: flex;
	align-items: center;
	gap: 6px;
}
.mail-to i {
	color: var(--primary-color);
}
.status-badge {
	padding: 6px 12px;
	border-radius: 20px;
	font-size: 12px;
	font-weight: 600;
	text-transform: uppercase;
}
.status-active {
	background: #d1fae5;
	color: #065f46;
}
.status-inactive {
	background: #fee2e2;
	color: #991b1b;
}

/* Empty State */
.noDetailDiv {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 100%;
	color: #626262;
	font-weight: 500;
	width: 100%;
}
@media (max-width:768px){
	.mail-card {
		width: 90%;
		min-width: 90%;
	}
}
</style>

<div class="innerMainDiv">
	<div class="boxContainer">
		<div class="boxHeader">
			<div>All Approval Setup</div>
			<a href="#Form:Add_Approval_Setup?zc_LoadIn=dialog&zc_Header=false&zc_NextUrl=#Script:page.refresh">+ Add Approval Setup</a>

		</div>
		<div class="boxContent">
<%
	fetchSalesOrder = Add_Approval_Setup[Approval_Setup_For != null];
	if(fetchSalesOrder.count() != 0)
	{
		fetchSalesOrder1 = Add_Approval_Setup[ID != null].distinct(Approval_Setup_For);
		for each  rec in fetchSalesOrder1
		{
			%>
<div class="mail-card">
			<a class="card-header" href="#Page:Approval_Setup?zc_LoadIn=embed-embedDiv&recID=<%=rec%>">
	  <div class="subject"><%=Approval_Setup_For[ID == rec].Approval_Setup_For%></div>
				<div class="options-container">
					<button class="options-toggle"><i class="fas fa-ellipsis-v"></i></button>
					
				</div>
			</a>
		 
		</div>
<%
		}
	}
	else
	{
		%>
<style>
/*.zc-content-loader div {
 display: none !important;
}*/
	.main_container_img {
				width: 100%;
				height: 100%;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 15px;
		}
	.img_c {
				animation: fadeInZoom 0.2s ease-in-out forwards;
				object-fit: contain;
				width: 10%;
		}
		</style>
<div class="main_container_img">
<div style="display: flex ; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-content: center; align-items: center;">
		<img class="img_c" src="https://files-accl.zohoexternal.com/public/workdrive-external/download/c4yc5f4e45a3a037f4ceeb726dfdca8d7e886?x-cli-msg=%7B%22linkId%22%3A%226OxchGZlnBc-J8HFH%22%2C%22isFileOwner%22%3Afalse%2C%22version%22%3A%221.0%22%2C%22isWDSupport%22%3Afalse%7D">
	<div style="color: #2f305d; font-weight:600;"> No Data Available</div></div>
</div>
<%
	}
	%>
</div>
	</div>
</div>