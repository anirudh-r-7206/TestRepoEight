				<div class="cd-card-header"><div class="cd-card-title"><h2>Settlement Offers</h2><p><%=Add_Settlement_Offer[Case == caseRec.ID].count()%> offers and responses</p></div><div class="cd-section-actions"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Settlement_Offer?Case=<%=caseRec.ID%>&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Add Offer</span></a></div></div>
				<div class="cd-scroll">
<%
		if(settleRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No settlement offers</h5><p class="cd-empty-text">Track offers, counteroffers, terms, review notes, and accepted settlements.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full cd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">By</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
			for each so in settleRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=ifnull(so.Offer_Date,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(so.Offered_By,"-")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(so.Offer_Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(so.Offer_Status,"-")%></td></tr>
<%
			}
%>
					</tbody></table></div>
<%
		}
%>
				</div>
			</div>
<%
		timeRows = Add_Time_Entry[Case == caseRec.ID] sort by Entry_Date desc range from 1 to 20;
%>
			<div class="cd-related">
				<div class="cd-card-header"><div class="cd-card-title"><h2>Time Entries</h2><p><%=Add_Time_Entry[Case == caseRec.ID].count()%> time records</p></div><div class="cd-section-actions"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Time_Entry?Case=<%=caseRec.ID%>&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Add Time</span></a></div></div>
				<div class="cd-scroll">
<%
		if(timeRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No time entries</h5><p class="cd-empty-text">Record legal work, review, court appearances, negotiations, and client calls.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full cd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Activity</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Hours</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
			for each te in timeRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=ifnull(te.Entry_Date,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(te.Activity_Type,"-")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right"><%=ifnull(te.Hours,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(te.Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(te.Approval_Status,"-")%></td></tr>
<%
			}
%>
					</tbody></table></div>
<%
		}
%>
				</div>
			</div>
<%
		expenseRows = Add_Expense_Entry[Case == caseRec.ID] sort by Expense_Date desc range from 1 to 20;
%>
			<div class="cd-related">
				<div class="cd-card-header"><div class="cd-card-title"><h2>Expense Entries</h2><p><%=Add_Expense_Entry[Case == caseRec.ID].count()%> expense records</p></div><div class="cd-section-actions"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Expense_Entry?Case=<%=caseRec.ID%>&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Add Expense</span></a></div></div>
				<div class="cd-scroll">
<%
		if(expenseRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No expenses</h5><p class="cd-empty-text">Add court fees, travel, filing costs, expert fees, or other reimbursable expenses.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full cd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Category</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
			for each ex in expenseRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=ifnull(ex.Expense_Date,"-")%></td><td class="zcs-px-16 zcs-py-8"><div class="cd-main"><%=ifnull(ex.Expense_Category,"-")%></div><div class="cd-sub"><%=ifnull(ex.Vendor,"")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(ex.Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(ex.Approval_Status,"-")%></td></tr>
<%
			}
%>
					</tbody></table></div>
<%
		}
%>
				</div>
			</div>
<%
		invoiceRows = Create_Invoice[Case == caseRec.ID] sort by Invoice_Date desc range from 1 to 20;
%>
			<div class="cd-related">
				<div class="cd-card-header"><div class="cd-card-title"><h2>Invoices</h2><p><%=Create_Invoice[Case == caseRec.ID].count()%> invoices</p></div><div class="cd-section-actions"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Create_Invoice?Case=<%=caseRec.ID%>&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Create Invoice</span></a></div></div>
				<div class="cd-scroll">
<%
		if(invoiceRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No invoices</h5><p class="cd-empty-text">Create invoices after time and expenses are approved for billing.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full cd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Invoice</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Total</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Balance</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
			for each inv in invoiceRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><a class="cd-main" href="#Page:Billing_Detail?Invoice_ID=<%=inv.ID%>"><%=ifnull(inv.Invoice_Number,inv.ID)%></a></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(inv.Invoice_Date,"-")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(inv.Total_Amount,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(inv.Balance_Due,0)%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(inv.Invoice_Status,"-")%></td></tr>
<%
			}
%>
					</tbody></table></div>
<%
		}
%>
				</div>
			</div>
<%
		paymentRows = Add_Payment[Case == caseRec.ID] sort by Payment_Date desc range from 1 to 20;
%>
			<div class="cd-related">
				<div class="cd-card-header"><div class="cd-card-title"><h2>Payments</h2><p><%=Add_Payment[Case == caseRec.ID].count()%> payments</p></div><div class="cd-section-actions"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Payment?Case=<%=caseRec.ID%>&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span class="zcs-button-text">Add Payment</span></a></div></div>
				<div class="cd-scroll">
<%
		if(paymentRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No payments</h5><p class="cd-empty-text">Record payment receipts, reconciliations, refunds, or bounced payments.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full cd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Invoice</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
			for each pay in paymentRows
			{
				payInvoice = "-";
				if(pay.Invoice != null)
				{
					pi = Create_Invoice[ID == pay.Invoice];
					if(pi.count() > 0){payInvoice = ifnull(pi.Invoice_Number,pi.ID);}
				}
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=payInvoice%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(pay.Payment_Date,"-")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(pay.Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(pay.Payment_Status,"-")%></td></tr>
<%
			}
%>
					</tbody></table></div>
<%
		}
%>
				</div>
			</div>
<%
		historyRows = Add_Case_History[Case == caseRec.ID] sort by Event_Date desc range from 1 to 50;
%>
			<div class="cd-related cd-related-full">
				<div class="cd-card-header"><div class="cd-card-title"><h2>Case History</h2><p><%=Add_Case_History[Case == caseRec.ID].count()%> audit events</p></div></div>
				<div class="cd-history-scroll">
<%
		if(historyRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No history yet</h5><p class="cd-empty-text">Lifecycle changes and related-record events will appear here after workflows run.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full cd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Event</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status Change</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Summary</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Client Visible</th></tr></thead><tbody>
<%
			for each hist in historyRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Event_Type,"System")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Event_Date,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Previous_Status,"-")%> → <%=ifnull(hist.New_Status,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Summary,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=if(hist.Visible_To_Client == true,"Yes","No")%></td></tr>
<%
			}
%>
					</tbody></table></div>
<%
		}
%>
				</div>
			</div>
		</div>
<%
	}
%>
	</div>
</div>