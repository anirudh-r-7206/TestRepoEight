<%
draftCount = Create_Invoice[Invoice_Status == "Draft"].count();
submittedReviewCount = Create_Invoice[Invoice_Status == "Submitted for Review"].count();
approvedCount = Create_Invoice[Invoice_Status == "Approved"].count();
sentCount = Create_Invoice[Invoice_Status == "Sent"].count();
overdueCount = Create_Invoice[Invoice_Status == "Overdue" || (Due_Date < zoho.currentdate && Balance_Due > 0 && Invoice_Status != "Paid" && Invoice_Status != "Cancelled")].count();
paidCount = Create_Invoice[Invoice_Status == "Paid"].count();
cancelledCount = Create_Invoice[Invoice_Status == "Cancelled"].count();
allInvoiceCount = Create_Invoice.count();
outstandingBalance = Create_Invoice[Invoice_Status != "Paid" && Invoice_Status != "Cancelled"].sum(Balance_Due);
if(outstandingBalance == null)
{
		outstandingBalance = 0;
}
overdueBalance = Create_Invoice[Invoice_Status == "Overdue" || (Due_Date < zoho.currentdate && Balance_Due > 0 && Invoice_Status != "Paid" && Invoice_Status != "Cancelled")].sum(Balance_Due);
if(overdueBalance == null)
{
		overdueBalance = 0;
}
reviewQueueCount = submittedReviewCount + approvedCount;
%>
<style>
/* ===== zcs-global.css: utility subset included once for this page ===== */
:root {
		--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);
		--zcs_brand_color: #6147E5;
		--zcs_brand_foreground_color: #FFFFFF;
		--zcs_brand_dark_color: #4E38C8;
		--zcs_brand_light_color: #F1EEFF;
		--zcs_primary_text_color: #17142F;
		--zcs_secondary_text_color: #4F5873;
		--zcs_tertiary_text_color: #7A8094;
		--zcs_tertiary_border_color: #E7E8F0;
		--zcs_primary_border_color: #E0E2EA;
		--zcs_component_hover_color: #F4F1FF;
		--zcs_light_grey_color: #F7F8FC;
		--zcs-white-color: #FFFFFF;
		--zcs-page-bg-color: #F6F7FB;
		--bw-primary: #6147E5;
		--bw-primary-dark: #4E38C8;
		--bw-primary-light: #F1EEFF;
		--bw-bg: #F6F7FB;
		--bw-surface: #FFFFFF;
		--bw-border: #E7E8F0;
		--bw-text: #17142F;
		--bw-muted: #667085;
		--bw-success: #179E6C;
		--bw-warning: #B8770D;
		--bw-danger: #D92D20;
		--bw-info: #2A6FFC;
		--bw-gap: 15px;
		--bw-radius: 12px;
		font-size: 16px;
		line-height: 1.5;
}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-p-0{padding:0}.zcs-p-10{padding:10px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-px-6{padding-left:6px;padding-right:6px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-py-0{padding-top:0;padding-bottom:0}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}

/* ===== ZCS component CSS: button-primary-button and button-secondary-button ===== */
.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0;transition:background .15s ease,border-color .15s ease,color .15s ease}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-secondary-button:hover,.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus,.zcs-secondary-button.zcs-button:active,.zcs-secondary-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-button-text{white-space:nowrap}

/* ===== ZCS component CSS: horizontal-tab-horizontal-tab-with-count ===== */
.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style-type:none;border-bottom:2px solid transparent;letter-spacing:.1px;flex:0 0 auto}.zcs-horizontal-tablink{cursor:pointer;min-height:46px}.zcs-horizontal-tabtext{text-wrap:nowrap}.zcs-horizontal-tabcount{min-width:22px;background-color:var(--zcs-page-bg-color);border:1px solid transparent}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabitem:hover .zcs-horizontal-tabcount{background-color:var(--zcs_component_hover_color)}.zcs-horizontal-tabbody{overflow:auto}

/* ===== ZCS component CSS: header-heading-with-actions adapted for this page ===== */
.zcs-page-header{background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%);border:1px solid var(--bw-border);border-radius:var(--bw-radius);box-shadow:0 2px 8px 0 rgba(23,20,47,.04)}

/* ===== Billing Workspace approved CSS block ===== */
*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.billing-workspace-page{width:100%;min-height:100%;background:var(--bw-bg);color:var(--bw-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--bw-gap);overflow:auto}.billing-workspace-stack{display:flex;flex-direction:column;gap:var(--bw-gap);max-width:1600px;margin:0 auto}.billing-header-copy{min-width:0;display:flex;flex-direction:column;gap:6px}.billing-header-title-row{display:flex;align-items:center;gap:10px;min-width:0}.billing-header-icon{width:36px;height:36px;border-radius:10px;background:var(--bw-primary-light);color:var(--bw-primary);display:inline-flex;align-items:center;justify-content:center;font-size:18px}.billing-header-kicker{margin:0;color:var(--bw-muted);max-width:860px}.billing-header-meta{display:flex;gap:8px;flex-wrap:wrap}.billing-meta-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(97,71,229,.16);background:#FFFFFF;color:var(--bw-muted);border-radius:999px;padding:5px 10px;font-size:12px}.billing-meta-pill i{color:var(--bw-primary);font-size:14px}.billing-header-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.billing-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(180px,1fr));gap:var(--bw-gap)}.billing-kpi-card{background:#fff;border:1px solid var(--bw-border);border-radius:var(--bw-radius);padding:15px;min-height:96px;display:flex;gap:12px;align-items:flex-start}.billing-kpi-icon{width:38px;height:38px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.billing-kpi-icon.violet{background:var(--bw-primary-light);color:var(--bw-primary)}.billing-kpi-icon.blue{background:#E8EFFF;color:var(--bw-info)}.billing-kpi-icon.red{background:#FDE3E6;color:var(--bw-danger)}.billing-kpi-icon.green{background:#E4FCF3;color:var(--bw-success)}.billing-kpi-copy{min-width:0}.billing-kpi-label{margin:0;color:var(--bw-muted);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}.billing-kpi-value{margin:6px 0 0;color:var(--bw-text);font-size:23px;font-weight:700;line-height:1.1;word-break:break-word}.billing-kpi-note{margin:5px 0 0;color:var(--bw-muted);font-size:12px}.billing-tab-radio{position:absolute;opacity:0;pointer-events:none}.billing-tabs-shell{background:#fff;border:1px solid var(--bw-border);border-radius:var(--bw-radius);overflow:hidden}.billing-tab-panels{padding:15px;background:#fff}.billing-tab-panel{display:none}.billing-tab-context{display:flex;justify-content:space-between;align-items:center;gap:15px;border:1px solid var(--bw-border);border-radius:10px;background:#FCFCFF;padding:12px 15px;margin-bottom:12px}.billing-tab-title{display:flex;align-items:center;gap:8px;min-width:0;color:var(--bw-text);font-weight:700}.billing-tab-title i{color:var(--bw-primary);font-size:16px}.billing-tab-hint{color:var(--bw-muted);font-size:12px}.billing-report-frame{min-height:650px;width:100%;border:1px solid var(--bw-border);border-radius:10px;overflow:auto;background:#FFFFFF}.billing-detail-note{display:inline-flex;align-items:center;gap:6px;color:var(--bw-muted);font-size:12px}.billing-detail-note i{color:var(--bw-primary)}

#bw-tab-draft:checked ~ .billing-tabs-shell label[for='bw-tab-draft'],#bw-tab-review:checked ~ .billing-tabs-shell label[for='bw-tab-review'],#bw-tab-approved:checked ~ .billing-tabs-shell label[for='bw-tab-approved'],#bw-tab-sent:checked ~ .billing-tabs-shell label[for='bw-tab-sent'],#bw-tab-overdue:checked ~ .billing-tabs-shell label[for='bw-tab-overdue'],#bw-tab-paid:checked ~ .billing-tabs-shell label[for='bw-tab-paid'],#bw-tab-all:checked ~ .billing-tabs-shell label[for='bw-tab-all']{color:var(--bw-primary)}
#bw-tab-draft:checked ~ .billing-tabs-shell label[for='bw-tab-draft'] .zcs-horizontal-tabcount,#bw-tab-review:checked ~ .billing-tabs-shell label[for='bw-tab-review'] .zcs-horizontal-tabcount,#bw-tab-approved:checked ~ .billing-tabs-shell label[for='bw-tab-approved'] .zcs-horizontal-tabcount,#bw-tab-sent:checked ~ .billing-tabs-shell label[for='bw-tab-sent'] .zcs-horizontal-tabcount,#bw-tab-overdue:checked ~ .billing-tabs-shell label[for='bw-tab-overdue'] .zcs-horizontal-tabcount,#bw-tab-paid:checked ~ .billing-tabs-shell label[for='bw-tab-paid'] .zcs-horizontal-tabcount,#bw-tab-all:checked ~ .billing-tabs-shell label[for='bw-tab-all'] .zcs-horizontal-tabcount{background:var(--bw-primary-light);color:var(--bw-primary);border-color:rgba(97,71,229,.18)}
#bw-tab-draft:checked ~ .billing-tabs-shell .tabitem-draft,#bw-tab-review:checked ~ .billing-tabs-shell .tabitem-review,#bw-tab-approved:checked ~ .billing-tabs-shell .tabitem-approved,#bw-tab-sent:checked ~ .billing-tabs-shell .tabitem-sent,#bw-tab-overdue:checked ~ .billing-tabs-shell .tabitem-overdue,#bw-tab-paid:checked ~ .billing-tabs-shell .tabitem-paid,#bw-tab-all:checked ~ .billing-tabs-shell .tabitem-all{border-bottom-color:var(--bw-primary)}
#bw-tab-draft:checked ~ .billing-tabs-shell #panel-draft,#bw-tab-review:checked ~ .billing-tabs-shell #panel-review,#bw-tab-approved:checked ~ .billing-tabs-shell #panel-approved,#bw-tab-sent:checked ~ .billing-tabs-shell #panel-sent,#bw-tab-overdue:checked ~ .billing-tabs-shell #panel-overdue,#bw-tab-paid:checked ~ .billing-tabs-shell #panel-paid,#bw-tab-all:checked ~ .billing-tabs-shell #panel-all{display:block}
@media (max-width:1100px){.billing-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.zcs-page-header{align-items:flex-start;flex-direction:column}.billing-header-actions{justify-content:flex-start}}
@media (max-width:768px){.billing-workspace-page{padding:10px}.zcs-page-header{padding:14px 16px}.billing-tab-panels{padding:10px}.billing-tab-context{align-items:flex-start;flex-direction:column}.billing-report-frame{min-height:560px}}
@media (max-width:576px){.billing-kpi-grid{grid-template-columns:1fr}.billing-header-actions,.billing-header-actions .zcs-button{width:100%}.zcs-horizontal-tablink{padding-left:8px;padding-right:8px}.billing-meta-pill{width:100%;justify-content:flex-start}}
</style>

<div class='billing-workspace-page'>
		<div class='billing-workspace-stack'>
				<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-15 zcs-px-30 zcs-py-24 zcs-box-border'>
						<div class='billing-header-copy'>
								<div class='billing-header-title-row'>
										<span class='billing-header-icon'><i class='zc-li-outline business-money-time'></i></span>
										<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'>Billing Workspace</h5>
								</div>
								<p class='billing-header-kicker'>Manage invoice queues with status tabs, live counts, and embedded filtered reports. Actions are section-level only; no custom report buttons are added.</p>
								<div class='billing-header-meta'>
										<span class='billing-meta-pill'><i class='zc-li-outline files-paper'></i> Total invoices: <%=allInvoiceCount%></span>
										<span class='billing-meta-pill'><i class='zc-li-outline ui-1-check-circle-08'></i> Review and approval queue: <%=reviewQueueCount%></span>
										<span class='billing-meta-pill'><i class='zc-li-outline ui-2-time'></i> Overdue: <%=overdueCount%></span>
								</div>
						</div>
						<div class='billing-header-actions'>
								<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Create_Invoice?zc_LoadIn=dialog'>
										<i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
										<span class='zcs-button-text'>Create Invoice</span>
								</a>
								<a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Add_Payment?zc_LoadIn=dialog'>
										<i class='zcs-button-icon zc-li-outline business-money-time'></i>
										<span class='zcs-button-text'>Add Payment</span>
								</a>
								<a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Add_Time_Entry?zc_LoadIn=dialog'>
										<i class='zcs-button-icon zc-li-outline ui-2-time'></i>
										<span class='zcs-button-text'>Add Time Entry</span>
								</a>
								<a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Add_Expense_Entry?zc_LoadIn=dialog'>
										<i class='zcs-button-icon zc-li-outline files-paper'></i>
										<span class='zcs-button-text'>Add Expense Entry</span>
								</a>
						</div>
				</div>

				<div class='billing-kpi-grid'>
						<div class='billing-kpi-card'>
								<span class='billing-kpi-icon violet'><i class='zc-li-outline files-paper'></i></span>
								<div class='billing-kpi-copy'><p class='billing-kpi-label'>Draft invoices</p><p class='billing-kpi-value'><%=draftCount%></p><p class='billing-kpi-note'>Ready for preparation before review.</p></div>
						</div>
						<div class='billing-kpi-card'>
								<span class='billing-kpi-icon blue'><i class='zc-li-outline ui-1-check-circle-08'></i></span>
								<div class='billing-kpi-copy'><p class='billing-kpi-label'>Review queue</p><p class='billing-kpi-value'><%=reviewQueueCount%></p><p class='billing-kpi-note'>Submitted and approved invoices.</p></div>
						</div>
						<div class='billing-kpi-card'>
								<span class='billing-kpi-icon red'><i class='zc-li-outline ui-2-time'></i></span>
								<div class='billing-kpi-copy'><p class='billing-kpi-label'>Overdue balance</p><p class='billing-kpi-value'><%=overdueBalance%></p><p class='billing-kpi-note'>Invoices past due or marked overdue.</p></div>
						</div>
						<div class='billing-kpi-card'>
								<span class='billing-kpi-icon green'><i class='zc-li-outline business-money-time'></i></span>
								<div class='billing-kpi-copy'><p class='billing-kpi-label'>Outstanding balance</p><p class='billing-kpi-value'><%=outstandingBalance%></p><p class='billing-kpi-note'>Open invoice balance excluding paid/cancelled.</p></div>
						</div>
				</div>

				<input class='billing-tab-radio' type='radio' name='billing_workspace_status' id='bw-tab-draft' checked='checked'>
				<input class='billing-tab-radio' type='radio' name='billing_workspace_status' id='bw-tab-review'>
				<input class='billing-tab-radio' type='radio' name='billing_workspace_status' id='bw-tab-approved'>
				<input class='billing-tab-radio' type='radio' name='billing_workspace_status' id='bw-tab-sent'>
				<input class='billing-tab-radio' type='radio' name='billing_workspace_status' id='bw-tab-overdue'>
				<input class='billing-tab-radio' type='radio' name='billing_workspace_status' id='bw-tab-paid'>
				<input class='billing-tab-radio' type='radio' name='billing_workspace_status' id='bw-tab-all'>

				<div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full billing-tabs-shell'>
						<ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border' role='tablist'>
								<li class='zcs-horizontal-tabitem tabitem-draft'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='bw-tab-draft'><span class='zcs-horizontal-tabtext zcs-font-15'>Draft</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=draftCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-review'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='bw-tab-review'><span class='zcs-horizontal-tabtext zcs-font-15'>Submitted for Review</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=submittedReviewCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-approved'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='bw-tab-approved'><span class='zcs-horizontal-tabtext zcs-font-15'>Approved</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=approvedCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-sent'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='bw-tab-sent'><span class='zcs-horizontal-tabtext zcs-font-15'>Sent</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=sentCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-overdue'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='bw-tab-overdue'><span class='zcs-horizontal-tabtext zcs-font-15'>Overdue</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=overdueCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-paid'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='bw-tab-paid'><span class='zcs-horizontal-tabtext zcs-font-15'>Paid</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=paidCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-all'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='bw-tab-all'><span class='zcs-horizontal-tabtext zcs-font-15'>Cancelled/All</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=cancelledCount%>/<%=allInvoiceCount%></span></label></li>
						</ul>

						<div class='zcs-horizontal-tabbody zcs-col-common billing-tab-panels'>
								<section class='billing-tab-panel' id='panel-draft'>
										<div class='billing-tab-context'><div class='billing-tab-title'><i class='zc-li-outline files-paper'></i><span>Draft invoices</span></div><div class='billing-tab-hint'>Prepare invoices for submission without report-level add buttons.</div></div>
										<div class='billing-report-frame' zc-component='report' zc-linkname='Draft_Invoices' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='billing-tab-panel' id='panel-review'>
										<div class='billing-tab-context'><div class='billing-tab-title'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Submitted for Review invoices</span></div><div class='billing-tab-hint'>Review submitted invoices. Lifecycle actions are handled from billing detail pages where configured.</div></div>
										<div class='billing-report-frame' zc-component='report' zc-linkname='Invoices_For_Approval' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='billing-tab-panel' id='panel-approved'>
										<div class='billing-tab-context'><div class='billing-tab-title'><i class='zc-li-outline ui-1-check-bold'></i><span>Approved invoices</span></div><div class='billing-tab-hint'>Approved invoices are shown through All Invoices with an approved-status embed criterion until a dedicated report is added.</div></div>
										<div class='billing-report-frame' zc-component='report' zc-linkname='all_invoices' zc-criteria='Invoice_Status == "Approved"' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='billing-tab-panel' id='panel-sent'>
										<div class='billing-tab-context'><div class='billing-tab-title'><i class='zc-li-outline arrows-1-tail-right'></i><span>Sent invoices</span></div><div class='billing-tab-hint'>Track invoices sent to clients and add payments from the section action above.</div></div>
										<div class='billing-report-frame' zc-component='report' zc-linkname='Sent_Invoices' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='billing-tab-panel' id='panel-overdue'>
										<div class='billing-tab-context'><div class='billing-tab-title'><i class='zc-li-outline ui-2-time'></i><span>Overdue invoices</span></div><div class='billing-tab-hint'>Invoices marked overdue or past due with an open balance.</div></div>
										<div class='billing-report-frame' zc-component='report' zc-linkname='Overdue_Invoices' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='billing-tab-panel' id='panel-paid'>
										<div class='billing-tab-context'><div class='billing-tab-title'><i class='zc-li-outline business-money-time'></i><span>Paid invoices</span></div><div class='billing-tab-hint'>Completed billing records retained for reconciliation and audit review.</div></div>
										<div class='billing-report-frame' zc-component='report' zc-linkname='Paid_Invoices' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='billing-tab-panel' id='panel-all'>
										<div class='billing-tab-context'><div class='billing-tab-title'><i class='zc-li-outline files-folder-14'></i><span>Cancelled and all invoices</span></div><div class='billing-tab-hint'><span class='billing-detail-note'><i class='zc-li-outline ui-1-link-69'></i>Open records through report-native detail links and Billing Detail links where available.</span></div></div>
										<div class='billing-report-frame' zc-component='report' zc-linkname='all_invoices' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
						</div>
				</div>
		</div>
</div>