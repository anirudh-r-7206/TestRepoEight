										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Open_Matter' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='case-tab-panel' id='panel-strategy-pleadings'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline business-hammer'></i><span>Strategy and Pleadings matters</span></div><div class='case-tab-hint'>Track active legal strategy and pleading preparation queues.</div></div>
