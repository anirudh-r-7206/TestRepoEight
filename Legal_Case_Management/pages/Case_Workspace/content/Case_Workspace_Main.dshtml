								</section>
								<section class='case-tab-panel' id='panel-discovery-diligence'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline ui-1-zoom'></i><span>Discovery and Diligence matters</span></div><div class='case-tab-hint'>Browse matters in discovery, due diligence, and evidence gathering.</div></div>
										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Discovery_and_Diligence' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='case-tab-panel' id='panel-negotiation-mediation'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline users-multiple-11'></i><span>Negotiation and Mediation matters</span></div><div class='case-tab-hint'>Review settlement and mediation-stage matter queues.</div></div>
										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Negotiation_and_Mediation' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='case-tab-panel' id='panel-hearing-trial'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline business-scale'></i><span>Hearing and Trial matters</span></div><div class='case-tab-hint'>Monitor matters currently in hearings, trial preparation, or trial.</div></div>
										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Hearing_and_Trial' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='case-tab-panel' id='panel-awaiting-order-execution'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline ui-2-time'></i><span>Awaiting Order or Execution matters</span></div><div class='case-tab-hint'>Track matters awaiting final order, enforcement, execution, or billing handoff.</div></div>
										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Awaiting_Order_or_Execution' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='case-tab-panel' id='panel-billing-review'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline business-money-time'></i><span>Billing Review matters</span></div><div class='case-tab-hint'>Review matters ready for billing workflow and financial closure.</div></div>
										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Billing_Review' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='case-tab-panel' id='panel-closed'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Closed matters</span></div><div class='case-tab-hint'>Closed matters remain available for detail review and archive transition workflows.</div></div>
										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Closed' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
								</section>
								<section class='case-tab-panel' id='panel-archived'>
										<div class='case-tab-context'><div class='case-tab-title'><i class='zc-li-outline files-archive-3d-content'></i><span>Archived matters</span></div><div class='case-tab-hint'>Reference archived legal matters with report-native detail access.</div></div>
										<div class='case-report-frame' zc-component='report' zc-linkname='Cases_Archived' zc_Header='false' zc_Search='false' zc_AddRec='false'></div>
