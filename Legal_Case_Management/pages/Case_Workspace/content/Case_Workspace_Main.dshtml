<%
newIntakeCount = Create_Case[Case_Status == "New Intake"].count();
conflictCheckCount = Create_Case[Case_Status == "Conflict Check"].count();
engagementPendingCount = Create_Case[Case_Status == "Engagement Pending"].count();
openMatterCount = Create_Case[Case_Status == "Open Matter"].count();
strategyPleadingsCount = Create_Case[Case_Status == "Strategy and Pleadings"].count();
discoveryDiligenceCount = Create_Case[Case_Status == "Discovery and Diligence"].count();
negotiationMediationCount = Create_Case[Case_Status == "Negotiation and Mediation"].count();
hearingTrialCount = Create_Case[Case_Status == "Hearing and Trial"].count();
awaitingOrderExecutionCount = Create_Case[Case_Status == "Awaiting Order or Execution"].count();
billingReviewCount = Create_Case[Case_Status == "Billing Review"].count();
closedCount = Create_Case[Case_Status == "Closed"].count();
archivedCount = Create_Case[Case_Status == "Archived"].count();
rejectedCount = Create_Case[Case_Status == "Rejected"].count();
activeLifecycleCount = newIntakeCount + conflictCheckCount + engagementPendingCount + openMatterCount + strategyPleadingsCount + discoveryDiligenceCount + negotiationMediationCount + hearingTrialCount + awaitingOrderExecutionCount + billingReviewCount;
totalCaseCount = activeLifecycleCount + closedCount + archivedCount + rejectedCount;
%>
<style>
/* ===== ZCS global utility subset for this page (zcs-global included once) ===== */
:root {
		--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);
		--zcs-page-bg-color: var(--zcs_page_bg_color, #F6F5FB);
		--zcs-primary-text-color: var(--zcs_primary_text_color, #1F2433);
		--zcs-secondary-text-color: var(--zcs_secondary_text_color, #5F667A);
		--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7B8192);
		--zcs-border-color: var(--zcs_tertiary_border_color, #E6E3F2);
		--zcs-white-color: #FFFFFF;
		--zcs-brand-color: var(--zcs_brand_color, #6147E5);
		--zcs-brand-foreground-color: var(--zcs_brand_foreground_color, #FFFFFF);
		--zcs-component-hover-color: var(--zcs_component_hover_color, #F1EEFF);
		--case-brand: var(--zcs_brand_color, #6147E5);
		--case-brand-light: var(--zcs_brand_light_color, #F1EEFF);
		--case-brand-dark: var(--zcs_brand_dark_color, #4E37C9);
		--case-text: var(--zcs_primary_text_color, #1F2433);
		--case-muted: var(--zcs_secondary_text_color, #667085);
		--case-border: var(--zcs_tertiary_border_color, #E5E1F2);
		--case-bg: #F7F6FB;
		--case-card-bg: #FFFFFF;
		--case-radius: 12px;
		--case-gap: 15px;
		font-size: 16px;
		line-height: 1.5;
}
.zcs-flex { display: flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-8 { gap: 0.5rem; }
.zcs-gap-12 { gap: 0.75rem; }
.zcs-px-6 { padding-left: 0.375rem; padding-right: 0.375rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-py-0 { padding-top: 0; padding-bottom: 0; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-w-full { width: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-col-common { flex: 1 1 0%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-rounded-sm { border-radius: 0.25rem; }
.zcs-rounded-md { border-radius: 0.375rem; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-15 { font-size: 0.9375rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ===== ZCS Header with Button component ===== */
.zcs-page-header {
		background: var(--case-card-bg);
		border: 1px solid var(--case-border);
		border-radius: var(--case-radius);
		box-shadow: 0 8px 24px rgba(34, 24, 77, 0.06);
}
.zcs-button {
		width: auto;
		min-width: 5rem;
		min-height: 36px;
		text-decoration: none;
		transition: background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}
.zcs-primary-button {
		background-color: var(--case-brand);
		color: var(--zcs_brand_foreground_color, #FFFFFF);
}
.zcs-primary-button.zcs-button:hover {
		background-color: var(--case-brand-dark);
		color: var(--zcs_brand_foreground_color, #FFFFFF);
}
.zcs-primary-button.zcs-button:focus {
		outline: 2px solid var(--case-brand);
		outline-offset: 2px;
}
.zcs-button-icon {
		width: 16px;
		max-height: 16px;
}

/* ===== ZCS Horizontal Tab With Count component, adapted to radio labels ===== */
.zcs-horizontal-tabhead {
		box-shadow: 0 -1px 0 0 var(--case-border) inset;
		overflow-x: auto;
		overflow-y: hidden;
		-ms-overflow-style: none;
		scrollbar-width: none;
}
.zcs-horizontal-tabhead::-webkit-scrollbar { display: none; }
.zcs-horizontal-tabitem {
		list-style-type: none;
		border-bottom: 2px solid transparent;
		letter-spacing: 0.1px;
		flex: 0 0 auto;
}
.zcs-horizontal-tablink {
		text-decoration: none;
		cursor: pointer;
		border: 0;
		background: transparent;
		min-height: 48px;
}
.zcs-horizontal-tabtext { white-space: nowrap; }
.zcs-horizontal-tabcount {
		min-width: 24px;
		background-color: var(--case-bg);
		color: var(--case-muted);
		border: 1px solid transparent;
}
.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--case-brand); }
.zcs-horizontal-tabitem:hover .zcs-horizontal-tabcount { background-color: var(--case-brand-light); }
.zcs-horizontal-tabbody { overflow: auto; }

/* ===== Supplied Case Workspace page CSS block ===== */
.case-workspace-page,
.case-workspace-page * {
		box-sizing: border-box;
}
.case-workspace-page {
		width: 100%;
		min-height: 100%;
		padding: var(--case-gap);
		background: var(--case-bg);
		color: var(--case-text);
		font-family: Lato, Arial, sans-serif;
		font-size: 14px;
}
.case-workspace-stack {
		display: flex;
		flex-direction: column;
		gap: var(--case-gap);
		width: 100%;
}
.case-header-copy {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
}
.case-header-kicker {
		margin: 0;
		color: var(--case-muted);
		font-size: 12px;
		line-height: 1.4;
}
.case-header-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		margin-top: 2px;
		color: var(--case-muted);
		font-size: 12px;
}
.case-meta-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 8px;
		border: 1px solid var(--case-border);
		border-radius: 999px;
		background: #FBFAFF;
		color: var(--case-muted);
}
.case-tabs-shell {
		background: var(--case-card-bg);
		border: 1px solid var(--case-border);
		border-radius: var(--case-radius);
		box-shadow: 0 8px 24px rgba(34, 24, 77, 0.06);
		overflow: hidden;
}
.case-tab-radio {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
}
.case-tab-panels {
		padding: var(--case-gap);
		background: #FFFFFF;
}
.case-tab-panel {
		display: none;
}
.case-tab-context {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		padding: 0 0 12px 0;
		border-bottom: 1px solid var(--case-border);
		margin-bottom: 12px;
}
.case-tab-title {
		display: flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
		color: var(--case-text);
		font-weight: 600;
}
.case-tab-title i {
		color: var(--case-brand);
		font-size: 16px;
}
.case-tab-hint {
		color: var(--case-muted);
		font-size: 12px;
}
.case-report-frame {
		min-height: 650px;
		width: 100%;
		border: 1px solid var(--case-border);
		border-radius: 10px;
		overflow: auto;
		background: #FFFFFF;
}
.case-empty-note {
		color: var(--case-muted);
		font-size: 12px;
}

#cw-tab-new-intake:checked ~ .case-tabs-shell label[for='cw-tab-new-intake'],
#cw-tab-conflict-check:checked ~ .case-tabs-shell label[for='cw-tab-conflict-check'],
#cw-tab-engagement-pending:checked ~ .case-tabs-shell label[for='cw-tab-engagement-pending'],
#cw-tab-open-matter:checked ~ .case-tabs-shell label[for='cw-tab-open-matter'],
#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell label[for='cw-tab-strategy-pleadings'],
#cw-tab-discovery-diligence:checked ~ .case-tabs-shell label[for='cw-tab-discovery-diligence'],
#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell label[for='cw-tab-negotiation-mediation'],
#cw-tab-hearing-trial:checked ~ .case-tabs-shell label[for='cw-tab-hearing-trial'],
#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell label[for='cw-tab-awaiting-order-execution'],
#cw-tab-billing-review:checked ~ .case-tabs-shell label[for='cw-tab-billing-review'],
#cw-tab-closed:checked ~ .case-tabs-shell label[for='cw-tab-closed'],
#cw-tab-archived:checked ~ .case-tabs-shell label[for='cw-tab-archived'],
#cw-tab-rejected:checked ~ .case-tabs-shell label[for='cw-tab-rejected'] {
		color: var(--case-brand);
}
#cw-tab-new-intake:checked ~ .case-tabs-shell label[for='cw-tab-new-intake'] .zcs-horizontal-tabcount,
#cw-tab-conflict-check:checked ~ .case-tabs-shell label[for='cw-tab-conflict-check'] .zcs-horizontal-tabcount,
#cw-tab-engagement-pending:checked ~ .case-tabs-shell label[for='cw-tab-engagement-pending'] .zcs-horizontal-tabcount,
#cw-tab-open-matter:checked ~ .case-tabs-shell label[for='cw-tab-open-matter'] .zcs-horizontal-tabcount,
#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell label[for='cw-tab-strategy-pleadings'] .zcs-horizontal-tabcount,
#cw-tab-discovery-diligence:checked ~ .case-tabs-shell label[for='cw-tab-discovery-diligence'] .zcs-horizontal-tabcount,
#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell label[for='cw-tab-negotiation-mediation'] .zcs-horizontal-tabcount,
#cw-tab-hearing-trial:checked ~ .case-tabs-shell label[for='cw-tab-hearing-trial'] .zcs-horizontal-tabcount,
#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell label[for='cw-tab-awaiting-order-execution'] .zcs-horizontal-tabcount,
#cw-tab-billing-review:checked ~ .case-tabs-shell label[for='cw-tab-billing-review'] .zcs-horizontal-tabcount,
#cw-tab-closed:checked ~ .case-tabs-shell label[for='cw-tab-closed'] .zcs-horizontal-tabcount,
#cw-tab-archived:checked ~ .case-tabs-shell label[for='cw-tab-archived'] .zcs-horizontal-tabcount,
#cw-tab-rejected:checked ~ .case-tabs-shell label[for='cw-tab-rejected'] .zcs-horizontal-tabcount {
		background: var(--case-brand-light);
		color: var(--case-brand);
		border-color: rgba(97, 71, 229, 0.18);
}
#cw-tab-new-intake:checked ~ .case-tabs-shell .tabitem-new-intake,
#cw-tab-conflict-check:checked ~ .case-tabs-shell .tabitem-conflict-check,
#cw-tab-engagement-pending:checked ~ .case-tabs-shell .tabitem-engagement-pending,
#cw-tab-open-matter:checked ~ .case-tabs-shell .tabitem-open-matter,
#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell .tabitem-strategy-pleadings,
#cw-tab-discovery-diligence:checked ~ .case-tabs-shell .tabitem-discovery-diligence,
#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell .tabitem-negotiation-mediation,
#cw-tab-hearing-trial:checked ~ .case-tabs-shell .tabitem-hearing-trial,
#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell .tabitem-awaiting-order-execution,
#cw-tab-billing-review:checked ~ .case-tabs-shell .tabitem-billing-review,
#cw-tab-closed:checked ~ .case-tabs-shell .tabitem-closed,
#cw-tab-archived:checked ~ .case-tabs-shell .tabitem-archived,
#cw-tab-rejected:checked ~ .case-tabs-shell .tabitem-rejected {
		border-bottom-color: var(--case-brand);
}
#cw-tab-new-intake:checked ~ .case-tabs-shell #panel-new-intake,
#cw-tab-conflict-check:checked ~ .case-tabs-shell #panel-conflict-check,
#cw-tab-engagement-pending:checked ~ .case-tabs-shell #panel-engagement-pending,
#cw-tab-open-matter:checked ~ .case-tabs-shell #panel-open-matter,
#cw-tab-strategy-pleadings:checked ~ .case-tabs-shell #panel-strategy-pleadings,
#cw-tab-discovery-diligence:checked ~ .case-tabs-shell #panel-discovery-diligence,
#cw-tab-negotiation-mediation:checked ~ .case-tabs-shell #panel-negotiation-mediation,
#cw-tab-hearing-trial:checked ~ .case-tabs-shell #panel-hearing-trial,
#cw-tab-awaiting-order-execution:checked ~ .case-tabs-shell #panel-awaiting-order-execution,
#cw-tab-billing-review:checked ~ .case-tabs-shell #panel-billing-review,
#cw-tab-closed:checked ~ .case-tabs-shell #panel-closed,
#cw-tab-archived:checked ~ .case-tabs-shell #panel-archived,
#cw-tab-rejected:checked ~ .case-tabs-shell #panel-rejected {
		display: block;
}
@media (max-width: 768px) {
		.case-workspace-page { padding: 10px; }
		.zcs-page-header { padding: 14px 16px; align-items: flex-start; flex-direction: column; }
		.case-tab-panels { padding: 10px; }
		.case-report-frame { min-height: 560px; }
}
@media (max-width: 576px) {
		.zcs-page-header .zcs-button { width: 100%; }
		.zcs-horizontal-tablink { padding-left: 8px; padding-right: 8px; }
}
</style>

<div class='case-workspace-page'>
		<div class='case-workspace-stack'>
				<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
						<div class='case-header-copy'>
								<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'>Case Workspace</h5>
								<p class='case-header-kicker'>Browse legal matters by lifecycle status. Open records from the embedded reports for status-specific work and detail navigation.</p>
								<div class='case-header-meta'>
										<span class='case-meta-pill'><i class='zc-li-outline business-law'></i> Active lifecycle: <%=activeLifecycleCount%></span>
										<span class='case-meta-pill'><i class='zc-li-outline files-folder-14'></i> Total matters: <%=totalCaseCount%></span>
								</div>
						</div>
						<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Create_Case?zc_LoadIn=dialog'>
								<i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
								<span class='zcs-button-text'>Create Case</span>
						</a>
				</div>

				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-new-intake' checked='checked'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-conflict-check'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-engagement-pending'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-open-matter'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-strategy-pleadings'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-discovery-diligence'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-negotiation-mediation'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-hearing-trial'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-awaiting-order-execution'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-billing-review'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-closed'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-archived'>
				<input class='case-tab-radio' type='radio' name='case_workspace_status' id='cw-tab-rejected'>

				<div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full case-tabs-shell'>
						<ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border' role='tablist'>
								<li class='zcs-horizontal-tabitem tabitem-new-intake'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-new-intake'><span class='zcs-horizontal-tabtext zcs-font-15'>New Intake</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=newIntakeCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-conflict-check'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-conflict-check'><span class='zcs-horizontal-tabtext zcs-font-15'>Conflict Check</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=conflictCheckCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-engagement-pending'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-engagement-pending'><span class='zcs-horizontal-tabtext zcs-font-15'>Engagement Pending</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=engagementPendingCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-open-matter'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-open-matter'><span class='zcs-horizontal-tabtext zcs-font-15'>Open Matter</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=openMatterCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-strategy-pleadings'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-strategy-pleadings'><span class='zcs-horizontal-tabtext zcs-font-15'>Strategy and Pleadings</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=strategyPleadingsCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-discovery-diligence'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-discovery-diligence'><span class='zcs-horizontal-tabtext zcs-font-15'>Discovery and Diligence</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=discoveryDiligenceCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-negotiation-mediation'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-negotiation-mediation'><span class='zcs-horizontal-tabtext zcs-font-15'>Negotiation and Mediation</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=negotiationMediationCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-hearing-trial'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-hearing-trial'><span class='zcs-horizontal-tabtext zcs-font-15'>Hearing and Trial</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=hearingTrialCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-awaiting-order-execution'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-awaiting-order-execution'><span class='zcs-horizontal-tabtext zcs-font-15'>Awaiting Order or Execution</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=awaitingOrderExecutionCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-billing-review'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-billing-review'><span class='zcs-horizontal-tabtext zcs-font-15'>Billing Review</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=billingReviewCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-closed'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-closed'><span class='zcs-horizontal-tabtext zcs-font-15'>Closed</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=closedCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-archived'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-archived'><span class='zcs-horizontal-tabtext zcs-font-15'>Archived</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=archivedCount%></span></label></li>
								<li class='zcs-horizontal-tabitem tabitem-rejected'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' for='cw-tab-rejected'><span class='zcs-horizontal-tabtext zcs-font-15'>Rejected</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=rejectedCount%></span></label></li>
						</ul>

						<div class='zcs-horizontal-tabbody zcs-col-common case-tab-panels'>
								<section class='case-tab-panel' id='panel-new-intake'>
