<%
	loginEmail = ifnull(zoho.loginuserid,"");
	loginUser = ifnull(zoho.loginuser,"");
	contactRows = Add_Client_Contact[Email == loginEmail && Status == "Active"];
	if(contactRows.count() == 0 && loginUser != "" && loginUser != loginEmail)
	{
		contactRows = Add_Client_Contact[Email == loginUser && Status == "Active"];
	}
%>
<style>
/* ===== zcs-global.css: utility subset included once for this page ===== */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);
	--zcs_brand_color: #6147E5;
	--zcs_brand_foreground_color: #FFFFFF;
	--zcs_brand_dark_color: #4E38C8;
	--zcs_brand_light_color: #F1EEFF;
	--zcs_primary_text_color: #17142F;
	--zcs_secondary_text_color: #4F5873;
	--zcs_tertiary_text_color: #7A8094;
	--zcs_tertiary_border_color: #E7E8F0;
	--zcs_primary_border_color: #E0E2EA;
	--zcs_component_hover_color: #F4F1FF;
	--zcs_light_grey_color: #F7F8FC;
	--zcs-white-color: #FFFFFF;
	--zcs-page-bg-color: #F6F7FB;
	--cp-primary: #6147E5;
	--cp-primary-dark: #4E38C8;
	--cp-bg: #F6F7FB;
	--cp-surface: #FFFFFF;
	--cp-border: #E7E8F0;
	--cp-text: #17142F;
	--cp-muted: #6B7280;
	--cp-soft: #F1EEFF;
	--cp-success: #179E6C;
	--cp-warning: #B8770D;
	--cp-danger: #D92D20;
	--cp-info: #2A6FFC;
	--cp-gap: 15px;
	--cp-radius: 12px;
	font-size: 16px;
	line-height: 1.5;
}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mt-20{margin-top:20px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}
/* ===== ZCS component CSS: button-primary-button/header-heading-with-button and no-data-no-data-with-button ===== */
.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0;transition:background .15s ease,border-color .15s ease,color .15s ease}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-secondary-button:hover,.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus,.zcs-secondary-button.zcs-button:active,.zcs-secondary-button.zcs-button:focus,.zcs-primary-outline-button.zcs-button:active,.zcs-primary-outline-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-button-text{white-space:nowrap}.zcs-nodata-wrapper{min-height:150px}.zcs-nodata-img{width:84px;height:84px}.zcs-nodata-header{font-size:18px}
/* ===== ZCS component CSS: badge-filled-badge ===== */
.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}
/* ===== ZCS component CSS: table-simple-table ===== */
:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#FE455D}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-l_blue{color:#1094C5}
/* ===== Client Portal approved CSS block ===== */
*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.client-portal{width:100%;min-height:100%;background:var(--cp-bg);color:var(--cp-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--cp-gap);overflow:auto}.cp-shell{display:flex;flex-direction:column;gap:var(--cp-gap);max-width:1680px;margin:0 auto}.cp-header{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--cp-gap);padding:15px;border:1px solid var(--cp-border);border-radius:var(--cp-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.cp-title-block{min-width:0;flex:1}.cp-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--cp-primary);margin:0 0 4px}.cp-title{font-size:24px;line-height:1.2;font-weight:700;color:var(--cp-text);margin:0}.cp-subtitle{margin:6px 0 0;color:var(--cp-muted)}.cp-trust-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.cp-action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end;max-width:560px}.cp-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--cp-gap);align-items:start}.cp-card{grid-column:span 4;background:var(--cp-surface);border:1px solid var(--cp-border);border-radius:var(--cp-radius);overflow:hidden;min-height:100%;display:flex;flex-direction:column}.cp-card.cp-wide{grid-column:span 8}.cp-card.cp-full{grid-column:span 12}.cp-card-header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px;border-bottom:1px solid var(--cp-border);background:#fff}.cp-card-title{display:flex;flex-direction:column;gap:2px;min-width:0}.cp-card-title h2{font-size:16px;line-height:1.25;font-weight:700;color:var(--cp-text);margin:0}.cp-card-title p{font-size:12px;color:var(--cp-muted);margin:0}.cp-card-body{padding:15px}.cp-section-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.cp-metrics{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:var(--cp-gap)}.cp-metric{border:1px solid var(--cp-border);border-radius:var(--cp-radius);padding:15px;background:#fff}.cp-metric label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--cp-muted);margin-bottom:6px}.cp-metric strong{display:block;font-size:20px;line-height:1.2;color:var(--cp-text);word-break:break-word}.cp-list{display:grid;gap:12px}.cp-record{border:1px solid var(--cp-border);border-radius:var(--cp-radius);padding:12px;background:#FCFCFF;min-width:0}.cp-record-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.cp-record-title{font-size:15px;font-weight:700;color:var(--cp-text);margin:0;word-break:break-word}.cp-record-meta{font-size:12px;color:var(--cp-muted);margin:4px 0 0;word-break:break-word}.cp-record-desc{color:var(--cp-text);margin:8px 0 0;word-break:break-word}.cp-record-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.cp-scroll{height:330px;overflow:auto;padding:15px}.cp-tall-scroll{height:430px;overflow:auto;padding:15px}.cp-table{min-width:720px}.cp-table.compact{min-width:560px}.cp-table .cp-main{font-weight:600;color:var(--cp-text)}.cp-table .cp-sub{font-size:12px;color:var(--cp-muted);margin-top:2px}.cp-status-pill{font-size:12px;font-weight:600;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:240px}.cp-status-primary{background:#F1EEFF;color:var(--cp-primary)}.cp-status-success{background:#E4FCF3;color:var(--cp-success)}.cp-status-warning{background:#FCF4E6;color:var(--cp-warning)}.cp-status-danger{background:#FDE3E6;color:var(--cp-danger)}.cp-status-info{background:#E8EFFF;color:var(--cp-info)}.cp-empty{min-height:150px;border:1px dashed var(--cp-border);border-radius:var(--cp-radius);background:#FCFCFF}.cp-empty-text{color:var(--cp-muted);margin:6px 0 0}.cp-alert{display:flex;gap:10px;align-items:flex-start;border:1px solid #D9D2FF;background:#F8F6FF;color:var(--cp-text);border-radius:var(--cp-radius);padding:15px}.cp-alert i{font-size:18px;line-height:1.2;color:var(--cp-primary)}.cp-security-note{display:flex;gap:8px;align-items:flex-start;color:var(--cp-muted);font-size:12px;margin-top:10px}.cp-mobile-list{display:none}.cp-mobile-card{border:1px solid var(--cp-border);border-radius:var(--cp-radius);padding:12px;background:#fff;margin-bottom:10px}.cp-mobile-card:last-child{margin-bottom:0}.cp-mobile-card-title{font-weight:700;margin:0 0 4px;color:var(--cp-text)}.cp-mobile-card-line{font-size:12px;color:var(--cp-muted);margin:2px 0}.cp-mobile-card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1280px){.cp-card,.cp-card.cp-wide{grid-column:span 6}.cp-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}@media (max-width:860px){.client-portal{padding:15px}.cp-header{flex-direction:column}.cp-action-row,.cp-section-actions{justify-content:flex-start;max-width:none}.cp-card,.cp-card.cp-wide,.cp-card.cp-full{grid-column:span 12}.cp-metrics{grid-template-columns:1fr}.cp-scroll,.cp-tall-scroll{height:340px}.cp-table-wrapper-mobile{display:none}.cp-mobile-list{display:block}}@media (max-width:520px){.cp-title{font-size:20px}.cp-card-header{align-items:flex-start;flex-direction:column}.cp-action-row .zcs-button{width:100%}}
</style>

<div class="client-portal">
	<div class="cp-shell">
<%
	if(contactRows.count() == 0)
	{
%>
		<div class="cp-header">
			<div class="cp-title-block">
				<p class="cp-kicker">Client Portal</p>
				<h1 class="cp-title">We could not match your portal account</h1>
				<p class="cp-subtitle">Your sign-in email is not currently linked to an active client contact record.</p>
			</div>
		</div>
		<div class="zcs-nodata-wrapper cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center">
			<div class="zcs-nodata-content zcs-p-20 zcs-box-border">
				<i class="zc-li-outline users-single-02" style="font-size:54px;color:var(--cp-primary);"></i>
				<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Please contact the firm to activate portal access</h5>
				<p class="cp-empty-text">Ask your matter team to verify that <strong><%=loginEmail%></strong> is recorded as an active client contact. For privacy, this page shows case and billing information only after the contact match is confirmed.</p>
			</div>
		</div>
<%
	}
	else
	{
		contactRec = contactRows;
		clientRows = Add_Client[ID == contactRec.Client && Client_Status != "Blacklisted"];
		if(clientRows.count() == 0)
		{
%>
		<div class="cp-header">
			<div class="cp-title-block">
				<p class="cp-kicker">Client Portal</p>
				<h1 class="cp-title">Client account unavailable</h1>
				<p class="cp-subtitle">Your contact is active, but the related client account is not available for portal viewing.</p>
			</div>
		</div>
		<div class="zcs-nodata-wrapper cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center">
			<div class="zcs-nodata-content zcs-p-20 zcs-box-border">
				<i class="zc-li-outline ui-2-alert-circle" style="font-size:54px;color:var(--cp-primary);"></i>
				<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Please contact the firm</h5>
				<p class="cp-empty-text">We are unable to show records for this account at this time. Your legal team can confirm the account status and portal access.</p>
			</div>
		</div>
<%
		}
		else
		{
			clientRec = clientRows;
			clientName = ifnull(clientRec.Client_Name,"Client");
			caseCount = Create_Case[Client == clientRec.ID && Case_Status != "New Intake" && Case_Status != "Conflict Check" && Case_Status != "Engagement Pending" && Case_Status != "Rejected"].count();
			hearingCount = Add_Hearing[Case.Client == clientRec.ID && Hearing_DateTime >= zoho.currenttime && (Hearing_Status == "Scheduled" || Hearing_Status == "Prepared") && Case.Case_Status != "New Intake" && Case.Case_Status != "Conflict Check" && Case.Case_Status != "Engagement Pending" && Case.Case_Status != "Rejected"].count();
			documentCount = Add_Case_Document[Visible_To_Client == true && Case.Client == clientRec.ID].count();
			historyCount = Add_Case_History[Visible_To_Client == true && Case.Client == clientRec.ID].count();
			invoiceCount = Create_Invoice[Client == clientRec.ID && (Invoice_Status == "Sent" || Invoice_Status == "Partially Paid" || Invoice_Status == "Paid" || Invoice_Status == "Overdue")].count();
			paymentCount = Add_Payment[Client == clientRec.ID].count();
			invoiceBalance = Create_Invoice[Client == clientRec.ID && (Invoice_Status == "Sent" || Invoice_Status == "Partially Paid" || Invoice_Status == "Overdue")].sum(Balance_Due);
			if(invoiceBalance == null){invoiceBalance = 0;}
%>
		<div class="cp-header">
			<div class="cp-title-block">
				<p class="cp-kicker">Client Portal</p>
				<h1 class="cp-title">Welcome, <%=ifnull(contactRec.Contact_Name,zoho.loginuser)%></h1>
				<p class="cp-subtitle">Secure view for <%=clientName%>. Only client-visible matter updates and client billing records are shown.</p>
				<div class="cp-trust-row">
					<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><i class="zc-li-outline ui-1-lock"></i> Client-visible records only</span></div>
					<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><i class="zc-li-outline business-briefcase-24"></i> <%=caseCount%> matters</span></div>
					<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><i class="zc-li-outline files-single-copy-04"></i> <%=documentCount%> shared documents</span></div>
				</div>
				<div class="cp-security-note"><i class="zc-li-outline ui-1-check-circle-08"></i><span>Internal notes, conflict records, confidential documents, staff-only actions, drafts, and unavailable actions are excluded from this page.</span></div>
			</div>
		</div>

		<div class="cp-metrics">
			<div class="cp-metric"><label>Visible Matters</label><strong><%=caseCount%></strong></div>
			<div class="cp-metric"><label>Upcoming Hearings</label><strong><%=hearingCount%></strong></div>
			<div class="cp-metric"><label>Shared Documents</label><strong><%=documentCount%></strong></div>
			<div class="cp-metric"><label>Client Updates</label><strong><%=historyCount%></strong></div>
			<div class="cp-metric"><label>Sent or Paid Invoices</label><strong><%=invoiceCount%></strong></div>
			<div class="cp-metric"><label>Open Balance</label><strong>$<%=invoiceBalance%></strong></div>
		</div>

		<div class="cp-grid">
<%
			caseRows = Create_Case[Client == clientRec.ID && Case_Status != "New Intake" && Case_Status != "Conflict Check" && Case_Status != "Engagement Pending" && Case_Status != "Rejected"] sort by Opened_On desc range from 1 to 8;
%>
			<div class="cp-card cp-wide">
				<div class="cp-card-header"><div class="cp-card-title"><h2>Case Summaries</h2><p>Public matter status and summaries for your client account</p></div></div>
				<div class="cp-tall-scroll">
<%
			if(caseRows.count() == 0)
			{
%>
					<div class="cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><i class="zc-li-outline business-briefcase-24" style="font-size:38px;color:var(--cp-muted);"></i><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No client-visible matters yet</h5><p class="cp-empty-text">Your legal team will publish case information here when a matter is ready for client portal viewing.</p></div></div>
<%
			}
			else
			{
%>
					<div class="cp-list">
<%
				for each caseRec in caseRows
				{
					caseStatus = ifnull(caseRec.Case_Status,"Status pending");
					caseClass = "cp-status-primary";
					if(caseStatus == "Closed" || caseStatus == "Archived")
					{
						caseClass = "cp-status-success";
					}
					else if(caseStatus == "Billing Review" || caseStatus == "Awaiting Order or Execution")
					{
						caseClass = "cp-status-warning";
					}
%>
						<div class="cp-record">
							<div class="cp-record-head"><div><p class="cp-record-title"><%=ifnull(caseRec.Case_Title,"Untitled matter")%></p><p class="cp-record-meta">Case <%=ifnull(caseRec.Case_Number,caseRec.ID)%> · <%=ifnull(caseRec.Practice_Area.Practice_Area_Name,"Practice area not set")%> · <%=ifnull(caseRec.Case_Type.Case_Type_Name,"Case type not set")%></p></div><span class="cp-status-pill <%=caseClass%>"><%=caseStatus%></span></div>
							<p class="cp-record-desc"><%=ifnull(caseRec.Summary,"No public summary has been posted yet.")%></p>
							<div class="cp-record-actions"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Case_Note?Case=<%=caseRec.ID%>&amp;Note_Type=Client%20Communication&amp;Direction=Inbound&amp;Contact_Email=<%=loginEmail%>&amp;Visible_To_Client=true&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-email-85"></i><span class="zcs-button-text">Send Message</span></a></div>
						</div>
<%
				}
%>
					</div>
<%
			}
%>
				</div>
			</div>

<%
			hearingRows = Add_Hearing[Case.Client == clientRec.ID && Hearing_DateTime >= zoho.currenttime && (Hearing_Status == "Scheduled" || Hearing_Status == "Prepared") && Case.Case_Status != "New Intake" && Case.Case_Status != "Conflict Check" && Case.Case_Status != "Engagement Pending" && Case.Case_Status != "Rejected"] sort by Hearing_DateTime asc range from 1 to 8;
%>
			<div class="cp-card">
				<div class="cp-card-header"><div class="cp-card-title"><h2>Upcoming Hearings</h2><p>Scheduled or prepared hearings for visible matters</p></div></div>
				<div class="cp-tall-scroll">
<%
			if(hearingRows.count() == 0)
			{
%>
					<div class="cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><i class="zc-li-outline ui-2-time" style="font-size:38px;color:var(--cp-muted);"></i><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No upcoming hearings</h5><p class="cp-empty-text">Any scheduled client-visible hearing dates will appear here.</p></div></div>
<%
			}
			else
			{
%>
					<div class="cp-list">
<%
				for each hear in hearingRows
				{
%>
						<div class="cp-record"><div class="cp-record-head"><div><p class="cp-record-title"><%=ifnull(hear.Hearing_Type,"Hearing")%></p><p class="cp-record-meta"><%=ifnull(hear.Hearing_DateTime,"Date pending")%> · <%=ifnull(hear.Venue,"Venue to be confirmed")%></p></div><span class="cp-status-pill cp-status-info"><%=ifnull(hear.Hearing_Status,"Scheduled")%></span></div><p class="cp-record-desc"><%=ifnull(hear.Case.Case_Title,"Matter")%></p><p class="cp-record-meta">Court: <%=ifnull(hear.Court.Court_Name,"Not specified")%></p></div>
<%
				}
%>
					</div>
<%
			}
%>
				</div>
			</div>
		</div>

		<div class="cp-grid">
<%
			documentRows = Add_Case_Document[Visible_To_Client == true && Case.Client == clientRec.ID] sort by Document_Date desc range from 1 to 8;
%>
			<div class="cp-card cp-wide">
				<div class="cp-card-header"><div class="cp-card-title"><h2>Shared Documents</h2><p>Documents explicitly marked Visible to Client</p></div></div>
				<div class="cp-scroll">
<%
			if(documentRows.count() == 0)
			{
%>
					<div class="cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><i class="zc-li-outline files-single-copy-04" style="font-size:38px;color:var(--cp-muted);"></i><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No shared documents</h5><p class="cp-empty-text">Approved non-confidential documents will appear when your legal team marks them visible to client.</p></div></div>
<%
			}
			else
			{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative cp-table-wrapper-mobile"><table class="zcs-w-full cp-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Document</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
				for each doc in documentRows
				{
%>
						<tr><td class="zcs-px-16 zcs-py-8"><div class="cp-main"><%=ifnull(doc.Document_Title,"Untitled document")%></div><div class="cp-sub"><%=ifnull(doc.Document_Type.Document_Type_Name,"Document")%> · Version <%=ifnull(doc.Version_Number,1)%></div></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(doc.Case.Case_Title,"Matter")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(doc.Document_Date,"Not dated")%></td><td class="zcs-px-16 zcs-py-8"><span class="cp-status-pill cp-status-success"><%=ifnull(doc.Document_Status,"Shared")%></span></td></tr>
<%
				}
%>
					</tbody></table></div><div class="cp-mobile-list">
<%
				for each doc in documentRows
				{
%>
						<div class="cp-mobile-card"><p class="cp-mobile-card-title"><%=ifnull(doc.Document_Title,"Untitled document")%></p><p class="cp-mobile-card-line"><%=ifnull(doc.Case.Case_Title,"Matter")%> · <%=ifnull(doc.Document_Date,"Not dated")%></p><p class="cp-mobile-card-line"><%=ifnull(doc.Document_Type.Document_Type_Name,"Document")%> · <%=ifnull(doc.Document_Status,"Shared")%></p></div>
<%
				}
%>
					</div>
<%
			}
%>
				</div>
			</div>

<%
			historyRows = Add_Case_History[Visible_To_Client == true && Case.Client == clientRec.ID] sort by Event_Date desc range from 1 to 8;
%>
			<div class="cp-card">
				<div class="cp-card-header"><div class="cp-card-title"><h2>Recent Updates</h2><p>Client-visible matter history</p></div></div>
				<div class="cp-scroll">
<%
			if(historyRows.count() == 0)
			{
%>
					<div class="cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><i class="zc-li-outline ui-1-notification-69" style="font-size:38px;color:var(--cp-muted);"></i><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No public updates</h5><p class="cp-empty-text">Client-visible updates will be posted here by your matter team.</p></div></div>
<%
			}
			else
			{
%>
					<div class="cp-list">
<%
				for each hist in historyRows
				{
%>
						<div class="cp-record"><div class="cp-record-head"><div><p class="cp-record-title"><%=ifnull(hist.Event_Type,"Update")%></p><p class="cp-record-meta"><%=ifnull(hist.Event_Date,"Date pending")%> · <%=ifnull(hist.Case.Case_Title,"Matter")%></p></div><span class="cp-status-pill cp-status-primary"><%=ifnull(hist.New_Status,"Update")%></span></div><p class="cp-record-desc"><%=ifnull(hist.Summary,"No update details provided.")%></p></div>
<%
				}
%>
					</div>
<%
			}
%>
				</div>
			</div>
		</div>

		<div class="cp-grid">
<%
			invoiceRows = Create_Invoice[Client == clientRec.ID && (Invoice_Status == "Sent" || Invoice_Status == "Partially Paid" || Invoice_Status == "Paid" || Invoice_Status == "Overdue")] sort by Invoice_Date desc range from 1 to 8;
%>
			<div class="cp-card cp-wide">
				<div class="cp-card-header"><div class="cp-card-title"><h2>Invoices</h2><p>Sent, partially paid, paid, and overdue invoices for your client account</p></div></div>
				<div class="cp-scroll">
<%
			if(invoiceRows.count() == 0)
			{
%>
					<div class="cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><i class="zc-li-outline business-money-11" style="font-size:38px;color:var(--cp-muted);"></i><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No client invoices</h5><p class="cp-empty-text">Invoices will appear here after they are sent by the firm or marked paid.</p></div></div>
<%
			}
			else
			{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative cp-table-wrapper-mobile"><table class="zcs-w-full cp-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Invoice</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Due</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Total</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Balance</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
				for each inv in invoiceRows
				{
					invStatus = ifnull(inv.Invoice_Status,"Sent");
					invClass = "cp-status-info";
					if(invStatus == "Paid")
					{
						invClass = "cp-status-success";
					}
					else if(invStatus == "Overdue")
					{
						invClass = "cp-status-danger";
					}
					else if(invStatus == "Partially Paid")
					{
						invClass = "cp-status-warning";
					}
%>
						<tr><td class="zcs-px-16 zcs-py-8"><div class="cp-main"><%=ifnull(inv.Invoice_Number,inv.ID)%></div><div class="cp-sub"><%=ifnull(inv.Invoice_Date,"Not dated")%></div></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(inv.Case.Case_Title,"Matter")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(inv.Due_Date,"Not set")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(inv.Total_Amount,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(inv.Balance_Due,0)%></td><td class="zcs-px-16 zcs-py-8"><span class="cp-status-pill <%=invClass%>"><%=invStatus%></span></td></tr>
<%
				}
%>
					</tbody></table></div><div class="cp-mobile-list">
<%
				for each inv in invoiceRows
				{
%>
						<div class="cp-mobile-card"><p class="cp-mobile-card-title">Invoice <%=ifnull(inv.Invoice_Number,inv.ID)%> · $<%=ifnull(inv.Total_Amount,0)%></p><p class="cp-mobile-card-line"><%=ifnull(inv.Case.Case_Title,"Matter")%> · Due <%=ifnull(inv.Due_Date,"Not set")%></p><p class="cp-mobile-card-line"><%=ifnull(inv.Invoice_Status,"Sent")%> · Balance $<%=ifnull(inv.Balance_Due,0)%></p></div>
<%
				}
%>
					</div>
<%
			}
%>
				</div>
			</div>

<%
			paymentRows = Add_Payment[Client == clientRec.ID] sort by Payment_Date desc range from 1 to 8;
%>
			<div class="cp-card">
				<div class="cp-card-header"><div class="cp-card-title"><h2>Payments</h2><p>Payments recorded for your client account</p></div></div>
				<div class="cp-scroll">
<%
			if(paymentRows.count() == 0)
			{
%>
					<div class="cp-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><i class="zc-li-outline business-money-time" style="font-size:38px;color:var(--cp-muted);"></i><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No payments recorded</h5><p class="cp-empty-text">Payment receipts and reconciliations will appear when posted by the firm.</p></div></div>
<%
			}
			else
			{
%>
					<div class="cp-list">
<%
				for each pay in paymentRows
				{
					payStatus = ifnull(pay.Payment_Status,"Received");
					payClass = "cp-status-success";
					if(payStatus == "Bounced")
					{
						payClass = "cp-status-danger";
					}
					else if(payStatus == "Refunded")
					{
						payClass = "cp-status-warning";
					}
%>
						<div class="cp-record"><div class="cp-record-head"><div><p class="cp-record-title">$<%=ifnull(pay.Amount,0)%> payment</p><p class="cp-record-meta"><%=ifnull(pay.Payment_Date,"Date pending")%> · <%=ifnull(pay.Payment_Mode,"Mode not set")%></p></div><span class="cp-status-pill <%=payClass%>"><%=payStatus%></span></div><p class="cp-record-desc">Invoice <%=ifnull(pay.Invoice.Invoice_Number,pay.Invoice)%> · Reference <%=ifnull(pay.Reference_Number,"Not provided")%></p></div>
<%
				}
%>
					</div>
<%
			}
%>
				</div>
			</div>
		</div>

		<div class="cp-alert">
			<i class="zc-li-outline ui-1-lock"></i>
			<div><strong>Privacy notice</strong><div>This portal intentionally omits internal notes, confidential evidence, conflict checks, staff-only tasks, draft invoices, and legal team actions. Contact the firm if you believe a client-visible item is missing.</div></div>
		</div>
<%
		}
	}
%>
	</div>
</div>