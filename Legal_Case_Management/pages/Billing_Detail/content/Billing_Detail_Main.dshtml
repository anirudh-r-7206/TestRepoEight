<%
	invoiceRows = Create_Invoice[ID == input.Invoice_ID];
%>
<style>
/* ===== zcs-global.css: utility subset included once for this page ===== */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);
	--zcs_brand_color: #6147E5;
	--zcs_brand_foreground_color: #FFFFFF;
	--zcs_brand_dark_color: #4E38C8;
	--zcs_brand_light_color: #F1EEFF;
	--zcs_primary_text_color: #17142F;
	--zcs_secondary_text_color: #4F5873;
	--zcs_tertiary_text_color: #7A8094;
	--zcs_tertiary_border_color: #E7E8F0;
	--zcs_primary_border_color: #E0E2EA;
	--zcs_component_hover_color: #F4F1FF;
	--zcs_light_grey_color: #F7F8FC;
	--zcs-white-color: #FFFFFF;
	--zcs-page-bg-color: #F6F7FB;
	--bd-primary: #6147E5;
	--bd-primary-dark: #4E38C8;
	--bd-bg: #F6F7FB;
	--bd-surface: #FFFFFF;
	--bd-border: #E7E8F0;
	--bd-text: #17142F;
	--bd-muted: #6B7280;
	--bd-soft: #F1EEFF;
	--bd-success: #179E6C;
	--bd-warning: #B8770D;
	--bd-danger: #D92D20;
	--bd-info: #2A6FFC;
	--bd-gap: 15px;
	--bd-radius: 12px;
	font-size: 16px;
	line-height: 1.5;
}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}
/* ===== ZCS component CSS: button-primary-button and button-secondary-button ===== */
.zcs-button{width:auto;min-width:5rem;min-height:36px;border:0;transition:background .15s ease,border-color .15s ease,color .15s ease}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-secondary-button:hover,.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus,.zcs-secondary-button.zcs-button:active,.zcs-secondary-button.zcs-button:focus,.zcs-primary-outline-button.zcs-button:active,.zcs-primary-outline-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-button-text{white-space:nowrap}
/* ===== ZCS component CSS: badge-filled-badge ===== */
.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}
/* ===== ZCS component CSS: table-simple-table ===== */
:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#FE455D}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-l_blue{color:#1094C5}
/* ===== Billing Detail approved CSS block ===== */
*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.billing-detail{width:100%;min-height:100%;background:var(--bd-bg);color:var(--bd-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--bd-gap);overflow:auto}.bd-shell{display:flex;flex-direction:column;gap:var(--bd-gap);max-width:1680px;margin:0 auto}.bd-header{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--bd-gap);padding:15px;border:1px solid var(--bd-border);border-radius:var(--bd-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.bd-title-block{min-width:0;flex:1}.bd-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--bd-primary);margin:0 0 4px}.bd-title{font-size:24px;line-height:1.2;font-weight:700;color:var(--bd-text);margin:0}.bd-subtitle{margin:6px 0 0;color:var(--bd-muted)}.bd-action-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:flex-end;max-width:820px}.bd-action-row .zcs-button,.bd-section-actions .zcs-button{border-radius:8px}.bd-badge-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.bd-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--bd-gap);align-items:start}.bd-card{grid-column:span 4;background:var(--bd-surface);border:1px solid var(--bd-border);border-radius:var(--bd-radius);overflow:hidden;min-height:100%;display:flex;flex-direction:column}.bd-card.bd-wide{grid-column:span 8}.bd-card.bd-full{grid-column:span 12}.bd-card-header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px;border-bottom:1px solid var(--bd-border);background:#fff}.bd-card-title{display:flex;flex-direction:column;gap:2px;min-width:0}.bd-card-title h2{font-size:16px;line-height:1.25;font-weight:700;color:var(--bd-text);margin:0}.bd-card-title p{font-size:12px;color:var(--bd-muted);margin:0}.bd-card-body{padding:15px}.bd-section-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.bd-kv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.bd-kv-grid.single{grid-template-columns:1fr}.bd-kv{border:1px solid var(--bd-border);border-radius:10px;padding:12px;background:#FCFCFF;min-width:0}.bd-kv label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--bd-muted);margin-bottom:5px}.bd-kv strong,.bd-kv span{display:block;color:var(--bd-text);word-break:break-word}.bd-kv small{display:block;color:var(--bd-muted);font-size:12px;margin-top:4px;word-break:break-word}.bd-metrics{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:var(--bd-gap)}.bd-metric{border:1px solid var(--bd-border);border-radius:var(--bd-radius);padding:15px;background:#fff}.bd-metric label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.02em;font-weight:700;color:var(--bd-muted);margin-bottom:6px}.bd-metric strong{display:block;font-size:20px;line-height:1.2;color:var(--bd-text);word-break:break-word}.bd-metric.balance strong{color:var(--bd-danger)}.bd-metric.balance-paid strong{color:var(--bd-success)}.bd-related-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--bd-gap)}.bd-related{grid-column:span 6;background:var(--bd-surface);border:1px solid var(--bd-border);border-radius:var(--bd-radius);overflow:hidden;display:flex;flex-direction:column;min-height:330px}.bd-related.bd-related-full{grid-column:span 12}.bd-scroll{height:260px;overflow:auto;padding:15px}.bd-history-scroll{height:360px;overflow:auto;padding:15px}.bd-table{min-width:720px}.bd-table.compact{min-width:560px}.bd-table .bd-main{font-weight:600;color:var(--bd-text)}.bd-table .bd-sub{font-size:12px;color:var(--bd-muted);margin-top:2px}.bd-status-pill{font-size:12px;font-weight:600;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:220px}.bd-status-primary{background:#F1EEFF;color:var(--bd-primary)}.bd-status-success{background:#E4FCF3;color:var(--bd-success)}.bd-status-warning{background:#FCF4E6;color:var(--bd-warning)}.bd-status-danger{background:#FDE3E6;color:var(--bd-danger)}.bd-status-info{background:#E8EFFF;color:var(--bd-info)}.zcs-nodata-wrapper{min-height:150px;border:1px dashed var(--bd-border);border-radius:var(--bd-radius);background:#FCFCFF}.zcs-nodata-header{font-size:15px}.bd-empty-text{color:var(--bd-muted);margin:6px 0 0}.bd-alert{display:flex;gap:10px;align-items:flex-start;border:1px solid #F7C7CB;background:#FFF5F6;color:#9E1C2B;border-radius:var(--bd-radius);padding:15px}.bd-alert i{font-size:18px;line-height:1.2}.bd-mobile-list{display:none}.bd-mobile-card{border:1px solid var(--bd-border);border-radius:var(--bd-radius);padding:12px;background:#fff;margin-bottom:10px}.bd-mobile-card:last-child{margin-bottom:0}.bd-mobile-card-title{font-weight:700;margin:0 0 4px;color:var(--bd-text)}.bd-mobile-card-line{font-size:12px;color:var(--bd-muted);margin:2px 0}.bd-mobile-card-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1280px){.bd-card,.bd-card.bd-wide{grid-column:span 6}.bd-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.bd-related{grid-column:span 12}}@media (max-width:860px){.billing-detail{padding:15px}.bd-header{flex-direction:column}.bd-action-row,.bd-section-actions{justify-content:flex-start;max-width:none}.bd-card,.bd-card.bd-wide,.bd-card.bd-full{grid-column:span 12}.bd-kv-grid,.bd-metrics{grid-template-columns:1fr}.bd-scroll{height:300px}.bd-table-wrapper-mobile{display:none}.bd-mobile-list{display:block}}@media (max-width:520px){.bd-title{font-size:20px}.bd-card-header{align-items:flex-start;flex-direction:column}.bd-action-row .zcs-button{width:100%}}
</style>

<div class="billing-detail">
	<div class="bd-shell">
<%
	if(invoiceRows.count() == 0)
	{
%>
		<div class="bd-alert">
			<i class="zc-li-outline ui-1-circle-remove"></i>
			<div>
				<strong>Invoice not found</strong>
				<div>The requested invoice could not be found or you do not have access to it.</div>
			</div>
		</div>
<%
	}
	else
	{
		invoiceRec = invoiceRows;
		invoiceStatus = ifnull(invoiceRec.Invoice_Status,"Draft");
		subtotal = ifnull(invoiceRec.Subtotal,0);
		taxAmount = ifnull(invoiceRec.Tax_Amount,0);
		discountAmount = ifnull(invoiceRec.Discount_Amount,0);
		totalAmount = ifnull(invoiceRec.Total_Amount,0);
		amountPaid = ifnull(invoiceRec.Amount_Paid,0);
		balanceDue = ifnull(invoiceRec.Balance_Due,0);
		lineTotal = Add_Invoice_Item[Invoice == invoiceRec.ID].sum(Amount);
		if(lineTotal == null){lineTotal = 0;}
		paymentTotal = Add_Payment[Invoice == invoiceRec.ID && (Payment_Status == "Received" || Payment_Status == "Reconciled")].sum(Amount);
		if(paymentTotal == null){paymentTotal = 0;}
		clientName = "Not set";
		clientEmail = "";
		clientPhone = "";
		clientStatus = "";
		if(invoiceRec.Client != null)
		{
			clientRec = Add_Client[ID == invoiceRec.Client];
			if(clientRec.count() > 0)
			{
				clientName = ifnull(clientRec.Client_Name,"Not set");
				clientEmail = ifnull(clientRec.Primary_Email,"");
				clientPhone = ifnull(clientRec.Primary_Phone,"");
				clientStatus = ifnull(clientRec.Client_Status,"");
			}
		}
		caseTitle = "Not set";
		caseNumber = "";
		caseStatus = "";
		billingAttorney = "Not assigned";
		if(invoiceRec.Case != null)
		{
			caseRec = Create_Case[ID == invoiceRec.Case];
			if(caseRec.count() > 0)
			{
				caseTitle = ifnull(caseRec.Case_Title,"Not set");
				caseNumber = ifnull(caseRec.Case_Number,caseRec.ID);
				caseStatus = ifnull(caseRec.Case_Status,"");
				if(caseRec.Billing_Attorney != null)
				{
					ba = Add_Employee[ID == caseRec.Billing_Attorney];
					if(ba.count() > 0){billingAttorney = ifnull(ba.Employee_Name.first_name,"") + " " + ifnull(ba.Employee_Name.last_name,"");}
				}
			}
		}
		preparedBy = "Not assigned";
		if(invoiceRec.Prepared_By != null)
		{
			prep = Add_Employee[ID == invoiceRec.Prepared_By];
			if(prep.count() > 0){preparedBy = ifnull(prep.Employee_Name.first_name,"") + " " + ifnull(prep.Employee_Name.last_name,"");}
		}
		approvedBy = "Not assigned";
		if(invoiceRec.Approved_By != null)
		{
			appr = Add_Employee[ID == invoiceRec.Approved_By];
			if(appr.count() > 0){approvedBy = ifnull(appr.Employee_Name.first_name,"") + " " + ifnull(appr.Employee_Name.last_name,"");}
		}
		statusClass = "zcs-badge-yellow";
		statusIcon = "ui-2-time";
		if(invoiceStatus == "Paid")
		{
			statusClass = "zcs-badge-green";
			statusIcon = "ui-1-check-circle-08";
		}
		else if(invoiceStatus == "Overdue")
		{
			statusClass = "zcs-badge-red";
			statusIcon = "ui-2-alert-circle";
		}
		else if(invoiceStatus == "Cancelled")
		{
			statusClass = "zcs-badge-grey";
			statusIcon = "ui-1-circle-remove";
		}
		else if(invoiceStatus == "Approved" || invoiceStatus == "Sent" || invoiceStatus == "Partially Paid")
		{
			statusClass = "zcs-badge-blue";
			statusIcon = "ui-1-check-circle-08";
		}
		else if(invoiceStatus == "Submitted for Review")
		{
			statusClass = "zcs-badge-orange";
			statusIcon = "ui-1-check";
		}
		balanceMetricClass = "balance";
		if(balanceDue <= 0)
		{
			balanceMetricClass = "balance-paid";
		}
%>
		<div class="bd-header">
			<div class="bd-title-block">
				<p class="bd-kicker">Billing Detail</p>
				<h1 class="bd-title">Invoice <%=ifnull(invoiceRec.Invoice_Number,invoiceRec.ID)%></h1>
				<p class="bd-subtitle"><%=clientName%> · <%=caseTitle%> · Due <%=ifnull(invoiceRec.Due_Date,"Not set")%></p>
				<div class="bd-badge-row">
					<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><i class="zc-li-outline <%=statusIcon%>"></i> <%=invoiceStatus%></span></div>
					<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">Balance $<%=balanceDue%></span></div>
					<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">Total $<%=totalAmount%></span></div>
				</div>
			</div>
			<div class="bd-action-row">
<%
		if(invoiceStatus == "Draft")
		{
%>
				<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Invoice_Action?Invoice=<%=invoiceRec.ID%>&amp;Action_Type=Submit%20for%20Review&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span class="zcs-button-text">Submit for Review</span></a>
<%
		}
		if(invoiceStatus == "Submitted for Review")
		{
%>
				<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Invoice_Action?Invoice=<%=invoiceRec.ID%>&amp;Action_Type=Approve%20Invoice&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span class="zcs-button-text">Approve</span></a>
<%
		}
		if(invoiceStatus == "Approved")
		{
%>
				<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Invoice_Action?Invoice=<%=invoiceRec.ID%>&amp;Action_Type=Send%20Invoice&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline arrows-1-share-66"></i><span class="zcs-button-text">Send</span></a>
<%
		}
		if(invoiceStatus == "Sent" || invoiceStatus == "Partially Paid" || invoiceStatus == "Overdue")
		{
%>
				<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Payment?Invoice=<%=invoiceRec.ID%>&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline business-money-time"></i><span class="zcs-button-text">Add Payment</span></a>
<%
		}
		if(balanceDue <= 0 && invoiceStatus != "Paid" && invoiceStatus != "Cancelled")
		{
%>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Invoice_Action?Invoice=<%=invoiceRec.ID%>&amp;Action_Type=Mark%20Paid&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span class="zcs-button-text">Mark Paid</span></a>
<%
		}
		if(invoiceStatus == "Draft" || invoiceStatus == "Submitted for Review" || invoiceStatus == "Approved" || invoiceStatus == "Sent")
		{
%>
				<a class="zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Invoice_Action?Invoice=<%=invoiceRec.ID%>&amp;Action_Type=Cancel%20Invoice&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-circle-remove"></i><span class="zcs-button-text">Cancel</span></a>
<%
		}
		if(invoiceStatus == "Cancelled")
		{
%>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Invoice_Action?Invoice=<%=invoiceRec.ID%>&amp;Action_Type=Reopen%20Invoice&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline arrows-1-refresh-69"></i><span class="zcs-button-text">Reopen</span></a>
<%
		}
%>
			</div>
		</div>

		<div class="bd-grid">
			<div class="bd-card bd-wide">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Invoice Header</h2><p>Client, matter, dates, terms, and billing ownership</p></div></div>
				<div class="bd-card-body">
					<div class="bd-kv-grid">
						<div class="bd-kv"><label>Client</label><strong><%=clientName%></strong><small><%=clientStatus%></small><small><%=clientEmail%> <%=clientPhone%></small></div>
						<div class="bd-kv"><label>Case</label><strong><a href="#Page:Case_Detail?Case_ID=<%=invoiceRec.Case%>" class="bd-main"><%=caseTitle%></a></strong><small>Case <%=caseNumber%> · <%=caseStatus%></small></div>
						<div class="bd-kv"><label>Billing Period</label><strong><%=ifnull(invoiceRec.Billing_Period_Start,"Not set")%> to <%=ifnull(invoiceRec.Billing_Period_End,"Not set")%></strong><small>Invoice date: <%=ifnull(invoiceRec.Invoice_Date,"Not set")%></small></div>
						<div class="bd-kv"><label>Due and Terms</label><strong><%=ifnull(invoiceRec.Due_Date,"Not set")%></strong><small><%=ifnull(invoiceRec.Payment_Terms,"No payment terms recorded")%></small></div>
						<div class="bd-kv"><label>Prepared By</label><strong><%=preparedBy%></strong><small>Billing attorney: <%=billingAttorney%></small></div>
						<div class="bd-kv"><label>Approved By / Sent</label><strong><%=approvedBy%></strong><small>Sent on: <%=ifnull(invoiceRec.Sent_On,"Not sent")%></small></div>
					</div>
				</div>
			</div>
			<div class="bd-card">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Notes</h2><p>Invoice remarks</p></div></div>
				<div class="bd-card-body bd-kv-grid single"><div class="bd-kv"><label>Notes</label><span><%=ifnull(invoiceRec.Notes,"No invoice notes have been recorded.")%></span></div></div>
			</div>
			<div class="bd-card bd-full">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Totals and Balance</h2><p>Amounts are calculated from invoice items and payment workflows</p></div></div>
				<div class="bd-card-body bd-metrics">
					<div class="bd-metric"><label>Subtotal</label><strong>$<%=subtotal%></strong></div>
					<div class="bd-metric"><label>Tax</label><strong>$<%=taxAmount%></strong></div>
					<div class="bd-metric"><label>Discount</label><strong>$<%=discountAmount%></strong></div>
					<div class="bd-metric"><label>Total Amount</label><strong>$<%=totalAmount%></strong></div>
					<div class="bd-metric"><label>Amount Paid</label><strong>$<%=amountPaid%></strong></div>
					<div class="bd-metric <%=balanceMetricClass%>"><label>Balance Due</label><strong>$<%=balanceDue%></strong></div>
				</div>
			</div>
		</div>

		<div class="bd-related-grid">
<%
		itemRows = Add_Invoice_Item[Invoice == invoiceRec.ID] sort by Source_Type asc range from 1 to 50;
%>
			<div class="bd-related bd-related-full">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Line Items</h2><p><%=Add_Invoice_Item[Invoice == invoiceRec.ID].count()%> invoice items · calculated line total $<%=lineTotal%></p></div></div>
				<div class="bd-scroll">
<%
		if(itemRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No invoice line items</h5><p class="bd-empty-text">Add time, expenses, fixed fees, or adjustment lines before sending this invoice.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile"><table class="zcs-w-full bd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Source</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Description</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Quantity</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Rate</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
			for each item in itemRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=ifnull(item.Source_Type,"-")%><div class="bd-sub">Taxable: <%=if(item.Taxable == true,"Yes","No")%></div></td><td class="zcs-px-16 zcs-py-8"><div class="bd-main"><%=ifnull(item.Description,"-")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-text-right"><%=ifnull(item.Quantity,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(item.Rate,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(item.Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><span class="bd-status-pill bd-status-primary"><%=ifnull(item.Line_Status,"Draft")%></span></td></tr>
<%
			}
%>
					</tbody></table></div><div class="bd-mobile-list">
<%
			for each item in itemRows
			{
%>
					<div class="bd-mobile-card"><p class="bd-mobile-card-title"><%=ifnull(item.Description,"-")%></p><p class="bd-mobile-card-line"><%=ifnull(item.Source_Type,"-")%> · <%=ifnull(item.Line_Status,"Draft")%></p><p class="bd-mobile-card-line">Qty <%=ifnull(item.Quantity,0)%> at $<%=ifnull(item.Rate,0)%></p><div class="bd-mobile-card-meta"><span class="bd-status-pill bd-status-primary">$<%=ifnull(item.Amount,0)%></span></div></div>
<%
			}
%>
					</div>
<%
		}
%>
				</div>
			</div>
<%
		paymentRows = Add_Payment[Invoice == invoiceRec.ID] sort by Payment_Date desc range from 1 to 50;
%>
			<div class="bd-related">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Payments</h2><p><%=Add_Payment[Invoice == invoiceRec.ID].count()%> payment records · received/reconciled total $<%=paymentTotal%></p></div><div class="bd-section-actions"><% if(invoiceStatus == "Sent" || invoiceStatus == "Partially Paid" || invoiceStatus == "Overdue") { %><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Add_Payment?Invoice=<%=invoiceRec.ID%>&amp;zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline business-money-time"></i><span class="zcs-button-text">Add Payment</span></a><% } %></div></div>
				<div class="bd-scroll">
<%
		if(paymentRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No payments recorded</h5><p class="bd-empty-text">Payments are available only after invoices are sent, partially paid, or overdue.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile"><table class="zcs-w-full bd-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Mode</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Reference</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead><tbody>
<%
			for each pay in paymentRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=ifnull(pay.Payment_Date,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(pay.Payment_Mode,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(pay.Reference_Number,"-")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(pay.Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><span class="bd-status-pill bd-status-success"><%=ifnull(pay.Payment_Status,"Received")%></span></td></tr>
<%
			}
%>
					</tbody></table></div><div class="bd-mobile-list">
<%
			for each pay in paymentRows
			{
%>
					<div class="bd-mobile-card"><p class="bd-mobile-card-title">$<%=ifnull(pay.Amount,0)%> · <%=ifnull(pay.Payment_Status,"Received")%></p><p class="bd-mobile-card-line"><%=ifnull(pay.Payment_Date,"-")%> · <%=ifnull(pay.Payment_Mode,"-")%></p><p class="bd-mobile-card-line">Reference: <%=ifnull(pay.Reference_Number,"-")%></p></div>
<%
			}
%>
					</div>
<%
		}
%>
				</div>
			</div>
<%
		timeRows = Add_Time_Entry[Invoice == invoiceRec.ID] sort by Entry_Date desc range from 1 to 50;
%>
			<div class="bd-related">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Related Time</h2><p><%=Add_Time_Entry[Invoice == invoiceRec.ID].count()%> time entries attached to this invoice</p></div></div>
				<div class="bd-scroll">
<%
		if(timeRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No related time entries</h5><p class="bd-empty-text">Time entries linked through invoice items or billing workflows will appear here.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile"><table class="zcs-w-full bd-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Entry</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Employee</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Hours</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Approval</th></tr></thead><tbody>
<%
			for each t in timeRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><div class="bd-main"><%=ifnull(t.Activity_Type,"-")%></div><div class="bd-sub"><%=ifnull(t.Entry_Date,"-")%> · ID <%=ifnull(t.Time_Entry_ID,t.ID)%></div></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(t.Employee.Employee_Name.first_name,"Unassigned")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right"><%=ifnull(t.Hours,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(t.Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><span class="bd-status-pill bd-status-info"><%=ifnull(t.Approval_Status,"Draft")%></span></td></tr>
<%
			}
%>
					</tbody></table></div><div class="bd-mobile-list">
<%
			for each t in timeRows
			{
%>
					<div class="bd-mobile-card"><p class="bd-mobile-card-title"><%=ifnull(t.Activity_Type,"-")%> · $<%=ifnull(t.Amount,0)%></p><p class="bd-mobile-card-line"><%=ifnull(t.Entry_Date,"-")%> · <%=ifnull(t.Hours,0)%> hours</p><p class="bd-mobile-card-line"><%=ifnull(t.Employee.Employee_Name.first_name,"Unassigned")%> · <%=ifnull(t.Approval_Status,"Draft")%></p></div>
<%
			}
%>
					</div>
<%
		}
%>
				</div>
			</div>
<%
		expenseRows = Add_Expense_Entry[Invoice == invoiceRec.ID] sort by Expense_Date desc range from 1 to 50;
%>
			<div class="bd-related">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Related Expenses</h2><p><%=Add_Expense_Entry[Invoice == invoiceRec.ID].count()%> expense entries attached to this invoice</p></div></div>
				<div class="bd-scroll">
<%
		if(expenseRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No related expenses</h5><p class="bd-empty-text">Expense entries linked through invoice items or billing workflows will appear here.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile"><table class="zcs-w-full bd-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Expense</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Employee</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Approval</th></tr></thead><tbody>
<%
			for each ex in expenseRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><div class="bd-main"><%=ifnull(ex.Expense_Category,"-")%></div><div class="bd-sub"><%=ifnull(ex.Expense_Date,"-")%> · <%=ifnull(ex.Vendor,"No vendor")%></div></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(ex.Employee.Employee_Name.first_name,"Unassigned")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right">$<%=ifnull(ex.Amount,0)%></td><td class="zcs-px-16 zcs-py-8"><span class="bd-status-pill bd-status-info"><%=ifnull(ex.Approval_Status,"Draft")%></span></td></tr>
<%
			}
%>
					</tbody></table></div><div class="bd-mobile-list">
<%
			for each ex in expenseRows
			{
%>
					<div class="bd-mobile-card"><p class="bd-mobile-card-title"><%=ifnull(ex.Expense_Category,"-")%> · $<%=ifnull(ex.Amount,0)%></p><p class="bd-mobile-card-line"><%=ifnull(ex.Expense_Date,"-")%> · <%=ifnull(ex.Vendor,"No vendor")%></p><p class="bd-mobile-card-line"><%=ifnull(ex.Employee.Employee_Name.first_name,"Unassigned")%> · <%=ifnull(ex.Approval_Status,"Draft")%></p></div>
<%
			}
%>
					</div>
<%
		}
%>
				</div>
			</div>
<%
		historyRows = Add_Case_History[Case == invoiceRec.Case && (Event_Type == "Invoice Updated" || Event_Type == "Payment Received")] sort by Event_Date desc range from 1 to 50;
%>
			<div class="bd-related bd-related-full">
				<div class="bd-card-header"><div class="bd-card-title"><h2>Invoice and Payment History</h2><p>Case history events for invoice updates and payment receipts</p></div></div>
				<div class="bd-history-scroll">
<%
		if(historyRows.count() == 0)
		{
%>
					<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No billing history yet</h5><p class="bd-empty-text">Invoice and payment workflows will write audit history as actions are submitted.</p></div></div>
<%
		}
		else
		{
%>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative bd-table-wrapper-mobile"><table class="zcs-w-full bd-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Date</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Event</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status Change</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Summary</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Changed By</th></tr></thead><tbody>
<%
			for each hist in historyRows
			{
%>
					<tr><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Event_Date,"-")%></td><td class="zcs-px-16 zcs-py-8"><span class="bd-status-pill bd-status-primary"><%=ifnull(hist.Event_Type,"System")%></span></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Previous_Status,"-")%> to <%=ifnull(hist.New_Status,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Summary,"-")%></td><td class="zcs-px-16 zcs-py-8"><%=ifnull(hist.Changed_By.Employee_Name.first_name,"System")%></td></tr>
<%
			}
%>
					</tbody></table></div><div class="bd-mobile-list">
<%
			for each hist in historyRows
			{
%>
					<div class="bd-mobile-card"><p class="bd-mobile-card-title"><%=ifnull(hist.Event_Type,"System")%></p><p class="bd-mobile-card-line"><%=ifnull(hist.Event_Date,"-")%> · <%=ifnull(hist.Previous_Status,"-")%> to <%=ifnull(hist.New_Status,"-")%></p><p class="bd-mobile-card-line"><%=ifnull(hist.Summary,"-")%></p></div>
<%
			}
%>
					</div>
<%
		}
%>
				</div>
			</div>
		</div>
<%
	}
%>
	</div>
</div>