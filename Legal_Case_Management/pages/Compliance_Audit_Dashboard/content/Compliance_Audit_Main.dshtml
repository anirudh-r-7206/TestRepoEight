<%
	conflictRiskCount = Add_Conflict_Check[Decision == "Conflict Found" || Decision == "Waiver Required"].count();
	highConfidentialDocCount = Add_Case_Document[Confidentiality_Level == "Highly Confidential"].count();
	missedDeadlineCount = Add_Deadline[Deadline_Status == "Missed" || (Deadline_Date < zoho.currentdate && (Deadline_Status == "Open" || Deadline_Status == "Extended"))].count();
	overdueTaskCount = Add_Case_Task[Task_Status == "Overdue" || (Due_Date < zoho.currentdate && Task_Status != "Completed" && Task_Status != "Cancelled")].count();
	rejectedWaiverConflictCount = Add_Conflict_Check[Decision == "Waiver Required" || Approval_Status == "Rejected"].count();
	cancelledInvoiceCount = Create_Invoice[Invoice_Status == "Cancelled"].count();
	overdueInvoiceCount = Create_Invoice[Invoice_Status == "Overdue" || (Due_Date < zoho.currentdate && Balance_Due > 0 && Invoice_Status != "Paid" && Invoice_Status != "Cancelled")].count();
	recentHistoryCount = Add_Case_History[Event_Date >= zoho.currenttime.subDay(14)].count();
	overdueInvoiceBalance = Create_Invoice[Invoice_Status == "Overdue" || (Due_Date < zoho.currentdate && Balance_Due > 0 && Invoice_Status != "Paid" && Invoice_Status != "Cancelled")].sum(Balance_Due);
	if(overdueInvoiceBalance == null)
	{
		overdueInvoiceBalance = 0;
	}
	cancelledInvoiceTotal = Create_Invoice[Invoice_Status == "Cancelled"].sum(Total_Amount);
	if(cancelledInvoiceTotal == null)
	{
		cancelledInvoiceTotal = 0;
	}
	conflictRiskRows = Add_Conflict_Check[Decision == "Conflict Found" || Decision == "Waiver Required"] sort by Checked_On desc range from 1 to 8;
	highConfidentialDocRows = Add_Case_Document[Confidentiality_Level == "Highly Confidential"] sort by Document_Date desc range from 1 to 8;
	missedDeadlineRows = Add_Deadline[Deadline_Status == "Missed" || (Deadline_Date < zoho.currentdate && (Deadline_Status == "Open" || Deadline_Status == "Extended"))] sort by Deadline_Date asc range from 1 to 8;
	overdueTaskRows = Add_Case_Task[Task_Status == "Overdue" || (Due_Date < zoho.currentdate && Task_Status != "Completed" && Task_Status != "Cancelled")] sort by Due_Date asc range from 1 to 8;
	rejectedWaiverConflictRows = Add_Conflict_Check[Decision == "Waiver Required" || Approval_Status == "Rejected"] sort by Checked_On desc range from 1 to 8;
	cancelledInvoiceRows = Create_Invoice[Invoice_Status == "Cancelled"] sort by Invoice_Date desc range from 1 to 8;
	overdueInvoiceRows = Create_Invoice[Invoice_Status == "Overdue" || (Due_Date < zoho.currentdate && Balance_Due > 0 && Invoice_Status != "Paid" && Invoice_Status != "Cancelled")] sort by Due_Date asc range from 1 to 8;
	historyRows = Add_Case_History[ID != 0] sort by Event_Date desc range from 1 to 10;
%>
<style>
/* ===== zcs-global.css: utility subset included once for this page ===== */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color, #6147E5);
	--zcs_brand_color: #6147E5;
	--zcs_brand_foreground_color: #FFFFFF;
	--zcs_brand_dark_color: #4E38C8;
	--zcs_brand_light_color: #F1EEFF;
	--zcs_primary_text_color: #17142F;
	--zcs_secondary_text_color: #4F5873;
	--zcs_tertiary_text_color: #7A8094;
	--zcs_tertiary_border_color: #E7E8F0;
	--zcs_primary_border_color: #E0E2EA;
	--zcs_component_hover_color: #F4F1FF;
	--zcs_light_grey_color: #F7F8FC;
	--zcs-white-color: #FFFFFF;
	--zcs-page-bg-color: #F6F7FB;
	--audit-primary: #6147E5;
	--audit-primary-dark: #4E38C8;
	--audit-primary-light: #F1EEFF;
	--audit-bg: #F6F7FB;
	--audit-surface: #FFFFFF;
	--audit-border: #E7E8F0;
	--audit-text: #17142F;
	--audit-muted: #667085;
	--audit-success: #179E6C;
	--audit-warning: #B8770D;
	--audit-danger: #D92D20;
	--audit-info: #2A6FFC;
	--audit-gap: 15px;
	--audit-radius: 12px;
	font-size: 16px;
	line-height: 1.5;
}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:16px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-10{padding:10px}.zcs-p-12{padding:12px}.zcs-p-15{padding:15px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-8{padding-left:8px;padding-right:8px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-5{padding-top:5px;padding-bottom:5px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-30{font-size:30px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}

/* ===== ZCS component CSS: card-template adapted without action footer ===== */
.zcs-template-card{width:auto;height:auto;overflow:hidden}.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-card-content{min-height:0}.zcs-card-content-inner{min-width:0}.zcs-template-card .zcs-card-footer{display:none}

/* ===== ZCS component CSS: badge-badge-with-icon ===== */
.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#D92D20}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#E8E8E8;border-color:#667085;color:#475467}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#B8770D}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#F4660C}

/* ===== ZCS component CSS: table-simple-table ===== */
:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;position:sticky;z-index:1}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table thead tr th.zcs-green,.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179E6C}.zcs-table-wrapper table thead tr th.zcs-red,.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#D92D20}.zcs-table-wrapper table thead tr th.zcs-yellow,.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#B8770D}.zcs-table-wrapper table thead tr th.zcs-blue,.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-blue{color:#2A6FFC}

/* ===== Compliance Audit Dashboard approved CSS block ===== */
*{box-sizing:border-box}html,body{font-size:14px}div#zppagesLive,div#elementsContainer,.Layout.elemContainment,.zc-pb-formreport-placeholder,.zc-pb-tile-card{height:100%!important}.Layout.elemContainment,.zc-pb-tile-container{padding:0!important}.zc-pb-tile-card{border-radius:0!important;box-shadow:none!important}#splash-screen{display:none!important}.compliance-audit-dashboard{width:100%;min-height:100%;background:var(--audit-bg);color:var(--audit-text);font-family:Lato,Arial,sans-serif;font-size:14px;line-height:1.45;padding:var(--audit-gap);overflow:auto}.audit-shell{display:flex;flex-direction:column;gap:var(--audit-gap);max-width:1600px;margin:0 auto}.audit-header{display:flex;justify-content:space-between;align-items:center;gap:var(--audit-gap);padding:15px;border:1px solid var(--audit-border);border-radius:var(--audit-radius);background:linear-gradient(135deg,#FFFFFF 0%,#F4F1FF 100%)}.audit-title-block{min-width:0}.audit-kicker{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--audit-primary);margin:0 0 4px}.audit-title{font-size:22px;line-height:1.2;font-weight:700;color:var(--audit-text);margin:0}.audit-subtitle{margin:6px 0 0;color:var(--audit-muted);max-width:940px}.audit-readonly-pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(97,71,229,.18);background:#FFFFFF;color:var(--audit-primary);border-radius:999px;padding:7px 12px;font-size:13px;font-weight:700;white-space:nowrap}.audit-readonly-pill i{font-size:16px}.audit-kpi-grid{display:grid;grid-template-columns:repeat(8,minmax(140px,1fr));gap:var(--audit-gap)}.audit-kpi{min-height:126px;border-color:var(--audit-border);box-shadow:0 2px 8px rgba(23,20,47,.04)}.audit-kpi .zcs-card-header{padding:12px 14px;background:#fff}.audit-kpi .zcs-card-content{padding:14px}.audit-kpi-title{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--audit-muted);font-weight:700;margin:0}.audit-kpi-value{font-size:26px;line-height:1.1;font-weight:800;color:var(--audit-text);margin:0}.audit-kpi-note{font-size:12px;color:var(--audit-muted);margin:5px 0 0}.audit-icon{width:38px;height:38px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;flex:0 0 auto}.audit-icon.red{background:#FDE3E6;color:var(--audit-danger)}.audit-icon.yellow{background:#FCF4E6;color:var(--audit-warning)}.audit-icon.blue{background:#E8EFFF;color:var(--audit-info)}.audit-icon.violet{background:var(--audit-primary-light);color:var(--audit-primary)}.audit-icon.grey{background:#F2F4F7;color:#475467}.audit-section-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:var(--audit-gap);align-items:start}.audit-section{grid-column:span 6;background:var(--audit-surface);border:1px solid var(--audit-border);border-radius:var(--audit-radius);overflow:hidden;min-height:365px;display:flex;flex-direction:column}.audit-section.audit-wide{grid-column:span 12}.audit-section-header{display:flex;justify-content:space-between;align-items:center;gap:var(--audit-gap);padding:15px;border-bottom:1px solid var(--audit-border);background:#fff}.audit-section-title{display:flex;align-items:flex-start;gap:10px;min-width:0}.audit-section-title h2{font-size:16px;line-height:1.25;font-weight:800;color:var(--audit-text);margin:0}.audit-section-title p{font-size:12px;color:var(--audit-muted);margin:2px 0 0}.audit-section-icon{width:34px;height:34px;border-radius:9px;background:var(--audit-primary-light);color:var(--audit-primary);display:inline-flex;align-items:center;justify-content:center;font-size:16px;flex:0 0 auto}.audit-scroll{height:285px;overflow:auto;padding:15px}.audit-table{min-width:760px}.audit-table.compact{min-width:640px}.audit-table.history{min-width:880px}.audit-main{font-weight:700;color:var(--audit-text)}.audit-sub{font-size:12px;color:var(--audit-muted);margin-top:2px}.audit-link{color:var(--audit-primary);font-weight:700}.audit-link:hover{color:var(--audit-primary-dark);text-decoration:underline}.audit-status-pill{font-size:12px;font-weight:700;line-height:1.25;border-radius:6px;padding:3px 8px;display:inline-flex;align-items:center;max-width:220px}.audit-status-primary{background:#F1EEFF;color:var(--audit-primary)}.audit-status-success{background:#E4FCF3;color:var(--audit-success)}.audit-status-warning{background:#FCF4E6;color:var(--audit-warning)}.audit-status-danger{background:#FDE3E6;color:var(--audit-danger)}.audit-status-info{background:#E8EFFF;color:var(--audit-info)}.audit-status-grey{background:#F2F4F7;color:#475467}.audit-summary-line{display:flex;gap:8px;align-items:center;color:var(--audit-muted);font-size:12px;margin-top:6px;flex-wrap:wrap}.audit-metric-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--audit-gap);margin-bottom:15px}.audit-mini-card{border:1px solid var(--audit-border);border-radius:var(--audit-radius);padding:15px;background:#fff}.audit-mini-card label{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.03em;font-weight:800;color:var(--audit-muted);margin-bottom:5px}.audit-mini-card strong{display:block;font-size:22px;line-height:1.15;color:var(--audit-text);word-break:break-word}.zcs-nodata-wrapper{min-height:180px;border:1px dashed var(--audit-border);border-radius:var(--audit-radius);background:#FCFCFF}.zcs-nodata-header{font-size:15px}.audit-empty-text{color:var(--audit-muted);margin:6px 0 0}.audit-mobile-list{display:none}.audit-mobile-card{border:1px solid var(--audit-border);border-radius:var(--audit-radius);padding:12px;background:#fff;margin-bottom:10px}.audit-mobile-card:last-child{margin-bottom:0}.audit-mobile-title{font-weight:800;margin:0 0 4px;color:var(--audit-text)}.audit-mobile-line{font-size:12px;color:var(--audit-muted);margin:2px 0}.audit-mobile-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}@media (max-width:1400px){.audit-kpi-grid{grid-template-columns:repeat(4,minmax(160px,1fr))}}@media (max-width:1024px){.audit-section{grid-column:span 12}.audit-metric-row{grid-template-columns:1fr}}@media (max-width:768px){.compliance-audit-dashboard{padding:15px}.audit-header{align-items:flex-start;flex-direction:column}.audit-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.audit-section{min-height:auto}.audit-scroll{height:320px}.audit-table-wrapper-mobile{display:none}.audit-mobile-list{display:block}.audit-section-header{align-items:flex-start;flex-direction:column}.audit-readonly-pill{white-space:normal}}@media (max-width:520px){.audit-kpi-grid{grid-template-columns:1fr}.audit-title{font-size:20px}}
</style>

<div class="compliance-audit-dashboard">
	<div class="audit-shell">
		<section class="audit-header">
			<div class="audit-title-block">
				<p class="audit-kicker">Compliance Oversight</p>
				<h1 class="audit-title">Compliance Audit Dashboard</h1>
				<p class="audit-subtitle">Read-only oversight for conflicts, confidential documents, lifecycle changes, missed legal obligations, overdue work, and billing exceptions.</p>
			</div>
			<div class="audit-readonly-pill"><i class="zc-li-outline ui-1-eye-17"></i><span>Read-only audit view</span></div>
		</section>

		<section class="audit-kpi-grid">
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Conflict or Waiver</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon red"><i class="zc-li-outline ui-1-circle-remove"></i></span><div><p class="audit-kpi-value"><%=conflictRiskCount%></p><p class="audit-kpi-note">Conflict found or waiver required</p></div></div></div></div>
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Highly Confidential</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon violet"><i class="zc-li-outline files-folder-14"></i></span><div><p class="audit-kpi-value"><%=highConfidentialDocCount%></p><p class="audit-kpi-note">Restricted document oversight</p></div></div></div></div>
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Missed Deadlines</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon red"><i class="zc-li-outline ui-2-time"></i></span><div><p class="audit-kpi-value"><%=missedDeadlineCount%></p><p class="audit-kpi-note">Missed or past due open items</p></div></div></div></div>
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Overdue Tasks</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon yellow"><i class="zc-li-outline ui-1-check-circle-08"></i></span><div><p class="audit-kpi-value"><%=overdueTaskCount%></p><p class="audit-kpi-note">Open tasks past due</p></div></div></div></div>
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Rejected or Waiver</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon blue"><i class="zc-li-outline business-hammer"></i></span><div><p class="audit-kpi-value"><%=rejectedWaiverConflictCount%></p><p class="audit-kpi-note">Waiver or rejected approvals</p></div></div></div></div>
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Cancelled Invoices</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon grey"><i class="zc-li-outline files-paper"></i></span><div><p class="audit-kpi-value"><%=cancelledInvoiceCount%></p><p class="audit-kpi-note">Total $<%=cancelledInvoiceTotal%></p></div></div></div></div>
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Overdue Invoices</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon red"><i class="zc-li-outline business-money-time"></i></span><div><p class="audit-kpi-value"><%=overdueInvoiceCount%></p><p class="audit-kpi-note">Balance $<%=overdueInvoiceBalance%></p></div></div></div></div>
			<div class="zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative audit-kpi"><div class="zcs-card-header zcs-box-border"><h6 class="audit-kpi-title">Recent History</h6></div><div class="zcs-card-content zcs-col-common zcs-box-border"><div class="zcs-card-content-inner zcs-flex zcs-align-items-center zcs-gap-12"><span class="audit-icon violet"><i class="zc-li-outline files-time"></i></span><div><p class="audit-kpi-value"><%=recentHistoryCount%></p><p class="audit-kpi-note">Events in the last 14 days</p></div></div></div></div>
		</section>

		<section class="audit-section-grid">
			<div class="audit-section">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline ui-1-circle-remove"></i></span><div><h2>Conflict Found or Waiver Required</h2><p>Potential conflicts requiring partner, waiver, or rejection oversight.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=conflictRiskCount%></span></div></div>
				<div class="audit-scroll">
					<% if(conflictRiskRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No conflict exceptions</h5><p class="audit-empty-text">No conflict found or waiver-required checks are currently recorded.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Opposing Party</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Decision</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Severity</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Checked</th></tr></thead><tbody>
						<% for each conflict in conflictRiskRows { decisionClass = if(conflict.Decision == "Conflict Found","audit-status-danger","audit-status-warning"); %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><% if(conflict.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=conflict.Case.ID%>"><%=ifnull(conflict.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(conflict.Case.Case_Title,"No matter")%><% } %></div><div class="audit-sub"><%=ifnull(conflict.Client.Client_Name,"No client")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(conflict.Opposing_Party_Name,"Not recorded")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill <%=decisionClass%>"><%=ifnull(conflict.Decision,"No decision")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill audit-status-grey"><%=ifnull(conflict.Conflict_Severity,"No severity")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><%=ifnull(conflict.Checked_On,"No date")%></div><div class="audit-sub"><%=ifnull(conflict.Checked_By.Employee_Name.first_name,"Unassigned")%></div></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each conflictCard in conflictRiskRows { cClass = if(conflictCard.Decision == "Conflict Found","audit-status-danger","audit-status-warning"); %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><% if(conflictCard.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=conflictCard.Case.ID%>"><%=ifnull(conflictCard.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(conflictCard.Case.Case_Title,"No matter")%><% } %></p><p class="audit-mobile-line"><%=ifnull(conflictCard.Opposing_Party_Name,"Not recorded")%> · <%=ifnull(conflictCard.Client.Client_Name,"No client")%></p><div class="audit-mobile-meta"><span class="audit-status-pill <%=cClass%>"><%=ifnull(conflictCard.Decision,"No decision")%></span><span class="audit-status-pill audit-status-grey"><%=ifnull(conflictCard.Conflict_Severity,"No severity")%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>

			<div class="audit-section">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline files-folder-14"></i></span><div><h2>Highly Confidential Documents</h2><p>Document records that require strict visibility and sharing oversight.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline files-folder-14"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=highConfidentialDocCount%></span></div></div>
				<div class="audit-scroll">
					<% if(highConfidentialDocRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No highly confidential documents</h5><p class="audit-empty-text">No documents are currently marked highly confidential.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Document</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Review Due</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Client Visible</th></tr></thead><tbody>
						<% for each doc in highConfidentialDocRows { visibleClass = if(doc.Visible_To_Client == true,"audit-status-danger","audit-status-success"); visibleText = if(doc.Visible_To_Client == true,"Client visible","Internal only"); %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><%=ifnull(doc.Document_Title,"Untitled document")%></div><div class="audit-sub"><%=ifnull(doc.Document_Type.Document_Type_Name,"No type")%> · Version <%=ifnull(doc.Version_Number,"1")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><% if(doc.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=doc.Case.ID%>"><%=ifnull(doc.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(doc.Case.Case_Title,"No matter")%><% } %></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill audit-status-primary"><%=ifnull(doc.Document_Status,"No status")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(doc.Review_Due_Date,"Not set")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill <%=visibleClass%>"><%=visibleText%></span></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each docCard in highConfidentialDocRows { vClass = if(docCard.Visible_To_Client == true,"audit-status-danger","audit-status-success"); vText = if(docCard.Visible_To_Client == true,"Client visible","Internal only"); %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><%=ifnull(docCard.Document_Title,"Untitled document")%></p><p class="audit-mobile-line"><% if(docCard.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=docCard.Case.ID%>"><%=ifnull(docCard.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(docCard.Case.Case_Title,"No matter")%><% } %></p><div class="audit-mobile-meta"><span class="audit-status-pill audit-status-primary"><%=ifnull(docCard.Document_Status,"No status")%></span><span class="audit-status-pill <%=vClass%>"><%=vText%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>

			<div class="audit-section">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline ui-2-time"></i></span><div><h2>Missed Deadlines</h2><p>Deadlines marked missed or past due while still open or extended.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=missedDeadlineCount%></span></div></div>
				<div class="audit-scroll">
					<% if(missedDeadlineRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No missed deadlines</h5><p class="audit-empty-text">No missed or past-due open deadlines are currently visible.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Deadline</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Responsible</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Priority</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th></tr></thead><tbody>
						<% for each deadline in missedDeadlineRows { deadlineClass = if(deadline.Priority == "Critical","audit-status-danger",if(deadline.Priority == "High","audit-status-warning","audit-status-info")); %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><%=ifnull(deadline.Deadline_Type,"Deadline")%></div><div class="audit-sub"><%=ifnull(deadline.Deadline_Date,"No date")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><% if(deadline.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=deadline.Case.ID%>"><%=ifnull(deadline.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(deadline.Case.Case_Title,"No matter")%><% } %></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(deadline.Responsible_Attorney.Employee_Name.first_name,"Unassigned")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill <%=deadlineClass%>"><%=ifnull(deadline.Priority,"No priority")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill audit-status-danger"><%=ifnull(deadline.Deadline_Status,"Past due")%></span></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each deadlineCard in missedDeadlineRows { dClass = if(deadlineCard.Priority == "Critical","audit-status-danger",if(deadlineCard.Priority == "High","audit-status-warning","audit-status-info")); %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><%=ifnull(deadlineCard.Deadline_Type,"Deadline")%> · <%=ifnull(deadlineCard.Deadline_Date,"No date")%></p><p class="audit-mobile-line"><% if(deadlineCard.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=deadlineCard.Case.ID%>"><%=ifnull(deadlineCard.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(deadlineCard.Case.Case_Title,"No matter")%><% } %></p><div class="audit-mobile-meta"><span class="audit-status-pill <%=dClass%>"><%=ifnull(deadlineCard.Priority,"No priority")%></span><span class="audit-status-pill audit-status-danger"><%=ifnull(deadlineCard.Deadline_Status,"Past due")%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>

			<div class="audit-section">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span><div><h2>Overdue Tasks</h2><p>Open matter tasks past due or explicitly marked overdue.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=overdueTaskCount%></span></div></div>
				<div class="audit-scroll">
					<% if(overdueTaskRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No overdue tasks</h5><p class="audit-empty-text">No missed open assignments are currently visible.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Task</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Assigned</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Due</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th></tr></thead><tbody>
						<% for each task in overdueTaskRows { taskClass = if(task.Priority == "Critical","audit-status-danger",if(task.Priority == "High","audit-status-warning","audit-status-info")); %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><%=ifnull(task.Task_Title,"Untitled task")%></div><div class="audit-sub"><%=ifnull(task.Task_Type,"Task")%> · <%=ifnull(task.Priority,"No priority")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><% if(task.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=task.Case.ID%>"><%=ifnull(task.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(task.Case.Case_Title,"No matter")%><% } %></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(task.Assigned_To.Employee_Name.first_name,"Unassigned")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(task.Due_Date,"No due date")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill <%=taskClass%>"><%=ifnull(task.Task_Status,"Overdue")%></span></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each taskCard in overdueTaskRows { tClass = if(taskCard.Priority == "Critical","audit-status-danger",if(taskCard.Priority == "High","audit-status-warning","audit-status-info")); %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><%=ifnull(taskCard.Task_Title,"Untitled task")%></p><p class="audit-mobile-line"><% if(taskCard.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=taskCard.Case.ID%>"><%=ifnull(taskCard.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(taskCard.Case.Case_Title,"No matter")%><% } %></p><p class="audit-mobile-line">Assigned: <%=ifnull(taskCard.Assigned_To.Employee_Name.first_name,"Unassigned")%> · Due <%=ifnull(taskCard.Due_Date,"No due date")%></p><div class="audit-mobile-meta"><span class="audit-status-pill <%=tClass%>"><%=ifnull(taskCard.Task_Status,"Overdue")%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>

			<div class="audit-section">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline business-hammer"></i></span><div><h2>Rejected or Waiver Conflict Checks</h2><p>Waiver-needed or rejected approval records requiring compliance follow-up.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline business-hammer"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=rejectedWaiverConflictCount%></span></div></div>
				<div class="audit-scroll">
					<% if(rejectedWaiverConflictRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No waiver or rejected conflict checks</h5><p class="audit-empty-text">No waiver-needed or rejected conflict approval records are currently visible.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Decision</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Approval</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Checked By</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Checked On</th></tr></thead><tbody>
						<% for each waiver in rejectedWaiverConflictRows { approvalClass = if(waiver.Approval_Status == "Rejected","audit-status-danger",if(waiver.Decision == "Waiver Required","audit-status-warning","audit-status-info")); %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><% if(waiver.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=waiver.Case.ID%>"><%=ifnull(waiver.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(waiver.Case.Case_Title,"No matter")%><% } %></div><div class="audit-sub"><%=ifnull(waiver.Opposing_Party_Name,"No opposing party")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill audit-status-warning"><%=ifnull(waiver.Decision,"No decision")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill <%=approvalClass%>"><%=ifnull(waiver.Approval_Status,"No approval status")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(waiver.Checked_By.Employee_Name.first_name,"Unassigned")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(waiver.Checked_On,"No date")%></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each waiverCard in rejectedWaiverConflictRows { wClass = if(waiverCard.Approval_Status == "Rejected","audit-status-danger",if(waiverCard.Decision == "Waiver Required","audit-status-warning","audit-status-info")); %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><% if(waiverCard.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=waiverCard.Case.ID%>"><%=ifnull(waiverCard.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(waiverCard.Case.Case_Title,"No matter")%><% } %></p><p class="audit-mobile-line"><%=ifnull(waiverCard.Opposing_Party_Name,"No opposing party")%></p><div class="audit-mobile-meta"><span class="audit-status-pill audit-status-warning"><%=ifnull(waiverCard.Decision,"No decision")%></span><span class="audit-status-pill <%=wClass%>"><%=ifnull(waiverCard.Approval_Status,"No approval status")%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>

			<div class="audit-section">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline files-paper"></i></span><div><h2>Cancelled Invoices</h2><p>Invoice cancellations retained for billing exception review.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline files-paper"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=cancelledInvoiceCount%></span></div></div>
				<div class="audit-scroll">
					<div class="audit-metric-row"><div class="audit-mini-card"><label>Cancelled invoice count</label><strong><%=cancelledInvoiceCount%></strong></div><div class="audit-mini-card"><label>Cancelled invoice total</label><strong>$<%=cancelledInvoiceTotal%></strong></div></div>
					<% if(cancelledInvoiceRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No cancelled invoices</h5><p class="audit-empty-text">No invoices are currently cancelled.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table compact"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Invoice</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Client</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Total</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Invoice Date</th></tr></thead><tbody>
						<% for each cancelled in cancelledInvoiceRows { %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><a class="audit-link" href="#Page:Billing_Detail?Invoice_ID=<%=cancelled.ID%>">Invoice <%=ifnull(cancelled.Invoice_Number,"Pending number")%></a><div class="audit-sub"><%=ifnull(cancelled.Invoice_Status,"Cancelled")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(cancelled.Client.Client_Name,"No client")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><% if(cancelled.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=cancelled.Case.ID%>"><%=ifnull(cancelled.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(cancelled.Case.Case_Title,"No matter")%><% } %></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary">$<%=ifnull(cancelled.Total_Amount,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(cancelled.Invoice_Date,"No date")%></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each cancelledCard in cancelledInvoiceRows { %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><a class="audit-link" href="#Page:Billing_Detail?Invoice_ID=<%=cancelledCard.ID%>">Invoice <%=ifnull(cancelledCard.Invoice_Number,"Pending number")%></a></p><p class="audit-mobile-line"><%=ifnull(cancelledCard.Client.Client_Name,"No client")%> · $<%=ifnull(cancelledCard.Total_Amount,0)%></p><div class="audit-mobile-meta"><span class="audit-status-pill audit-status-grey"><%=ifnull(cancelledCard.Invoice_Status,"Cancelled")%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>

			<div class="audit-section audit-wide">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline business-money-time"></i></span><div><h2>Overdue Invoices</h2><p>Invoices marked overdue or past due with an open balance.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline business-money-time"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=overdueInvoiceCount%> · $<%=overdueInvoiceBalance%></span></div></div>
				<div class="audit-scroll">
					<% if(overdueInvoiceRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No overdue invoices</h5><p class="audit-empty-text">No past-due open balances are currently visible.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Invoice</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Client</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Balance Due</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Due Date</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th></tr></thead><tbody>
						<% for each invoice in overdueInvoiceRows { %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><a class="audit-link" href="#Page:Billing_Detail?Invoice_ID=<%=invoice.ID%>">Invoice <%=ifnull(invoice.Invoice_Number,"Pending number")%></a><div class="audit-sub"><%=ifnull(invoice.Invoice_Date,"No invoice date")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(invoice.Client.Client_Name,"No client")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><% if(invoice.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=invoice.Case.ID%>"><%=ifnull(invoice.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(invoice.Case.Case_Title,"No matter")%><% } %></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-red">$<%=ifnull(invoice.Balance_Due,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(invoice.Due_Date,"No due date")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="audit-status-pill audit-status-danger"><%=ifnull(invoice.Invoice_Status,"Overdue")%></span></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each invoiceCard in overdueInvoiceRows { %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><a class="audit-link" href="#Page:Billing_Detail?Invoice_ID=<%=invoiceCard.ID%>">Invoice <%=ifnull(invoiceCard.Invoice_Number,"Pending number")%></a></p><p class="audit-mobile-line"><%=ifnull(invoiceCard.Client.Client_Name,"No client")%> · Balance $<%=ifnull(invoiceCard.Balance_Due,0)%></p><p class="audit-mobile-line">Due <%=ifnull(invoiceCard.Due_Date,"No due date")%></p><div class="audit-mobile-meta"><span class="audit-status-pill audit-status-danger"><%=ifnull(invoiceCard.Invoice_Status,"Overdue")%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>

			<div class="audit-section audit-wide">
				<div class="audit-section-header"><div class="audit-section-title"><span class="audit-section-icon"><i class="zc-li-outline files-time"></i></span><div><h2>Recent Case History Events</h2><p>Latest Add Case History events across lifecycle, conflict, document, task, deadline, and billing changes.</p></div></div><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline files-time"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=recentHistoryCount%> in 14 days</span></div></div>
				<div class="audit-scroll">
					<% if(historyRows.count() == 0) { %>
						<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No history events</h5><p class="audit-empty-text">No Add Case History events are currently available.</p></div></div>
					<% } else { %>
						<div class="zcs-table-wrapper audit-table-wrapper-mobile zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full audit-table history"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Event</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Matter</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status Change</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Changed By</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Summary</th></tr></thead><tbody>
						<% for each hist in historyRows { %>
							<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><%=ifnull(hist.Event_Type,"Event")%></div><div class="audit-sub"><%=ifnull(hist.Event_Date,"No date")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><% if(hist.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=hist.Case.ID%>"><%=ifnull(hist.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(hist.Case.Case_Title,"No matter")%><% } %></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><div class="audit-main"><%=ifnull(hist.Previous_Status,"Not recorded")%></div><div class="audit-sub">to <%=ifnull(hist.New_Status,"Not recorded")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(hist.Changed_By.Employee_Name.first_name,"System")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(hist.Summary,"No summary")%></td></tr>
						<% } %>
						</tbody></table></div>
						<div class="audit-mobile-list">
						<% for each histCard in historyRows { %>
							<div class="audit-mobile-card"><p class="audit-mobile-title"><%=ifnull(histCard.Event_Type,"Event")%> · <%=ifnull(histCard.Event_Date,"No date")%></p><p class="audit-mobile-line"><% if(histCard.Case != null) { %><a class="audit-link" href="#Page:Case_Detail?Case_ID=<%=histCard.Case.ID%>"><%=ifnull(histCard.Case.Case_Title,"No matter")%></a><% } else { %><%=ifnull(histCard.Case.Case_Title,"No matter")%><% } %></p><p class="audit-mobile-line"><%=ifnull(histCard.Summary,"No summary")%></p><div class="audit-mobile-meta"><span class="audit-status-pill audit-status-primary"><%=ifnull(histCard.Previous_Status,"Not recorded")%> to <%=ifnull(histCard.New_Status,"Not recorded")%></span></div></div>
						<% } %>
						</div>
					<% } %>
				</div>
			</div>
		</section>
	</div>
</div>