<style>
/* Decision box(Search - cancel icon) */ .zc-pra-filter .form-group.zc-decisionbox-field-group { width: auto; height: 36px; position: absolute; right: 7px; top: 0px; z-index: 1; margin: 0px; } .zc-pra-filter .form-group .decision-box-field { display: none; } .zc-pra-filter .form-outer-wrapper .formColumn .zc-decisionbox-field-group .form-label.decision-box-label { height: 36px; font-size: 0px; line-height: 36px; padding: 0px; } .zc-pra-filter .form-label.decision-box-label:before { content: '\\ed84'; font-family: 'ZC Live Outline'; font-size: 17px; } .zc-pra-filter .form-label.decision-box-label:hover:before { color: #EE3131; } .zc-pra-filter .form-group .cogLoader { margin: 11px 3px; }.zc-rtl-wrapper .zc-pra-filter .formColumn:not(.first-column) .form-group:not(:first-child) { margin-left: 0px; margin-right: 20px; } .zc-rtl-wrapper .zc-pra-filter .formContainer .formColumn.second-column { float: left; } /* Placeholder */ .zc-rtl-wrapper .zc-pra-filter .first-column .form-group label .zc-label-text:after { margin-left: 0px; margin-right: 18px; } .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search_Key-group .form-field:before, .zc-rtl-wrapper .zc-pra-filter .form-group.zc-Search-group .form-field:before { left: auto; right: 12px; } /* Decision box(Search - cancel icon) */ .zc-rtl-wrapper .zc-pra-filter .form-group.zc-decisionbox-field-group { right: auto; left: 7px; }.zc-pra-more-options { border: 1px solid; text-align: center; cursor: pointer; position: relative; } .zc-pra-more-options.zc-pra-square { width: 36px; height: 36px; background-color: #FFFFFF; border-color: #EBECF0; border-radius: 6px; color: #666D79; } .zc-pra-more-options.zc-pra-rounded { width: 30px; height: 30px; background-color: transparent; border-color: transparent; border-radius: 50%; color: #666D79; } .zc-pra-more-options .zc-pra-hover-extend { width: calc(160px / 2); height: 20px; position: absolute; z-index: 0; right: 0px; bottom: -7px; display: none; } .zc-pra-more-options .fa.fa-bars, .zc-pra-more-options .fa.fa-ellipsis-h, .zc-pra-more-options .ui-2-menu-dots { vertical-align: top; } .zc-pra-more-options .fa.fa-bars { line-height: 34px; } .zc-pra-more-options .fa.fa-ellipsis-h, .zc-pra-more-options .ui-2-menu-dots { line-height: 28px; } .zc-pra-more-options.zc-pra-square ul { top: 40px; } .zc-pra-more-options.zc-pra-rounded ul { top: 34px; } .zc-pra-more-options ul { width: 160px; background-color: #FFFFFF; box-shadow: 0 2px 9px 0 #d8d8d880; border: 1px solid #EBECF0; border-radius: 6px; padding: 8px; position: absolute; right: 0px; z-index: 2; display: none; } .zc-pra-more-options ul li { list-style-type: none; } .zc-pra-more-options ul li:not(:last-child) { margin-bottom: 4px; } .zc-pra-more-options ul li a { width: 100%; display: inline-block; vertical-align: top; font-size: 14px; font-weight: 400; line-height: 20px; color: #131635; text-align: left; padding: 8px; border-radius: 6px; } .zc-pra-more-options ul li a i, .zc-pra-more-options ul li a span { float: left; } .zc-pra-more-options ul li.zc-pra-color-red a i, .zc-pra-more-options ul li.zc-pra-color-red a span { color: #E71F43; } .zc-pra-more-options ul li a i { width: 14px; line-height: 20px; margin-right: 8px; } .zc-pra-more-options ul li a i+span { width: calc(100% - 22px); } .zc-pra-more-options.zc-pra-square:hover { border-color: var(--theme_brand_color); color: var(--theme_brand_color); } .zc-pra-more-options.zc-pra-rounded:hover { background-color: #EAECF0; color: #131635; } .zc-pra-more-options:hover>.zc-pra-hover-extend, .zc-pra-more-options:hover ul { display: block; } .zc-pra-more-options ul li a:hover { background-color: var(--left_pane_section_selected); } .zc-pra-more-options ul li.zc-pra-color-red a:hover { background-color: #E71F431A; } .zc-pra-more-options i { font-style: normal; }.zc-rtl-wrapper .zc-pra-more-options .zc-pra-hover-extend, .zc-rtl-wrapper .zc-pra-more-options ul { right: auto; left: 0px; } .zc-rtl-wrapper .zc-pra-more-options ul li a { text-align: right; } .zc-rtl-wrapper .zc-pra-more-options ul li a i, .zc-rtl-wrapper .zc-pra-more-options ul li a span { float: right; } .zc-rtl-wrapper .zc-pra-more-options ul li a i { margin-right: 0px; margin-left: 8px; }.zc-pra-custom-detail-content { height: calc(100% - 68px); padding: 30px 0px; overflow-x: hidden; } .zc-pra-filter .select2-container.select2-allowclear .select2-choice abbr { display: none; } ul.zc-pra-zigzag-wrapper { width: 725px; position: relative; margin: 0px auto 20px; display: flex; justify-content: center; } ul.zc-pra-zigzag-wrapper:nth-child(odd) { justify-content: flex-start; } ul.zc-pra-zigzag-wrapper li.zc-pra-zigzag-li { display: flex; flex-direction: row; align-items: center; } ul.zc-pra-zigzag-wrapper li .zc-pra-card { width: 300px; box-shadow: 0 2px 9px 0 #d8d8d880; position: relative; z-index: 1; } .zc-pra-zcard-header { padding: 10px 16px; border-bottom: 1px solid #EBECF0; } .zc-pra-zcard-title { width: calc(100% - 30px); padding: 5px 0px; } .zc-pra-no-wrapper { width: 20px; height: 20px; border-radius: 4px; margin-right: 8px; background-color: var(--section_menu_active_bg_color); color: var(--theme_brand_color); font-size: 14px; font-weight: 500; line-height: 20px; text-align: center; } .zc-pra-zcard-title h6 { width: calc(100% - 28px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-zcard-content { padding: 16px; } .zc-pra-zcard-content ul li { list-style-type: none; } .zc-pra-zcard-content ul li:not(:last-child) { margin-bottom: 8px; } .zc-pra-zcard-content label, .zc-pra-zcard-content span { font-size: 14px; line-height: 29px; display: inline-block; vertical-align: top; } .zc-pra-zcard-content label { width: 80px; font-weight: 400; color: #666D79; padding-right: 8px; } .zc-pra-zcard-badge { display: inline-block; vertical-align: top; } .zc-pra-zcard-content span { color: #131635; font-weight: 500; } .zc-pra-zcard-content span.zc-pra-currency-value { margin: 0px; } .zc-pra-zcard-badge span { background-color: var(--section_menu_active_bg_color); padding: 4px 8px; border-radius: 4px; line-height: 21px; } .zc-pra-zcard-content > ul > li > span, .zc-pra-zcard-content > ul > li > div { width: calc(100% - 80px); } .zc-pra-zcard-content span.zc-pra-color-green { color: #179E6C; } .zc-pra-zcard-content .zc-pra-img-wrapper { width: 30px; height: 30px; border-radius: 50%; margin: 6px 8px 6px 0px; } .zc-pra-zcard-content .zc-pra-img-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: contain; } .zc-pra-zcard-content .zc-pra-img-txt-wrapper { width: calc(100% - 38px); } .zc-pra-img-txt-wrapper span { line-height: 1.5; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .zc-pra-img-txt-wrapper span.zc-pra-sm-txt { font-size: 12px; color: #666D79; margin-top: 3px; } 
.zc-pra-fwh {
		width: 100%;
		height: 100%;
}
ul.zc-pra-zigzag-wrapper li .zc-pra-card{
	overflow: hidden;
}
.zc-pra-zcard-header{
	background: var(--theme_brand_color);
}
.zc-pra-page-container h6{
	color: #ffffff !important;
}
.zc-pra-more-options .ui-2-menu-dots{
	    color: #ffffff;
}
.zc-pra-more-options:hover .ui-2-menu-dots {
		color:  var(--theme_brand_color); 
}

.zc-pra-nodata {
		position: relative;
		text-align: center;
}
.zc-pra-nodata-content {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
}
.zc-pra-more-options ul li a:hover {
		background-color: #ebf0ff;
}
.zc_live_adminbar .zc-container-wrapper {
		height: 100%;
	}
	.zc-pra-nodata-btns {
		margin-top: 24px;
}
.zc-pra-no-wrapper {
		background-color: var(--secondary_color) !important;
}
.zc-pra-zcard-badge span {
	 background-color: var(--secondary_color) !important;
	color: var(--theme_brand_color) !important;
}
.zc-pra-page-content{
	padding: unset !important;
}

</style>
<%
	approvalFlows = Add_Approval_Setup[Approval_Setup_For == input.recID && Status == null || Status == "Active"] sort by Sequence_Order;
	flowsList = List();
	for each  flow in approvalFlows
	{
		flowsList.add({"Level_Name":flow.Level_Name,"Approver_Role":flow.Approver_Role.Role,"Approver_Type":flow.Approver_Type,"ID":flow.ID,"Previous_Sequence_Number":flow.Sequence_Order,"Is_Last_Step":flow.Is_Last_Step,"Requester_Role_Param":flow.Added_User,"users":flow.users});
	}
	%>
<style>
/*trmp*/
.zc-pra-setup .divEmbedContainer {
	height: calc(100% - 87px) !important;
}
ul.zc-pra-horizontal-tabhead {
		display: none !important;
}

.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .zc-pb-page-content-wrapper {
	border-radius:unset !important;
}
.zc-pra-card.zc-pra-horizontal-tabpanel {
	height: calc(100% - 70px) ;
	border: unset !important;
	}
	.zc-pra-page-content, .zc-pra-custom-detail-content, .zc-pra-horizontal-tabbody{
	   height: 100% !important;	
	}
	
/*end*/
<%=thisapp.styles.CommonStyles()%>
<%=thisapp.PageStyles.Custom_Approval_Template()%>
<%=thisapp.PageStyles.Custom_Approval_Details()%>

</style>
<div class='zc-pra-page-container zc-pra-system-detail'>
	<div class='zc-pra-page-container-inner zc-pra-fwh'>
		<div class='zc-pra-page-header zc-pra-clearfix zc-pra-fw' style="padding: 10px !important; border-bottom: unset;">
			<div class='zc-pra-flt-left zc-pra-clearfix zc-pra-header-title'>
				<a class='zc-pra-flt-left zc-pra-back-icon' href='#Page:All_Approval_Setup?zc_LoadIn=embed-embedDiv'>
					<span class='fa fa-angle-left'></span>
				</a>
				<h5 class='zc-pra-flt-left'>Back</h5>
			</div>

</div>
		<div class='zc-pra-page-content'>
			<div class='zc-pra-card zc-pra-horizontal-tabpanel'>
				<ul class='zc-pra-horizontal-tabhead'>
					<li> 
						<a href='#Page:Approval_Setup?recID=1&module=Purchase-Request' class='Purchase-Request'> Vendor Onboard Approval</a> 
			  		</li>
					<li>
						<a href='#Page:Approval_Setup?recID=2&module=Purchase-Order' class='Purchase-Order'>Invoice Approval</a> 
					</li>
					
					</ul>
				<div class='zc-pra-horizontal-tabbody'>
					<!--<div class='zc-pra-filter' elName='zc-component' formLinkName='Approval_Filter_Form' params=''></div>-->
					<div class='zc-pra-custom-detail-content zc-pra-fwh '>
<%
	if(approvalFlows.count() > 0)
	{
		i = 0;
		counter = 1;
		for each  item in flowsList
		{
			if(counter.isOdd())
			{
				if(counter > 1)
				{
					i = i + 1;
				}
				secondLiIndex = i + 1;
				if(i < flowsList.size())
				{
					%>
<ul class='zc-pra-zigzag-wrapper'>
	
							<%=thisapp.Components.ApprovalCard({"ID":flowsList.get(i).get("ID"),"Sequence_Order":i + 1,"Level_name":flowsList.get(i).get('Level_Name'),"Approval_For_Role":flowsList.get(i).get("Approval_For_Role"),"Approver_Type":flowsList.get(i).get('Approver_Type'),"Approver_Role":flowsList.get(i).get("Approver_Role"),"Previous_Sequence_Number":flowsList.get(i).get("Previous_Sequence_Number"),"Show_Add_Before":if(counter == 1,true,false),"Type_field":input.recID,"Template_ID":input.recID,"Approver_User":flowsList.get(i).get('Approver_User'),"Is_Preview":false,"Price_From":flowsList.get(i).get("Price_From"),"Price_To":flowsList.get(i).get("Price_To"),"Is_Last_Step":flowsList.get(i).get("Is_Last_Step"),"Requester_Role_Param":flowsList.get(i).get("Requester_Role_Param"),"users":flowsList.get(i).get("users")})%>
<%
				}
				if(secondLiIndex < flowsList.size())
				{
					%>
<%=thisapp.Components.ApprovalCard({"ID":flowsList.get(secondLiIndex).get("ID"),"Sequence_Order":secondLiIndex + 1,"Level_name":flowsList.get(secondLiIndex).get('Level_Name'),"Approval_For_Role":flowsList.get(secondLiIndex).get("Approval_For_Role"),"Approver_Type":flowsList.get(secondLiIndex).get('Approver_Type'),"Approver_Role":flowsList.get(secondLiIndex).get("Approver_Role"),"Previous_Sequence_Number":flowsList.get(secondLiIndex).get("Previous_Sequence_Number"),"Show_Add_Before":false,"Type_field":input.recID,"Template_ID":input.recID,"Approver_User":flowsList.get(secondLiIndex).get('Approver_User'),"Is_Preview":false,"Price_From":flowsList.get(secondLiIndex).get("Price_From"),"Price_To":flowsList.get(secondLiIndex).get("Price_To"),"Is_Last_Step":flowsList.get(secondLiIndex).get("Is_Last_Step"),"Requester_Role_Param":flowsList.get(secondLiIndex).get("Requester_Role_Param"),"users":flowsList.get(secondLiIndex).get("users")})%>
<%
				}
				%>
</ul>
<%
			}
			else
			{
				singleIndex = i + 1;
				if(singleIndex < flowsList.size())
				{
					%>
<ul class='zc-pra-zigzag-wrapper'>
<%=thisapp.Components.ApprovalCard({"ID":flowsList.get(singleIndex).get("ID"),"Sequence_Order":singleIndex + 1,"Level_name":flowsList.get(singleIndex).get('Level_Name'),"Approval_For_Role":flowsList.get(singleIndex).get("Approval_For_Role"),"Approver_Type":flowsList.get(singleIndex).get('Approver_Type'),"Approver_Role":flowsList.get(singleIndex).get("Approver_Role"),"Previous_Sequence_Number":flowsList.get(singleIndex).get("Previous_Sequence_Number"),"Show_Add_Before":false,"Type_field":input.recID,"Template_ID":input.recID,"Approver_User":flowsList.get(singleIndex).get('Approver_User'),"Is_Preview":false,"Price_From":flowsList.get(singleIndex).get("Price_From"),"Price_To":flowsList.get(singleIndex).get("Price_To"),"Is_Last_Step":flowsList.get(singleIndex).get("Is_Last_Step"),"Requester_Role_Param":flowsList.get(singleIndex).get("Requester_Role_Param"),"users":flowsList.get(singleIndex).get("users")})%>
						</ul>
<%
				}
			}
			i = i + 1;
			counter = counter + 1;
		}
	}
	else
	{
		img_src = "";
		lastRec = Add_Approval_Setup[Approval_Setup_For == input.recID] sort by Sequence_Order desc range from 0 to 0;
		if(lastRec.count() > 0)
		{
			previousSequenceNumber = lastRec.Sequence_Order;
		}
		else
		{
			previousSequenceNumber = 0;
		}
		%>
<div class='zc-pra-nodata zc-pra-fwh'>
		<div class='zc-pra-nodata-content'>
				<img alt="No Data" src="data:image/svg+xml;base64,">
				<h6> No Data </h6>
				<div class='zc-pra-nodata-btns'>
				 <a class='zc-live-primary-btn' href='#Form:Add_Approval_Setup?Add_Type=Specific&zc_LoadIn=dialog&Type_field=<%=input.recID%>&Sequence_Order=0&Sequence_Order_Display=0&Previous_Sequence_Number=0'> Add Step </a>
				</div>
		</div>
</div>
<%
	}
	%>
</div>
				</div>
			</div>
		</div>
	</div>
</div>