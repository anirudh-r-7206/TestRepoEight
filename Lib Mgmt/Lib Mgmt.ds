application "Lib-Mgmt"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Books
		{
		    title
		    {
		        displayname = "Books"
		        on add = "Add Book"
		        on edit = "Edit Book"
		    }
		    success message = "Book saved successfully."
		
		    Book_Details
		    (
		        type = section
		        displayname = "Book Details"
		        row = 1
		        column = 0
		    )
		    must have Book_Name
		    (
		        type = text
		        displayname = "Book Name"
		        maxchar = 255
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Price
		    (
		        type = INR
		        displayname = "Price"
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Book_Type
		    (
		        type = text
		        displayname = "Book Type"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	web
	{
	forms
	{
	    form Books
	    {
	        label placement = left
	    }
	}
	menu
	{
	    space Library
	    {
	        displayname = "Library"
	        icon = "education-books-46"
	
	        section Catalog
	        {
	            displayname = "Catalog"
	            icon = "education-book-open"
	
	            form Books
	            {
	                icon = "education-book-39"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    font = "lato"
	
	    color options
	    {
	        color = "3"
	    }
	}
	}
}
