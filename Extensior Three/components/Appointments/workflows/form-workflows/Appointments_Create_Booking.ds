Appointments_Create_Booking as "Appointments Create Booking"
{
    type = form
    form = Appointments
    record event = on add

    on success
    {
        actions
        {
            custom deluge script
            (
                settings_count = Booking_Settings[ID != 0].count();
                if(settings_count == 0)
                {
                    input.Sync_Status = "Failed";
                    input.Last_Sync_Message = "Booking configuration is missing. Create the Booking Settings record before adding appointments.";
                }
                else
                {
                    settings = Booking_Settings[ID != 0] range from 0 to 0;
                    customer_details = Map();
                    customer_details.put("name",input.Customer_Name);
                    customer_details.put("email",input.Customer_Email);
                    customer_details.put("phone_number",input.Customer_Phone);
                    appointment_start = input.Start_Time.toString("dd-MMM-yyyy HH:mm:ss");
                    try
                    {
                        booking_response = zoho.bookings.createAppointment(settings.Service_ID,appointment_start,customer_details,settings.Assignee_ID,settings.Time_Zone,settings.Assignee_Type == "Staff","zoho_bookings_connection");
                        if(booking_response.containKey("response"))
                        {
                            response_data = booking_response.get("response");
                            if(response_data.containKey("status") && response_data.get("status") == "success" && response_data.containKey("returnvalue"))
                            {
                                return_value = response_data.get("returnvalue");
                                if(return_value.containKey("booking_id"))
                                {
                                    input.Booking_ID = return_value.get("booking_id");
                                }
                                if(return_value.containKey("summary_url"))
                                {
                                    input.Summary_URL = return_value.get("summary_url");
                                }
                                input.Sync_Status = "Synced";
                                input.Synced_At = zoho.currenttime;
                                input.Last_Sync_Message = "Zoho Bookings appointment created successfully.";
                            }
                            else
                            {
                                input.Sync_Status = "Failed";
                                input.Last_Sync_Message = "Zoho Bookings rejected the appointment: " + response_data.toString();
                            }
                        }
                        else
                        {
                            input.Sync_Status = "Failed";
                            input.Last_Sync_Message = "Zoho Bookings returned an unexpected response: " + booking_response.toString();
                        }
                    }
                    catch(e)
                    {
                        input.Sync_Status = "Failed";
                        input.Last_Sync_Message = "Zoho Bookings appointment creation failed: " + e.message;
                    }
                }
            )
        }
    }
}