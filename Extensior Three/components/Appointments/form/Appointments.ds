form Appointments
{
    title
    {
        displayname = "Appointments"
        on add = "Add Appointment"
        on edit = "Edit Appointment"
    }
    success message = "Appointment saved successfully."

    Appointment_Details
    (
        type = section
        displayname = "Appointment Details"
        row = 1
        column = 0
    )
    must have Customer_Name
    (
        type = text
        displayname = "Customer Name"
        row = 1
        column = 1
        width = medium
    )
    must have Customer_Email
    (
        type = email
        displayname = "Customer Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Customer_Phone
    (
        type = phonenumber
        displayname = "Customer Phone"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Start_Time
    (
        type = datetime
        displayname = "Start Time"
        row = 1
        column = 2
        width = medium
    )
    must have End_Time
    (
        type = datetime
        displayname = "End Time"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        row = 1
        column = 2
        width = medium
    )

    Sync_Details
    (
        type = section
        displayname = "Sync Details"
        visibility = true
        row = 2
        column = 1
    )
    Sync_Status
    (
        type = picklist
        displayname = "Sync Status"
        values = {"Pending", "Synced", "Needs Review", "Failed"}
        initial value = "Pending"
        private = true
        row = 2
        column = 1
        width = medium
    )
    Booking_ID
    (
        type = text
        displayname = "Booking ID"
        private = true
        row = 2
        column = 2
        width = medium
    )
    Summary_URL
    (
        type = url
        displayname = "Summary URL"
        private = true
        row = 2
        column = 1
        width = medium
    )
    Last_Sync_Message
    (
        type = textarea
        displayname = "Last Sync Message"
        private = true
        row = 2
        column = 2
        width = medium
    )
    Synced_At
    (
        type = datetime
        displayname = "Synced At"
        private = true
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}