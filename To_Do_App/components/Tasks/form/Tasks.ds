form Tasks
{
    success message = "Task saved."

    Task_Details
    (
        type = section
        displayname = "Task Details"
        row = 1
        column = 0
    )
    must have Task_Title
    (
        type = text
        displayname = "Task"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    must have Priority
    (
        type = picklist
        values = {"Low", "Medium", "High", "Urgent"}
        initial value = "Medium"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        values = {"Not Started", "In Progress", "Completed"}
        initial value = "Not Started"
        row = 1
        column = 2
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )
    Completed
    (
        type = checkbox
        initial value = false
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}