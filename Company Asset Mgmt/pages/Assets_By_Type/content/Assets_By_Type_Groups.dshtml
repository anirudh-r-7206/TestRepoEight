<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f3f4}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-theme{background:var(--zcs_brand_light_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-green{background:#e4fcf3;border-color:#179e6c;color:#179e6c}.zcs-badge-red{background:#fde3e6;border-color:#fe455d;color:#fe455d}.zcs-badge-yellow{background:#fcf4e6;border-color:#faae13;color:#9b6500}.zcs-badge-blue{background:#e8efff;border-color:#2a6ffc;color:#2a6ffc}.zcs-badge-grey{background:#eee;border-color:#686978;color:#4d4e59}.zcs-nodata-wrapper{width:100%;min-height:92px;display:flex;align-items:center;justify-content:center;text-align:center}
.assets-page{background:var(--zcs-page-bg-color);padding:16px;box-sizing:border-box}.asset-group{margin-bottom:18px;overflow:hidden}.asset-group-header{padding:14px 16px;border-bottom:1px solid var(--zcs-border-color);background:var(--zcs-white-color)}.asset-group-icon{font-size:19px;color:var(--zcs-theme-brand-color)}.asset-count{min-width:28px}.asset-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:12px;background:color-mix(in srgb,var(--zcs-page-bg-color) 65%,var(--zcs-white-color))}.zcs-asset-card{min-width:0;padding:16px;transition:border-color .2s ease}.zcs-asset-card:hover{border-color:var(--zcs_brand_color)}.asset-card-top{margin-bottom:12px}.asset-tag{word-break:break-word}.asset-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px}.asset-detail{min-width:0}.asset-label{display:block;color:var(--zcs-teritiary-text-color);font-size:12px;line-height:1.35;margin-bottom:2px}.asset-value{display:block;color:var(--zcs-primary-text-color);font-size:14px;line-height:1.4;overflow-wrap:anywhere}.asset-holder{grid-column:1/-1}.overall-empty{min-height:220px}.overall-empty i{font-size:30px;color:var(--zcs-theme-brand-color)}
@media(max-width:1100px){.asset-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.assets-page{padding:10px}.asset-grid{grid-template-columns:1fr}.asset-group-header{align-items:flex-start}.asset-details{grid-template-columns:1fr}.asset-holder{grid-column:auto}}
</style>
<%
assetTypes = {"Laptop","Monitor","Desktop","Tablet","Mobile Phone","Dock","Peripheral","Other"};
totalAssets = Assets[ID != 0].count();
%>
<div class='assets-page'>
<%
if(totalAssets == 0)
{
%>
  <div class='zcs-card zcs-nodata-wrapper overall-empty'>
    <div class='zcs-nodata-content zcs-p-20 zcs-box-border'>
      <i class='zc-li-outline business-briefcase-24'></i>
      <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No assets found</h5>
      <div class='zcs-font-14 zcs-color-secondary zcs-mt-10'>Add assets to the Assets form to populate these groups.</div>
    </div>
  </div>
<%
}
else
{
  for each assetType in assetTypes
  {
    groupAssets = Assets[Asset_Type == assetType] sort by Asset_Tag asc;
    groupCount = groupAssets.count();
%>
  <section class='zcs-card asset-group'>
    <div class='asset-group-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
      <div class='zcs-flex zcs-align-items-center zcs-gap-8'>
        <i class='zc-li-outline design-layers'></i>
        <h2 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=assetType%></h2>
      </div>
      <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme asset-count'>
        <span class='zcs-badge-text zcs-font-14 zcs-font-medium zcs-lh-body'><%=groupCount%></span>
      </div>
    </div>
<%
    if(groupCount == 0)
    {
%>
    <div class='zcs-nodata-wrapper'>
      <div class='zcs-nodata-content zcs-p-16 zcs-box-border'>
        <h5 class='zcs-font-14 zcs-font-medium zcs-lh-heading zcs-color-secondary zcs-m-0'>No <%=assetType%> assets found</h5>
      </div>
    </div>
<%
    }
    else
    {
%>
    <div class='asset-grid'>
<%
      for each asset in groupAssets
      {
        statusClass = "zcs-badge-blue";
        if(asset.Asset_Status == "Available")
        {
          statusClass = "zcs-badge-green";
        }
        else if(asset.Asset_Status == "Retired" || asset.Asset_Status == "Lost" || asset.Asset_Status == "Stolen")
        {
          statusClass = "zcs-badge-red";
        }
        else if(asset.Asset_Status == "In Repair" || asset.Asset_Status == "Maintenance")
        {
          statusClass = "zcs-badge-yellow";
        }
        else if(asset.Asset_Status == null || asset.Asset_Status == "")
        {
          statusClass = "zcs-badge-grey";
        }
%>
      <article class='zcs-card zcs-asset-card zcs-flex zcs-direction-column'>
        <div class='asset-card-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
          <div class='asset-tag zcs-font-16 zcs-font-semibold zcs-color-primary'><%=ifnull(asset.Asset_Tag,"Not tagged")%></div>
          <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>'>
            <span class='zcs-badge-text zcs-font-12 zcs-font-medium zcs-lh-body'><%=ifnull(asset.Asset_Status,"Not set")%></span>
          </div>
        </div>
        <div class='asset-details'>
          <div class='asset-detail'><span class='asset-label'>Manufacturer</span><span class='asset-value'><%=ifnull(asset.Manufacturer,"Not set")%></span></div>
          <div class='asset-detail'><span class='asset-label'>Model</span><span class='asset-value'><%=ifnull(asset.Model,"Not set")%></span></div>
          <div class='asset-detail'><span class='asset-label'>Serial number</span><span class='asset-value'><%=ifnull(asset.Serial_Number,"Not set")%></span></div>
          <div class='asset-detail'><span class='asset-label'>Condition</span><span class='asset-value'><%=ifnull(asset.Condition,"Not set")%></span></div>
          <div class='asset-detail asset-holder'><span class='asset-label'>Current holder</span><span class='asset-value'><%=ifnull(asset.Current_Holder,"Unassigned")%></span></div>
        </div>
      </article>
<%
      }
%>
    </div>
<%
    }
%>
  </section>
<%
  }
}
%>
</div>