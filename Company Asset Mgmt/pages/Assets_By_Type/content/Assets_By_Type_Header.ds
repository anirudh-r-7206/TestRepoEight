<panel elementName='Assets_By_Type_Header' bgColor='#FFFFFF'>
  <pr width='fill' height='auto'>
    <pc width='100%' padding='20px' hAlign='left' vAlign='middle' bgColor='#FFFFFF' cornerRadius='12px' borderColor='#E7E7EE' borderWidth='1px'>
      <pr>
        <pc width='100%' padding='5px' hAlign='left'>
          <text margin='0px' padding='0px' color='#1C1C40' size='24px' bold='true' type='Text' value='Assets by Type'> </text>
        </pc>
      </pr>
      <pr>
        <pc width='100%' padding='5px' hAlign='left'>
          <text margin='0px' padding='0px' color='#686978' size='14px' type='Text' value='Inventory grouped by standard asset categories'> </text>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>