form Assets
{
    title
    {
        displayname = "Assets"
        on add = "Add Asset"
        on edit = "Edit Asset"
    }

    Asset_Details
    (
        type = section
        displayname = "Asset Details"
        row = 1
        column = 0
    )
    Asset_ID
    (
        type = autonumber
        displayname = "Asset ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have unique Asset_Tag
    (
        type = text
        displayname = "Asset Tag"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Asset_Type
    (
        type = picklist
        displayname = "Asset Type"
        values = {"Laptop", "Monitor", "Desktop", "Tablet", "Mobile Phone", "Dock", "Peripheral", "Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Manufacturer
    (
        type = text
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Model
    (
        type = text
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have unique Serial_Number
    (
        type = text
        displayname = "Serial Number"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )

    Custody_Status
    (
        type = section
        displayname = "Custody Status"
        visibility = true
        row = 2
        column = 1
    )
    must have Condition
    (
        type = picklist
        values = {"New", "Good", "Fair", "Damaged", "Unusable"}
        initial value = "Good"
        row = 2
        column = 1
        width = medium
    )
    must have Asset_Status
    (
        type = picklist
        displayname = "Asset Status"
        values = {"Available", "Assigned", "In Maintenance", "Retired", "Lost"}
        initial value = "Available"
        row = 2
        column = 2
        width = medium
    )
    Current_Holder
    (
        type = users
        displayname = "Current Holder"
        row = 2
        column = 1
        width = medium
    )
    Current_Assignment_ID
    (
        type = number
        displayname = "Current Assignment ID"
        row = 2
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
