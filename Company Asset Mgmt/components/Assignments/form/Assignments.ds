form Assignments
{
    title
    {
        displayname = "Asset Assignments"
        on add = "Add Asset Assignment"
        on edit = "Edit Asset Assignment"
    }

    Assignment_Details
    (
        type = section
        displayname = "Assignment Details"
        row = 1
        column = 0
    )
    Assignment_ID
    (
        type = autonumber
        displayname = "Assignment ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Asset
    (
        type = picklist
        values = Assets.ID
        displayformat = [Asset_Tag]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Assigned_To
    (
        type = users
        displayname = "Assigned To"
        row = 1
        column = 1
        width = medium
    )
    must have Assigned_Date
    (
        type = date
        displayname = "Assigned Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Condition_On_Issue
    (
        type = picklist
        displayname = "Condition On Issue"
        values = {"New", "Good", "Fair", "Damaged", "Unusable"}
        row = 1
        column = 1
        width = medium
    )
    must have Assignment_Status
    (
        type = picklist
        displayname = "Assignment Status"
        values = {"Active", "Returned"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Assignment_Notes
    (
        type = textarea
        displayname = "Assignment Notes"
        row = 1
        column = 1
        width = medium
    )

    Return_Details
    (
        type = section
        displayname = "Return Details"
        visibility = true
        row = 2
        column = 1
    )
    Return_Date
    (
        type = date
        displayname = "Return Date"
        row = 2
        column = 1
        width = medium
    )
    Condition_On_Return
    (
        type = picklist
        displayname = "Condition On Return"
        values = {"New", "Good", "Fair", "Damaged", "Unusable"}
        row = 2
        column = 1
        width = medium
    )
    Return_Notes
    (
        type = textarea
        displayname = "Return Notes"
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
