form Trainers
{
    Trainer_Details
    (
        type = section
        displayname = "Trainer Details"
        row = 1
        column = 0
    )
    must have Trainer_Name
    (
        type = text
        displayname = "Trainer Name"
        row = 1
        column = 1
        width = medium
        maxchar = 100
    )
    must have Age
    (
        type = number
        displayname = "Age"
        row = 1
        column = 1
        width = medium
        maxchar = 3
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
