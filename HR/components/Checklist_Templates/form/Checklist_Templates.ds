form Checklist_Templates
{
    displayname = "Checklist Templates"

    Template_Details
    (
        type = section
        displayname = "Template Details"
        row = 1
        column = 0
    )
    must have Task_Name
    (
        type = text
        displayname = "Task Name"
        row = 1
        column = 1
    )
    must have Category
    (
        type = picklist
        values = {"HR", "IT", "Manager"}
        row = 1
        column = 1
    )
    must have Description
    (
        type = textarea
        row = 1
        column = 1
    )
    must have Offset_Days
    (
        type = number
        displayname = "Offset Days"
        initial value = 0
        row = 1
        column = 1
    )
    must have Priority
    (
        type = picklist
        values = {"Low", "Normal", "High", "Critical"}
        initial value = "Normal"
        row = 1
        column = 1
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
