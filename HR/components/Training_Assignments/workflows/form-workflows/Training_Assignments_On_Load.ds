Training_Assignments_On_Load as "Training Assignments On Load"
{
    type = form
    form = Training_Assignments
    record event = on add or edit

    on load
    {
        actions ( Status == "Completed" || Status == "Waived" )
        {
            show Completed_Date, Facilitated_By;
        }
        actions ( Status != "Completed" && Status != "Waived" )
        {
            hide Completed_Date, Facilitated_By;
        }
    }
}
