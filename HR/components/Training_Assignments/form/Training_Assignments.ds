form Training_Assignments
{
    displayname = "Training Assignments"

    Assignment_Details
    (
        type = section
        displayname = "Assignment Details"
        row = 1
        column = 0
    )
    must have New_Hire
    (
        type = picklist
        displayname = "New Hire"
        values = New_Hires.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Training_Item
    (
        type = picklist
        displayname = "Training Item"
        values = Training_Content.ID
        displayformat = [Training_Title]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Assigned","In Progress","Completed","Waived"}
        initial value = "Assigned"
        row = 1
        column = 2
        width = medium
    )
    Completed_Date
    (
        type = date
        displayname = "Completed Date"
        row = 1
        column = 1
        width = medium
    )
    Facilitated_By
    (
        type = email
        displayname = "Facilitated By"
        row = 1
        column = 2
        width = medium
    )
    Completion_Notes
    (
        type = textarea
        displayname = "Completion Notes"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
