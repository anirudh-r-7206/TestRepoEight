form Training_Content
{
    Content_Details
    (
        type = section
        displayname = "Content Details"
        row = 1
        column = 0
    )
    must have unique Training_Title
    (
        type = text
        displayname = "Training Title"
        row = 1
        column = 1
        width = medium
    )
    must have Description
    (
        type = textarea
        row = 1
        column = 2
        width = medium
    )
    must have Training_Video
    (
        type = video
        displayname = "Training Video"
        duration = 300
        row = 1
        column = 1
        width = medium
    )
    Duration_Minutes
    (
        type = number
        displayname = "Duration Minutes"
        row = 1
        column = 2
        width = medium
    )
    must have Due_Offset_Days
    (
        type = number
        displayname = "Due Offset Days"
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Mandatory
    (
        type = checkbox
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
