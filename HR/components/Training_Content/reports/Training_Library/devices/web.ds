report Training_Library
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Training_Title
                    Description
                    Duration_Minutes
                    Due_Offset_Days
                    Mandatory
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Training_Title
                    Description
                    Duration_Minutes
                    Due_Offset_Days
                    Mandatory
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
