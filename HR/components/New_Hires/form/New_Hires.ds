form New_Hires
{
    title
    {
        displayname = "New Hires"
        on add = "Add New Hire"
        on edit = "Edit New Hire"
    }

    Onboarding_Details
    (
        type = section
        displayname = "Onboarding Details"
        row = 1
        column = 0
    )
    Employee_ID
    (
        type = autonumber
        displayname = "Employee ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Full_Name
    (
        type = text
        displayname = "Full Name"
        row = 1
        column = 1
        width = medium
    )
    must have unique Personal_Email
    (
        type = email
        displayname = "Personal Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Job_Title
    (
        type = text
        displayname = "Job Title"
        row = 1
        column = 1
        width = medium
    )
    must have Department
    (
        type = picklist
        values = {"Human Resources", "Information Technology", "Finance", "Sales", "Marketing", "Operations", "Legal", "Other"}
        row = 1
        column = 1
        width = medium
    )
    must have Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 1
        column = 1
        width = medium
    )
    must have Manager_Name
    (
        type = text
        displayname = "Manager Name"
        row = 1
        column = 1
        width = medium
    )
    must have Manager_Email
    (
        type = email
        displayname = "Manager Email"
        row = 1
        column = 1
        width = medium
    )
    must have HR_Owner_Email
    (
        type = email
        displayname = "HR Owner Email"
        row = 1
        column = 1
        width = medium
    )
    must have IT_Owner_Email
    (
        type = email
        displayname = "IT Owner Email"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        values = {"Pre-boarding", "In Progress", "Awaiting Sign-off", "Complete", "On Hold"}
        initial value = "Pre-boarding"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
