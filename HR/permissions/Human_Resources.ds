"Human_Resources"
{
    name = "Human_Resources"
    type = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Full administration of onboarding, training, tasks, templates, identity documents, and handbook acknowledgements."
    ModulePermissions
    {
        New_Hires
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_New_Hires={"View","Edit","Delete"}
                Active_Onboarding={"View","Edit","Delete"}
            }
        }
        Checklist_Templates
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Checklist_Templates={"View","Edit","Delete"}
            }
        }
        Training_Content
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Training_Library={"View","Edit","Delete"}
            }
        }
        Onboarding_Tasks
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Onboarding_Tasks={"View","Edit","Delete"}
                Onboarding_Task_Board={"View","Edit","Delete"}
                Onboarding_Due_Calendar={"View","Edit","Delete"}
            }
        }
        ID_Documents
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                ID_Document_Register={"View","Edit","Delete"}
            }
        }
        Training_Assignments
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Training_Assignment_Register={"View","Edit","Delete"}
                Outstanding_Training={"View","Edit","Delete"}
            }
        }
        Handbook_Acknowledgements
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Handbook_Signoff_Register={"View","Edit","Delete"}
            }
        }
        Onboarding_Dashboard
        {
            enabled = tab
        }
    }
}
