application "HR"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Checklist_Templates
		{
		    displayname = "Checklist Templates"
		
		    Template_Details
		    (
		        type = section
		        displayname = "Template Details"
		        row = 1
		        column = 0
		    )
		    must have Task_Name
		    (
		        type = text
		        displayname = "Task Name"
		        row = 1
		        column = 1
		    )
		    must have Category
		    (
		        type = picklist
		        values = {"HR", "IT", "Manager"}
		        row = 1
		        column = 1
		    )
		    must have Description
		    (
		        type = textarea
		        row = 1
		        column = 1
		    )
		    must have Offset_Days
		    (
		        type = number
		        displayname = "Offset Days"
		        initial value = 0
		        row = 1
		        column = 1
		    )
		    must have Priority
		    (
		        type = picklist
		        values = {"Low", "Normal", "High", "Critical"}
		        initial value = "Normal"
		        row = 1
		        column = 1
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Handbook_Acknowledgements
		{
		    Acknowledgement_Details
		    (
		        type = section
		        displayname = "Acknowledgement Details"
		        row = 1
		        column = 0
		    )
		    must have New_Hire
		    (
		        type = picklist
		        displayname = "New Hire"
		        values = New_Hires.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Handbook_Version
		    (
		        type = text
		        displayname = "Handbook Version"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Handbook_File
		    (
		        type = upload file
		        displayname = "Handbook File"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Signature
		    (
		        type = signature
		        displayname = "Employee Signature"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Signed_Date
		    (
		        type = date
		        displayname = "Signed Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Witnessed_By
		    (
		        type = email
		        displayname = "Witnessed By"
		        initial value = "${zoho.loginuserid}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form ID_Documents
		{
		    displayname = "ID Documents"
		
		    Document_Details
		    (
		        type = section
		        displayname = "Document Details"
		        row = 1
		        column = 0
		    )
		    must have New_Hire
		    (
		        type = picklist
		        displayname = "New Hire"
		        values = New_Hires.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Document_Type
		    (
		        type = picklist
		        displayname = "Document Type"
		        values = {"Passport", "National ID", "Driver License", "Tax Document", "Work Authorization", "Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Document_File
		    (
		        type = upload file
		        displayname = "Document File"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        personal data = true
		        isencrypted = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Expiry_Date
		    (
		        type = date
		        displayname = "Expiry Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Verification_Status
		    (
		        type = picklist
		        displayname = "Verification Status"
		        values = {"Pending", "Verified", "Rejected"}
		        initial value = "Pending"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Verified_By
		    (
		        type = email
		        displayname = "Verified By"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Verified_Date
		    (
		        type = date
		        displayname = "Verified Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Verification_Notes
		    (
		        type = textarea
		        displayname = "Verification Notes"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form New_Hires
		{
		    title
		    {
		        displayname = "New Hires"
		        on add = "Add New Hire"
		        on edit = "Edit New Hire"
		    }
		
		    Onboarding_Details
		    (
		        type = section
		        displayname = "Onboarding Details"
		        row = 1
		        column = 0
		    )
		    Employee_ID
		    (
		        type = autonumber
		        displayname = "Employee ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Full_Name
		    (
		        type = text
		        displayname = "Full Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Personal_Email
		    (
		        type = email
		        displayname = "Personal Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Job_Title
		    (
		        type = text
		        displayname = "Job Title"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Department
		    (
		        type = picklist
		        values = {"Human Resources", "Information Technology", "Finance", "Sales", "Marketing", "Operations", "Legal", "Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Start_Date
		    (
		        type = date
		        displayname = "Start Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Manager_Name
		    (
		        type = text
		        displayname = "Manager Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Manager_Email
		    (
		        type = email
		        displayname = "Manager Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have HR_Owner_Email
		    (
		        type = email
		        displayname = "HR Owner Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have IT_Owner_Email
		    (
		        type = email
		        displayname = "IT Owner Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"Pre-boarding", "In Progress", "Awaiting Sign-off", "Complete", "On Hold"}
		        initial value = "Pre-boarding"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Onboarding_Tasks
		{
		    displayname = "Onboarding Tasks"
		
		    Task_Details
		    (
		        type = section
		        displayname = "Task Details"
		        row = 1
		        column = 0
		    )
		    must have New_Hire
		    (
		        type = picklist
		        displayname = "New Hire"
		        values = New_Hires.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Task_Name
		    (
		        type = text
		        displayname = "Task Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = {"HR","IT","Manager"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Assignee_Email
		    (
		        type = email
		        displayname = "Assignee Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Priority
		    (
		        type = picklist
		        displayname = "Priority"
		        values = {"Low","Normal","High","Critical"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Not Started","In Progress","Blocked","Complete"}
		        initial value = "Not Started"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Completion_Date
		    (
		        type = date
		        displayname = "Completion Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Completion_Notes
		    (
		        type = textarea
		        displayname = "Completion Notes"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Last_Reminder_Date
		    (
		        type = date
		        displayname = "Last Reminder Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reminder_Level
		    (
		        type = number
		        displayname = "Reminder Level"
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Training_Assignments
		{
		    displayname = "Training Assignments"
		
		    Assignment_Details
		    (
		        type = section
		        displayname = "Assignment Details"
		        row = 1
		        column = 0
		    )
		    must have New_Hire
		    (
		        type = picklist
		        displayname = "New Hire"
		        values = New_Hires.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Training_Item
		    (
		        type = picklist
		        displayname = "Training Item"
		        values = Training_Content.ID
		        displayformat = [Training_Title]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Assigned","In Progress","Completed","Waived"}
		        initial value = "Assigned"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Completed_Date
		    (
		        type = date
		        displayname = "Completed Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Facilitated_By
		    (
		        type = email
		        displayname = "Facilitated By"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Completion_Notes
		    (
		        type = textarea
		        displayname = "Completion Notes"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Training_Content
		{
		    Content_Details
		    (
		        type = section
		        displayname = "Content Details"
		        row = 1
		        column = 0
		    )
		    must have unique Training_Title
		    (
		        type = text
		        displayname = "Training Title"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Description
		    (
		        type = textarea
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Training_Video
		    (
		        type = video
		        displayname = "Training Video"
		        duration = 300
		        row = 1
		        column = 1
		        width = medium
		    )
		    Duration_Minutes
		    (
		        type = number
		        displayname = "Duration Minutes"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Due_Offset_Days
		    (
		        type = number
		        displayname = "Due Offset Days"
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Mandatory
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Checklist_Templates
		{
		    displayName = "All Checklist Templates"
		    show all rows from Checklist_Templates
		    (
		        Task_Name
		        Category
		        Offset_Days
		        Priority
		        Active
		    )
		    filters
		    (
		        Category
		        Priority
		        Active
		    )
		    group by
		    (
		        Category ascending
		    )
		    sort by
		    (
		        Task_Name ascending
		    )
		}

		default list Handbook_Signoff_Register
		{
		    displayName = "Handbook Signoff Register"
		    show all rows from Handbook_Acknowledgements
		    (
		        New_Hire
		        Handbook_Version
		        Signed_Date
		        Witnessed_By
		    )
		    filters
		    (
		        Handbook_Version
		        Signed_Date
		    )
		    sort by
		    (
		        Signed_Date descending
		    )
		}

		default list ID_Document_Register
		{
		    displayName = "ID Document Register"
		    show all rows from ID_Documents
		    (
		        New_Hire
		        Document_Type
		        Expiry_Date
		        Verification_Status
		        Verified_By
		        Verified_Date
		    )
		    filters
		    (
		        Document_Type
		        Verification_Status
		    )
		    sort by
		    (
		        New_Hire ascending
		    )
		}

		list Active_Onboarding
		{
		    displayName = "Active Onboarding"
		    show all rows from New_Hires [Status != "Complete"]
		    (
		        Employee_ID
		        Full_Name
		        Personal_Email
		        Job_Title
		        Department
		        Start_Date
		        Manager_Name
		        Status
		    )
		    filters
		    (
		        Department
		        Start_Date
		        Status
		    )
		    sort by
		    (
		        Start_Date descending
		    )
		}

		default list All_New_Hires
		{
		    displayName = "All New Hires"
		    show all rows from New_Hires
		    (
		        Employee_ID
		        Full_Name
		        Personal_Email
		        Job_Title
		        Department
		        Start_Date
		        Manager_Name
		        Status
		    )
		    group by
		    (
		        Status ascending
		    )
		    sort by
		    (
		        Start_Date descending
		    )
		}

		default list All_Onboarding_Tasks
		{
		    displayName = "All Onboarding Tasks"
		    show all rows from Onboarding_Tasks
		    (
		        New_Hire
		        Task_Name
		        Category
		        Assignee_Email
		        Due_Date
		        Priority
		        Status
		        Completion_Date
		    )
		    filters
		    (
		        Category
		        Assignee_Email
		        Priority
		        Status
		    )
		    group by
		    (
		        Category ascending
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		calendar Onboarding_Due_Calendar
		{
		    displayName = "Onboarding Due Calendar"
		    show all rows from Onboarding_Tasks
		    (
		        Task_Name
		        Due_Date
		        New_Hire
		        Category
		        Assignee_Email
		        Priority
		        Status
		    )
		    filters
		    (
		        Category
		        Assignee_Email
		        Status
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Task_Name
		        start date = Due_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		kanban Onboarding_Task_Board
		{
		    displayName = "Onboarding Task Board"
		    show all rows from Onboarding_Tasks
		    (
		        New_Hire
		        Task_Name
		        Category
		        Assignee_Email
		        Due_Date
		        Priority
		        Status
		    )
		    filters
		    (
		        Category
		        Assignee_Email
		        Priority
		    )
		    options
		    (
		        display field = Status
		        sort order = custom
		        record count = enable
		    )
		}

		list Outstanding_Training
		{
		    displayName = "Outstanding Training"
		    show all rows from Training_Assignments [Status != "Completed" && Status != "Waived"]
		    (
		        New_Hire
		        Training_Item
		        Due_Date
		        Status
		    )
		    filters
		    (
		        New_Hire
		        Due_Date
		        Status
		    )
		}

		default list Training_Assignment_Register
		{
		    displayName = "Training Assignment Register"
		    show all rows from Training_Assignments
		    (
		        New_Hire
		        Training_Item
		        Due_Date
		        Status
		        Completed_Date
		        Facilitated_By
		    )
		    filters
		    (
		        New_Hire
		        Status
		        Due_Date
		    )
		    group by
		    (
		        Status ascending
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		default list Training_Library
		{
		    displayName = "Training Library"
		    show all rows from Training_Content
		    (
		        Training_Title
		        Description
		        Duration_Minutes
		        Due_Offset_Days
		        Mandatory
		        Active
		    )
		    filters
		    (
		        Mandatory
		        Active
		    )
		    sort by
		    (
		        Training_Title ascending
		    )
		}
	}

	pages
	{
		page Onboarding_Dashboard
		{
					displayname = "Onboarding Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Onboarding_Dashboard_Snippet' elementName='Onboarding_Dashboard_Snippet'>\n\t<![CDATA[htmlpage Onboarding_Dashboard_Snippet()\ncontent\n&lt;%{%&gt;\n\t<file name:Onboarding_Dashboard.dshtml/>\n&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Handbook_Acknowledgements_On_Success as "Handbook Acknowledgements On Success"
			{
			    type = form
			    form = Handbook_Acknowledgements
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.New_Hire != null)
			                {
			                    hire_id = input.New_Hire;
			                    incomplete_task_count = Onboarding_Tasks[New_Hire == hire_id && Status != "Complete"].count();
			                    incomplete_mandatory_training_count = Training_Assignments[New_Hire == hire_id && Training_Item.Mandatory == true && Status != "Completed" && Status != "Waived"].count();
			                    hire_records = New_Hires[ID == hire_id] range from 0 to 0;
			                    if(hire_records.count() > 0)
			                    {
			                        if(incomplete_task_count == 0 && incomplete_mandatory_training_count == 0)
			                        {
			                            hire_records.Status = "Complete";
			                        }
			                        else
			                        {
			                            hire_records.Status = "In Progress";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Verification_Status_On_User_Input as "Verification Status On User Input"
			{
			    type = form
			    form = ID_Documents
			    record event = on add or edit
			
			    on user input of Verification_Status
			    {
			        actions ( Verification_Status == "Verified" )
			        {
			            show Verified_By, Verified_Date;
			            enable Verified_By, Verified_Date;
			        }
			        actions ( Verification_Status != "Verified" )
			        {
			            hide Verified_By, Verified_Date;
			        }
			    }
			}

			ID_Documents_On_Load as "ID Documents On Load"
			{
			    type = form
			    form = ID_Documents
			    record event = on add or edit
			
			    on load
			    {
			        actions ( Verification_Status == "Verified" )
			        {
			            show Verified_By, Verified_Date;
			            enable Verified_By, Verified_Date;
			        }
			        actions ( Verification_Status != "Verified" )
			        {
			            hide Verified_By, Verified_Date;
			        }
			    }
			}

			ID_Documents_On_Success as "ID Documents On Success"
			{
			    type = form
			    form = ID_Documents
			    record event = on add or edit
			
			    on success
			    {
			        actions ( Verification_Status == "Verified" )
			        {
			            custom deluge script
			            (
			                input.Verified_By = zoho.loginuserid;
			                input.Verified_Date = zoho.currentdate;
			            )
			        }
			    }
			}

			New_Hires_On_Success as "New Hires On Success"
			{
			    type = form
			    form = New_Hires
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                active_templates = Checklist_Templates[Active == true];
			                if(active_templates.count() > 0)
			                {
			                    for each template_record in active_templates
			                    {
			                        assignee_email = input.Manager_Email;
			                        if(template_record.Category == "HR")
			                        {
			                            assignee_email = input.HR_Owner_Email;
			                        }
			                        else if(template_record.Category == "IT")
			                        {
			                            assignee_email = input.IT_Owner_Email;
			                        }
			                        task_id = insert into Onboarding_Tasks
			                        [
			                            New_Hire = input.ID
			                            Task_Name = template_record.Task_Name
			                            Category = template_record.Category
			                            Description = template_record.Description
			                            Assignee_Email = assignee_email
			                            Due_Date = input.Start_Date.addDay(template_record.Offset_Days)
			                            Priority = template_record.Priority
			                            Status = "Not Started"
			                        ];
			                    }
			                }
			
			                active_training = Training_Content[Active == true];
			                if(active_training.count() > 0)
			                {
			                    for each content_record in active_training
			                    {
			                        assignment_id = insert into Training_Assignments
			                        [
			                            New_Hire = input.ID
			                            Training_Item = content_record.ID
			                            Due_Date = input.Start_Date.addDay(content_record.Due_Offset_Days)
			                            Status = "Assigned"
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Task_Status_On_User_Input as "Task Status On User Input"
			{
			    type = form
			    form = Onboarding_Tasks
			    record event = on add or edit
			
			    on user input of Status
			    {
			        actions ( Status == "Complete" )
			        {
			            show Completion_Date, Completion_Notes;
			        }
			        actions ( Status != "Complete" )
			        {
			            hide Completion_Date, Completion_Notes;
			        }
			    }
			}

			Onboarding_Tasks_On_Load as "Onboarding Tasks On Load"
			{
			    type = form
			    form = Onboarding_Tasks
			    record event = on add or edit
			
			    on load
			    {
			        actions ( Status == "Complete" )
			        {
			            show Completion_Date, Completion_Notes;
			        }
			        actions ( Status != "Complete" )
			        {
			            hide Completion_Date, Completion_Notes;
			        }
			    }
			}

			Onboarding_Tasks_On_Success as "Onboarding Tasks On Success"
			{
			    type = form
			    form = Onboarding_Tasks
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Complete")
			                {
			                    if(input.Completion_Date == null)
			                    {
			                        input.Completion_Date = zoho.currentdate;
			                    }
			                }
			                else
			                {
			                    input.Completion_Date = null;
			                }
			
			                if(input.New_Hire != null)
			                {
			                    hire_id = input.New_Hire;
			                    incomplete_task_count = Onboarding_Tasks[New_Hire == hire_id && Status != "Complete"].count();
			                    incomplete_mandatory_training_count = Training_Assignments[New_Hire == hire_id && Training_Item.Mandatory == true && Status != "Completed" && Status != "Waived"].count();
			                    acknowledgement_count = Handbook_Acknowledgements[New_Hire == hire_id].count();
			                    hire_records = New_Hires[ID == hire_id] range from 0 to 0;
			                    if(hire_records.count() > 0)
			                    {
			                        if(incomplete_task_count == 0 && incomplete_mandatory_training_count == 0)
			                        {
			                            if(acknowledgement_count > 0)
			                            {
			                                hire_records.Status = "Complete";
			                            }
			                            else
			                            {
			                                hire_records.Status = "Awaiting Sign-off";
			                            }
			                        }
			                        else
			                        {
			                            hire_records.Status = "In Progress";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Training_Status_On_User_Input as "Training Status On User Input"
			{
			    type = form
			    form = Training_Assignments
			    record event = on add or edit
			
			    on user input of Status
			    {
			        actions ( Status == "Completed" || Status == "Waived" )
			        {
			            show Completed_Date, Facilitated_By;
			        }
			        actions ( Status != "Completed" && Status != "Waived" )
			        {
			            hide Completed_Date, Facilitated_By;
			        }
			    }
			}

			Training_Assignments_On_Load as "Training Assignments On Load"
			{
			    type = form
			    form = Training_Assignments
			    record event = on add or edit
			
			    on load
			    {
			        actions ( Status == "Completed" || Status == "Waived" )
			        {
			            show Completed_Date, Facilitated_By;
			        }
			        actions ( Status != "Completed" && Status != "Waived" )
			        {
			            hide Completed_Date, Facilitated_By;
			        }
			    }
			}

			Training_Assignments_On_Success as "Training Assignments On Success"
			{
			    type = form
			    form = Training_Assignments
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Completed" || input.Status == "Waived")
			                {
			                    input.Completed_Date = zoho.currentdate;
			                    input.Facilitated_By = zoho.loginuserid;
			                }
			
			                if(input.New_Hire != null)
			                {
			                    hire_id = input.New_Hire;
			                    incomplete_task_count = Onboarding_Tasks[New_Hire == hire_id && Status != "Complete"].count();
			                    incomplete_mandatory_training_count = Training_Assignments[New_Hire == hire_id && Training_Item.Mandatory == true && Status != "Completed" && Status != "Waived"].count();
			                    acknowledgement_count = Handbook_Acknowledgements[New_Hire == hire_id].count();
			                    if(incomplete_task_count == 0 && incomplete_mandatory_training_count == 0 && acknowledgement_count > 0)
			                    {
			                        hire_records = New_Hires[ID == hire_id] range from 0 to 0;
			                        if(hire_records.count() > 0)
			                        {
			                            hire_records.Status = "Complete";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Overdue_Task_Reminders as "Overdue Task Reminders"
			{
			    type = schedule
			    form = Onboarding_Tasks[Due_Date < zoho.currentdate && Status != "Complete"]
			    start = Due_Date at "09:00:00"
			    frequency = daily
			    time zone = "UTC"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                if(input.Due_Date != null && input.Assignee_Email != null && input.Status != "Complete")
			                {
			                    days_overdue = input.Due_Date.daysBetween(zoho.currentdate);
			                    reminder_due = false;
			                    target_level = 0;
			                    if(days_overdue == 1 && input.Reminder_Level < 1)
			                    {
			                        reminder_due = true;
			                        target_level = 1;
			                    }
			                    else if(days_overdue == 3 && input.Reminder_Level < 3)
			                    {
			                        reminder_due = true;
			                        target_level = 3;
			                    }
			                    else if(days_overdue == 7 && input.Reminder_Level < 7)
			                    {
			                        reminder_due = true;
			                        target_level = 7;
			                    }
			
			                    already_sent_today = input.Last_Reminder_Date != null && input.Last_Reminder_Date == zoho.currentdate;
			                    if(reminder_due && !already_sent_today)
			                    {
			                        hire_name = "New Hire";
			                        hr_owner_email = "";
			                        if(input.New_Hire != null)
			                        {
			                            hire_records = New_Hires[ID == input.New_Hire] range from 0 to 0;
			                            if(hire_records.count() > 0)
			                            {
			                                hire_name = hire_records.Full_Name;
			                                hr_owner_email = hire_records.HR_Owner_Email;
			                            }
			                        }
			                        report_link = "#Report:All_Onboarding_Tasks";
			                        mail_subject = "Onboarding task overdue: " + input.Task_Name;
			                        mail_message = "<p>An onboarding task is overdue.</p><p><strong>New hire:</strong> " + hire_name + "<br><strong>Task:</strong> " + input.Task_Name + "<br><strong>Due date:</strong> " + input.Due_Date + "<br><strong>Days overdue:</strong> " + days_overdue + "</p><p><a href='" + report_link + "'>Open onboarding tasks</a></p>";
			
			                        if(days_overdue == 7 && hr_owner_email != null && hr_owner_email != "")
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : input.Assignee_Email
			                                cc : hr_owner_email
			                                subject : mail_subject
			                                message : mail_message
			                            )
			                        }
			                        else
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : input.Assignee_Email
			                                subject : mail_subject
			                                message : mail_message
			                            )
			                        }
			                        input.Last_Reminder_Date = zoho.currentdate;
			                        input.Reminder_Level = target_level;
			                    }
			                }
			            )
			        }
			    }
			}
		}
	}

