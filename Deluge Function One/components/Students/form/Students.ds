form Students
{
    Student_Details
    (
        type = section
        displayname = "Student Details"
        row = 1
        column = 0
    )
    must have Student_Name
    (
        type = text
        displayname = "Student Name"
        row = 1
        column = 1
        width = medium
    )
    must have Age
    (
        type = number
        displayname = "Age"
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
