form Students
{
    Personal_Information
    (
        type = section
        displayname = "Personal Information"
        row = 1
        column = 0
    )
    must have Student_Name
    (
        type = text
        displayname = "Student Name"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Age
    (
        type = number
        displayname = "Age"
        row = 1
        column = 1
        width = medium
    )
    must have Gender
    (
        type = radiobuttons
        displayname = "Gender"
        values = {"Male", "Female", "Other"}
        layout = 3
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
