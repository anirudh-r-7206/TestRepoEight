<%
	totalStudents = Students[ID != 0].count();
	maleStudents = Students[Gender == "Male"].count();
	femaleStudents = Students[Gender == "Female"].count();
	otherStudents = Students[Gender == "Other"].count();
	preferNotToSayStudents = Students[Gender == "Prefer not to say"].count();
	%>
<style>
.zcs-page {
  font-family: var(--zcs-font, Arial, sans-serif);
  background: var(--zcs-bg, #f5f6f8);
  min-height: 100vh;
  padding: 32px;
  box-sizing: border-box;
}
.zcs-page-header { margin-bottom: 24px; }
.zcs-page-header__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  color: var(--zcs_brand_color, #3768d9);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.zcs-page-header__title {
  font-size: 26px;
  font-weight: 700;
  color: var(--zcs-text-1, var(--zcs_primary_text_color, #202124));
  margin: 0 0 7px;
}
.zcs-page-header__sub {
  max-width: 680px;
  font-size: 14px;
  line-height: 1.55;
  color: var(--zcs-text-2, var(--zcs_secondary_text_color, #666a73));
  margin: 0;
}
.zcs-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}
.zcs-kpi-card {
  position: relative;
  overflow: hidden;
  background: var(--zcs-surface, #ffffff);
  border: 1px solid var(--zcs_tertiary_border_color, #e6e8ec);
  border-radius: var(--zcs-radius, 14px);
  box-shadow: var(--zcs-shadow, 0 5px 18px rgba(25, 32, 56, .07));
  padding: 20px 24px;
  min-height: 130px;
  box-sizing: border-box;
}
.zcs-kpi-card::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 4px;
  background: var(--metric-color, var(--zcs_brand_color, #3768d9));
}
.zcs-kpi-card__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.zcs-kpi-card__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  color: var(--metric-color, var(--zcs_brand_color, #3768d9));
  background: color-mix(in srgb, var(--metric-color, #3768d9) 11%, transparent);
  font-size: 18px;
}
.zcs-kpi-card__label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .6px;
  color: var(--zcs-text-2, var(--zcs_secondary_text_color, #666a73));
}
.zcs-kpi-card__value {
  font-size: 34px;
  font-weight: 700;
  margin: 14px 0 5px;
  line-height: 1;
  color: var(--metric-color, var(--zcs_brand_color, #3768d9));
}
.zcs-kpi-card__sub {
  font-size: 12px;
  color: var(--zcs-text-3, var(--zcs_tertiary_text_color, #8a8e98));
}
.zcs-kpi-card--total { --metric-color: var(--zcs_brand_color, #3768d9); grid-column: span 2; }
.zcs-kpi-card--male { --metric-color: #2274a5; }
.zcs-kpi-card--female { --metric-color: #b84a78; }
.zcs-kpi-card--other { --metric-color: #6d55a3; }
.zcs-kpi-card--private { --metric-color: #68717c; }
@media (max-width: 720px) {
  .zcs-page { padding: 20px; }
  .zcs-kpi-card--total { grid-column: span 1; }
}
</style>
<div class="zcs-page">
  <div class="zcs-page-header">
    <div class="zcs-page-header__eyebrow"><i class="zc-li-outline users-1-multiple-11"></i><span>Student dashboard</span></div>
    <h1 class="zcs-page-header__title">Student Overview</h1>
    <p class="zcs-page-header__sub">A current snapshot of the student population, with enrollment totals grouped by each available gender choice.</p>
  </div>
  <div class="zcs-kpi-grid">
    <div class="zcs-kpi-card zcs-kpi-card--total">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Total Students</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline users-1-multiple-11"></i></span></div>
      <div class="zcs-kpi-card__value"><%=totalStudents%></div>
      <div class="zcs-kpi-card__sub">All student records</div>
    </div>
    <div class="zcs-kpi-card zcs-kpi-card--male">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Male</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline users-1-single-body"></i></span></div>
      <div class="zcs-kpi-card__value"><%=maleStudents%></div>
      <div class="zcs-kpi-card__sub">Students selecting Male</div>
    </div>
    <div class="zcs-kpi-card zcs-kpi-card--female">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Female</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline users-1-single-body"></i></span></div>
      <div class="zcs-kpi-card__value"><%=femaleStudents%></div>
      <div class="zcs-kpi-card__sub">Students selecting Female</div>
    </div>
    <div class="zcs-kpi-card zcs-kpi-card--other">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Other</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline ui-1-circle-08"></i></span></div>
      <div class="zcs-kpi-card__value"><%=otherStudents%></div>
      <div class="zcs-kpi-card__sub">Students selecting Other</div>
    </div>
    <div class="zcs-kpi-card zcs-kpi-card--private">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Prefer Not to Say</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline ui-1-lock-circle"></i></span></div>
      <div class="zcs-kpi-card__value"><%=preferNotToSayStudents%></div>
      <div class="zcs-kpi-card__sub">Students withholding a response</div>
    </div>
  </div>
</div>