	menu
	{
	    space To_Do_Space
	    {
	        displayname = "To-Do"
	        icon = "business-agenda"
	
	        section Overview_Section
	        {
	            displayname = "Overview"
	            icon = "business-chart"
	
	            page To_Do_Overview
	            {
	                icon = "business-chart-pie-36"
	            }
	        }
	
	        section Tasks_Section
	        {
	            displayname = "Tasks"
	            icon = "business-agenda"
	
	            form Tasks
	            {
