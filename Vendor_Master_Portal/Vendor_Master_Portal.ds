				    (
				        type = decimal
				        displayname = "Days"
				        decimalplace = 2
				        row = 1
				        column = 1
				        width = medium
				    )
				    Recipient_Profile
				    (
				        type = picklist
				        displayname = "Recipient Profile"
				        values = {"Business Requestor","Procurement Officer","Compliance Analyst","Finance Manager","MDM Team","Vendor","Administrator"}
				        row = 1
				        column = 2
				        width = medium
				    )
				    Active
				    (
				        type = checkbox
				        displayname = "Active"
				        initial value = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    Message_Template
				    (
				        type = textarea
				        displayname = "Message Template"
				        height = 120px
				        row = 1
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save Rule"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update Rule"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

