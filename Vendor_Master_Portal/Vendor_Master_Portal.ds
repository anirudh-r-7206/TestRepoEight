				        displayname = "Rule Name"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Rule_Type
				    (
				        type = picklist
				        displayname = "Rule Type"
				        values = {"Approval Reminder","Approval Escalation","Document Expiry Reminder","Legacy Email Cycle Baseline","Portal Cycle Target"}
				        row = 1
				        column = 1
				        width = medium
				    )
				    Applies_To_Stage
				    (
				        type = picklist
				        displayname = "Applies To Stage"
				        values = {"Submitted/Data Check","Procurement Review","Finance Callback","Compliance Review","Finance Approval","MDM Processing","Document Expiry","Overall Request"}
				        row = 1
				        column = 2
				        width = medium
				    )
