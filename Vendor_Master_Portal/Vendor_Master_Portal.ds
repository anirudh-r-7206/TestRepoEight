				    Normalized_Registration_ID
				    (
				        type = text
				        displayname = "Normalized Registration ID"
				        private = true
				        row = 4
				        column = 2
				        width = medium
				    )
				    Normalized_Bank_Account
				    (
				        type = text
				        displayname = "Normalized Bank Account"
				        private = true
				        row = 4
				        column = 1
				        width = medium
				    )
				    Normalized_Email
				    (
				        type = text
				        displayname = "Normalized Email"
				        private = true
				        row = 4
				        column = 2
				        width = medium
				    )
				    Documents_Section
				    (
				        type = section
				        displayname = "Supporting Documents"
				        visibility = false
				        row = 5
				        column = 1
				    )
				    Request_Documents
				    (
				        type = grid
				        displayname = "Request Documents"
				        values = Request_Documents.ID
				        bidirectional = Vendor_Request
				        defaultrow = 0
				        maxrow = 25
				        viewtype = list
				        row = 5
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Save_Draft
				            (
				                type = submit
				                displayname = "Save Draft"
				                tooltip = "Save this request without submitting it for review"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update_Draft
				            (
				                type = submit
				                displayname = "Update Draft"
				                tooltip = "Save changes to this draft or returned request"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				    blueprint components
				    {
				        stages = {"Draft","Submitted/Data Check","Procurement Review","Finance Callback","Compliance Review","Finance Approval","MDM Processing","Returned","Rejected","Escalated","Completed"}
				    }
				
		}
	}

	reports
	{
		list Full_Approval_Audit
		{
		
				    displayName = "Full Approval Audit"
				    show all rows from Approval_History
				    (
				        Vendor_Request
				        Stage
				        Decision
				        Actor_Email
				        Actor_Profile
				        Decision_At
				        Comment
				        Previous_Stage
				        Next_Stage
				        Related_Compliance_Review
				        Related_Bank_Verification
				        Added_User
				        Added_Time
				        Modified_User
				        Modified_Time
				    )
				    filters
				    (
				        Vendor_Request
				        Stage
				        Decision
				        Actor_Email
				        Actor_Profile
				        Decision_At
				        Previous_Stage
				        Next_Stage
				        Added_User
				        Added_Time
				    )
				    sort by
				    (
				        Decision_At descending
				    )
				
		}

		default list Request_Approval_History
		{
		
				    displayName = "Request Approval History"
				    show all rows from Approval_History
				    (
				        Vendor_Request
				        Stage
				        Decision
				        Actor_Email
				        Actor_Profile
				        Decision_At
				        Comment
				        Previous_Stage
				        Next_Stage
				        Related_Compliance_Review
				        Related_Bank_Verification
				    )
				    filters
				    (
				        Vendor_Request
				        Stage
				        Decision
				        Actor_Email
				        Actor_Profile
				        Decision_At
				        Previous_Stage
				        Next_Stage
				    )
				    sort by
				    (
				        Decision_At descending
				    )
				
		}

		default list Complete_Audit_Log
		{
		
				    displayName = "Complete Audit Log"
				    show all rows from Audit_Log
				    (
				        Event_Time
				        Actor_Email
				        Actor_Profile
				        Event_Category
				        Action
				        Record_Form
				        Record_ID
				        Vendor_Request
				        Outcome
				        Source_IP
				        Before_Value
				        After_Value
				        Details
				        Added_User
				        Added_Time
				    )
				    filters
				    (
				        Event_Time
				        Actor_Email
				        Actor_Profile
				        Event_Category
				        Action
				        Record_Form
				        Vendor_Request
				        Outcome
				        Added_User
				        Added_Time
				    )
				    sort by
				    (
				        Event_Time descending
				    )
				
		}

		list Request_Audit_Trail
		{
		
				    displayName = "Request Audit Trail"
				    show all rows from Audit_Log
				    (
				        Vendor_Request
				        Event_Time
				        Event_Category
				        Action
				        Actor_Email
				        Actor_Profile
				        Outcome
				        Record_Form
				        Record_ID
				        Before_Value
				        After_Value
				        Details
				    )
				    filters
				    (
				        Vendor_Request
				        Event_Time
				        Event_Category
				        Action
				        Actor_Email
				        Actor_Profile
				        Outcome
				        Record_Form
				    )
				    sort by
				    (
				        Event_Time descending
				    )
				
		}

		list Bank_Verification_History
		{
		
				    displayName = "Bank Verification History"
