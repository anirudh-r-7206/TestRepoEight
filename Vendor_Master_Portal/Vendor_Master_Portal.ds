	web
	{
	forms
	{
	
		    form SLA_Configuration { label placement = left }
		    form Vendor_Master { label placement = left }
		    form Vendor_Requests { label placement = left }
		    form Request_Documents { label placement = left }
		    form Duplicate_Matches { label placement = left }
