		    form Bank_Verifications { label placement = left }
		    form Approval_History { label placement = left }
		    form Audit_Log { label placement = left }
		    form Request_Action { label placement = left }
		
	}
	reports
	{
		report Full_Approval_Audit
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Vendor_Request Stage Decision Actor_Email Decision_At ) ) ) menu ( header ( Edit ) record ( Edit ) ) action ( on click ( View Record ) on right click ( View Record ) ) ) detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Vendor_Request Stage Decision Actor_Email Actor_Profile Decision_At Comment Previous_Stage Next_Stage Related_Compliance_Review Related_Bank_Verification Added_User Added_Time Modified_User Modified_Time ) ) ) menu ( header ( Edit ) ) ) 
		}
	
