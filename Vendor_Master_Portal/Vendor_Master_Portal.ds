	pages
	{
		page Compliance_Review_Workspace(int Request_ID)
		{
					displayname = "Compliance Review Workspace"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='zcs_htmlpage_9f7c3b21_a64e_4d58_b812_6e3f0c5a947d' elementName='Compliance_Review_Workspace_Content'>\n\t\t\t\t\t<![CDATA[htmlpage zcs_htmlpage_9f7c3b21_a64e_4d58_b812_6e3f0c5a947d()\n\t\t\t\t\t\tcontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\nrequestRecord = Vendor_Requests[ID == input.Request_ID];\nrequestFound = requestRecord.count() &gt; 0;\nif(requestFound)\n{\n\t\tdocuments = Request_Documents[Vendor_Request == requestRecord.ID];\n\t\tduplicates = Duplicate_Matches[Vendor_Request == requestRecord.ID];\n\t\tcallbacks = Bank_Verifications[Vendor_Request == requestRecord.ID] sort by Call_Date_Time desc;\n\t\treviews = Compliance_Reviews[Vendor_Request == requestRecord.ID] sort by Review_Started_At desc;\n\t\tapprovalHistory = Approval_History[Vendor_Request == requestRecord.ID] sort by Decision_At desc;\n\t\tverifiedDocumentCount = 0;\n\t\trejectedDocumentCount = 0;\n\t\tpendingDocumentCount = 0;\n\t\tfor each documentSummaryRecord in documents\n\t\t{\n\t\t\t\tif(documentSummaryRecord.Verification_Status == &quot;Verified&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tverifiedDocumentCount = verifiedDocumentCount + 1;\n\t\t\t\t}\n\t\t\t\tif(documentSummaryRecord.Verification_Status == &quot;Rejected&quot;)\n\t\t\t\t{\n\t\t\t\t\t\trejectedDocumentCount = rejectedDocumentCount + 1;\n\t\t\t\t}\n\t\t\t\tif(documentSummaryRecord.Verification_Status != &quot;Verified&quot; &amp;&amp; documentSummaryRecord.Verification_Status != &quot;Rejected&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tpendingDocumentCount = pendingDocumentCount + 1;\n\t\t\t\t}\n\t\t}\n\t\tstageBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\tstageBadgeIcon = &quot;loader-dots-06&quot;;\n\t\tif(requestRecord.Current_Stage == &quot;Completed&quot;)\n\t\t{\n\t\t\t\tstageBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\tstageBadgeIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\tif(requestRecord.Current_Stage == &quot;Rejected&quot;)\n\t\t{\n\t\t\t\tstageBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\tstageBadgeIcon = &quot;ui-1-circle-remove&quot;;\n\t\t}\n\t\triskBadgeClass = &quot;zcs-badge-green&quot;;\n\t\tif(requestRecord.Risk_Level == &quot;Medium&quot;)\n\t\t{\n\t\t\t\triskBadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\tif(requestRecord.Risk_Level == &quot;High&quot;)\n\t\t{\n\t\t\t\triskBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-page-bg-color: #f3f3f4;\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #ffffff;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-justify-center { justify-content: center; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-w-full { width: 100%; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mb-16 { margin-bottom: 1rem; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-card {\n\t\tbackground-color: var(--zcs-white-color);\n\t\tborder: 1px solid #e7e7ee;\n\t\tborder-radius: 12px;\n}\n.zcs-button {\n\t\twidth: auto;\n\t\tmin-width: 5rem;\n\t\tmin-height: 36px;\n\t\ttext-decoration: none;\n}\n.zcs-primary-button {\n\t\tbackground-color: var(--zcs_brand_color);\n\t\tcolor: var(--zcs_brand_foreground_color);\n}\n.zcs-primary-outline-button {\n\t\tborder: 1px solid var(--zcs_brand_color);\n\t\tbackground-color: var(--zcs-white-color);\n\t\tcolor: var(--zcs_brand_color);\n}\n.zcs-danger-button {\n\t\tborder: 1px solid #fe455d;\n\t\tbackground-color: var(--zcs-white-color);\n\t\tcolor: #d52f48;\n}\n.zcs-badge { width: auto; border: 1px solid; }\n.zcs-badge-green { background-color: #e4fcf3; border-color: #179e6c; color: #179e6c; }\n.zcs-badge-red { background-color: #fde3e6; border-color: #fe455d; color: #d52f48; }\n.zcs-badge-yellow { background-color: #fcf4e6; border-color: #faae13; color: #986307; }\n.zcs-badge-blue { background-color: #e8efff; border-color: #2a6ffc; color: #2a6ffc; }\n.zcs-badge-grey { background-color: #eeeeee; border-color: #666666; color: #444444; }\n.zcs-labelvalue-wrapper ul { list-style: none; }\n.zcs-table-wrapper {\n\t\tborder: 1px solid var(--zcs-border-color);\n\t\tbackground-color: var(--zcs-white-color);\n\t\toverflow: auto;\n}\n.zcs-table-wrapper table { width: 100%; border-collapse: collapse; }\n.zcs-table-wrapper th {\n\t\tbackground-color: #f9fafe;\n\t\ttext-align: left;\n\t\twhite-space: nowrap;\n\t\tfont-size: 13px;\n\t\tfont-weight: 500;\n}\n.zcs-table-wrapper th,\n.zcs-table-wrapper td {\n\t\tpadding: 9px 12px;\n\t\tborder-bottom: 1px solid var(--zcs-border-color);\n\t\tfont-size: 13px;\n\t\tvertical-align: top;\n}\n.workspace {\n\t\tbackground-color: var(--zcs-page-bg-color);\n\t\tcolor: var(--zcs-primary-text-color);\n\t\tpadding: 20px;\n\t\tbox-sizing: border-box;\n}\n.workspace-grid {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);\n\t\tgap: 16px;\n}\n.section-title {\n\t\tpadding-bottom: 12px;\n\t\tborder-bottom: 1px solid var(--zcs-border-color);\n\t\tmargin-bottom: 12px;\n}\n.summary-list {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(2, minmax(0, 1fr));\n}\n.summary-list li {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: minmax(125px, 40%) 1fr;\n\t\tborder-bottom: 1px solid #f0f0f3;\n}\n.summary-list label { color: var(--zcs-secondary-text-color); }\n.summary-list span { overflow-wrap: anywhere; }\n.metric-strip {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(4, minmax(0, 1fr));\n\t\tgap: 10px;\n}\n.metric {\n\t\tbackground-color: #f9fafe;\n\t\tborder: 1px solid var(--zcs-border-color);\n\t\tpadding: 12px;\n\t\tborder-radius: 8px;\n}\n.metric strong { display: block; font-size: 20px; }\n.masked {\n\t\tfont-family: monospace;\n\t\tletter-spacing: 1px;\n}\n.empty-state { color: var(--zcs-secondary-text-color); margin: 8px 0; }\n.review-block,\n.callback-block {\n\t\tborder: 1px solid var(--zcs-border-color);\n\t\tborder-radius: 8px;\n\t\tpadding: 12px;\n\t\tmargin-top: 10px;\n}\n.check-row { display: flex; align-items: center; gap: 8px; margin-top: 7px; }\n.check-yes { color: #179e6c; }\n.check-no { color: #fe455d; }\n.zcs-timeline-wrapper ul { list-style: none; }\n.zcs-tl-li {\n\t\tposition: relative;\n\t\tpadding-left: 28px;\n\t\tpadding-bottom: 18px;\n}\n.zcs-tl-li:before {\n\t\tcontent: &apos;&apos;;\n\t\tposition: absolute;\n\t\tleft: 6px;\n\t\ttop: 10px;\n\t\tbottom: -5px;\n\t\twidth: 1px;\n\t\tbackground-color: #e1e1e1;\n}\n.zcs-tl-li:last-child:before { display: none; }\n.zcs-tl-dot {\n\t\tposition: absolute;\n\t\tleft: 0;\n\t\ttop: 5px;\n\t\twidth: 13px;\n\t\theight: 13px;\n\t\tborder-radius: 50%;\n\t\tbackground-color: var(--zcs_brand_color);\n\t\tborder: 2px solid var(--zcs-white-color);\n\t\tbox-shadow: 0 0 0 1px var(--zcs_brand_color);\n}\n.access-card {\n\t\tmax-width: 680px;\n\t\tmargin: 60px auto;\n\t\ttext-align: center;\n\t\tpadding: 32px;\n}\n@media (max-width: 900px) {\n\t\t.workspace-grid { grid-template-columns: 1fr; }\n\t\t.metric-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 576px) {\n\t\t.workspace { padding: 10px; }\n\t\t.header-row { align-items: flex-start; flex-direction: column; }\n\t\t.summary-list { grid-template-columns: 1fr; }\n\t\t.summary-list li { grid-template-columns: 1fr; gap: 3px; }\n\t\t.metric-strip { grid-template-columns: 1fr; }\n\t\t.action-row { width: 100%; }\n\t\t.action-row .zcs-button { flex: 1; }\n}\n&lt;/style&gt;\n&lt;% if(requestFound == false) { %&gt;\n&lt;div class=&apos;workspace&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card access-card&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-circle-remove zcs-font-24&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h2&gt;Request not found&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;zcs-color-secondary&apos;&gt;No vendor request matches ID &lt;%=input.Request_ID%&gt;.&lt;/p&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;% } %&gt;\n&lt;% if(requestFound) { %&gt;\n&lt;div class=&apos;workspace&apos;&gt;\n\t\t&lt;header class=&apos;zcs-card zcs-p-20 zcs-mb-16&apos;&gt;\n\t\t\t\t&lt;div class=&apos;header-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Compliance review workspace&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&apos;zcs-font-24 zcs-m-0&apos;&gt;&lt;%=requestRecord.Request_Number%&gt; - &lt;%=requestRecord.Legal_Name%&gt;&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-row-wrap zcs-gap-8 zcs-mt-8&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge &lt;%=stageBadgeClass%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=stageBadgeIcon%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=requestRecord.Current_Stage%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge &lt;%=riskBadgeClass%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-2-shield-check&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=requestRecord.Risk_Level%&gt; risk\n\t\t\t\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;action-row zcs-flex zcs-row-wrap zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Request_Action?Vendor_Request_ID=&lt;%=requestRecord.ID%&gt;&amp;amp;Action_Type=Approve Compliance&amp;amp;zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span&gt;Approve&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Request_Action?Vendor_Request_ID=&lt;%=requestRecord.ID%&gt;&amp;amp;Action_Type=Return&amp;amp;zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span&gt;Return&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-danger-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Request_Action?Vendor_Request_ID=&lt;%=requestRecord.ID%&gt;&amp;amp;Action_Type=Reject&amp;amp;zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span&gt;Reject&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/header&gt;\n\n\t\t&lt;div class=&apos;workspace-grid&apos;&gt;\n\t\t\t\t&lt;main class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;section-title zcs-font-18 zcs-m-0&apos;&gt;Request summary&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;ul class=&apos;summary-list zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Request type&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Request_Type%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Submission channel&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Submission_Channel%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Requested by&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Requested_By_Email%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Country&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Country%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Tax ID&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Tax_ID%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Registration ID&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Registration_ID%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Primary email&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Primary_Email%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Primary phone&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=requestRecord.Primary_Phone%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;Bank account&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;masked zcs-font-14 zcs-font-medium&apos;&gt;Masked&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14&apos;&gt;IBAN&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;masked zcs-font-14 zcs-font-medium&apos;&gt;Masked&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-14&apos;&gt;Business justification&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14&apos;&gt;&lt;%=requestRecord.Business_Justification%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;section-title zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-18 zcs-m-0&apos;&gt;Related documents&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=documents.count()%&gt; document(s)&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;metric-strip zcs-mb-16&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metric&apos;&gt;&lt;strong&gt;&lt;%=documents.count()%&gt;&lt;/strong&gt;&lt;span&gt;Total&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metric&apos;&gt;&lt;strong&gt;&lt;%=verifiedDocumentCount%&gt;&lt;/strong&gt;&lt;span&gt;Verified&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metric&apos;&gt;&lt;strong&gt;&lt;%=pendingDocumentCount%&gt;&lt;/strong&gt;&lt;span&gt;Pending&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;metric&apos;&gt;&lt;strong&gt;&lt;%=rejectedDocumentCount%&gt;&lt;/strong&gt;&lt;span&gt;Rejected&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;table&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Type&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Expiry&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Confidentiality&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Verification&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Action&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% for each documentRecord in documents { %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentBadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentIcon = &quot;ui-2-time&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\texpiryDisplay = &quot;Not set&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(documentRecord.Expiry_Date != null)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\texpiryDisplay = documentRecord.Expiry_Date;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(documentRecord.Verification_Status == &quot;Verified&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(documentRecord.Verification_Status == &quot;Rejected&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=documentRecord.Document_Type%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=expiryDisplay%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=documentRecord.Confidentiality_Level%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge &lt;%=documentBadgeClass%&gt; zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=documentIcon%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=documentRecord.Verification_Status%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-color-primary&apos; href=&apos;#Form:Request_Action?Vendor_Request_ID=&lt;%=requestRecord.ID%&gt;&amp;amp;Document_ID=&lt;%=documentRecord.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;Review&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% if(documents.count() == 0) { %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td colspan=&apos;5&apos; class=&apos;empty-state&apos;&gt;No related documents.&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;section-title zcs-font-18 zcs-m-0&apos;&gt;Duplicate findings&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;table&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Basis&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Score&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Finding&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Resolution&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Comment&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Action&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% for each duplicateRecord in duplicates { %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tduplicateBadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tduplicateComment = &quot;Not provided&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(duplicateRecord.Resolution_Comment != null &amp;&amp; duplicateRecord.Resolution_Comment != &quot;&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tduplicateComment = duplicateRecord.Resolution_Comment;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(duplicateRecord.Resolution_Status == &quot;Cleared Not Duplicate&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tduplicateBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(duplicateRecord.Resolution_Status == &quot;Confirmed Duplicate&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tduplicateBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=duplicateRecord.Match_Basis%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=duplicateRecord.Match_Score%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=duplicateRecord.Match_Summary%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;span class=&apos;zcs-badge &lt;%=duplicateBadgeClass%&gt; zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2&apos;&gt;&lt;%=duplicateRecord.Resolution_Status%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=duplicateComment%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;a class=&apos;zcs-color-primary&apos; href=&apos;#Form:Request_Action?Vendor_Request_ID=&lt;%=requestRecord.ID%&gt;&amp;amp;Action_Type=Resolve Duplicate&amp;amp;zc_LoadIn=dialog&apos;&gt;Resolve&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% if(duplicates.count() == 0) { %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td colspan=&apos;6&apos; class=&apos;empty-state&apos;&gt;No duplicate findings were recorded.&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;section-title zcs-font-18 zcs-m-0&apos;&gt;Callback evidence&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;% if(callbacks.count() == 0) { %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;empty-state&apos;&gt;No callback evidence is available.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;% for each callbackRecord in callbacks { %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;callback-block&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-row zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Result:&lt;/strong&gt; &lt;%=callbackRecord.Verification_Result%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Date:&lt;/strong&gt; &lt;%=callbackRecord.Call_Date_Time%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Called by:&lt;/strong&gt; &lt;%=callbackRecord.Called_By%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Number source:&lt;/strong&gt; &lt;%=callbackRecord.Number_Source%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Callback number:&lt;/strong&gt; &lt;span class=&apos;masked&apos;&gt;Masked&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Contact:&lt;/strong&gt; &lt;%=callbackRecord.Contact_Name%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Evidence notes:&lt;/strong&gt; &lt;%=callbackRecord.Verification_Notes%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-color-primary zcs-font-14&apos; href=&apos;#Form:Request_Action?Vendor_Request_ID=&lt;%=requestRecord.ID%&gt;&amp;amp;Bank_Verification_ID=&lt;%=callbackRecord.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;Open callback action&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t&lt;/main&gt;\n\n\t\t\t\t&lt;aside class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;section-title zcs-font-18 zcs-m-0&apos;&gt;Compliance reviews&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;% if(reviews.count() == 0) { %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;empty-state&apos;&gt;No compliance review has been started.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;% for each reviewRecord in reviews { %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\tfindingsDisplay = &quot;Not provided&quot;;\n\t\t\t\t\t\t\t\t\t\tif(reviewRecord.Findings != null &amp;&amp; reviewRecord.Findings != &quot;&quot;)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tfindingsDisplay = reviewRecord.Findings;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;review-block&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=reviewRecord.Decision%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=reviewRecord.Review_Started_At%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13&apos;&gt;Reviewer: &lt;%=reviewRecord.Reviewer_Email%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tidentityIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tidentityClass = &quot;check-no&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(reviewRecord.Identity_Verified)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tidentityIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tidentityClass = &quot;check-yes&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\ttaxIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\ttaxClass = &quot;check-no&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(reviewRecord.Tax_Documents_Verified)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\ttaxIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\ttaxClass = &quot;check-yes&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tregistrationIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tregistrationClass = &quot;check-no&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(reviewRecord.Registration_Verified)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tregistrationIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tregistrationClass = &quot;check-yes&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\twatchlistIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\twatchlistClass = &quot;check-no&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(reviewRecord.Watchlist_Manual_Check_Completed)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\twatchlistIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\twatchlistClass = &quot;check-yes&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tinsuranceIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tinsuranceClass = &quot;check-no&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(reviewRecord.Insurance_Verified)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tinsuranceIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tinsuranceClass = &quot;check-yes&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tdocumentsIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tdocumentsClass = &quot;check-no&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(reviewRecord.Documents_Complete)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentsIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdocumentsClass = &quot;check-yes&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;check-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=identityIcon%&gt; &lt;%=identityClass%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Identity verified&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;check-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=taxIcon%&gt; &lt;%=taxClass%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Tax documents verified&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;check-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=registrationIcon%&gt; &lt;%=registrationClass%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Registration verified&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;check-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=watchlistIcon%&gt; &lt;%=watchlistClass%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Manual watchlist check&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;check-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=insuranceIcon%&gt; &lt;%=insuranceClass%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Insurance verified&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;check-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=documentsIcon%&gt; &lt;%=documentsClass%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Documents complete&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14&apos;&gt;&lt;strong&gt;Findings:&lt;/strong&gt; &lt;%=findingsDisplay%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-color-primary zcs-font-14&apos; href=&apos;#Form:Request_Action?Vendor_Request_ID=&lt;%=requestRecord.ID%&gt;&amp;amp;Compliance_Review_ID=&lt;%=reviewRecord.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;Open review action&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;section-title zcs-font-18 zcs-m-0&apos;&gt;Approval history&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-timeline-wrapper&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;ul class=&apos;zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;% for each historyRecord in approvalHistory { %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\thistoryComment = &quot;&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(historyRecord.Comment != null)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\thistoryComment = historyRecord.Comment;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-tl-li&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-tl-dot&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;&lt;%=historyRecord.Decision_At%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-16 zcs-font-medium&apos;&gt;&lt;%=historyRecord.Stage%&gt; - &lt;%=historyRecord.Decision%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13&apos;&gt;&lt;%=historyRecord.Actor_Email%&gt; - &lt;%=historyRecord.Actor_Profile%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;% if(historyComment != &quot;&quot;) { %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-mt-8&apos;&gt;&lt;%=historyComment%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;% if(approvalHistory.count() == 0) { %&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;empty-state&apos;&gt;No approval history.&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n %&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Operations_Dashboard(string Date_Range, string Request_Type, string Risk, string Stage)
		{
					displayname = "Operations Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='zcs_ops_dashboard_202603_c84f19a2' elementName='Operations_Dashboard_Content'>\n\t\t\t\t\t<![CDATA[htmlpage zcs_ops_dashboard_202603_c84f19a2()\n\t\t\t\t\t\tcontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\ndateRange = input.Date_Range;\nrequestType = input.Request_Type;\nstageFilter = input.Stage;\nriskFilter = input.Risk;\n\nif(dateRange == null)\n{\n\t\tdateRange = &quot;90&quot;;\n}\nif(dateRange == &quot;&quot;)\n{\n\t\tdateRange = &quot;90&quot;;\n}\nif(requestType == null)\n{\n\t\trequestType = &quot;All&quot;;\n}\nif(requestType == &quot;&quot;)\n{\n\t\trequestType = &quot;All&quot;;\n}\nif(stageFilter == null)\n{\n\t\tstageFilter = &quot;All&quot;;\n}\nif(stageFilter == &quot;&quot;)\n{\n\t\tstageFilter = &quot;All&quot;;\n}\nif(riskFilter == null)\n{\n\t\triskFilter = &quot;All&quot;;\n}\nif(riskFilter == &quot;&quot;)\n{\n\t\triskFilter = &quot;All&quot;;\n}\n\nstartDate = zoho.currentdate.subDay(90);\nif(dateRange == &quot;30&quot;)\n{\n\t\tstartDate = zoho.currentdate.subDay(30);\n}\nif(dateRange == &quot;365&quot;)\n{\n\t\tstartDate = zoho.currentdate.subDay(365);\n}\n\nrequestTypeParam = encodeUrl(requestType);\nstageParam = encodeUrl(stageFilter);\nriskParam = encodeUrl(riskFilter);\n\nfilteredRequestCount = 0;\nopenRequestCount = 0;\nhighRiskPendingCount = 0;\ncompletedRequestCount = 0;\nsubmittedCount = 0;\nprocurementCount = 0;\ncallbackCount = 0;\ncomplianceCount = 0;\nfinanceCount = 0;\nmdmCount = 0;\n\ndateRequests = Vendor_Requests[Added_Time &gt;= startDate];\nfor each requestItem in dateRequests\n{\n\t\tincludeRequest = true;\n\t\tif(requestType != &quot;All&quot; &amp;&amp; requestItem.Request_Type != requestType)\n\t\t{\n\t\t\t\tincludeRequest = false;\n\t\t}\n\t\tif(stageFilter != &quot;All&quot; &amp;&amp; requestItem.Current_Stage != stageFilter)\n\t\t{\n\t\t\t\tincludeRequest = false;\n\t\t}\n\t\tif(riskFilter != &quot;All&quot; &amp;&amp; requestItem.Risk_Level != riskFilter)\n\t\t{\n\t\t\t\tincludeRequest = false;\n\t\t}\n\t\tif(includeRequest)\n\t\t{\n\t\t\t\tfilteredRequestCount = filteredRequestCount + 1;\n\t\t\t\tif(requestItem.Current_Stage == &quot;Submitted/Data Check&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tsubmittedCount = submittedCount + 1;\n\t\t\t\t}\n\t\t\t\tif(requestItem.Current_Stage == &quot;Procurement Review&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tprocurementCount = procurementCount + 1;\n\t\t\t\t}\n\t\t\t\tif(requestItem.Current_Stage == &quot;Finance Callback&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tcallbackCount = callbackCount + 1;\n\t\t\t\t}\n\t\t\t\tif(requestItem.Current_Stage == &quot;Compliance Review&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tcomplianceCount = complianceCount + 1;\n\t\t\t\t}\n\t\t\t\tif(requestItem.Current_Stage == &quot;Finance Approval&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tfinanceCount = financeCount + 1;\n\t\t\t\t}\n\t\t\t\tif(requestItem.Current_Stage == &quot;MDM Processing&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tmdmCount = mdmCount + 1;\n\t\t\t\t}\n\t\t\t\tif(requestItem.Current_Stage == &quot;Completed&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tcompletedRequestCount = completedRequestCount + 1;\n\t\t\t\t}\n\t\t\t\tif(requestItem.Current_Stage != &quot;Draft&quot; &amp;&amp; requestItem.Current_Stage != &quot;Completed&quot; &amp;&amp; requestItem.Current_Stage != &quot;Rejected&quot;)\n\t\t\t\t{\n\t\t\t\t\t\topenRequestCount = openRequestCount + 1;\n\t\t\t\t\t\tif(requestItem.Risk_Level == &quot;High&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\thighRiskPendingCount = highRiskPendingCount + 1;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\ndate30Class = &quot;&quot;;\ndate90Class = &quot;&quot;;\ndate365Class = &quot;&quot;;\ntypeAllClass = &quot;&quot;;\ntypeNewClass = &quot;&quot;;\ntypeGeneralClass = &quot;&quot;;\ntypeBankClass = &quot;&quot;;\nstageAllClass = &quot;&quot;;\nstageSubmittedClass = &quot;&quot;;\nstageProcurementClass = &quot;&quot;;\nstageCallbackClass = &quot;&quot;;\nstageComplianceClass = &quot;&quot;;\nstageFinanceClass = &quot;&quot;;\nstageMdmClass = &quot;&quot;;\nriskAllClass = &quot;&quot;;\nriskStandardClass = &quot;&quot;;\nriskHighClass = &quot;&quot;;\n\nif(dateRange == &quot;30&quot;)\n{\n\t\tdate30Class = &quot;ops-filter-active&quot;;\n}\nif(dateRange == &quot;90&quot;)\n{\n\t\tdate90Class = &quot;ops-filter-active&quot;;\n}\nif(dateRange == &quot;365&quot;)\n{\n\t\tdate365Class = &quot;ops-filter-active&quot;;\n}\nif(requestType == &quot;All&quot;)\n{\n\t\ttypeAllClass = &quot;ops-filter-active&quot;;\n}\nif(requestType == &quot;New Vendor&quot;)\n{\n\t\ttypeNewClass = &quot;ops-filter-active&quot;;\n}\nif(requestType == &quot;General Change&quot;)\n{\n\t\ttypeGeneralClass = &quot;ops-filter-active&quot;;\n}\nif(requestType == &quot;Bank Detail Change&quot;)\n{\n\t\ttypeBankClass = &quot;ops-filter-active&quot;;\n}\nif(stageFilter == &quot;All&quot;)\n{\n\t\tstageAllClass = &quot;ops-filter-active&quot;;\n}\nif(stageFilter == &quot;Submitted/Data Check&quot;)\n{\n\t\tstageSubmittedClass = &quot;ops-filter-active&quot;;\n}\nif(stageFilter == &quot;Procurement Review&quot;)\n{\n\t\tstageProcurementClass = &quot;ops-filter-active&quot;;\n}\nif(stageFilter == &quot;Finance Callback&quot;)\n{\n\t\tstageCallbackClass = &quot;ops-filter-active&quot;;\n}\nif(stageFilter == &quot;Compliance Review&quot;)\n{\n\t\tstageComplianceClass = &quot;ops-filter-active&quot;;\n}\nif(stageFilter == &quot;Finance Approval&quot;)\n{\n\t\tstageFinanceClass = &quot;ops-filter-active&quot;;\n}\nif(stageFilter == &quot;MDM Processing&quot;)\n{\n\t\tstageMdmClass = &quot;ops-filter-active&quot;;\n}\nif(riskFilter == &quot;All&quot;)\n{\n\t\triskAllClass = &quot;ops-filter-active&quot;;\n}\nif(riskFilter == &quot;Standard&quot;)\n{\n\t\triskStandardClass = &quot;ops-filter-active&quot;;\n}\nif(riskFilter == &quot;High&quot;)\n{\n\t\triskHighClass = &quot;ops-filter-active&quot;;\n}\n\nhighRiskCandidates = Vendor_Requests[Risk_Level == &quot;High&quot;] sort by Stage_Entered_At asc;\noldestCandidates = Vendor_Requests[Current_Stage != &quot;Draft&quot;] sort by Stage_Entered_At asc;\nrecentActivities = Approval_History[Decision_At &gt;= startDate] sort by Decision_At desc;\n%&gt;\n&lt;style&gt;\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-page-bg-color: #f3f3f4;\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #ffffff;\n}\n* {\n\t\tbox-sizing: border-box;\n}\na {\n\t\ttext-decoration: none;\n}\n.zcs-flex {\n\t\tdisplay: flex;\n}\n.zcs-inline-flex {\n\t\tdisplay: inline-flex;\n}\n.zcs-row {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n}\n.zcs-direction-column {\n\t\tflex-direction: column;\n}\n.zcs-align-items-center {\n\t\talign-items: center;\n}\n.zcs-align-items-start {\n\t\talign-items: flex-start;\n}\n.zcs-justify-center {\n\t\tjustify-content: center;\n}\n.zcs-justify-space-between {\n\t\tjustify-content: space-between;\n}\n.zcs-row-wrap {\n\t\tflex-wrap: wrap;\n}\n.zcs-gap-4 {\n\t\tgap: 4px;\n}\n.zcs-gap-8 {\n\t\tgap: 8px;\n}\n.zcs-gap-12 {\n\t\tgap: 12px;\n}\n.zcs-gap-16 {\n\t\tgap: 16px;\n}\n.zcs-p-0 {\n\t\tpadding: 0;\n}\n.zcs-p-8 {\n\t\tpadding: 8px;\n}\n.zcs-p-10 {\n\t\tpadding: 10px;\n}\n.zcs-p-16 {\n\t\tpadding: 16px;\n}\n.zcs-p-20 {\n\t\tpadding: 20px;\n}\n.zcs-p-24 {\n\t\tpadding: 24px;\n}\n.zcs-px-10 {\n\t\tpadding-left: 10px;\n\t\tpadding-right: 10px;\n}\n.zcs-px-16 {\n\t\tpadding-left: 16px;\n\t\tpadding-right: 16px;\n}\n.zcs-py-2 {\n\t\tpadding-top: 2px;\n\t\tpadding-bottom: 2px;\n}\n.zcs-py-8 {\n\t\tpadding-top: 8px;\n\t\tpadding-bottom: 8px;\n}\n.zcs-m-0 {\n\t\tmargin: 0;\n}\n.zcs-mt-8 {\n\t\tmargin-top: 8px;\n}\n.zcs-mb-0 {\n\t\tmargin-bottom: 0;\n}\n.zcs-font-12 {\n\t\tfont-size: 12px;\n}\n.zcs-font-13 {\n\t\tfont-size: 13px;\n}\n.zcs-font-14 {\n\t\tfont-size: 14px;\n}\n.zcs-font-16 {\n\t\tfont-size: 16px;\n}\n.zcs-font-18 {\n\t\tfont-size: 18px;\n}\n.zcs-font-24 {\n\t\tfont-size: 24px;\n}\n.zcs-font-30 {\n\t\tfont-size: 30px;\n}\n.zcs-font-normal {\n\t\tfont-weight: 400;\n}\n.zcs-font-medium {\n\t\tfont-weight: 500;\n}\n.zcs-font-semibold {\n\t\tfont-weight: 600;\n}\n.zcs-lh-body {\n\t\tline-height: 1.5;\n}\n.zcs-lh-heading {\n\t\tline-height: 1.25;\n}\n.zcs-color-primary {\n\t\tcolor: var(--zcs-primary-text-color);\n}\n.zcs-color-secondary {\n\t\tcolor: var(--zcs-secondary-text-color);\n}\n.zcs-color-tertiary {\n\t\tcolor: var(--zcs-teritiary-text-color);\n}\n.zcs-color-theme {\n\t\tcolor: var(--zcs-theme-brand-color);\n}\n.zcs-rounded-sm {\n\t\tborder-radius: 4px;\n}\n.zcs-rounded-md {\n\t\tborder-radius: 6px;\n}\n.zcs-box-border {\n\t\tbox-sizing: border-box;\n}\n.zcs-text-left {\n\t\ttext-align: left;\n}\n.zcs-text-right {\n\t\ttext-align: right;\n}\n.zcs-relative {\n\t\tposition: relative;\n}\n.zcs-sticky {\n\t\tposition: sticky;\n}\n.zcs-w-full {\n\t\twidth: 100%;\n}\n.zcs-card {\n\t\tbackground-color: var(--zcs-white-color);\n\t\tborder: 1px solid #e7e7ee;\n\t\tborder-radius: 12px;\n}\n.zcs-button {\n\t\twidth: auto;\n\t\tmin-width: 80px;\n\t\tmin-height: 36px;\n}\n.zcs-primary-outline-button {\n\t\tborder: 1px solid var(--zcs_brand_color);\n\t\tbackground-color: var(--zcs-white-color);\n\t\tcolor: var(--zcs_brand_color);\n}\n.zcs-primary-outline-button:hover {\n\t\tbackground-color: var(--zcs_component_hover_color);\n}\n.zcs-button-icon {\n\t\twidth: 16px;\n\t\tmax-height: 16px;\n}\n.zcs-badge {\n\t\twidth: auto;\n}\n.zcs-badge-filled-outline {\n\t\tborder: 1px solid;\n}\n.zcs-badge-filled-outline.zcs-badge-red {\n\t\tbackground-color: #fde3e6;\n\t\tborder-color: #fe455d;\n\t\tcolor: #b32336;\n}\n.zcs-badge-filled-outline.zcs-badge-blue {\n\t\tbackground-color: #e8efff;\n\t\tborder-color: #2a6ffc;\n\t\tcolor: #1e55c8;\n}\n.zcs-table-wrapper {\n\t\tborder: 1px solid var(--zcs-border-color);\n\t\tbackground-color: var(--zcs-white-color);\n\t\toverflow: auto;\n}\n.zcs-table-wrapper table {\n\t\tborder-collapse: collapse;\n}\n.zcs-table-wrapper th {\n\t\tbackground-color: #f9fafe;\n\t\twhite-space: nowrap;\n}\n.zcs-table-wrapper th,\n.zcs-table-wrapper td {\n\t\tborder-top: 1px solid var(--zcs-border-color);\n}\n.zcs-table-wrapper tbody tr:first-child td {\n\t\tborder-top-color: transparent;\n}\n.zcs-tl-li {\n\t\tlist-style: none;\n\t\tborder-left: 2px solid var(--zcs_brand_color);\n\t\tpadding-left: 16px;\n}\n.ops-dashboard {\n\t\tmin-height: 100%;\n\t\tpadding: 20px;\n\t\tbackground: var(--zcs-page-bg-color);\n\t\tcolor: var(--zcs-primary-text-color);\n\t\tfont-family: Arial, sans-serif;\n}\n.ops-page-header {\n\t\tpadding: 24px;\n}\n.ops-actions {\n\t\tflex-wrap: wrap;\n}\n.ops-filter-panel {\n\t\tmargin-top: 16px;\n}\n.ops-filter-groups {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(2, minmax(0, 1fr));\n\t\tgap: 16px;\n}\n.ops-filter-label {\n\t\tdisplay: block;\n\t\tmargin-bottom: 8px;\n\t\tcolor: var(--zcs-teritiary-text-color);\n\t\tfont-size: 12px;\n\t\tfont-weight: 600;\n\t\ttext-transform: uppercase;\n}\n.ops-filter-links {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: 8px;\n}\n.ops-filter-link {\n\t\tpadding: 6px 10px;\n\t\tborder: 1px solid var(--zcs-border-color);\n\t\tborder-radius: 6px;\n\t\tbackground: var(--zcs-white-color);\n\t\tcolor: var(--zcs-primary-text-color);\n\t\tfont-size: 13px;\n}\n.ops-filter-link.ops-filter-active {\n\t\tborder-color: var(--zcs_brand_color);\n\t\tbackground: var(--zcs_component_hover_color);\n\t\tcolor: var(--zcs_brand_color);\n}\n.ops-kpi-grid {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(4, minmax(150px, 1fr));\n\t\tgap: 16px;\n\t\tmargin-top: 16px;\n}\n.ops-kpi-icon {\n\t\tfont-size: 20px;\n\t\tcolor: var(--zcs_brand_color);\n}\n.ops-kpi-value {\n\t\tmargin-top: 10px;\n\t\tfont-size: 30px;\n\t\tfont-weight: 600;\n}\n.ops-content-grid {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(12, minmax(0, 1fr));\n\t\tgap: 16px;\n\t\tmargin-top: 16px;\n}\n.ops-span-4 {\n\t\tgrid-column: span 4;\n}\n.ops-span-6 {\n\t\tgrid-column: span 6;\n}\n.ops-span-12 {\n\t\tgrid-column: span 12;\n}\n.ops-section-header {\n\t\tmargin-bottom: 16px;\n}\n.ops-stage-list {\n\t\tdisplay: grid;\n\t\tgap: 10px;\n}\n.ops-stage-row {\n\t\tpadding: 10px 12px;\n\t\tborder: 1px solid var(--zcs-border-color);\n\t\tborder-radius: 6px;\n}\n.ops-work-row {\n\t\tpadding: 12px 0;\n\t\tborder-bottom: 1px solid var(--zcs-border-color);\n}\n.ops-work-row:last-child {\n\t\tborder-bottom: 0;\n}\n.ops-empty {\n\t\tpadding: 18px;\n\t\tcolor: var(--zcs-teritiary-text-color);\n\t\ttext-align: center;\n}\n@media (max-width: 1000px) {\n\t\t.ops-kpi-grid {\n\t\t\t\tgrid-template-columns: repeat(2, minmax(150px, 1fr));\n\t\t}\n\t\t.ops-span-4,\n\t\t.ops-span-6 {\n\t\t\t\tgrid-column: span 12;\n\t\t}\n}\n@media (max-width: 700px) {\n\t\t.ops-dashboard {\n\t\t\t\tpadding: 12px;\n\t\t}\n\t\t.ops-page-header {\n\t\t\t\talign-items: flex-start;\n\t\t\t\tflex-direction: column;\n\t\t}\n\t\t.ops-filter-groups {\n\t\t\t\tgrid-template-columns: 1fr;\n\t\t}\n\t\t.ops-kpi-grid {\n\t\t\t\tgrid-template-columns: 1fr;\n\t\t}\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;ops-dashboard&apos;&gt;\n\t\t&lt;div class=&apos;zcs-page-header zcs-card zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 ops-page-header&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Operations Dashboard&lt;/h1&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-8 zcs-mb-0&apos;&gt;Read-only request volumes, stage queues, risk and approval activity. Sensitive bank values are not queried or shown.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 ops-actions&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body&apos; href=&apos;#Report:Open_Request_Queue&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-folder-15&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span&gt;Open queue&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body&apos; href=&apos;#Report:High_Risk_Bank_Requests&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span&gt;High risk&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body&apos; href=&apos;#Report:All_Request_Audit_Export&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-2-file-download-87&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span&gt;Audit export&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body&apos; href=&apos;#Report:Request_Approval_History&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-single-folded-content&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span&gt;Approval history&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-card zcs-p-16 ops-filter-panel&apos;&gt;\n\t\t\t\t&lt;div class=&apos;ops-filter-groups&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-filter-label&apos;&gt;Date range&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-filter-links&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=date30Class%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=30&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;30 days&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=date90Class%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=90&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;90 days&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=date365Class%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=365&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;12 months&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-filter-label&apos;&gt;Request type&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-filter-links&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=typeAllClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=All&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;All&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=typeNewClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=New%20Vendor&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;New vendor&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=typeGeneralClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=General%20Change&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;General change&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=typeBankClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=Bank%20Detail%20Change&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;Bank detail change&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-filter-label&apos;&gt;Stage&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-filter-links&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=stageAllClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=All&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;All&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=stageSubmittedClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=Submitted%2FData%20Check&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;Data check&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=stageProcurementClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=Procurement%20Review&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;Procurement&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=stageCallbackClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=Finance%20Callback&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;Finance callback&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=stageComplianceClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=Compliance%20Review&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;Compliance&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=stageFinanceClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=Finance%20Approval&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;Finance approval&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=stageMdmClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=MDM%20Processing&amp;amp;Risk=&lt;%=riskParam%&gt;&apos;&gt;MDM processing&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-filter-label&apos;&gt;Risk&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-filter-links&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=riskAllClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=All&apos;&gt;All&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=riskStandardClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=Standard&apos;&gt;Standard&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;ops-filter-link &lt;%=riskHighClass%&gt;&apos; href=&apos;#Page:Operations_Dashboard?Date_Range=&lt;%=dateRange%&gt;&amp;amp;Request_Type=&lt;%=requestTypeParam%&gt;&amp;amp;Stage=&lt;%=stageParam%&gt;&amp;amp;Risk=High&apos;&gt;High&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;ops-kpi-grid&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Filtered requests&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;ops-kpi-icon zc-li-outline files-single-folded-content&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-value&apos;&gt;&lt;%=filteredRequestCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Open requests&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;ops-kpi-icon zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-value&apos;&gt;&lt;%=openRequestCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;High-risk pending&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;ops-kpi-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-value&apos;&gt;&lt;%=highRiskPendingCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Completed&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;ops-kpi-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-value&apos;&gt;&lt;%=completedRequestCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;ops-content-grid&apos;&gt;\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20 ops-span-4&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-section-header&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;Stage queue counts&lt;/h2&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-stage-list&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Data check&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=submittedCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Procurement review&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=procurementCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Finance callback&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=callbackCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Compliance review&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=complianceCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Finance approval&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=financeCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;MDM processing&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=mdmCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20 ops-span-4&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;High-risk pending work&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:High_Risk_Bank_Requests&apos;&gt;Open report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\thighRiskDisplayCount = 0;\n\t\t\t\t\t\tfor each highRiskItem in highRiskCandidates\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tshowHighRisk = true;\n\t\t\t\t\t\t\t\tif(highRiskItem.Added_Time &lt; startDate)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHighRisk = false;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(highRiskItem.Current_Stage == &quot;Draft&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHighRisk = false;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(highRiskItem.Current_Stage == &quot;Completed&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHighRisk = false;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(highRiskItem.Current_Stage == &quot;Rejected&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHighRisk = false;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(requestType != &quot;All&quot; &amp;&amp; highRiskItem.Request_Type != requestType)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHighRisk = false;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(stageFilter != &quot;All&quot; &amp;&amp; highRiskItem.Current_Stage != stageFilter)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHighRisk = false;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(riskFilter != &quot;All&quot; &amp;&amp; highRiskItem.Risk_Level != riskFilter)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowHighRisk = false;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(showHighRisk &amp;&amp; highRiskDisplayCount &lt; 5)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\thighRiskAge = 0;\n\t\t\t\t\t\t\t\t\t\tif(highRiskItem.Stage_Entered_At != null)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\thighRiskAge = highRiskItem.Stage_Entered_At.daysBetween(zoho.currenttime);\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-work-row zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Request &lt;%=highRiskItem.Request_Number%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=highRiskItem.Request_Type%&gt; | &lt;%=highRiskItem.Current_Stage%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=highRiskAge%&gt; days&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\thighRiskDisplayCount = highRiskDisplayCount + 1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(highRiskDisplayCount == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;No matching high-risk pending work&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20 ops-span-4&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;Oldest pending requests&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:Open_Request_Queue&apos;&gt;Open queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Request&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium&apos;&gt;Stage&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13 zcs-font-medium&apos;&gt;Age&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\toldestDisplayCount = 0;\n\t\t\t\t\t\t\t\t\t\tfor each pendingItem in oldestCandidates\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tshowPending = true;\n\t\t\t\t\t\t\t\t\t\t\t\tif(pendingItem.Added_Time &lt; startDate)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowPending = false;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(pendingItem.Stage_Entered_At == null)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowPending = false;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(pendingItem.Current_Stage == &quot;Completed&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowPending = false;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(pendingItem.Current_Stage == &quot;Rejected&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowPending = false;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(requestType != &quot;All&quot; &amp;&amp; pendingItem.Request_Type != requestType)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowPending = false;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(stageFilter != &quot;All&quot; &amp;&amp; pendingItem.Current_Stage != stageFilter)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowPending = false;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(riskFilter != &quot;All&quot; &amp;&amp; pendingItem.Risk_Level != riskFilter)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowPending = false;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(showPending &amp;&amp; oldestDisplayCount &lt; 6)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpendingAge = pendingItem.Stage_Entered_At.daysBetween(zoho.currenttime);\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Report:Open_Request_Queue?ID=&lt;%=pendingItem.ID%&gt;&apos;&gt;&lt;%=pendingItem.Request_Number%&gt;&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13&apos;&gt;&lt;%=pendingItem.Current_Stage%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13&apos;&gt;&lt;%=pendingAge%&gt;d&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\toldestDisplayCount = oldestDisplayCount + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\tif(oldestDisplayCount == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-empty&apos;&gt;No matching pending requests.&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-card zcs-p-20 ops-span-12&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0&apos;&gt;Recent approval activity&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-font-13 zcs-color-theme&apos; href=&apos;#Report:Request_Approval_History&apos;&gt;View history&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-timeline-wrapper&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tactivityDisplayCount = 0;\n\t\t\t\t\t\t\t\tfor each activityItem in recentActivities\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tshowActivity = true;\n\t\t\t\t\t\t\t\t\t\tif(requestType != &quot;All&quot; &amp;&amp; activityItem.Vendor_Request.Request_Type != requestType)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tshowActivity = false;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(stageFilter != &quot;All&quot; &amp;&amp; activityItem.Stage != stageFilter)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tshowActivity = false;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(riskFilter != &quot;All&quot; &amp;&amp; activityItem.Vendor_Request.Risk_Level != riskFilter)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tshowActivity = false;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(showActivity &amp;&amp; activityDisplayCount &lt; 6)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-flex zcs-direction-column zcs-gap-4 zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=activityItem.Decision%&gt; at &lt;%=activityItem.Stage%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;&lt;%=activityItem.Decision_At%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Request &lt;%=activityItem.Vendor_Request.Request_Number%&gt; | Actor profile: &lt;%=activityItem.Actor_Profile%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tactivityDisplayCount = activityDisplayCount + 1;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\tif(activityDisplayCount == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;div class=&apos;ops-empty&apos;&gt;No matching approval activity in this date range.&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Vendor_Portal_Home
		{
					displayname = "Vendor Portal Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='VendorPortalHome' elementName='Vendor Portal Home'>\n\t\t\t\t\t<![CDATA[htmlpage VendorPortalHome()\n\t\t\t\t\t\t content\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;file name:Vendor_Portal_Home/Vendor_Home.dshtml/&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Block_Approval_History_Delete as "Block Approval History Delete"
			{
			
						    type = form
						    form = Approval_History
						    record event = on delete
						    description = "Rejects deletion of permanent transition evidence"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Approval"
						                    Action = "Approval History Delete Blocked"
						                    Record_Form = "Approval_History"
						                    Record_ID = input.ID
						                    Vendor_Request = input.Vendor_Request
						                    Before_Value = "Stage: " + input.Stage + "; decision: " + input.Decision + "; actor: " + input.Actor_Email + "; time: " + input.Decision_At
						                    Outcome = "Failed"
						                    Details = "Approval history is permanent and cannot be deleted interactively."
						                ];
						                alert "Approval history is permanent and cannot be deleted.";
						                cancel delete;
						            )
						        }
						    }
						
			}

			Block_Approval_History_Mutation as "Block Approval History Mutation"
			{
			
						    type = form
						    form = Approval_History
						    record event = on add or edit
						    description = "Rejects interactive creation or modification of immutable transition evidence"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Approval"
						                    Action = "Approval History Mutation Blocked"
						                    Record_Form = "Approval_History"
						                    Record_ID = ifnull(input.ID,0)
						                    Vendor_Request = input.Vendor_Request
						                    Outcome = "Failed"
						                    Details = "Approval history is system generated and cannot be created or edited interactively."
						                ];
						                alert "Approval history is system generated and cannot be added or edited.";
						                cancel submit;
						            )
						        }
						    }
						
			}

			Protect_Approval_History as "Protect Approval History"
			{
			
						    type = form
						    form = Approval_History
						    record event = on add or edit
						    description = "Presents transition evidence as read only"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                disable Vendor_Request;
						                disable Stage;
						                disable Decision;
						                disable Actor_Email;
						                disable Actor_Profile;
						                disable Decision_At;
						                disable Comment;
						                disable Previous_Stage;
						                disable Next_Stage;
						                disable Related_Compliance_Review;
						                disable Related_Bank_Verification;
						            )
						        }
						    }
						
			}

			Block_Audit_Log_Delete as "Block Audit Log Delete"
			{
			
						    type = form
						    form = Audit_Log
						    record event = on delete
						    description = "Rejects deletion of permanent audit evidence"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                alert "Audit events are permanent and cannot be deleted.";
						                cancel delete;
						            )
						        }
						    }
						
			}

			Block_Audit_Log_Mutation as "Block Audit Log Mutation"
			{
			
						    type = form
						    form = Audit_Log
						    record event = on add or edit
						    description = "Rejects interactive creation or modification of system-generated audit evidence"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                alert "Audit events are system generated and cannot be added or edited.";
						                cancel submit;
						            )
						        }
						    }
						
			}

			Protect_Audit_Log as "Protect Audit Log"
			{
			
						    type = form
						    form = Audit_Log
						    record event = on add or edit
						    description = "Presents audit evidence as read only"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                disable Event_Time;
						                disable Actor_Email;
						                disable Actor_Profile;
						                disable Event_Category;
						                disable Action;
						                disable Record_Form;
						                disable Record_ID;
						                disable Vendor_Request;
						                disable Outcome;
						                disable Source_IP;
						                disable Before_Value;
						                disable After_Value;
						                disable Details;
						            )
						        }
						    }
						
			}

			Derive_Callback_Source as "Derive Callback Source"
			{
			
						    type = form
						    form = Bank_Verifications
						    record event = on add or edit
						    description = "Copies the callback number only from the selected request's SAP vendor master record"
						
						    on user input of Vendor_Request
						    {
						        actions
						        {
						            custom deluge script
						            (
						                input.Existing_Vendor = null;
						                input.Callback_Number_Used = "";
						                input.Number_Source = "SAP Vendor Master";
						                if (input.Vendor_Request != null)
						                {
						                    requestRecord = Vendor_Requests[ID == input.Vendor_Request];
						                    if (requestRecord.count() > 0 && requestRecord.Existing_Vendor != null)
						                    {
						                        input.Existing_Vendor = requestRecord.Existing_Vendor;
						                        vendorRecord = Vendor_Master[ID == requestRecord.Existing_Vendor];
						                        if (vendorRecord.count() > 0)
						                        {
						                            input.Callback_Number_Used = vendorRecord.Callback_Phone_On_File;
						                        }
						                    }
						                }
						            )
						        }
						    }
						
			}

			Audit_Bank_Verification as "Audit Bank Verification"
			{
			
						    type = form
						    form = Bank_Verifications
						    record event = on add or edit
						    description = "Records successful callback and independent Finance evidence saves"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Bank Verification"
						                    Action = "Bank Verification Evidence Saved"
						                    Record_Form = "Bank_Verifications"
						                    Record_ID = input.ID
						                    Vendor_Request = input.Vendor_Request
						                    After_Value = "Source: " + input.Number_Source + "; callback result: " + input.Verification_Result + "; called by: " + input.Called_By + "; second decision: " + input.Second_Approval_Decision + "; second approver: " + input.Second_Approver_Email
						                    Outcome = "Success"
						                    Details = "Independent callback and Finance sign-off evidence was saved."
						                ];
						            )
						        }
						    }
						
			}

			Protect_Bank_Verification as "Protect Bank Verification"
			{
			
						    type = form
						    form = Bank_Verifications
						    record event = on add or edit
						    description = "Derives the independent callback source and locks controlled outcome fields"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if (input.Vendor_Request != null)
						                {
						                    requestRecord = Vendor_Requests[ID == input.Vendor_Request];
						                    if (requestRecord.count() > 0 && requestRecord.Existing_Vendor != null)
						                    {
						                        input.Existing_Vendor = requestRecord.Existing_Vendor;
						                        vendorRecord = Vendor_Master[ID == requestRecord.Existing_Vendor];
						                        if (vendorRecord.count() > 0)
						                        {
						                            input.Callback_Number_Used = vendorRecord.Callback_Phone_On_File;
						                            input.Number_Source = "SAP Vendor Master";
						                        }
						                    }
						                }
						                disable Vendor_Request;
						                disable Existing_Vendor;
						                disable Callback_Number_Used;
						                disable Number_Source;
						                disable Call_Date_Time;
						                disable Called_By;
						                disable Contact_Name;
						                disable Verification_Result;
						                disable Verification_Notes;
						                disable Second_Approver_Email;
						                disable Second_Approval_Date;
						                disable Second_Approval_Decision;
						                disable Second_Approval_Comment;
						            )
						        }
						    }
						
			}

			Validate_Bank_Verification as "Validate Bank Verification"
			{
			
						    type = form
						    form = Bank_Verifications
						    record event = on add or edit
						    description = "Enforces SAP callback source, stage order, segregation of duties, and required comments"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                failureReason = "";
						                requestRecord = Vendor_Requests[ID == input.Vendor_Request];
						                if (requestRecord.count() == 0)
						                {
						                    failureReason = "The selected vendor request no longer exists.";
						                }
						                else if (requestRecord.Request_Type != "Bank Detail Change")
						                {
						                    failureReason = "Bank verification is available only for bank-detail change requests.";
						                }
						                else if (requestRecord.Existing_Vendor == null)
						                {
						                    failureReason = "The request must reference an existing SAP vendor.";
						                }
						                if (failureReason == "")
						                {
						                    vendorRecord = Vendor_Master[ID == requestRecord.Existing_Vendor];
						                    if (vendorRecord.count() == 0 || vendorRecord.Callback_Phone_On_File in {""," ","null"})
						                    {
						                        failureReason = "No callback number is available in the SAP Vendor Master mirror.";
						                    }
						                    else if (input.Existing_Vendor != requestRecord.Existing_Vendor || input.Callback_Number_Used != vendorRecord.Callback_Phone_On_File || input.Number_Source != "SAP Vendor Master")
						                    {
						                        failureReason = "The callback must use the phone number held in the SAP Vendor Master mirror.";
						                    }
						                }
						                if (failureReason == "" && input.Called_By.toLowerCase() == requestRecord.Requested_By_Email.toLowerCase())
						                {
						                    failureReason = "The requester cannot perform the bank callback.";
						                }
						                if (failureReason == "" && input.Verification_Result == "Verified" && requestRecord.Current_Stage != "Finance Callback")
						                {
						                    failureReason = "A successful callback can be completed only during the Finance Callback stage.";
						                }
						                if (failureReason == "" && input.Verification_Result in {"Failed","Unable to Reach"} && input.Verification_Notes in {""," ","null"})
						                {
						                    failureReason = "Explain a failed or unreachable callback in the verification notes.";
						                }
						                if (failureReason == "" && input.Second_Approval_Decision != "Pending")
						                {
						                    complianceReview = Compliance_Reviews[Vendor_Request == input.Vendor_Request && Decision == "Approved"];
						                    if (requestRecord.Current_Stage != "Finance Approval" || complianceReview.count() == 0)
						                    {
						                        failureReason = "Compliance approval must be complete before the independent Finance decision.";
						                    }
						                    else if (input.Second_Approver_Email in {""," ","null"})
						                    {
						                        failureReason = "The independent Finance approver is required.";
						                    }
						                    else if (input.Second_Approver_Email.toLowerCase() == requestRecord.Requested_By_Email.toLowerCase() || input.Second_Approver_Email.toLowerCase() == input.Called_By.toLowerCase())
						                    {
						                        failureReason = "The Finance approver must differ from both the requester and callback caller.";
						                    }
						                    else if (input.Second_Approval_Comment in {""," ","null"})
						                    {
						                        failureReason = "A Finance approval or rejection comment is required.";
						                    }
						                }
						                if (failureReason != "")
						                {
						                    insert into Audit_Log
						                    [
						                        Event_Time = zoho.currenttime
						                        Actor_Email = zoho.loginuser
						                        Event_Category = "Bank Verification"
						                        Action = "Bank Verification Save Blocked"
						                        Record_Form = "Bank_Verifications"
						                        Record_ID = ifnull(input.ID,0)
						                        Vendor_Request = input.Vendor_Request
						                        Outcome = "Failed"
						                        Details = failureReason
						                    ];
						                    alert failureReason;
						                    cancel submit;
						                }
						            )
						        }
						    }
						
			}

			Audit_Compliance_Checklist as "Audit Compliance Checklist"
			{
			
						    type = form
						    form = Compliance_Reviews
						    record event = on add or edit
						    description = "Records successful manual checklist evidence saves"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Compliance"
						                    Action = "Compliance Checklist Saved"
						                    Record_Form = "Compliance_Reviews"
						                    Record_ID = input.ID
						                    Vendor_Request = input.Vendor_Request
						                    After_Value = "Identity: " + input.Identity_Verified + "; Tax: " + input.Tax_Documents_Verified + "; Registration: " + input.Registration_Verified + "; Manual watchlist: " + input.Watchlist_Manual_Check_Completed + "; Documents: " + input.Documents_Complete + "; Bank callback reviewed: " + input.Bank_Callback_Result_Reviewed + "; Evidence: " + input.Evidence_Reference
						                    Outcome = "Success"
						                    Details = "Manual Phase 1 compliance screening evidence was saved; the decision remains controlled by Request Action."
						                ];
						            )
						        }
						    }
						
			}

			Protect_Compliance_Review as "Protect Compliance Review"
			{
			
						    type = form
						    form = Compliance_Reviews
						    record event = on add or edit
						    description = "Initializes reviewer metadata and prevents direct decision changes"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                disable Reviewer_Email;
						                disable Review_Started_At;
						                disable Review_Completed_At;
						                disable Decision;
						                disable Decision_Comment;
						                if (input.ID == null)
						                {
						                    input.Reviewer_Email = zoho.loginuser;
						                    input.Review_Started_At = zoho.currenttime;
						                    input.Decision = "Pending";
						                }
						                if (input.Vendor_Request != null)
						                {
						                    requestRecord = Vendor_Requests[ID == input.Vendor_Request];
						                    if (requestRecord.count() > 0 && requestRecord.Request_Type == "Bank Detail Change")
						                    {
						                        show Bank_Callback_Result_Reviewed;
						                    }
						                    else
						                    {
						                        hide Bank_Callback_Result_Reviewed;
						                    }
						                    if (requestRecord.count() == 0 || requestRecord.Current_Stage != "Compliance Review" || input.Decision != "Pending" || input.Reviewer_Email.toLowerCase() != zoho.loginuser.toLowerCase())
						                    {
						                        disable Vendor_Request;
						                        disable Identity_Verified;
						                        disable Tax_Documents_Verified;
						                        disable Registration_Verified;
						                        disable Watchlist_Manual_Check_Completed;
						                        disable Insurance_Verified;
						                        disable Documents_Complete;
						                        disable Bank_Callback_Result_Reviewed;
						                        disable Findings;
						                        disable Evidence_Reference;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Validate_Compliance_Review as "Validate Compliance Review"
			{
			
						    type = form
						    form = Compliance_Reviews
						    record event = on add or edit
						    description = "Enforces one active review, checklist completion, stage ownership, and decision evidence"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                requestRecord = Vendor_Requests[ID == input.Vendor_Request];
						                failureReason = "";
						                if (requestRecord.count() == 0)
						                {
						                    failureReason = "The selected vendor request no longer exists.";
						                }
						                else if (requestRecord.Current_Stage != "Compliance Review")
						                {
						                    failureReason = "Compliance checklist work is allowed only during the Compliance Review stage.";
						                }
						                else if (input.Decision != "Pending")
						                {
						                    failureReason = "Compliance decisions must be completed through Request Action.";
						                }
						                else if (input.Reviewer_Email.toLowerCase() != zoho.loginuser.toLowerCase())
						                {
						                    failureReason = "Only the assigned reviewer can update this checklist.";
						                }
						                if (failureReason == "")
						                {
						                    if (input.ID == null)
						                    {
						                        activeReviews = Compliance_Reviews[Vendor_Request == input.Vendor_Request && Decision == "Pending"];
						                    }
						                    else
						                    {
						                        activeReviews = Compliance_Reviews[Vendor_Request == input.Vendor_Request && Decision == "Pending" && ID != input.ID];
						                    }
						                    if (activeReviews.count() > 0)
						                    {
						                        failureReason = "An active compliance review already exists for this request.";
						                    }
						                }
						                if (failureReason == "" && (!input.Identity_Verified || !input.Tax_Documents_Verified || !input.Registration_Verified || !input.Watchlist_Manual_Check_Completed || !input.Documents_Complete))
						                {
						                    failureReason = "Complete the identity, tax, registration, manual watchlist, and document checks before saving.";
						                }
						                if (failureReason == "" && requestRecord.Request_Type == "Bank Detail Change" && !input.Bank_Callback_Result_Reviewed)
						                {
						                    failureReason = "Review the completed Finance callback result before saving this bank-change checklist.";
						                }
						                if (failureReason != "")
						                {
						                    insert into Audit_Log
						                    [
						                        Event_Time = zoho.currenttime
						                        Actor_Email = zoho.loginuser
						                        Event_Category = "Compliance"
						                        Action = "Compliance Checklist Save Blocked"
						                        Record_Form = "Compliance_Reviews"
						                        Record_ID = ifnull(input.ID,0)
						                        Vendor_Request = input.Vendor_Request
						                        Outcome = "Failed"
						                        Details = failureReason
						                    ];
						                    alert failureReason;
						                    cancel submit;
						                }
						                if (input.Review_Started_At == null)
						                {
						                    input.Review_Started_At = zoho.currenttime;
						                }
						            )
						        }
						    }
						
			}

			Audit_Duplicate_Match as "Audit Duplicate Match"
			{
			
						    type = form
						    form = Duplicate_Matches
						    record event = on add or edit
						    description = "Records duplicate check evidence and any controlled resolution"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                requestRecord = Vendor_Requests[ID == input.Vendor_Request];
						                eventName = "Duplicate Check Recorded";
						                if (input.Resolution_Status != "Open")
						                {
						                    eventName = "Duplicate Alert Resolved";
						                }
						                insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Duplicate Check"
						                    Action = eventName
						                    Record_Form = "Duplicate_Matches"
						                    Record_ID = input.ID
						                    Vendor_Request = input.Vendor_Request
						                    After_Value = "Request " + requestRecord.Request_Number + "; status " + input.Resolution_Status + "; basis " + input.Match_Basis + "; score " + input.Match_Score + "; comment " + input.Resolution_Comment
						                    Outcome = "Success"
						                    Details = "Duplicate evidence was recorded or resolved through the controlled process."
						                ];
						            )
						        }
						    }
						
			}

			Protect_Duplicate_Match as "Protect Duplicate Match"
			{
			
						    type = form
						    form = Duplicate_Matches
						    record event = on add or edit
						    description = "Keeps duplicate evidence and resolution fields system controlled"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                disable Vendor_Request;
						                disable Matched_Vendor;
						                disable Matched_Open_Request;
						                disable Match_Basis;
						                disable Match_Score;
						                disable Match_Summary;
						                disable Resolution_Status;
						                disable Resolution_Comment;
						                disable Resolved_By;
						                disable Resolved_At;
						            )
						        }
						    }
						
			}

			Validate_Duplicate_Match as "Validate Duplicate Match"
			{
			
						    type = form
						    form = Duplicate_Matches
						    record event = on add or edit
						    description = "Ensures each match has a target and each resolution has complete evidence"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if (input.Matched_Vendor == null && input.Matched_Open_Request == null)
						                {
						                    alert "A duplicate alert must identify either an SAP vendor or another open request.";
						                    cancel submit;
						                }
						                if (input.Matched_Open_Request != null && input.Matched_Open_Request == input.Vendor_Request)
						                {
						                    alert "A vendor request cannot be matched to itself.";
						                    cancel submit;
						                }
						                if (input.Match_Score != null && (input.Match_Score < 0 || input.Match_Score > 100))
						                {
						                    alert "Match Score must be between 0 and 100.";
						                    cancel submit;
						                }
						                if (input.Resolution_Status == "Open")
						                {
						                    input.Resolution_Comment = "";
						                    input.Resolved_By = null;
						                    input.Resolved_At = null;
						                }
						                else
						                {
						                    if (input.Resolution_Comment in {""," ","null"})
						                    {
						                        alert "A resolution comment is required before closing a duplicate alert.";
						                        cancel submit;
						                    }
						                    if (input.Resolved_By in {""," ","null"})
						                    {
						                        input.Resolved_By = zoho.loginuser;
						                    }
						                    if (input.Resolved_At == null)
						                    {
						                        input.Resolved_At = zoho.currenttime;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Configure_Request_Action_Inputs as "Configure Request Action Inputs"
			{
			
						    type = form
						    form = Request_Action
						    record event = on add
						    description = "Shows only the evidence inputs needed for the selected action"
						
						    on user input of Action_Type
						    {
						        actions
						        {
						            custom deluge script
						            (
						                hide Duplicate_Resolution;
						                hide Document_ID;
						                hide Compliance_Review_ID;
						                hide Bank_Verification_ID;
						                hide SAP_Reference;
						                if (input.Action_Type == "Resolve Duplicate")
						                {
						                    show Duplicate_Resolution;
						                }
						                if (input.Action_Type in {"Verify Document","Reject Document"})
						                {
						                    show Document_ID;
						                }
						                if (input.Action_Type == "Approve Compliance")
						                {
						                    show Compliance_Review_ID;
						                }
						                if (input.Action_Type in {"Complete Finance Callback","Approve Finance"})
						                {
						                    show Bank_Verification_ID;
						                }
						                if (input.Action_Type == "Mark SAP Complete")
						                {
						                    show SAP_Reference;
						                }
						            )
						        }
						    }
						
			}

			Execute_Controlled_Request_Action as "Execute Controlled Request Action"
			{
			
						    type = form
						    form = Request_Action
						    button = Execute_Action
						    description = "Revalidates and performs controlled request, evidence, and lifecycle actions"
						
						    on click
						    {
						        actions
						        {
						            on click
						            (
						                actorEmail = zoho.loginuser;
						                actorProfile = "";
						                try
						                {
						                    actorProfile = thisapp.permissions.loginUserProfile();
						                }
						                catch (profileError)
						                {
						                    actorProfile = thisapp.portal.loginUserProfile();
						                }
						                isAdministrator = actorProfile in {"Administrator","Developer"};
						                failureReason = "";
						                eventCategory = "Request";
						                previousStage = "";
						                nextStage = "";
						                decisionValue = "Approved";
						                relatedCompliance = null;
						                relatedBank = null;
						                requestRecord = Vendor_Requests[ID == input.Vendor_Request_ID];
						                if (requestRecord.count() == 0)
						                {
						                    failureReason = "The vendor request no longer exists.";
						                }
						                else
						                {
						                    previousStage = requestRecord.Current_Stage;
						                }
						                if (failureReason == "" && input.Action_Type in {""," ","null"})
						                {
						                    failureReason = "Select an action.";
						                }
						                if (failureReason == "" && input.Confirmation != true)
						                {
						                    failureReason = "Confirm the controlled action before continuing.";
						                }
						                if (failureReason == "" && input.Action_Type in {"Return","Reject","Escalate"} && input.Decision_Comment in {""," ","null"})
						                {
						                    failureReason = "A decision comment is required for return, rejection, or escalation.";
						                }
						                if (failureReason == "" && input.Action_Type == "Submit Request")
						                {
						                    isOwner = requestRecord.Requested_By_Email.toLowerCase() == actorEmail.toLowerCase();
						                    if (!(actorProfile in {"Business_Requestor","Vendor_Portal_User"} || isAdministrator) || !isOwner || !(requestRecord.Current_Stage in {"Draft","Returned"}))
						                    {
						                        failureReason = "Only the request owner may submit a Draft or Returned request.";
						                    }
						                    else if (Request_Documents[Vendor_Request == requestRecord.ID].count() == 0)
						                    {
						                        failureReason = "Upload at least one supporting document before submission.";
						                    }
						                    else
						                    {
						                        nextStage = "Submitted/Data Check";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = "Procurement_Officer";
						                        requestRecord.Submitted_At = zoho.currenttime;
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                        requestRecord.Rejection_or_Return_Reason = "";
						                        decisionValue = "Submitted";
						                    }
						                }
						                if (failureReason == "" && input.Action_Type == "Approve Procurement")
						                {
						                    if (!(actorProfile == "Procurement_Officer" || isAdministrator) || !(requestRecord.Current_Stage in {"Submitted/Data Check","Procurement Review"}))
						                    {
						                        failureReason = "Procurement may act only during data check or Procurement Review.";
						                    }
						                    else if (requestRecord.Duplicate_Flag == true && Duplicate_Matches[Vendor_Request == requestRecord.ID && Resolution_Status == "Open"].count() > 0)
						                    {
						                        failureReason = "Resolve all open duplicate alerts before Procurement approval.";
						                    }
						                    else if (Request_Documents[Vendor_Request == requestRecord.ID && Verification_Status != "Verified"].count() > 0)
						                    {
						                        failureReason = "All supporting documents must be verified before Procurement approval.";
						                    }
						                    else if (requestRecord.Current_Stage == "Submitted/Data Check")
						                    {
						                        nextStage = "Procurement Review";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = "Procurement_Officer";
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                    }
						                    else if (requestRecord.Request_Type == "Bank Detail Change")
						                    {
						                        vendorRecord = Vendor_Master[ID == requestRecord.Existing_Vendor];
						                        if (vendorRecord.count() == 0 || vendorRecord.Callback_Phone_On_File in {""," ","null"})
						                        {
						                            failureReason = "The SAP mirror must contain an independent callback number before bank verification.";
						                        }
						                        else
						                        {
						                            bankEvidence = Bank_Verifications[Vendor_Request == requestRecord.ID && Verification_Result == "Pending"];
						                            if (bankEvidence.count() == 0)
						                            {
						                                relatedBank = insert into Bank_Verifications
						                                [
						                                    Vendor_Request = requestRecord.ID
						                                    Existing_Vendor = requestRecord.Existing_Vendor
						                                    Callback_Number_Used = vendorRecord.Callback_Phone_On_File
						                                    Number_Source = "SAP Vendor Master"
						                                    Call_Date_Time = zoho.currenttime
						                                    Called_By = actorEmail
						                                    Contact_Name = "Pending callback"
						                                    Verification_Result = "Pending"
						                                    Verification_Notes = "Callback evidence pending Finance completion."
						                                    Second_Approval_Decision = "Pending"
						                                ];
						                            }
						                            else
						                            {
						                                relatedBank = bankEvidence.ID;
						                            }
						                            nextStage = "Finance Callback";
						                            requestRecord.Current_Stage = nextStage;
						                            requestRecord.Current_Assignee_Profile = "Finance_Manager";
						                            requestRecord.Stage_Entered_At = zoho.currenttime;
						                        }
						                    }
						                    else
						                    {
						                        complianceEvidence = Compliance_Reviews[Vendor_Request == requestRecord.ID && Decision == "Pending"];
						                        if (complianceEvidence.count() == 0)
						                        {
						                            relatedCompliance = insert into Compliance_Reviews
						                            [
						                                Vendor_Request = requestRecord.ID
						                                Reviewer_Email = actorEmail
						                                Review_Started_At = zoho.currenttime
						                                Decision = "Pending"
						                            ];
						                        }
						                        else
						                        {
						                            relatedCompliance = complianceEvidence.ID;
						                        }
						                        nextStage = "Compliance Review";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = "Compliance_Analyst";
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                    }
						                }
						                if (failureReason == "" && input.Action_Type == "Complete Finance Callback")
						                {
						                    eventCategory = "Bank Verification";
						                    bankEvidence = Bank_Verifications[ID == input.Bank_Verification_ID && Vendor_Request == requestRecord.ID];
						                    if (!(actorProfile == "Finance_Manager" || isAdministrator) || requestRecord.Current_Stage != "Finance Callback")
						                    {
						                        failureReason = "Finance callback completion is allowed only during Finance Callback.";
						                    }
						                    else if (bankEvidence.count() == 0)
						                    {
						                        failureReason = "Select the callback evidence record for this request.";
						                    }
						                    else if (actorEmail.toLowerCase() == requestRecord.Requested_By_Email.toLowerCase())
						                    {
						                        failureReason = "The requester cannot perform the independent callback.";
						                    }
						                    else if (input.Decision_Comment in {""," ","null"})
						                    {
						                        failureReason = "Document the callback contact and result in the decision comment.";
						                    }
						                    else
						                    {
						                        bankEvidence.Call_Date_Time = zoho.currenttime;
						                        bankEvidence.Called_By = actorEmail;
						                        bankEvidence.Contact_Name = "Verified vendor contact";
						                        bankEvidence.Verification_Result = "Verified";
						                        bankEvidence.Verification_Notes = input.Decision_Comment;
						                        relatedBank = bankEvidence.ID;
						                        complianceEvidence = Compliance_Reviews[Vendor_Request == requestRecord.ID && Decision == "Pending"];
						                        if (complianceEvidence.count() == 0)
						                        {
						                            relatedCompliance = insert into Compliance_Reviews
						                            [
						                                Vendor_Request = requestRecord.ID
						                                Reviewer_Email = actorEmail
						                                Review_Started_At = zoho.currenttime
						                                Decision = "Pending"
						                            ];
						                        }
						                        else
						                        {
						                            relatedCompliance = complianceEvidence.ID;
						                        }
						                        nextStage = "Compliance Review";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = "Compliance_Analyst";
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                    }
						                }
						                if (failureReason == "" && input.Action_Type == "Approve Compliance")
						                {
						                    eventCategory = "Compliance";
						                    complianceEvidence = Compliance_Reviews[ID == input.Compliance_Review_ID && Vendor_Request == requestRecord.ID];
						                    if (!(actorProfile == "Compliance_Analyst" || isAdministrator) || requestRecord.Current_Stage != "Compliance Review")
						                    {
						                        failureReason = "Compliance approval is allowed only during Compliance Review.";
						                    }
						                    else if (complianceEvidence.count() == 0 || complianceEvidence.Decision != "Pending")
						                    {
						                        failureReason = "Select the active pending compliance review for this request.";
						                    }
						                    else if (!complianceEvidence.Identity_Verified || !complianceEvidence.Tax_Documents_Verified || !complianceEvidence.Registration_Verified || !complianceEvidence.Watchlist_Manual_Check_Completed || !complianceEvidence.Documents_Complete)
						                    {
						                        failureReason = "Complete all mandatory manual compliance checks before approval.";
						                    }
						                    else if (requestRecord.Request_Type == "Bank Detail Change" && (!complianceEvidence.Bank_Callback_Result_Reviewed || Bank_Verifications[Vendor_Request == requestRecord.ID && Verification_Result == "Verified"].count() == 0))
						                    {
						                        failureReason = "A verified callback must be reviewed before approving a bank change.";
						                    }
						                    else
						                    {
						                        complianceEvidence.Decision = "Approved";
						                        complianceEvidence.Decision_Comment = input.Decision_Comment;
						                        complianceEvidence.Reviewer_Email = actorEmail;
						                        complianceEvidence.Review_Completed_At = zoho.currenttime;
						                        relatedCompliance = complianceEvidence.ID;
						                        if (requestRecord.Request_Type == "Bank Detail Change")
						                        {
						                            nextStage = "Finance Approval";
						                            requestRecord.Current_Assignee_Profile = "Finance_Manager";
						                        }
						                        else
						                        {
						                            nextStage = "MDM Processing";
						                            requestRecord.Current_Assignee_Profile = "MDM_Team";
						                        }
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                    }
						                }
						                if (failureReason == "" && input.Action_Type == "Approve Finance")
						                {
						                    eventCategory = "Bank Verification";
						                    bankEvidence = Bank_Verifications[ID == input.Bank_Verification_ID && Vendor_Request == requestRecord.ID];
						                    if (!(actorProfile == "Finance_Manager" || isAdministrator) || requestRecord.Current_Stage != "Finance Approval")
						                    {
						                        failureReason = "Finance approval is allowed only during Finance Approval.";
						                    }
						                    else if (bankEvidence.count() == 0 || bankEvidence.Verification_Result != "Verified")
						                    {
						                        failureReason = "Select verified callback evidence for this request.";
						                    }
						                    else if (actorEmail.toLowerCase() in {requestRecord.Requested_By_Email.toLowerCase(),bankEvidence.Called_By.toLowerCase()})
						                    {
						                        failureReason = "The final Finance approver must differ from the requester and callback caller.";
						                    }
						                    else if (input.Decision_Comment in {""," ","null"})
						                    {
						                        failureReason = "A Finance approval comment is required.";
						                    }
						                    else
						                    {
						                        bankEvidence.Second_Approver_Email = actorEmail;
						                        bankEvidence.Second_Approval_Date = zoho.currenttime;
						                        bankEvidence.Second_Approval_Decision = "Approved";
						                        bankEvidence.Second_Approval_Comment = input.Decision_Comment;
						                        relatedBank = bankEvidence.ID;
						                        nextStage = "MDM Processing";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = "MDM_Team";
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                    }
						                }
						                if (failureReason == "" && input.Action_Type == "Resolve Duplicate")
						                {
						                    eventCategory = "Duplicate Check";
						                    duplicateEvidence = Duplicate_Matches[Vendor_Request == requestRecord.ID && Resolution_Status == "Open"];
						                    if (!(actorProfile == "Procurement_Officer" || isAdministrator) || !(requestRecord.Current_Stage in {"Submitted/Data Check","Procurement Review"}))
						                    {
						                        failureReason = "Duplicate resolution is restricted to Procurement during data check and review.";
						                    }
						                    else if (duplicateEvidence.count() == 0)
						                    {
						                        failureReason = "No open duplicate alert exists for this request.";
						                    }
						                    else if (input.Duplicate_Resolution in {""," ","null"} || input.Decision_Comment in {""," ","null"})
						                    {
						                        failureReason = "Select a duplicate resolution and provide a comment.";
						                    }
						                    else
						                    {
						                        duplicateEvidence.Resolution_Status = input.Duplicate_Resolution;
						                        duplicateEvidence.Resolution_Comment = input.Decision_Comment;
						                        duplicateEvidence.Resolved_By = actorEmail;
						                        duplicateEvidence.Resolved_At = zoho.currenttime;
						                        requestRecord.Duplicate_Flag = Duplicate_Matches[Vendor_Request == requestRecord.ID && Resolution_Status == "Open"].count() > 0;
						                    }
						                }
						                if (failureReason == "" && input.Action_Type in {"Verify Document","Reject Document"})
						                {
						                    eventCategory = "Document";
						                    documentEvidence = Request_Documents[ID == input.Document_ID && Vendor_Request == requestRecord.ID];
						                    if (!(actorProfile == "Procurement_Officer" || isAdministrator) || !(requestRecord.Current_Stage in {"Submitted/Data Check","Procurement Review"}))
						                    {
						                        failureReason = "Document verification is restricted to Procurement during data check and review.";
						                    }
						                    else if (documentEvidence.count() == 0)
						                    {
						                        failureReason = "Select a supporting document belonging to this request.";
						                    }
						                    else if (input.Action_Type == "Reject Document" && input.Decision_Comment in {""," ","null"})
						                    {
						                        failureReason = "A document rejection reason is required.";
						                    }
						                    else
						                    {
						                        documentEvidence.Verification_Status = if(input.Action_Type == "Verify Document","Verified","Rejected");
						                        documentEvidence.Verified_By = actorEmail;
						                        documentEvidence.Verified_At = zoho.currenttime;
						                        documentEvidence.Rejection_Reason = if(input.Action_Type == "Reject Document",input.Decision_Comment,"");
						                    }
						                }
						                if (failureReason == "" && input.Action_Type == "Mark SAP Complete")
						                {
						                    eventCategory = "SAP Completion";
						                    if (!(actorProfile == "MDM_Team" || isAdministrator) || requestRecord.Current_Stage != "MDM Processing")
						                    {
						                        failureReason = "Only MDM may complete a request during MDM Processing.";
						                    }
						                    else if (input.SAP_Reference in {""," ","null"})
						                    {
						                        failureReason = "Enter the SAP completion reference.";
						                    }
						                    else
						                    {
						                        nextStage = "Completed";
						                        decisionValue = "Completed";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = "";
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                        requestRecord.Completed_At = zoho.currenttime;
						                        requestRecord.SAP_Completion_Reference = input.SAP_Reference;
						                    }
						                }
						                if (failureReason == "" && input.Action_Type in {"Return","Reject","Escalate"})
						                {
						                    validProcessor = actorProfile in {"Procurement_Officer","Compliance_Analyst","Finance_Manager","MDM_Team"} || isAdministrator;
						                    if (!validProcessor || !(requestRecord.Current_Stage in {"Submitted/Data Check","Procurement Review","Finance Callback","Compliance Review","Finance Approval","MDM Processing","Escalated"}))
						                    {
						                        failureReason = "This exception action is not permitted for the current user and stage.";
						                    }
						                    else if (input.Action_Type == "Return")
						                    {
						                        nextStage = "Returned";
						                        decisionValue = "Returned";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = if(requestRecord.Submission_Channel == "Vendor Portal","Vendor_Portal_User","Business_Requestor");
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                        requestRecord.Rejection_or_Return_Reason = input.Decision_Comment;
						                    }
						                    else if (input.Action_Type == "Reject")
						                    {
						                        nextStage = "Rejected";
						                        decisionValue = "Rejected";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = "";
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                        requestRecord.Rejection_or_Return_Reason = input.Decision_Comment;
						                    }
						                    else
						                    {
						                        nextStage = "Escalated";
						                        decisionValue = "Escalated";
						                        requestRecord.Current_Stage = nextStage;
						                        requestRecord.Current_Assignee_Profile = actorProfile;
						                        requestRecord.Stage_Entered_At = zoho.currenttime;
						                        requestRecord.Rejection_or_Return_Reason = input.Decision_Comment;
						                    }
						                }
						                actionChangesStage = nextStage != "";
						                if (failureReason != "")
						                {
						                    insert into Audit_Log
						                    [
						                        Event_Time = zoho.currenttime
						                        Actor_Email = actorEmail
						                        Actor_Profile = actorProfile
						                        Event_Category = eventCategory
						                        Action = input.Action_Type + " Blocked"
						                        Record_Form = "Vendor_Requests"
						                        Record_ID = input.Vendor_Request_ID
						                        Vendor_Request = if(requestRecord.count() > 0,requestRecord.ID,null)
						                        Outcome = "Failed"
						                        Details = failureReason
						                    ];
						                    alert failureReason;
						                }
						                else
						                {
						                    if (actionChangesStage)
						                    {
						                        insert into Approval_History
						                        [
						                            Vendor_Request = requestRecord.ID
						                            Stage = previousStage
						                            Decision = decisionValue
						                            Actor_Email = actorEmail
						                            Actor_Profile = actorProfile
						                            Decision_At = zoho.currenttime
						                            Comment = input.Decision_Comment
						                            Previous_Stage = previousStage
						                            Next_Stage = nextStage
						                            Related_Compliance_Review = relatedCompliance
						                            Related_Bank_Verification = relatedBank
						                        ];
						                    }
						                    insert into Audit_Log
						                    [
						                        Event_Time = zoho.currenttime
						                        Actor_Email = actorEmail
						                        Actor_Profile = actorProfile
						                        Event_Category = eventCategory
						                        Action = input.Action_Type
						                        Record_Form = "Vendor_Requests"
						                        Record_ID = requestRecord.ID
						                        Vendor_Request = requestRecord.ID
						                        Before_Value = "Stage: " + previousStage
						                        After_Value = if(actionChangesStage,"Stage: " + nextStage,"Controlled evidence updated without a stage change")
						                        Outcome = "Success"
						                        Details = ifnull(input.Decision_Comment,"")
						                    ];
						                    sendmail
						                    (
						                        from : zoho.adminuserid
						                        to : requestRecord.Requested_By_Email
						                        subject : "Vendor request " + requestRecord.Request_Number + ": " + input.Action_Type
						                        message : "Action: " + input.Action_Type + "<br>Current stage: " + requestRecord.Current_Stage + "<br>Comment: " + ifnull(input.Decision_Comment,"")
						                    )
						                    insert into Audit_Log
						                    [
						                        Event_Time = zoho.currenttime
						                        Actor_Email = zoho.adminuserid
						                        Actor_Profile = "System"
						                        Event_Category = "Notification"
						                        Action = "Request Action Notification Sent"
						                        Record_Form = "Vendor_Requests"
						                        Record_ID = requestRecord.ID
						                        Vendor_Request = requestRecord.ID
						                        Outcome = "Success"
						                        Details = "Notification sent to " + requestRecord.Requested_By_Email + " for " + input.Action_Type
						                    ];
						                    alert "The controlled action was completed successfully.";
						                    openUrl("#Report:My_Vendor_Requests","parent window");
						                }
						            )
						        }
						    }
						
			}

			Load_Request_Action as "Load Request Action"
			{
			
						    type = form
						    form = Request_Action
						    record event = on add
						    description = "Loads request context and derives actions permitted by profile, ownership, and stage"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                disable Vendor_Request_ID;
						                disable Request_Context;
						                hide Duplicate_Resolution;
						                hide Document_ID;
						                hide Compliance_Review_ID;
						                hide Bank_Verification_ID;
						                hide SAP_Reference;
						                input.Action_Type:ui.add(list());
						                actorProfile = "";
						                try
						                {
						                    actorProfile = thisapp.permissions.loginUserProfile();
						                }
						                catch (profileError)
						                {
						                    actorProfile = thisapp.portal.loginUserProfile();
						                }
						                requestRecord = Vendor_Requests[ID == input.Vendor_Request_ID];
						                if (requestRecord.count() > 0)
						                {
						                    input.Request_Context = "Request: " + requestRecord.Request_Number + " | Type: " + requestRecord.Request_Type + " | Stage: " + requestRecord.Current_Stage + " | Risk: " + requestRecord.Risk_Level + " | Possible duplicate: " + requestRecord.Duplicate_Flag;
						                    isAdministrator = actorProfile in {"Administrator","Developer"};
						                    isOwner = requestRecord.Requested_By_Email.toLowerCase() == zoho.loginuser.toLowerCase();
						                    if ((actorProfile in {"Business_Requestor","Vendor_Portal_User"} || isAdministrator) && isOwner && requestRecord.Current_Stage in {"Draft","Returned"})
						                    {
						                        input.Action_Type:ui.add("Submit Request");
						                    }
						                    if ((actorProfile == "Procurement_Officer" || isAdministrator) && requestRecord.Current_Stage in {"Submitted/Data Check","Procurement Review"})
						                    {
						                        input.Action_Type:ui.add("Approve Procurement");
						                    }
						                    if ((actorProfile == "Finance_Manager" || isAdministrator) && requestRecord.Current_Stage == "Finance Callback")
						                    {
						                        input.Action_Type:ui.add("Complete Finance Callback");
						                    }
						                    if ((actorProfile == "Compliance_Analyst" || isAdministrator) && requestRecord.Current_Stage == "Compliance Review")
						                    {
						                        input.Action_Type:ui.add("Approve Compliance");
						                    }
						                    if ((actorProfile == "Finance_Manager" || isAdministrator) && requestRecord.Current_Stage == "Finance Approval")
						                    {
						                        input.Action_Type:ui.add("Approve Finance");
						                    }
						                    if ((actorProfile == "MDM_Team" || isAdministrator) && requestRecord.Current_Stage == "MDM Processing")
						                    {
						                        input.Action_Type:ui.add("Mark SAP Complete");
						                    }
						                    if ((actorProfile in {"Procurement_Officer","Compliance_Analyst","Finance_Manager","MDM_Team"} || isAdministrator) && requestRecord.Current_Stage in {"Submitted/Data Check","Procurement Review","Finance Callback","Compliance Review","Finance Approval","MDM Processing","Escalated"})
						                    {
						                        input.Action_Type:ui.add("Return");
						                        input.Action_Type:ui.add("Reject");
						                        input.Action_Type:ui.add("Escalate");
						                    }
						                    if ((actorProfile == "Procurement_Officer" || isAdministrator) && requestRecord.Current_Stage in {"Submitted/Data Check","Procurement Review"})
						                    {
						                        input.Action_Type:ui.add("Resolve Duplicate");
						                        input.Action_Type:ui.add("Verify Document");
						                        input.Action_Type:ui.add("Reject Document");
						                    }
						                }
						                else
						                {
						                    input.Request_Context = "The requested vendor request record was not found.";
						                    disable Action_Type;
						                    disable Confirmation;
						                }
						            )
						        }
						    }
						
			}

			Audit_Request_Document_Deletion as "Audit Request Document Deletion"
			{
			
						    type = form
						    form = Request_Documents
						    record event = on delete
						    description = "Records allowed deletion of a pending document"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                auditId = insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Document"
						                    Action = "Pending Document Deleted"
						                    Record_Form = "Request_Documents"
						                    Record_ID = input.ID
						                    Vendor_Request = input.Vendor_Request
						                    Before_Value = "Type: " + input.Document_Type + "; Confidentiality: " + input.Confidentiality_Level + "; Verification: " + input.Verification_Status
						                    Outcome = "Success"
						                    Details = "The request owner deleted a pending document while the request remained editable."
						                ];
						            )
						        }
						    }
						
			}

			Audit_Request_Document_Save as "Audit Request Document Save"
			{
			
						    type = form
						    form = Request_Documents
						    record event = on add or edit
						    description = "Audits document upload, metadata edits, and file replacement"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                auditId = insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Document"
						                    Action = "Document Uploaded or Replaced"
						                    Record_Form = "Request_Documents"
						                    Record_ID = input.ID
						                    Vendor_Request = input.Vendor_Request
						                    After_Value = "Type: " + input.Document_Type + "; Confidentiality: " + input.Confidentiality_Level + "; Verification: " + input.Verification_Status + "; Expiry: " + input.Expiry_Date
						                    Outcome = "Success"
						                    Details = "Supporting document content or metadata was saved; prior changes remain evidenced by the audit trail."
						                ];
						            )
						        }
						    }
						
			}

			Control_Request_Document_Deletion as "Control Request Document Deletion"
			{
			
						    type = form
						    form = Request_Documents
						    record event = on delete
						    description = "Blocks deletion after verification or once processing has begun"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                parentRequest = Vendor_Requests[ID == input.Vendor_Request];
						                deletionBlocked = false;
						                blockReason = "";
						                if (input.Verification_Status != "Pending")
						                {
						                    deletionBlocked = true;
						                    blockReason = "Verified or rejected documents cannot be deleted.";
						                }
						                if (parentRequest.count() > 0 && parentRequest.Current_Stage != "Draft" && parentRequest.Current_Stage != "Returned")
						                {
						                    deletionBlocked = true;
						                    blockReason = "Documents cannot be deleted after request processing begins.";
						                }
						                if (input.Owner_Email.toLowerCase() != zoho.loginuser.toLowerCase())
						                {
						                    deletionBlocked = true;
						                    blockReason = "Only the document owner can delete a pending document.";
						                }
						                if (deletionBlocked)
						                {
						                    auditId = insert into Audit_Log
						                    [
						                        Event_Time = zoho.currenttime
						                        Actor_Email = zoho.loginuser
						                        Event_Category = "Document"
						                        Action = "Document Deletion Blocked"
						                        Record_Form = "Request_Documents"
						                        Record_ID = input.ID
						                        Vendor_Request = input.Vendor_Request
						                        Outcome = "Failed"
						                        Details = blockReason
						                    ];
						                    alert blockReason;
						                    cancel delete;
						                }
						            )
						        }
						    }
						
			}

			Protect_Document_Verification as "Protect Document Verification"
			{
			
						    type = form
						    form = Request_Documents
						    record event = on add or edit
						    description = "Initializes document ownership and locks verification fields"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                disable Verification_Status;
						                disable Verified_By;
						                disable Verified_At;
						                disable Rejection_Reason;
						                if (input.Owner_Email in {""," ","null"})
						                {
						                    input.Owner_Email = zoho.loginuser;
						                }
						                if (input.Vendor_Request != null)
						                {
						                    parentRequest = Vendor_Requests[ID == input.Vendor_Request];
						                    if (parentRequest.count() > 0 && input.Existing_Vendor == null)
						                    {
						                        input.Existing_Vendor = parentRequest.Existing_Vendor;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Validate_Request_Document as "Validate Request Document"
			{
			
						    type = form
						    form = Request_Documents
						    record event = on add or edit
						    description = "Enforces parent ownership, expiry ordering, and pending verification"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                parentRequest = Vendor_Requests[ID == input.Vendor_Request];
						                if (parentRequest.count() == 0)
						                {
						                    alert "The selected vendor request no longer exists.";
						                    cancel submit;
						                }
						                if (parentRequest.Current_Stage != "Draft" && parentRequest.Current_Stage != "Returned")
						                {
						                    alert "Documents can only be uploaded or replaced while the request is Draft or Returned.";
						                    cancel submit;
						                }
						                if (parentRequest.Requested_By_Email.toLowerCase() != zoho.loginuser.toLowerCase() && input.Owner_Email.toLowerCase() != zoho.loginuser.toLowerCase())
						                {
						                    alert "Only the request owner can upload or replace supporting documents.";
						                    cancel submit;
						                }
						                if (input.Issue_Date != null && input.Expiry_Date != null && input.Expiry_Date <= input.Issue_Date)
						                {
						                    alert "Expiry Date must be later than Issue Date.";
						                    cancel submit;
						                }
						                input.Existing_Vendor = parentRequest.Existing_Vendor;
						                input.Owner_Email = parentRequest.Requested_By_Email;
						                input.Verification_Status = "Pending";
						                input.Verified_By = null;
						                input.Verified_At = null;
						                input.Rejection_Reason = "";
						            )
						        }
						    }
						
			}

			Audit_SLA_Configuration as "Audit SLA Configuration"
			{
			
						    type = form
						    form = SLA_Configuration
						    record event = on add or edit
						    description = "Records successful SLA configuration changes in the application audit trail"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                actionName = if(input.ID != null,"SLA rule saved","SLA rule created");
						                auditId = insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Configuration"
						                    Action = actionName
						                    Record_Form = "SLA_Configuration"
						                    Record_ID = input.ID
						                    After_Value = "Rule Code: " + input.Rule_Code + "; Rule Type: " + input.Rule_Type + "; Days: " + input.Days + "; Active: " + input.Active
						                    Outcome = "Success"
						                    Details = "SLA configuration was saved."
						                ];
						            )
						        }
						    }
						
			}

			Validate_SLA_Configuration as "Validate SLA Configuration"
			{
			
						    type = form
						    form = SLA_Configuration
						    record event = on add or edit
						    description = "Validates positive rule durations and singleton baseline and target rules"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if (ifnull(input.Days,0) <= 0)
						                {
						                    alert "Days must be greater than zero.";
						                    cancel submit;
						                }
						                if (input.Rule_Type in {"Legacy Email Cycle Baseline","Portal Cycle Target"} && input.Active == true)
						                {
						                    matchingRules = SLA_Configuration[Rule_Type == input.Rule_Type && Active == true && ID != input.ID];
						                    if (matchingRules.count() > 0)
						                    {
						                        alert "Only one active " + input.Rule_Type + " rule is allowed.";
						                        cancel submit;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Audit_Vendor_Master as "Audit Vendor Master"
			{
			
						    type = form
						    form = Vendor_Master
						    record event = on add or edit
						    description = "Records imported vendor changes in the audit trail"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                auditId = insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Vendor Master Import"
						                    Action = "SAP vendor mirror record saved"
						                    Record_Form = "Vendor_Master"
						                    Record_ID = input.ID
						                    After_Value = "SAP Vendor: " + input.SAP_Vendor_Number + "; Legal Name: " + input.Legal_Name + "; Status: " + input.Vendor_Status + "; Batch: " + ifnull(input.Import_Batch_Reference,"")
						                    Outcome = "Success"
						                    Details = "A vendor mirror record was created or updated from the manual SAP extract."
						                ];
						            )
						        }
						    }
						
			}

			Normalize_Vendor_Master as "Normalize Vendor Master"
			{
			
						    type = form
						    form = Vendor_Master
						    record event = on add or edit
						    description = "Normalizes imported SAP identifiers for duplicate detection"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                input.Normalized_Legal_Name = ifnull(input.Legal_Name,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Tax_ID = ifnull(input.Tax_ID,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Registration_ID = ifnull(input.Registration_ID,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Bank_Account = ifnull(input.Bank_Account_Number,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Email = ifnull(input.Primary_Email,"").trim().toLowerCase();
						                if (input.Last_SAP_Import_Date == null)
						                {
						                    input.Last_SAP_Import_Date = zoho.currenttime;
						                }
						            )
						        }
						    }
						
			}

			Set_Request_Type_Behaviour as "Set Request Type Behaviour"
			{
			
						    type = form
						    form = Vendor_Requests
						    record event = on add or edit
						    description = "Shows conditional fields and marks bank changes as high risk"
						
						    on user input of Request_Type
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if (input.Request_Type == "General Change" || input.Request_Type == "Bank Detail Change")
						                {
						                    show Existing_Vendor;
						                }
						                else
						                {
						                    hide Existing_Vendor;
						                    input.Existing_Vendor = null;
						                }
						                if (input.Request_Type == "New Vendor" || input.Request_Type == "Bank Detail Change")
						                {
						                    show Proposed_Bank_Section;
						                }
						                else
						                {
						                    hide Proposed_Bank_Section;
						                }
						                if (input.Request_Type == "Bank Detail Change")
						                {
						                    input.Risk_Level = "High";
						                }
						                else
						                {
						                    input.Risk_Level = "Standard";
						                }
						            )
						        }
						    }
						
			}

			Configure_Vendor_Request_Form as "Configure Vendor Request Form"
			{
			
						    type = form
						    form = Vendor_Requests
						    record event = on add or edit
						    description = "Applies request-type visibility and protects lifecycle controls"
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                hide Normalized_Legal_Name;
						                hide Normalized_Tax_ID;
						                hide Normalized_Registration_ID;
						                hide Normalized_Bank_Account;
						                hide Normalized_Email;
						                disable Risk_Level;
						                disable Duplicate_Flag;
						                disable Current_Stage;
						                disable Current_Assignee_Profile;
						                disable Submitted_At;
						                disable Stage_Entered_At;
						                disable Completed_At;
						                disable SAP_Completion_Reference;
						                disable Rejection_or_Return_Reason;
						                if (input.Request_Type == "General Change" || input.Request_Type == "Bank Detail Change")
						                {
						                    show Existing_Vendor;
						                }
						                else
						                {
						                    hide Existing_Vendor;
						                }
						                if (input.Request_Type == "New Vendor" || input.Request_Type == "Bank Detail Change")
						                {
						                    show Proposed_Bank_Section;
						                }
						                else
						                {
						                    hide Proposed_Bank_Section;
						                }
						                if (input.ID != null && input.Current_Stage != "Draft" && input.Current_Stage != "Returned")
						                {
						                    disable Request_Type;
						                    disable Submission_Channel;
						                    disable Existing_Vendor;
						                    disable Business_Justification;
						                    disable Requested_By_Email;
						                    disable Legal_Name;
						                    disable Trading_Name;
						                    disable Tax_ID;
						                    disable Registration_ID;
						                    disable Primary_Email;
						                    disable Primary_Phone;
						                    disable Registered_Address;
						                    disable Country;
						                    disable Bank_Name;
						                    disable Account_Holder_Name;
						                    disable Bank_Account_Number;
						                    disable IBAN;
						                    disable SWIFT_BIC;
						                }
						            )
						        }
						    }
						
			}

			Initialize_And_Audit_Vendor_Request as "Initialize and Audit Vendor Request"
			{
			
						    type = form
						    form = Vendor_Requests
						    record event = on add or edit
						    description = "Initializes draft ownership and records successful draft saves"
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                requestRec = Vendor_Requests[ID == input.ID];
						                if (requestRec.count() > 0 && requestRec.Current_Stage in {""," ","null"})
						                {
						                    requestRec.Current_Stage = "Draft";
						                    requestRec.Current_Assignee_Profile = if(input.Submission_Channel == "Vendor Portal","Vendor_Portal_User","Business_Requestor");
						                    requestRec.Stage_Entered_At = zoho.currenttime;
						                }
						                auditId = insert into Audit_Log
						                [
						                    Event_Time = zoho.currenttime
						                    Actor_Email = zoho.loginuser
						                    Event_Category = "Request"
						                    Action = "Draft Saved"
						                    Record_Form = "Vendor_Requests"
						                    Record_ID = input.ID
						                    Vendor_Request = input.ID
						                    After_Value = "Request Type: " + input.Request_Type + "; Stage: " + input.Current_Stage + "; Duplicate Flag: " + input.Duplicate_Flag
						                    Outcome = "Success"
						                    Details = "Vendor request details were saved. Submission requires the controlled Request Action form."
						                ];
						            )
						        }
						    }
						
			}

			Validate_Vendor_Request as "Validate Vendor Request"
			{
			
						    type = form
						    form = Vendor_Requests
						    record event = on add or edit
						    description = "Validates conditional data, normalizes identifiers, and flags exact duplicates"
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if ((input.Request_Type == "General Change" || input.Request_Type == "Bank Detail Change") && input.Existing_Vendor == null)
						                {
						                    alert "Select the existing SAP vendor for a change request.";
						                    cancel submit;
						                }
						                if ((input.Request_Type == "New Vendor" || input.Request_Type == "Bank Detail Change") && input.Bank_Name in {""," ","null"})
						                {
						                    alert "Bank name is required for new-vendor and bank-detail requests.";
						                    cancel submit;
						                }
						                if ((input.Request_Type == "New Vendor" || input.Request_Type == "Bank Detail Change") && input.Account_Holder_Name in {""," ","null"})
						                {
						                    alert "Account holder name is required when bank details are proposed.";
						                    cancel submit;
						                }
						                if ((input.Request_Type == "New Vendor" || input.Request_Type == "Bank Detail Change") && input.Bank_Account_Number == "" && input.IBAN == "")
						                {
						                    alert "Enter either a bank account number or an IBAN.";
						                    cancel submit;
						                }
						                if (input.ID != null && input.Current_Stage != "Draft" && input.Current_Stage != "Returned")
						                {
						                    alert "Only Draft or Returned requests may be edited. Use Request Action for lifecycle decisions.";
						                    cancel submit;
						                }
						                input.Risk_Level = if(input.Request_Type == "Bank Detail Change","High","Standard");
						                input.Normalized_Legal_Name = ifnull(input.Legal_Name,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Tax_ID = ifnull(input.Tax_ID,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Registration_ID = ifnull(input.Registration_ID,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Bank_Account = ifnull(input.Bank_Account_Number,"").trim().toLowerCase().replaceAll("[^a-z0-9]","");
						                input.Normalized_Email = ifnull(input.Primary_Email,"").trim().toLowerCase();
						                requestLegalName = input.Normalized_Legal_Name;
						                requestTaxID = input.Normalized_Tax_ID;
						                requestRegistrationID = input.Normalized_Registration_ID;
						                requestBankAccount = input.Normalized_Bank_Account;
						                requestEmail = input.Normalized_Email;
						                requestID = ifnull(input.ID,0);
						                duplicateFound = false;
						                if (requestLegalName != "")
						                {
						                    masterLegalMatches = Vendor_Master[Active == true && Normalized_Legal_Name == requestLegalName];
						                    openLegalMatches = Vendor_Requests[ID != requestID && Current_Stage != "Rejected" && Current_Stage != "Completed" && Normalized_Legal_Name == requestLegalName];
						                    duplicateFound = duplicateFound || masterLegalMatches.count() > 0 || openLegalMatches.count() > 0;
						                }
						                if (requestTaxID != "")
						                {
						                    masterTaxMatches = Vendor_Master[Active == true && Normalized_Tax_ID == requestTaxID];
						                    openTaxMatches = Vendor_Requests[ID != requestID && Current_Stage != "Rejected" && Current_Stage != "Completed" && Normalized_Tax_ID == requestTaxID];
						                    duplicateFound = duplicateFound || masterTaxMatches.count() > 0 || openTaxMatches.count() > 0;
						                }
						                if (requestRegistrationID != "")
						                {
						                    masterRegistrationMatches = Vendor_Master[Active == true && Normalized_Registration_ID == requestRegistrationID];
						                    openRegistrationMatches = Vendor_Requests[ID != requestID && Current_Stage != "Rejected" && Current_Stage != "Completed" && Normalized_Registration_ID == requestRegistrationID];
						                    duplicateFound = duplicateFound || masterRegistrationMatches.count() > 0 || openRegistrationMatches.count() > 0;
						                }
						                if (requestBankAccount != "")
						                {
						                    masterBankMatches = Vendor_Master[Active == true && Normalized_Bank_Account == requestBankAccount];
						                    openBankMatches = Vendor_Requests[ID != requestID && Current_Stage != "Rejected" && Current_Stage != "Completed" && Normalized_Bank_Account == requestBankAccount];
						                    duplicateFound = duplicateFound || masterBankMatches.count() > 0 || openBankMatches.count() > 0;
						                }
						                if (requestEmail != "")
						                {
						                    masterEmailMatches = Vendor_Master[Active == true && Normalized_Email == requestEmail];
						                    openEmailMatches = Vendor_Requests[ID != requestID && Current_Stage != "Rejected" && Current_Stage != "Completed" && Normalized_Email == requestEmail];
						                    duplicateFound = duplicateFound || masterEmailMatches.count() > 0 || openEmailMatches.count() > 0;
						                }
						                input.Duplicate_Flag = duplicateFound;
						            )
						        }
						    }
						
			}
		}

		schedule
		{
			Request_Document_Expiry_Reminder as "Request Document Expiry Reminder"
			{
			
						    type = schedule
						    form = Request_Documents[Expiry_Date is not null && Verification_Status == "Verified"]
						    start = before 90 days from Expiry_Date at "09:00:00"
						    end = Expiry_Date at "09:00:00"
						    frequency = daily
						    time zone = "UTC"
						
						    on start
						    {
						        actions
						        {
						            on load
						            (
						                reminderRule = SLA_Configuration[Active == true && Rule_Type == "Document Expiry Reminder"];
						                if (reminderRule.count() > 0)
						                {
						                    daysRemaining = (input.Expiry_Date - zoho.currentdate).toLong();
						                    if (daysRemaining == reminderRule.Days)
						                    {
						                        sendmail
						                        (
						                            from : zoho.adminuserid
						                            to : input.Owner_Email
						                            subject : "Document renewal due for vendor request"
						                            message : ifnull(reminderRule.Message_Template,"A verified supporting document will expire in " + daysRemaining + " day(s). Please arrange renewal.")
						                        )
						                        auditId = insert into Audit_Log
						                        [
						                            Event_Time = zoho.currenttime
						                            Actor_Email = zoho.adminuserid
						                            Event_Category = "Notification"
						                            Action = "Document Expiry Reminder Sent"
						                            Record_Form = "Request_Documents"
						                            Record_ID = input.ID
						                            Vendor_Request = input.Vendor_Request
						                            Outcome = "Success"
						                            Details = "Expiry reminder sent with " + daysRemaining + " day(s) remaining."
						                        ];
						                    }
						                }
						            )
						        }
						    }
						
			}

			Vendor_Request_SLA_Reminder as "Vendor Request SLA Reminder"
			{
			
						    type = schedule
						    form = Vendor_Requests[Current_Stage != "Draft" && Current_Stage != "Rejected" && Current_Stage != "Completed"]
						    start = after 1 days from Stage_Entered_At
						    frequency = daily
						    time zone = "UTC"
						
						    on start
						    {
						        actions
						        {
						            on load
						            (
						                activeRule = SLA_Configuration[Active == true && Rule_Type == "Approval Reminder" && Applies_To_Stage == input.Current_Stage];
						                if (activeRule.count() > 0)
						                {
						                    elapsedDays = ((zoho.currenttime - input.Stage_Entered_At) / (1000 * 60 * 60 * 24)).toLong();
						                    if (elapsedDays >= activeRule.Days)
						                    {
						                        sendmail
						                        (
						                            from : zoho.adminuserid
						                            to : input.Requested_By_Email
						                            subject : "Vendor request " + input.Request_Number + " remains at " + input.Current_Stage
						                            message : ifnull(activeRule.Message_Template,"Your vendor request remains in its current processing stage and has reached the configured reminder threshold.")
						                        )
						                    }
						                }
						            )
						        }
						    }
						
			}
		}

