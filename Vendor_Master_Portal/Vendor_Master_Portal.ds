				    (
				        type = textarea
				        displayname = "Rejection or Return Reason"
				        height = 90px
				        row = 4
				        column = 1
				        width = medium
				    )
				    Normalized_Legal_Name
				    (
				        type = text
				        displayname = "Normalized Legal Name"
				        private = true
				        row = 4
				        column = 2
				        width = medium
				    )
				    Normalized_Tax_ID
				    (
				        type = text
				        displayname = "Normalized Tax ID"
				        private = true
				        row = 4
				        column = 1
				        width = medium
