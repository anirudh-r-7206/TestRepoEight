application "Vendor-Master-Portal"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Approval_History
		{
		
				    title
				    {
				        displayname = "Approval History"
				        on add = "Approval History Entry"
				        on edit = "Approval History Entry"
				    }
				    success message = "Approval history recorded."
				    Approval_Section
				    (
				        type = section
				        displayname = "Stage Decision Evidence"
				        row = 1
				        column = 0
				    )
				    must have Vendor_Request
				    (
				        type = picklist
				        displayname = "Vendor Request"
				        values = Vendor_Requests.ID
				        displayformat = [Request_Number]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Stage
				    (
				        type = text
				        displayname = "Decision Stage"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Decision
				    (
				        type = picklist
				        displayname = "Decision"
				        values = {"Submitted","Approved","Returned","Rejected","Escalated","Completed"}
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Actor_Email
				    (
				        type = email
				        displayname = "Actor Email"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Actor_Profile
				    (
				        type = text
				        displayname = "Actor Profile"
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Decision_At
				    (
				        type = datetime
				        displayname = "Decision At"
				        row = 1
				        column = 2
				        width = medium
				    )
				    Comment
				    (
				        type = textarea
				        displayname = "Decision Comment"
				        height = 100px
				        row = 1
				        column = 1
				        width = medium
				    )
				    Previous_Stage
				    (
				        type = text
				        displayname = "Previous Stage"
				        row = 1
				        column = 2
				        width = medium
				    )
				    Next_Stage
				    (
				        type = text
				        displayname = "Next Stage"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Related_Review_Section
				    (
				        type = section
				        displayname = "Related Control Evidence"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    Related_Compliance_Review
				    (
				        type = picklist
				        displayname = "Related Compliance Review"
				        values = Compliance_Reviews.ID
				        displayformat = [Reviewer_Email]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    Related_Bank_Verification
				    (
				        type = picklist
				        displayname = "Related Bank Verification"
				        values = Bank_Verifications.ID
				        displayformat = [Called_By]
				        searchable = true
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Submit"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Audit_Log
		{
		
				    title
				    {
				        displayname = "Audit Log"
				        on add = "Audit Event"
				        on edit = "Audit Event"
				    }
				    success message = "Audit event recorded."
				    Audit_Section
				    (
				        type = section
				        displayname = "Audit Evidence"
				        row = 1
				        column = 0
				    )
				    must have Event_Time
				    (
				        type = datetime
				        displayname = "Event Time"
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Actor_Email
				    (
				        type = email
				        displayname = "Actor Email"
				        row = 1
				        column = 2
				        width = medium
				    )
				    Actor_Profile
				    (
				        type = text
				        displayname = "Actor Profile"
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Event_Category
				    (
				        type = picklist
				        displayname = "Event Category"
				        values = {"Request","Vendor Master Import","Document","Duplicate Check","Compliance","Bank Verification","Approval","SAP Completion","Configuration","Security Access","Notification"}
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Action
				    (
				        type = text
				        displayname = "Action"
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Record_Form
				    (
				        type = text
				        displayname = "Record Form"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Record_ID
				    (
				        type = number
				        displayname = "Record ID"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Vendor_Request
				    (
				        type = picklist
				        displayname = "Vendor Request"
				        values = Vendor_Requests.ID
				        displayformat = [Request_Number]
				        searchable = true
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Outcome
				    (
				        type = picklist
				        displayname = "Outcome"
				        values = {"Success","Failed"}
				        row = 1
				        column = 1
				        width = medium
				    )
				    Source_IP
				    (
				        type = text
				        displayname = "Source IP"
				        row = 1
				        column = 2
				        width = medium
				    )
				    Evidence_Section
				    (
				        type = section
				        displayname = "Change and Event Detail"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    Before_Value
				    (
				        type = textarea
				        displayname = "Before Value"
				        height = 100px
				        row = 2
				        column = 1
				        width = medium
				    )
				    After_Value
				    (
				        type = textarea
				        displayname = "After Value"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    Details
				    (
				        type = textarea
				        displayname = "Details"
				        height = 120px
				        row = 2
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Submit"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Bank_Verifications
		{
		
				    title
				    {
				        displayname = "Bank Verifications"
				        on add = "Record Bank Verification"
				        on edit = "Review Bank Verification"
				    }
				    success message = "Bank verification evidence saved successfully."
				    Verification_Section
				    (
				        type = section
				        displayname = "Independent Callback"
				        row = 1
				        column = 0
				    )
				    must have Vendor_Request
				    (
				        type = picklist
				        displayname = "Vendor Request"
				        values = Vendor_Requests.ID
				        displayformat = [Request_Number]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Existing_Vendor
				    (
				        type = picklist
				        displayname = "Existing Vendor"
				        values = Vendor_Master.ID
				        displayformat = [Legal_Name]
				        searchable = true
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Callback_Number_Used
				    (
				        type = phonenumber
				        displayname = "Callback Number Used"
				        isencrypted = true
				        description
				        [
				            type = tooltip
				            message = "Copied from the SAP Vendor Master mirror; request-supplied contact details are not permitted."
				        ]
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Number_Source
				    (
				        type = picklist
				        displayname = "Number Source"
				        values = {"SAP Vendor Master"}
				        initial value = "SAP Vendor Master"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Call_Date_Time
				    (
				        type = datetime
				        displayname = "Call Date and Time"
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Called_By
				    (
				        type = email
				        displayname = "Called By"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Contact_Name
				    (
				        type = text
				        displayname = "Contact Name"
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Verification_Result
				    (
				        type = picklist
				        displayname = "Verification Result"
				        values = {"Pending","Verified","Failed","Unable to Reach"}
				        initial value = "Pending"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Verification_Notes
				    (
				        type = textarea
				        displayname = "Verification Notes"
				        height = 100px
				        row = 1
				        column = 1
				        width = medium
				    )
				    Second_Approval_Section
				    (
				        type = section
				        displayname = "Independent Finance Approval"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    Second_Approver_Email
				    (
				        type = email
				        displayname = "Second Approver Email"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Second_Approval_Date
				    (
				        type = datetime
				        displayname = "Second Approval Date"
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Second_Approval_Decision
				    (
				        type = picklist
				        displayname = "Second Approval Decision"
				        values = {"Pending","Approved","Rejected"}
				        initial value = "Pending"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Second_Approval_Comment
				    (
				        type = textarea
				        displayname = "Second Approval Comment"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Submit"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Compliance_Reviews
		{
		
				    title
				    {
				        displayname = "Compliance Reviews"
				        on add = "Start Compliance Review"
				        on edit = "Update Compliance Review"
				    }
				    success message = "Compliance checklist saved successfully."
				    Review_Section
				    (
				        type = section
				        displayname = "Review Assignment"
				        row = 1
				        column = 0
				    )
				    must have Vendor_Request
				    (
				        type = picklist
				        displayname = "Vendor Request"
				        values = Vendor_Requests.ID
				        displayformat = [Request_Number]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Reviewer_Email
				    (
				        type = email
				        displayname = "Reviewer Email"
				        row = 1
				        column = 2
				        width = medium
				    )
				    Review_Started_At
				    (
				        type = datetime
				        displayname = "Review Started At"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Review_Completed_At
				    (
				        type = datetime
				        displayname = "Review Completed At"
				        row = 1
				        column = 2
				        width = medium
				    )
				    Checklist
				    (
				        type = section
				        displayname = "Manual Screening Checklist"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    Identity_Verified
				    (
				        type = checkbox
				        displayname = "Identity Verified"
				        initial value = false
				        row = 2
				        column = 1
				        width = medium
				    )
				    Tax_Documents_Verified
				    (
				        type = checkbox
				        displayname = "Tax Documents Verified"
				        initial value = false
				        row = 2
				        column = 2
				        width = medium
				    )
				    Registration_Verified
				    (
				        type = checkbox
				        displayname = "Registration Verified"
				        initial value = false
				        row = 2
				        column = 1
				        width = medium
				    )
				    Watchlist_Manual_Check_Completed
				    (
				        type = checkbox
				        displayname = "Manual Watchlist Check Completed"
				        initial value = false
				        description
				        [
				            type = tooltip
				            message = "Phase 1 requires a documented manual check; no live watchlist API is used."
				        ]
				        row = 2
				        column = 2
				        width = medium
				    )
				    Insurance_Verified
				    (
				        type = checkbox
				        displayname = "Insurance Verified"
				        initial value = false
				        row = 2
				        column = 1
				        width = medium
				    )
				    Documents_Complete
				    (
				        type = checkbox
				        displayname = "Documents Complete"
				        initial value = false
				        row = 2
				        column = 2
				        width = medium
				    )
				    Bank_Callback_Result_Reviewed
				    (
				        type = checkbox
				        displayname = "Bank Callback Result Reviewed"
				        initial value = false
				        row = 2
				        column = 1
				        width = medium
				    )
				    Findings
				    (
				        type = textarea
				        displayname = "Findings"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    Decision_Section
				    (
				        type = section
				        displayname = "Compliance Decision"
				        visibility = true
				        row = 3
				        column = 1
				    )
				    must have Decision
				    (
				        type = picklist
				        displayname = "Decision"
				        values = {"Pending","Approved","Rejected","Escalated"}
				        initial value = "Pending"
				        row = 3
				        column = 1
				        width = medium
				    )
				    Decision_Comment
				    (
				        type = textarea
				        displayname = "Decision Comment"
				        height = 100px
				        row = 3
				        column = 2
				        width = medium
				    )
				    Evidence_Reference
				    (
				        type = text
				        displayname = "Evidence Reference"
				        description
				        [
				            type = tooltip
				            message = "Reference the manual screening source, case, or retained evidence."
				        ]
				        row = 3
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Save
				            (
				                type = submit
				                displayname = "Save Checklist"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update Checklist"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Duplicate_Matches
		{
		
				    title
				    {
				        displayname = "Duplicate Matches"
				        on add = "Record Duplicate Match"
				        on edit = "Review Duplicate Match"
				    }
				    success message = "Duplicate match saved successfully."
				    Match_Section
				    (
				        type = section
				        displayname = "Duplicate Match Evidence"
				        row = 1
				        column = 0
				    )
				    must have Vendor_Request
				    (
				        type = picklist
				        displayname = "Vendor Request"
				        values = Vendor_Requests.ID
				        displayformat = [Request_Number]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    Matched_Vendor
				    (
				        type = picklist
				        displayname = "Matched SAP Vendor"
				        values = Vendor_Master.ID
				        displayformat = [SAP_Vendor_Number]
				        searchable = true
				        row = 1
				        column = 2
				        width = medium
				    )
				    Matched_Open_Request
				    (
				        type = picklist
				        displayname = "Matched Open Request"
				        values = Vendor_Requests.ID
				        displayformat = [Request_Number]
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Match_Basis
				    (
				        type = checkboxes
				        displayname = "Match Basis"
				        values = {"Legal Name","Tax ID","Registration ID","Email","Bank Account","IBAN"}
				        layout = 2
				        row = 1
				        column = 2
				        width = medium
				    )
				    Match_Score
				    (
				        type = number
				        displayname = "Match Score"
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Match_Summary
				    (
				        type = textarea
				        displayname = "Match Summary"
				        height = 90px
				        row = 1
				        column = 2
				        width = medium
				    )
				    Resolution_Section
				    (
				        type = section
				        displayname = "Resolution"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Resolution_Status
				    (
				        type = picklist
				        displayname = "Resolution Status"
				        values = {"Open","Confirmed Duplicate","Cleared Not Duplicate"}
				        initial value = "Open"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Resolution_Comment
				    (
				        type = textarea
				        displayname = "Resolution Comment"
				        height = 90px
				        row = 2
				        column = 2
				        width = medium
				    )
				    Resolved_By
				    (
				        type = email
				        displayname = "Resolved By"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Resolved_At
				    (
				        type = datetime
				        displayname = "Resolved At"
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Submit"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Request_Action
		{
		
				    title
				    {
				        displayname = "Request Action"
				        on add = "Perform Request Action"
				        on edit = "Perform Request Action"
				    }
				    store data in zc = false
				    Action_Section
				    (
				        type = section
				        displayname = "Controlled Request Action"
				        row = 1
				        column = 0
				    )
				    must have Vendor_Request_ID
				    (
				        type = number
				        displayname = "Vendor Request ID"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Request_Context
				    (
				        type = textarea
				        displayname = "Request Context"
				        height = 100px
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Action_Type
				    (
				        type = picklist
				        displayname = "Action"
				        values = {"Submit Request","Approve Procurement","Complete Finance Callback","Approve Compliance","Approve Finance","Return","Reject","Escalate","Resolve Duplicate","Verify Document","Reject Document","Mark SAP Complete"}
				        row = 1
				        column = 1
				        width = medium
				    )
				    Decision_Comment
				    (
				        type = textarea
				        displayname = "Decision Comment"
				        height = 100px
				        row = 1
				        column = 2
				        width = medium
				    )
				    Evidence_Section
				    (
				        type = section
				        displayname = "Supporting Action Evidence"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    Duplicate_Resolution
				    (
				        type = picklist
				        displayname = "Duplicate Resolution"
				        values = {"Confirmed Duplicate","Cleared Not Duplicate"}
				        row = 2
				        column = 1
				        width = medium
				    )
				    Document_ID
				    (
				        type = number
				        displayname = "Document ID"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Compliance_Review_ID
				    (
				        type = number
				        displayname = "Compliance Review ID"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Bank_Verification_ID
				    (
				        type = number
				        displayname = "Bank Verification ID"
				        row = 2
				        column = 2
				        width = medium
				    )
				    SAP_Reference
				    (
				        type = text
				        displayname = "SAP Completion Reference"
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Confirmation
				    (
				        type = checkbox
				        displayname = "I confirm this controlled action and its evidence"
				        initial value = false
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        Execute_Action
				        (
				            type = button
				            displayname = "Execute Action"
				            tooltip = "Revalidates and performs the selected controlled action"
				        )
				        Reset_Action
				        (
				            type = reset
				            displayname = "Reset"
				        )
				    }
				
		}

		form Request_Documents
		{
		
				    title
				    {
				        displayname = "Request Documents"
				        on add = "Upload Request Document"
				        on edit = "Replace or Update Request Document"
				    }
				    record owner = Added_User
				    success message = "Document saved successfully."
				    Document_Section
				    (
				        type = section
				        displayname = "Document Details"
				        row = 1
				        column = 0
				    )
				    must have Vendor_Request
				    (
				        type = picklist
				        displayname = "Vendor Request"
				        values = Vendor_Requests.ID
				        displayformat = [Request_Number]
				        bidirectional = Request_Documents
				        searchable = true
				        row = 1
				        column = 1
				        width = medium
				    )
				    Existing_Vendor
				    (
				        type = picklist
				        displayname = "Existing Vendor"
				        values = Vendor_Master.ID
				        displayformat = [Legal_Name]
				        searchable = true
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Document_Type
				    (
				        type = picklist
				        displayname = "Document Type"
				        values = {"Tax Form","Registration Certificate","Insurance Certificate","Bank Letter","Other"}
				        row = 1
				        column = 1
				        width = medium
				    )
				    must have Document_File
				    (
				        type = upload file
				        displayname = "Document File"
				        browse = local_drive, google_docs, zoho_docs
				        row = 1
				        column = 2
				        width = medium
				    )
				    Issue_Date
				    (
				        type = date
				        displayname = "Issue Date"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Expiry_Date
				    (
				        type = date
				        displayname = "Expiry Date"
				        row = 1
				        column = 2
				        width = medium
				    )
				    must have Confidentiality_Level
				    (
				        type = picklist
				        displayname = "Confidentiality Level"
				        values = {"Standard","Sensitive","Restricted"}
				        initial value = "Standard"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Verification_Section
				    (
				        type = section
				        displayname = "Verification Control"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    Verification_Status
				    (
				        type = picklist
				        displayname = "Verification Status"
				        values = {"Pending","Verified","Rejected"}
				        initial value = "Pending"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Verified_By
				    (
				        type = email
				        displayname = "Verified By"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Verified_At
				    (
				        type = datetime
				        displayname = "Verified At"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Rejection_Reason
				    (
				        type = textarea
				        displayname = "Rejection Reason"
				        height = 90px
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Owner_Email
				    (
				        type = email
				        displayname = "Owner Email"
				        row = 2
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Upload
				            (
				                type = submit
				                displayname = "Upload Document"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Replace
				            (
				                type = submit
				                displayname = "Save Replacement"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

