form Audit_Log
{

		    title
		    {
		        displayname = "Audit Log"
		        on add = "Audit Event"
		        on edit = "Audit Event"
		    }
		    success message = "Audit event recorded."
		    Audit_Section
		    (
		        type = section
		        displayname = "Audit Evidence"
		        row = 1
		        column = 0
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Actor_Email
		    (
		        type = email
		        displayname = "Actor Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Actor_Profile
		    (
		        type = text
		        displayname = "Actor Profile"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Category
		    (
		        type = picklist
		        displayname = "Event Category"
		        values = {"Request","Vendor Master Import","Document","Duplicate Check","Compliance","Bank Verification","Approval","SAP Completion","Configuration","Security Access","Notification"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Action
		    (
		        type = text
		        displayname = "Action"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Record_Form
		    (
		        type = text
		        displayname = "Record Form"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Record_ID
		    (
		        type = number
		        displayname = "Record ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Vendor_Request
		    (
		        type = picklist
		        displayname = "Vendor Request"
		        values = Vendor_Requests.ID
		        displayformat = [Request_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Outcome
		    (
		        type = picklist
		        displayname = "Outcome"
		        values = {"Success","Failed"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source_IP
		    (
		        type = text
		        displayname = "Source IP"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Evidence_Section
		    (
		        type = section
		        displayname = "Change and Event Detail"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Before_Value
		    (
		        type = textarea
		        displayname = "Before Value"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    After_Value
		    (
		        type = textarea
		        displayname = "After Value"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Details
		    (
		        type = textarea
		        displayname = "Details"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}