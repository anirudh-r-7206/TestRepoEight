list Bank_Verification_History
{

		    displayName = "Bank Verification History"
		    show all rows from Bank_Verifications [Verification_Result != "Pending"]
		    (
		        Vendor_Request
		        Existing_Vendor
		        Number_Source
		        Call_Date_Time
		        Called_By
		        Contact_Name
		        Verification_Result
		        Verification_Notes
		        Second_Approver_Email
		        Second_Approval_Date
		        Second_Approval_Decision
		        Second_Approval_Comment
		    )
		    filters
		    (
		        Vendor_Request
		        Existing_Vendor
		        Called_By
		        Verification_Result
		        Second_Approver_Email
		        Second_Approval_Date
		        Second_Approval_Decision
		    )
		    sort by
		    (
		        Call_Date_Time descending
		    )
		
}