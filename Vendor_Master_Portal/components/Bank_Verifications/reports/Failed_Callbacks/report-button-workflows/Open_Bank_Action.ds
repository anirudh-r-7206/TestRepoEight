Open_Bank_Action as "Open Bank Action"
{

			    type = functions
			    form = Bank_Verifications
			    execution type = for each record
			    description = "Opens the controlled request action form for callback or Finance approval"
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                openUrl("#Form:Request_Action?Vendor_Request_ID=" + input.Vendor_Request + "&Bank_Verification_ID=" + input.ID, "popup window", "height=650px,width=760px");
			            )
			        }
			    }
			
}