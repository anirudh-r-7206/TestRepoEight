list Finance_Approval_Queue
{

		    displayName = "Finance Approval Queue"
		    show all rows from Bank_Verifications [Verification_Result == "Verified" && Second_Approval_Decision == "Pending"]
		    (
		        Vendor_Request
		        Existing_Vendor
		        Number_Source
		        Call_Date_Time
		        Called_By
		        Contact_Name
		        Verification_Result
		        Verification_Notes
		        Second_Approver_Email
		        Second_Approval_Date
		        Second_Approval_Decision
		        Second_Approval_Comment
		        custom action "Bank Action"
		        (
		            workflow = Open_Bank_Action
		            show action for each record = true
		            show action in edit record menu = true
		            column header = "Bank Action"
		            success message = "Opening Finance approval action"
		        )
		    )
		    filters
		    (
		        Vendor_Request
		        Existing_Vendor
		        Called_By
		        Verification_Result
		        Second_Approver_Email
		        Second_Approval_Decision
		    )
		    sort by
		    (
		        Call_Date_Time ascending
		    )
		
}