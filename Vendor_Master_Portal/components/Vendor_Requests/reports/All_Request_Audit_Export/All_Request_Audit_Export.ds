list All_Request_Audit_Export
{

		    displayName = "All Request Audit Export"
		    show all rows from Vendor_Requests
		    (
		        Request_Number
		        Request_Type
		        Submission_Channel
		        Existing_Vendor
		        Business_Justification
		        Requested_By_Email
		        Legal_Name
		        Trading_Name
		        Tax_ID
		        Registration_ID
		        Primary_Email
		        Primary_Phone
		        Registered_Address
		        Country
		        Bank_Name
		        Account_Holder_Name
		        SWIFT_BIC
		        Risk_Level
		        Duplicate_Flag
		        Current_Stage
		        Current_Assignee_Profile
		        Submitted_At
		        Stage_Entered_At
		        Completed_At
		        SAP_Completion_Reference
		        Rejection_or_Return_Reason
		        Added_User
		        Added_Time
		        Modified_User
		        Modified_Time
		    )
		    filters
		    (
		        Request_Type
		        Submission_Channel
		        Country
		        Risk_Level
		        Duplicate_Flag
		        Current_Stage
		        Submitted_At
		        Completed_At
		    )
		    sort by
		    (
		        Added_Time descending
		    )
		
}