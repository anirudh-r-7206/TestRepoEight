list Escalated_Compliance_Reviews
{

		    displayName = "Escalated Compliance Reviews"
		    show all rows from Compliance_Reviews [Decision == "Escalated"]
		    (
		        Vendor_Request
		        Reviewer_Email
		        Review_Started_At
		        Review_Completed_At
		        Findings
		        Decision
		        Decision_Comment
		        Evidence_Reference
		        custom action "Compliance Action"
		        (
		            workflow = Open_Compliance_Action
		            show action for each record = true
		            show action in edit record menu = true
		            column header = "Compliance Action"
		            success message = "Opening compliance action"
		        )
		    )
		    filters
		    (
		        Vendor_Request
		        Reviewer_Email
		        Review_Completed_At
		        Decision
		    )
		    sort by
		    (
		        Review_Completed_At descending
		    )
		
}