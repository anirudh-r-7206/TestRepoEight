<%
dateRange = input.Date_Range;
requestType = input.Request_Type;
stageFilter = input.Stage;
riskFilter = input.Risk;

if(dateRange == null)
{
		dateRange = "90";
}
if(dateRange == "")
{
		dateRange = "90";
}
if(requestType == null)
{
		requestType = "All";
}
if(requestType == "")
{
		requestType = "All";
}
if(stageFilter == null)
{
		stageFilter = "All";
}
if(stageFilter == "")
{
		stageFilter = "All";
}
if(riskFilter == null)
{
		riskFilter = "All";
}
if(riskFilter == "")
{
		riskFilter = "All";
}

startDate = zoho.currentdate.subDay(90);
if(dateRange == "30")
{
		startDate = zoho.currentdate.subDay(30);
}
if(dateRange == "365")
{
		startDate = zoho.currentdate.subDay(365);
}

requestTypeParam = encodeUrl(requestType);
stageParam = encodeUrl(stageFilter);
riskParam = encodeUrl(riskFilter);

filteredRequestCount = 0;
openRequestCount = 0;
highRiskPendingCount = 0;
completedRequestCount = 0;
submittedCount = 0;
procurementCount = 0;
callbackCount = 0;
complianceCount = 0;
financeCount = 0;
mdmCount = 0;

dateRequests = Vendor_Requests[Added_Time >= startDate];
for each requestItem in dateRequests
{
		includeRequest = true;
		if(requestType != "All" && requestItem.Request_Type != requestType)
		{
				includeRequest = false;
		}
		if(stageFilter != "All" && requestItem.Current_Stage != stageFilter)
		{
				includeRequest = false;
		}
		if(riskFilter != "All" && requestItem.Risk_Level != riskFilter)
		{
				includeRequest = false;
		}
		if(includeRequest)
		{
				filteredRequestCount = filteredRequestCount + 1;
				if(requestItem.Current_Stage == "Submitted/Data Check")
				{
						submittedCount = submittedCount + 1;
				}
				if(requestItem.Current_Stage == "Procurement Review")
				{
						procurementCount = procurementCount + 1;
				}
				if(requestItem.Current_Stage == "Finance Callback")
				{
						callbackCount = callbackCount + 1;
				}
				if(requestItem.Current_Stage == "Compliance Review")
				{
						complianceCount = complianceCount + 1;
				}
				if(requestItem.Current_Stage == "Finance Approval")
				{
						financeCount = financeCount + 1;
				}
				if(requestItem.Current_Stage == "MDM Processing")
				{
						mdmCount = mdmCount + 1;
				}
				if(requestItem.Current_Stage == "Completed")
				{
						completedRequestCount = completedRequestCount + 1;
				}
				if(requestItem.Current_Stage != "Draft" && requestItem.Current_Stage != "Completed" && requestItem.Current_Stage != "Rejected")
				{
						openRequestCount = openRequestCount + 1;
						if(requestItem.Risk_Level == "High")
						{
								highRiskPendingCount = highRiskPendingCount + 1;
						}
				}
		}
}

date30Class = "";
date90Class = "";
date365Class = "";
typeAllClass = "";
typeNewClass = "";
typeGeneralClass = "";
typeBankClass = "";
stageAllClass = "";
stageSubmittedClass = "";
stageProcurementClass = "";
stageCallbackClass = "";
stageComplianceClass = "";
stageFinanceClass = "";
stageMdmClass = "";
riskAllClass = "";
riskStandardClass = "";
riskHighClass = "";

if(dateRange == "30")
{
		date30Class = "ops-filter-active";
}
if(dateRange == "90")
{
		date90Class = "ops-filter-active";
}
if(dateRange == "365")
{
		date365Class = "ops-filter-active";
}
if(requestType == "All")
{
		typeAllClass = "ops-filter-active";
}
if(requestType == "New Vendor")
{
		typeNewClass = "ops-filter-active";
}
if(requestType == "General Change")
{
		typeGeneralClass = "ops-filter-active";
}
if(requestType == "Bank Detail Change")
{
		typeBankClass = "ops-filter-active";
}
if(stageFilter == "All")
{
		stageAllClass = "ops-filter-active";
}
if(stageFilter == "Submitted/Data Check")
{
		stageSubmittedClass = "ops-filter-active";
}
if(stageFilter == "Procurement Review")
{
		stageProcurementClass = "ops-filter-active";
}
if(stageFilter == "Finance Callback")
{
		stageCallbackClass = "ops-filter-active";
}
if(stageFilter == "Compliance Review")
{
		stageComplianceClass = "ops-filter-active";
}
if(stageFilter == "Finance Approval")
{
		stageFinanceClass = "ops-filter-active";
}
if(stageFilter == "MDM Processing")
{
		stageMdmClass = "ops-filter-active";
}
if(riskFilter == "All")
{
		riskAllClass = "ops-filter-active";
}
if(riskFilter == "Standard")
{
		riskStandardClass = "ops-filter-active";
}
if(riskFilter == "High")
{
		riskHighClass = "ops-filter-active";
}

highRiskCandidates = Vendor_Requests[Risk_Level == "High"] sort by Stage_Entered_At asc;
oldestCandidates = Vendor_Requests[Current_Stage != "Draft"] sort by Stage_Entered_At asc;
recentActivities = Approval_History[Decision_At >= startDate] sort by Decision_At desc;
%>
<style>
:root {
		--zcs-theme-brand-color: var(--zcs_brand_color);
		--zcs-page-bg-color: #f3f3f4;
		--zcs-primary-text-color: var(--zcs_primary_text_color);
		--zcs-secondary-text-color: var(--zcs_secondary_text_color);
		--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
		--zcs-border-color: var(--zcs_tertiary_border_color);
		--zcs-white-color: #ffffff;
}
* {
		box-sizing: border-box;
}
a {
		text-decoration: none;
}
.zcs-flex {
		display: flex;
}
.zcs-inline-flex {
		display: inline-flex;
}
.zcs-row {
		display: flex;
		flex-wrap: wrap;
}
.zcs-direction-column {
		flex-direction: column;
}
.zcs-align-items-center {
		align-items: center;
}
.zcs-align-items-start {
		align-items: flex-start;
}
.zcs-justify-center {
		justify-content: center;
}
.zcs-justify-space-between {
		justify-content: space-between;
}
.zcs-row-wrap {
		flex-wrap: wrap;
}
.zcs-gap-4 {
		gap: 4px;
}
.zcs-gap-8 {
		gap: 8px;
}
.zcs-gap-12 {
		gap: 12px;
}
.zcs-gap-16 {
		gap: 16px;
}
.zcs-p-0 {
		padding: 0;
}
.zcs-p-8 {
		padding: 8px;
}
.zcs-p-10 {
		padding: 10px;
}
.zcs-p-16 {
		padding: 16px;
}
.zcs-p-20 {
		padding: 20px;
}
.zcs-p-24 {
		padding: 24px;
}
.zcs-px-10 {
		padding-left: 10px;
		padding-right: 10px;
}
.zcs-px-16 {
		padding-left: 16px;
		padding-right: 16px;
}
.zcs-py-2 {
		padding-top: 2px;
		padding-bottom: 2px;
}
.zcs-py-8 {
		padding-top: 8px;
		padding-bottom: 8px;
}
.zcs-m-0 {
		margin: 0;
}
.zcs-mt-8 {
		margin-top: 8px;
}
.zcs-mb-0 {
		margin-bottom: 0;
}
.zcs-font-12 {
		font-size: 12px;
}
.zcs-font-13 {
		font-size: 13px;
}
.zcs-font-14 {
		font-size: 14px;
}
.zcs-font-16 {
		font-size: 16px;
}
.zcs-font-18 {
		font-size: 18px;
}
.zcs-font-24 {
		font-size: 24px;
}
.zcs-font-30 {
		font-size: 30px;
}
.zcs-font-normal {
		font-weight: 400;
}
.zcs-font-medium {
		font-weight: 500;
}
.zcs-font-semibold {
		font-weight: 600;
}
.zcs-lh-body {
		line-height: 1.5;
}
.zcs-lh-heading {
		line-height: 1.25;
}
.zcs-color-primary {
		color: var(--zcs-primary-text-color);
}
.zcs-color-secondary {
		color: var(--zcs-secondary-text-color);
}
.zcs-color-tertiary {
		color: var(--zcs-teritiary-text-color);
}
.zcs-color-theme {
		color: var(--zcs-theme-brand-color);
}
.zcs-rounded-sm {
		border-radius: 4px;
}
.zcs-rounded-md {
		border-radius: 6px;
}
.zcs-box-border {
		box-sizing: border-box;
}
.zcs-text-left {
		text-align: left;
}
.zcs-text-right {
		text-align: right;
}
.zcs-relative {
		position: relative;
}
.zcs-sticky {
		position: sticky;
}
.zcs-w-full {
		width: 100%;
}
.zcs-card {
		background-color: var(--zcs-white-color);
		border: 1px solid #e7e7ee;
		border-radius: 12px;
}
.zcs-button {
		width: auto;
		min-width: 80px;
		min-height: 36px;
}
.zcs-primary-outline-button {
		border: 1px solid var(--zcs_brand_color);
		background-color: var(--zcs-white-color);
		color: var(--zcs_brand_color);
}
.zcs-primary-outline-button:hover {
		background-color: var(--zcs_component_hover_color);
}
.zcs-button-icon {
		width: 16px;
		max-height: 16px;
}
.zcs-badge {
		width: auto;
}
.zcs-badge-filled-outline {
		border: 1px solid;
}
.zcs-badge-filled-outline.zcs-badge-red {
		background-color: #fde3e6;
		border-color: #fe455d;
		color: #b32336;
}
.zcs-badge-filled-outline.zcs-badge-blue {
		background-color: #e8efff;
		border-color: #2a6ffc;
		color: #1e55c8;
}
.zcs-table-wrapper {
		border: 1px solid var(--zcs-border-color);
		background-color: var(--zcs-white-color);
		overflow: auto;
}
.zcs-table-wrapper table {
		border-collapse: collapse;
}
.zcs-table-wrapper th {
		background-color: #f9fafe;
		white-space: nowrap;
}
.zcs-table-wrapper th,
.zcs-table-wrapper td {
		border-top: 1px solid var(--zcs-border-color);
}
.zcs-table-wrapper tbody tr:first-child td {
		border-top-color: transparent;
}
.zcs-tl-li {
		list-style: none;
		border-left: 2px solid var(--zcs_brand_color);
		padding-left: 16px;
}
.ops-dashboard {
		min-height: 100%;
		padding: 20px;
		background: var(--zcs-page-bg-color);
		color: var(--zcs-primary-text-color);
		font-family: Arial, sans-serif;
}
.ops-page-header {
		padding: 24px;
}
.ops-actions {
		flex-wrap: wrap;
}
.ops-filter-panel {
		margin-top: 16px;
}
.ops-filter-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
}
.ops-filter-label {
		display: block;
		margin-bottom: 8px;
		color: var(--zcs-teritiary-text-color);
		font-size: 12px;
		font-weight: 600;
		text-transform: uppercase;
}
.ops-filter-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
}
.ops-filter-link {
		padding: 6px 10px;
		border: 1px solid var(--zcs-border-color);
		border-radius: 6px;
		background: var(--zcs-white-color);
		color: var(--zcs-primary-text-color);
		font-size: 13px;
}
.ops-filter-link.ops-filter-active {
		border-color: var(--zcs_brand_color);
		background: var(--zcs_component_hover_color);
		color: var(--zcs_brand_color);
}
.ops-kpi-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(150px, 1fr));
		gap: 16px;
		margin-top: 16px;
}
.ops-kpi-icon {
		font-size: 20px;
		color: var(--zcs_brand_color);
}
.ops-kpi-value {
		margin-top: 10px;
		font-size: 30px;
		font-weight: 600;
}
.ops-content-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 16px;
		margin-top: 16px;
}
.ops-span-4 {
		grid-column: span 4;
}
.ops-span-6 {
		grid-column: span 6;
}
.ops-span-12 {
		grid-column: span 12;
}
.ops-section-header {
		margin-bottom: 16px;
}
.ops-stage-list {
		display: grid;
		gap: 10px;
}
.ops-stage-row {
		padding: 10px 12px;
		border: 1px solid var(--zcs-border-color);
		border-radius: 6px;
}
.ops-work-row {
		padding: 12px 0;
		border-bottom: 1px solid var(--zcs-border-color);
}
.ops-work-row:last-child {
		border-bottom: 0;
}
.ops-empty {
		padding: 18px;
		color: var(--zcs-teritiary-text-color);
		text-align: center;
}
@media (max-width: 1000px) {
		.ops-kpi-grid {
				grid-template-columns: repeat(2, minmax(150px, 1fr));
		}
		.ops-span-4,
		.ops-span-6 {
				grid-column: span 12;
		}
}
@media (max-width: 700px) {
		.ops-dashboard {
				padding: 12px;
		}
		.ops-page-header {
				align-items: flex-start;
				flex-direction: column;
		}
		.ops-filter-groups {
				grid-template-columns: 1fr;
		}
		.ops-kpi-grid {
				grid-template-columns: 1fr;
		}
}
</style>

<div class='ops-dashboard'>
		<div class='zcs-page-header zcs-card zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 ops-page-header'>
				<div>
						<h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Operations Dashboard</h1>
						<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-8 zcs-mb-0'>Read-only request volumes, stage queues, risk and approval activity. Sensitive bank values are not queried or shown.</p>
				</div>
				<div class='zcs-flex zcs-align-items-center zcs-gap-8 ops-actions'>
						<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body' href='#Report:Open_Request_Queue'>
								<i class='zcs-button-icon zc-li-outline files-folder-15'></i>
								<span>Open queue</span>
						</a>
						<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body' href='#Report:High_Risk_Bank_Requests'>
								<i class='zcs-button-icon zc-li-outline ui-2-time'></i>
								<span>High risk</span>
						</a>
						<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body' href='#Report:All_Request_Audit_Export'>
								<i class='zcs-button-icon zc-li-outline arrows-2-file-download-87'></i>
								<span>Audit export</span>
						</a>
						<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body' href='#Report:Request_Approval_History'>
								<i class='zcs-button-icon zc-li-outline files-single-folded-content'></i>
								<span>Approval history</span>
						</a>
				</div>
		</div>

		<div class='zcs-card zcs-p-16 ops-filter-panel'>
				<div class='ops-filter-groups'>
						<div>
								<span class='ops-filter-label'>Date range</span>
								<div class='ops-filter-links'>
										<a class='ops-filter-link <%=date30Class%>' href='#Page:Operations_Dashboard?Date_Range=30&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=<%=stageParam%>&amp;Risk=<%=riskParam%>'>30 days</a>
										<a class='ops-filter-link <%=date90Class%>' href='#Page:Operations_Dashboard?Date_Range=90&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=<%=stageParam%>&amp;Risk=<%=riskParam%>'>90 days</a>
										<a class='ops-filter-link <%=date365Class%>' href='#Page:Operations_Dashboard?Date_Range=365&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=<%=stageParam%>&amp;Risk=<%=riskParam%>'>12 months</a>
								</div>
						</div>
						<div>
								<span class='ops-filter-label'>Request type</span>
								<div class='ops-filter-links'>
										<a class='ops-filter-link <%=typeAllClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=All&amp;Stage=<%=stageParam%>&amp;Risk=<%=riskParam%>'>All</a>
										<a class='ops-filter-link <%=typeNewClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=New%20Vendor&amp;Stage=<%=stageParam%>&amp;Risk=<%=riskParam%>'>New vendor</a>
										<a class='ops-filter-link <%=typeGeneralClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=General%20Change&amp;Stage=<%=stageParam%>&amp;Risk=<%=riskParam%>'>General change</a>
										<a class='ops-filter-link <%=typeBankClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=Bank%20Detail%20Change&amp;Stage=<%=stageParam%>&amp;Risk=<%=riskParam%>'>Bank detail change</a>
								</div>
						</div>
						<div>
								<span class='ops-filter-label'>Stage</span>
								<div class='ops-filter-links'>
										<a class='ops-filter-link <%=stageAllClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=All&amp;Risk=<%=riskParam%>'>All</a>
										<a class='ops-filter-link <%=stageSubmittedClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=Submitted%2FData%20Check&amp;Risk=<%=riskParam%>'>Data check</a>
										<a class='ops-filter-link <%=stageProcurementClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=Procurement%20Review&amp;Risk=<%=riskParam%>'>Procurement</a>
										<a class='ops-filter-link <%=stageCallbackClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=Finance%20Callback&amp;Risk=<%=riskParam%>'>Finance callback</a>
										<a class='ops-filter-link <%=stageComplianceClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=Compliance%20Review&amp;Risk=<%=riskParam%>'>Compliance</a>
										<a class='ops-filter-link <%=stageFinanceClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=Finance%20Approval&amp;Risk=<%=riskParam%>'>Finance approval</a>
										<a class='ops-filter-link <%=stageMdmClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=MDM%20Processing&amp;Risk=<%=riskParam%>'>MDM processing</a>
								</div>
						</div>
						<div>
								<span class='ops-filter-label'>Risk</span>
								<div class='ops-filter-links'>
										<a class='ops-filter-link <%=riskAllClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=<%=stageParam%>&amp;Risk=All'>All</a>
										<a class='ops-filter-link <%=riskStandardClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=<%=stageParam%>&amp;Risk=Standard'>Standard</a>
										<a class='ops-filter-link <%=riskHighClass%>' href='#Page:Operations_Dashboard?Date_Range=<%=dateRange%>&amp;Request_Type=<%=requestTypeParam%>&amp;Stage=<%=stageParam%>&amp;Risk=High'>High</a>
								</div>
						</div>
				</div>
		</div>

		<div class='ops-kpi-grid'>
				<div class='zcs-card zcs-p-20'>
						<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
								<span class='zcs-font-13 zcs-color-tertiary'>Filtered requests</span>
								<i class='ops-kpi-icon zc-li-outline files-single-folded-content'></i>
						</div>
						<div class='ops-kpi-value'><%=filteredRequestCount%></div>
				</div>
				<div class='zcs-card zcs-p-20'>
						<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
								<span class='zcs-font-13 zcs-color-tertiary'>Open requests</span>
								<i class='ops-kpi-icon zc-li-outline loader-dots-06'></i>
						</div>
						<div class='ops-kpi-value'><%=openRequestCount%></div>
				</div>
				<div class='zcs-card zcs-p-20'>
						<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
								<span class='zcs-font-13 zcs-color-tertiary'>High-risk pending</span>
								<i class='ops-kpi-icon zc-li-outline ui-2-time'></i>
						</div>
						<div class='ops-kpi-value'><%=highRiskPendingCount%></div>
				</div>
				<div class='zcs-card zcs-p-20'>
						<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
								<span class='zcs-font-13 zcs-color-tertiary'>Completed</span>
								<i class='ops-kpi-icon zc-li-outline ui-1-check-circle-08'></i>
						</div>
						<div class='ops-kpi-value'><%=completedRequestCount%></div>
				</div>
		</div>

		<div class='ops-content-grid'>
				<section class='zcs-card zcs-p-20 ops-span-4'>
						<div class='ops-section-header'>
								<h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Stage queue counts</h2>
						</div>
						<div class='ops-stage-list'>
								<div class='ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between'>
										<span class='zcs-font-14'>Data check</span>
										<strong><%=submittedCount%></strong>
								</div>
								<div class='ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between'>
										<span class='zcs-font-14'>Procurement review</span>
										<strong><%=procurementCount%></strong>
								</div>
								<div class='ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between'>
										<span class='zcs-font-14'>Finance callback</span>
										<strong><%=callbackCount%></strong>
								</div>
								<div class='ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between'>
										<span class='zcs-font-14'>Compliance review</span>
										<strong><%=complianceCount%></strong>
								</div>
								<div class='ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between'>
										<span class='zcs-font-14'>Finance approval</span>
										<strong><%=financeCount%></strong>
								</div>
								<div class='ops-stage-row zcs-flex zcs-align-items-center zcs-justify-space-between'>
										<span class='zcs-font-14'>MDM processing</span>
										<strong><%=mdmCount%></strong>
								</div>
						</div>
				</section>

				<section class='zcs-card zcs-p-20 ops-span-4'>
						<div class='ops-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
								<h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>High-risk pending work</h2>
								<a class='zcs-font-13 zcs-color-theme' href='#Report:High_Risk_Bank_Requests'>Open report</a>
						</div>
						<%
						highRiskDisplayCount = 0;
						for each highRiskItem in highRiskCandidates
						{
								showHighRisk = true;
								if(highRiskItem.Added_Time < startDate)
								{
										showHighRisk = false;
								}
								if(highRiskItem.Current_Stage == "Draft")
								{
										showHighRisk = false;
								}
								if(highRiskItem.Current_Stage == "Completed")
								{
										showHighRisk = false;
								}
								if(highRiskItem.Current_Stage == "Rejected")
								{
										showHighRisk = false;
								}
								if(requestType != "All" && highRiskItem.Request_Type != requestType)
								{
										showHighRisk = false;
								}
								if(stageFilter != "All" && highRiskItem.Current_Stage != stageFilter)
								{
										showHighRisk = false;
								}
								if(riskFilter != "All" && highRiskItem.Risk_Level != riskFilter)
								{
										showHighRisk = false;
								}
								if(showHighRisk && highRiskDisplayCount < 5)
								{
										highRiskAge = 0;
										if(highRiskItem.Stage_Entered_At != null)
										{
												highRiskAge = highRiskItem.Stage_Entered_At.daysBetween(zoho.currenttime);
										}
						%>
						<div class='ops-work-row zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12'>
								<div>
										<strong class='zcs-font-14 zcs-color-primary'>Request <%=highRiskItem.Request_Number%></strong>
										<div class='zcs-font-12 zcs-color-tertiary'><%=highRiskItem.Request_Type%> | <%=highRiskItem.Current_Stage%></div>
								</div>
								<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-4 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red'>
										<i class='zc-li-outline ui-2-time'></i>
										<span class='zcs-font-12'><%=highRiskAge%> days</span>
								</div>
						</div>
						<%
										highRiskDisplayCount = highRiskDisplayCount + 1;
								}
						}
						if(highRiskDisplayCount == 0)
						{
						%>
						<div class='zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
								<div class='zcs-nodata-content zcs-p-20'>
										<h5 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'>No matching high-risk pending work</h5>
								</div>
						</div>
						<%
						}
						%>
				</section>

				<section class='zcs-card zcs-p-20 ops-span-4'>
						<div class='ops-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
								<h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Oldest pending requests</h2>
								<a class='zcs-font-13 zcs-color-theme' href='#Report:Open_Request_Queue'>Open queue</a>
						</div>
						<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
								<table class='zcs-w-full'>
										<thead class='zcs-sticky'>
												<tr>
														<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium'>Request</th>
														<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium'>Stage</th>
														<th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13 zcs-font-medium'>Age</th>
												</tr>
										</thead>
										<tbody>
										<%
										oldestDisplayCount = 0;
										for each pendingItem in oldestCandidates
										{
												showPending = true;
												if(pendingItem.Added_Time < startDate)
												{
														showPending = false;
												}
												if(pendingItem.Stage_Entered_At == null)
												{
														showPending = false;
												}
												if(pendingItem.Current_Stage == "Completed")
												{
														showPending = false;
												}
												if(pendingItem.Current_Stage == "Rejected")
												{
														showPending = false;
												}
												if(requestType != "All" && pendingItem.Request_Type != requestType)
												{
														showPending = false;
												}
												if(stageFilter != "All" && pendingItem.Current_Stage != stageFilter)
												{
														showPending = false;
												}
												if(riskFilter != "All" && pendingItem.Risk_Level != riskFilter)
												{
														showPending = false;
												}
												if(showPending && oldestDisplayCount < 6)
												{
														pendingAge = pendingItem.Stage_Entered_At.daysBetween(zoho.currenttime);
										%>
												<tr>
														<td class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'><a class='zcs-color-theme' href='#Report:Open_Request_Queue?ID=<%=pendingItem.ID%>'><%=pendingItem.Request_Number%></a></td>
														<td class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-13'><%=pendingItem.Current_Stage%></td>
														<td class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-13'><%=pendingAge%>d</td>
												</tr>
										<%
														oldestDisplayCount = oldestDisplayCount + 1;
												}
										}
										%>
										</tbody>
								</table>
						</div>
						<%
						if(oldestDisplayCount == 0)
						{
						%>
						<div class='ops-empty'>No matching pending requests.</div>
						<%
						}
						%>
				</section>

				<section class='zcs-card zcs-p-20 ops-span-12'>
						<div class='ops-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
								<h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Recent approval activity</h2>
								<a class='zcs-font-13 zcs-color-theme' href='#Report:Request_Approval_History'>View history</a>
						</div>
						<div class='zcs-timeline-wrapper'>
								<ul class='zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0'>
								<%
								activityDisplayCount = 0;
								for each activityItem in recentActivities
								{
										showActivity = true;
										if(requestType != "All" && activityItem.Vendor_Request.Request_Type != requestType)
										{
												showActivity = false;
										}
										if(stageFilter != "All" && activityItem.Stage != stageFilter)
										{
												showActivity = false;
										}
										if(riskFilter != "All" && activityItem.Vendor_Request.Risk_Level != riskFilter)
										{
												showActivity = false;
										}
										if(showActivity && activityDisplayCount < 6)
										{
								%>
										<li class='zcs-tl-li zcs-flex zcs-direction-column zcs-gap-4 zcs-relative'>
												<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
														<strong class='zcs-font-14 zcs-color-primary'><%=activityItem.Decision%> at <%=activityItem.Stage%></strong>
														<span class='zcs-font-12 zcs-color-tertiary'><%=activityItem.Decision_At%></span>
												</div>
												<div class='zcs-font-13 zcs-color-secondary'>Request <%=activityItem.Vendor_Request.Request_Number%> | Actor profile: <%=activityItem.Actor_Profile%></div>
										</li>
								<%
												activityDisplayCount = activityDisplayCount + 1;
										}
								}
								%>
								</ul>
						</div>
						<%
						if(activityDisplayCount == 0)
						{
						%>
						<div class='ops-empty'>No matching approval activity in this date range.</div>
						<%
						}
						%>
				</section>
		</div>
</div>