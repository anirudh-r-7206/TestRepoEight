report All_Clients
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Client_Name
                    Company
                    Hourly_Rate
                    Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Client_Name
                    Company
                    Hourly_Rate
                    Email
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
