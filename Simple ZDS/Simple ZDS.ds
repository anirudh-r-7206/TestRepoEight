application "Simple-ZDS"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Tasks
		{
		    success message = "Task saved successfully."
		
		    Task_Details
		    (
		        type = section
		        displayname = "Task Details"
		        row = 1
		        column = 0
		    )
		    must have Title
		    (
		        type = text
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Priority
		    (
		        type = picklist
		        values = {"Low", "Medium", "High"}
		        initial value = "Medium"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"To Do", "In Progress", "Completed"}
		        initial value = "To Do"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Completed
		    (
		        type = checkbox
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Task"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Task"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Tasks
		{
		    displayName = "All Tasks"
		    show all rows from Tasks
		    (
		        Title
		        Priority
		        Due_Date
		        Status
		        Completed
		    )
		    filters
		    (
		        Priority
		        Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		kanban Task_Board
		{
		    displayName = "Task Board"
		    show all rows from Tasks
		    (
		        Title
		        Priority
		        Due_Date
		        Status
		        Completed
		    )
		    filters
		    (
		        Priority
		        Status
		    )
		    options
		    (
		        display field = Status
		        sort order = custom
		        record count = enable
		    )
		}

		calendar Task_Calendar
		{
		    displayName = "Task Calendar"
		    show all rows from Tasks
		    (
		        Title
		        Priority
		        Due_Date
		        Status
		    )
		    filters
		    (
		        Priority
		        Status
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Title
		        start date = Due_Date
		    )
		}
	}

	web
	{
	forms
	{
	    form Tasks
	    {
	        label placement = left
	    }
	}
	reports
	{
		report All_Tasks
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Title
		                    Priority
		                    Due_Date
		                    Status
		                    Completed
		                )
		            )
		        )
		        menu
		        (
		            header ( Edit  Duplicate  Delete )
		            record ( Edit  Duplicate  Delete )
		        )
		        action
		        (
		            on click ( View Record )
		            on right click ( Edit  Delete  Duplicate  View Record )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Title
		                    Priority
		                    Due_Date
		                    Status
		                    Completed
		                )
		            )
		        )
		        menu
		        (
		            header ( Edit  Duplicate  Delete )
		        )
		    )
		}
	
		report Task_Board
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Title
		                    Priority
		                    Due_Date
		                    Status
		                    Completed
		                )
		            )
		        )
		        menu
		        (
		            header ( Edit  Duplicate  Delete )
		            record ( Edit  Duplicate  Delete )
		        )
		        action
		        (
		            on click ( View Record )
		            on right click ( Edit  Delete  Duplicate  View Record )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Title
		                    Priority
		                    Due_Date
		                    Status
		                    Completed
		                )
		            )
		        )
		        menu
		        (
		            header ( Edit  Duplicate  Delete )
		        )
		    )
		}
	
		report Task_Calendar
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Title
		                    Priority
		                    Due_Date
		                    Status
		                )
		            )
		        )
		        menu
		        (
		            header ( Edit  Duplicate  Delete )
		            record ( Edit  Duplicate  Delete )
		        )
		        action
		        (
		            on click ( View Record )
		            on right click ( Edit  Delete  Duplicate  View Record )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Title
		                    Priority
		                    Due_Date
		                    Status
		                )
		            )
		        )
		        menu
		        (
		            header ( Edit  Duplicate  Delete )
		        )
		    )
		}
	}
	menu
	{
	    space To_Do_Space
	    {
	        displayname = "To Do"
	        icon = "business-agenda"
	
	        section Tasks_Section
	        {
	            displayname = "Tasks"
	            icon = "files-check"
	
	            form Tasks
	            {
	                icon = "files-add"
	            }
	            report All_Tasks
	            {
	                icon = "files-check"
	            }
	            report Task_Board
	            {
	                icon = "business-board-27"
	            }
	            report Task_Calendar
	            {
	                icon = "business-agenda"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    font = "lato"
	
	    color options
	    {
	        color = "1"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	}
	}
}
