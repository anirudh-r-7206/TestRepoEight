form Students
{
    Student_Details
    (
        type = section
        displayname = "Student Details"
        row = 1
        column = 0
    )
    must have Student_Name
    (
        type = text
        displayname = "Student Name"
        row = 1
        column = 1
        width = medium
    )
    must have Age
    (
        type = number
        row = 1
        column = 1
        width = medium
        width = medium
    )
    Gender
    (
        type = picklist
        displayname = "Gender"
        values = {"Female", "Male", "Non-binary", "Prefer not to say"}
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
