<%
  allTasks = Tasks[ID != 0];
  totalCount = allTasks.count();
  notStartedCount = Tasks[Status == "Not Started"].count();
  inProgressCount = Tasks[Status == "In Progress"].count();
  completedCount = Tasks[Status == "Completed"].count();
  overdueTasks = Tasks[Due_Date != null && Due_Date < zoho.currentdate && Status != "Completed"] sort by Due_Date asc;
  overdueCount = overdueTasks.count();
  lowCount = Tasks[Priority == "Low"].count();
  mediumCount = Tasks[Priority == "Medium"].count();
  highCount = Tasks[Priority == "High"].count();
  upcomingTasks = Tasks[Due_Date != null && Due_Date >= zoho.currentdate && Status != "Completed"] sort by Due_Date asc range from 1 to 5;
  completionPercent = 0;
  notStartedPercent = 0;
  inProgressPercent = 0;
  completedPercent = 0;
  lowPercent = 0;
  mediumPercent = 0;
  highPercent = 0;
  if(totalCount > 0)
  {
    completionPercent = (completedCount * 100.0 / totalCount).round(0);
    notStartedPercent = (notStartedCount * 100.0 / totalCount).round(0);
    inProgressPercent = (inProgressCount * 100.0 / totalCount).round(0);
    completedPercent = (completedCount * 100.0 / totalCount).round(0);
    lowPercent = (lowCount * 100.0 / totalCount).round(0);
    mediumPercent = (mediumCount * 100.0 / totalCount).round(0);
    highPercent = (highCount * 100.0 / totalCount).round(0);
  }
%>
<style>
/* zcs-global.css: page-scoped utility subset used by this dashboard. */
:root {
  --zcs-theme-brand-color: var(--zcs_brand_color);
  --zcs-light-bg-color: var(--zcs_brand_light_color);
  --zcs-page-bg-color: #f3f3f4;
  --zcs-primary-text-color: var(--zcs_primary_text_color);
  --zcs-secondary-text-color: var(--zcs_secondary_text_color);
  --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
  --zcs-border-color: var(--zcs_tertiary_border_color);
  --zcs-white-color: #fff;
  --zcs-bg: var(--zcs-page-bg-color);
  --zcs-surface: var(--zcs-white-color);
  --zcs-text-1: var(--zcs-primary-text-color);
  --zcs-text-2: var(--zcs-secondary-text-color);
  --zcs-text-3: var(--zcs-teritiary-text-color);
  --zcs-border: var(--zcs-border-color);
  --zcs-radius: 12px;
  --zcs-shadow: 0 1px 3px rgba(18,19,43,.08);
  --zcs-font: Arial, sans-serif;
  --zcs-green: #179e6c;
  --zcs-green-bg: #e8f7f1;
  --zcs-red: #d9364f;
  --zcs-red-bg: #fff0f2;
  --zcs-orange: #a96500;
  --zcs-orange-bg: #fff4df;
  --zcs-blue: #09598e;
  --zcs-blue-bg: #eaf5fb;
  --zcs-thead-color: #f9fafe;
  --zcs-tr-h-color: #f9fafe;
}
.zcs-flex{display:flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-w-full{width:100%}.zcs-p-2{padding:.125rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-medium{font-weight:500}.zcs-font-normal{font-weight:400}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-blue{color:#09598e}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#d9364f}.zcs-color-yellow{color:#a96500}.zcs-rounded-sm{border-radius:.25rem}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}
.zcs-page{font-family:var(--zcs-font);background:var(--zcs-bg);min-height:100vh;padding:24px;box-sizing:border-box;color:var(--zcs-text-1)}
.zcs-page-header{margin-bottom:24px}.zcs-page-header__title{font-size:22px;font-weight:600;color:var(--zcs-text-1);margin:0 0 4px}.zcs-page-header__sub{font-size:14px;color:var(--zcs-text-2);margin:0}
.zcs-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin-bottom:24px}.zcs-kpi-card{background:var(--zcs-surface);border-radius:var(--zcs-radius);box-shadow:var(--zcs-shadow);padding:20px 24px;border:1px solid var(--zcs-border)}.zcs-kpi-card__label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--zcs-text-2);display:flex;align-items:center;gap:7px}.zcs-kpi-card__value{font-size:32px;font-weight:700;margin:6px 0 4px;line-height:1}.zcs-kpi-card__sub{font-size:12px;color:var(--zcs-text-3)}
.zcs-section{background:var(--zcs-surface);border-radius:var(--zcs-radius);box-shadow:var(--zcs-shadow);padding:20px 24px;margin-bottom:16px;border:1px solid var(--zcs-border)}.zcs-section__heading{font-size:15px;font-weight:600;color:var(--zcs-text-1);margin:0 0 14px;display:flex;align-items:center;gap:8px}.zcs-stat-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--zcs-border);font-size:14px;color:var(--zcs-text-1)}.zcs-stat-row:last-child{border-bottom:none}
.zcs-badge{display:inline-block;font-size:12px;font-weight:600;padding:3px 10px;border-radius:20px;line-height:1.4}.zcs-badge--success{background:var(--zcs-green-bg);color:var(--zcs-green)}.zcs-badge--danger{background:var(--zcs-red-bg);color:var(--zcs-red)}.zcs-badge--warning{background:var(--zcs-orange-bg);color:var(--zcs-orange)}.zcs-badge--info{background:var(--zcs-blue-bg);color:var(--zcs-blue)}.zcs-badge--neutral{background:#f3f4f6;color:var(--zcs-text-2)}
.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color,#e8e9ee);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}
.zcs-empty-state{text-align:center;padding:40px 24px}.zcs-empty-state__title{font-size:16px;font-weight:600;color:var(--zcs-text-2);margin:8px 0 6px}.zcs-empty-state__body{font-size:14px;color:var(--zcs-text-3)}
.dashboard-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.dashboard-grid--wide{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}.metric-icon{color:var(--zcs_brand_color);font-size:16px}.danger-icon{color:var(--zcs-red)}.distribution-row{margin-bottom:14px}.distribution-row:last-child{margin-bottom:0}.task-name{font-weight:600;max-width:360px;overflow-wrap:anywhere}.task-meta{white-space:nowrap}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:900px){.dashboard-grid,.dashboard-grid--wide{grid-template-columns:1fr}}@media(max-width:576px){.zcs-page{padding:14px}.zcs-kpi-grid{grid-template-columns:1fr 1fr;gap:10px}.zcs-kpi-card{padding:16px}.zcs-section{padding:16px}.zcs-kpi-card__value{font-size:26px}}@media(max-width:390px){.zcs-kpi-grid{grid-template-columns:1fr}}
</style>
<div class="zcs-page">
  <header class="zcs-page-header">
    <h1 class="zcs-page-header__title">Task Dashboard</h1>
    <p class="zcs-page-header__sub">Your workload at a glance, updated for <%=zoho.currentdate.toString("dd MMM yyyy")%>.</p>
  </header>

  <section class="zcs-kpi-grid" aria-label="Task totals">
    <div class="zcs-kpi-card"><div class="zcs-kpi-card__label"><i class="zc-li-outline files-folder-15 metric-icon" aria-hidden="true"></i>Total tasks</div><div class="zcs-kpi-card__value zcs-color-blue"><%=totalCount%></div><div class="zcs-kpi-card__sub">All tracked work</div></div>
    <div class="zcs-kpi-card"><div class="zcs-kpi-card__label"><i class="zc-li-outline ui-2-time metric-icon" aria-hidden="true"></i>Not started</div><div class="zcs-kpi-card__value zcs-color-secondary"><%=notStartedCount%></div><div class="zcs-kpi-card__sub">Waiting to begin</div></div>
    <div class="zcs-kpi-card"><div class="zcs-kpi-card__label"><i class="zc-li-outline arrows-1-refresh-69 metric-icon" aria-hidden="true"></i>In progress</div><div class="zcs-kpi-card__value zcs-color-yellow"><%=inProgressCount%></div><div class="zcs-kpi-card__sub">Currently active</div></div>
    <div class="zcs-kpi-card"><div class="zcs-kpi-card__label"><i class="zc-li-outline ui-1-check-circle-08 metric-icon" aria-hidden="true"></i>Completed</div><div class="zcs-kpi-card__value zcs-color-green"><%=completedCount%></div><div class="zcs-kpi-card__sub">Finished tasks</div></div>
    <div class="zcs-kpi-card"><div class="zcs-kpi-card__label"><i class="zc-li-outline ui-1-alert-circle danger-icon" aria-hidden="true"></i>Overdue</div><div class="zcs-kpi-card__value zcs-color-red"><%=overdueCount%></div><div class="zcs-kpi-card__sub">Needs attention</div></div>
  </section>

  <div class="zcs-section" aria-labelledby="completion-heading">
    <h2 class="zcs-section__heading" id="completion-heading"><i class="zc-li-outline ui-1-check-square-11 metric-icon" aria-hidden="true"></i>Completion progress</h2>
    <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6">
      <div class="zcs-progress-bar zcs-rounded-sm" role="progressbar" aria-label="Task completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%=completionPercent%>"><div class="zcs-progress-bar-indicator" style="width:<%=completionPercent%>%;"></div></div>
      <p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-primary"><%=completedCount%> of <%=totalCount%> tasks completed</span><span class="zcs-color-primary"><%=completionPercent%>%</span></p>
    </div>
  </div>

  <div class="dashboard-grid">
    <section class="zcs-section" aria-labelledby="status-heading"><h2 class="zcs-section__heading" id="status-heading"><i class="zc-li-outline design-shape-circle metric-icon" aria-hidden="true"></i>Status distribution</h2>
      <div class="distribution-row"><div class="zcs-stat-row"><span>Not Started</span><span class="zcs-badge zcs-badge--neutral"><%=notStartedCount%></span></div><div class="zcs-progress-bar zcs-rounded-sm" aria-hidden="true"><div class="zcs-progress-bar-indicator" style="width:<%=notStartedPercent%>%;"></div></div></div>
      <div class="distribution-row"><div class="zcs-stat-row"><span>In Progress</span><span class="zcs-badge zcs-badge--warning"><%=inProgressCount%></span></div><div class="zcs-progress-bar zcs-rounded-sm" aria-hidden="true"><div class="zcs-progress-bar-indicator" style="width:<%=inProgressPercent%>%;"></div></div></div>
      <div class="distribution-row"><div class="zcs-stat-row"><span>Completed</span><span class="zcs-badge zcs-badge--success"><%=completedCount%></span></div><div class="zcs-progress-bar zcs-rounded-sm" aria-hidden="true"><div class="zcs-progress-bar-indicator" style="width:<%=completedPercent%>%;"></div></div></div>
    </section>
    <section class="zcs-section" aria-labelledby="priority-heading"><h2 class="zcs-section__heading" id="priority-heading"><i class="zc-li-outline ui-2-flag metric-icon" aria-hidden="true"></i>Priority distribution</h2>
      <div class="distribution-row"><div class="zcs-stat-row"><span>High</span><span class="zcs-badge zcs-badge--danger"><%=highCount%></span></div><div class="zcs-progress-bar zcs-rounded-sm" aria-hidden="true"><div class="zcs-progress-bar-indicator" style="width:<%=highPercent%>%;"></div></div></div>
      <div class="distribution-row"><div class="zcs-stat-row"><span>Medium</span><span class="zcs-badge zcs-badge--warning"><%=mediumCount%></span></div><div class="zcs-progress-bar zcs-rounded-sm" aria-hidden="true"><div class="zcs-progress-bar-indicator" style="width:<%=mediumPercent%>%;"></div></div></div>
      <div class="distribution-row"><div class="zcs-stat-row"><span>Low</span><span class="zcs-badge zcs-badge--info"><%=lowCount%></span></div><div class="zcs-progress-bar zcs-rounded-sm" aria-hidden="true"><div class="zcs-progress-bar-indicator" style="width:<%=lowPercent%>%;"></div></div></div>
    </section>
  </div>

  <div class="dashboard-grid dashboard-grid--wide">
    <section class="zcs-section" aria-labelledby="overdue-heading"><h2 class="zcs-section__heading" id="overdue-heading"><i class="zc-li-outline ui-1-alert-circle danger-icon" aria-hidden="true"></i>Overdue tasks</h2>
    <% if(overdueCount == 0) { %><div class="zcs-empty-state"><i class="zc-li-outline ui-1-check-circle-08 zcs-color-green" aria-hidden="true"></i><div class="zcs-empty-state__title">No overdue tasks</div><div class="zcs-empty-state__body">Everything with a due date is on track.</div></div><% } else { %>
      <div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full"><caption class="sr-only">Tasks overdue before today</caption><thead class="zcs-sticky"><tr><th scope="col" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Task</th><th scope="col" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Due</th><th scope="col" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Priority</th></tr><tr class="zcs-tspace"><th class="zcs-p-2" colspan="3"></th></tr></thead><tbody>
      <% for each task in overdueTasks { taskName = ifnull(task.Task_Name,"Untitled task").toString().replaceAll("&","&amp;",true).replaceAll("<","&lt;",true).replaceAll(">","&gt;",true); taskPriority = ifnull(task.Priority,"Unspecified").toString().replaceAll("&","&amp;",true).replaceAll("<","&lt;",true).replaceAll(">","&gt;",true); %><tr><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary task-name"><%=taskName%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-red task-meta"><%=task.Due_Date.toString("dd MMM yyyy")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="zcs-badge zcs-badge--danger"><%=taskPriority%></span></td></tr><% } %>
      </tbody></table></div><% } %>
    </section>

    <section class="zcs-section" aria-labelledby="upcoming-heading"><h2 class="zcs-section__heading" id="upcoming-heading"><i class="zc-li-outline ui-1-calendar-57 metric-icon" aria-hidden="true"></i>Upcoming due work</h2>
    <% if(upcomingTasks.count() == 0) { %><div class="zcs-empty-state"><i class="zc-li-outline ui-1-calendar-57 zcs-color-blue" aria-hidden="true"></i><div class="zcs-empty-state__title">No upcoming tasks</div><div class="zcs-empty-state__body">There are no incomplete tasks with a future due date.</div></div><% } else { %>
      <div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full"><caption class="sr-only">Next five incomplete tasks ordered by due date</caption><thead class="zcs-sticky"><tr><th scope="col" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Task</th><th scope="col" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Due</th><th scope="col" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th></tr><tr class="zcs-tspace"><th class="zcs-p-2" colspan="3"></th></tr></thead><tbody>
      <% for each task in upcomingTasks { taskName = ifnull(task.Task_Name,"Untitled task").toString().replaceAll("&","&amp;",true).replaceAll("<","&lt;",true).replaceAll(">","&gt;",true); taskStatus = ifnull(task.Status,"Not Started").toString().replaceAll("&","&amp;",true).replaceAll("<","&lt;",true).replaceAll(">","&gt;",true); statusClass = "zcs-badge--neutral"; if(task.Status == "In Progress") { statusClass = "zcs-badge--warning"; } %><tr><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary task-name"><%=taskName%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary task-meta"><%=task.Due_Date.toString("dd MMM yyyy")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="zcs-badge <%=statusClass%>"><%=taskStatus%></span></td></tr><% } %>
      </tbody></table></div><% } %>
    </section>
  </div>
</div>