form Tasks
{
    title
    {
        displayname = "Tasks"
        on add = "Add Task"
        on edit = "Edit Task"
    }
    success message = "Task saved."

    Task_Details
    (
        type = section
        displayname = "Task Details"
        row = 1
        column = 0
    )
    must have Task_Name
    (
        type = text
        displayname = "Task Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        values = {"Not Started", "In Progress", "Completed"}
        initial value = "Not Started"
        row = 1
        column = 1
        width = medium
    )
    must have Priority
    (
        type = picklist
        values = {"Low", "Medium", "High"}
        initial value = "Medium"
        row = 1
        column = 2
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )
    Category
    (
        type = text
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    Completed
    (
        type = checkbox
        initial value = false
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Task"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Task"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}