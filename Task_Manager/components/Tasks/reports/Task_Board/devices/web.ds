report Task_Board
{
    quickview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -1
                fields
                (
                    Task_Name
                    Status
                    Priority
                    Due_Date
                    Category
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                title = "Task Details"
                fields
                (
                    Task_Name
                    Status
                    Priority
                    Due_Date
                    Category
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}