Tasks_On_Load as "Tasks On Load"
{
    type = form
    form = Tasks
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                shouldBeCompleted = input.Status == "Completed";
                if (input.Completed != shouldBeCompleted)
                {
                    input.Completed = shouldBeCompleted;
                }
            )
        }
    }
}