form Students
{
    success message = "Student was saved successfully."
    Personal_Information
    (
        type = section
        displayname = "Personal Information"
        row = 1
        column = 0
    )
    must have Student_Name
    (
        type = text
        displayname = "Student Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Age
    (
        type = number
        maxchar = 3
        row = 1
        column = 2
        width = medium
    )
    must have Gender
    (
        type = radiobuttons
        values = {"Male", "Female", "Non-binary", "Prefer not to say"}
        layout = 2
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
