application "customapitw"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Students
		{
		    success message = "Student was saved successfully."
		    Personal_Information
		    (
		        type = section
		        displayname = "Personal Information"
		        row = 1
		        column = 0
		    )
		    must have Student_Name
		    (
		        type = text
		        displayname = "Student Name"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Age
		    (
		        type = number
		        maxchar = 3
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Gender
		    (
		        type = radiobuttons
		        values = {"Male", "Female", "Non-binary", "Prefer not to say"}
		        layout = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Students
		{
		    displayName = "All Students"
		    show all rows from Students
		    (
		        Student_Name
		        Age
		        Gender
		    )
		    filters
		    (
		        Gender
		    )
		    sort by
		    (
		        Student_Name ascending
		    )
		}
	}

	functions
	{
		Deluge
		{
			void Hello()
			{
				info "Hello";
			}
		}
	}

	web
	{
	forms
	{
	    form Students
	    {
	        label placement = left
	    }
	}
	reports
	{
		report All_Students
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Student_Name
		                    Age
		                    Gender
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Student_Name
		                    Age
		                    Gender
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	}
	menu
	{
	    space Student_Registry_Space
	    {
	        displayname = "Student Registry"
	        icon = "education-school"
	
	        section Students_Section
	        {
	            displayname = "Students"
	            icon = "education-school"
	
	            form Students
	            {
	                icon = "education-pencil-47"
	            }
	            report All_Students
	            {
	                icon = "education-books-46"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = space,section,component
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        name = "Academic Blue"
	        brand color = "#2563EB"
	        type = "custom"
	        dark mode color = "#60A5FA"
	    }
	}
	}
}
