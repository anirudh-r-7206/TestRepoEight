<%
openCount = Tasks[Status != "Done"].count();
dueTodayCount = Tasks[Status != "Done" && Due_Date == zoho.currentdate].count();
overdueCount = Tasks[Status != "Done" && Due_Date < zoho.currentdate].count();
completedCount = Tasks[Status == "Done"].count();
todoCount = Tasks[Status == "To Do"].count();
inProgressCount = Tasks[Status == "In Progress"].count();
doneCount = Tasks[Status == "Done"].count();
lowCount = Tasks[Priority == "Low"].count();
mediumCount = Tasks[Priority == "Medium"].count();
highCount = Tasks[Priority == "High"].count();
upcomingTasks = Tasks[Status != "Done" && Due_Date >= zoho.currentdate] sort by Due_Date asc;
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;--zcs-text-1:var(--zcs_primary_text_color);--zcs-text-2:var(--zcs_secondary_text_color);--zcs-text-3:var(--zcs_tertiary_text_color);--zcs-border:var(--zcs_tertiary_border_color);--zcs-surface:#fff;--zcs-bg:#f5f6f8;--zcs-radius:12px;--zcs-shadow:0 2px 10px rgba(18,19,43,.07);--zcs-green:#168a62;--zcs-green-bg:#e8f7f1;--zcs-red:#c83f52;--zcs-red-bg:#fdecef;--zcs-orange:#a86100;--zcs-orange-bg:#fff3dd;--zcs-blue:#14689b;--zcs-blue-bg:#e9f4fb}.zcs-w-full{width:100%}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-p-2{padding:.125rem}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-font-14{font-size:.875rem}.zcs-font-medium{font-weight:500}.zcs-font-normal{font-weight:400}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-rounded-sm{border-radius:.25rem}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-color-blue{color:#09598e}.zcs-color-red{color:#c83f52}.zcs-color-green{color:#168a62}.zcs-color-yellow{color:#a86100}
.zcs-page{font-family:var(--zcs-font);background:var(--zcs-bg);min-height:100vh;padding:24px;box-sizing:border-box}.zcs-page-header{margin-bottom:24px}.zcs-page-header__title{font-size:22px;font-weight:600;color:var(--zcs-text-1);margin:0 0 4px}.zcs-page-header__sub{font-size:14px;color:var(--zcs-text-2);margin:0}.zcs-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin-bottom:24px}.zcs-kpi-card{background:var(--zcs-surface);border-radius:var(--zcs-radius);box-shadow:var(--zcs-shadow);padding:20px 24px;border-top:3px solid var(--kpi-accent,var(--zcs-theme-brand-color))}.zcs-kpi-card__label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--zcs-text-2);display:flex;align-items:center;gap:7px}.zcs-kpi-card__value{font-size:32px;font-weight:700;margin:8px 0 4px;line-height:1}.zcs-kpi-card__sub{font-size:12px;color:var(--zcs-text-3)}.zcs-section{background:var(--zcs-surface);border-radius:var(--zcs-radius);box-shadow:var(--zcs-shadow);padding:20px 24px;margin-bottom:16px}.zcs-section__heading{font-size:15px;font-weight:600;color:var(--zcs-text-1);margin:0 0 14px;display:flex;align-items:center;gap:8px}.zcs-stat-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--zcs-border);font-size:14px;color:var(--zcs-text-1)}.zcs-stat-row:last-child{border-bottom:none}.zcs-badge{display:inline-block;font-size:12px;font-weight:600;padding:3px 10px;border-radius:20px;line-height:1.4;white-space:nowrap}.zcs-badge--success{background:var(--zcs-green-bg);color:var(--zcs-green)}.zcs-badge--danger{background:var(--zcs-red-bg);color:var(--zcs-red)}.zcs-badge--warning{background:var(--zcs-orange-bg);color:var(--zcs-orange)}.zcs-badge--info{background:var(--zcs-blue-bg);color:var(--zcs-blue)}.zcs-badge--neutral{background:#f3f4f6;color:var(--zcs-text-2)}.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:8px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:650px}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#f9fafe}.task-name{font-weight:600}.empty-row{text-align:center!important;color:var(--zcs-text-2)!important;padding:28px!important}.due-overdue{color:var(--zcs-red);font-weight:600}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.section-note{font-size:12px;color:var(--zcs-text-3);font-weight:400}@media(max-width:760px){.zcs-page{padding:16px}.summary-grid{grid-template-columns:1fr}.zcs-kpi-grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.zcs-kpi-grid{grid-template-columns:1fr}}
</style>
<div class="zcs-page">
  <div class="zcs-page-header">
    <h1 class="zcs-page-header__title">To-Do Overview</h1>
    <p class="zcs-page-header__sub">A focused view of workload, urgency, and upcoming tasks.</p>
  </div>
  <div class="zcs-kpi-grid">
    <div class="zcs-kpi-card" style="--kpi-accent:var(--zcs-blue)"><div class="zcs-kpi-card__label"><i class="zc-li-outline ui-1-list-bullet"></i>Total open tasks</div><div class="zcs-kpi-card__value zcs-color-blue"><%=openCount%></div><div class="zcs-kpi-card__sub">To Do and In Progress</div></div>
    <div class="zcs-kpi-card" style="--kpi-accent:var(--zcs-orange)"><div class="zcs-kpi-card__label"><i class="zc-li-outline ui-2-time"></i>Due today</div><div class="zcs-kpi-card__value zcs-color-yellow"><%=dueTodayCount%></div><div class="zcs-kpi-card__sub"><%=zoho.currentdate.toString("dd MMM yyyy")%></div></div>
    <div class="zcs-kpi-card" style="--kpi-accent:var(--zcs-red)"><div class="zcs-kpi-card__label"><i class="zc-li-outline ui-1-alert-circle"></i>Overdue</div><div class="zcs-kpi-card__value zcs-color-red"><%=overdueCount%></div><div class="zcs-kpi-card__sub">Open tasks past due</div></div>
    <div class="zcs-kpi-card" style="--kpi-accent:var(--zcs-green)"><div class="zcs-kpi-card__label"><i class="zc-li-outline ui-1-check-circle-08"></i>Completed</div><div class="zcs-kpi-card__value zcs-color-green"><%=completedCount%></div><div class="zcs-kpi-card__sub">Tasks marked Done</div></div>
  </div>
  <div class="summary-grid">
    <div class="zcs-section"><h2 class="zcs-section__heading"><i class="zc-li-outline ui-1-chart-bar-32"></i>Status summary</h2><div class="zcs-stat-row"><span>To Do</span><span class="zcs-badge zcs-badge--neutral"><%=todoCount%></span></div><div class="zcs-stat-row"><span>In Progress</span><span class="zcs-badge zcs-badge--info"><%=inProgressCount%></span></div><div class="zcs-stat-row"><span>Done</span><span class="zcs-badge zcs-badge--success"><%=doneCount%></span></div></div>
    <div class="zcs-section"><h2 class="zcs-section__heading"><i class="zc-li-outline ui-1-flag"></i>Priority summary</h2><div class="zcs-stat-row"><span>Low</span><span class="zcs-badge zcs-badge--success"><%=lowCount%></span></div><div class="zcs-stat-row"><span>Medium</span><span class="zcs-badge zcs-badge--warning"><%=mediumCount%></span></div><div class="zcs-stat-row"><span>High</span><span class="zcs-badge zcs-badge--danger"><%=highCount%></span></div></div>
  </div>
  <div class="zcs-section">
    <div class="section-head"><h2 class="zcs-section__heading"><i class="zc-li-outline ui-1-calendar-60"></i>Upcoming work</h2><span class="section-note">Next 8 open tasks by due date</span></div>
    <div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative"><table class="zcs-w-full"><thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Task</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Due date</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Priority</th></tr></thead><tbody>
<%
rowCount = 0;
for each task in upcomingTasks
{
  if(rowCount < 8)
  {
    statusClass = "zcs-badge--neutral";
    if(task.Status == "In Progress") { statusClass = "zcs-badge--info"; }
    if(task.Status == "Done") { statusClass = "zcs-badge--success"; }
    priorityClass = "zcs-badge--success";
    if(task.Priority == "Medium") { priorityClass = "zcs-badge--warning"; }
    if(task.Priority == "High") { priorityClass = "zcs-badge--danger"; }
    dueClass = "";
    if(task.Due_Date < zoho.currentdate) { dueClass = "due-overdue"; }
%>
      <tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-lh-body zcs-color-primary task-name"><%=task.Task_Name%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-lh-body <%=dueClass%>"><%=task.Due_Date.toString("dd MMM yyyy")%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="zcs-badge <%=statusClass%>"><%=task.Status%></span></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left"><span class="zcs-badge <%=priorityClass%>"><%=task.Priority%></span></td></tr>
<%
    rowCount = rowCount + 1;
  }
}
if(rowCount == 0)
{
%>
      <tr><td colspan="4" class="empty-row"><i class="zc-li-outline ui-1-check-circle-08"></i> No upcoming open tasks</td></tr>
<%
}
%>
    </tbody></table></div>
  </div>
</div>