<%
  visibleExpenses = Expense_Reports[ID != 0];
  totalSubmitted = ifnull(visibleExpenses.sum(Amount),0.00);
  pendingCount = Expense_Reports[Approval_Status == "Pending Department Head"].count();
  approvedUnpaid = ifnull(Expense_Reports[Approval_Status == "Approved" && (Payment_Status == "Unpaid" || Payment_Status == "Processing")].sum(Amount),0.00);
  paidAmount = ifnull(Expense_Reports[Payment_Status == "Paid"].sum(Amount),0.00);
  unpaidCount = Expense_Reports[Approval_Status == "Approved" && Payment_Status == "Unpaid"].count();
  processingCount = Expense_Reports[Approval_Status == "Approved" && Payment_Status == "Processing"].count();
  paidCount = Expense_Reports[Payment_Status == "Paid"].count();
  rejectedCount = Expense_Reports[Approval_Status == "Rejected"].count();
  pipelineTotal = unpaidCount + processingCount + paidCount;
  categories = {"Travel","Meals","Lodging","Office Supplies","Training","Client Entertainment","Other"};
  recentExpenses = Expense_Reports[ID != 0] sort by Added_Time desc range from 1 to 8;
  displayUser = zoho.loginuser;
  if(displayUser == null || displayUser == "")
  {
    displayUser = zoho.loginuserid;
  }
%>
<style>
/* ZCS shared global stylesheet: included once on this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#f3f5f8;--zcs-surface:var(--zcs-white-color);--zcs-bg:var(--zcs-page-bg-color);--zcs-text-1:var(--zcs-primary-text-color);--zcs-text-2:var(--zcs-secondary-text-color);--zcs-text-3:var(--zcs-teritiary-text-color);--zcs-radius:12px;--zcs-shadow:0 2px 10px rgba(22,34,51,.07);--zcs-green:#147d58;--zcs-green-bg:#e7f6ef;--zcs-red:#b73535;--zcs-red-bg:#fdecec;--zcs-orange:#a45f08;--zcs-orange-bg:#fff2dc;--zcs-blue:#17699b;--zcs-blue-bg:#e8f3fa}
.zcs-flex{display:flex}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-w-full{width:100%}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-font-12{font-size:.75rem}.zcs-font-14{font-size:.875rem}.zcs-font-medium{font-weight:500}.zcs-font-normal{font-weight:400}.zcs-lh-body{line-height:1.5}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-m-0{margin:0}
.zcs-page{font-family:var(--zcs-font,Arial,sans-serif);background:var(--zcs-bg);min-height:100vh;padding:24px;box-sizing:border-box;color:var(--zcs-text-1)}
.zcs-page-header{margin-bottom:24px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.zcs-page-header__title{font-size:24px;font-weight:650;color:var(--zcs-text-1);margin:0 0 4px}.zcs-page-header__sub{font-size:14px;color:var(--zcs-text-2);margin:0}.dashboard-date{font-size:12px;color:var(--zcs-text-3);white-space:nowrap;padding-top:6px}
.zcs-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin-bottom:24px}.zcs-kpi-card{background:var(--zcs-surface);border-radius:var(--zcs-radius);box-shadow:var(--zcs-shadow);padding:20px 22px;border:1px solid var(--zcs-border-color)}.zcs-kpi-card__top{display:flex;align-items:center;justify-content:space-between;gap:10px}.zcs-kpi-card__icon{width:36px;height:36px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;background:var(--zcs-blue-bg);color:var(--zcs-blue);font-size:18px}.zcs-kpi-card__label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--zcs-text-2)}.zcs-kpi-card__value{font-size:30px;font-weight:700;margin:10px 0 5px;line-height:1.05}.zcs-kpi-card__sub{font-size:12px;color:var(--zcs-text-3)}.zcs-color-blue{color:#17699b}.zcs-color-yellow{color:#a45f08}.zcs-color-green{color:#147d58}.zcs-color-d_blue{color:#3046a5}
.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:16px;align-items:start}.zcs-section{background:var(--zcs-surface);border-radius:var(--zcs-radius);box-shadow:var(--zcs-shadow);padding:20px 24px;margin-bottom:16px;border:1px solid var(--zcs-border-color)}.zcs-section__head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.zcs-section__heading{font-size:15px;font-weight:600;color:var(--zcs-text-1);margin:0}.section-note{font-size:12px;color:var(--zcs-text-3)}
.category-row{margin-bottom:15px}.category-meta{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:13px;margin-bottom:6px}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color,#edf0f4);border-radius:5px;overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color,#2878bd);min-width:0}.pipeline{display:grid;gap:10px}.pipeline-row{display:grid;grid-template-columns:34px 1fr auto;gap:11px;align-items:center;padding:11px 0;border-bottom:1px solid var(--zcs-border-color)}.pipeline-row:last-child{border-bottom:0}.pipeline-icon{width:32px;height:32px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:var(--zcs-blue-bg);color:var(--zcs-blue)}.pipeline-label{font-size:13px;font-weight:600}.pipeline-sub{font-size:11px;color:var(--zcs-text-3);margin-top:2px}.pipeline-count{font-size:20px;font-weight:700}
.zcs-badge{display:inline-block;font-size:12px;font-weight:600;padding:3px 10px;border-radius:20px;line-height:1.4;white-space:nowrap}.zcs-badge--success{background:var(--zcs-green-bg);color:var(--zcs-green)}.zcs-badge--danger{background:var(--zcs-red-bg);color:var(--zcs-red)}.zcs-badge--warning{background:var(--zcs-orange-bg);color:var(--zcs-orange)}.zcs-badge--info{background:var(--zcs-blue-bg);color:var(--zcs-blue)}.zcs-badge--neutral{background:#f3f4f6;color:var(--zcs-text-2)}
.quick-links{display:grid;gap:9px}.quick-link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 12px;border:1px solid var(--zcs-border-color);border-radius:9px;color:var(--zcs-text-1);text-decoration:none;background:var(--zcs-surface)}.quick-link__label{display:flex;align-items:center;gap:9px;font-size:13px;font-weight:600}.quick-link i{color:var(--zcs-theme-brand-color)}
.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:780px}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper th{background:#f9fafe;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper tbody tr:first-child td{border-top-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#f9fafe}.expense-link{color:var(--zcs-theme-brand-color);font-weight:600;text-decoration:none}.empty-state{text-align:center;padding:34px 16px;color:var(--zcs-text-2)}.empty-state i{font-size:28px;color:var(--zcs-text-3);display:block;margin-bottom:8px}
@media(max-width:900px){.dashboard-grid{grid-template-columns:1fr}.zcs-page{padding:18px}.zcs-page-header{flex-direction:column}.dashboard-date{padding-top:0}}
@media(max-width:560px){.zcs-page{padding:12px}.zcs-section{padding:17px 16px}.zcs-kpi-card{padding:18px}.zcs-kpi-card__value{font-size:26px}.zcs-page-header__title{font-size:21px}}
</style>
<div class="zcs-page">
  <div class="zcs-page-header">
    <div>
      <h1 class="zcs-page-header__title">Expense dashboard</h1>
      <p class="zcs-page-header__sub">Spend, approvals and payments visible to <%=displayUser%>.</p>
    </div>
    <div class="dashboard-date"><i class="zc-li-outline ui-1-calendar-60"></i> Updated <%=zoho.currentdate.toString("MMM d, yyyy")%></div>
  </div>

  <div class="zcs-kpi-grid">
    <div class="zcs-kpi-card">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Submitted spend</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline business-money-coins"></i></span></div>
      <div class="zcs-kpi-card__value zcs-color-blue">$<%=totalSubmitted.toString("#,##0.00")%></div>
      <div class="zcs-kpi-card__sub">Total amount in your accessible expense records</div>
    </div>
    <div class="zcs-kpi-card">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Pending Department Head</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline ui-2-time"></i></span></div>
      <div class="zcs-kpi-card__value zcs-color-yellow"><%=pendingCount%></div>
      <div class="zcs-kpi-card__sub">Claims waiting for an approval decision</div>
    </div>
    <div class="zcs-kpi-card">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Approved and unpaid</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline business-money-bag-09"></i></span></div>
      <div class="zcs-kpi-card__value zcs-color-d_blue">$<%=approvedUnpaid.toString("#,##0.00")%></div>
      <div class="zcs-kpi-card__sub">Approved claims not yet marked paid</div>
    </div>
    <div class="zcs-kpi-card">
      <div class="zcs-kpi-card__top"><div class="zcs-kpi-card__label">Paid claims</div><span class="zcs-kpi-card__icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span></div>
      <div class="zcs-kpi-card__value zcs-color-green">$<%=paidAmount.toString("#,##0.00")%></div>
      <div class="zcs-kpi-card__sub"><%=paidCount%> claim(s) completed</div>
    </div>
  </div>

  <div class="dashboard-grid">
    <div>
      <div class="zcs-section">
        <div class="zcs-section__head"><h2 class="zcs-section__heading">Spend by category</h2><span class="section-note">Share of submitted spend</span></div>
        <% for each categoryName in categories {
             categoryAmount = ifnull(Expense_Reports[Category == categoryName].sum(Amount),0.00);
             categoryPercent = 0;
             if(totalSubmitted > 0) { categoryPercent = ((categoryAmount * 100.0) / totalSubmitted).round(1); }
        %>
        <div class="category-row">
          <div class="category-meta"><span><%=categoryName%></span><strong>$<%=categoryAmount.toString("#,##0.00")%> · <%=categoryPercent%>%</strong></div>
          <div class="zcs-progress-bar"><div class="zcs-progress-bar-indicator" style="width:<%=categoryPercent%>%;"></div></div>
        </div>
        <% } %>
      </div>
    </div>

    <div>
      <div class="zcs-section">
        <div class="zcs-section__head"><h2 class="zcs-section__heading">Payment pipeline</h2><span class="zcs-badge zcs-badge--info"><%=pipelineTotal%> active or paid</span></div>
        <div class="pipeline">
          <div class="pipeline-row"><span class="pipeline-icon"><i class="zc-li-outline ui-2-time"></i></span><div><div class="pipeline-label">Unpaid</div><div class="pipeline-sub">Ready for Finance</div></div><div class="pipeline-count"><%=unpaidCount%></div></div>
          <div class="pipeline-row"><span class="pipeline-icon"><i class="zc-li-outline arrows-1-refresh-69"></i></span><div><div class="pipeline-label">Processing</div><div class="pipeline-sub">Payment in progress</div></div><div class="pipeline-count"><%=processingCount%></div></div>
          <div class="pipeline-row"><span class="pipeline-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span><div><div class="pipeline-label">Paid</div><div class="pipeline-sub">Payment completed</div></div><div class="pipeline-count"><%=paidCount%></div></div>
          <div class="pipeline-row"><span class="pipeline-icon"><i class="zc-li-outline ui-1-simple-remove"></i></span><div><div class="pipeline-label">Rejected</div><div class="pipeline-sub">Not eligible for payment</div></div><div class="pipeline-count"><%=rejectedCount%></div></div>
        </div>
      </div>
      <div class="zcs-section">
        <h2 class="zcs-section__heading">Work queues</h2>
        <div class="quick-links">
          <a class="quick-link" href="#Report:My_Expenses"><span class="quick-link__label"><i class="zc-li-outline files-single-copy-04"></i> My expenses</span><i class="zc-li-outline arrows-1-tail-right"></i></a>
          <a class="quick-link" href="#Report:Head_Approval_Queue"><span class="quick-link__label"><i class="zc-li-outline ui-1-check-square-11"></i> Head approval queue</span><i class="zc-li-outline arrows-1-tail-right"></i></a>
          <a class="quick-link" href="#Report:Finance_Payment_Queue"><span class="quick-link__label"><i class="zc-li-outline business-money-coins"></i> Finance payment queue</span><i class="zc-li-outline arrows-1-tail-right"></i></a>
        </div>
      </div>
    </div>
  </div>

  <div class="zcs-section">
    <div class="zcs-section__head"><h2 class="zcs-section__heading">Recent expenses</h2><a class="expense-link" href="#Report:My_Expenses">View report <i class="zc-li-outline arrows-1-tail-right"></i></a></div>
    <% if(recentExpenses.count() == 0) { %>
      <div class="empty-state"><i class="zc-li-outline files-single-copy-04"></i>No expense records are currently visible.</div>
    <% } else { %>
    <div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
      <table class="zcs-w-full">
        <thead class="zcs-sticky"><tr>
          <th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Expense</th>
          <th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Date</th>
          <th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Category</th>
          <th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Amount</th>
          <th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Approval</th>
          <th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Payment</th>
        </tr></thead>
        <tbody>
        <% for each expense in recentExpenses {
             approvalBadge = "zcs-badge--neutral";
             if(expense.Approval_Status == "Approved") { approvalBadge = "zcs-badge--success"; }
             else if(expense.Approval_Status == "Rejected") { approvalBadge = "zcs-badge--danger"; }
             else if(expense.Approval_Status == "Pending Department Head") { approvalBadge = "zcs-badge--warning"; }
             paymentBadge = "zcs-badge--neutral";
             if(expense.Payment_Status == "Paid") { paymentBadge = "zcs-badge--success"; }
             else if(expense.Payment_Status == "Processing") { paymentBadge = "zcs-badge--info"; }
             else if(expense.Payment_Status == "Unpaid") { paymentBadge = "zcs-badge--warning"; }
        %>
          <tr>
            <td class="zcs-px-16 zcs-py-8 zcs-font-14"><a class="expense-link" href="#Report:My_Expenses?ID=<%=expense.ID%>">#<%=expense.Expense_Number%></a></td>
            <td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=expense.Expense_Date.toString("MMM d, yyyy")%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=expense.Category%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14">$<%=expense.Amount.toString("#,##0.00")%></td>
            <td class="zcs-px-16 zcs-py-8"><span class="zcs-badge <%=approvalBadge%>"><%=expense.Approval_Status%></span></td>
            <td class="zcs-px-16 zcs-py-8"><span class="zcs-badge <%=paymentBadge%>"><%=expense.Payment_Status%></span></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>