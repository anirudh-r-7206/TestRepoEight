	"Finance"
	{
	    name        = "Finance"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
	    description = "Finance users who view all approved expenses and maintain payment state."
	
	    ModulePermissions
	    {
	        Department_Heads
