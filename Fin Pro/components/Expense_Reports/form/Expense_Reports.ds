form Expense_Reports
{
    success message = "Expense report submitted successfully."
    record owner = Added_User

    Expense_Details
    (
        type = section
        displayname = "Expense Details"
        row = 1
        column = 0
    )
    Expense_Number
    (
        type = autonumber
        displayname = "Expense Number"
        start index = 1
        row = 1
        column = 1
    )
    must have Expense_Date
    (
        type = date
        displayname = "Expense Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Category
    (
        type = picklist
        values = {"Travel", "Meals", "Lodging", "Office Supplies", "Training", "Client Entertainment", "Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Amount
    (
        type = USD
        decimalplace = 2
        maxchar = 12
        row = 1
        column = 1
        width = medium
    )
    must have Receipt
    (
        type = upload file
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        row = 1
        column = 1
        width = medium
    )

    Approval_and_Payment
    (
        type = section
        displayname = "Approval and Payment"
        visibility = true
        row = 2
        column = 1
    )
    Department_Head
    (
        type = picklist
        displayname = "Department Head"
        values = Department_Heads.ID
        displayformat = [Head_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Approval_Status
    (
        type = picklist
        displayname = "Approval Status"
        values = {"Pending Department Head", "Approved", "Rejected"}
        initial value = "Approved"
        row = 2
        column = 2
        width = medium
    )
    Payment_Status
    (
        type = picklist
        displayname = "Payment Status"
        values = {"Not Ready", "Unpaid", "Processing", "Paid"}
        initial value = "Unpaid"
        row = 2
        column = 1
        width = medium
    )
    Submitted_By
    (
        type = email
        displayname = "Submitted By"
        initial value = "${zoho.loginuserid}"
        row = 2
        column = 2
        width = medium
    )
    Approved_or_Rejected_By
    (
        type = email
        displayname = "Approved or Rejected By"
        row = 2
        column = 1
        width = medium
    )
    Decision_Date
    (
        type = date
        displayname = "Decision Date"
        row = 2
        column = 2
        width = medium
    )
    Decision_Notes
    (
        type = textarea
        displayname = "Decision Notes"
        row = 2
        column = 1
        width = medium
    )
    Payment_Reference
    (
        type = text
        displayname = "Payment Reference"
        row = 2
        column = 2
        width = medium
    )
    Paid_Date
    (
        type = date
        displayname = "Paid Date"
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
