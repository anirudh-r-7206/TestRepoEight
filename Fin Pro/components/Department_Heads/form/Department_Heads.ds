form Department_Heads
{
    Directory_Details
    (
        type = section
        displayname = "Directory Details"
        row = 1
        column = 0
    )
    must have Head_Name
    (
        type = text
        displayname = "Head Name"
        row = 1
        column = 1
        width = medium
    )
    must have unique Head_Email
    (
        type = email
        displayname = "Head Email"
        row = 1
        column = 2
        width = medium
    )
    must have Department
    (
        type = text
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
