form Expense_Audit
{
    title
    {
        displayname = "Expense Audit"
        on add = "Add Expense Audit"
        on edit = "Edit Expense Audit"
    }

    Audit_Details
    (
        type = section
        displayname = "Audit Details"
        row = 1
        column = 0
    )
    must have Expense
    (
        type = picklist
        values = Expense_Reports.ID
        displayformat = [Expense_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Action
    (
        type = text
        row = 1
        column = 2
        width = medium
    )
    must have Actor_Email
    (
        type = email
        displayname = "Actor Email"
        row = 1
        column = 1
        width = medium
    )
    must have Action_Time
    (
        type = datetime
        displayname = "Action Time"
        row = 1
        column = 2
        width = medium
    )
    Previous_Approval_Status
    (
        type = text
        displayname = "Previous Approval Status"
        row = 1
        column = 1
        width = medium
    )
    New_Approval_Status
    (
        type = text
        displayname = "New Approval Status"
        row = 1
        column = 2
        width = medium
    )
    Previous_Payment_Status
    (
        type = text
        displayname = "Previous Payment Status"
        row = 1
        column = 1
        width = medium
    )
    New_Payment_Status
    (
        type = text
        displayname = "New Payment Status"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
