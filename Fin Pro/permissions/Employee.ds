"Employee"
{
    name        = "Employee"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Employees who create expenses, manage only their own eligible records, and view their own expense status."

    ModulePermissions
    {
        Department_Heads
        {
            enabled          = View,Search
            allFieldsVisible = false
            ReportPermissions
            {
                Active_Department_Heads={"View"}
            }
            FieldPermissions
            {
                Directory_Details{visibility:true,readonly:true}
                Head_Name{visibility:true,readonly:true}
                Head_Email{visibility:true,readonly:true}
                Department{visibility:true,readonly:true}
                Active{visibility:true,readonly:true}
            }
        }

        Expense_Reports
        {
            enabled          = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                My_Expenses={"View","Edit"}
            }
            FieldPermissions
            {
                Expense_Details{visibility:true,readonly:true}
                Expense_Number{visibility:true,readonly:true}
                Expense_Date{visibility:true,readonly:false}
                Category{visibility:true,readonly:false}
                Amount{visibility:true,readonly:false}
                Receipt{visibility:true,readonly:false}
                Description{visibility:true,readonly:false}
                Approval_and_Payment{visibility:true,readonly:true}
                Department_Head{visibility:true,readonly:false}
                Approval_Status{visibility:true,readonly:true}
                Payment_Status{visibility:true,readonly:true}
                Submitted_By{visibility:true,readonly:true}
                Approved_or_Rejected_By{visibility:true,readonly:true}
                Decision_Date{visibility:true,readonly:true}
                Decision_Notes{visibility:true,readonly:true}
                Payment_Reference{visibility:true,readonly:true}
                Paid_Date{visibility:true,readonly:true}
            }
        }

        Expense_Dashboard
        {
            enabled = tab
        }
    }
}
