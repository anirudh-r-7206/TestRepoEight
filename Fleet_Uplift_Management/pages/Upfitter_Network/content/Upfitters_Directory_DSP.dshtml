<%
activeCount = Upfitters[Status == "Active"].count();
inactiveCount = Upfitters[Status == "Inactive"].count();
%>
<style>
/* ZCS global utility subset used by this page. */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color);
	--zcs-light-bg-color: var(--zcs_brand_light_color);
	--zcs-page-bg-color: #f3f3f4;
	--zcs-primary-text-color: var(--zcs_primary_text_color);
	--zcs-secondary-text-color: var(--zcs_secondary_text_color);
	--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
	--zcs-border-color: var(--zcs_tertiary_border_color);
	--zcs-white-color: #ffffff;
	--upfitter-container-spacing: 15px;
	--upfitter-radius: 12px;
	--upfitter-base-size: 14px;
	--upfitter-surface: var(--zcs-white-color);
	--upfitter-page-bg: var(--zcs-page-bg-color);
	--upfitter-border: var(--zcs_tertiary_border_color);
	--upfitter-text: var(--zcs_primary_text_color);
	--upfitter-muted: var(--zcs_secondary_text_color);
	--upfitter-brand: var(--zcs_brand_color);
}
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-6 { gap: 6px; }
.zcs-gap-8 { gap: 8px; }
.zcs-gap-12 { gap: 12px; }
.zcs-w-full { width: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-col-common { flex: 1 1 0%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-px-6 { padding-left: 6px; padding-right: 6px; }
.zcs-px-10 { padding-left: 10px; padding-right: 10px; }
.zcs-px-16 { padding-left: 16px; padding-right: 16px; }
.zcs-py-0 { padding-top: 0; padding-bottom: 0; }
.zcs-py-2 { padding-top: 2px; padding-bottom: 2px; }
.zcs-py-8 { padding-top: 8px; padding-bottom: 8px; }
.zcs-py-12 { padding-top: 12px; padding-bottom: 12px; }
.zcs-m-0 { margin: 0; }
.zcs-mt-10 { margin-top: 10px; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-font-12 { font-size: 12px; }
.zcs-font-14 { font-size: 14px; }
.zcs-font-18 { font-size: 18px; }
.zcs-font-24 { font-size: 24px; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: 4px; }
.zcs-rounded-md { border-radius: 6px; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
a { text-decoration: none; }

/* ZCS Heading with Button / Primary Button. */
.zcs-button {
	width: auto;
	min-width: 5rem;
	min-height: 36px;
	border: 0;
	cursor: pointer;
}
.zcs-primary-button {
	background-color: var(--zcs_brand_color);
	color: var(--zcs_brand_foreground_color);
}
.zcs-primary-button:hover { background-color: var(--zcs_brand_dark_color); }
.zcs-primary-button:focus {
	outline: 2px solid var(--zcs_brand_color);
	outline-offset: 2px;
}
.zcs-button-icon { width: 16px; max-height: 16px; }

/* ZCS Horizontal Tab With Count. */
.zcs-horizontal-tabpanel { min-height: 520px; }
.zcs-horizontal-tabhead {
	box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset;
	overflow-x: auto;
	overflow-y: hidden;
	scrollbar-width: none;
}
.zcs-horizontal-tabhead::-webkit-scrollbar { display: none; }
.zcs-horizontal-tabitem {
	flex: 0 0 auto;
	list-style: none;
	border-bottom: 2px solid transparent;
	letter-spacing: .1px;
}
.zcs-horizontal-tablink {
	cursor: pointer;
	user-select: none;
	white-space: nowrap;
	color: var(--zcs_teritiary_text_color);
}
.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs_brand_color); }
.zcs-horizontal-tabcount {
	min-width: 24px;
	background-color: var(--zcs-page-bg-color);
}
.zcs-horizontal-tabbody { overflow: visible; }

.upfitter-directory,
.upfitter-directory * { box-sizing: border-box; }
.upfitter-directory {
	width: 100%;
	min-height: 100%;
	padding: var(--upfitter-container-spacing);
	background: var(--upfitter-page-bg);
	color: var(--upfitter-text);
	font-size: var(--upfitter-base-size);
	line-height: 1.5;
}
.upfitter-header {
	min-height: 88px;
	margin-bottom: var(--upfitter-container-spacing);
	padding: 20px 22px;
	background: var(--upfitter-surface);
	border: 1px solid var(--upfitter-border);
	border-radius: var(--upfitter-radius);
	box-shadow: 0 1px 2px rgba(18,19,43,.04);
}
.upfitter-header-copy { min-width: 0; }
.upfitter-header-title { margin: 0; color: var(--upfitter-text); }
.upfitter-header-subtitle {
	margin: 4px 0 0;
	color: var(--upfitter-muted);
	font-size: var(--upfitter-base-size);
}
.upfitter-add-action { flex: 0 0 auto; }
.upfitter-tabs-card {
	position: relative;
	overflow: hidden;
	background: var(--upfitter-surface);
	border: 1px solid var(--upfitter-border);
	border-radius: var(--upfitter-radius);
	box-shadow: 0 1px 2px rgba(18,19,43,.04);
}
.upfitter-tab-control {
	position: absolute;
	width: 1px;
	height: 1px;
	padding: 0;
	margin: -1px;
	overflow: hidden;
	clip: rect(0,0,0,0);
	white-space: nowrap;
	border: 0;
}
.upfitter-tab-control:focus-visible ~ .zcs-horizontal-tabpanel .zcs-horizontal-tabhead {
	outline: 2px solid var(--upfitter-brand);
	outline-offset: -2px;
}
.upfitter-tabhead { padding: 0 12px; }
.upfitter-tabpane { display: none; padding: var(--upfitter-container-spacing); }
.upfitter-report-shell {
	position: relative;
	min-height: 480px;
	overflow: hidden;
	background: var(--upfitter-surface);
	border: 1px solid var(--upfitter-border);
	border-radius: var(--upfitter-radius);
}
.upfitter-report {
	width: 100%;
	min-height: 480px;
	border: 0;
	background: transparent;
}
.upfitter-report-empty { display: none; }
.upfitter-empty-state { min-height: 480px; color: var(--upfitter-muted); }
.upfitter-empty-content { max-width: 440px; padding: 32px 20px; }
.upfitter-empty-icon {
	width: 52px;
	height: 52px;
	margin: 0 auto 12px;
	border-radius: 12px;
	background: var(--zcs_brand_light_color);
	color: var(--upfitter-brand);
	font-size: 23px;
}
.upfitter-empty-copy { margin: 6px 0 0; color: var(--upfitter-muted); }
.upfitter-guidance {
	padding: 10px 15px;
	color: var(--upfitter-muted);
	background: var(--zcs_brand_light_color);
	border-top: 1px solid var(--upfitter-border);
	font-size: 13px;
}
.upfitter-guidance a { color: var(--upfitter-brand); font-weight: 600; }

#upfitter-tab-active:checked ~ .zcs-horizontal-tabpanel .tab-active,
#upfitter-tab-inactive:checked ~ .zcs-horizontal-tabpanel .tab-inactive { border-bottom-color: var(--upfitter-brand); }
#upfitter-tab-active:checked ~ .zcs-horizontal-tabpanel .tab-active .zcs-horizontal-tablink,
#upfitter-tab-inactive:checked ~ .zcs-horizontal-tabpanel .tab-inactive .zcs-horizontal-tablink { color: var(--upfitter-brand); }
#upfitter-tab-active:checked ~ .zcs-horizontal-tabpanel .pane-active,
#upfitter-tab-inactive:checked ~ .zcs-horizontal-tabpanel .pane-inactive { display: block; }

.status-active { background: #e2f6ee; color: #116f50; }
.status-inactive { background: #e9ebef; color: #4f5461; }

@media (max-width: 768px) {
	.upfitter-header { align-items: flex-start; flex-direction: column; padding: 18px; }
	.upfitter-add-action { width: 100%; }
	.upfitter-add-action .zcs-button { width: 100%; }
	.upfitter-tabhead { padding: 0 6px; }
	.zcs-horizontal-tablink { padding: 11px 9px; }
	.upfitter-tabpane { padding: 12px; }
	.upfitter-report-shell,
	.upfitter-report,
	.upfitter-empty-state { min-height: 560px; }
}
@media (max-width: 480px) {
	.upfitter-directory { padding: 10px; }
	.upfitter-header { margin-bottom: 10px; }
	.upfitter-header-title { font-size: 21px; }
	.upfitter-header-subtitle { font-size: 13px; }
}
</style>

<div class='upfitter-directory'>
	<header class='upfitter-header zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-box-border'>
		<div class='upfitter-header-copy zcs-ellipsis'>
			<h1 class='upfitter-header-title zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-ellipsis'>Upfitters</h1>
			<p class='upfitter-header-subtitle'>Manage the internal directory of member and contracted shops.</p>
		</div>
		<div class='upfitter-add-action zcs-flex zcs-align-items-center'>
			<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body'
				 href='#Form:Upfitters?zc_LoadIn=dialog&amp;zc_Header=false&amp;zc_NextUrl=%23Page%3AUpfitter_Network&amp;zc_OpenUrlIn=same%20window&amp;zc_SuccMsg=Upfitter%20added%20successfully'>
				<i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
				<span class='zcs-button-text'>Add Upfitter</span>
			</a>
		</div>
	</header>

	<section class='upfitter-tabs-card'>
		<input class='upfitter-tab-control' type='radio' name='upfitter-status' id='upfitter-tab-active' checked='checked'>
		<input class='upfitter-tab-control' type='radio' name='upfitter-status' id='upfitter-tab-inactive'>

		<div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full'>
			<ul class='upfitter-tabhead zcs-horizontal-tabhead zcs-flex zcs-gap-6 zcs-py-0 zcs-m-0 zcs-box-border' role='tablist' aria-label='Upfitter status'>
				<li class='tab-active zcs-horizontal-tabitem'>
					<label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body' for='upfitter-tab-active'>
						<span class='zcs-horizontal-tabtext zcs-font-14'>Active</span>
						<span class='zcs-horizontal-tabcount status-active zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=activeCount%></span>
					</label>
				</li>
				<li class='tab-inactive zcs-horizontal-tabitem'>
					<label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body' for='upfitter-tab-inactive'>
						<span class='zcs-horizontal-tabtext zcs-font-14'>Inactive</span>
						<span class='zcs-horizontal-tabcount status-inactive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=inactiveCount%></span>
					</label>
				</li>
			</ul>

			<div class='zcs-horizontal-tabbody zcs-col-common'>
				<div class='upfitter-tabpane pane-active'>
					<div class='upfitter-report-shell'>
						<% if(activeCount == 0) { %>
						<div class='upfitter-empty-state zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
							<div class='upfitter-empty-content zcs-box-border'>
								<div class='upfitter-empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline transportation-truck-front'></i></div>
								<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No active upfitters</h5>
								<p class='upfitter-empty-copy'>Add a shop or reactivate an existing upfitter to make it available for matching.</p>
							</div>
						</div>
						<% } %>
						<div class='upfitter-report <% if(activeCount == 0) { %>upfitter-report-empty<% } %>' elName='zc-component' viewLinkName='Active_Upfitters' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div>
					</div>
				</div>

				<div class='upfitter-tabpane pane-inactive'>
					<div class='upfitter-report-shell'>
						<% if(inactiveCount == 0) { %>
						<div class='upfitter-empty-state zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
							<div class='upfitter-empty-content zcs-box-border'>
								<div class='upfitter-empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-archive'></i></div>
								<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No inactive upfitters</h5>
								<p class='upfitter-empty-copy'>Deactivated shops will remain available here for historical reference.</p>
							</div>
						</div>
						<% } %>
						<div class='upfitter-report <% if(inactiveCount == 0) { %>upfitter-report-empty<% } %>' elName='zc-component' viewLinkName='Inactive_Upfitters' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div>
					</div>
				</div>
			</div>

			<div class='upfitter-guidance'>Select an upfitter record to open its workspace in <a href='#Page:Upfitter_Detail'>Upfitter Detail</a>.</div>
		</div>
	</section>
</div>