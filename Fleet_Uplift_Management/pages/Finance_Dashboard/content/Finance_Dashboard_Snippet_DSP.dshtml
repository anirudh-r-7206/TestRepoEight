<%
monthStart = zoho.currentdate.toStartOfMonth();
outstandingInvoices = Client_Invoices[Payment_Status != "Paid"];
outstandingInvoiceAmount = ifnull(outstandingInvoices.sum(Invoice_Amount),0);
outstandingInvoiceCount = outstandingInvoices.count();
outstandingPayables = Upfitter_Payables[Payment_Status != "Paid"];
outstandingPayableAmount = ifnull(outstandingPayables.sum(Payable_Amount),0);
outstandingPayableCount = outstandingPayables.count();
collectedThisMonth = ifnull(Client_Invoices[Payment_Status == "Paid" && Payment_Date >= monthStart].sum(Invoice_Amount),0);
paidThisMonth = ifnull(Upfitter_Payables[Payment_Status == "Paid" && Payment_Date >= monthStart].sum(Payable_Amount),0);
overdueInvoices = Client_Invoices[Payment_Status != "Paid" && Due_Date < zoho.currentdate];
overdueInvoiceAmount = ifnull(overdueInvoices.sum(Invoice_Amount),0);
overdueInvoiceCount = overdueInvoices.count();
paidInvoiceCount = Client_Invoices[Payment_Status == "Paid"].count();
partialInvoiceCount = Client_Invoices[Payment_Status == "Partial"].count();
unpaidInvoiceCount = Client_Invoices[Payment_Status == "Unpaid"].count();
overdueStatusCount = Client_Invoices[Payment_Status == "Overdue"].count();
invoiceStatusTotal = paidInvoiceCount + partialInvoiceCount + unpaidInvoiceCount + overdueStatusCount;
paidPct = 0;
partialPct = 0;
overduePct = 0;
unpaidPct = 0;
if(invoiceStatusTotal > 0)
{
		paidPct = (paidInvoiceCount * 100.0 / invoiceStatusTotal).round(2);
		partialPct = (partialInvoiceCount * 100.0 / invoiceStatusTotal).round(2);
		overduePct = (overdueStatusCount * 100.0 / invoiceStatusTotal).round(2);
		unpaidPct = (unpaidInvoiceCount * 100.0 / invoiceStatusTotal).round(2);
}
comparisonMax = outstandingInvoiceAmount;
if(outstandingPayableAmount > comparisonMax)
{
		comparisonMax = outstandingPayableAmount;
}
arPct = 0;
apPct = 0;
if(comparisonMax > 0)
{
		arPct = (outstandingInvoiceAmount * 100.0 / comparisonMax).round(2);
		apPct = (outstandingPayableAmount * 100.0 / comparisonMax).round(2);
}
recentInvoicePayments = Client_Invoices[Payment_Status == "Paid"] sort by Payment_Date desc;
recentPayablePayments = Upfitter_Payables[Payment_Status == "Paid"] sort by Payment_Date desc;
%>
<style>
/* zcs-global: page-scoped utility subset used by this standalone dashboard */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;font-size:16px;line-height:1.5}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-box-border{box-sizing:border-box}.zcs-overflow-auto{overflow:auto}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}
.finance-dashboard{min-height:100%;padding:24px 30px;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:inherit}.fd-header{margin-bottom:20px}.fd-subtitle{max-width:760px}.fd-actions{flex-shrink:0}.zcs-button{width:auto;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-button:hover{background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}
.fd-kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin-bottom:20px}.fd-kpi{min-height:132px;box-shadow:0 2px 8px rgba(28,28,64,.04)}.fd-kpi-icon{width:42px;height:42px;flex:0 0 42px}.fd-kpi-icon i{line-height:1}.fd-blue{background:#EAF2FF;color:#1652BB}.fd-green{background:#E4FCF3;color:#179E6C}.fd-yellow{background:#FCF4E6;color:#B8770D}.fd-red{background:#FDE3E6;color:#FE455D}.fd-violet{background:#F1EFFE;color:#6554C0}.fd-kpi-value{word-break:break-word}.fd-kpi-meta{color:var(--zcs-teritiary-text-color)}
.fd-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr);gap:20px;margin-bottom:20px}.fd-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.fd-chart-body{min-height:270px}.fd-comparison{display:flex;flex-direction:column;gap:28px}.fd-comparison-row{display:grid;grid-template-columns:190px minmax(0,1fr) 130px;align-items:center;gap:14px}.fd-track{height:20px;background:#EEF0F5;overflow:hidden}.fd-bar{height:100%;min-width:0}.fd-bar-ar{width:<%=arPct%>%;background:var(--zcs_brand_color)}.fd-bar-ap{width:<%=apPct%>%;background:#F4660C}.fd-legend-dot{width:10px;height:10px;display:inline-block}.fd-donut-wrap{min-height:270px}.fd-donut{width:178px;height:178px;background:conic-gradient(#179E6C 0 <%=paidPct%>%,#2A6FFC <%=paidPct%>% <%=paidPct + partialPct%>%,#FE455D <%=paidPct + partialPct%>% <%=paidPct + partialPct + overduePct%>%,#FAAE13 <%=paidPct + partialPct + overduePct%>% 100%)}.fd-donut:after{content:'';position:absolute;inset:26px;background:var(--zcs-white-color);border-radius:50%}.fd-donut-center{z-index:1}.fd-legend{list-style:none}.fd-legend li{display:grid;grid-template-columns:12px 1fr auto;align-items:center;gap:8px}.fd-dot-paid{background:#179E6C}.fd-dot-partial{background:#2A6FFC}.fd-dot-overdue{background:#FE455D}.fd-dot-unpaid{background:#FAAE13}
.fd-lower-grid{display:grid;grid-template-columns:minmax(360px,.75fr) minmax(0,1.25fr);gap:20px}.fd-activity-list{list-style:none}.fd-activity-item{border-bottom:1px solid var(--zcs_tertiary_border_color)}.fd-activity-item:last-child{border-bottom:0}.fd-activity-icon{width:34px;height:34px;flex:0 0 34px}.fd-activity-copy{min-width:0}.fd-activity-amount{white-space:nowrap}.fd-table-card{min-width:0}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:760px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-red{background:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-yellow{background:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-nodata-wrapper{min-height:180px}.fd-zero-icon{font-size:28px;color:var(--zcs-teritiary-text-color)}
@media(max-width:1280px){.fd-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:992px){.fd-grid,.fd-lower-grid{grid-template-columns:1fr}.fd-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:768px){.finance-dashboard{padding:16px 20px}.fd-header{align-items:flex-start;flex-direction:column}.fd-actions{width:100%}.fd-actions .zcs-button{flex:1}.fd-comparison-row{grid-template-columns:1fr}.fd-comparison-value{text-align:left}.fd-donut-wrap{flex-direction:column}.fd-lower-grid{grid-template-columns:minmax(0,1fr)}}@media(max-width:576px){.fd-kpi-grid{grid-template-columns:1fr}.fd-actions{flex-direction:column}.fd-kpi{min-height:auto}}
</style>
<div class='finance-dashboard zcs-box-border'>
		<header class='fd-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
				<div>
						<h1 class='zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Finance Dashboard</h1>
						<p class='fd-subtitle zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-8 zcs-mb-0'>Live receivables, payables, cash movement, and overdue exposure as of <%=zoho.currentdate.toString("dd-MMM-yyyy")%>.</p>
				</div>
				<nav class='fd-actions zcs-flex zcs-align-items-center zcs-gap-10' aria-label='Finance links'>
						<a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Page:Invoices'>
								<i class='zc-li-outline files-single-content-03'></i><span>Invoices</span>
						</a>
						<a class='zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Page:Upfitter_Payables_Hub'>
								<i class='zc-li-outline business-money-coins'></i><span>Upfitter Payables</span>
						</a>
				</nav>
		</header>

		<section class='fd-kpi-grid' aria-label='Finance key performance indicators'>
				<article class='fd-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='fd-kpi-icon fd-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline business-money-13 zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Outstanding invoices</span></div>
						<div><div class='fd-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=outstandingInvoiceAmount.round(2)%></div><div class='fd-kpi-meta zcs-font-13'><%=outstandingInvoiceCount%> invoice<%=if(outstandingInvoiceCount == 1,"","s")%></div></div>
				</article>
				<article class='fd-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='fd-kpi-icon fd-yellow zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline arrows-4-restore zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Approved and pending payables</span></div>
						<div><div class='fd-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=outstandingPayableAmount.round(2)%></div><div class='fd-kpi-meta zcs-font-13'><%=outstandingPayableCount%> payable<%=if(outstandingPayableCount == 1,"","s")%></div></div>
				</article>
				<article class='fd-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='fd-kpi-icon fd-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline arrows-2-down-arrow zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Collected this month</span></div>
						<div><div class='fd-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=collectedThisMonth.round(2)%></div><div class='fd-kpi-meta zcs-font-13'>Client payments received</div></div>
				</article>
				<article class='fd-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='fd-kpi-icon fd-violet zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline arrows-2-up-arrow zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Paid to upfitters this month</span></div>
						<div><div class='fd-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=paidThisMonth.round(2)%></div><div class='fd-kpi-meta zcs-font-13'>Upfitter payments issued</div></div>
				</article>
				<article class='fd-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='fd-kpi-icon fd-red zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-2-time zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Overdue exposure</span></div>
						<div><div class='fd-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=overdueInvoiceAmount.round(2)%></div><div class='fd-kpi-meta zcs-font-13'><%=overdueInvoiceCount%> overdue invoice<%=if(overdueInvoiceCount == 1,"","s")%></div></div>
				</article>
		</section>

		<section class='fd-grid'>
				<article class='zcs-card zcs-flex zcs-direction-column'>
						<div class='fd-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>AR vs AP comparison</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Outstanding balances, scaled to the larger amount</p></div>
						<div class='fd-chart-body zcs-p-24 zcs-box-border zcs-flex zcs-direction-column zcs-justify-center'>
						<%if(comparisonMax == 0){%>
								<div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='fd-zero-icon zc-li-outline business-money-13'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No outstanding balances</h3><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Receivables and payables are currently clear.</p></div></div>
						<%}else{%>
								<div class='fd-comparison'>
										<div class='fd-comparison-row'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='fd-legend-dot zcs-rounded-half' style='background:var(--zcs_brand_color)'></span><span class='zcs-font-14 zcs-color-primary'>Accounts receivable</span></div><div class='fd-track zcs-rounded-lg'><div class='fd-bar fd-bar-ar'></div></div><strong class='fd-comparison-value zcs-font-14 zcs-text-right'>$<%=outstandingInvoiceAmount.round(2)%></strong></div>
										<div class='fd-comparison-row'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><span class='fd-legend-dot zcs-rounded-half' style='background:#F4660C'></span><span class='zcs-font-14 zcs-color-primary'>Accounts payable</span></div><div class='fd-track zcs-rounded-lg'><div class='fd-bar fd-bar-ap'></div></div><strong class='fd-comparison-value zcs-font-14 zcs-text-right'>$<%=outstandingPayableAmount.round(2)%></strong></div>
								</div>
						<%}%>
						</div>
				</article>
				<article class='zcs-card zcs-flex zcs-direction-column'>
						<div class='fd-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Invoice payment status</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Distribution across all client invoices</p></div>
						<div class='fd-donut-wrap zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20 zcs-p-20 zcs-box-border'>
						<%if(invoiceStatusTotal == 0){%>
								<div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='fd-zero-icon zc-li-outline files-single-content-03'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No invoices yet</h3><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Payment status will appear when invoices are created.</p></div></div>
						<%}else{%>
								<div class='fd-donut zcs-relative zcs-rounded-half zcs-flex zcs-align-items-center zcs-justify-center'><div class='fd-donut-center zcs-absolute zcs-text-center'><strong class='zcs-font-24 zcs-color-primary'><%=invoiceStatusTotal%></strong><div class='zcs-font-12 zcs-color-tertiary'>Invoices</div></div></div>
								<ul class='fd-legend zcs-flex zcs-direction-column zcs-gap-10 zcs-p-0 zcs-m-0'>
										<li><span class='fd-legend-dot fd-dot-paid zcs-rounded-half'></span><span class='zcs-font-14'>Paid</span><strong class='zcs-font-14'><%=paidInvoiceCount%></strong></li>
										<li><span class='fd-legend-dot fd-dot-partial zcs-rounded-half'></span><span class='zcs-font-14'>Partial</span><strong class='zcs-font-14'><%=partialInvoiceCount%></strong></li>
										<li><span class='fd-legend-dot fd-dot-overdue zcs-rounded-half'></span><span class='zcs-font-14'>Overdue</span><strong class='zcs-font-14'><%=overdueStatusCount%></strong></li>
										<li><span class='fd-legend-dot fd-dot-unpaid zcs-rounded-half'></span><span class='zcs-font-14'>Unpaid</span><strong class='zcs-font-14'><%=unpaidInvoiceCount%></strong></li>
								</ul>
						<%}%>
						</div>
				</article>
		</section>

		<section class='fd-lower-grid'>
				<article class='zcs-card zcs-flex zcs-direction-column'>
						<div class='fd-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Recent payment activity</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Latest incoming and outgoing payments</p></div>
						<div class='zcs-px-20 zcs-py-12 zcs-box-border'>
						<%
						invoiceActivityShown = 0;
						payableActivityShown = 0;
						%>
						<h3 class='zcs-font-14 zcs-font-semibold zcs-color-tertiary zcs-mt-8 zcs-mb-4'>CLIENT COLLECTIONS</h3>
						<ul class='fd-activity-list zcs-p-0 zcs-m-0'>
						<%for each invoicePayment in recentInvoicePayments
						{
								if(invoiceActivityShown < 4)
								{
										invoiceActivityShown = invoiceActivityShown + 1;
										paymentDateText = "Date not recorded";
										if(invoicePayment.Payment_Date != null){paymentDateText = invoicePayment.Payment_Date.toString("dd-MMM-yyyy");}
										paymentRef = ifnull(invoicePayment.Invoice_Number,"Invoice");
						%>
								<li class='fd-activity-item zcs-flex zcs-align-items-center zcs-gap-12 zcs-py-12'><span class='fd-activity-icon fd-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline arrows-2-down-arrow'></i></span><div class='fd-activity-copy zcs-col-common'><div class='zcs-font-14 zcs-font-medium zcs-color-primary'><%=paymentRef%></div><div class='zcs-font-12 zcs-color-tertiary'><%=paymentDateText%> · Collected</div></div><strong class='fd-activity-amount zcs-font-14 zcs-color-primary'>$<%=ifnull(invoicePayment.Invoice_Amount,0).round(2)%></strong></li>
						<%  }
						}%>
						<%if(invoiceActivityShown == 0){%><li class='zcs-font-14 zcs-color-tertiary zcs-py-12'>No client payments have been recorded.</li><%}%>
						</ul>
						<h3 class='zcs-font-14 zcs-font-semibold zcs-color-tertiary zcs-mt-10 zcs-mb-4'>UPFITTER PAYMENTS</h3>
						<ul class='fd-activity-list zcs-p-0 zcs-m-0'>
						<%for each payablePayment in recentPayablePayments
						{
								if(payableActivityShown < 4)
								{
										payableActivityShown = payableActivityShown + 1;
										paymentDateText = "Date not recorded";
										if(payablePayment.Payment_Date != null){paymentDateText = payablePayment.Payment_Date.toString("dd-MMM-yyyy");}
										paymentRef = "Payable " + payablePayment.Payable_ID;
						%>
								<li class='fd-activity-item zcs-flex zcs-align-items-center zcs-gap-12 zcs-py-12'><span class='fd-activity-icon fd-violet zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline arrows-2-up-arrow'></i></span><div class='fd-activity-copy zcs-col-common'><div class='zcs-font-14 zcs-font-medium zcs-color-primary'><%=paymentRef%></div><div class='zcs-font-12 zcs-color-tertiary'><%=paymentDateText%> · Paid</div></div><strong class='fd-activity-amount zcs-font-14 zcs-color-primary'>$<%=ifnull(payablePayment.Payable_Amount,0).round(2)%></strong></li>
						<%  }
						}%>
						<%if(payableActivityShown == 0){%><li class='zcs-font-14 zcs-color-tertiary zcs-py-12'>No upfitter payments have been recorded.</li><%}%>
						</ul>
						</div>
				</article>

				<article class='fd-table-card zcs-card zcs-flex zcs-direction-column'>
						<div class='fd-card-header zcs-px-24 zcs-py-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Overdue invoice summary</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Oldest due dates first</p></div><span class='zcs-badge zcs-badge-filled zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-14'><%=overdueInvoiceCount%> overdue</span></div>
						<div class='zcs-p-16 zcs-box-border'>
						<%if(overdueInvoiceCount == 0){%>
								<div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-20'><i class='fd-zero-icon zc-li-outline ui-1-check-circle-08'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No overdue invoices</h3><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>All open invoices are within their due dates.</p></div></div>
						<%}else{%>
								<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
										<table class='zcs-w-full'>
												<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Invoice</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Program</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Due date</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Amount</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Days overdue</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Status</th></tr></thead>
												<tbody>
												<%
												overdueShown = 0;
												for each invoice in Client_Invoices[Payment_Status != "Paid" && Due_Date < zoho.currentdate] sort by Due_Date asc
												{
														if(overdueShown < 10)
														{
																overdueShown = overdueShown + 1;
																programName = "Not assigned";
																if(invoice.Program != null){programName = ifnull(invoice.Program.Service_ID,"Not assigned");}
																dueDateText = invoice.Due_Date.toString("dd-MMM-yyyy");
																daysLate = invoice.Due_Date.daysBetween(zoho.currentdate);
																badgeClass = "zcs-badge-red";
																displayedStatus = invoice.Payment_Status;
																if(displayedStatus == "Partial"){badgeClass = "zcs-badge-yellow";}
												%>
														<tr><td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-font-medium'><%=ifnull(invoice.Invoice_Number,"Invoice")%></td><td class='zcs-px-16 zcs-py-12 zcs-font-14'><%=programName%></td><td class='zcs-px-16 zcs-py-12 zcs-font-14'><%=dueDateText%></td><td class='zcs-px-16 zcs-py-12 zcs-text-right zcs-font-14'>$<%=ifnull(invoice.Invoice_Amount,0).round(2)%></td><td class='zcs-px-16 zcs-py-12 zcs-text-right zcs-font-14'><%=daysLate%></td><td class='zcs-px-16 zcs-py-12'><span class='zcs-badge zcs-badge-filled <%=badgeClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=displayedStatus%></span></td></tr>
												<%  }
												}%>
												</tbody>
										</table>
								</div>
								<%if(overdueInvoiceCount > 10){%><p class='zcs-font-13 zcs-color-tertiary zcs-text-right zcs-mt-8 zcs-mb-0'>Showing 10 of <%=overdueInvoiceCount%> overdue invoices. Open Invoices for the complete list.</p><%}%>
						<%}%>
						</div>
				</article>
		</section>
</div>