<%
monthStart = zoho.currentdate.toStartOfMonth();
allPayables = Upfitter_Payables[ID != 0];
payableCount = allPayables.count();
totalPayables = ifnull(allPayables.sum(Payable_Amount),0);
approvedOutstanding = ifnull(Upfitter_Payables[Payment_Status == "Approved"].sum(Payable_Amount),0);
approvedCount = Upfitter_Payables[Payment_Status == "Approved"].count();
pendingApproval = ifnull(Upfitter_Payables[Payment_Status == "Pending Approval"].sum(Payable_Amount),0);
pendingCount = Upfitter_Payables[Payment_Status == "Pending Approval"].count();
paidTotal = ifnull(Upfitter_Payables[Payment_Status == "Paid"].sum(Payable_Amount),0);
paidCount = Upfitter_Payables[Payment_Status == "Paid"].count();
paidThisMonth = ifnull(Upfitter_Payables[Payment_Status == "Paid" && Payment_Date >= monthStart].sum(Payable_Amount),0);
paidThisMonthCount = Upfitter_Payables[Payment_Status == "Paid" && Payment_Date >= monthStart].count();
paidPct = 0;
approvedPct = 0;
pendingPct = 0;
if(totalPayables > 0)
{
		paidPct = (paidTotal * 100.0 / totalPayables).round(2);
		approvedPct = (approvedOutstanding * 100.0 / totalPayables).round(2);
		pendingPct = (pendingApproval * 100.0 / totalPayables).round(2);
}
upfitterMax = 0;
upfitterWithPayablesCount = 0;
for each shopSummary in Upfitters[ID != 0]
{
		shopSummaryId = shopSummary.ID;
		shopPayableTotal = ifnull(Upfitter_Payables[Upfitter == shopSummaryId].sum(Payable_Amount),0);
		if(shopPayableTotal > 0)
		{
				upfitterWithPayablesCount = upfitterWithPayablesCount + 1;
				if(shopPayableTotal > upfitterMax)
				{
						upfitterMax = shopPayableTotal;
				}
		}
}
%>
<style>
/* zcs-global.css: page-scoped utility rules used by this standalone analytics page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;font-size:16px;line-height:1.5}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row{display:flex;flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-box-border{box-sizing:border-box}.zcs-overflow-auto{overflow:auto}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half{border-radius:50%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}
.payout-report{min-height:100%;padding:24px 30px;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:inherit}.pr-header{margin-bottom:20px}.pr-subtitle{max-width:760px}.zcs-button{width:auto;min-height:36px;text-decoration:none}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color);color:var(--zcs_brand_foreground_color)}
.pr-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.pr-kpi{min-height:132px;box-shadow:0 2px 8px rgba(28,28,64,.04)}.pr-kpi-icon{width:42px;height:42px;flex:0 0 42px}.pr-kpi-icon i{line-height:1}.pr-violet{background:#F1EFFE;color:#6554C0}.pr-blue{background:#E8EFFF;color:#2A6FFC}.pr-yellow{background:#FCF4E6;color:#B8770D}.pr-green{background:#E4FCF3;color:#179E6C}.pr-kpi-value{word-break:break-word}.pr-kpi-meta{color:var(--zcs-teritiary-text-color)}
.pr-analytics-grid{display:grid;grid-template-columns:minmax(320px,.7fr) minmax(0,1.3fr);gap:20px;margin-bottom:20px}.pr-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.pr-donut-wrap{min-height:300px}.pr-donut{width:182px;height:182px;background:conic-gradient(#179E6C 0 <%=paidPct%>%,#2A6FFC <%=paidPct%>% <%=paidPct + approvedPct%>%,#FAAE13 <%=paidPct + approvedPct%>% 100%)}.pr-donut:after{content:'';position:absolute;inset:27px;background:var(--zcs-white-color);border-radius:50%}.pr-donut-center{z-index:1}.pr-legend{list-style:none;min-width:190px}.pr-legend li{display:grid;grid-template-columns:12px 1fr auto;align-items:center;gap:8px}.pr-dot{width:10px;height:10px}.pr-dot-paid{background:#179E6C}.pr-dot-approved{background:#2A6FFC}.pr-dot-pending{background:#FAAE13}
.pr-bars{min-height:300px;max-height:420px;overflow:auto}.pr-bar-item{list-style:none}.pr-bar-copy{min-width:0}.pr-bar-shop{color:var(--zcs-primary-text-color)}.pr-bar-shop:hover{color:var(--zcs_brand_color)}.zcs-progress-bar{height:12px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color);min-width:2px}.pr-bar-amount{white-space:nowrap}
.pr-table-card{min-width:0}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1120px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}.pr-table-link{color:var(--zcs_brand_color);font-weight:500}.pr-table-link:hover{text-decoration:underline}.pr-reference{word-break:break-word}.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-yellow{background:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-nodata-wrapper{min-height:220px}.pr-zero-icon{font-size:30px;color:var(--zcs-teritiary-text-color)}.pr-mobile-list{display:none}.pr-mobile-card{box-shadow:0 2px 8px rgba(28,28,64,.04)}.pr-mobile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pr-mobile-field{padding-top:10px;border-top:1px solid var(--zcs_tertiary_border_color)}.pr-mobile-label{display:block;color:var(--zcs-teritiary-text-color);font-size:.75rem;margin-bottom:3px}.pr-mobile-actions{border-top:1px solid var(--zcs_tertiary_border_color);padding-top:12px}
@media(max-width:1100px){.pr-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pr-analytics-grid{grid-template-columns:1fr}.pr-donut-wrap{min-height:260px}}
@media(max-width:768px){.payout-report{padding:16px 20px}.pr-header{align-items:flex-start;flex-direction:column}.pr-header .zcs-button{width:100%}.pr-donut-wrap{flex-direction:column}.pr-table-desktop{display:none}.pr-mobile-list{display:flex}.pr-table-card{background:transparent;border:0}.pr-table-card>.pr-card-header{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.pr-table-body{padding:0}.zcs-nodata-wrapper{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}}
@media(max-width:576px){.pr-kpi-grid{grid-template-columns:1fr}.pr-kpi{min-height:auto}.pr-mobile-grid{grid-template-columns:1fr}}
</style>
<div class='payout-report zcs-box-border'>
	<header class='pr-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
		<div>
			<h1 class='zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Payout Report</h1>
			<p class='pr-subtitle zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-8 zcs-mb-0'>Live payable totals, payment exposure, and shop-level payout activity as of <%=zoho.currentdate.toString("dd-MMM-yyyy")%>.</p>
		</div>
		<a class='zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14' href='#Page:Upfitter_Payables_Hub'>
			<i class='zc-li-outline business-money-coins'></i><span>Open Payables</span>
		</a>
	</header>

	<section class='pr-kpi-grid' aria-label='Payout key performance indicators'>
		<article class='pr-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='pr-kpi-icon pr-violet zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline business-money-13 zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Total payables</span></div>
			<div><div class='pr-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=totalPayables.round(2)%></div><div class='pr-kpi-meta zcs-font-13'><%=payableCount%> payable<%=if(payableCount == 1,"","s")%> recorded</div></div>
		</article>
		<article class='pr-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='pr-kpi-icon pr-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Approved outstanding</span></div>
			<div><div class='pr-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=approvedOutstanding.round(2)%></div><div class='pr-kpi-meta zcs-font-13'><%=approvedCount%> approved awaiting payment</div></div>
		</article>
		<article class='pr-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='pr-kpi-icon pr-yellow zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-2-time zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Pending approval</span></div>
			<div><div class='pr-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=pendingApproval.round(2)%></div><div class='pr-kpi-meta zcs-font-13'><%=pendingCount%> pending review</div></div>
		</article>
		<article class='pr-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='pr-kpi-icon pr-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline arrows-2-up-arrow zcs-font-24'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Paid this month</span></div>
			<div><div class='pr-kpi-value zcs-font-24 zcs-font-semibold zcs-color-primary'>$<%=paidThisMonth.round(2)%></div><div class='pr-kpi-meta zcs-font-13'><%=paidThisMonthCount%> payment<%=if(paidThisMonthCount == 1,"","s")%> issued</div></div>
		</article>
	</section>

	<section class='pr-analytics-grid'>
		<article class='zcs-card zcs-flex zcs-direction-column'>
			<div class='pr-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Payment status</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Distribution of payable value by current status</p></div>
			<div class='pr-donut-wrap zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20 zcs-p-20 zcs-box-border'>
			<%if(totalPayables == 0){%>
				<div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='pr-zero-icon zc-li-outline business-money-coins'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No payables yet</h3><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Payment status will appear when payable records are created.</p></div></div>
			<%}else{%>
				<div class='pr-donut zcs-relative zcs-rounded-half zcs-flex zcs-align-items-center zcs-justify-center'><div class='pr-donut-center zcs-absolute zcs-text-center'><strong class='zcs-font-24 zcs-color-primary'><%=payableCount%></strong><div class='zcs-font-12 zcs-color-tertiary'>Payables</div></div></div>
				<ul class='pr-legend zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'>
					<li><span class='pr-dot pr-dot-paid zcs-rounded-half'></span><span class='zcs-font-14'>Paid</span><strong class='zcs-font-14'>$<%=paidTotal.round(2)%></strong></li>
					<li><span class='pr-dot pr-dot-approved zcs-rounded-half'></span><span class='zcs-font-14'>Approved</span><strong class='zcs-font-14'>$<%=approvedOutstanding.round(2)%></strong></li>
					<li><span class='pr-dot pr-dot-pending zcs-rounded-half'></span><span class='zcs-font-14'>Pending approval</span><strong class='zcs-font-14'>$<%=pendingApproval.round(2)%></strong></li>
				</ul>
			<%}%>
			</div>
		</article>

		<article class='zcs-card zcs-flex zcs-direction-column'>
			<div class='pr-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Payable by upfitter</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Total payable value by shop, scaled to the largest balance</p></div>
			<div class='pr-bars zcs-p-24 zcs-box-border'>
			<%if(upfitterWithPayablesCount == 0){%>
				<div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='pr-zero-icon zc-li-outline buildings-2-shop'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No shop payout data</h3><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Shop bars will appear after payables are calculated.</p></div></div>
			<%}else{%>
				<ul class='zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0'>
				<%for each shop in Upfitters[ID != 0] sort by Upfitter_Name asc
				{
						shopId = shop.ID;
						shopTotal = ifnull(Upfitter_Payables[Upfitter == shopId].sum(Payable_Amount),0);
						if(shopTotal > 0)
						{
								shopBarPct = (shopTotal * 100.0 / upfitterMax).round(2);
				%>
					<li class='pr-bar-item zcs-flex zcs-direction-column zcs-gap-8'>
						<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><a class='pr-bar-shop zcs-font-14 zcs-font-medium' href='#Page:Upfitter_Detail?Upfitter_ID=<%=shopId%>'><%=shop.Upfitter_Name%></a><strong class='pr-bar-amount zcs-font-14'>$<%=shopTotal.round(2)%></strong></div>
						<div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=shopBarPct%>%;'></div></div>
					</li>
				<%  }
				}%>
				</ul>
			<%}%>
			</div>
		</article>
	</section>

	<section class='pr-table-card zcs-card zcs-flex zcs-direction-column'>
		<div class='pr-card-header zcs-px-24 zcs-py-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Payable detail</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Program and payment detail across all shops</p></div><span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-14'><%=payableCount%> total</span></div>
		<div class='pr-table-body zcs-p-16 zcs-box-border'>
		<%if(payableCount == 0){%>
			<div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='pr-zero-icon zc-li-outline files-single-content-03'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No payable records</h3><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Approved vehicle completions will populate this report.</p></div></div>
		<%}else{%>
			<div class='pr-table-desktop zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full'>
					<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Upfitter</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Program</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Completed vehicles</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Rate</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Amount</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Terms</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Payment reference</th><th class='zcs-px-16 zcs-py-8 zcs-text-center zcs-font-14 zcs-font-medium'>Payable</th></tr></thead>
					<tbody>
					<%for each payable in Upfitter_Payables[ID != 0] sort by Payable_ID desc
					{
							shopName = "Not assigned";
							shopId = 0;
							if(payable.Upfitter != null){shopName = ifnull(payable.Upfitter.Upfitter_Name,"Not assigned");shopId = payable.Upfitter.ID;}
							programName = "Not assigned";
							if(payable.Program != null){programName = ifnull(payable.Program.Service_ID,"Not assigned");}
							termsText = ifnull(payable.Payment_Terms,"Not recorded");
							referenceText = ifnull(payable.Payment_Reference,"Not recorded");
							statusText = ifnull(payable.Payment_Status,"Pending Approval");
							badgeClass = "zcs-badge-yellow";
							if(statusText == "Approved"){badgeClass = "zcs-badge-blue";}
							if(statusText == "Paid"){badgeClass = "zcs-badge-green";}
					%>
						<tr>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14'><%if(shopId != 0){%><a class='pr-table-link' href='#Page:Upfitter_Detail?Upfitter_ID=<%=shopId%>'><%=shopName%></a><%}else{%><%=shopName%><%}%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-font-medium'><%=programName%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-text-right zcs-font-14'><%=ifnull(payable.Completed_Vehicles,0)%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-text-right zcs-font-14'>$<%=ifnull(payable.Per_Vehicle_Rate,0).round(2)%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-text-right zcs-font-14 zcs-font-semibold'>$<%=ifnull(payable.Payable_Amount,0).round(2)%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14'><%=termsText%></td>
							<td class='zcs-px-16 zcs-py-12'><span class='zcs-badge zcs-badge-filled <%=badgeClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=statusText%></span></td>
							<td class='pr-reference zcs-px-16 zcs-py-12 zcs-font-14'><%=referenceText%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-text-center'><a class='pr-table-link zcs-inline-flex zcs-align-items-center zcs-gap-6' href='#Page:Upfitter_Payables_Hub'><i class='zc-li-outline arrows-1-tail-right'></i><span>Open</span></a></td>
						</tr>
					<%}%>
					</tbody>
				</table>
			</div>

			<div class='pr-mobile-list zcs-direction-column zcs-gap-12'>
			<%for each payable in Upfitter_Payables[ID != 0] sort by Payable_ID desc
			{
					shopName = "Not assigned";
					shopId = 0;
					if(payable.Upfitter != null){shopName = ifnull(payable.Upfitter.Upfitter_Name,"Not assigned");shopId = payable.Upfitter.ID;}
					programName = "Not assigned";
					if(payable.Program != null){programName = ifnull(payable.Program.Service_ID,"Not assigned");}
					termsText = ifnull(payable.Payment_Terms,"Not recorded");
					referenceText = ifnull(payable.Payment_Reference,"Not recorded");
					statusText = ifnull(payable.Payment_Status,"Pending Approval");
					badgeClass = "zcs-badge-yellow";
					if(statusText == "Approved"){badgeClass = "zcs-badge-blue";}
					if(statusText == "Paid"){badgeClass = "zcs-badge-green";}
			%>
				<article class='pr-mobile-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
					<div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12'><div><div class='zcs-font-12 zcs-color-tertiary'>UPFITTER</div><%if(shopId != 0){%><a class='pr-table-link zcs-font-16' href='#Page:Upfitter_Detail?Upfitter_ID=<%=shopId%>'><%=shopName%></a><%}else{%><strong class='zcs-font-16'><%=shopName%></strong><%}%><div class='zcs-font-13 zcs-color-tertiary zcs-mt-4'><%=programName%></div></div><span class='zcs-badge zcs-badge-filled <%=badgeClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=statusText%></span></div>
					<div class='pr-mobile-grid'><div class='pr-mobile-field'><span class='pr-mobile-label'>Completed vehicles</span><strong class='zcs-font-14'><%=ifnull(payable.Completed_Vehicles,0)%></strong></div><div class='pr-mobile-field'><span class='pr-mobile-label'>Rate</span><strong class='zcs-font-14'>$<%=ifnull(payable.Per_Vehicle_Rate,0).round(2)%></strong></div><div class='pr-mobile-field'><span class='pr-mobile-label'>Amount</span><strong class='zcs-font-14'>$<%=ifnull(payable.Payable_Amount,0).round(2)%></strong></div><div class='pr-mobile-field'><span class='pr-mobile-label'>Terms</span><strong class='zcs-font-14'><%=termsText%></strong></div><div class='pr-mobile-field'><span class='pr-mobile-label'>Payment reference</span><strong class='zcs-font-14'><%=referenceText%></strong></div></div>
					<div class='pr-mobile-actions'><a class='pr-table-link zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-font-14' href='#Page:Upfitter_Payables_Hub'><i class='zc-li-outline arrows-1-tail-right'></i><span>Open payable workspace</span></a></div>
				</article>
			<%}%>
			</div>
		<%}%>
		</div>
	</section>
</div>