<%
programId = input.Program_ID;
programRecord = Programs[ID == programId];
if(programRecord.count() == 0)
{
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-p-24{padding:1.5rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-xl{border-radius:.75rem}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.program-empty{min-height:280px;background:var(--zcs-page-bg-color);padding:15px}
</style>
<div class='program-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-box-border'>
	<div class='zcs-card zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-12 zcs-p-24 zcs-rounded-xl zcs-box-border'>
		<i class='zc-li-outline ui-1-search-zoom-out zcs-font-18 zcs-color-tertiary'></i>
		<h2 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'>Program not available</h2>
		<p class='zcs-font-14 zcs-lh-body zcs-color-tertiary zcs-m-0'>The program does not exist or is not accessible to the current user.</p>
	</div>
</div>
<%
}
else
{
		statusValue = ifnull(programRecord.Program_Status,"Request Intake");
		statusClass = "zcs-badge-theme";
		if(statusValue == "Closed")
		{
				statusClass = "zcs-badge-green";
		}
		else if(statusValue == "In Execution" || statusValue == "PO Received")
		{
				statusClass = "zcs-badge-blue";
		}
		else if(statusValue == "Pending Estimates" || statusValue == "Pending Quote Approval")
		{
				statusClass = "zcs-badge-orange";
		}

		estimateCount = Estimates[Program == programId].count();
		approvedEstimateCount = Estimates[Program == programId && Status == "Approved"].count();
		quoteCount = Quotes[Program == programId].count();
		approvedQuotes = Quotes[Program == programId && Status == "Approved"];
		approvedQuoteCount = approvedQuotes.count();
		poCount = Purchase_Orders[Program == programId].count();
		vehicleCount = Vehicles[Program == programId].count();
		approvedVehicleCount = Vehicles[Program == programId && QC_Status == "Approved"].count();

		canEdit = statusValue != "Closed";
		canAddVehicle = statusValue != "Closed";
		canGenerateQuote = estimateCount > 0 && estimateCount == approvedEstimateCount && quoteCount == 0;
		canIssuePO = approvedQuoteCount > 0 && poCount == 0;
		canClose = vehicleCount > 0 && vehicleCount == approvedVehicleCount && statusValue != "Closed" && (programRecord.Closeout_Document == null || programRecord.Completion_Report == null);

		pageReturn = "%23Page%3AProgram_Detail%3FProgram_ID%3D" + programId;
		commonDialog = "&zc_LoadIn=dialog&zc_Header=false&zc_OpenUrlIn=same%20window&zc_NextUrl=" + pageReturn;
		editUrl = "#Form:Programs?recLinkID=" + programId + "&viewLinkName=All_Programs" + commonDialog + "&zc_SuccMsg=Program%20updated%20successfully";
		vehicleUrl = "#Form:Vehicles?Program=" + programId + commonDialog + "&zc_SuccMsg=Vehicle%20added%20successfully";
		quoteUrl = "#Form:Quotes?Program=" + programId + commonDialog + "&zc_SuccMsg=Quote%20generated%20successfully";
		approvedQuoteId = 0;
		if(approvedQuoteCount > 0)
		{
				approvedQuoteId = approvedQuotes.ID;
		}
		poUrl = "#Form:Purchase_Orders?Program=" + programId + "&Quote=" + approvedQuoteId + commonDialog + "&zc_SuccMsg=Purchase%20order%20issued%20successfully";
		closeUrl = "#Form:Programs?recLinkID=" + programId + "&viewLinkName=All_Programs&Program_Status=Closed" + commonDialog + "&zc_SuccMsg=Program%20closed%20successfully";
		documentUrl = "#Form:Programs?recLinkID=" + programId + "&viewLinkName=All_Programs&zc_LoadIn=dialog&zc_Header=false";

		clientName = "";
		if(programRecord.FMC_Client != null)
		{
				clientName = ifnull(programRecord.FMC_Client.Client_Name,"");
		}
		completionAvailable = programRecord.Completion_Report != null;
		closeoutAvailable = programRecord.Closeout_Document != null;
%>
<style>
/* ZCS global utilities used by this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-black-color:#000;font-size:16px;line-height:1.5;--column-gap:0px}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0}.zcs-col-3{flex:0 0 25%;max-width:25%}.zcs-col-4{flex:0 0 33.333%;max-width:33.333%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-15{padding:.9375rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-6{padding-left:.375rem;padding-right:.375rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-overflow-auto{overflow:auto}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-list-none{list-style:none}a{text-decoration:none}
/* ZCS button */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}
/* ZCS badge */
.zcs-badge{width:max-content;white-space:nowrap}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-badge-filled.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background:#F4660C;border-color:#F4660C;color:#fff}
/* ZCS horizontal tab */
.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style:none;border-bottom:1px solid transparent}.zcs-horizontal-tablink{white-space:nowrap}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}
/* Program detail adaptation of ZCS 360 view */
.program-detail-page{min-height:100%;background:var(--zcs-page-bg-color);font-size:14px}.program-page-header{background:var(--zcs-white-color);border-bottom:1px solid var(--zcs-border-color);position:sticky;top:0;z-index:5}.program-title-block{min-width:0}.program-actions{justify-content:flex-end}.program-page-content{padding:15px}.program-summary{background:var(--zcs-white-color)}.program-summary-top{min-width:0}.program-kicker{letter-spacing:.08em;text-transform:uppercase}.program-details-grid{background:#F9FAFE}.program-detail-item{min-width:0}.program-detail-value{overflow-wrap:anywhere}.program-note{border-left:3px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.program-section-nav{position:sticky;top:69px;z-index:4;background:var(--zcs-white-color)}.program-content-grid{align-items:flex-start}.program-main-column{flex:1 1 680px;min-width:0}.program-side-column{flex:1 1 320px;min-width:280px;max-width:420px}.program-section{scroll-margin-top:125px}.program-section-heading{border-bottom:1px solid var(--zcs-border-color)}.program-embed{min-height:220px;overflow:auto}.program-embed>div{min-height:210px}.program-report .view-outer-wrapper,.program-report .reportfullwidth,.program-report .zc-reporttype-list,.program-report .list-view-inner{border-radius:0 0 12px 12px}.program-report .view-header-reportlist{display:none}.program-document{border:1px solid var(--zcs-border-color);background:#F9FAFE}.program-document-icon{width:38px;height:38px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);flex:0 0 38px}.program-doc-meta{min-width:0}.program-doc-link{color:var(--zcs_brand_color)}.program-doc-link:hover{text-decoration:underline}.program-empty-state{min-height:120px}.program-section-count{background:var(--zcs-page-bg-color);min-width:20px}.program-sensitive{border-top:1px solid var(--zcs-border-color)}
@media(max-width:992px){.zcs-col-md-6{flex:0 0 50%;max-width:50%}.program-page-header{position:static}.program-section-nav{top:0}.program-side-column{max-width:none;flex-basis:100%}}
@media(max-width:768px){.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.program-page-header{padding:14px 15px;align-items:flex-start;flex-direction:column}.program-actions{width:100%;justify-content:flex-start;overflow-x:auto;padding-bottom:2px}.program-actions .zcs-button{min-width:36px}.program-actions .zcs-button-text{display:inline}.program-page-content{padding:12px}.program-summary{padding:18px}.program-details-grid{padding:8px}.program-detail-item{padding:10px}.program-section-nav{position:static}.program-content-grid{gap:12px}.program-side-column{min-width:0}.program-embed{min-height:180px}.program-section{scroll-margin-top:10px}}
@media(max-width:576px){.zcs-col-xs-12{flex:0 0 100%;max-width:100%}.program-actions .zcs-button{width:100%;min-width:100%}.program-actions{display:grid;grid-template-columns:1fr}.program-section-heading{align-items:flex-start}.program-summary-top{align-items:flex-start;flex-direction:column}.program-section{padding:14px}.program-section-nav{padding-left:4px;padding-right:4px}}
</style>
<div class='program-detail-page zcs-wh-full zcs-flex zcs-direction-column'>
	<div class='program-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border'>
		<div class='program-title-block zcs-flex zcs-direction-column zcs-gap-4'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-8'>
				<a href='#Page:Program_Workspace' class='zcs-color-tertiary' aria-label='Back to programs'><i class='zc-li-outline arrows-1-tail-left zcs-font-18'></i></a>
				<span class='program-kicker zcs-font-12 zcs-font-semibold zcs-color-tertiary'>Program detail</span>
			</div>
			<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'>
				<h1 class='zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=ifnull(programRecord.Service_ID,"")%></h1>
				<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>'>
					<span class='zcs-badge-text zcs-font-13 zcs-font-medium zcs-lh-body'><%=statusValue%></span>
				</div>
			</div>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=ifnull(programRecord.Program_Name,"")%></p>
		</div>
		<div class='program-actions zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'>
			<% if(canEdit) { %>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=editUrl%>'>
				<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span class='zcs-button-text'>Edit</span>
			</a>
			<% } %>
			<% if(canAddVehicle) { %>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=vehicleUrl%>'>
				<i class='zcs-button-icon zc-li-outline transport-car'></i><span class='zcs-button-text'>Add Vehicle</span>
			</a>
			<% } %>
			<% if(canGenerateQuote) { %>
			<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=quoteUrl%>'>
				<i class='zcs-button-icon zc-li-outline arrows-1-refresh-69'></i><span class='zcs-button-text'>Generate Quote</span>
			</a>
			<% } %>
			<% if(canIssuePO) { %>
			<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=poUrl%>'>
				<i class='zcs-button-icon zc-li-outline files-single-content-03'></i><span class='zcs-button-text'>Issue PO</span>
			</a>
			<% } %>
			<% if(canClose) { %>
			<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=closeUrl%>'>
				<i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span class='zcs-button-text'>Close Program</span>
			</a>
			<% } %>
		</div>
	</div>

	<div class='program-page-content zcs-flex zcs-direction-column zcs-gap-15 zcs-box-border'>
		<section class='program-summary zcs-card zcs-flex zcs-direction-column zcs-gap-20 zcs-p-24 zcs-box-border'>
			<div class='program-summary-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
				<div>
					<h2 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Program overview</h2>
					<p class='zcs-font-14 zcs-lh-body zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Core program information and lifecycle position.</p>
				</div>
				<span class='zcs-font-13 zcs-color-tertiary'>Record <%=programId%></span>
			</div>
			<div class='program-details-grid zcs-row zcs-rounded-xl zcs-p-8 zcs-box-border'>
				<div class='program-detail-item zcs-col-3 zcs-col-md-6 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'>
					<span class='zcs-font-13 zcs-color-tertiary'>Service ID</span><strong class='program-detail-value zcs-font-16 zcs-font-semibold zcs-color-primary'><%=ifnull(programRecord.Service_ID,"—")%></strong>
				</div>
				<div class='program-detail-item zcs-col-3 zcs-col-md-6 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'>
					<span class='zcs-font-13 zcs-color-tertiary'>Client</span><strong class='program-detail-value zcs-font-16 zcs-font-semibold zcs-color-primary'><%=clientName%></strong>
				</div>
				<div class='program-detail-item zcs-col-3 zcs-col-md-6 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'>
					<span class='zcs-font-13 zcs-color-tertiary'>Request date</span><strong class='program-detail-value zcs-font-16 zcs-font-semibold zcs-color-primary'><%=ifnull(programRecord.Request_Date,"—")%></strong>
				</div>
				<div class='program-detail-item zcs-col-3 zcs-col-md-6 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'>
					<span class='zcs-font-13 zcs-color-tertiary'>Region / market</span><strong class='program-detail-value zcs-font-16 zcs-font-semibold zcs-color-primary'><%=ifnull(programRecord.Region_Market,"—")%></strong>
				</div>
				<div class='program-detail-item zcs-col-3 zcs-col-md-6 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'>
					<span class='zcs-font-13 zcs-color-tertiary'>Vehicles</span><strong class='program-detail-value zcs-font-16 zcs-font-semibold zcs-color-primary'><%=ifnull(programRecord.Vehicle_Count,vehicleCount)%></strong>
				</div>
				<div class='program-detail-item zcs-col-3 zcs-col-md-6 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'>
					<span class='zcs-font-13 zcs-color-tertiary'>Current status</span><strong class='program-detail-value zcs-font-16 zcs-font-semibold zcs-color-primary'><%=statusValue%></strong>
				</div>
				<% if(programRecord.Markup_Percent != null) { %>
				<div class='program-detail-item zcs-col-3 zcs-col-md-6 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'>
					<span class='zcs-font-13 zcs-color-tertiary'>Markup</span><strong class='program-detail-value zcs-font-16 zcs-font-semibold zcs-color-primary'><%=programRecord.Markup_Percent%>%</strong>
				</div>
				<% } %>
			</div>
			<% if(programRecord.Internal_Notes != null && programRecord.Internal_Notes != "") { %>
			<div class='program-sensitive program-note zcs-rounded-lg zcs-p-16 zcs-box-border'>
				<div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline files-single-content-03 zcs-color-theme'></i><strong class='zcs-font-14 zcs-color-primary'>Internal notes</strong></div>
				<p class='zcs-font-14 zcs-lh-body zcs-color-secondary zcs-mt-8 zcs-mb-0'><%=programRecord.Internal_Notes%></p>
			</div>
			<% } %>
		</section>

		<nav class='program-section-nav zcs-card zcs-horizontal-tabpanel zcs-rounded-xl zcs-box-border' aria-label='Program sections'>
			<ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-8 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border'>
				<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium zcs-color-tertiary' href='#vehicles'><span>Vehicles</span><span class='program-section-count zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=vehicleCount%></span></a></li>
				<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium zcs-color-tertiary' href='#estimates'><span>Estimates</span><span class='program-section-count zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=estimateCount%></span></a></li>
				<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium zcs-color-tertiary' href='#quote'><span>Quote</span><span class='program-section-count zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=quoteCount%></span></a></li>
				<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium zcs-color-tertiary' href='#purchase-order'><span>Purchase Order</span><span class='program-section-count zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12 zcs-text-center'><%=poCount%></span></a></li>
				<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium zcs-color-tertiary' href='#documents'><span>Documents</span></a></li>
				<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium zcs-color-tertiary' href='#activity'><span>Activity</span></a></li>
			</ul>
		</nav>

		<div class='program-content-grid zcs-flex zcs-row-wrap zcs-gap-15'>
			<main class='program-main-column zcs-flex zcs-direction-column zcs-gap-15'>
				<section id='vehicles' class='program-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='program-section-heading zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-py-8'>
						<div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Vehicles</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>VINs, assignment, progress, and QC.</p></div>
						<% if(canAddVehicle) { %><a class='zcs-color-theme zcs-font-14 zcs-font-medium' href='<%=vehicleUrl%>'><i class='zc-li-outline ui-1-simple-add'></i> Add vehicle</a><% } %>
					</div>
					<div class='program-embed program-report zcs-overflow-auto' elName='zc-component' viewLinkName='All_Vehicles' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Program=<%=programId%>'></div>
				</section>

				<section id='estimates' class='program-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='program-section-heading zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Estimates</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Internal estimate records are surfaced only when report permissions allow access.</p></div>
					<div class='program-embed program-report zcs-overflow-auto' elName='zc-component' viewLinkName='All_Estimates' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Program=<%=programId%>'></div>
				</section>

				<section id='quote' class='program-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='program-section-heading zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-py-8'>
						<div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Quote</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Quote revisions, approval, totals, and PDF.</p></div>
						<% if(canGenerateQuote) { %><a class='zcs-color-theme zcs-font-14 zcs-font-medium' href='<%=quoteUrl%>'><i class='zc-li-outline arrows-1-refresh-69'></i> Generate quote</a><% } %>
					</div>
					<div class='program-embed program-report zcs-overflow-auto' elName='zc-component' viewLinkName='All_Quotes' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Program=<%=programId%>'></div>
				</section>

				<section id='purchase-order' class='program-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='program-section-heading zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-py-8'>
						<div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Purchase Order</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Client PO, acknowledgement, and Green Light status.</p></div>
						<% if(canIssuePO) { %><a class='zcs-color-theme zcs-font-14 zcs-font-medium' href='<%=poUrl%>'><i class='zc-li-outline files-single-content-03'></i> Issue PO</a><% } %>
					</div>
					<div class='program-embed program-report zcs-overflow-auto' elName='zc-component' viewLinkName='All_Purchase_Orders' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Program=<%=programId%>'></div>
				</section>
			</main>

			<aside class='program-side-column zcs-flex zcs-direction-column zcs-gap-15'>
				<section id='documents' class='program-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='program-section-heading zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Documents</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Generated program files and lifecycle documents.</p></div>
					<div class='zcs-flex zcs-direction-column zcs-gap-10 zcs-mt-12'>
						<div class='program-document zcs-flex zcs-align-items-center zcs-gap-12 zcs-rounded-lg zcs-p-12 zcs-box-border'>
							<div class='program-document-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline files-2-doc'></i></div>
							<div class='program-doc-meta zcs-col-common'><strong class='zcs-font-14 zcs-color-primary'>Completion report</strong><div class='zcs-font-13 zcs-color-tertiary'><%=if(completionAvailable,"Available","Not generated")%></div></div>
							<% if(completionAvailable) { %><a class='program-doc-link zcs-font-13 zcs-font-medium' href='<%=documentUrl%>'>Open</a><% } %>
						</div>
						<div class='program-document zcs-flex zcs-align-items-center zcs-gap-12 zcs-rounded-lg zcs-p-12 zcs-box-border'>
							<div class='program-document-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline files-2-doc'></i></div>
							<div class='program-doc-meta zcs-col-common'><strong class='zcs-font-14 zcs-color-primary'>Closeout document</strong><div class='zcs-font-13 zcs-color-tertiary'><%=if(closeoutAvailable,"Available","Not generated")%></div></div>
							<% if(closeoutAvailable) { %><a class='program-doc-link zcs-font-13 zcs-font-medium' href='<%=documentUrl%>'>Open</a><% } %>
						</div>
						<p class='zcs-font-12 zcs-color-tertiary zcs-m-0'>Quote PDFs and PO acknowledgement files are available in their related records above.</p>
					</div>
				</section>

				<section id='issues' class='program-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='program-section-heading zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Issues</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Internal exception tracking is surfaced only when report permissions allow access.</p></div>
					<div class='program-embed program-report zcs-overflow-auto' elName='zc-component' viewLinkName='All_Issues' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Program=<%=programId%>'></div>
				</section>
			</aside>
		</div>

		<section id='activity' class='program-section zcs-card zcs-p-20 zcs-box-border'>
			<div class='program-section-heading zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Program activity</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Newest lifecycle and audit events for this program.</p></div>
			<div class='program-embed program-report zcs-overflow-auto' elName='zc-component' viewLinkName='Program_Activity_Log' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_EditRec=false&amp;zc_DelRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Program=<%=programId%>'></div>
		</section>
	</div>
</div>
<%

%>