<%
isAdmin = thisapp.permissions.isUserInProfile("Internal_Admin");
outstandingInvoices = Client_Invoices[Payment_Status != "Paid"] sort by Due_Date asc;
outstandingTotal = 0.0;
bucket0Total = 0.0;
bucket31Total = 0.0;
bucket46Total = 0.0;
bucket60Total = 0.0;
bucket0Count = 0;
bucket31Count = 0;
bucket46Count = 0;
bucket60Count = 0;
oldestDays = 0;
if(isAdmin)
{
		for each agingInvoice in outstandingInvoices
		{
				invoiceAmount = ifnull(agingInvoice.Invoice_Amount,0.0);
				ageAnchor = agingInvoice.Invoice_Date;
				if(ageAnchor == null)
				{
						ageAnchor = agingInvoice.Due_Date;
				}
				daysOutstanding = 0;
				if(ageAnchor != null)
				{
						daysOutstanding = ageAnchor.daysBetween(zoho.currentdate);
						if(daysOutstanding < 0)
						{
								daysOutstanding = 0;
						}
				}
				outstandingTotal = outstandingTotal + invoiceAmount;
				if(daysOutstanding <= 30)
				{
						bucket0Total = bucket0Total + invoiceAmount;
						bucket0Count = bucket0Count + 1;
				}
				else if(daysOutstanding <= 45)
				{
						bucket31Total = bucket31Total + invoiceAmount;
						bucket31Count = bucket31Count + 1;
				}
				else if(daysOutstanding <= 60)
				{
						bucket46Total = bucket46Total + invoiceAmount;
						bucket46Count = bucket46Count + 1;
				}
				else
				{
						bucket60Total = bucket60Total + invoiceAmount;
						bucket60Count = bucket60Count + 1;
				}
				if(daysOutstanding > oldestDays)
				{
						oldestDays = daysOutstanding;
				}
		}
}
chartMax = bucket0Total;
if(bucket31Total > chartMax){chartMax = bucket31Total;}
if(bucket46Total > chartMax){chartMax = bucket46Total;}
if(bucket60Total > chartMax){chartMax = bucket60Total;}
if(chartMax <= 0){chartMax = 1.0;}
bucket0Height = (bucket0Total * 100.0 / chartMax).round(2);
bucket31Height = (bucket31Total * 100.0 / chartMax).round(2);
bucket46Height = (bucket46Total * 100.0 / chartMax).round(2);
bucket60Height = (bucket60Total * 100.0 / chartMax).round(2);
bucket0Pct = 0.0;
bucket31Pct = 0.0;
bucket46Pct = 0.0;
bucket60Pct = 0.0;
if(outstandingTotal > 0)
{
		bucket0Pct = (bucket0Total * 100.0 / outstandingTotal).round(2);
		bucket31Pct = (bucket31Total * 100.0 / outstandingTotal).round(2);
		bucket46Pct = (bucket46Total * 100.0 / outstandingTotal).round(2);
		bucket60Pct = (bucket60Total * 100.0 / outstandingTotal).round(2);
}
%>
<style>
/* zcs-global utility sheet: included once for this standalone page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color,#6147E5);--zcs-light-bg-color:var(--zcs_brand_light_color,#F1EFFE);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color,#18202C);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#4B5563);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#697386);--zcs-white-color:#fff;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;font-size:16px;line-height:1.5}
*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-half,.zcs-rounded-full{border-radius:50%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color,#6147E5)}.zcs-color-white{color:#fff}.zcs-color-red{color:#FE455D}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-15{gap:15px}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-32{gap:2rem}.zcs-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color,#E7E7EE);border-radius:12px}a{text-decoration:none}
/* header-heading-with-actions and button-primary-outline-button */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#6147E5);background:#fff;color:var(--zcs_brand_color,#6147E5)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color,#F1EFFE);border-color:var(--zcs_brand_color,#6147E5);color:var(--zcs_brand_color,#6147E5)}.zcs-button-icon{width:16px;max-height:16px}
/* chart-bar-chart */
.zcs-chart ul li{list-style:none}.zcs-chart-y-axis-text{width:66px}.zcs-chart-y-axis-line{border-top:1px dashed #EBECF0}.zcs-scrollable-container{top:10px;left:66px;width:calc(100% - 66px);height:calc(100% + 12px);overflow-x:auto;overflow-y:hidden}.zcs-chart-x-axis{min-width:480px}.zcs-chart-x-axis>li{width:92px}.zcs-chart-x-axis-text{max-width:92px}.zcs-bar-value{width:36px;border-radius:6px 6px 0 0;background:#6147E5}.zcs-chart-x-axis>li:nth-child(2) .zcs-bar-value{background:#2A6FFC}.zcs-chart-x-axis>li:nth-child(3) .zcs-bar-value{background:#F4660C}.zcs-chart-x-axis>li:nth-child(4) .zcs-bar-value{background:#FE455D}
/* chart-donut-chart-with-text */
.zcs-legend-wrapper li{list-style:none}.zcs-legend-wrapper li label{min-width:112px}.zcs-legend-wrapper li label:before{content:'';display:inline-block;vertical-align:top;width:12px;height:12px;margin:4px 10px 4px 0;border-radius:50%}.zcs-legend-wrapper li:nth-child(1) label:before{background:#6147E5}.zcs-legend-wrapper li:nth-child(2) label:before{background:#2A6FFC}.zcs-legend-wrapper li:nth-child(3) label:before{background:#F4660C}.zcs-legend-wrapper li:nth-child(4) label:before{background:#FE455D}.zcs-donut-chart-wrapper{--donut-cx:90px;--donut-cy:90px;--donut-r:70;--donut-stroke_width:20;--donut-pi:3.1416;--donut-a1:<%=bucket0Pct%>;--donut-a2:<%=bucket31Pct%>;--donut-a3:<%=bucket46Pct%>;--donut-a4:<%=bucket60Pct%>;--donut-space_value:0;--donut-donut_size:180px}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg{width:var(--donut-donut_size);height:var(--donut-donut_size);overflow:hidden;transform:rotate(-90deg)}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle{cx:var(--donut-cx);cy:var(--donut-cy);stroke-width:var(--donut-stroke_width);fill:transparent}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(1){stroke:#6147E5;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * (1 - var(--donut-a1) / 100));stroke-dashoffset:0}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(2){stroke:#2A6FFC;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * (1 - var(--donut-a2) / 100));stroke-dashoffset:calc(-2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(3){stroke:#F4660C;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * (1 - var(--donut-a3) / 100));stroke-dashoffset:calc(-2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2)) / 100)}.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(4){stroke:#FE455D;stroke-dasharray:calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * (1 - var(--donut-a4) / 100));stroke-dashoffset:calc(-2 * var(--donut-pi) * var(--donut-r) * (var(--donut-a1) + var(--donut-a2) + var(--donut-a3)) / 100)}
/* table-table-with-custom-action-button-icon */
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color,#E7E7EE);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1120px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper thead th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color,#E7E7EE) inset;white-space:nowrap}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs_tertiary_border_color,#E7E7EE)}.zcs-table-wrapper tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}.zcs-custom-action-icon{color:#6147E5}.zcs-custom-action-icon:hover{color:#4129B9}
/* badge-filled-badge */
.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-theme{background:#6147E5;border-color:#6147E5;color:#fff}.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-red{background:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-yellow{background:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}
.ar-page{min-height:100%;padding:15px;background:var(--zcs-page-bg-color);font-family:inherit;font-size:14px;color:var(--zcs-primary-text-color)}.ar-header{background:linear-gradient(120deg,#6147E5,#4129B9);border:0;overflow:hidden;position:relative}.ar-header:after{content:'';position:absolute;width:220px;height:220px;border:38px solid rgba(255,255,255,.08);border-radius:50%;right:-65px;top:-105px}.ar-header-content{position:relative;z-index:1}.ar-header-icon{width:44px;height:44px;flex:0 0 44px;background:rgba(255,255,255,.16)}.ar-header-copy{min-width:0}.ar-header-subtitle{max-width:760px;color:rgba(255,255,255,.86)}.ar-header-action{background:#fff;color:#6147E5;border-color:#fff}.ar-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:15px;margin:15px 0}.ar-kpi{min-height:132px}.ar-kpi-danger{border-color:#FE455D;background:#FFF8F9}.ar-kpi-icon{width:40px;height:40px;flex:0 0 40px}.ar-violet{background:#F1EFFE;color:#6147E5}.ar-blue{background:#E8EFFF;color:#2A6FFC}.ar-orange{background:#F8F0EB;color:#F4660C}.ar-red{background:#FDE3E6;color:#D92D48}.ar-slate{background:#EEF0F5;color:#4B5563}.ar-charts{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(340px,.65fr);gap:15px;margin-bottom:15px}.ar-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color,#E7E7EE)}.ar-bar-body{height:330px}.ar-donut-body{min-height:330px}.ar-table-card{min-width:0}.ar-row-danger td{background:#FFF8F9}.ar-days-danger{color:#D92D48;font-weight:600}.ar-empty{min-height:260px}.ar-empty-icon,.ar-denied-icon{font-size:30px;color:#6147E5}.ar-denied{min-height:360px;margin:15px}.ar-client-cell{max-width:200px}.ar-nowrap{white-space:nowrap}.ar-row-link:hover{text-decoration:underline}
@media(max-width:1280px){.ar-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:992px){.ar-charts{grid-template-columns:1fr}.ar-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:768px){.ar-page{padding:12px}.ar-header{padding:18px}.ar-header-content{align-items:flex-start;flex-direction:column}.ar-header-action{width:100%}.ar-donut-body{min-height:280px}.zcs-donut-chart-wrapper{flex-direction:column}.ar-bar-body{height:300px}}@media(max-width:520px){.ar-kpis{grid-template-columns:1fr}.ar-header-icon{display:none}.ar-kpi{min-height:auto}}
</style>
<%if(!isAdmin){%>
<div class='ar-page zcs-box-border'><section class='ar-denied zcs-card zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-24'><div><i class='ar-denied-icon zc-li-outline ui-1-lock'></i><h1 class='zcs-font-24 zcs-font-semibold zcs-color-primary zcs-mt-10 zcs-mb-0'>Internal Admin access required</h1><p class='zcs-font-14 zcs-color-tertiary zcs-mt-8 zcs-mb-0'>Accounts receivable aging data is restricted to the Internal Admin profile.</p></div></section></div>
<%}else{%>
<div class='ar-page zcs-box-border'>
	<header class='ar-header zcs-card zcs-w-full zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='ar-header-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'><span class='ar-header-icon zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg zcs-color-white'><i class='zc-li-outline business-chart-bar-32 zcs-font-22'></i></span><div class='ar-header-copy'><div class='zcs-font-12 zcs-font-semibold' style='color:rgba(255,255,255,.78)'>FINANCIAL ANALYTICS</div><h1 class='zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-white zcs-m-0'>AR Aging Report</h1><p class='ar-header-subtitle zcs-font-14 zcs-mt-4 zcs-mb-0'>Outstanding client invoices aged from invoice date, with due-date context as of <%=zoho.currentdate.toString("dd-MMM-yyyy")%>.</p></div></div>
			<a class='ar-header-action zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='#Page:Invoices'><i class='zcs-button-icon zc-li-outline files-single-content-03'></i><span>View invoices</span></a>
		</div>
	</header>

	<section class='ar-kpis' aria-label='Accounts receivable aging totals'>
		<article class='ar-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='ar-kpi-icon ar-slate zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline business-money-13 zcs-font-20'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Total outstanding</span></div><div><strong class='zcs-font-24 zcs-color-primary'>$<%=outstandingTotal.round(2)%></strong><div class='zcs-font-13 zcs-color-tertiary'><%=outstandingInvoices.count()%> open invoice<%=if(outstandingInvoices.count() == 1,"","s")%></div></div></article>
		<article class='ar-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='ar-kpi-icon ar-violet zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-2-time zcs-font-20'></i></span><span class='zcs-font-14 zcs-color-tertiary'>0-30 days</span></div><div><strong class='zcs-font-24 zcs-color-primary'>$<%=bucket0Total.round(2)%></strong><div class='zcs-font-13 zcs-color-tertiary'><%=bucket0Count%> invoice<%=if(bucket0Count == 1,"","s")%></div></div></article>
		<article class='ar-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='ar-kpi-icon ar-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-2-time zcs-font-20'></i></span><span class='zcs-font-14 zcs-color-tertiary'>31-45 days</span></div><div><strong class='zcs-font-24 zcs-color-primary'>$<%=bucket31Total.round(2)%></strong><div class='zcs-font-13 zcs-color-tertiary'><%=bucket31Count%> invoice<%=if(bucket31Count == 1,"","s")%></div></div></article>
		<article class='ar-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='ar-kpi-icon ar-orange zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-2-time zcs-font-20'></i></span><span class='zcs-font-14 zcs-color-tertiary'>46-60 days</span></div><div><strong class='zcs-font-24 zcs-color-primary'>$<%=bucket46Total.round(2)%></strong><div class='zcs-font-13 zcs-color-tertiary'><%=bucket46Count%> invoice<%=if(bucket46Count == 1,"","s")%></div></div></article>
		<article class='ar-kpi ar-kpi-danger zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='ar-kpi-icon ar-red zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-solid ui-2-time zcs-font-20'></i></span><span class='zcs-font-14 zcs-color-red'>60+ days</span></div><div><strong class='zcs-font-24 zcs-color-red'>$<%=bucket60Total.round(2)%></strong><div class='zcs-font-13 zcs-color-red'><%=bucket60Count%> invoice<%=if(bucket60Count == 1,"","s")%> · oldest <%=oldestDays%> days</div></div></article>
	</section>

	<%if(outstandingInvoices.count() == 0){%>
	<section class='ar-empty zcs-card zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-24'><div class='zcs-nodata-content'><i class='ar-empty-icon zc-li-outline ui-1-check-circle-08'></i><h2 class='zcs-font-20 zcs-font-semibold zcs-color-primary zcs-mt-10 zcs-mb-0'>No outstanding receivables</h2><p class='zcs-font-14 zcs-color-tertiary zcs-mt-8 zcs-mb-0'>All client invoices are marked Paid. New unpaid, partial, or overdue invoices will appear here automatically.</p></div></section>
	<%}else{%>
	<section class='ar-charts'>
		<article class='zcs-card zcs-flex zcs-direction-column'>
			<div class='ar-card-header zcs-px-24 zcs-py-16'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Outstanding amount by age</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Bucket values scaled to the largest outstanding balance</p></div>
			<div class='ar-bar-body zcs-p-20'><div class='zcs-chart zcs-w-full zcs-wh-full zcs-barchart-wrapper zcs-relative'><ul class='zcs-chart-y-axis zcs-flex zcs-direction-column zcs-gap-32 zcs-m-0 zcs-p-0'><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-11 zcs-color-tertiary'>$<%=chartMax.round(0)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-11 zcs-color-tertiary'>$<%=(chartMax*.8).round(0)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-11 zcs-color-tertiary'>$<%=(chartMax*.6).round(0)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-11 zcs-color-tertiary'>$<%=(chartMax*.4).round(0)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-11 zcs-color-tertiary'>$<%=(chartMax*.2).round(0)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-11 zcs-color-tertiary'>$0</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li></ul><div class='zcs-scrollable-container zcs-absolute'><ul class='zcs-chart-x-axis zcs-wh-full zcs-flex zcs-justify-space-between zcs-gap-12 zcs-m-0 zcs-p-0'><li class='zcs-flex zcs-direction-column zcs-gap-12'><div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'><span class='zcs-bar-value' title='$<%=bucket0Total.round(2)%>' style='height:<%=bucket0Height%>%'></span></div><span class='zcs-chart-x-axis-text zcs-font-13 zcs-color-primary zcs-text-center'>0-30</span></li><li class='zcs-flex zcs-direction-column zcs-gap-12'><div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'><span class='zcs-bar-value' title='$<%=bucket31Total.round(2)%>' style='height:<%=bucket31Height%>%'></span></div><span class='zcs-chart-x-axis-text zcs-font-13 zcs-color-primary zcs-text-center'>31-45</span></li><li class='zcs-flex zcs-direction-column zcs-gap-12'><div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'><span class='zcs-bar-value' title='$<%=bucket46Total.round(2)%>' style='height:<%=bucket46Height%>%'></span></div><span class='zcs-chart-x-axis-text zcs-font-13 zcs-color-primary zcs-text-center'>46-60</span></li><li class='zcs-flex zcs-direction-column zcs-gap-12'><div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'><span class='zcs-bar-value' title='$<%=bucket60Total.round(2)%>' style='height:<%=bucket60Height%>%'></span></div><span class='zcs-chart-x-axis-text zcs-font-13 zcs-color-red zcs-text-center'>60+</span></li></ul></div></div></div>
		</article>
		<article class='zcs-card zcs-flex zcs-direction-column'>
			<div class='ar-card-header zcs-px-24 zcs-py-16'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Aging mix</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Share of total outstanding amount</p></div>
			<div class='ar-donut-body zcs-flex zcs-align-items-center zcs-justify-center'><div class='zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12 zcs-p-20 zcs-box-border'><div class='zcs-donut-chart zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative'><svg class='zcs-rounded-full'><circle r='70'></circle><circle r='70'></circle><circle r='70'></circle><circle r='70'></circle></svg><div class='zcs-donut-chart-name zcs-absolute zcs-text-center'><strong class='zcs-font-20 zcs-color-primary'>$<%=outstandingTotal.round(2)%></strong><div class='zcs-font-12 zcs-color-tertiary'>Outstanding</div></div></div><div class='zcs-legend-wrapper'><ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'><li class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><label class='zcs-font-14 zcs-color-primary'>0-30</label><strong class='zcs-font-13'><%=bucket0Pct%>%</strong></li><li class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><label class='zcs-font-14 zcs-color-primary'>31-45</label><strong class='zcs-font-13'><%=bucket31Pct%>%</strong></li><li class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><label class='zcs-font-14 zcs-color-primary'>46-60</label><strong class='zcs-font-13'><%=bucket46Pct%>%</strong></li><li class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><label class='zcs-font-14 zcs-color-red'>60+</label><strong class='zcs-font-13 zcs-color-red'><%=bucket60Pct%>%</strong></li></ul></div></div></div>
		</article>
	</section>

	<section class='ar-table-card zcs-card zcs-flex zcs-direction-column'>
		<div class='ar-card-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Outstanding invoice detail</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Oldest due dates first; days outstanding use invoice date and fall back to due date</p></div><span class='zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=outstandingInvoices.count()%> open</span></div>
		<div class='zcs-p-16'><div class='zcs-table-wrapper zcs-rounded-sm zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Client</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Program</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Invoice</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Due date</th><th class='zcs-px-12 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Days outstanding</th><th class='zcs-px-12 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Amount</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Status</th><th class='zcs-px-12 zcs-py-8 zcs-text-center zcs-font-14 zcs-font-medium'>Detail</th></tr></thead><tbody>
		<%for each detailInvoice in outstandingInvoices
		{
				detailProgram = "Not assigned";
				detailClient = "Not assigned";
				detailProgramId = 0;
				if(detailInvoice.Program != null)
				{
						detailProgramId = detailInvoice.Program.ID;
						detailProgram = ifnull(detailInvoice.Program.Service_ID,"Program");
						if(detailInvoice.Program.FMC_Client != null)
						{
								detailClient = ifnull(detailInvoice.Program.FMC_Client.Client_Name,"Not assigned");
						}
				}
				dueDateText = "Not set";
				if(detailInvoice.Due_Date != null){dueDateText = detailInvoice.Due_Date.toString("dd-MMM-yyyy");}
				detailAgeAnchor = detailInvoice.Invoice_Date;
				if(detailAgeAnchor == null){detailAgeAnchor = detailInvoice.Due_Date;}
				detailDays = 0;
				if(detailAgeAnchor != null){detailDays = detailAgeAnchor.daysBetween(zoho.currentdate);if(detailDays < 0){detailDays = 0;}}
				detailDanger = "";
				if(detailDays > 60){detailDanger = "ar-row-danger";}
				detailDaysClass = "";
				if(detailDays > 60){detailDaysClass = "ar-days-danger";}
				detailStatus = ifnull(detailInvoice.Payment_Status,"Unpaid");
				detailBadge = "zcs-badge-yellow";
				if(detailStatus == "Overdue"){detailBadge = "zcs-badge-red";}else if(detailStatus == "Partial"){detailBadge = "zcs-badge-blue";}
		%><tr class='<%=detailDanger%>'><td class='ar-client-cell zcs-px-12 zcs-py-12 zcs-font-14 zcs-font-medium'><%=detailClient%></td><td class='zcs-px-12 zcs-py-12'><%if(detailProgramId != 0){%><a class='ar-row-link zcs-font-14 zcs-font-medium zcs-color-theme' href='#Page:Program_Detail?Program_ID=<%=detailProgramId%>'><%=detailProgram%></a><%}else{%><span class='zcs-font-14 zcs-color-tertiary'><%=detailProgram%></span><%}%></td><td class='zcs-px-12 zcs-py-12 zcs-font-14 zcs-font-medium'><%=ifnull(detailInvoice.Invoice_Number,"Invoice")%></td><td class='ar-nowrap zcs-px-12 zcs-py-12 zcs-font-14'><%=dueDateText%></td><td class='zcs-px-12 zcs-py-12 zcs-text-right zcs-font-14 <%=detailDaysClass%>'><%=detailDays%></td><td class='ar-nowrap zcs-px-12 zcs-py-12 zcs-text-right zcs-font-14 zcs-font-medium'>$<%=ifnull(detailInvoice.Invoice_Amount,0.0).round(2)%></td><td class='zcs-px-12 zcs-py-12'><span class='zcs-badge zcs-badge-filled <%=detailBadge%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=detailStatus%></span></td><td class='zcs-px-12 zcs-py-12 zcs-text-center'><a class='zcs-custom-action-icon zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-half' href='#Page:Invoice_Detail?Invoice_ID=<%=detailInvoice.ID%>' title='Open invoice detail'><i class='zc-li-outline arrows-1-tail-right zcs-font-20'></i></a></td></tr><%}%>
		</tbody></table></div></div>
	</section>
	<%}%>
</div>
<%
%>