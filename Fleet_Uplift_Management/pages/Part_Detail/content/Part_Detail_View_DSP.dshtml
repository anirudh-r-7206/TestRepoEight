<%
partId = input.Part_ID;
partRecord = Parts[ID == partId];
if(partRecord.count() == 0)
{
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-gap-12{gap:.75rem}.zcs-p-24{padding:1.5rem}.zcs-m-0{margin:0}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-box-border{box-sizing:border-box}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.part-empty{min-height:300px;background:var(--zcs-page-bg-color);padding:15px}
</style>
<div class='part-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-box-border'>
	<div class='zcs-card zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-12 zcs-p-24 zcs-box-border'>
		<i class='zc-li-outline ui-1-search-zoom-out zcs-font-18 zcs-color-tertiary'></i>
		<h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Part not available</h2>
		<p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>The part does not exist or is not accessible to the current user.</p>
	</div>
</div>
<%
}
else
{
		statusValue = ifnull(partRecord.Status,"Active");
		statusClass = if(statusValue == "Active","zcs-badge-green","zcs-badge-grey");
		capabilityName = "Not provided";
		if(partRecord.Linked_Capability != null)
		{
				capabilityRecord = Capabilities[ID == partRecord.Linked_Capability];
				if(capabilityRecord.count() > 0)
				{
						capabilityName = ifnull(capabilityRecord.Capability_Name,"Not provided");
				}
		}
		usageLines = Estimate_Parts_Lines[Part == partId] sort by Estimate_Part_Line_ID descending;
		usageCount = usageLines.count();
		totalQuantity = ifnull(usageLines.sum(Quantity),0);
		totalExtended = ifnull(usageLines.sum(Line_Total),0.00);

		pageReturn = "%23Page%3APart_Detail%3FPart_ID%3D" + partId;
		dialogParams = "&zc_LoadIn=dialog&zc_Header=false&zc_OpenUrlIn=same%20window&zc_NextUrl=" + pageReturn;
		editUrl = "#Form:Parts?recLinkID=" + partId + "&viewLinkName=All_Parts" + dialogParams + "&zc_SuccMsg=Part%20updated%20successfully";
		statusUrl = "";
		statusAction = "";
		statusIcon = "";
		if(statusValue == "Active")
		{
				statusUrl = "#Form:Parts?recLinkID=" + partId + "&viewLinkName=All_Parts&Status=Discontinued" + dialogParams + "&zc_SuccMsg=Part%20discontinued%20successfully";
				statusAction = "Discontinue";
				statusIcon = "ui-1-circle-remove";
		}
		else if(statusValue == "Discontinued")
		{
				statusUrl = "#Form:Parts?recLinkID=" + partId + "&viewLinkName=All_Parts&Status=Active" + dialogParams + "&zc_SuccMsg=Part%20reactivated%20successfully";
				statusAction = "Reactivate";
				statusIcon = "ui-1-check-circle-08";
		}
%>
<style>
/* zcs-global: utility rules used by the ZCS components on this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-15{gap:.9375rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-15{padding:.9375rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}
/* ZCS button-primary-button and button-primary-outline-button */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}
/* ZCS badge-filled-badge */
.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-grey{background:#52525B;border-color:#52525B;color:#fff}.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}
/* ZCS label-value-key-value and notes-notes-simple */
.zcs-labelvalue-wrapper ul{list-style:none}.zcs-labelvalue-wrapper li{min-width:0}.zcs-notes-text{overflow-wrap:anywhere}.zcs-notes-title{display:inline}.zcs-notes-text a:hover{text-decoration:underline}
/* ZCS table-simple-table */
.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:820px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper tbody tr:first-child td{border-top-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}
/* Page composition */
.part-page{min-height:100%;background:var(--zcs-page-bg-color);font-size:14px}.part-header{background:#fff;border-bottom:1px solid var(--zcs-border-color);position:sticky;top:0;z-index:5}.part-title{min-width:0}.part-kicker{text-transform:uppercase;letter-spacing:.08em}.part-actions{justify-content:flex-end}.part-content{padding:15px}.part-hero{background:#fff}.part-icon{width:64px;height:64px;flex:0 0 64px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:28px}.part-identity{min-width:0}.part-stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.part-stat{min-width:0;background:#F9FAFE}.part-stat-value{font-size:20px;overflow-wrap:anywhere}.part-detail-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 24px}.part-detail-list li{display:grid;grid-template-columns:minmax(130px,40%) minmax(0,1fr);gap:12px}.part-section-head{border-bottom:1px solid var(--zcs-border-color)}.part-note{border-left:3px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.part-estimate-link{color:var(--zcs_brand_color)}.part-estimate-link:hover{text-decoration:underline}.part-nodata{min-height:130px}.part-mobile-meta{display:none}
@media(max-width:992px){.part-stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.part-header{position:static}.part-detail-list{grid-template-columns:1fr}}
@media(max-width:768px){.part-header{padding:14px 15px;align-items:flex-start;flex-direction:column}.part-actions{width:100%;justify-content:flex-start}.part-content{padding:12px}.part-hero{padding:18px}.part-hero-top{align-items:flex-start;flex-direction:column}.part-icon{width:52px;height:52px;flex-basis:52px}.part-table table{min-width:0}.part-table thead{display:none}.part-table tbody,.part-table tr,.part-table td{display:block;width:100%;box-sizing:border-box}.part-table tr{padding:12px;border-top:1px solid var(--zcs-border-color)}.part-table tr:first-child{border-top:0}.part-table td{border:0!important;padding:5px 0}.part-table td:before{content:attr(data-label);display:inline-block;width:42%;color:var(--zcs-teritiary-text-color);font-size:12px;vertical-align:top}.part-table td>a,.part-table td>span{display:inline-block;width:56%;text-align:left}.part-mobile-meta{display:inline}}
@media(max-width:576px){.part-actions{display:grid;grid-template-columns:1fr}.part-actions .zcs-button{width:100%;min-width:100%}.part-stat-grid{grid-template-columns:1fr}.part-detail-list li{grid-template-columns:1fr;gap:2px}.part-detail-list li label{font-size:12px}}
</style>
<div class='part-page zcs-wh-full zcs-flex zcs-direction-column'>
	<header class='part-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border'>
		<div class='part-title zcs-flex zcs-direction-column zcs-gap-4'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-8'><a href='#Page:Parts_Catalog' class='zcs-color-tertiary' aria-label='Back to parts catalog'><i class='zc-li-outline arrows-1-tail-left zcs-font-18'></i></a><span class='part-kicker zcs-font-12 zcs-font-semibold zcs-color-tertiary'>Part detail</span></div>
			<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'><h1 class='zcs-font-22 zcs-font-semibold zcs-color-primary zcs-m-0'><%=ifnull(partRecord.Part_Name,"Part")%></h1><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=statusClass%>'><%=statusValue%></span></div>
			<p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Catalog identity, sourcing, pricing, capability, lead time, and estimate usage.</p>
		</div>
		<div class='part-actions zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=editUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span class='zcs-button-text'>Edit</span></a>
			<% if(statusAction != "") { %><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=statusUrl%>'><i class='zcs-button-icon zc-li-outline <%=statusIcon%>'></i><span class='zcs-button-text'><%=statusAction%></span></a><% } %>
		</div>
	</header>

	<main class='part-content zcs-flex zcs-direction-column zcs-gap-15 zcs-box-border'>
		<section class='part-hero zcs-card zcs-flex zcs-direction-column zcs-gap-20 zcs-p-24 zcs-box-border'>
			<div class='part-hero-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
				<div class='part-identity zcs-flex zcs-align-items-center zcs-gap-16'>
					<div class='part-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-xl'><i class='zc-li-outline logistics-box-2'></i></div>
					<div><h2 class='zcs-font-20 zcs-font-semibold zcs-color-primary zcs-m-0'><%=ifnull(partRecord.Part_Name,"Part")%></h2><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Catalog ID <%=ifnull(partRecord.Part_ID,partId)%><% if(partRecord.Part_Number != null && partRecord.Part_Number != "") { %> &middot; Part <%=partRecord.Part_Number%><% } %></p></div>
				</div>
				<span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-blue'><%=capabilityName%></span>
			</div>
			<div class='part-stat-grid'>
				<div class='part-stat zcs-rounded-xl zcs-flex zcs-direction-column zcs-gap-4 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Unit price</span><strong class='part-stat-value zcs-color-primary'>$<%=ifnull(partRecord.Unit_Price,0.00)%></strong></div>
				<div class='part-stat zcs-rounded-xl zcs-flex zcs-direction-column zcs-gap-4 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Lead time</span><strong class='part-stat-value zcs-color-primary'><%=ifnull(partRecord.Lead_Time_Days,0)%> days</strong></div>
				<div class='part-stat zcs-rounded-xl zcs-flex zcs-direction-column zcs-gap-4 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Estimate lines</span><strong class='part-stat-value zcs-color-primary'><%=usageCount%></strong></div>
				<div class='part-stat zcs-rounded-xl zcs-flex zcs-direction-column zcs-gap-4 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Estimated quantity</span><strong class='part-stat-value zcs-color-primary'><%=totalQuantity%></strong><span class='zcs-font-12 zcs-color-tertiary'>$<%=totalExtended%> extended</span></div>
			</div>
		</section>

		<section class='zcs-card zcs-p-20 zcs-box-border'>
			<div class='part-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Part and sourcing information</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Current catalog values used when the part is selected for an estimate.</p></div>
			<div class='zcs-labelvalue-wrapper zcs-mt-12'>
				<ul class='part-detail-list zcs-p-0 zcs-m-0'>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Part ID</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=ifnull(partRecord.Part_ID,partId)%></span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Part name</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=ifnull(partRecord.Part_Name,"Not provided")%></span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Brand</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=ifnull(partRecord.Brand,"Not provided")%></span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Part number</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=ifnull(partRecord.Part_Number,"Not provided")%></span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Sourcing</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=ifnull(partRecord.Sourcing,"Not provided")%></span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Unit price</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>$<%=ifnull(partRecord.Unit_Price,0.00)%></span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Linked capability</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=capabilityName%></span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Lead time</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=ifnull(partRecord.Lead_Time_Days,0)%> days</span></li>
					<li><label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Status</label><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=statusValue%></span></li>
				</ul>
			</div>
			<% if(partRecord.Notes != null && partRecord.Notes != "") { %><div class='part-note zcs-notes-wrapper zcs-rounded-lg zcs-p-16 zcs-mt-12 zcs-box-border'><p class='zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><span class='zcs-notes-title zcs-font-medium zcs-color-tertiary'>Notes: </span><%=partRecord.Notes%></p></div><% } %>
		</section>

		<section class='zcs-card zcs-p-20 zcs-box-border'>
			<div class='part-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Estimate usage</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Related estimate part lines using this catalog part and their copied pricing.</p></div>
			<% if(usageCount == 0) { %>
			<div class='part-nodata zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center'>
				<div class='zcs-p-20 zcs-box-border'><h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'>No estimate usage yet</h5><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>This part has not been added to an estimate part line.</p></div>
			</div>
			<% } else { %>
			<div class='part-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12'>
				<table class='zcs-w-full'>
					<thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Estimate</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Program</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Upfitter</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary'>Quantity</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary'>Unit price</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary'>Line total</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Status</th></tr></thead>
					<tbody>
					<% for each usageLine in usageLines { estimateRecord = Estimates[ID == usageLine.Estimate]; programLabel = "Not provided"; upfitterLabel = "Not provided"; estimateLabel = ifnull(usageLine.Estimate,"Estimate"); estimateStatus = "Not provided"; estimateRecordId = usageLine.Estimate; if(estimateRecord.count() > 0) { estimateLabel = ifnull(estimateRecord.Estimate_ID,estimateRecord.ID); estimateStatus = ifnull(estimateRecord.Status,"Not provided"); if(estimateRecord.Program != null) { programRecord = Programs[ID == estimateRecord.Program]; if(programRecord.count() > 0) { programLabel = ifnull(programRecord.Service_ID,programRecord.Program_Name); } } if(estimateRecord.Upfitter != null) { upfitterRecord = Upfitters[ID == estimateRecord.Upfitter]; if(upfitterRecord.count() > 0) { upfitterLabel = ifnull(upfitterRecord.Upfitter_Name,"Not provided"); } } } %>
						<tr>
							<td data-label='Estimate' class='zcs-px-16 zcs-py-10 zcs-font-14'><a class='part-estimate-link zcs-font-medium' href='#Page:Estimate_Review?Estimate_ID=<%=estimateRecordId%>'><span><%=estimateLabel%></span></a></td>
							<td data-label='Program' class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-color-primary'><span><%=programLabel%></span></td>
							<td data-label='Upfitter' class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-color-primary'><span><%=upfitterLabel%></span></td>
							<td data-label='Quantity' class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-text-right zcs-color-primary'><span><%=ifnull(usageLine.Quantity,0)%></span></td>
							<td data-label='Unit price' class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-text-right zcs-color-primary'><span>$<%=ifnull(usageLine.Unit_Price,0.00)%></span></td>
							<td data-label='Line total' class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-text-right zcs-color-primary'><span>$<%=ifnull(usageLine.Line_Total,0.00)%></span></td>
							<td data-label='Status' class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-color-primary'><span><%=estimateStatus%></span></td>
						</tr>
					<% } %>
					</tbody>
				</table>
			</div>
			<% } %>
		</section>
	</main>
</div>
<%

%>