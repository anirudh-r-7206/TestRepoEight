<%
pendingCount = Upfitter_Payables[Payment_Status == "Pending Approval"].count();
approvedCount = Upfitter_Payables[Payment_Status == "Approved"].count();
paidCount = Upfitter_Payables[Payment_Status == "Paid"].count();
isAdmin = thisapp.permissions.isUserInProfile("Internal_Admin");
dialogSuffix = "&zc_LoadIn=dialog&zc_Header=false&zc_OpenUrlIn=same%20window&zc_NextUrl=%23Page%3AUpfitter_Payables_Hub";
%>
<style>
/* ZCS global utilities used by this page; included once here. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-box-border{box-sizing:border-box}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-6{padding-left:.375rem;padding-right:.375rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-text-center{text-align:center}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-no-shrink{flex-shrink:0}a{text-decoration:none}#splash-screen{display:none!important}
/* ZCS Heading with Actions, Horizontal Tab With Count, Filled Badge, Primary/Outline Button, Outline Banner, and Text-only No Data. */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{flex:0 0 auto;list-style:none;border-bottom:2px solid transparent}.zcs-horizontal-tablink{cursor:pointer;white-space:nowrap;color:var(--zcs_tertiary_text_color)}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabcount{min-width:24px;background:var(--zcs-page-bg-color)}.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-yellow{background:#FAAE13;color:#fff}.zcs-badge-blue{background:#2A6FFC;color:#fff}.zcs-badge-green{background:#179E6C;color:#fff}.zcs-outline-toast{border:1px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}
/* Payables workspace. */
.payables-page,.payables-page *{box-sizing:border-box}.payables-page{min-height:100%;padding:15px;background:var(--zcs-page-bg-color);font-size:14px;color:var(--zcs-primary-text-color)}.payables-header{min-height:92px;margin-bottom:15px;padding:20px 22px}.payables-title-wrap{min-width:0}.payables-subtitle{margin:4px 0 0;color:var(--zcs-secondary-text-color)}.payables-tabs-card{overflow:hidden}.payables-tab-control{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.payables-tabhead{padding:0 12px}.payables-tabpane{display:none;padding:15px}.payables-controls{margin-bottom:12px}.payables-control-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px}.payables-control-card{border:1px solid var(--zcs-border-color);background:#F9FAFE}.payables-control-main{min-width:0}.payables-control-label{overflow-wrap:anywhere}.payables-control-meta{color:var(--zcs-secondary-text-color)}.payables-actions{flex-shrink:0}.payables-report-shell{position:relative;min-height:510px;overflow:hidden;border:1px solid var(--zcs-border-color);border-radius:12px;background:#fff}.payables-report{width:100%;min-height:510px;border:0}.payables-report-empty{display:none}.payables-empty{min-height:510px}.payables-empty-icon{font-size:28px;color:var(--zcs_brand_color)}.payables-guidance{padding:11px 15px;border-top:1px solid var(--zcs-border-color);background:var(--zcs_brand_light_color);color:var(--zcs-secondary-text-color)}
#payables-tab-pending:checked~.zcs-horizontal-tabpanel .tab-pending,#payables-tab-approved:checked~.zcs-horizontal-tabpanel .tab-approved,#payables-tab-paid:checked~.zcs-horizontal-tabpanel .tab-paid{border-bottom-color:var(--zcs_brand_color)}
#payables-tab-pending:checked~.zcs-horizontal-tabpanel .tab-pending .zcs-horizontal-tablink,#payables-tab-approved:checked~.zcs-horizontal-tabpanel .tab-approved .zcs-horizontal-tablink,#payables-tab-paid:checked~.zcs-horizontal-tabpanel .tab-paid .zcs-horizontal-tablink{color:var(--zcs_brand_color)}
#payables-tab-pending:checked~.zcs-horizontal-tabpanel .pane-pending,#payables-tab-approved:checked~.zcs-horizontal-tabpanel .pane-approved,#payables-tab-paid:checked~.zcs-horizontal-tabpanel .pane-paid{display:block}
@media(max-width:768px){.payables-page{padding:10px}.payables-header{padding:17px;margin-bottom:10px;align-items:flex-start}.payables-tabpane{padding:10px}.payables-control-list{grid-template-columns:1fr}.payables-report-shell,.payables-report,.payables-empty{min-height:590px}}
@media(max-width:520px){.payables-header h1{font-size:21px}.payables-tabhead{padding:0 4px;gap:2px}.zcs-horizontal-tablink{padding:10px 8px;gap:5px}.payables-control-card{align-items:flex-start;flex-direction:column}.payables-actions{width:100%}.payables-actions .zcs-button{flex:1}.payables-subtitle{font-size:13px}}
</style>

<div class='payables-page'>
	<header class='payables-header zcs-card zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
		<div class='payables-title-wrap zcs-ellipsis'>
			<h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Upfitter Payables</h1>
			<p class='payables-subtitle'>Review shop payables, approve pending amounts, and record completed payments.</p>
		</div>
		<span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'>Finance workspace</span>
	</header>

	<section class='payables-tabs-card zcs-card'>
		<input class='payables-tab-control' type='radio' name='payable-status' id='payables-tab-pending' checked='checked'>
		<input class='payables-tab-control' type='radio' name='payable-status' id='payables-tab-approved'>
		<input class='payables-tab-control' type='radio' name='payable-status' id='payables-tab-paid'>
		<div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full'>
			<ul class='payables-tabhead zcs-horizontal-tabhead zcs-flex zcs-gap-6 zcs-m-0' role='tablist' aria-label='Payable payment status'>
				<li class='tab-pending zcs-horizontal-tabitem'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' for='payables-tab-pending'><span>Pending Approval</span><span class='zcs-horizontal-tabcount zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12'><%=pendingCount%></span></label></li>
				<li class='tab-approved zcs-horizontal-tabitem'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' for='payables-tab-approved'><span>Approved</span><span class='zcs-horizontal-tabcount zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12'><%=approvedCount%></span></label></li>
				<li class='tab-paid zcs-horizontal-tabitem'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-font-medium' for='payables-tab-paid'><span>Paid</span><span class='zcs-horizontal-tabcount zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12'><%=paidCount%></span></label></li>
			</ul>
			<div class='zcs-horizontal-tabbody zcs-col-common'>
				<div class='payables-tabpane pane-pending'>
					<% if(isAdmin && pendingCount > 0) { %><div class='payables-controls'><div class='payables-control-list'>
					<% for each payableRecord in Upfitter_Payables[Payment_Status == "Pending Approval"] sort by ID desc { detailUrl = "#Report:All_Upfitter_Payables?recLinkID=" + payableRecord.ID + dialogSuffix; approveUrl = "#Form:Upfitter_Payables?recLinkID=" + payableRecord.ID + "&viewLinkName=All_Upfitter_Payables&Payment_Status=Approved" + dialogSuffix + "&zc_SuccMsg=Payable%20approved"; %>
						<div class='payables-control-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-rounded-xl zcs-p-12'><div class='payables-control-main'><strong class='payables-control-label zcs-font-14 zcs-color-primary'><%=ifnull(payableRecord.Upfitter.Upfitter_Name,"Upfitter")%> · <%=ifnull(payableRecord.Program.Service_ID,"Program")%></strong><div class='payables-control-meta zcs-font-13'>$<%=ifnull(payableRecord.Payable_Amount,0)%> · <%=ifnull(payableRecord.Completed_Vehicles,0)%> approved vehicles</div></div><div class='payables-actions zcs-flex zcs-gap-8'><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='<%=detailUrl%>'><i class='zc-li-outline ui-1-eye-17'></i><span>Detail</span></a><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='<%=approveUrl%>'><i class='zc-li-outline ui-1-check-circle-08'></i><span>Approve</span></a></div></div>
					<% } %></div></div><% } %>
					<div class='payables-report-shell'><% if(pendingCount == 0) { %><div class='payables-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='payables-empty-icon zc-li-outline ui-1-check-circle-08'></i><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No payables pending approval</h2><p class='zcs-color-secondary zcs-mt-4 zcs-mb-0'>New calculated shop payables will appear here for finance review.</p></div></div><% } %><div class='payables-report <% if(pendingCount == 0) { %>payables-report-empty<% } %>' elName='zc-component' viewLinkName='Pending_Approval_Payables' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div></div>
				</div>
				<div class='payables-tabpane pane-approved'>
					<% if(isAdmin && approvedCount > 0) { %><div class='zcs-toast zcs-outline-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-font-14 zcs-color-primary payables-controls'><i class='zcs-no-shrink zc-li-outline travel-info'></i><p class='zcs-m-0'>Payment date and payment reference are required before an approved payable can be marked Paid.</p></div><div class='payables-controls'><div class='payables-control-list'>
					<% for each payableRecord in Upfitter_Payables[Payment_Status == "Approved"] sort by ID desc { detailUrl = "#Report:All_Upfitter_Payables?recLinkID=" + payableRecord.ID + dialogSuffix; paidUrl = "#Form:Upfitter_Payables?recLinkID=" + payableRecord.ID + "&viewLinkName=All_Upfitter_Payables&Payment_Status=Paid" + dialogSuffix + "&zc_SuccMsg=Payable%20marked%20paid"; %>
						<div class='payables-control-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-rounded-xl zcs-p-12'><div class='payables-control-main'><strong class='payables-control-label zcs-font-14 zcs-color-primary'><%=ifnull(payableRecord.Upfitter.Upfitter_Name,"Upfitter")%> · <%=ifnull(payableRecord.Program.Service_ID,"Program")%></strong><div class='payables-control-meta zcs-font-13'>$<%=ifnull(payableRecord.Payable_Amount,0)%> · <%=ifnull(payableRecord.Payment_Terms,"Terms not set")%></div></div><div class='payables-actions zcs-flex zcs-gap-8'><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='<%=detailUrl%>'><i class='zc-li-outline ui-1-eye-17'></i><span>Detail</span></a><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='<%=paidUrl%>'><i class='zc-li-outline business-money-coins'></i><span>Mark Paid</span></a></div></div>
					<% } %></div></div><% } %>
					<div class='payables-report-shell'><% if(approvedCount == 0) { %><div class='payables-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='payables-empty-icon zc-li-outline business-money-coins'></i><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No approved payables</h2><p class='zcs-color-secondary zcs-mt-4 zcs-mb-0'>Approved amounts awaiting payment will appear here.</p></div></div><% } %><div class='payables-report <% if(approvedCount == 0) { %>payables-report-empty<% } %>' elName='zc-component' viewLinkName='Approved_Payables' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div></div>
				</div>
				<div class='payables-tabpane pane-paid'>
					<div class='payables-report-shell'><% if(paidCount == 0) { %><div class='payables-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='payables-empty-icon zc-li-outline ui-1-check-circle-08'></i><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No paid payables</h2><p class='zcs-color-secondary zcs-mt-4 zcs-mb-0'>Completed payments with their dates and references will appear here.</p></div></div><% } %><div class='payables-report <% if(paidCount == 0) { %>payables-report-empty<% } %>' elName='zc-component' viewLinkName='Paid_Payables' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div></div>
				</div>
			</div>
			<div class='payables-guidance'>Select a report record or use Detail to inspect it. Approval and payment controls are shown only for valid states and authorized finance users.</div>
		</div>
	</section>
</div>