<%
activeUpfitters = Upfitters[Status == "Active"];
activeCount = activeUpfitters.count();
rankedUpfitterIds = List();
totalAssigned = 0;
totalApproved = 0;
totalOpenWorkOrders = 0;
allTurnaroundDays = 0;
allTurnaroundVehicles = 0;
totalEstimates = 0;
totalDeclines = 0;
totalQcRejected = 0;
for each summaryUpfitter in activeUpfitters
{
		summaryUpfitterId = summaryUpfitter.ID;
		totalAssigned = totalAssigned + Vehicles[Assigned_Upfitter == summaryUpfitterId].count();
		totalApproved = totalApproved + Vehicles[Assigned_Upfitter == summaryUpfitterId && QC_Status == "Approved"].count();
		totalOpenWorkOrders = totalOpenWorkOrders + Work_Orders[Upfitter == summaryUpfitterId && Status != "Completed"].count();
		totalEstimates = totalEstimates + Estimates[Upfitter == summaryUpfitterId].count();
		totalDeclines = totalDeclines + Estimates[Upfitter == summaryUpfitterId && Status == "Declined"].count();
		totalQcRejected = totalQcRejected + Vehicles[Assigned_Upfitter == summaryUpfitterId && QC_Status == "Rejected"].count();
		for each summaryVehicle in Vehicles[Assigned_Upfitter == summaryUpfitterId && Arrival_Date != null && Pickup_Date != null]
		{
				allTurnaroundDays = allTurnaroundDays + daysBetween(summaryVehicle.Arrival_Date,summaryVehicle.Pickup_Date);
				allTurnaroundVehicles = allTurnaroundVehicles + 1;
		}
}
overallCompletionRate = 0.0;
if(totalAssigned > 0)
{
		overallCompletionRate = (totalApproved * 100.0 / totalAssigned).round(1);
}
overallTurnaround = 0.0;
if(allTurnaroundVehicles > 0)
{
		overallTurnaround = (allTurnaroundDays * 1.0 / allTurnaroundVehicles).round(1);
}
overallDeclineRate = 0.0;
if(totalEstimates > 0)
{
		overallDeclineRate = (totalDeclines * 100.0 / totalEstimates).round(1);
}
overallQcRate = 0.0;
if(totalAssigned > 0)
{
		overallQcRate = (totalQcRejected * 100.0 / totalAssigned).round(1);
}
for each rankSlot in activeUpfitters
{
		bestId = 0;
		bestCompletion = -1.0;
		bestTurnaround = 999999.0;
		bestAssigned = -1;
		for each candidate in activeUpfitters
		{
				candidateId = candidate.ID;
				if(!rankedUpfitterIds.contains(candidateId))
				{
						candidateAssigned = Vehicles[Assigned_Upfitter == candidateId].count();
						candidateApproved = Vehicles[Assigned_Upfitter == candidateId && QC_Status == "Approved"].count();
						candidateCompletion = 0.0;
						if(candidateAssigned > 0)
						{
								candidateCompletion = (candidateApproved * 100.0 / candidateAssigned).round(1);
						}
						candidateTurnaroundTotal = 0;
						candidateTurnaroundCount = 0;
						for each candidateVehicle in Vehicles[Assigned_Upfitter == candidateId && Arrival_Date != null && Pickup_Date != null]
						{
								candidateTurnaroundTotal = candidateTurnaroundTotal + daysBetween(candidateVehicle.Arrival_Date,candidateVehicle.Pickup_Date);
								candidateTurnaroundCount = candidateTurnaroundCount + 1;
						}
						candidateTurnaround = 999999.0;
						if(candidateTurnaroundCount > 0)
						{
								candidateTurnaround = (candidateTurnaroundTotal * 1.0 / candidateTurnaroundCount).round(1);
						}
						if(candidateCompletion > bestCompletion || (candidateCompletion == bestCompletion && candidateTurnaround < bestTurnaround) || (candidateCompletion == bestCompletion && candidateTurnaround == bestTurnaround && candidateAssigned > bestAssigned))
						{
								bestId = candidateId;
								bestCompletion = candidateCompletion;
								bestTurnaround = candidateTurnaround;
								bestAssigned = candidateAssigned;
						}
				}
		}
		if(bestId != 0)
		{
				rankedUpfitterIds.add(bestId);
		}
}
maxTurnaround = 0.0;
for each rankedId in rankedUpfitterIds
{
		chartTurnaroundTotal = 0;
		chartTurnaroundCount = 0;
		for each chartVehicle in Vehicles[Assigned_Upfitter == rankedId && Arrival_Date != null && Pickup_Date != null]
		{
				chartTurnaroundTotal = chartTurnaroundTotal + daysBetween(chartVehicle.Arrival_Date,chartVehicle.Pickup_Date);
				chartTurnaroundCount = chartTurnaroundCount + 1;
		}
		chartTurnaround = 0.0;
		if(chartTurnaroundCount > 0)
		{
				chartTurnaround = (chartTurnaroundTotal * 1.0 / chartTurnaroundCount).round(1);
		}
		if(chartTurnaround > maxTurnaround)
		{
				maxTurnaround = chartTurnaround;
		}
}
%>
<style>
/* zcs-global utility sheet, page-scoped to the classes used by this standalone analytics page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;font-size:16px;line-height:1.5}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-end{align-items:flex-end}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-space-around{justify-content:space-around}.zcs-col-common{flex:1 1 0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-32{gap:2rem}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}
/* header-heading-with-actions */
.zcs-page-header{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.up-header-icon{width:42px;height:42px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);flex:0 0 42px}.up-header-copy{min-width:0}.up-header-subtitle{max-width:760px}
/* table-simple-table */
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1120px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper thead th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:var(--zcs-tr-h-color)}
/* badge-badge-with-icon */
.zcs-badge{width:auto;border:1px solid}.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#D92D48}.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9A6508}.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-grey{background:#E8E8E8;border-color:#777;color:#555}
/* progress-bar-range-bar-with-text */
.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}
/* chart-bar-chart and chart-column-chart */
.zcs-chart ul li{list-style:none}.zcs-chart-y-axis-text{width:46px}.zcs-chart-y-axis-line{border-top:1px dashed #EBECF0}.zcs-scrollable-container{top:10px;left:46px;width:calc(100% - 46px);height:calc(100% + 12px);overflow-x:auto;overflow-y:hidden}.zcs-chart-x-axis{min-width:max-content}.zcs-chart-x-axis>li{width:92px;min-width:92px;height:100%}.zcs-chart-x-axis-text{max-width:92px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-bar-value{width:30px;border-radius:6px 6px 0 0;background:var(--zcs_brand_color)}.up-turnaround-chart .zcs-bar-value{background:#F4660C}.up-chart-value{position:absolute;top:-22px;left:50%;transform:translateX(-50%);white-space:nowrap;color:var(--zcs-primary-text-color)}
/* no-data-no-data-text-only */
.zcs-nodata-wrapper{min-height:220px}.up-no-data-icon{font-size:30px;color:var(--zcs-teritiary-text-color)}
.up-page{min-height:100%;padding:15px;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:inherit}.up-kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:15px;margin:15px 0}.up-kpi{min-height:126px}.up-kpi-icon{width:40px;height:40px;flex:0 0 40px}.up-green{background:#E4FCF3;color:#179E6C}.up-blue{background:#E8EFFF;color:#2A6FFC}.up-orange{background:#F8F0EB;color:#F4660C}.up-red{background:#FDE3E6;color:#D92D48}.up-violet{background:#F1EFFE;color:#6554C0}.up-visual-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:15px}.up-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.up-chart-body{height:330px;min-width:0}.up-rank{width:28px;height:28px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);flex:0 0 28px}.up-shop-link{color:var(--zcs_brand_color)}.up-warning-stack{min-width:132px}.up-table-card{min-width:0}.up-mobile-list{display:none}.up-mobile-card{gap:14px}.up-mobile-metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px}.up-mobile-metric{background:var(--zcs-thead-color)}.up-card-badges{min-height:26px}
@media(max-width:1280px){.up-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:992px){.up-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.up-visual-grid{grid-template-columns:1fr}}@media(max-width:768px){.up-page{padding:12px}.zcs-page-header{padding:16px}.up-kpi-grid{grid-template-columns:1fr 1fr}.up-desktop-table{display:none}.up-mobile-list{display:flex}.up-chart-body{height:300px}.zcs-scrollable-container{left:42px;width:calc(100% - 42px)}.zcs-chart-y-axis-text{width:42px}}@media(max-width:576px){.up-kpi-grid{grid-template-columns:1fr}.up-mobile-metrics{grid-template-columns:1fr 1fr}.up-header-icon{display:none}.up-chart-body{height:280px}}
</style>
<div class='up-page zcs-box-border'>
	<header class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
			<span class='up-header-icon zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline business-chart-bar-32 zcs-font-22'></i></span>
			<div class='up-header-copy'><h1 class='zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Upfitter Performance</h1><p class='up-header-subtitle zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Ranked completion, turnaround, estimate response, quality, and active workload for <%=activeCount%> active shop<%=if(activeCount == 1,"","s")%>.</p></div>
		</div>
	</header>

	<%if(activeCount == 0){%>
	<section class='zcs-card zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-24 zcs-box-border' style='margin-top:15px'>
		<div><i class='up-no-data-icon zc-li-outline business-store'></i><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No active upfitters</h2><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Performance analytics will appear when an active shop is available.</p></div>
	</section>
	<%}else{%>
	<section class='up-kpi-grid' aria-label='Portfolio performance summary'>
		<article class='up-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='up-kpi-icon up-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline transportation-car zcs-font-22'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Assigned vehicles</span></div><div><strong class='zcs-font-24 zcs-color-primary'><%=totalAssigned%></strong><div class='zcs-font-13 zcs-color-tertiary'><%=activeCount%> active shop<%=if(activeCount == 1,"","s")%></div></div></article>
		<article class='up-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='up-kpi-icon up-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-22'></i></span><span class='zcs-font-14 zcs-color-tertiary'>QC-approved completion</span></div><div><strong class='zcs-font-24 zcs-color-primary'><%=overallCompletionRate%>%</strong><div class='zcs-font-13 zcs-color-tertiary'><%=totalApproved%> approved</div></div></article>
		<article class='up-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='up-kpi-icon up-orange zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-2-time zcs-font-22'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Average turnaround</span></div><div><strong class='zcs-font-24 zcs-color-primary'><%=overallTurnaround%> days</strong><div class='zcs-font-13 zcs-color-tertiary'><%=allTurnaroundVehicles%> completed pickup<%=if(allTurnaroundVehicles == 1,"","s")%></div></div></article>
		<article class='up-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='up-kpi-icon up-red zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline ui-1-circle-remove zcs-font-22'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Estimate decline rate</span></div><div><strong class='zcs-font-24 zcs-color-primary'><%=overallDeclineRate%>%</strong><div class='zcs-font-13 zcs-color-tertiary'><%=totalDeclines%> of <%=totalEstimates%> estimates</div></div></article>
		<article class='up-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='up-kpi-icon up-violet zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline design-pen-01 zcs-font-22'></i></span><span class='zcs-font-14 zcs-color-tertiary'>Open work orders</span></div><div><strong class='zcs-font-24 zcs-color-primary'><%=totalOpenWorkOrders%></strong><div class='zcs-font-13 zcs-color-tertiary'>QC rejection rate <%=overallQcRate%>%</div></div></article>
	</section>

	<section class='up-visual-grid'>
		<article class='zcs-card zcs-flex zcs-direction-column'>
			<div class='up-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Completion rate by shop</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>QC-approved vehicles as a percentage of assigned vehicles</p></div>
			<div class='up-chart-body zcs-p-20 zcs-box-border'>
				<div class='zcs-chart zcs-w-full zcs-barchart-wrapper zcs-relative zcs-wh-full'>
					<ul class='zcs-chart-y-axis zcs-flex zcs-direction-column zcs-gap-32 zcs-m-0 zcs-p-0'><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'>100%</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'>80%</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'>60%</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'>40%</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'>20%</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'>0%</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li></ul>
					<div class='zcs-scrollable-container zcs-absolute'><ul class='zcs-chart-x-axis zcs-wh-full zcs-flex zcs-justify-space-around zcs-gap-12 zcs-m-0 zcs-p-0'>
					<%for each chartId in rankedUpfitterIds
					{
							chartShop = Upfitters[ID == chartId];
							chartAssigned = Vehicles[Assigned_Upfitter == chartId].count();
							chartApproved = Vehicles[Assigned_Upfitter == chartId && QC_Status == "Approved"].count();
							chartCompletion = 0.0;
							if(chartAssigned > 0){chartCompletion = (chartApproved * 100.0 / chartAssigned).round(1);}
					%><li class='zcs-flex zcs-direction-column zcs-gap-12'><div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'><a class='zcs-bar-value zcs-relative' href='#Page:Upfitter_Detail?Upfitter_ID=<%=chartId%>' style='height:<%=chartCompletion%>%'><span class='up-chart-value zcs-font-12 zcs-font-medium'><%=chartCompletion%>%</span></a></div><a class='zcs-chart-x-axis-text zcs-font-12 zcs-color-primary zcs-text-center' title='<%=ifnull(chartShop.Upfitter_Name,"Upfitter")%>' href='#Page:Upfitter_Detail?Upfitter_ID=<%=chartId%>'><%=ifnull(chartShop.Upfitter_Name,"Upfitter")%></a></li><%}%>
					</ul></div>
				</div>
			</div>
		</article>
		<article class='zcs-card zcs-flex zcs-direction-column'>
			<div class='up-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Average turnaround by shop</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Days from arrival to pickup for vehicles with both dates</p></div>
			<div class='up-chart-body zcs-p-20 zcs-box-border'>
				<%if(maxTurnaround == 0){%><div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div><i class='up-no-data-icon zc-li-outline ui-2-time'></i><h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No turnaround history</h3><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Arrival and pickup dates are needed to calculate turnaround.</p></div></div><%}else{%>
				<div class='zcs-chart up-turnaround-chart zcs-w-full zcs-columnchart-wrapper zcs-relative zcs-wh-full'>
					<ul class='zcs-chart-y-axis zcs-flex zcs-direction-column zcs-gap-32 zcs-m-0 zcs-p-0'><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'><%=maxTurnaround.round(1)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'><%=(maxTurnaround * .8).round(1)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'><%=(maxTurnaround * .6).round(1)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'><%=(maxTurnaround * .4).round(1)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'><%=(maxTurnaround * .2).round(1)%></span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li><li class='zcs-flex zcs-align-items-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-12 zcs-color-tertiary'>0</span><span class='zcs-chart-y-axis-line zcs-col-common'></span></li></ul>
					<div class='zcs-scrollable-container zcs-absolute'><ul class='zcs-chart-x-axis zcs-wh-full zcs-flex zcs-justify-space-around zcs-gap-12 zcs-m-0 zcs-p-0'>
					<%for each turnaroundId in rankedUpfitterIds
					{
							turnaroundShop = Upfitters[ID == turnaroundId];
							shopTurnaroundTotal = 0;
							shopTurnaroundCount = 0;
							for each turnaroundVehicle in Vehicles[Assigned_Upfitter == turnaroundId && Arrival_Date != null && Pickup_Date != null]
							{
									shopTurnaroundTotal = shopTurnaroundTotal + daysBetween(turnaroundVehicle.Arrival_Date,turnaroundVehicle.Pickup_Date);
									shopTurnaroundCount = shopTurnaroundCount + 1;
							}
							shopTurnaround = 0.0;
							shopTurnaroundHeight = 0.0;
							if(shopTurnaroundCount > 0){shopTurnaround = (shopTurnaroundTotal * 1.0 / shopTurnaroundCount).round(1);shopTurnaroundHeight = (shopTurnaround * 100.0 / maxTurnaround).round(1);}
					%><li class='zcs-flex zcs-direction-column zcs-gap-12'><div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'><a class='zcs-bar-value zcs-relative' href='#Page:Upfitter_Detail?Upfitter_ID=<%=turnaroundId%>' style='height:<%=shopTurnaroundHeight%>%'><span class='up-chart-value zcs-font-12 zcs-font-medium'><%=shopTurnaround%>d</span></a></div><a class='zcs-chart-x-axis-text zcs-font-12 zcs-color-primary zcs-text-center' title='<%=ifnull(turnaroundShop.Upfitter_Name,"Upfitter")%>' href='#Page:Upfitter_Detail?Upfitter_ID=<%=turnaroundId%>'><%=ifnull(turnaroundShop.Upfitter_Name,"Upfitter")%></a></li><%}%>
					</ul></div>
				</div><%}%>
			</div>
		</article>
	</section>

	<section class='up-table-card zcs-card zcs-flex zcs-direction-column'>
		<div class='up-card-header zcs-px-24 zcs-py-16 zcs-box-border'><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Ranked shop performance</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Ranked by completion rate, then lower turnaround and assigned workload. Warning badges appear at 20% or higher.</p></div>
		<div class='up-desktop-table zcs-p-16 zcs-box-border'><div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium'>Rank</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium'>Upfitter</th><th class='zcs-px-12 zcs-py-8 zcs-text-right zcs-font-13 zcs-font-medium'>Assigned</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium'>QC completion</th><th class='zcs-px-12 zcs-py-8 zcs-text-right zcs-font-13 zcs-font-medium'>Turnaround</th><th class='zcs-px-12 zcs-py-8 zcs-text-right zcs-font-13 zcs-font-medium'>Estimates</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium'>Declines</th><th class='zcs-px-12 zcs-py-8 zcs-text-left zcs-font-13 zcs-font-medium'>QC rejected</th><th class='zcs-px-12 zcs-py-8 zcs-text-right zcs-font-13 zcs-font-medium'>Open WOs</th></tr></thead><tbody>
		<%
		rankNumber = 0;
		for each rowId in rankedUpfitterIds
		{
				rankNumber = rankNumber + 1;
				rowShop = Upfitters[ID == rowId];
				rowAssigned = Vehicles[Assigned_Upfitter == rowId].count();
				rowApproved = Vehicles[Assigned_Upfitter == rowId && QC_Status == "Approved"].count();
				rowCompletion = 0.0;
				if(rowAssigned > 0){rowCompletion = (rowApproved * 100.0 / rowAssigned).round(1);}
				rowEstimateCount = Estimates[Upfitter == rowId].count();
				rowDeclined = Estimates[Upfitter == rowId && Status == "Declined"].count();
				rowDeclineRate = 0.0;
				if(rowEstimateCount > 0){rowDeclineRate = (rowDeclined * 100.0 / rowEstimateCount).round(1);}
				rowRejected = Vehicles[Assigned_Upfitter == rowId && QC_Status == "Rejected"].count();
				rowQcRate = 0.0;
				if(rowAssigned > 0){rowQcRate = (rowRejected * 100.0 / rowAssigned).round(1);}
				rowOpenWorkOrders = Work_Orders[Upfitter == rowId && Status != "Completed"].count();
				rowTurnaroundTotal = 0;
				rowTurnaroundCount = 0;
				for each rowVehicle in Vehicles[Assigned_Upfitter == rowId && Arrival_Date != null && Pickup_Date != null]
				{
						rowTurnaroundTotal = rowTurnaroundTotal + daysBetween(rowVehicle.Arrival_Date,rowVehicle.Pickup_Date);
						rowTurnaroundCount = rowTurnaroundCount + 1;
				}
				rowTurnaround = 0.0;
				if(rowTurnaroundCount > 0){rowTurnaround = (rowTurnaroundTotal * 1.0 / rowTurnaroundCount).round(1);}
				declineBadgeClass = if(rowDeclineRate >= 20,"zcs-badge-red",if(rowDeclineRate > 0,"zcs-badge-yellow","zcs-badge-green"));
				declineIcon = if(rowDeclineRate >= 20,"ui-2-alert-circle","ui-1-check-circle-08");
				qcBadgeClass = if(rowQcRate >= 20,"zcs-badge-red",if(rowQcRate > 0,"zcs-badge-yellow","zcs-badge-green"));
				qcIcon = if(rowQcRate >= 20,"ui-2-alert-circle","ui-1-check-circle-08");
		%><tr><td class='zcs-px-12 zcs-py-12'><span class='up-rank zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg zcs-font-13 zcs-font-semibold'><%=rankNumber%></span></td><td class='zcs-px-12 zcs-py-12'><a class='up-shop-link zcs-font-14 zcs-font-semibold' href='#Page:Upfitter_Detail?Upfitter_ID=<%=rowId%>'><%=ifnull(rowShop.Upfitter_Name,"Upfitter")%></a><div class='zcs-font-12 zcs-color-tertiary'><%=ifnull(rowShop.Upfitter_Type,"Type not set")%></div></td><td class='zcs-px-12 zcs-py-12 zcs-text-right zcs-font-14'><%=rowAssigned%></td><td class='zcs-px-12 zcs-py-12'><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=rowCompletion%>%'></div></div><p class='zcs-font-12 zcs-font-medium zcs-color-primary zcs-m-0'><strong class='zcs-color-theme'><%=rowCompletion%>%</strong> · <%=rowApproved%> approved</p></div></td><td class='zcs-px-12 zcs-py-12 zcs-text-right zcs-font-14'><%=if(rowTurnaroundCount > 0,rowTurnaround + " days","No history")%></td><td class='zcs-px-12 zcs-py-12 zcs-text-right zcs-font-14'><%=rowEstimateCount%></td><td class='zcs-px-12 zcs-py-12'><span class='zcs-badge <%=declineBadgeClass%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><i class='zc-li-outline <%=declineIcon%>'></i><%=rowDeclineRate%>% · <%=rowDeclined%></span></td><td class='zcs-px-12 zcs-py-12'><span class='zcs-badge <%=qcBadgeClass%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><i class='zc-li-outline <%=qcIcon%>'></i><%=rowQcRate%>% · <%=rowRejected%></span></td><td class='zcs-px-12 zcs-py-12 zcs-text-right zcs-font-14 zcs-font-semibold'><%=rowOpenWorkOrders%></td></tr><%}%>
		</tbody></table></div></div>

		<div class='up-mobile-list zcs-direction-column zcs-gap-12 zcs-p-12 zcs-box-border'>
		<%
		mobileRank = 0;
		for each mobileId in rankedUpfitterIds
		{
				mobileRank = mobileRank + 1;
				mobileShop = Upfitters[ID == mobileId];
				mobileAssigned = Vehicles[Assigned_Upfitter == mobileId].count();
				mobileApproved = Vehicles[Assigned_Upfitter == mobileId && QC_Status == "Approved"].count();
				mobileCompletion = 0.0;
				if(mobileAssigned > 0){mobileCompletion = (mobileApproved * 100.0 / mobileAssigned).round(1);}
				mobileEstimateCount = Estimates[Upfitter == mobileId].count();
				mobileDeclined = Estimates[Upfitter == mobileId && Status == "Declined"].count();
				mobileDeclineRate = 0.0;
				if(mobileEstimateCount > 0){mobileDeclineRate = (mobileDeclined * 100.0 / mobileEstimateCount).round(1);}
				mobileRejected = Vehicles[Assigned_Upfitter == mobileId && QC_Status == "Rejected"].count();
				mobileQcRate = 0.0;
				if(mobileAssigned > 0){mobileQcRate = (mobileRejected * 100.0 / mobileAssigned).round(1);}
				mobileOpenWorkOrders = Work_Orders[Upfitter == mobileId && Status != "Completed"].count();
				mobileTurnaroundTotal = 0;
				mobileTurnaroundCount = 0;
				for each mobileVehicle in Vehicles[Assigned_Upfitter == mobileId && Arrival_Date != null && Pickup_Date != null]
				{
						mobileTurnaroundTotal = mobileTurnaroundTotal + daysBetween(mobileVehicle.Arrival_Date,mobileVehicle.Pickup_Date);
						mobileTurnaroundCount = mobileTurnaroundCount + 1;
				}
				mobileTurnaround = 0.0;
				if(mobileTurnaroundCount > 0){mobileTurnaround = (mobileTurnaroundTotal * 1.0 / mobileTurnaroundCount).round(1);}
				mobileDeclineBadge = if(mobileDeclineRate >= 20,"zcs-badge-red",if(mobileDeclineRate > 0,"zcs-badge-yellow","zcs-badge-green"));
				mobileQcBadge = if(mobileQcRate >= 20,"zcs-badge-red",if(mobileQcRate > 0,"zcs-badge-yellow","zcs-badge-green"));
		%><article class='up-mobile-card zcs-card zcs-flex zcs-direction-column zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-10'><div class='zcs-flex zcs-align-items-center zcs-gap-10'><span class='up-rank zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg zcs-font-13 zcs-font-semibold'><%=mobileRank%></span><div><a class='up-shop-link zcs-font-16 zcs-font-semibold' href='#Page:Upfitter_Detail?Upfitter_ID=<%=mobileId%>'><%=ifnull(mobileShop.Upfitter_Name,"Upfitter")%></a><div class='zcs-font-12 zcs-color-tertiary'><%=ifnull(mobileShop.Upfitter_Type,"Type not set")%></div></div></div><strong class='zcs-font-14 zcs-color-primary'><%=mobileOpenWorkOrders%> open WO<%=if(mobileOpenWorkOrders == 1,"","s")%></strong></div><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=mobileCompletion%>%'></div></div><p class='zcs-font-12 zcs-font-medium zcs-color-primary zcs-m-0'><strong class='zcs-color-theme'><%=mobileCompletion%>% complete</strong> · <%=mobileApproved%> of <%=mobileAssigned%> assigned</p></div><div class='up-mobile-metrics'><div class='up-mobile-metric zcs-p-12 zcs-rounded-lg'><div class='zcs-font-12 zcs-color-tertiary'>Turnaround</div><strong class='zcs-font-14'><%=if(mobileTurnaroundCount > 0,mobileTurnaround + " days","No history")%></strong></div><div class='up-mobile-metric zcs-p-12 zcs-rounded-lg'><div class='zcs-font-12 zcs-color-tertiary'>Estimates</div><strong class='zcs-font-14'><%=mobileEstimateCount%></strong></div></div><div class='up-card-badges zcs-flex zcs-row-wrap zcs-gap-8'><span class='zcs-badge <%=mobileDeclineBadge%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><i class='zc-li-outline ui-2-alert-circle'></i>Declines <%=mobileDeclineRate%>%</span><span class='zcs-badge <%=mobileQcBadge%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><i class='zc-li-outline design-pen-01'></i>QC rejected <%=mobileQcRate%>%</span></div></article><%}%>
		</div>
	</section>
	<%}%>
</div>