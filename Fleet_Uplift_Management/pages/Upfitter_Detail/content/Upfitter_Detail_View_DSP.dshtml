<%
upfitterId = input.Upfitter_ID;
upfitterRecord = Upfitters[ID == upfitterId];
if(upfitterRecord.count() == 0)
{
%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-white-color:#fff;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-gap-12{gap:.75rem}.zcs-p-24{padding:1.5rem}.zcs-m-0{margin:0}.zcs-font-14{font-size:.875rem}.zcs-font-18{font-size:1.125rem}.zcs-font-medium{font-weight:500}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-box-border{box-sizing:border-box}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.upfitter-empty{min-height:300px;background:var(--zcs-page-bg-color);padding:15px}
</style>
<div class='upfitter-empty zcs-flex zcs-align-items-center zcs-justify-center zcs-box-border'>
	<div class='zcs-card zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-12 zcs-p-24 zcs-box-border'>
		<i class='zc-li-outline ui-1-search-zoom-out zcs-font-18 zcs-color-tertiary'></i>
		<h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Upfitter not available</h2>
		<p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>The shop does not exist or is not accessible to the current user.</p>
	</div>
</div>
<%
}
else
{
		statusValue = ifnull(upfitterRecord.Status,"Inactive");
		statusClass = if(statusValue == "Active","zcs-badge-green","zcs-badge-grey");
		typeValue = ifnull(upfitterRecord.Upfitter_Type,"Not provided");

		assignedVehicles = Vehicles[Assigned_Upfitter == upfitterId];
		assignedCount = assignedVehicles.count();
		completedCount = Vehicles[Assigned_Upfitter == upfitterId && (Vehicle_Status == "Completed" || Vehicle_Status == "Picked Up")].count();
		approvedCount = Vehicles[Assigned_Upfitter == upfitterId && QC_Status == "Approved"].count();
		estimateCount = Estimates[Upfitter == upfitterId].count();
		declinedCount = Estimates[Upfitter == upfitterId && Status == "Declined"].count();
		workOrderCount = Work_Orders[Upfitter == upfitterId].count();
		openWorkOrderCount = Work_Orders[Upfitter == upfitterId && Status != "Completed"].count();
		payableCount = Upfitter_Payables[Upfitter == upfitterId].count();

		completionRate = 0.0;
		if(assignedCount > 0)
		{
				completionRate = ((approvedCount * 100.0) / assignedCount).round(1);
		}
		declineRate = 0.0;
		if(estimateCount > 0)
		{
				declineRate = ((declinedCount * 100.0) / estimateCount).round(1);
		}
		turnaroundTotal = 0;
		turnaroundCount = 0;
		for each turnaroundVehicle in assignedVehicles
		{
				if(turnaroundVehicle.Arrival_Date != null && turnaroundVehicle.Pickup_Date != null)
				{
						turnaroundTotal = turnaroundTotal + daysBetween(turnaroundVehicle.Arrival_Date,turnaroundVehicle.Pickup_Date);
						turnaroundCount = turnaroundCount + 1;
				}
		}
		averageTurnaround = 0.0;
		if(turnaroundCount > 0)
		{
				averageTurnaround = (turnaroundTotal * 1.0 / turnaroundCount).round(1);
		}

		certificationState = "Not recorded";
		certificationClass = "zcs-badge-grey";
		if(upfitterRecord.Cert_Expiry_Date != null)
		{
				if(upfitterRecord.Cert_Expiry_Date < zoho.currentdate)
				{
						certificationState = "Expired";
						certificationClass = "zcs-badge-red";
				}
				else
				{
						certificationState = "Current";
						certificationClass = "zcs-badge-green";
				}
		}

		programIds = List();
		for each assignedVehicle in assignedVehicles
		{
				if(assignedVehicle.Program != null && !programIds.contains(assignedVehicle.Program))
				{
						programIds.add(assignedVehicle.Program);
				}
		}

		pageReturn = "%23Page%3AUpfitter_Detail%3FUpfitter_ID%3D" + upfitterId;
		dialogParams = "&zc_LoadIn=dialog&zc_Header=false&zc_OpenUrlIn=same%20window&zc_NextUrl=" + pageReturn;
		editUrl = "#Form:Upfitters?recLinkID=" + upfitterId + "&viewLinkName=All_Upfitters" + dialogParams + "&zc_SuccMsg=Upfitter%20updated%20successfully";
		statusUrl = "";
		statusAction = "";
		statusIcon = "";
		if(statusValue == "Active")
		{
				statusUrl = "#Form:Upfitters?recLinkID=" + upfitterId + "&viewLinkName=All_Upfitters&Status=Inactive" + dialogParams + "&zc_SuccMsg=Upfitter%20status%20updated";
				statusAction = "Deactivate";
				statusIcon = "ui-1-circle-remove";
		}
		else if(statusValue == "Inactive")
		{
				statusUrl = "#Form:Upfitters?recLinkID=" + upfitterId + "&viewLinkName=All_Upfitters&Status=Active" + dialogParams + "&zc_SuccMsg=Upfitter%20status%20updated";
				statusAction = "Activate";
				statusIcon = "ui-1-check-circle-08";
		}
%>
<style>
/* ZCS global utility subset used by this single-snippet page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0}.zcs-col-2{flex:0 0 16.666%;max-width:16.666%}.zcs-col-3{flex:0 0 25%;max-width:25%}.zcs-col-4{flex:0 0 33.333%;max-width:33.333%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-8{flex:0 0 66.666%;max-width:66.666%}.zcs-col-10{flex:0 0 83.333%;max-width:83.333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-0{gap:0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-15{gap:.9375rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-15{padding:.9375rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-overflow-auto{overflow:auto}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}
/* ZCS buttons, badges, metrics, table, and timeline */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:max-content;white-space:nowrap}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-red{background:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-grey{background:#52525B;border-color:#52525B;color:#fff}.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{border-collapse:collapse}.zcs-table-wrapper th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper tbody tr:first-child td{border-top-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.zcs-tl-indicator{width:60px;left:16.666%}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';position:absolute;width:1px;height:calc(100% + 32px);background:#E1E1E1;top:5px}
/* Page-specific adaptation of ZCS fleet 360 detail */
.upfitter-page{min-height:100%;background:var(--zcs-page-bg-color);font-size:14px}.upfitter-header{background:#fff;border-bottom:1px solid var(--zcs-border-color);position:sticky;top:0;z-index:5}.upfitter-title{min-width:0}.upfitter-kicker{text-transform:uppercase;letter-spacing:.08em}.upfitter-actions{justify-content:flex-end}.upfitter-content{padding:15px}.upfitter-hero{background:#fff}.upfitter-profile-icon{width:64px;height:64px;flex:0 0 64px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:26px}.upfitter-detail-grid{background:#F9FAFE}.upfitter-detail{min-width:0;overflow-wrap:anywhere}.upfitter-layout{align-items:flex-start}.upfitter-main{flex:1 1 680px;min-width:0}.upfitter-side{flex:1 1 320px;min-width:280px;max-width:420px}.upfitter-section{scroll-margin-top:85px}.upfitter-section-head{border-bottom:1px solid var(--zcs-border-color)}.upfitter-chip{list-style:none;background:var(--zcs_component_hover_color)}.upfitter-map{min-height:310px;overflow:hidden}.upfitter-map>div{min-height:300px}.upfitter-report{min-height:230px;overflow:auto}.upfitter-report>div{min-height:220px}.upfitter-report .view-header-reportlist{display:none}.upfitter-metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.upfitter-metric{min-width:0}.upfitter-metric-value{font-size:24px}.upfitter-note{border-left:3px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.upfitter-program-link{color:var(--zcs_brand_color)}.upfitter-program-link:hover{text-decoration:underline}.upfitter-empty-row{min-height:90px}.upfitter-finance-note{background:#F9FAFE;border:1px solid var(--zcs-border-color)}
@media(max-width:992px){.upfitter-metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.upfitter-side{max-width:none;flex-basis:100%}.upfitter-header{position:static}}
@media(max-width:768px){.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.upfitter-header{padding:14px 15px;align-items:flex-start;flex-direction:column}.upfitter-actions{width:100%;justify-content:flex-start}.upfitter-content{padding:12px}.upfitter-hero{padding:18px}.upfitter-hero-top{align-items:flex-start;flex-direction:column}.upfitter-layout{gap:12px}.upfitter-side{min-width:0}.upfitter-map{min-height:240px}.upfitter-report{min-height:190px}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}}
@media(max-width:576px){.upfitter-actions{display:grid;grid-template-columns:1fr}.upfitter-actions .zcs-button{width:100%;min-width:100%}.upfitter-metric-grid{grid-template-columns:1fr}.upfitter-profile-icon{width:52px;height:52px;flex-basis:52px}.upfitter-section{padding:14px}.upfitter-detail-grid .zcs-col-6{flex:0 0 100%;max-width:100%}}
</style>
<div class='upfitter-page zcs-wh-full zcs-flex zcs-direction-column'>
	<header class='upfitter-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border'>
		<div class='upfitter-title zcs-flex zcs-direction-column zcs-gap-4'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-8'><a href='#Page:Upfitter_Network' class='zcs-color-tertiary' aria-label='Back to upfitters'><i class='zc-li-outline arrows-1-tail-left zcs-font-18'></i></a><span class='upfitter-kicker zcs-font-12 zcs-font-semibold zcs-color-tertiary'>Upfitter detail</span></div>
			<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'><h1 class='zcs-font-22 zcs-font-semibold zcs-color-primary zcs-m-0'><%=ifnull(upfitterRecord.Upfitter_Name,"Upfitter")%></h1><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=statusClass%>'><%=statusValue%></span><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-badge-blue'><%=typeValue%></span></div>
			<p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Coverage, capability, operational performance, history, and payment visibility.</p>
		</div>
		<div class='upfitter-actions zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=editUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span>Edit</span></a>
			<% if(statusAction != "") { %><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=statusUrl%>'><i class='zcs-button-icon zc-li-outline <%=statusIcon%>'></i><span><%=statusAction%></span></a><% } %>
		</div>
	</header>

	<div class='upfitter-content zcs-flex zcs-direction-column zcs-gap-15 zcs-box-border'>
		<section class='upfitter-hero zcs-card zcs-flex zcs-direction-column zcs-gap-20 zcs-p-24 zcs-box-border'>
			<div class='upfitter-hero-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
				<div class='zcs-flex zcs-align-items-center zcs-gap-16'>
					<div class='upfitter-profile-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-xl'><i class='zc-li-outline business-shop'></i></div>
					<div><h2 class='zcs-font-20 zcs-font-semibold zcs-color-primary zcs-m-0'><%=ifnull(upfitterRecord.Upfitter_Name,"Upfitter")%></h2><p class='zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Shop ID <%=ifnull(upfitterRecord.Upfitter_ID,upfitterId)%></p></div>
				</div>
				<div class='zcs-flex zcs-direction-column zcs-align-items-start zcs-gap-4'><span class='zcs-font-13 zcs-color-tertiary'>Certification</span><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=certificationClass%>'><%=certificationState%></span></div>
			</div>
			<div class='upfitter-detail-grid zcs-row zcs-rounded-xl zcs-p-8 zcs-box-border'>
				<div class='upfitter-detail zcs-col-3 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Service radius</span><strong class='zcs-font-16 zcs-color-primary'><%=ifnull(upfitterRecord.Service_Radius_Miles,"Not provided")%> miles</strong></div>
				<div class='upfitter-detail zcs-col-3 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Payment terms</span><strong class='zcs-font-16 zcs-color-primary'><%=ifnull(upfitterRecord.Payment_Terms,"Not provided")%></strong></div>
				<div class='upfitter-detail zcs-col-3 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Certification expiry</span><strong class='zcs-font-16 zcs-color-primary'><%=ifnull(upfitterRecord.Cert_Expiry_Date,"Not recorded")%></strong></div>
				<div class='upfitter-detail zcs-col-3 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Programs served</span><strong class='zcs-font-16 zcs-color-primary'><%=programIds.size()%></strong></div>
			</div>
			<div><h3 class='zcs-font-14 zcs-font-semibold zcs-color-primary zcs-m-0'>Capabilities</h3><ul class='zcs-flex zcs-row-wrap zcs-gap-8 zcs-p-0 zcs-mt-8 zcs-mb-0'>
				<% if(upfitterRecord.Capabilities == null || upfitterRecord.Capabilities.isEmpty()) { %><li class='zcs-font-14 zcs-color-tertiary'>No capabilities recorded.</li><% } else { for each capabilityId in upfitterRecord.Capabilities { capabilityRecord = Capabilities[ID == capabilityId]; %><li class='upfitter-chip zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md zcs-px-12 zcs-py-8 zcs-font-14 zcs-color-primary'><i class='zc-li-outline ui-1-check-small zcs-color-theme'></i><%=ifnull(capabilityRecord.Capability_Name,"Capability")%></li><% } } %>
			</ul></div>
			<% if(upfitterRecord.Certifications != null && upfitterRecord.Certifications != "") { %><div class='upfitter-note zcs-rounded-lg zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline education-certificate zcs-color-theme'></i><strong class='zcs-font-14 zcs-color-primary'>Certification details</strong></div><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'><%=upfitterRecord.Certifications%></p></div><% } %>
			<% if(upfitterRecord.Notes != null && upfitterRecord.Notes != "") { %><div class='upfitter-note zcs-rounded-lg zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline business-notes zcs-color-theme'></i><strong class='zcs-font-14 zcs-color-primary'>Internal notes</strong></div><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'><%=upfitterRecord.Notes%></p></div><% } %>
		</section>

		<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'>
			<div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Performance</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Completion, turnaround, estimate response, and current workload.</p></div>
			<div class='upfitter-metric-grid zcs-mt-12'>
				<div class='upfitter-metric zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Completion rate</span><strong class='upfitter-metric-value zcs-color-primary'><%=completionRate%>%</strong><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=completionRate%>%'></div></div><span class='zcs-font-12 zcs-color-tertiary'><%=approvedCount%> QC approved of <%=assignedCount%> assigned</span></div>
				<div class='upfitter-metric zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Average turnaround</span><strong class='upfitter-metric-value zcs-color-primary'><%=averageTurnaround%> days</strong><span class='zcs-font-12 zcs-color-tertiary'><%=turnaroundCount%> completed date pairs</span></div>
				<div class='upfitter-metric zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Estimate decline rate</span><strong class='upfitter-metric-value zcs-color-primary'><%=declineRate%>%</strong><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=declineRate%>%'></div></div><span class='zcs-font-12 zcs-color-tertiary'><%=declinedCount%> declined of <%=estimateCount%> estimates</span></div>
				<div class='upfitter-metric zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Open work orders</span><strong class='upfitter-metric-value zcs-color-primary'><%=openWorkOrderCount%></strong><span class='zcs-font-12 zcs-color-tertiary'><%=workOrderCount%> total work orders; <%=completedCount%> vehicles completed or picked up</span></div>
			</div>
		</section>

		<div class='upfitter-layout zcs-flex zcs-row-wrap zcs-gap-15'>
			<main class='upfitter-main zcs-flex zcs-direction-column zcs-gap-15'>
				<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Program history</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Programs with vehicles assigned to this shop.</p></div>
					<% if(programIds.isEmpty()) { %><div class='upfitter-empty-row zcs-flex zcs-align-items-center zcs-justify-center zcs-color-tertiary'>No assigned programs.</div><% } else { %>
					<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12'><table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Service ID</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Program</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium'>Assigned vehicles</th></tr></thead><tbody>
					<% for each programId in programIds { programRecord = Programs[ID == programId]; programVehicleCount = Vehicles[Program == programId && Assigned_Upfitter == upfitterId].count(); %><tr><td class='zcs-px-16 zcs-py-10 zcs-font-14'><a class='upfitter-program-link zcs-font-medium' href='#Page:Program_Detail?Program_ID=<%=programId%>'><%=ifnull(programRecord.Service_ID,"Program")%></a></td><td class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-color-primary'><%=ifnull(programRecord.Program_Name,"Not provided")%></td><td class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-color-primary'><%=ifnull(programRecord.Program_Status,"Not provided")%></td><td class='zcs-px-16 zcs-py-10 zcs-font-14 zcs-text-right zcs-color-primary'><%=programVehicleCount%></td></tr><% } %>
					</tbody></table></div><% } %>
				</section>
				<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'><div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Work-order history</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Issue dates, parts-order deadlines, documents, and status.</p></div><div class='upfitter-report' elName='zc-component' viewLinkName='All_Work_Orders' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Upfitter=<%=upfitterId%>'></div></section>
				<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'><div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Vehicle operations</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Assigned VINs, arrival and pickup dates, progress, and QC.</p></div><div class='upfitter-report' elName='zc-component' viewLinkName='All_Vehicles' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Assigned_Upfitter=<%=upfitterId%>'></div></section>
				<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'><div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Estimate history</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Estimate volume, response status, and decline history.</p></div><div class='upfitter-report' elName='zc-component' viewLinkName='All_Estimates' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Upfitter=<%=upfitterId%>'></div></section>
			</main>

			<aside class='upfitter-side zcs-flex zcs-direction-column zcs-gap-15'>
				<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'><div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Coverage and address</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'><%=ifnull(upfitterRecord.Address,"Address not provided")%></p></div><div class='upfitter-map zcs-rounded-lg zcs-mt-12' elName='zc-component' viewLinkName='Upfitter_Map' params='zc_Header=false&amp;zc_Footer=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Upfitter_ID=<%=upfitterId%>'></div><div class='zcs-flex zcs-direction-column zcs-gap-4 zcs-mt-12'><span class='zcs-font-13 zcs-color-tertiary'>Coverage radius</span><strong class='zcs-font-16 zcs-color-primary'><%=ifnull(upfitterRecord.Service_Radius_Miles,"Not provided")%> miles from shop</strong><span class='zcs-font-13 zcs-color-tertiary'><%=ifnull(upfitterRecord.City,"")%><%=if(upfitterRecord.City != null && upfitterRecord.State != null,", ","")%><%=ifnull(upfitterRecord.State,"")%> <%=ifnull(upfitterRecord.ZIP,"")%></span></div></section>
				<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'><div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Primary contact</h2></div><div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-12'><div class='zcs-flex zcs-align-items-center zcs-gap-12'><i class='zc-li-outline users-single-01 zcs-font-18 zcs-color-theme'></i><div><span class='zcs-font-13 zcs-color-tertiary'>Contact</span><div class='zcs-font-14 zcs-font-medium zcs-color-primary'><%=ifnull(upfitterRecord.Primary_Contact,"Not provided")%></div></div></div><div class='zcs-flex zcs-align-items-center zcs-gap-12'><i class='zc-li-outline ui-1-email-83 zcs-font-18 zcs-color-theme'></i><div><span class='zcs-font-13 zcs-color-tertiary'>Email</span><div class='zcs-font-14 zcs-color-primary'><%=ifnull(upfitterRecord.Contact_Email,"Not provided")%></div></div></div><div class='zcs-flex zcs-align-items-center zcs-gap-12'><i class='zc-li-outline ui-3-phone zcs-font-18 zcs-color-theme'></i><div><span class='zcs-font-13 zcs-color-tertiary'>Phone</span><div class='zcs-font-14 zcs-color-primary'><%=ifnull(upfitterRecord.Contact_Phone,"Not provided")%></div></div></div></div></section>
				<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'><div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Payable history</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'><%=payableCount%> payable records. Finance columns are shown only when report and field permissions permit.</p></div><div class='upfitter-finance-note zcs-rounded-lg zcs-p-12 zcs-mt-12 zcs-box-border zcs-font-13 zcs-color-tertiary'><i class='zc-li-outline business-money-coins zcs-color-theme'></i> Approval, amount, payment date, and reference remain permission-controlled.</div><div class='upfitter-report' elName='zc-component' viewLinkName='All_Upfitter_Payables' params='zc_Header=false&amp;zc_Footer=true&amp;zc_AddRec=false&amp;zc_EditRec=false&amp;zc_DelRec=false&amp;zc_Search=false&amp;zc_Filter=false&amp;Upfitter=<%=upfitterId%>'></div></section>
			</aside>
		</div>

		<section class='upfitter-section zcs-card zcs-p-20 zcs-box-border'>
			<div class='upfitter-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Audit activity</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Newest recorded shop changes and status events.</p></div>
			<% auditRecords = Audit_Log[Module_Name == "Upfitters" && Record_ID == upfitterId]; if(auditRecords.count() == 0) { %><div class='upfitter-empty-row zcs-flex zcs-align-items-center zcs-justify-center zcs-color-tertiary'>No audit activity recorded.</div><% } else { %><div class='zcs-timeline-wrapper zcs-mt-12'><ul class='zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0'>
			<% for each auditRecord in Audit_Log[Module_Name == "Upfitters" && Record_ID == upfitterId] sort by Event_Date desc { %><li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div><span class='zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-color-tertiary zcs-text-right'><%=ifnull(auditRecord.Event_Date,"Not recorded")%></span><div class='zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'><%=ifnull(auditRecord.Action,"Activity")%></h3><span class='zcs-font-13 zcs-color-tertiary'><%=ifnull(auditRecord.User_Email,"System")%></span></div><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mx-0 zcs-mb-0'><%=ifnull(auditRecord.Details,"Upfitter record activity")%></p></div></li><% } %>
			</ul></div><% } %>
		</section>
	</div>
</div>
<%

%>