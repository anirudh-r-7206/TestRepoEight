<%
quoteRecord = Quotes[ID == input.Quote_ID];
quoteAvailable = quoteRecord.count() > 0;
if(quoteAvailable)
{
		programRecord = Programs[ID == quoteRecord.Program];
		quoteStatus = ifnull(quoteRecord.Status,"Draft");
		programLabel = ifnull(programRecord.Service_ID,"Program");
		if(programRecord.Program_Name != null && programRecord.Program_Name != "")
		{
				programLabel = programLabel + " - " + programRecord.Program_Name;
		}
		badgeClass = "zcs-badge-grey";
		if(quoteStatus == "Draft")
		{
				badgeClass = "zcs-badge-yellow";
		}
		else if(quoteStatus == "Sent to Client")
		{
				badgeClass = "zcs-badge-blue";
		}
		else if(quoteStatus == "Approved")
		{
				badgeClass = "zcs-badge-green";
		}
		else if(quoteStatus == "Declined")
		{
				badgeClass = "zcs-badge-red";
		}
		else if(quoteStatus == "Revised")
		{
				badgeClass = "zcs-badge-orange";
		}
		pageReturn = "%23Page%3AQuote_Detail%3FQuote_ID%3D" + quoteRecord.ID;
		dialogParams = "&zc_LoadIn=dialog&zc_Header=true&zc_OpenUrlIn=same%20window&zc_NextUrl=" + pageReturn;
		editBase = "#Form:Quotes?recLinkID=" + quoteRecord.ID + "&viewLinkName=All_Quotes";
		sendUrl = editBase + "&Status=Sent%20to%20Client" + dialogParams + "&zc_SuccMsg=Quote%20sent%20to%20client";
		approveUrl = editBase + "&Status=Approved" + dialogParams + "&zc_SuccMsg=Quote%20approved";
		declineUrl = editBase + "&Status=Declined" + dialogParams + "&zc_SuccMsg=Quote%20declined";
		revisionUrl = editBase + "&Status=Revised" + dialogParams + "&zc_SuccMsg=Revision%20requested";
}
%>
<style>
/* zcs-global: page utility sheet, included once for this page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-end{justify-content:flex-end}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-15{padding:.9375rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-p-30{padding:1.875rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-15{padding-left:.9375rem;padding-right:.9375rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:#fff}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}
/* ZCS component CSS: buttons, filled badges, label-value, notes, quote-detail 360 adaptation. */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:#fff;color:var(--zcs_brand_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-action-green{--action:#179E6C;border-color:var(--action);color:var(--action)}.zcs-action-red{--action:#D73347;border-color:var(--action);color:var(--action)}.zcs-action-orange{--action:#B44B09;border-color:var(--action);color:var(--action)}
.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-theme{background:var(--zcs_brand_color);color:#fff}.zcs-badge-green{background:#179E6C;color:#fff}.zcs-badge-red{background:#D73347;color:#fff}.zcs-badge-grey{background:#52525B;color:#fff}.zcs-badge-yellow{background:#B8770D;color:#fff}.zcs-badge-blue{background:#2A6FFC;color:#fff}.zcs-badge-orange{background:#B44B09;color:#fff}.zcs-labelvalue-with-bg{background:#F9FAFE}.zcs-labelvalue-wrapper ul{list-style:none}.zcs-notes-text a:hover{text-decoration:underline}
.quote-page{min-height:100%;background:var(--zcs-page-bg-color);font-size:14px}.quote-header{background:#fff;border-bottom:1px solid var(--zcs-border-color)}.quote-content{padding:15px;max-width:1280px;margin:0 auto}.quote-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,.42fr);gap:15px}.quote-main,.quote-side{min-width:0}.quote-kicker{text-transform:uppercase;letter-spacing:.08em}.quote-actions{justify-content:flex-end}.quote-section-head{border-bottom:1px solid var(--zcs-border-color)}.quote-document{border:1px solid var(--zcs-border-color);background:#F9FAFE}.quote-document-icon{width:44px;height:44px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:20px}.quote-meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.quote-meta-item{background:#F9FAFE;min-width:0}.quote-meta-item strong{display:block;overflow-wrap:anywhere}.quote-pricing{border-collapse:collapse}.quote-pricing td{border-bottom:1px solid var(--zcs-border-color)}.quote-pricing tr:last-child td{border-bottom:0}.quote-total-row{background:var(--zcs_component_hover_color)}.quote-total-row td{font-size:20px;font-weight:700;color:var(--zcs_brand_color)}.quote-notes{white-space:pre-wrap;overflow-wrap:anywhere}.quote-action-card{border-color:var(--zcs_brand_color)}.quote-empty{min-height:420px}.quote-permission-note{border-left:3px solid var(--zcs_brand_color);background:#F9FAFE}.quote-pdf-link{flex-shrink:0}.quote-version{border:1px solid var(--zcs-border-color);background:#fff}
.quote-main,.quote-side{gap:15px}
@media(max-width:992px){.quote-grid{grid-template-columns:1fr}.quote-header{align-items:flex-start;flex-direction:column}.quote-actions{justify-content:flex-start;width:100%}}
@media(max-width:768px){.quote-content{padding:10px}.quote-header{padding:14px 15px}.quote-section{padding:15px}.quote-meta-grid{grid-template-columns:1fr 1fr}.quote-actions{display:grid;grid-template-columns:1fr}.quote-actions .zcs-button{width:100%}.quote-pricing td{padding:10px}.quote-document{align-items:flex-start}.quote-total-row td{font-size:18px}}
@media(max-width:576px){.quote-meta-grid{grid-template-columns:1fr}.quote-page h1{font-size:20px}.quote-section{padding:12px}.quote-document{flex-wrap:wrap}.quote-pdf-link{width:100%}}
</style>
<div class='quote-page zcs-wh-full zcs-flex zcs-direction-column'>
<%
if(!quoteAvailable)
{
%>
	<header class='quote-header zcs-w-full zcs-px-30 zcs-py-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline files-single-content-03 zcs-font-22 zcs-color-tertiary'></i><h1 class='zcs-font-20 zcs-font-medium zcs-color-primary zcs-m-0'>Quote unavailable</h1></div></header>
	<main class='quote-content zcs-w-full zcs-box-border'><section class='quote-empty zcs-card zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-p-24 zcs-text-center zcs-box-border'><i class='zc-li-outline ui-1-lock zcs-font-30 zcs-color-tertiary'></i><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>This quote is not accessible</h2><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>It may not exist or your account may not have permission to view it.</p></section></main>
<%
}
else
{
%>
	<header class='quote-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border'>
		<div class='zcs-flex zcs-direction-column zcs-gap-4'>
			<span class='quote-kicker zcs-font-12 zcs-font-semibold zcs-color-tertiary'>Client quote</span>
			<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'><h1 class='zcs-font-24 zcs-font-semibold zcs-color-primary zcs-m-0'><%=ifnull(quoteRecord.Quote_Number,"Draft quote")%></h1><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13 <%=badgeClass%>'><%=quoteStatus%></span><span class='quote-version zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13 zcs-color-secondary'>Version <%=ifnull(quoteRecord.Version_Number,1)%></span></div>
			<p class='zcs-font-14 zcs-color-tertiary zcs-m-0'><%=programLabel%></p>
		</div>
		<div class='quote-actions zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'>
			<% if(quoteStatus == "Draft") { %><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=sendUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-email-83'></i><span>Send to Client</span></a><% } %>
			<% if(quoteStatus == "Sent to Client") { %><a class='zcs-button zcs-primary-outline-button zcs-action-green zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=approveUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Mark Approved</span></a><a class='zcs-button zcs-primary-outline-button zcs-action-red zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=declineUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-circle-remove'></i><span>Mark Declined</span></a><a class='zcs-button zcs-primary-outline-button zcs-action-orange zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=revisionUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span>Request Revision</span></a><% } %>
		</div>
	</header>
	<main class='quote-content zcs-w-full zcs-box-border'>
		<div class='quote-grid'>
			<div class='quote-main zcs-flex zcs-direction-column zcs-gap-15'>
				<section class='quote-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='quote-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Quote details</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Reference, validity period, program, and response status.</p></div>
					<div class='quote-meta-grid zcs-mt-12'>
						<div class='quote-meta-item zcs-rounded-xl zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Program</span><strong class='zcs-font-16 zcs-color-primary zcs-mt-4'><%=programLabel%></strong></div>
						<div class='quote-meta-item zcs-rounded-xl zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Quote number</span><strong class='zcs-font-16 zcs-color-primary zcs-mt-4'><%=ifnull(quoteRecord.Quote_Number,"Draft")%></strong></div>
						<div class='quote-meta-item zcs-rounded-xl zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Quote date</span><strong class='zcs-font-16 zcs-color-primary zcs-mt-4'><%=ifnull(quoteRecord.Quote_Date,"Not set")%></strong></div>
						<div class='quote-meta-item zcs-rounded-xl zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Valid until</span><strong class='zcs-font-16 zcs-color-primary zcs-mt-4'><%=ifnull(quoteRecord.Valid_Until,"Not set")%></strong></div>
						<div class='quote-meta-item zcs-rounded-xl zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Version</span><strong class='zcs-font-16 zcs-color-primary zcs-mt-4'><%=ifnull(quoteRecord.Version_Number,1)%></strong></div>
						<div class='quote-meta-item zcs-rounded-xl zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Approval date</span><strong class='zcs-font-16 zcs-color-primary zcs-mt-4'><%=ifnull(quoteRecord.FMC_Approval_Date,"Not approved")%></strong></div>
					</div>
				</section>
				<section class='quote-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='quote-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Pricing</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Client-facing pricing and quote total.</p></div>
					<table class='quote-pricing zcs-w-full zcs-mt-12'>
						<% if(quoteRecord.Estimate_Subtotal != null) { %><tr><td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-secondary'>Estimate subtotal</td><td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-font-semibold zcs-color-primary zcs-text-right'>$<%=ifnull(quoteRecord.Estimate_Subtotal,0.00)%></td></tr><% } %>
						<tr><td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-secondary'>Markup (<%=ifnull(quoteRecord.Markup_Percent,0.00)%>%)</td><td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-font-semibold zcs-color-primary zcs-text-right'>$<%=ifnull(quoteRecord.Markup_Amount,0.00)%></td></tr>
						<tr class='quote-total-row'><td class='zcs-px-16 zcs-py-16'>Total</td><td class='zcs-px-16 zcs-py-16 zcs-text-right'>$<%=ifnull(quoteRecord.Quote_Total,0.00)%></td></tr>
					</table>
					<div class='quote-permission-note zcs-rounded-lg zcs-p-12 zcs-mt-12 zcs-font-12 zcs-color-tertiary zcs-box-border'><i class='zc-li-outline ui-1-lock'></i> Cost-basis fields are returned only when field permissions allow them.</div>
				</section>
				<section class='quote-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='quote-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Notes</h2></div>
					<div class='zcs-notes-wrapper zcs-mt-12'><p class='quote-notes zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><span class='zcs-notes-title zcs-font-medium zcs-color-tertiary'>FMC notes: </span><%=ifnull(quoteRecord.FMC_Notes,"No notes have been recorded for this quote.")%></p></div>
				</section>
			</div>
			<aside class='quote-side zcs-flex zcs-direction-column zcs-gap-15'>
				<section class='quote-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='quote-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Quote PDF</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Stored client-ready quote document.</p></div>
					<div class='quote-document zcs-flex zcs-align-items-center zcs-gap-12 zcs-rounded-lg zcs-p-12 zcs-mt-12 zcs-box-border'>
						<div class='quote-document-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg'><i class='zc-li-outline files-2-pdf'></i></div>
						<div class='zcs-col-common'><strong class='zcs-font-14 zcs-color-primary'>Quote PDF</strong><div class='zcs-font-13 zcs-color-tertiary'><%=if(quoteRecord.Quote_PDF != null,"Available for download","Not generated")%></div></div>
						<% if(quoteRecord.Quote_PDF != null) { %><a class='quote-pdf-link zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=quoteRecord.Quote_PDF%>' download><i class='zcs-button-icon zc-li-outline arrows-1-download'></i><span>Download PDF</span></a><% } %>
					</div>
				</section>
				<section class='quote-section quote-action-card zcs-card zcs-p-20 zcs-box-border'>
					<div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-20 zcs-color-theme'></i><h2 class='zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0'>Approval workflow</h2></div>
					<% if(quoteStatus == "Draft") { %><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'>This draft is ready for an authorized internal user to send to the client.</p><% } else if(quoteStatus == "Sent to Client") { %><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'>The client can approve, decline, or request a revision. Decline and revision require FMC notes in the edit dialog.</p><% } else { %><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'>No further approval action is available for this quote status.</p><% } %>
					<p class='zcs-font-12 zcs-color-tertiary zcs-mt-12 zcs-mb-0'>Form, field, and record permissions enforce who may complete each action. The page reloads after a successful update.</p>
				</section>
			</aside>
		</div>
	</main>
<%
}
%>
</div>