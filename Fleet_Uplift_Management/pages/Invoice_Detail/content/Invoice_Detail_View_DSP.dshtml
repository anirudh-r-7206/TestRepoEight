<%
invoiceId = input.Invoice_ID;
invoiceRecord = Client_Invoices[ID == invoiceId];
invoiceAvailable = invoiceRecord.count() > 0;
if(invoiceAvailable)
{
		paymentStatus = ifnull(invoiceRecord.Payment_Status,"Unpaid");
		statusClass = "zcs-badge-yellow";
		if(paymentStatus == "Paid")
		{
				statusClass = "zcs-badge-green";
		}
		else if(paymentStatus == "Partial")
		{
				statusClass = "zcs-badge-blue";
		}
		else if(paymentStatus == "Overdue")
		{
				statusClass = "zcs-badge-red";
		}

		isAdmin = thisapp.permissions.isUserInProfile("Internal_Admin");
		canMarkPaid = isAdmin && (paymentStatus == "Unpaid" || paymentStatus == "Partial" || paymentStatus == "Overdue");
		pageReturn = "%23Page%3AInvoice_Detail%3FInvoice_ID%3D" + invoiceId;
		commonDialog = "&zc_LoadIn=dialog&zc_Header=false&zc_OpenUrlIn=same%20window&zc_NextUrl=" + pageReturn;
		editBase = "#Form:Client_Invoices?recLinkID=" + invoiceId + "&viewLinkName=All_Client_Invoices";
		markPaidUrl = editBase + "&Payment_Status=Paid" + commonDialog + "&zc_SuccMsg=Invoice%20marked%20paid";

		programId = invoiceRecord.Program.ID;
		programLabel = ifnull(invoiceRecord.Program.Service_ID,"Program");
		paymentAuditCount = Audit_Log[Module_Name == "Client_Invoices" && Record_ID == invoiceId && Action == "Payment Status Changed"].count();
}
%>
<style>
/* ZCS global utility sheet, included once for this page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--column-gap:0;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-col-2{flex:0 0 16.666%;max-width:16.666%}.zcs-col-3{flex:0 0 25%;max-width:25%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-10{flex:0 0 83.333%;max-width:83.333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-0{gap:0}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-15{gap:.9375rem}.zcs-gap-16{gap:1rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-15{padding:.9375rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-h-full{height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-list-none{list-style:none}.zcs-break-words{overflow-wrap:break-word}a{text-decoration:none}
/* ZCS component CSS: heading with actions, primary button, filled badge, key/value, notes, simple timeline, and text-only no-data. */
.zcs-back:hover{color:var(--zcs_primary_text_color)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background:var(--zcs_brand_dark_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background:#B8770D;border-color:#B8770D;color:#fff}.zcs-badge-filled.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-labelvalue-wrapper ul{list-style:none}.zcs-notes-wrapper ul{list-style:disc}.zcs-notes-text a:hover{text-decoration:underline}.zcs-tl-indicator{width:60px;left:16.666%}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';display:flex;position:absolute;width:1px;height:calc(100% + 32px);background:#E1E1E1;top:5px}
/* Invoice detail adaptation. */
.invoice-page{min-height:100%;background:var(--zcs-page-bg-color);font-size:14px}.invoice-header{background:#fff;border-bottom:1px solid var(--zcs-border-color);position:sticky;top:0;z-index:5}.invoice-title{min-width:0}.invoice-content{max-width:1280px;margin:0 auto;padding:15px}.invoice-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.38fr);gap:15px;align-items:start}.invoice-main,.invoice-side{min-width:0}.invoice-section-head{border-bottom:1px solid var(--zcs-border-color)}.invoice-summary{background:#F9FAFE}.invoice-detail{min-width:0}.invoice-value{display:block;overflow-wrap:anywhere}.invoice-amount-card{background:var(--zcs_component_hover_color);border:1px solid var(--zcs_brand_color)}.invoice-amount{font-size:30px;line-height:1.2;color:var(--zcs_brand_color)}.invoice-date-card{border-left:3px solid var(--zcs_brand_color);background:#F9FAFE}.invoice-note{white-space:pre-wrap;overflow-wrap:anywhere}.invoice-action-card{border-color:var(--zcs_brand_color)}.invoice-empty{min-height:360px}.invoice-history-empty{min-height:110px;background:#F9FAFE}.invoice-program-link:hover{text-decoration:underline}
@media(max-width:992px){.invoice-layout{grid-template-columns:1fr}.invoice-header{position:static}.invoice-side{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.invoice-side .invoice-action-card{grid-column:1/-1}}
@media(max-width:768px){.invoice-header{padding:14px 15px;align-items:flex-start;flex-direction:column}.invoice-header-action{width:100%}.invoice-header-action .zcs-button{width:100%}.invoice-content{padding:10px}.invoice-side{display:flex;flex-direction:column}.invoice-summary .invoice-detail{flex:0 0 50%;max-width:50%}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}.zcs-col-sm-12{flex:0 0 100%;max-width:100%}}
@media(max-width:520px){.invoice-summary .invoice-detail{flex:0 0 100%;max-width:100%}.invoice-section{padding:14px}.invoice-page h1{font-size:20px}.invoice-amount{font-size:26px}}
</style>
<div class='invoice-page zcs-wh-full zcs-flex zcs-direction-column'>
<%
if(!invoiceAvailable)
{
%>
	<header class='invoice-header zcs-w-full zcs-px-30 zcs-py-16 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><a href='#Page:Invoices' class='zcs-back zcs-color-tertiary' aria-label='Back to invoices'><i class='zc-li-outline arrows-1-tail-left zcs-font-22'></i></a><h1 class='zcs-font-20 zcs-font-medium zcs-color-primary zcs-m-0'>Invoice unavailable</h1></div></header>
	<main class='invoice-content zcs-w-full zcs-box-border'><div class='invoice-empty zcs-card zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-nodata-content zcs-p-24 zcs-box-border'><i class='zc-li-outline ui-1-lock zcs-font-30 zcs-color-tertiary'></i><h2 class='zcs-nodata-header zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>This invoice is not accessible</h2><p class='zcs-font-14 zcs-color-tertiary zcs-mt-8 zcs-mb-0'>It may not exist or may belong to another client account.</p></div></div></main>
<%
}
else
{
%>
	<header class='invoice-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border'>
		<div class='invoice-title zcs-flex zcs-direction-column zcs-gap-4'>
			<div class='zcs-flex zcs-align-items-center zcs-gap-8'><a href='#Page:Invoices' class='zcs-back zcs-color-tertiary' aria-label='Back to invoices'><i class='zc-li-outline arrows-1-tail-left zcs-font-18'></i></a><span class='zcs-font-12 zcs-font-semibold zcs-color-tertiary'>CLIENT INVOICE</span></div>
			<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-10'><h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=ifnull(invoiceRecord.Invoice_Number,"Invoice")%></h1><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13 <%=statusClass%>'><%=paymentStatus%></span></div>
			<p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Program <%=programLabel%> · Net 45 receivable</p>
		</div>
		<% if(canMarkPaid) { %><div class='invoice-header-action'><a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=markPaidUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Mark Paid</span></a></div><% } %>
	</header>

	<main class='invoice-content zcs-w-full zcs-box-border'>
		<div class='invoice-layout'>
			<div class='invoice-main zcs-flex zcs-direction-column zcs-gap-15'>
				<section class='invoice-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='invoice-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Invoice details</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Billing reference, dates, terms, and current payment state.</p></div>
					<div class='invoice-summary zcs-labelvalue-wrapper zcs-row zcs-rounded-xl zcs-p-8 zcs-mt-12 zcs-box-border'>
						<div class='invoice-detail zcs-col-6 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Invoice number</span><strong class='invoice-value zcs-font-16 zcs-color-primary'><%=ifnull(invoiceRecord.Invoice_Number,"Not assigned")%></strong></div>
						<div class='invoice-detail zcs-col-6 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Program</span><a class='invoice-program-link invoice-value zcs-font-16 zcs-font-semibold zcs-color-theme' href='#Page:Program_Detail?Program_ID=<%=programId%>'><%=programLabel%></a></div>
						<div class='invoice-detail invoice-date-card zcs-col-6 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'><i class='zc-li-outline ui-2-time'></i> Invoice date</span><strong class='invoice-value zcs-font-16 zcs-color-primary'><%=ifnull(invoiceRecord.Invoice_Date,"Not set")%></strong></div>
						<div class='invoice-detail invoice-date-card zcs-col-6 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'><i class='zc-li-outline ui-2-time'></i> Due date</span><strong class='invoice-value zcs-font-16 zcs-color-primary'><%=ifnull(invoiceRecord.Due_Date,"Not set")%></strong></div>
						<div class='invoice-detail zcs-col-6 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Payment terms</span><strong class='invoice-value zcs-font-16 zcs-color-primary'><%=ifnull(invoiceRecord.Payment_Terms,"Not set")%></strong></div>
						<div class='invoice-detail zcs-col-6 zcs-flex zcs-direction-column zcs-gap-4 zcs-p-12 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Payment date</span><strong class='invoice-value zcs-font-16 zcs-color-primary'><%=ifnull(invoiceRecord.Payment_Date,"Not recorded")%></strong></div>
					</div>
				</section>

				<section class='invoice-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='invoice-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Notes</h2></div>
					<div class='zcs-notes-wrapper zcs-mt-12'><p class='invoice-note zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><span class='zcs-notes-title zcs-font-medium zcs-color-tertiary'>Invoice notes: </span><%=ifnull(invoiceRecord.Notes,"No notes have been recorded for this invoice.")%></p></div>
				</section>

				<section class='invoice-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='invoice-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Payment and audit history</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>A client-safe timeline of invoice issuance and recorded payment-state changes.</p></div>
					<div class='zcs-timeline-wrapper zcs-mt-16'><ul class='zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0'>
						<li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div><span class='zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-color-tertiary zcs-text-right'><%=ifnull(invoiceRecord.Invoice_Date,"Not recorded")%></span><div class='zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border'><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'>Invoice issued</h3><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mx-0 zcs-mb-0'>Invoice <%=ifnull(invoiceRecord.Invoice_Number,"record")%> was issued for <%=programLabel%>.</p></div></li>
						<%
						for each auditRecord in Audit_Log[Module_Name == "Client_Invoices" && Record_ID == invoiceId && Action == "Payment Status Changed"] sort by Event_Date asc
						{
								auditStatus = ifnull(auditRecord.After_Value,"Updated");
						%>
						<li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div><span class='zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-color-tertiary zcs-text-right'><%=ifnull(auditRecord.Event_Date,"Not recorded")%></span><div class='zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border'><div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'>Payment status updated</h3><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=auditStatus%></span></div><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mx-0 zcs-mb-0'>The invoice payment status changed from <%=ifnull(auditRecord.Before_Value,"Not recorded")%> to <%=auditStatus%>.</p></div></li>
						<% } %>
						<% if(paymentStatus == "Paid" && paymentAuditCount == 0) { %><li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div><span class='zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-color-tertiary zcs-text-right'><%=ifnull(invoiceRecord.Payment_Date,"Not recorded")%></span><div class='zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border'><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'>Payment recorded</h3><p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mx-0 zcs-mb-0'>This invoice is recorded as paid.</p></div></li><% } %>
					</ul></div>
				</section>
			</div>

			<aside class='invoice-side zcs-flex zcs-direction-column zcs-gap-15'>
				<section class='invoice-section invoice-amount-card zcs-card zcs-p-20 zcs-box-border'>
					<div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline business-money-coins zcs-font-20 zcs-color-theme'></i><span class='zcs-font-14 zcs-color-tertiary'>Invoice amount</span></div>
					<strong class='invoice-amount zcs-font-bold zcs-mt-8'>$<%=ifnull(invoiceRecord.Invoice_Amount,0)%></strong>
					<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-mt-16'><span class='zcs-font-13 zcs-color-tertiary'>Payment status</span><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13 <%=statusClass%>'><%=paymentStatus%></span></div>
				</section>

				<section class='invoice-section zcs-card zcs-p-20 zcs-box-border'>
					<div class='invoice-section-head zcs-py-8'><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Payment summary</h2></div>
					<div class='zcs-labelvalue-wrapper zcs-mt-12'><ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'><li class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><span class='zcs-font-14 zcs-color-tertiary'>Terms</span><strong class='zcs-font-14 zcs-color-primary'><%=ifnull(invoiceRecord.Payment_Terms,"Not set")%></strong></li><li class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><span class='zcs-font-14 zcs-color-tertiary'>Due</span><strong class='zcs-font-14 zcs-color-primary'><%=ifnull(invoiceRecord.Due_Date,"Not set")%></strong></li><li class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'><span class='zcs-font-14 zcs-color-tertiary'>Paid on</span><strong class='zcs-font-14 zcs-color-primary'><%=ifnull(invoiceRecord.Payment_Date,"Not recorded")%></strong></li></ul></div>
				</section>

				<% if(canMarkPaid) { %>
				<section class='invoice-section invoice-action-card zcs-card zcs-p-20 zcs-box-border'>
					<div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-20 zcs-color-theme'></i><h2 class='zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0'>Manual payment action</h2></div>
					<p class='zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0'>Mark this invoice paid through the edit form. Validation records the payment date and audit event, then returns to this page.</p>
					<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-mt-16' href='<%=markPaidUrl%>'><i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i><span>Mark Paid</span></a>
				</section>
				<% } %>
			</aside>
		</div>
	</main>
<%
}
%>
</div>