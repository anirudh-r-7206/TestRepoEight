<%
programId = input.Program_ID;
if(programId != null && programId > 0)
{
		approvedQuotes = Quotes[Status == "Approved" && Program == programId] sort by FMC_Approval_Date descending;
		poRecords = Purchase_Orders[Program == programId] sort by PO_Date descending;
}
else
{
		approvedQuotes = Quotes[Status == "Approved"] sort by FMC_Approval_Date descending;
		poRecords = Purchase_Orders[ID != 0] sort by PO_Date descending;
}

returnFragment = "%23Page%3APO_Green_Light";
if(programId != null && programId > 0)
{
		returnFragment = returnFragment + "%3FProgram_ID%3D" + programId;
}
commonDialog = "&zc_LoadIn=dialog&zc_Header=false&zc_OpenUrlIn=same%20window&zc_NextUrl=" + returnFragment;

availableQuoteCount = 0;
for each approvedQuote in approvedQuotes
{
		if(Purchase_Orders[Quote == approvedQuote.ID].count() == 0)
		{
				availableQuoteCount = availableQuoteCount + 1;
		}
}
%>
<style>
/* ZCS global utilities used on this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-black-color:#000;font-size:16px;line-height:1.5}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-22{font-size:1.375rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-overflow-auto{overflow:auto}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}
/* ZCS buttons */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.zcs-button:focus,.zcs-custom-btn:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}
/* ZCS filled outlined badges */
.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#9b6708}.zcs-badge-filled-outline.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}
/* ZCS table with custom action buttons */
:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1120px}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:var(--zcs-tr-h-color)}.zcs-custom-btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color);white-space:nowrap}.zcs-custom-btn:hover{background:var(--zcs_component_hover_color)}
/* ZCS notes and no-data adaptations */
.zcs-notes-text a:hover{text-decoration:underline}.zcs-nodata-wrapper{min-height:240px}.zcs-nodata-icon{width:56px;height:56px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);border-radius:50%;font-size:24px}.zcs-nodata-content{max-width:560px}
/* Page-specific responsive layout */
.po-page{min-height:100%;background:var(--zcs-page-bg-color);font-size:14px}.po-page-header{background:var(--zcs-white-color);border-bottom:1px solid var(--zcs-border-color);position:sticky;top:0;z-index:5}.po-title-block{min-width:0}.po-page-content{padding:15px}.po-create-panel{background:var(--zcs-white-color)}.po-create-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.po-create-card{border:1px solid var(--zcs-border-color);background:#F9FAFE;min-width:0}.po-create-meta{min-width:0}.po-create-name{overflow-wrap:anywhere}.po-table-card{background:var(--zcs-white-color)}.po-mobile-list{display:none}.po-mobile-card{background:var(--zcs-white-color)}.po-mobile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));background:#F9FAFE}.po-field{min-width:0}.po-value{overflow-wrap:anywhere}.po-note{border-left:3px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.po-doc{color:var(--zcs_brand_color)}.po-actions{justify-content:flex-start}.po-context{background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}
@media(max-width:1100px){.po-create-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:768px){.po-page-header{position:static;padding:16px 15px}.po-page-content{padding:12px}.po-create-list{grid-template-columns:1fr}.po-desktop-table{display:none}.po-mobile-list{display:flex}.po-mobile-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.po-table-card{padding:0;border:0;background:transparent}.po-table-heading{padding:4px 2px}.po-actions .zcs-custom-btn{flex:1 1 auto;justify-content:center}.po-header-icon{display:none}}
@media(max-width:480px){.po-mobile-grid{grid-template-columns:1fr}.po-mobile-card{padding:14px}.po-actions{display:grid;grid-template-columns:1fr}.po-actions .zcs-custom-btn{width:100%;box-sizing:border-box}.po-create-card{padding:14px}}
</style>

<div class='po-page zcs-wh-full zcs-flex zcs-direction-column'>
	<header class='po-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border'>
		<div class='po-title-block zcs-flex zcs-align-items-center zcs-gap-12'>
			<div class='po-header-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg zcs-color-theme'><i class='zc-li-outline files-single-content-03 zcs-font-22'></i></div>
			<div>
				<h1 class='zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Purchase Orders and Green Light</h1>
				<p class='zcs-font-14 zcs-lh-body zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Acknowledge received purchase orders and advance approved work into execution.</p>
			</div>
		</div>
		<% if(programId != null && programId > 0) { %>
		<span class='po-context zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-md zcs-px-12 zcs-py-6 zcs-font-13 zcs-font-medium'><i class='zc-li-outline ui-1-filter'></i> Program <%=programId%></span>
		<% } %>
	</header>

	<main class='po-page-content zcs-flex zcs-direction-column zcs-gap-16 zcs-box-border'>
		<% if(availableQuoteCount > 0) { %>
		<section class='po-create-panel zcs-card zcs-p-20 zcs-box-border' aria-labelledby='available-quotes-heading'>
			<div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12'>
				<div>
					<h2 id='available-quotes-heading' class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Approved quotes awaiting a purchase order</h2>
					<p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Create one purchase order for each approved quote that does not already have one.</p>
				</div>
				<span class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=availableQuoteCount%> available</span>
			</div>
			<div class='po-create-list zcs-gap-12 zcs-mt-16'>
			<%
			for each approvedQuote in approvedQuotes
			{
					existingPOCount = Purchase_Orders[Quote == approvedQuote.ID].count();
					if(existingPOCount == 0)
					{
							quoteProgramId = approvedQuote.Program.ID;
							createUrl = "#Form:Purchase_Orders?Program=" + quoteProgramId + "&Quote=" + approvedQuote.ID + "&PO_Amount=" + approvedQuote.Quote_Total + commonDialog + "&zc_SuccMsg=Purchase%20order%20created%20successfully";
			%>
				<article class='po-create-card zcs-flex zcs-direction-column zcs-gap-12 zcs-rounded-lg zcs-p-16 zcs-box-border'>
					<div class='po-create-meta'>
						<div class='zcs-font-12 zcs-font-medium zcs-color-tertiary'>APPROVED QUOTE</div>
						<h3 class='po-create-name zcs-font-16 zcs-font-semibold zcs-color-primary zcs-mt-4 zcs-mb-0'><%=ifnull(approvedQuote.Quote_Number,"Approved quote")%></h3>
						<div class='zcs-font-13 zcs-color-secondary zcs-mt-4'>Program <%=ifnull(approvedQuote.Program.Service_ID,quoteProgramId)%></div>
					</div>
					<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
						<strong class='zcs-font-14 zcs-color-primary'>$<%=ifnull(approvedQuote.Quote_Total,0)%></strong>
						<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='<%=createUrl%>'>
							<i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i><span>Create PO</span>
						</a>
					</div>
				</article>
			<%
					}
			}
			%>
			</div>
		</section>
		<% } %>

		<section class='po-table-card zcs-card zcs-p-20 zcs-box-border' aria-labelledby='purchase-orders-heading'>
			<div class='po-table-heading zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-12'>
				<div>
					<h2 id='purchase-orders-heading' class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Accessible purchase orders</h2>
					<p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Records and controls are subject to the current user's record, field, and form permissions.</p>
				</div>
				<span class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=poRecords.count()%> records</span>
			</div>

			<% if(poRecords.count() > 0) { %>
			<div class='po-desktop-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-16'>
				<table class='zcs-w-full'>
					<thead>
						<tr>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Program</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Approved quote</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>PO number</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Date</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary'>Amount</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Status</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Acknowledgement</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Notes</th>
							<th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Actions</th>
						</tr>
					</thead>
					<tbody>
					<%
					for each poRecord in poRecords
					{
							statusValue = ifnull(poRecord.Status,"Received");
							statusClass = "zcs-badge-yellow";
							if(statusValue == "Acknowledged")
							{
									statusClass = "zcs-badge-blue";
							}
							else if(statusValue == "Green Light Issued")
							{
									statusClass = "zcs-badge-green";
							}
							editBaseUrl = "#Form:Purchase_Orders?recLinkID=" + poRecord.ID + "&viewLinkName=All_Purchase_Orders";
							recordDialogUrl = editBaseUrl + commonDialog;
							acknowledgeUrl = editBaseUrl + "&Status=Acknowledged" + commonDialog + "&zc_SuccMsg=Purchase%20order%20acknowledged%20successfully";
							greenLightUrl = editBaseUrl + "&Status=Green%20Light%20Issued" + commonDialog + "&zc_SuccMsg=Green%20Light%20issued%20successfully";
							documentAvailable = poRecord.PO_Acknowledgement_Document != null && poRecord.PO_Acknowledgement_Document != "";
					%>
						<tr>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-primary'><a class='zcs-color-theme zcs-font-medium' href='#Page:Program_Detail?Program_ID=<%=poRecord.Program.ID%>'><%=ifnull(poRecord.Program.Service_ID,poRecord.Program.ID)%></a></td>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-primary'><%=ifnull(poRecord.Quote.Quote_Number,"—")%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-font-medium zcs-color-primary'><%=ifnull(poRecord.FMC_PO_Number,"—")%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-primary'><%=ifnull(poRecord.PO_Date,"—")%></td>
							<td class='zcs-px-16 zcs-py-12 zcs-text-right zcs-font-14 zcs-color-primary'>$<%=ifnull(poRecord.PO_Amount,0)%></td>
							<td class='zcs-px-16 zcs-py-12'><span class='zcs-badge zcs-badge-filled-outline <%=statusClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-13'><%=statusValue%></span></td>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14'><% if(documentAvailable) { %><a class='po-doc zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-font-medium' href='<%=recordDialogUrl%>'><i class='zc-li-outline files-2-doc'></i> View document</a><% } else { %><span class='zcs-color-tertiary'>Not generated</span><% } %></td>
							<td class='zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-secondary'><%=ifnull(poRecord.Notes,"—")%></td>
							<td class='zcs-px-16 zcs-py-12'>
								<div class='po-actions zcs-flex zcs-row-wrap zcs-gap-6'>
									<% if(statusValue == "Received") { %><a class='zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm zcs-font-13 zcs-font-medium' href='<%=acknowledgeUrl%>'><i class='zc-li-outline ui-1-check-circle-08'></i>Acknowledge</a><% } %>
									<% if(statusValue == "Received" || statusValue == "Acknowledged") { %><a class='zcs-custom-btn zcs-px-10 zcs-py-6 zcs-rounded-sm zcs-font-13 zcs-font-medium' href='<%=greenLightUrl%>'><i class='zc-li-outline arrows-1-tail-right'></i>Mark Green Light</a><% } %>
								</div>
							</td>
						</tr>
					<% } %>
					</tbody>
				</table>
			</div>

			<div class='po-mobile-list zcs-direction-column zcs-gap-12 zcs-mt-16'>
			<%
			for each poRecord in poRecords
			{
					statusValue = ifnull(poRecord.Status,"Received");
					statusClass = "zcs-badge-yellow";
					if(statusValue == "Acknowledged")
					{
							statusClass = "zcs-badge-blue";
					}
					else if(statusValue == "Green Light Issued")
					{
							statusClass = "zcs-badge-green";
					}
					editBaseUrl = "#Form:Purchase_Orders?recLinkID=" + poRecord.ID + "&viewLinkName=All_Purchase_Orders";
					recordDialogUrl = editBaseUrl + commonDialog;
					acknowledgeUrl = editBaseUrl + "&Status=Acknowledged" + commonDialog + "&zc_SuccMsg=Purchase%20order%20acknowledged%20successfully";
					greenLightUrl = editBaseUrl + "&Status=Green%20Light%20Issued" + commonDialog + "&zc_SuccMsg=Green%20Light%20issued%20successfully";
					documentAvailable = poRecord.PO_Acknowledgement_Document != null && poRecord.PO_Acknowledgement_Document != "";
			%>
				<article class='po-mobile-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
					<div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-10'>
						<div>
							<div class='zcs-font-12 zcs-color-tertiary'>PURCHASE ORDER</div>
							<h3 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-mt-4 zcs-mb-0'><%=ifnull(poRecord.FMC_PO_Number,"—")%></h3>
							<a class='zcs-color-theme zcs-font-13 zcs-font-medium' href='#Page:Program_Detail?Program_ID=<%=poRecord.Program.ID%>'><%=ifnull(poRecord.Program.Service_ID,poRecord.Program.ID)%></a>
						</div>
						<span class='zcs-badge zcs-badge-filled-outline <%=statusClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=statusValue%></span>
					</div>
					<div class='po-mobile-grid zcs-rounded-lg zcs-p-12 zcs-gap-12 zcs-box-border'>
						<div class='po-field'><div class='zcs-font-12 zcs-color-tertiary'>Approved quote</div><strong class='po-value zcs-font-14 zcs-color-primary'><%=ifnull(poRecord.Quote.Quote_Number,"—")%></strong></div>
						<div class='po-field'><div class='zcs-font-12 zcs-color-tertiary'>PO date</div><strong class='po-value zcs-font-14 zcs-color-primary'><%=ifnull(poRecord.PO_Date,"—")%></strong></div>
						<div class='po-field'><div class='zcs-font-12 zcs-color-tertiary'>Amount</div><strong class='po-value zcs-font-14 zcs-color-primary'>$<%=ifnull(poRecord.PO_Amount,0)%></strong></div>
						<div class='po-field'><div class='zcs-font-12 zcs-color-tertiary'>Acknowledgement</div><% if(documentAvailable) { %><a class='po-doc zcs-font-14 zcs-font-medium' href='<%=recordDialogUrl%>'>View document</a><% } else { %><span class='zcs-font-14 zcs-color-tertiary'>Not generated</span><% } %></div>
					</div>
					<% if(poRecord.Notes != null && poRecord.Notes != "") { %>
					<div class='zcs-notes-wrapper po-note zcs-rounded-lg zcs-p-12 zcs-box-border'><p class='zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-secondary'><span class='zcs-font-medium zcs-color-primary'>Notes: </span><%=poRecord.Notes%></p></div>
					<% } %>
					<div class='po-actions zcs-flex zcs-row-wrap zcs-gap-8'>
						<% if(statusValue == "Received") { %><a class='zcs-custom-btn zcs-px-12 zcs-py-8 zcs-rounded-md zcs-font-14 zcs-font-medium' href='<%=acknowledgeUrl%>'><i class='zc-li-outline ui-1-check-circle-08'></i>Acknowledge</a><% } %>
						<% if(statusValue == "Received" || statusValue == "Acknowledged") { %><a class='zcs-custom-btn zcs-px-12 zcs-py-8 zcs-rounded-md zcs-font-14 zcs-font-medium' href='<%=greenLightUrl%>'><i class='zc-li-outline arrows-1-tail-right'></i>Mark Green Light</a><% } %>
					</div>
				</article>
			<% } %>
			</div>
			<% } else { %>
			<div class='zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
				<div class='zcs-nodata-content zcs-p-20 zcs-box-border'>
					<div class='zcs-nodata-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-m-0'><i class='zc-li-outline files-single-content-03'></i></div>
					<h3 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-mt-10 zcs-mb-0'>No accessible purchase orders</h3>
					<p class='zcs-font-14 zcs-color-tertiary zcs-mt-12 zcs-mb-0'>No purchase orders match this program context or your current record permissions.</p>
					<% if(availableQuoteCount > 0) { %><p class='zcs-font-13 zcs-color-tertiary zcs-mt-8 zcs-mb-0'>Use an approved quote above to create the first purchase order.</p><% } %>
				</div>
			</div>
			<% } %>
		</section>

		<div class='zcs-notes-wrapper zcs-card zcs-p-16 zcs-box-border'>
			<p class='zcs-notes-text zcs-m-0 zcs-font-13 zcs-color-secondary'><span class='zcs-notes-title zcs-font-medium zcs-color-primary'>Workflow note: </span>Marking Green Light submits the Purchase Orders form. Its existing workflow creates work orders and prevents duplicate work-order creation; this page performs no record writes.</p>
		</div>
	</main>
</div>