<%
openProgramCount = Programs[Program_Status != "Closed"].count();
vehiclesExecutionCount = Vehicles[Vehicle_Status == "Parts Ordered" || Vehicle_Status == "Arrived" || Vehicle_Status == "In Progress"].count();
pendingEstimateCount = Estimates[Status == "Pending Upfitter Review" || Status == "Revision Requested"].count();
pendingQuoteApprovalCount = Programs[Program_Status == "Pending Quote Approval"].count();
openCoverageGapCount = Issues[Issue_Type == "Coverage Gap" && (Status == "Open" || Status == "In Progress")].count();

programRequest = Programs[Program_Status == "Request Intake"].count();
programScope = Programs[Program_Status == "Scope & Source"].count();
programMatching = Programs[Program_Status == "Upfitter Matching"].count();
programEstimates = Programs[Program_Status == "Pending Estimates"].count();
programQuote = Programs[Program_Status == "Pending Quote Approval"].count();
programPO = Programs[Program_Status == "PO Received"].count();
programExecution = Programs[Program_Status == "In Execution"].count();
programClosed = Programs[Program_Status == "Closed"].count();
programMax = 1;
for each programValue in {programRequest,programScope,programMatching,programEstimates,programQuote,programPO,programExecution,programClosed}
{
		if(programValue > programMax)
		{
				programMax = programValue;
		}
}

vehicleScheduled = Vehicles[Vehicle_Status == "Scheduled"].count();
vehicleParts = Vehicles[Vehicle_Status == "Parts Ordered"].count();
vehicleArrived = Vehicles[Vehicle_Status == "Arrived"].count();
vehicleProgress = Vehicles[Vehicle_Status == "In Progress"].count();
vehicleCompleted = Vehicles[Vehicle_Status == "Completed"].count();
vehiclePicked = Vehicles[Vehicle_Status == "Picked Up"].count();
vehicleMax = 1;
for each vehicleValue in {vehicleScheduled,vehicleParts,vehicleArrived,vehicleProgress,vehicleCompleted,vehiclePicked}
{
		if(vehicleValue > vehicleMax)
		{
				vehicleMax = vehicleValue;
		}
}

programLabels = {"Request Intake","Scope & Source","Upfitter Matching","Pending Estimates","Pending Quote Approval","PO Received","In Execution","Closed"};
programValues = {programRequest,programScope,programMatching,programEstimates,programQuote,programPO,programExecution,programClosed};
vehicleLabels = {"Scheduled","Parts Ordered","Arrived","In Progress","Completed","Picked Up"};
vehicleValues = {vehicleScheduled,vehicleParts,vehicleArrived,vehicleProgress,vehicleCompleted,vehiclePicked};
issueCount = Issues[(Priority == "High" || Issue_Type == "Coverage Gap") && (Status == "Open" || Status == "In Progress")].count();
arrivalCount = Vehicles[Arrival_Date >= zoho.currentdate && Arrival_Date <= zoho.currentdate.addDay(14) && Vehicle_Status != "Completed" && Vehicle_Status != "Picked Up"].count();
activityCount = Audit_Log[ID != 0].count();
%>
<style>
/* ZCS global utility sheet, included once for this page. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-black-color:#000;font-size:16px;line-height:1.5}
*{box-sizing:border-box}.zcs-row,.zcs-flex,.zcs-inline-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-align-items-end{align-items:flex-end}.zcs-justify-start{justify-content:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-h-full{height:100%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-overflow-auto{overflow:auto}.zcs-overflow-hidden{overflow:hidden}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-break-words{overflow-wrap:break-word}.zcs-cursor-pointer{cursor:pointer}.zcs-no-underline{text-decoration:none}
.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-3{flex:0 0 25%;max-width:25%}.zcs-col-4{flex:0 0 33.3333%;max-width:33.3333%}.zcs-col-5{flex:0 0 41.6667%;max-width:41.6667%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-7{flex:0 0 58.3333%;max-width:58.3333%}.zcs-col-8{flex:0 0 66.6667%;max-width:66.6667%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}
.zcs-gap-2{gap:.125rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mx-0{margin-left:0;margin-right:0}
.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-color-green{color:#179E6C}.zcs-color-red{color:#FE455D}.zcs-color-yellow{color:#b8770d}.zcs-color-blue{color:#09598E}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}
/* ZCS header, buttons, badges, progress chart, table, timeline, and no-data components. */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:#fff}.zcs-badge-filled.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background:#F4660C;border-color:#F4660C;color:#fff}.zcs-progress-bar{height:8px;background:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background:var(--zcs_brand_color)}
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:720px}.zcs-table-wrapper thead{top:0}.zcs-table-wrapper thead th{background:#F9FAFE;box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper tbody td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper tbody tr:hover td{background:#F9FAFE}.zcs-tl-indicator{width:42px;left:0}.zcs-tl-dot{width:12px;height:12px;background:var(--zcs_brand_color);border:1px solid #fff;box-shadow:0 2px 6px #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';display:flex;position:absolute;width:1px;height:calc(100% + 20px);background:#E1E1E1;top:5px}.zcs-tl-content{padding-left:42px}.zcs-nodata-wrapper{min-height:130px}
.pipeline-page{min-height:100%;background:var(--zcs-page-bg-color);padding:15px;font-family:Arial,sans-serif;font-size:14px;color:var(--zcs-primary-text-color)}.pipeline-header{background:linear-gradient(120deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border:0;overflow:hidden}.pipeline-header:after{content:'';position:absolute;width:240px;height:240px;border:42px solid rgba(255,255,255,.09);border-radius:50%;right:-80px;top:-100px}.pipeline-header-content{z-index:1}.pipeline-grid{display:grid;gap:15px}.pipeline-kpis{grid-template-columns:repeat(5,minmax(0,1fr))}.pipeline-two{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.pipeline-bottom{grid-template-columns:minmax(0,1.4fr) minmax(300px,.6fr)}.pipeline-card{min-width:0}.pipeline-kpi{transition:transform .15s ease,border-color .15s ease}.pipeline-kpi:hover{transform:translateY(-2px);border-color:var(--zcs_brand_color)}.pipeline-kpi-icon{width:42px;height:42px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);border-radius:12px}.pipeline-kpi-alert .pipeline-kpi-icon{background:#FDE3E6;color:#FE455D}.pipeline-section-head{min-height:42px}.pipeline-chart-row{display:grid;grid-template-columns:minmax(126px,1fr) minmax(120px,3fr) 34px;align-items:center;gap:10px}.pipeline-chart-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pipeline-vehicle-bars .zcs-progress-bar-indicator{background:#2A6FFC}.pipeline-row-link:hover{text-decoration:underline}.pipeline-quick-link{border-top:1px solid var(--zcs_tertiary_border_color)}.pipeline-quick-link:first-child{border-top:0}.pipeline-quick-link:hover{background:#F9FAFE}.pipeline-empty{border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px}.pipeline-description{max-width:620px}.pipeline-activity{max-height:430px;overflow:auto}.pipeline-arrivals{max-height:390px;overflow:auto}.pipeline-arrival{border-top:1px solid var(--zcs_tertiary_border_color)}.pipeline-arrival:first-child{border-top:0}.pipeline-date{min-width:54px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}
@media(max-width:1100px){.pipeline-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.pipeline-bottom{grid-template-columns:1fr}.pipeline-arrivals{max-height:none}}
@media(max-width:768px){.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.pipeline-page{padding:12px}.pipeline-kpis,.pipeline-two{grid-template-columns:1fr 1fr}.pipeline-header-content{align-items:flex-start;flex-direction:column}.pipeline-header-actions{width:100%;flex-wrap:wrap}.pipeline-header-actions .zcs-button{flex:1 1 auto}.pipeline-chart-row{grid-template-columns:minmax(105px,1fr) minmax(90px,2fr) 30px}.pipeline-table-wrap table{min-width:650px}}
@media(max-width:520px){.pipeline-kpis,.pipeline-two{grid-template-columns:1fr}.pipeline-card{padding:16px}.pipeline-header{padding:20px}.pipeline-chart-row{grid-template-columns:1fr 34px}.pipeline-chart-row .zcs-progress-bar{grid-column:1 / 3}.pipeline-description{font-size:13px}.pipeline-header-actions{flex-direction:column}.pipeline-header-actions .zcs-button{width:100%}}
</style>
<div class='pipeline-page zcs-flex zcs-direction-column zcs-gap-16 zcs-box-border'>
	<section class='pipeline-header zcs-card zcs-relative zcs-p-24'>
		<div class='pipeline-header-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-relative'>
			<div class='zcs-flex zcs-direction-column zcs-gap-6'>
				<span class='zcs-font-13 zcs-font-semibold zcs-color-white'>OPERATIONS OVERVIEW</span>
				<h1 class='zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-white zcs-m-0'>Pipeline Dashboard</h1>
				<p class='pipeline-description zcs-font-14 zcs-lh-body zcs-color-white zcs-m-0'>Monitor program and vehicle flow, upcoming arrivals, operational exceptions, and coverage risk.</p>
			</div>
			<div class='pipeline-header-actions zcs-flex zcs-align-items-center zcs-gap-10'>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='#Page:Program_Workspace'><i class='zcs-button-icon zc-li-outline files-folder-13'></i><span>Programs</span></a>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14' href='#Page:Issue_Tracker'><i class='zcs-button-icon zc-li-outline ui-2-time'></i><span>Issue Tracker</span></a>
			</div>
		</div>
	</section>

	<section class='pipeline-grid pipeline-kpis'>
		<a class='pipeline-kpi zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-16 zcs-color-primary' href='#Page:Program_Workspace'>
			<span class='pipeline-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink'><i class='zc-li-outline files-folder-13 zcs-font-20'></i></span><span class='zcs-flex zcs-direction-column'><span class='zcs-font-13 zcs-color-tertiary'>Open programs</span><strong class='zcs-font-24 zcs-lh-heading'><%=openProgramCount%></strong></span>
		</a>
		<a class='pipeline-kpi zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-16 zcs-color-primary' href='#Page:Execution_Tracker'>
			<span class='pipeline-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink'><i class='zc-li-outline design-app zcs-font-20'></i></span><span class='zcs-flex zcs-direction-column'><span class='zcs-font-13 zcs-color-tertiary'>Vehicles in execution</span><strong class='zcs-font-24 zcs-lh-heading'><%=vehiclesExecutionCount%></strong></span>
		</a>
		<a class='pipeline-kpi zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-16 zcs-color-primary' href='#Page:Estimate_Review'>
			<span class='pipeline-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink'><i class='zc-li-outline files-single-content-03 zcs-font-20'></i></span><span class='zcs-flex zcs-direction-column'><span class='zcs-font-13 zcs-color-tertiary'>Pending estimates</span><strong class='zcs-font-24 zcs-lh-heading'><%=pendingEstimateCount%></strong></span>
		</a>
		<a class='pipeline-kpi zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-16 zcs-color-primary' href='#Page:Program_Workspace'>
			<span class='pipeline-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-20'></i></span><span class='zcs-flex zcs-direction-column'><span class='zcs-font-13 zcs-color-tertiary'>Pending quote approvals</span><strong class='zcs-font-24 zcs-lh-heading'><%=pendingQuoteApprovalCount%></strong></span>
		</a>
		<a class='pipeline-kpi pipeline-kpi-alert zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-16 zcs-color-primary' href='#Page:Issue_Tracker'>
			<span class='pipeline-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink'><i class='zc-li-outline ui-2-time zcs-font-20'></i></span><span class='zcs-flex zcs-direction-column'><span class='zcs-font-13 zcs-color-tertiary'>Open coverage gaps</span><strong class='zcs-font-24 zcs-lh-heading'><%=openCoverageGapCount%></strong></span>
		</a>
	</section>

	<section class='pipeline-grid pipeline-two'>
		<article class='pipeline-card zcs-card zcs-p-20'>
			<div class='pipeline-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-12'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Programs by lifecycle status</h2><span class='zcs-font-13 zcs-color-tertiary'>Current workload across all stages</span></div><a class='zcs-font-13 zcs-font-medium zcs-color-theme' href='#Page:Program_Workspace'>View programs</a></div>
			<ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'>
			<% for each index programIndex in programLabels { programBar = (programValues.get(programIndex) * 100.0) / programMax; %>
				<li class='pipeline-chart-row'><span class='pipeline-chart-label zcs-font-13 zcs-color-tertiary'><%=programLabels.get(programIndex)%></span><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=programBar%>%;'></div></div><strong class='zcs-font-13 zcs-color-primary zcs-text-right'><%=programValues.get(programIndex)%></strong></li>
			<% } %>
			</ul>
		</article>
		<article class='pipeline-card pipeline-vehicle-bars zcs-card zcs-p-20'>
			<div class='pipeline-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-12'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Vehicles by status</h2><span class='zcs-font-13 zcs-color-tertiary'>VIN progression through execution and QC</span></div><a class='zcs-font-13 zcs-font-medium zcs-color-theme' href='#Page:Execution_Tracker'>Open tracker</a></div>
			<ul class='zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0'>
			<% for each index vehicleIndex in vehicleLabels { vehicleBar = (vehicleValues.get(vehicleIndex) * 100.0) / vehicleMax; %>
				<li class='pipeline-chart-row'><span class='pipeline-chart-label zcs-font-13 zcs-color-tertiary'><%=vehicleLabels.get(vehicleIndex)%></span><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=vehicleBar%>%;'></div></div><strong class='zcs-font-13 zcs-color-primary zcs-text-right'><%=vehicleValues.get(vehicleIndex)%></strong></li>
			<% } %>
			</ul>
		</article>
	</section>

	<section class='pipeline-card zcs-card zcs-p-20'>
		<div class='pipeline-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-12'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>High-priority issues and coverage gaps</h2><span class='zcs-font-13 zcs-color-tertiary'>Open exceptions requiring operational attention</span></div><a class='zcs-font-13 zcs-font-medium zcs-color-theme' href='#Page:Issue_Tracker'>View all issues</a></div>
		<% if(issueCount == 0) { %>
		<div class='pipeline-empty zcs-nodata-wrapper zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-green'></i><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-mt-8 zcs-mb-0'>No urgent open issues</h3><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>High-priority exceptions and coverage gaps will appear here.</p></div></div>
		<% } else { %>
		<div class='pipeline-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-relative'>
			<table class='zcs-w-full'><thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Issue</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Program / Vehicle</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Priority</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Opened</th></tr></thead><tbody>
			<% issueShown = 0; for each issueRecord in Issues[(Priority == "High" || Issue_Type == "Coverage Gap") && (Status == "Open" || Status == "In Progress")] sort by Opened_Date desc { if(issueShown < 8) { issueShown = issueShown + 1; priorityClass = if(issueRecord.Priority == "High","zcs-badge-red","zcs-badge-yellow"); statusClass = if(issueRecord.Status == "In Progress","zcs-badge-blue","zcs-badge-orange"); %>
			<tr><td class='zcs-px-16 zcs-py-12'><div class='zcs-flex zcs-direction-column zcs-gap-2'><strong class='zcs-font-14 zcs-color-primary'><%=ifnull(issueRecord.Issue_Type,"Issue")%></strong><span class='zcs-font-13 zcs-color-tertiary zcs-break-words'><%=ifnull(issueRecord.Description,"")%></span></div></td><td class='zcs-px-16 zcs-py-12'><div class='zcs-flex zcs-direction-column zcs-gap-4'><a class='pipeline-row-link zcs-font-14 zcs-font-medium zcs-color-theme' href='#Page:Program_Detail?Program_ID=<%=issueRecord.Program.ID%>'><%=ifnull(issueRecord.Program.Service_ID,"Program")%></a><% if(issueRecord.Vehicle != null) { %><a class='pipeline-row-link zcs-font-13 zcs-color-tertiary' href='#Page:Vehicle_Detail?Vehicle_ID=<%=issueRecord.Vehicle.ID%>'><%=ifnull(issueRecord.Vehicle.VIN,"Vehicle")%></a><% } %></div></td><td class='zcs-px-16 zcs-py-12'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=priorityClass%>'><span class='zcs-font-12'><%=issueRecord.Priority%></span></span></td><td class='zcs-px-16 zcs-py-12'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 <%=statusClass%>'><span class='zcs-font-12'><%=issueRecord.Status%></span></span></td><td class='zcs-px-16 zcs-py-12 zcs-font-13 zcs-color-tertiary'><%=issueRecord.Opened_Date.toString("dd-MMM-yyyy")%></td></tr>
			<% } } %>
			</tbody></table>
		</div>
		<% } %>
	</section>

	<section class='pipeline-grid pipeline-bottom'>
		<article class='pipeline-card zcs-card zcs-p-20'>
			<div class='pipeline-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-12'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Upcoming arrivals</h2><span class='zcs-font-13 zcs-color-tertiary'>Scheduled in the next 14 days</span></div><a class='zcs-font-13 zcs-font-medium zcs-color-theme' href='#Page:Execution_Tracker'>Execution tracker</a></div>
			<% if(arrivalCount == 0) { %>
			<div class='pipeline-empty zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><i class='zc-li-outline ui-2-time zcs-font-24 zcs-color-tertiary'></i><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-mt-8 zcs-mb-0'>No upcoming arrivals</h3><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Vehicles arriving within two weeks will appear here.</p></div></div>
			<% } else { %>
			<div class='pipeline-arrivals zcs-flex zcs-direction-column'>
			<% arrivalShown = 0; for each vehicleRecord in Vehicles[Arrival_Date >= zoho.currentdate && Arrival_Date <= zoho.currentdate.addDay(14) && Vehicle_Status != "Completed" && Vehicle_Status != "Picked Up"] sort by Arrival_Date asc { if(arrivalShown < 8) { arrivalShown = arrivalShown + 1; %>
				<div class='pipeline-arrival zcs-flex zcs-align-items-center zcs-gap-12 zcs-py-12'><div class='pipeline-date zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-lg zcs-p-8'><strong class='zcs-font-18 zcs-lh-heading'><%=vehicleRecord.Arrival_Date.getDay()%></strong><span class='zcs-font-11 zcs-font-semibold'><%=vehicleRecord.Arrival_Date.toString("MMM").toUpperCase()%></span></div><div class='zcs-col-common zcs-flex zcs-direction-column zcs-gap-2 zcs-ellipsis'><a class='pipeline-row-link zcs-font-14 zcs-font-medium zcs-color-theme zcs-ellipsis' href='#Page:Vehicle_Detail?Vehicle_ID=<%=vehicleRecord.ID%>'><%=ifnull(vehicleRecord.VIN,"Vehicle")%></a><span class='zcs-font-13 zcs-color-tertiary zcs-ellipsis'><%=ifnull(vehicleRecord.Program.Service_ID,"Program")%> · <%=ifnull(vehicleRecord.Make,"")%> <%=ifnull(vehicleRecord.Model,"")%></span></div><span class='zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2'><span class='zcs-font-12'><%=vehicleRecord.Vehicle_Status%></span></span></div>
			<% } } %>
			</div>
			<% } %>
		</article>

		<article class='pipeline-card zcs-card zcs-p-20'>
			<div class='pipeline-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-12'><div><h2 class='zcs-font-18 zcs-font-medium zcs-color-primary zcs-m-0'>Recent activity</h2><span class='zcs-font-13 zcs-color-tertiary'>Latest audited lifecycle events</span></div></div>
			<% if(activityCount == 0) { %>
			<div class='pipeline-empty zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='zcs-p-20'><h3 class='zcs-font-16 zcs-font-medium zcs-color-primary zcs-m-0'>No recent activity</h3></div></div>
			<% } else { %>
			<div class='pipeline-activity zcs-timeline-wrapper'><ul class='zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0'>
			<% activityShown = 0; for each activityRecord in Audit_Log[ID != 0] sort by Event_Date desc { if(activityShown < 7) { activityShown = activityShown + 1; %>
				<li class='zcs-tl-li zcs-flex zcs-relative'><div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-relative'></span></div><div class='zcs-tl-content zcs-flex zcs-direction-column zcs-col-common'><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><strong class='zcs-font-14 zcs-font-medium zcs-color-primary'><%=ifnull(activityRecord.Action,"Activity")%></strong><span class='zcs-font-11 zcs-color-tertiary'><%=activityRecord.Event_Date.toString("dd-MMM HH:mm")%></span></div><span class='zcs-font-13 zcs-color-tertiary'><%=ifnull(activityRecord.Module_Name,"Record")%><% if(activityRecord.Program != null) { %> · <a class='pipeline-row-link zcs-color-theme' href='#Page:Program_Detail?Program_ID=<%=activityRecord.Program.ID%>'><%=ifnull(activityRecord.Program.Service_ID,"Program")%></a><% } %></span><% if(activityRecord.Details != null && activityRecord.Details != "") { %><p class='zcs-font-13 zcs-color-primary zcs-mt-4 zcs-mb-0 zcs-break-words'><%=activityRecord.Details%></p><% } %></div></li>
			<% } } %>
			</ul></div>
			<% } %>
			<div class='zcs-flex zcs-direction-column zcs-mt-8'>
				<a class='pipeline-quick-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-py-12 zcs-color-primary' href='#Page:Program_Workspace'><span class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline files-folder-13 zcs-color-theme'></i><span class='zcs-font-14'>Program workspace</span></span><i class='zc-li-outline arrows-1-tail-right zcs-color-tertiary'></i></a>
				<a class='pipeline-quick-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-py-12 zcs-color-primary' href='#Page:Issue_Tracker'><span class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline ui-2-time zcs-color-theme'></i><span class='zcs-font-14'>Issue tracker</span></span><i class='zc-li-outline arrows-1-tail-right zcs-color-tertiary'></i></a>
			</div>
		</article>
	</section>
</div>