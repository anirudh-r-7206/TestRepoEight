<%
accessibleVehicles = Vehicles[ID != 0] sort by Arrival_Date asc;
programIds = List();
for each accessibleVehicle in accessibleVehicles
{
		if(accessibleVehicle.Program != null)
		{
				accessibleProgramId = accessibleVehicle.Program.ID;
				if(!programIds.contains(accessibleProgramId))
				{
						programIds.add(accessibleProgramId);
				}
		}
}
selectedProgramId = ifnull(input.Program_ID,0);
if(selectedProgramId == 0 && programIds.size() > 0)
{
		selectedProgramId = programIds.get(0);
}
selectedVehicles = Vehicles[Program == selectedProgramId] sort by Arrival_Date asc;
selectedVehicleCount = selectedVehicles.count();
selectedContextVehicle = Vehicles[Program == selectedProgramId];
selectedProgramName = "Execution program";
selectedServiceId = "Program";
selectedProgramStatus = "";
if(selectedContextVehicle.count() > 0 && selectedContextVehicle.Program != null)
{
		selectedProgramName = ifnull(selectedContextVehicle.Program.Program_Name,"Execution program");
		selectedServiceId = ifnull(selectedContextVehicle.Program.Service_ID,"Program");
		selectedProgramStatus = ifnull(selectedContextVehicle.Program.Program_Status,"");
}
statusSteps = {"Scheduled","Parts Ordered","Arrived","In Progress","Completed","Picked Up"};
%>
<style>
/* zcs-global utility sheet: page-scoped subset used by this single snippet. */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;font-size:16px;line-height:1.5;--column-gap:0}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-15{gap:.9375rem}.zcs-gap-16{gap:1rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-15{padding:.9375rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}
/* ZCS heading and button adaptation. */
.zcs-page-header{background:var(--zcs-white-color);border-bottom:1px solid var(--zcs-border-color)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color)}.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}
/* ZCS badge with icon. */
.zcs-badge{width:auto;white-space:nowrap}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background:#E4FCF3;border-color:#179E6C;color:#147D58}.zcs-badge-filled-outline.zcs-badge-red{background:#FDE3E6;border-color:#FE455D;color:#C92D43}.zcs-badge-filled-outline.zcs-badge-grey{background:#F3F4F6;border-color:#6B7280;color:#374151}.zcs-badge-filled-outline.zcs-badge-yellow{background:#FCF4E6;border-color:#FAAE13;color:#946309}.zcs-badge-filled-outline.zcs-badge-blue{background:#E8EFFF;border-color:#2A6FFC;color:#245CCB}.zcs-badge-filled-outline.zcs-badge-orange{background:#F8F0EB;border-color:#F4660C;color:#B84B08}
/* ZCS simple table. */
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;min-width:1120px}.zcs-table-wrapper table thead{top:0;z-index:2}.zcs-table-wrapper table thead tr th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:var(--zcs-tr-h-color)}
/* Execution tracker adaptations using ZCS card, table, badge, stepper, and no-data structures. */
.execution-page{min-height:100%;background:var(--zcs-page-bg-color);font-size:14px}.execution-content{padding:15px;max-width:1500px;margin:0 auto}.execution-header-title{min-width:0}.execution-selector{background:var(--zcs-white-color)}.execution-selector-list{overflow-x:auto;padding-bottom:2px}.execution-program-link{border:1px solid var(--zcs-border-color);background:var(--zcs-white-color);color:var(--zcs-primary-text-color);white-space:nowrap;transition:border-color .15s ease,background .15s ease}.execution-program-link:hover,.execution-program-link.is-active{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.execution-context{background:linear-gradient(115deg,var(--zcs_component_hover_color),var(--zcs-white-color));border-color:var(--zcs_brand_color)}.execution-context-meta{min-width:0}.execution-context-stats{flex:0 0 auto}.execution-table-section{background:var(--zcs-white-color)}.execution-vin-link{color:var(--zcs_brand_color)}.execution-vin-link:hover{text-decoration:underline}.execution-shop{max-width:180px;overflow-wrap:anywhere}.execution-date{white-space:nowrap}.execution-progress{min-width:210px}.execution-progress-bars{display:grid;grid-template-columns:repeat(6,minmax(18px,1fr));gap:4px}.execution-progress-segment{height:7px;background:#E5E7EB}.execution-progress-segment.is-complete{background:var(--zcs_brand_color)}.execution-progress-labels{display:grid;grid-template-columns:repeat(6,minmax(18px,1fr));gap:4px}.execution-progress-label{text-align:center;color:var(--zcs-teritiary-text-color);font-size:9px;line-height:1.2}.execution-progress-label.is-current{color:var(--zcs_brand_color);font-weight:600}.execution-photo-summary{list-style:none;cursor:pointer;color:var(--zcs_brand_color)}.execution-photo-summary::-webkit-details-marker{display:none}.execution-gallery{display:grid;grid-template-columns:repeat(3,54px);gap:6px}.execution-gallery a{width:54px;height:54px;display:block;overflow:hidden;border:1px solid var(--zcs-border-color);background:#F9FAFE}.execution-gallery img{width:100%;height:100%;display:block;object-fit:cover}.execution-mobile-list{display:none}.execution-vehicle-card{transition:border-color .15s ease,transform .15s ease}.execution-vehicle-card:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.execution-vehicle-icon{width:42px;height:42px;flex:0 0 auto;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.execution-card-dates{display:grid;grid-template-columns:1fr 1fr;gap:8px;background:#F9FAFE}.execution-card-date{min-width:0}.execution-card-gallery{grid-template-columns:repeat(4,minmax(0,1fr))}.execution-card-gallery a{width:auto;height:78px}.execution-empty{min-height:300px}.execution-nodata-content{max-width:520px}.execution-count-badge{background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}
@media(max-width:992px){.execution-header{align-items:flex-start;flex-direction:column}.execution-header .execution-header-note{width:100%}.execution-context{align-items:flex-start;flex-direction:column}.execution-context-stats{width:100%;justify-content:flex-start}.execution-desktop-table{display:none}.execution-mobile-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}}
@media(max-width:700px){.execution-content{padding:10px}.execution-mobile-list{grid-template-columns:1fr}.execution-selector,.execution-context,.execution-table-section{padding:16px}.execution-card-gallery{grid-template-columns:repeat(3,minmax(0,1fr))}.execution-program-link{padding:8px 10px}.execution-page h1{font-size:20px}}
@media(max-width:480px){.execution-header{padding:14px 15px}.execution-card-dates{grid-template-columns:1fr}.execution-progress-labels{display:none}.execution-card-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.execution-context-stats{flex-direction:column;align-items:flex-start}.execution-vehicle-card{padding:14px}}
</style>
<div class='execution-page zcs-wh-full zcs-flex zcs-direction-column'>
	<header class='execution-header zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-20 zcs-box-border'>
		<div class='execution-header-title zcs-flex zcs-direction-column zcs-gap-4'>
			<span class='zcs-font-12 zcs-font-semibold zcs-color-tertiary'>FLEET EXECUTION</span>
			<h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Execution Tracker</h1>
			<p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Per-program VIN progress, completion evidence, and quality-control status.</p>
		</div>
		<div class='execution-header-note zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-12 zcs-py-4 zcs-box-border'>
			<i class='zcs-badge-icon zc-li-outline ui-1-lock'></i><span class='zcs-font-13'>Visible records only</span>
		</div>
	</header>

	<main class='execution-content zcs-w-full zcs-flex zcs-direction-column zcs-gap-15 zcs-box-border'>
		<% if(programIds.size() == 0) { %>
		<section class='execution-empty zcs-card zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-box-border'>
			<div class='execution-nodata-content zcs-nodata-content zcs-p-20 zcs-box-border'>
				<i class='zc-li-outline transportation-car zcs-font-30 zcs-color-tertiary'></i>
				<h2 class='zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mb-0'>No execution records available</h2>
				<p class='zcs-font-14 zcs-color-tertiary zcs-mt-8 zcs-mb-0'>No vehicle records are currently visible to your account.</p>
			</div>
		</section>
		<% } else { %>
		<section class='execution-selector zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-20 zcs-box-border'>
			<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
				<div><h2 class='zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0'>Select program</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Only programs represented by vehicles you can access are listed.</p></div>
				<span class='execution-count-badge zcs-badge zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=programIds.size()%> programs</span>
			</div>
			<nav class='execution-selector-list zcs-flex zcs-gap-8' aria-label='Accessible execution programs'>
			<%
			for each selectorProgramId in programIds
			{
					selectorVehicle = Vehicles[Program == selectorProgramId];
					selectorServiceId = "Program";
					selectorProgramName = "Execution program";
					if(selectorVehicle.count() > 0 && selectorVehicle.Program != null)
					{
							selectorServiceId = ifnull(selectorVehicle.Program.Service_ID,"Program");
							selectorProgramName = ifnull(selectorVehicle.Program.Program_Name,"Execution program");
					}
					selectorActiveClass = "";
					if(selectorProgramId == selectedProgramId)
					{
							selectorActiveClass = "is-active";
					}
			%>
				<a class='execution-program-link <%=selectorActiveClass%> zcs-button zcs-flex zcs-align-items-center zcs-gap-8 zcs-rounded-md zcs-px-12 zcs-py-8 zcs-box-border zcs-font-13 zcs-font-medium' href='#Page:Execution_Tracker?Program_ID=<%=selectorProgramId%>' aria-current='<%=if(selectorProgramId == selectedProgramId,"page","false")%>' title='<%=selectorProgramName%>'><i class='zc-li-outline files-single-content-03'></i><span><%=selectorServiceId%></span></a>
			<% } %>
			</nav>
		</section>

		<% if(selectedVehicleCount == 0) { %>
		<section class='execution-empty zcs-card zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-box-border'>
			<div class='execution-nodata-content zcs-nodata-content zcs-p-20 zcs-box-border'>
				<i class='zc-li-outline ui-1-lock zcs-font-30 zcs-color-tertiary'></i>
				<h2 class='zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mb-0'>Program not available</h2>
				<p class='zcs-font-14 zcs-color-tertiary zcs-mt-8 zcs-mb-0'>The requested program has no vehicles visible to your account. Choose an accessible program above.</p>
			</div>
		</section>
		<% } else { %>
		<section class='execution-context zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border'>
			<div class='execution-context-meta zcs-flex zcs-direction-column zcs-gap-4'>
				<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><span class='zcs-font-12 zcs-font-semibold zcs-color-tertiary'>PROGRAM CONTEXT</span><% if(selectedProgramStatus != "") { %><span class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><%=selectedProgramStatus%></span><% } %></div>
				<h2 class='zcs-font-22 zcs-font-semibold zcs-color-primary zcs-m-0'><%=selectedProgramName%></h2>
				<p class='zcs-font-14 zcs-color-secondary zcs-m-0'><%=selectedServiceId%></p>
			</div>
			<div class='execution-context-stats zcs-flex zcs-align-items-center zcs-gap-16'>
				<div class='zcs-flex zcs-direction-column'><span class='zcs-font-12 zcs-color-tertiary'>Accessible VINs</span><strong class='zcs-font-20 zcs-color-primary'><%=selectedVehicleCount%></strong></div>
			</div>
		</section>

		<section class='execution-table-section zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border'>
			<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
				<div><h2 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0'>Vehicle execution board</h2><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'>Open a VIN for its permitted detail, updates, and full completion evidence.</p></div>
				<span class='zcs-font-13 zcs-color-tertiary'><%=selectedVehicleCount%> visible</span>
			</div>

			<div class='execution-desktop-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full'>
					<thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>VIN</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Shop</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Arrival / Pickup</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Lifecycle progression</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Photos</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>QC</th><th class='zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary'>Open</th></tr></thead>
					<tbody>
					<%
					for each vehicleRecord in selectedVehicles
					{
							vehicleStatus = ifnull(vehicleRecord.Vehicle_Status,"Scheduled");
							currentStep = statusSteps.indexOf(vehicleStatus);
							if(currentStep < 0) { currentStep = 0; }
							assignedShop = "Not assigned";
							if(vehicleRecord.Assigned_Upfitter != null) { assignedShop = ifnull(vehicleRecord.Assigned_Upfitter.Upfitter_Name,"Not assigned"); }
							qcStatus = ifnull(vehicleRecord.QC_Status,"Pending");
							qcClass = "zcs-badge-yellow";
							qcIcon = "ui-2-time";
							if(qcStatus == "Approved") { qcClass = "zcs-badge-green"; qcIcon = "ui-1-check-circle-08"; }
							else if(qcStatus == "Rejected") { qcClass = "zcs-badge-red"; qcIcon = "ui-1-circle-remove"; }
							statusClass = "zcs-badge-grey";
							if(vehicleStatus == "Parts Ordered") { statusClass = "zcs-badge-orange"; }
							else if(vehicleStatus == "Arrived" || vehicleStatus == "In Progress") { statusClass = "zcs-badge-blue"; }
							else if(vehicleStatus == "Completed" || vehicleStatus == "Picked Up") { statusClass = "zcs-badge-green"; }
							photoCount = 0;
							if(vehicleRecord.Completion_Photos != null && !vehicleRecord.Completion_Photos.isEmpty())
							{
									for each photoItem in vehicleRecord.Completion_Photos { photoCount = photoCount + 1; }
							}
					%>
						<tr>
							<td class='zcs-px-16 zcs-py-12 zcs-box-border'><a class='execution-vin-link zcs-font-14 zcs-font-semibold' href='#Page:Vehicle_Detail?Vehicle_ID=<%=vehicleRecord.ID%>'><%=ifnull(vehicleRecord.VIN,"VIN unavailable")%></a><div class='zcs-mt-4'><span class='zcs-badge zcs-badge-filled-outline <%=statusClass%> zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-11'><%=vehicleStatus%></span></div></td>
							<td class='execution-shop zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-primary'><%=assignedShop%></td>
							<td class='execution-date zcs-px-16 zcs-py-12 zcs-font-13 zcs-color-primary'><div><span class='zcs-color-tertiary'>Arrival</span> <%=ifnull(vehicleRecord.Arrival_Date,"Not set")%></div><div class='zcs-mt-4'><span class='zcs-color-tertiary'>Pickup</span> <%=ifnull(vehicleRecord.Pickup_Date,"Not set")%></div></td>
							<td class='zcs-px-16 zcs-py-12'>
								<div class='execution-progress'>
									<div class='execution-progress-bars'><% for each index stepIndex in statusSteps { %><span class='execution-progress-segment zcs-rounded-md <% if(stepIndex <= currentStep) { %>is-complete<% } %>'></span><% } %></div>
									<div class='execution-progress-labels zcs-mt-4'><% for each index stepIndex in statusSteps { %><span class='execution-progress-label <% if(stepIndex == currentStep) { %>is-current<% } %>' title='<%=statusSteps.get(stepIndex)%>'><%=stepIndex + 1%></span><% } %></div>
								</div>
							</td>
							<td class='zcs-px-16 zcs-py-12'>
								<% if(photoCount == 0) { %><span class='zcs-badge zcs-badge-filled-outline zcs-badge-grey zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><i class='zc-li-outline images-image'></i><span>No photos</span></span><% } else { %>
								<details><summary class='execution-photo-summary zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-font-13 zcs-font-medium'><i class='zc-li-outline images-image'></i><span><%=photoCount%> photos</span></summary><div class='execution-gallery zcs-mt-8'><% for each completionPhoto in vehicleRecord.Completion_Photos { %><a class='zcs-rounded-md' href='<%=completionPhoto%>' target='_blank'><img src='<%=completionPhoto%>' alt='Completion photo for VIN <%=vehicleRecord.VIN%>'></a><% } %></div></details><% } %>
							</td>
							<td class='zcs-px-16 zcs-py-12'><span class='zcs-badge zcs-badge-filled-outline <%=qcClass%> zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12'><i class='zcs-badge-icon zc-li-outline <%=qcIcon%>'></i><span><%=qcStatus%></span></span></td>
							<td class='zcs-px-16 zcs-py-12'><a class='execution-vin-link zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-font-13 zcs-font-medium' href='#Page:Vehicle_Detail?Vehicle_ID=<%=vehicleRecord.ID%>'><span>Vehicle Detail</span><i class='zc-li-outline arrows-1-tail-right'></i></a></td>
						</tr>
					<% } %>
					</tbody>
				</table>
			</div>

			<div class='execution-mobile-list'>
			<%
			for each vehicleRecord in selectedVehicles
			{
					vehicleStatus = ifnull(vehicleRecord.Vehicle_Status,"Scheduled");
					currentStep = statusSteps.indexOf(vehicleStatus);
					if(currentStep < 0) { currentStep = 0; }
					assignedShop = "Not assigned";
					if(vehicleRecord.Assigned_Upfitter != null) { assignedShop = ifnull(vehicleRecord.Assigned_Upfitter.Upfitter_Name,"Not assigned"); }
					qcStatus = ifnull(vehicleRecord.QC_Status,"Pending");
					qcClass = "zcs-badge-yellow";
					qcIcon = "ui-2-time";
					if(qcStatus == "Approved") { qcClass = "zcs-badge-green"; qcIcon = "ui-1-check-circle-08"; }
					else if(qcStatus == "Rejected") { qcClass = "zcs-badge-red"; qcIcon = "ui-1-circle-remove"; }
					statusClass = "zcs-badge-grey";
					if(vehicleStatus == "Parts Ordered") { statusClass = "zcs-badge-orange"; }
					else if(vehicleStatus == "Arrived" || vehicleStatus == "In Progress") { statusClass = "zcs-badge-blue"; }
					else if(vehicleStatus == "Completed" || vehicleStatus == "Picked Up") { statusClass = "zcs-badge-green"; }
					photoCount = 0;
					if(vehicleRecord.Completion_Photos != null && !vehicleRecord.Completion_Photos.isEmpty())
					{
							for each photoItem in vehicleRecord.Completion_Photos { photoCount = photoCount + 1; }
					}
			%>
				<article class='execution-vehicle-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
					<div class='zcs-flex zcs-align-items-start zcs-gap-12'>
						<div class='execution-vehicle-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-md'><i class='zc-li-outline transportation-car zcs-font-20'></i></div>
						<div class='zcs-col-common'>
							<div class='zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-8'><div><a class='execution-vin-link zcs-font-16 zcs-font-semibold' href='#Page:Vehicle_Detail?Vehicle_ID=<%=vehicleRecord.ID%>'><%=ifnull(vehicleRecord.VIN,"VIN unavailable")%></a><p class='zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0'><%=assignedShop%></p></div><a class='zcs-color-theme' href='#Page:Vehicle_Detail?Vehicle_ID=<%=vehicleRecord.ID%>' aria-label='Open vehicle detail'><i class='zc-li-outline arrows-1-tail-right'></i></a></div>
							<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-6 zcs-mt-8'><span class='zcs-badge zcs-badge-filled-outline <%=statusClass%> zcs-inline-flex zcs-align-items-center zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-11'><%=vehicleStatus%></span><span class='zcs-badge zcs-badge-filled-outline <%=qcClass%> zcs-inline-flex zcs-align-items-center zcs-gap-4 zcs-rounded-sm zcs-px-8 zcs-py-2 zcs-font-11'><i class='zc-li-outline <%=qcIcon%>'></i><span>QC <%=qcStatus%></span></span></div>
						</div>
					</div>
					<div class='execution-card-dates zcs-rounded-lg zcs-p-10 zcs-box-border'><div class='execution-card-date zcs-flex zcs-direction-column'><span class='zcs-font-11 zcs-color-tertiary'>Arrival</span><strong class='zcs-font-13 zcs-color-primary'><%=ifnull(vehicleRecord.Arrival_Date,"Not set")%></strong></div><div class='execution-card-date zcs-flex zcs-direction-column'><span class='zcs-font-11 zcs-color-tertiary'>Pickup</span><strong class='zcs-font-13 zcs-color-primary'><%=ifnull(vehicleRecord.Pickup_Date,"Not set")%></strong></div></div>
					<div><div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'><span class='zcs-font-12 zcs-font-medium zcs-color-primary'>Lifecycle</span><span class='zcs-font-12 zcs-color-theme'><%=vehicleStatus%></span></div><div class='execution-progress-bars zcs-mt-8'><% for each index stepIndex in statusSteps { %><span class='execution-progress-segment zcs-rounded-md <% if(stepIndex <= currentStep) { %>is-complete<% } %>' title='<%=statusSteps.get(stepIndex)%>'></span><% } %></div></div>
					<details>
						<summary class='execution-photo-summary zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-13 zcs-font-medium'><span class='zcs-inline-flex zcs-align-items-center zcs-gap-6'><i class='zc-li-outline images-image'></i><span><%=if(photoCount == 0,"No completion photos",photoCount + " completion photos")%></span></span><i class='zc-li-outline arrows-1-small-triangle-down'></i></summary>
						<% if(photoCount == 0) { %><p class='zcs-font-13 zcs-color-tertiary zcs-mt-8 zcs-mb-0'>No completion evidence has been uploaded.</p><% } else { %><div class='execution-gallery execution-card-gallery zcs-mt-8'><% for each completionPhoto in vehicleRecord.Completion_Photos { %><a class='zcs-rounded-md' href='<%=completionPhoto%>' target='_blank'><img src='<%=completionPhoto%>' alt='Completion photo for VIN <%=vehicleRecord.VIN%>'></a><% } %></div><% } %>
					</details>
					<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium' href='#Page:Vehicle_Detail?Vehicle_ID=<%=vehicleRecord.ID%>'><span>Open Vehicle Detail</span><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i></a>
				</article>
			<% } %>
			</div>
		</section>
		<% } %>
		<% } %>
	</main>
</div>