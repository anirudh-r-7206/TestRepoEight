<%
unpaidCount = Client_Invoices[Payment_Status == "Unpaid"].count();
partialCount = Client_Invoices[Payment_Status == "Partial"].count();
paidCount = Client_Invoices[Payment_Status == "Paid"].count();
overdueCount = Client_Invoices[Payment_Status == "Overdue"].count();
%>
<style>
/* ZCS global utilities used by this page. */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color);
	--zcs-light-bg-color: var(--zcs_brand_light_color);
	--zcs-page-bg-color: #f3f3f4;
	--zcs-primary-text-color: var(--zcs_primary_text_color);
	--zcs-secondary-text-color: var(--zcs_secondary_text_color);
	--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
	--zcs-border-color: var(--zcs_tertiary_border_color);
	--zcs-white-color: #ffffff;
	--invoice-spacing: 15px;
	--invoice-radius: 12px;
	--invoice-base-size: 14px;
}
.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0}.zcs-box-border{box-sizing:border-box}.zcs-p-20{padding:20px}.zcs-px-6{padding-left:6px;padding-right:6px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-py-0{padding-top:0;padding-bottom:0}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:10px}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-text-center{text-align:center}.zcs-rounded-sm{border-radius:4px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}

/* ZCS Horizontal Tab With Count. */
.zcs-horizontal-tabpanel{min-height:560px}.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{flex:0 0 auto;list-style:none;border-bottom:2px solid transparent;letter-spacing:.1px}.zcs-horizontal-tablink{cursor:pointer;user-select:none;white-space:nowrap;color:var(--zcs_tertiary_text_color)}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabcount{min-width:24px;background:var(--zcs-page-bg-color)}.zcs-horizontal-tabbody{overflow:visible}

.invoices-workspace,.invoices-workspace *{box-sizing:border-box}.invoices-workspace{width:100%;min-height:100%;padding:var(--invoice-spacing);background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-size:var(--invoice-base-size);line-height:1.5}.invoices-header{min-height:88px;margin-bottom:var(--invoice-spacing);padding:20px 22px;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:var(--invoice-radius);box-shadow:0 1px 2px rgba(18,19,43,.04)}.invoices-header-copy{min-width:0}.invoices-header-title{margin:0;color:var(--zcs-primary-text-color)}.invoices-header-subtitle{margin:4px 0 0;color:var(--zcs-secondary-text-color);font-size:var(--invoice-base-size)}.invoices-tabs-card{position:relative;overflow:hidden;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:var(--invoice-radius);box-shadow:0 1px 2px rgba(18,19,43,.04)}.invoice-tab-control{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.invoice-tab-control:focus-visible~.zcs-horizontal-tabpanel .zcs-horizontal-tabhead{outline:2px solid var(--zcs_brand_color);outline-offset:-2px}.invoice-tabhead{padding:0 12px}.invoice-tabpane{display:none;padding:var(--invoice-spacing)}.invoice-report-shell{position:relative;min-height:500px;overflow:hidden;background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:var(--invoice-radius)}.invoice-report{width:100%;min-height:500px;border:0;background:transparent}.invoice-report-empty{display:none}.invoice-empty-state{min-height:500px;color:var(--zcs-secondary-text-color)}.invoice-empty-content{max-width:440px}.invoice-empty-icon{width:52px;height:52px;margin:0 auto 12px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:23px}.invoice-empty-copy{margin:6px 0 0;color:var(--zcs-secondary-text-color)}.invoice-guidance{padding:10px 15px;color:var(--zcs-secondary-text-color);background:var(--zcs_brand_light_color);border-top:1px solid var(--zcs-border-color);font-size:13px}.invoice-guidance a{color:var(--zcs_brand_color);font-weight:600}

#invoice-tab-unpaid:checked~.zcs-horizontal-tabpanel .tab-unpaid,#invoice-tab-partial:checked~.zcs-horizontal-tabpanel .tab-partial,#invoice-tab-paid:checked~.zcs-horizontal-tabpanel .tab-paid,#invoice-tab-overdue:checked~.zcs-horizontal-tabpanel .tab-overdue{border-bottom-color:var(--zcs_brand_color)}
#invoice-tab-unpaid:checked~.zcs-horizontal-tabpanel .tab-unpaid .zcs-horizontal-tablink,#invoice-tab-partial:checked~.zcs-horizontal-tabpanel .tab-partial .zcs-horizontal-tablink,#invoice-tab-paid:checked~.zcs-horizontal-tabpanel .tab-paid .zcs-horizontal-tablink,#invoice-tab-overdue:checked~.zcs-horizontal-tabpanel .tab-overdue .zcs-horizontal-tablink{color:var(--zcs_brand_color)}
#invoice-tab-unpaid:checked~.zcs-horizontal-tabpanel .pane-unpaid,#invoice-tab-partial:checked~.zcs-horizontal-tabpanel .pane-partial,#invoice-tab-paid:checked~.zcs-horizontal-tabpanel .pane-paid,#invoice-tab-overdue:checked~.zcs-horizontal-tabpanel .pane-overdue{display:block}
.status-unpaid{background:#fff1d6;color:#8b5b00}.status-partial{background:#e8e5ff;color:#4e3ab7}.status-paid{background:#e2f6ee;color:#116f50}.status-overdue{background:#ffe4e8;color:#a2263a}

@media(max-width:768px){.invoices-header{padding:18px}.invoice-tabhead{padding:0 6px}.zcs-horizontal-tablink{padding:11px 9px}.invoice-tabpane{padding:12px}.invoice-report-shell,.invoice-report,.invoice-empty-state{min-height:580px}}
@media(max-width:480px){.invoices-workspace{padding:10px}.invoices-header{margin-bottom:10px}.invoices-header-title{font-size:21px}.invoices-header-subtitle{font-size:13px}.invoice-tabhead{gap:2px}.zcs-horizontal-tablink{gap:5px;padding-left:8px;padding-right:8px}}
</style>

<div class='invoices-workspace'>
	<header class='invoices-header zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-box-border'>
		<div class='invoices-header-copy zcs-ellipsis'>
			<h1 class='invoices-header-title zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-ellipsis'>Invoices</h1>
			<p class='invoices-header-subtitle'>Review client invoices by payment status. Counts reflect records available to you.</p>
		</div>
	</header>

	<section class='invoices-tabs-card'>
		<input class='invoice-tab-control' type='radio' name='invoice-status' id='invoice-tab-unpaid' checked='checked'>
		<input class='invoice-tab-control' type='radio' name='invoice-status' id='invoice-tab-partial'>
		<input class='invoice-tab-control' type='radio' name='invoice-status' id='invoice-tab-paid'>
		<input class='invoice-tab-control' type='radio' name='invoice-status' id='invoice-tab-overdue'>

		<div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full'>
			<ul class='invoice-tabhead zcs-horizontal-tabhead zcs-flex zcs-gap-6 zcs-py-0 zcs-m-0 zcs-box-border' role='tablist' aria-label='Invoice payment status'>
				<li class='tab-unpaid zcs-horizontal-tabitem'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body' for='invoice-tab-unpaid'><span class='zcs-horizontal-tabtext zcs-font-14'>Unpaid</span><span class='zcs-horizontal-tabcount status-unpaid zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12'><%=unpaidCount%></span></label></li>
				<li class='tab-partial zcs-horizontal-tabitem'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body' for='invoice-tab-partial'><span class='zcs-horizontal-tabtext zcs-font-14'>Partial</span><span class='zcs-horizontal-tabcount status-partial zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12'><%=partialCount%></span></label></li>
				<li class='tab-paid zcs-horizontal-tabitem'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body' for='invoice-tab-paid'><span class='zcs-horizontal-tabtext zcs-font-14'>Paid</span><span class='zcs-horizontal-tabcount status-paid zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12'><%=paidCount%></span></label></li>
				<li class='tab-overdue zcs-horizontal-tabitem'><label class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body' for='invoice-tab-overdue'><span class='zcs-horizontal-tabtext zcs-font-14'>Overdue</span><span class='zcs-horizontal-tabcount status-overdue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-font-12'><%=overdueCount%></span></label></li>
			</ul>

			<div class='zcs-horizontal-tabbody zcs-col-common'>
				<div class='invoice-tabpane pane-unpaid'><div class='invoice-report-shell'><% if(unpaidCount == 0) { %><div class='invoice-empty-state zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='invoice-empty-content zcs-p-20 zcs-box-border'><div class='invoice-empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-archive'></i></div><h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No unpaid invoices</h5><p class='invoice-empty-copy'>There are no accessible invoices awaiting payment.</p></div></div><% } %><div class='invoice-report <% if(unpaidCount == 0) { %>invoice-report-empty<% } %>' elName='zc-component' viewLinkName='Unpaid_Invoices' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div></div></div>
				<div class='invoice-tabpane pane-partial'><div class='invoice-report-shell'><% if(partialCount == 0) { %><div class='invoice-empty-state zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='invoice-empty-content zcs-p-20 zcs-box-border'><div class='invoice-empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-archive'></i></div><h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No partial payments</h5><p class='invoice-empty-copy'>There are no accessible invoices with a partial payment.</p></div></div><% } %><div class='invoice-report <% if(partialCount == 0) { %>invoice-report-empty<% } %>' elName='zc-component' viewLinkName='Partial_Invoices' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div></div></div>
				<div class='invoice-tabpane pane-paid'><div class='invoice-report-shell'><% if(paidCount == 0) { %><div class='invoice-empty-state zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='invoice-empty-content zcs-p-20 zcs-box-border'><div class='invoice-empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08'></i></div><h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No paid invoices</h5><p class='invoice-empty-copy'>Paid invoices will appear here after payment is recorded.</p></div></div><% } %><div class='invoice-report <% if(paidCount == 0) { %>invoice-report-empty<% } %>' elName='zc-component' viewLinkName='Paid_Invoices' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div></div></div>
				<div class='invoice-tabpane pane-overdue'><div class='invoice-report-shell'><% if(overdueCount == 0) { %><div class='invoice-empty-state zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'><div class='invoice-empty-content zcs-p-20 zcs-box-border'><div class='invoice-empty-icon zcs-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-2-time'></i></div><h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No overdue invoices</h5><p class='invoice-empty-copy'>There are no accessible invoices currently marked overdue.</p></div></div><% } %><div class='invoice-report <% if(overdueCount == 0) { %>invoice-report-empty<% } %>' elName='zc-component' viewLinkName='Overdue_Invoices' params='zc_Header=false&amp;zc_Search=false&amp;zc_Filter=false&amp;zc_AddRec=false' zc_mobileView='inline'></div></div></div>
			</div>

			<div class='invoice-guidance'>Select an invoice record to open its permitted Invoice Detail workspace.</div>
		</div>
	</section>
</div>