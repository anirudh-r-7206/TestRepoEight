			Work_Orders_On_Add_Success as "Issue Work Order"
			{
			
						    type = form
						    form = Work_Orders
						    record event = on add
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                workOrderRecord = Work_Orders[ID == input.ID];
						                sequenceText = "0000" + workOrderRecord.Work_Order_Sequence.toString();
						                generatedNumber = "WO-" + zoho.currentdate.toString("yyyyMM") + "-" + sequenceText.right(4);
						                workOrderRecord.Work_Order_Number = generatedNumber;
						                thisapp.Generate_Work_Order_Document(input.ID);
						                upfitterRecord = Upfitters[ID == input.Upfitter];
						                programRecord = Programs[ID == input.Program];
						                if(upfitterRecord.count() > 0 && programRecord.count() > 0)
						                {
						                    templateData = Map();
						                    templateData.put("work_order_number", generatedNumber);
						                    templateData.put("service_id", programRecord.Service_ID);
						                    templateData.put("parts_order_by_date", input.Parts_Order_By_Date);
						                    templateData.put("issue_date", input.Issue_Date);
						                    alertKey = "WORK_ORDER_ISSUED-" + input.ID;
						                    thisapp.Send_Template_Email("WORK_ORDER_ISSUED", upfitterRecord.Contact_Email, templateData, alertKey);
						                }
						                thisapp.Create_Audit_Log("Work_Orders", input.ID, input.Program, "Created", "", input.Status, "Work order " + generatedNumber + " issued.");
						            )
						        }
						    }
						
			}

			Work_Orders_On_Add_Validate as "Calculate Work Order Values"
			{
			
						    type = form
						    form = Work_Orders
						    record event = on add
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                purchaseOrderRecord = Purchase_Orders[ID == input.Purchase_Order];
						                if(purchaseOrderRecord.count() == 0 || purchaseOrderRecord.Program != input.Program || purchaseOrderRecord.Status != "Green Light Issued")
						                {
						                    alert(Purchase_Order, "The purchase order must belong to the program and have Green Light status.");
						                    cancel submit;
						                }
						                upfitterRecord = Upfitters[ID == input.Upfitter];
						                if(upfitterRecord.count() > 0)
						                {
						                    input.Upfitter_Portal_User = upfitterRecord.Portal_User;
						                }
						                input.Issue_Date = zoho.currentdate;
						                input.Status = "Issued";
						                earliestArrival = Vehicles[Program == input.Program && Assigned_Upfitter == input.Upfitter && Arrival_Date != null].minimum(Arrival_Date);
						                requestedCapabilityIds = List();
						                for each vehicleRecord in Vehicles[Program == input.Program && Assigned_Upfitter == input.Upfitter]
						                {
						                    for each capabilityId in vehicleRecord.Requested_Upfits
						                    {
						                        if(!requestedCapabilityIds.contains(capabilityId))
						                        {
						                            requestedCapabilityIds.add(capabilityId);
						                        }
						                    }
						                }
						                maximumLeadDays = 0;
						                for each capabilityId in requestedCapabilityIds
						                {
						                    capabilityLeadDays = ifnull(Parts[Status == "Active" && Linked_Capability == capabilityId].maximum(Lead_Time_Days), 0);
						                    if(capabilityLeadDays > maximumLeadDays)
						                    {
						                        maximumLeadDays = capabilityLeadDays;
						                    }
						                }
						                input.Parts_Order_By_Date = zoho.currentdate;
						                if(earliestArrival != null)
						                {
						                    input.Parts_Order_By_Date = earliestArrival.addDay(0 - maximumLeadDays);
						                }
						                if(input.Work_Order_Number == null || input.Work_Order_Number == "")
						                {
						                    input.Work_Order_Number = "PENDING-" + zoho.currenttime.toLong();
						                }
						            )
						        }
						    }
						
			}

			Work_Orders_On_Edit_Success as "Audit Work Order Update"
			{
			
						    type = form
						    form = Work_Orders
						    record event = on edit
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                thisapp.Create_Audit_Log("Work_Orders", input.ID, input.Program, "Updated", "", input.Status, "Work order details updated.");
						            )
						        }
						    }
						
			}

			Work_Orders_On_Edit_Validate as "Audit Work Order Status"
			{
			
						    type = form
						    form = Work_Orders
						    record event = on edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                upfitterRecord = Upfitters[ID == input.Upfitter];
						                if(upfitterRecord.count() > 0)
						                {
						                    input.Upfitter_Portal_User = upfitterRecord.Portal_User;
						                }
						                if(old.Status != input.Status)
						                {
						                    thisapp.Create_Audit_Log("Work_Orders", input.ID, input.Program, "Status Changed", old.Status, input.Status, "Work order status updated without changing vehicle status.");
						                }
						            )
						        }
						    }
						
			}

			Work_Orders_On_Load as "Prepare Work Order Form"
			{
			
						    type = form
						    form = Work_Orders
						    record event = on add or edit
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                hide Hidden_Section;
						                disable Work_Order_Number, Upfitter_Portal_User, Issue_Date, Parts_Order_By_Date, Work_Order_Document;
						            )
						        }
						    }
						
			}
		}

