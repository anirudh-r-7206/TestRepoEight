				        values = {"Scheduled","Parts Ordered","Arrived","In Progress","Completed","Picked Up"}
				        initial value = "Scheduled"
				        row = 3
				        column = 1
				        width = medium
				    )
				    Completion_Photos
				    (
				        type = image
				        displayname = "Completion Photos"
				        source = file,camera
				        compression = true
				        file count = 10
				        camera = primary
				        switch camera = true
				        show gallery = true
				        preview duration = 0
				        row = 3
				        column = 2
				        width = medium
				    )
				    QC
				    (
				        type = section
				        displayname = "Quality Control"
				        visibility = true
				        row = 4
				        column = 1
				    )
				    QC_Status
				    (
				        type = picklist
				        displayname = "QC Status"
				        values = {"Pending","Approved","Rejected"}
				        initial value = "Pending"
				        row = 4
				        column = 1
				        width = medium
				    )
				    QC_Notes
				    (
				        type = textarea
				        displayname = "QC Notes"
				        height = 100px
				        row = 4
				        column = 2
				        width = medium
				    )
				    QC_Date
				    (
				        type = datetime
				        displayname = "QC Date"
				        row = 4
				        column = 1
				        width = medium
				    )
				    Internal_Notes
				    (
				        type = textarea
				        displayname = "Internal Notes"
				        height = 100px
				        row = 4
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Work_Orders
		{
		
				    title
				    {
				        displayname = "Work Orders"
				        on add = "Create Work Order"
				        on edit = "Edit Work Order"
				    }
				    record owner = Upfitter_Portal_User
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Work_Order_Sequence
				    (
				        type = autonumber
				        displayname = "Work Order Sequence"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    unique Work_Order_Number
				    (
				        type = text
				        displayname = "Work Order Number"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Upfitter_Portal_User
				    (
				        type = picklist
				        displayname = "Upfitter Portal User"
				        module = users
				        displayformat = [name]
				        user type = "portal users"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Work_Order_Details
				    (
				        type = section
				        displayname = "Work Order Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Program
				    (
				        type = picklist
				        displayname = "Program"
				        values = Programs.ID
				        displayformat = [Service_ID]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Purchase_Order
				    (
				        type = picklist
				        displayname = "Purchase Order"
				        values = Purchase_Orders.ID
				        displayformat = [FMC_PO_Number]
				        searchable = true
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Upfitter
				    (
				        type = picklist
				        displayname = "Upfitter"
				        values = Upfitters[Status == "Active"].ID
				        displayformat = [Upfitter_Name]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    Issue_Date
				    (
				        type = date
				        displayname = "Issue Date"
				        initial value = "${zoho.currentdate}"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Parts_Order_By_Date
				    (
				        type = date
				        displayname = "Parts Order By Date"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Status
				    (
				        type = picklist
				        displayname = "Status"
				        values = {"Issued","Parts Ordered","In Progress","Completed"}
				        initial value = "Issued"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Work_Order_Document
				    (
				        type = upload file
				        displayname = "Work Order Document"
				        browse = local_drive, google_docs, zoho_docs
				        row = 2
				        column = 1
				        width = medium
				    )
				    Notes
				    (
				        type = textarea
				        displayname = "Notes"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}
	}

	reports
	{
		default list All_Action_Items
		{
		
				    displayName = "All Action Items"
				    show all rows from Action_Items
				    (
				        Action_Item_ID
				        Action_Type
				        Program
				        Vehicle
				        Estimate
				        Assigned_To
				        Due_Date
				        Priority
				        Status
				        Description
				        Created_Date
				        Completed_Date
				    )
				    filters
				    (
				        Action_Type
				        Program
				        Vehicle
				        Estimate
				        Assigned_To
				        Due_Date
				        Priority
				        Status
				        Created_Date
				        Completed_Date
				    )
				    sort by
				    (
				        Due_Date ascending
				    )
				
		}

		list My_Open_Action_Items
		{
		
				    displayName = "My Open Action Items"
				    show all rows from Action_Items [(Status == "Open" || Status == "In Progress") && Assigned_To.Email == zoho.loginuserid]
				    (
				        Action_Item_ID
				        Action_Type
				        Program
				        Vehicle
				        Estimate
				        Assigned_To
				        Due_Date
				        Priority
				        Status
				        Description
				        Created_Date
				    )
				    filters
				    (
				        Action_Type
				        Program
				        Vehicle
				        Estimate
				        Due_Date
				        Priority
				        Status
				        Created_Date
				    )
				    sort by
