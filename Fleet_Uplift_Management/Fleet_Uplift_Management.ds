application "Fleet-Uplift-Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Action_Items
		{
		
				    title
				    {
				        displayname = "Action Items"
				        on add = "Create Action Item"
				        on edit = "Edit Action Item"
				    }
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Action_Item_ID
				    (
				        type = autonumber
				        displayname = "Action Item ID"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    Action_Details
				    (
				        type = section
				        displayname = "Action Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Action_Type
				    (
				        type = picklist
				        displayname = "Action Type"
				        values = {"Estimate Follow-up","Reassignment","QC Review","Operations Alert"}
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Program
				    (
				        type = picklist
				        displayname = "Program"
				        values = Programs.ID
				        displayformat = [Service_ID]
				        searchable = true
				        row = 2
				        column = 2
				        width = medium
				    )
				    Vehicle
				    (
				        type = picklist
				        displayname = "Vehicle"
				        values = Vehicles.ID
				        displayformat = [VIN]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    Estimate
				    (
				        type = picklist
				        displayname = "Estimate"
				        values = Estimates.ID
				        displayformat = [Estimate_ID]
				        searchable = true
				        row = 2
				        column = 2
				        width = medium
				    )
				    Assigned_To
				    (
				        type = picklist
				        displayname = "Assigned To"
				        module = users
				        displayformat = [name]
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Due_Date
				    (
				        type = datetime
				        displayname = "Due Date"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Priority
				    (
				        type = picklist
				        displayname = "Priority"
				        values = {"High","Medium","Low"}
				        initial value = "Medium"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Status
				    (
				        type = picklist
				        displayname = "Status"
				        values = {"Open","In Progress","Completed","Cancelled"}
				        initial value = "Open"
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Description
				    (
				        type = textarea
				        displayname = "Description"
				        height = 100px
				        row = 2
				        column = 1
				        width = medium
				    )
				    Created_Date
				    (
				        type = datetime
				        displayname = "Created Date"
				        initial value = "${zoho.currenttime}"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Completed_Date
				    (
				        type = datetime
				        displayname = "Completed Date"
				        row = 2
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Audit_Log
		{
		
				    title
				    {
				        displayname = "Audit Log"
				        on add = "Audit Log"
				        on edit = "Audit Log"
				    }
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Audit_ID
				    (
				        type = autonumber
				        displayname = "Audit ID"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    Audit_Details
				    (
				        type = section
				        displayname = "Audit Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    Event_Date
				    (
				        type = datetime
				        displayname = "Event Date"
				        initial value = "${zoho.currenttime}"
				        row = 2
				        column = 1
				        width = medium
				    )
				    User_Email
				    (
				        type = email
				        displayname = "User Email"
				        row = 2
				        column = 2
				        width = medium
				    )
				    User_Profile
				    (
				        type = text
				        displayname = "User Profile"
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Module_Name
				    (
				        type = text
				        displayname = "Module Name"
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Record_ID
				    (
				        type = number
				        displayname = "Record ID"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Program
				    (
				        type = picklist
				        displayname = "Program"
				        values = Programs.ID
				        displayformat = [Service_ID]
				        searchable = true
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Action
				    (
				        type = text
				        displayname = "Action"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Before_Value
				    (
				        type = textarea
				        displayname = "Before Value"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    After_Value
				    (
				        type = textarea
				        displayname = "After Value"
				        height = 100px
				        row = 2
				        column = 1
				        width = medium
				    )
				    Details
				    (
				        type = textarea
				        displayname = "Details"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Submit"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Capabilities
		{
		
				    title
				    {
				        displayname = "Capabilities"
				        on add = "Add Capability"
				        on edit = "Edit Capability"
				    }
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Capability_ID
				    (
				        type = autonumber
				        displayname = "Capability ID"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    Details
				    (
				        type = section
				        displayname = "Capability Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have unique Capability_Name
				    (
				        type = text
				        displayname = "Capability Name"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Description
				    (
				        type = textarea
				        displayname = "Description"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    Status
				    (
				        type = picklist
				        displayname = "Status"
				        values = {"Active","Inactive"}
				        initial value = "Active"
				        row = 2
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Client_Invoices
		{
		
				    title
				    {
				        displayname = "Client Invoices"
				        on add = "Create Client Invoice"
				        on edit = "Edit Client Invoice"
				    }
				    record owner = Client_Portal_User
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Invoice_Sequence
				    (
				        type = autonumber
				        displayname = "Invoice Sequence"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    unique Invoice_Number
				    (
				        type = text
				        displayname = "Invoice Number"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Client_Portal_User
				    (
				        type = picklist
				        displayname = "Client Portal User"
				        module = users
				        displayformat = [name]
				        user type = "portal users"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Invoice_Details
				    (
				        type = section
				        displayname = "Invoice Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Program
				    (
				        type = picklist
				        displayname = "Program"
				        values = Programs.ID
				        displayformat = [Service_ID]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    Invoice_Date
				    (
				        type = date
				        displayname = "Invoice Date"
				        initial value = "${zoho.currentdate}"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Payment_Terms
				    (
				        type = picklist
				        displayname = "Payment Terms"
				        values = {"Net 45"}
				        initial value = "Net 45"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Due_Date
				    (
				        type = date
				        displayname = "Due Date"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Invoice_Amount
				    (
				        type = USD
				        displayname = "Invoice Amount"
				        decimalplace = 2
				        maxchar = 16
				        row = 2
				        column = 1
				        width = medium
				    )
				    Payment_Status
				    (
				        type = picklist
				        displayname = "Payment Status"
				        values = {"Unpaid","Partial","Paid","Overdue"}
				        initial value = "Unpaid"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Payment_Date
				    (
				        type = date
				        displayname = "Payment Date"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Notes
				    (
				        type = textarea
				        displayname = "Notes"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Estimate_Labor_Lines
		{
		
				    title
				    {
				        displayname = "Estimate Labor Lines"
				        on add = "Add Estimate Labor Line"
				        on edit = "Edit Estimate Labor Line"
				    }
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Estimate_Labor_Line_ID
				    (
				        type = autonumber
				        displayname = "Estimate Labor Line ID"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    Line_Details
				    (
				        type = section
				        displayname = "Labor Line Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Estimate
				    (
				        type = picklist
				        displayname = "Estimate"
				        values = Estimates.ID
				        bidirectional = Estimate_Labor_Lines
				        displayformat = [Estimate_ID]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Description
				    (
				        type = text
				        displayname = "Description"
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Hours
				    (
				        type = decimal
				        displayname = "Hours"
				        decimalplace = 2
				        maxchar = 10
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Hourly_Rate
				    (
				        type = USD
				        displayname = "Hourly Rate"
				        decimalplace = 2
				        maxchar = 16
				        row = 2
				        column = 2
				        width = medium
				    )
				    Line_Total
				    (
				        type = USD
				        displayname = "Line Total"
				        decimalplace = 2
				        maxchar = 16
				        row = 2
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Estimate_Parts_Lines
		{
		
				    title
				    {
				        displayname = "Estimate Parts Lines"
				        on add = "Add Estimate Part Line"
				        on edit = "Edit Estimate Part Line"
				    }
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Estimate_Part_Line_ID
				    (
				        type = autonumber
				        displayname = "Estimate Part Line ID"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    Line_Details
				    (
				        type = section
				        displayname = "Part Line Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Estimate
				    (
				        type = picklist
				        displayname = "Estimate"
				        values = Estimates.ID
				        bidirectional = Estimate_Parts_Lines
				        displayformat = [Estimate_ID]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Part
				    (
				        type = picklist
				        displayname = "Part"
				        values = Parts[Status == "Active"].ID
				        displayformat = [Part_Name]
				        searchable = true
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Quantity
				    (
				        type = number
				        displayname = "Quantity"
				        row = 2
				        column = 1
				        width = medium
				    )
				    Unit_Price
				    (
				        type = USD
				        displayname = "Unit Price"
				        decimalplace = 2
				        maxchar = 16
				        row = 2
				        column = 2
				        width = medium
				    )
				    Line_Total
				    (
				        type = USD
				        displayname = "Line Total"
				        decimalplace = 2
				        maxchar = 16
				        row = 2
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form Estimates
		{
		
				    title
				    {
				        displayname = "Estimates"
				        on add = "Create Estimate"
				        on edit = "Edit Estimate"
				    }
				    record owner = Upfitter_Portal_User
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Estimate_ID
				    (
				        type = autonumber
				        displayname = "Estimate ID"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    Upfitter_Portal_User
				    (
				        type = picklist
				        displayname = "Upfitter Portal User"
				        module = users
				        displayformat = [name]
				        user type = "portal users"
				        row = 1
				        column = 1
				        width = medium
				    )
				    Reassignment_Flag
				    (
				        type = checkbox
				        displayname = "Reassignment Required"
				        initial value = false
				        row = 1
				        column = 1
				        width = medium
				    )
				    Estimate_Details
				    (
				        type = section
				        displayname = "Estimate Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Program
				    (
				        type = picklist
				        displayname = "Program"
				        values = Programs.ID
				        displayformat = [Service_ID]
				        searchable = true
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Upfitter
				    (
				        type = picklist
				        displayname = "Upfitter"
				        values = Upfitters[Status == "Active"].ID
				        displayformat = [Upfitter_Name]
				        searchable = true
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Vehicles_In_Scope
				    (
				        type = list
				        displayname = "Vehicles in Scope"
				        values = Vehicles.ID
				        displayformat = [VIN]
				        searchable = true
				        height = 120px
				        row = 2
				        column = 1
				        width = medium
				    )
				    Estimate_Parts_Section
				    (
				        type = section
				        displayname = "Parts"
				        visibility = false
				        row = 3
				        column = 1
				    )
				    Estimate_Parts_Lines
				    (
				        type = grid
				        displayname = "Parts Lines"
				        values = Estimate_Parts_Lines.ID
				        bidirectional = Estimate
				        defaultrow = 1
				        maxrow = 100
				        row = 3
				        column = 1
				        width = medium
				    )
				    Estimate_Labor_Section
				    (
				        type = section
				        displayname = "Labor"
				        visibility = false
				        row = 4
				        column = 1
				    )
				    Estimate_Labor_Lines
				    (
				        type = grid
				        displayname = "Labor Lines"
				        values = Estimate_Labor_Lines.ID
				        bidirectional = Estimate
				        defaultrow = 1
				        maxrow = 100
				        row = 4
				        column = 1
				        width = medium
				    )
				    Totals
				    (
				        type = section
				        displayname = "Estimate Totals"
				        visibility = true
				        row = 5
				        column = 1
				    )
				    Parts_Total
				    (
				        type = USD
				        displayname = "Parts Total"
				        initial value = 0.00
				        decimalplace = 2
				        maxchar = 16
				        row = 5
				        column = 1
				        width = medium
				    )
				    Labor_Total
				    (
				        type = USD
				        displayname = "Labor Total"
				        initial value = 0.00
				        decimalplace = 2
				        maxchar = 16
				        row = 5
				        column = 2
				        width = medium
				    )
				    Estimate_Total
				    (
				        type = USD
				        displayname = "Estimate Total"
				        initial value = 0.00
				        decimalplace = 2
				        maxchar = 16
				        row = 5
				        column = 1
				        width = medium
				    )
				    Response
				    (
				        type = section
				        displayname = "Upfitter Response"
				        visibility = true
				        row = 6
				        column = 1
				    )
				    Status
				    (
				        type = picklist
				        displayname = "Status"
				        values = {"Pending Upfitter Review","Approved","Declined","Revision Requested"}
				        initial value = "Pending Upfitter Review"
				        row = 6
				        column = 1
				        width = medium
				    )
				    Upfitter_Response
				    (
				        type = textarea
				        displayname = "Upfitter Response"
				        height = 100px
				        row = 6
				        column = 2
				        width = medium
				    )
				    Response_Date
				    (
				        type = datetime
				        displayname = "Response Date"
				        row = 6
				        column = 1
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

		form FMC_Clients
		{
		
				    title
				    {
				        displayname = "FMC Clients"
				        on add = "Add FMC Client"
				        on edit = "Edit FMC Client"
				    }
				    record owner = Portal_User
				    Hidden_Section
				    (
				        type = section
				        displayname = "System Information"
				        row = 1
				        column = 0
				    )
				    Client_ID
				    (
				        type = autonumber
				        displayname = "Client ID"
				        start index = 1
				        row = 1
				        column = 1
				        width = medium
				    )
				    Client_Details
				    (
				        type = section
				        displayname = "Client Details"
				        visibility = true
				        row = 2
				        column = 1
				    )
				    must have Client_Name
				    (
				        type = text
				        displayname = "Client Name"
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have unique Client_Code
				    (
				        type = text
				        displayname = "Client Code"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Status
				    (
				        type = picklist
				        displayname = "Status"
				        values = {"Active","Inactive"}
				        initial value = "Active"
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have Primary_Contact
				    (
				        type = text
				        displayname = "Primary Contact"
				        row = 2
				        column = 2
				        width = medium
				    )
				    must have Portal_User
				    (
				        type = picklist
				        displayname = "Portal User"
				        module = users
				        displayformat = [name]
				        user type = "portal users"
				        row = 2
				        column = 1
				        width = medium
				    )
				    must have unique Contact_Email
				    (
				        type = email
				        displayname = "Contact Email"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Contact_Phone
				    (
				        type = phonenumber
