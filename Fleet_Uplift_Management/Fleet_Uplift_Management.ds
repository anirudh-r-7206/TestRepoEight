			QC_Status_On_User_Input as "Update QC Notes Visibility"
			{
			
						    type = form
						    form = Vehicles
						    record event = on add or edit
						
						    on user input of QC_Status
						    {
						        actions
						        {
						            custom deluge script
						            (
						                isAdmin = thisapp.permissions.isUserInProfile("Internal_Admin");
						                if(input.QC_Status == "Rejected" || isAdmin)
						                {
						                    show QC_Notes;
						                }
						                else
						                {
						                    hide QC_Notes;
						                }
						            )
						        }
						    }
						
			}

			Vehicles_On_Add_Success as "Initialize Vehicle"
			{
			
						    type = form
						    form = Vehicles
						    record event = on add
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                vehicleTotal = Vehicles[Program == input.Program].count();
						                update Programs[ID == input.Program]
						                [
						                    Vehicle_Count = vehicleTotal
						                ];
						                thisapp.Create_Audit_Log("Vehicles", input.ID, input.Program, "Created", "", input.Vehicle_Status, "Vehicle created for VIN " + input.VIN + ".");
						            )
						        }
						    }
						
			}

			Vehicles_On_Edit_Success as "Process Vehicle Update"
			{
			
						    type = form
						    form = Vehicles
						    record event = on edit
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                vehicleTotal = Vehicles[Program == input.Program].count();
						                update Programs[ID == input.Program]
						                [
						                    Vehicle_Count = vehicleTotal
						                ];
						                thisapp.Create_Audit_Log("Vehicles", input.ID, input.Program, "Updated", "", input.Vehicle_Status, "Vehicle updated for VIN " + input.VIN + ".");
						                if(input.Vehicle_Status == "Completed")
						                {
						                    existingQCAction = Action_Items[Program == input.Program && Vehicle == input.ID && Action_Type == "QC Review" && (Status == "Open" || Status == "In Progress")];
						                    if(existingQCAction.count() == 0)
						                    {
						                        insertedAction = insert into Action_Items
						                        [
						                            Action_Type = "QC Review"
						                            Program = input.Program
						                            Vehicle = input.ID
						                            Assigned_To = zoho.adminuserid
						                            Due_Date = zoho.currenttime.addDay(1)
						                            Priority = "High"
						                            Status = "Open"
						                            Description = "Review completion evidence and perform QC for VIN " + input.VIN + "."
						                            Created_Date = zoho.currenttime
						                        ];
						                    }
						                }
						                if(input.QC_Status == "Rejected")
						                {
						                    existingQCFail = Issues[Program == input.Program && Vehicle == input.ID && Issue_Type == "QC Fail" && (Status == "Open" || Status == "In Progress")];
						                    if(existingQCFail.count() == 0)
						                    {
						                        insertedIssue = insert into Issues
						                        [
						                            Program = input.Program
						                            Vehicle = input.ID
						                            Issue_Type = "QC Fail"
						                            Priority = "High"
						                            Status = "Open"
						                            Description = "QC rejected for VIN " + input.VIN + ". " + input.QC_Notes
						                        ];
						                    }
						                }
						                if(input.QC_Status == "Approved")
						                {
						                    programVehicleCount = Vehicles[Program == input.Program].count();
						                    approvedVehicleCount = Vehicles[Program == input.Program && QC_Status == "Approved"].count();
						                    if(programVehicleCount > 0 && programVehicleCount == approvedVehicleCount)
						                    {
						                        thisapp.Create_Program_Closeout(input.Program);
						                    }
						                }
						            )
						        }
						    }
						
			}

			Vehicles_On_Load as "Prepare Vehicle Form"
			{
			
						    type = form
						    form = Vehicles
						    record event = on add or edit
						
						    on load
						    {
						        actions
						        {
						            custom deluge script
						            (
						                hide Hidden_Section;
						                disable Suggested_Upfitter, Matching_Distance_Miles, QC_Date, Billing_Eligible;
						                isAdmin = thisapp.permissions.isUserInProfile("Internal_Admin");
						                if(input.QC_Status == "Rejected" || isAdmin)
						                {
						                    show QC_Notes;
						                }
						                else
						                {
						                    hide QC_Notes;
						                }
						            )
						        }
						    }
						
			}

			Vehicles_On_Validate as "Validate Vehicle Progress"
			{
			
						    type = form
						    form = Vehicles
						    record event = on add or edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                programRecord = Programs[ID == input.Program];
						                if(programRecord.count() > 0)
						                {
						                    input.Client_Portal_User = programRecord.Client_Portal_User;
						                }
						                if(input.Assigned_Upfitter != null)
						                {
						                    upfitterRecord = Upfitters[ID == input.Assigned_Upfitter];
						                    if(upfitterRecord.count() > 0)
						                    {
						                        input.Upfitter_Portal_User = upfitterRecord.Portal_User;
						                    }
						                    input.Manual_Override = input.Suggested_Upfitter == null || input.Assigned_Upfitter != input.Suggested_Upfitter;
						                }
						                else
						                {
						                    input.Upfitter_Portal_User = null;
						                    input.Manual_Override = false;
						                }
						                if(input.Vehicle_Status == "Completed" && input.Completion_Photos == null)
						                {
						                    alert(Completion_Photos, "At least one completion photo is required before a vehicle can be completed.");
						                    cancel submit;
						                }
						                if(input.Vehicle_Status == "Picked Up" && input.QC_Status != "Approved")
						                {
						                    alert(Vehicle_Status, "QC must be approved before a vehicle can be marked Picked Up.");
						                    cancel submit;
						                }
						                if(input.QC_Status == "Rejected" && ifnull(input.QC_Notes, "") == "")
						                {
						                    alert(QC_Notes, "QC notes are required when QC is rejected.");
						                    cancel submit;
						                }
						                if(input.ID != null && input.QC_Status != null)
						                {
						                    if(input.QC_Status == "Approved")
						                    {
						                        input.QC_Date = zoho.currenttime;
						                        input.Billing_Eligible = true;
						                    }
						                    else if(input.QC_Status == "Rejected")
						                    {
						                        input.QC_Date = zoho.currenttime;
						                        input.Billing_Eligible = false;
						                    }
						                    else
						                    {
						                        input.QC_Date = null;
						                        input.Billing_Eligible = false;
						                    }
						                }
						            )
						        }
						    }
						
			}

