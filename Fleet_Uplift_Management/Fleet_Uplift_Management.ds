				        type = picklist
				        displayname = "Status"
				        values = {"Active","Inactive"}
				        initial value = "Active"
				        row = 2
				        column = 2
				        width = medium
				    )
				    Notes
				    (
				        type = textarea
				        displayname = "Notes"
				        height = 100px
				        row = 2
				        column = 2
				        width = medium
				    )
				    actions
				    {
				        on add
				        {
				            Submit
				            (
				                type = submit
				                displayname = "Save"
				            )
				            Reset
				            (
				                type = reset
				                displayname = "Reset"
				            )
				        }
				        on edit
				        {
				            Update
				            (
				                type = submit
				                displayname = "Update"
				            )
				            Cancel
				            (
				                type = cancel
				                displayname = "Cancel"
				            )
				        }
				    }
				
		}

