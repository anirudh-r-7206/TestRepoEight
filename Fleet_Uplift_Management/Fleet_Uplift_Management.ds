	}

	functions
	{
		Deluge
		{
			float Calculate_Distance_Miles(float lat1, float lon1, float lat2, float lon2)
			{
			
						    distanceMiles = 0.0;
						    if(lat1 != null && lon1 != null && lat2 != null && lon2 != null)
						    {
						        lat1Radians = lat1.radians();
						        lat2Radians = lat2.radians();
						        deltaLat = (lat2 - lat1).radians();
						        deltaLon = (lon2 - lon1).radians();
						        halfLatSin = (deltaLat / 2).sin();
						        halfLonSin = (deltaLon / 2).sin();
						        haversineValue = (halfLatSin * halfLatSin) + (lat1Radians.cos() * lat2Radians.cos() * halfLonSin * halfLonSin);
						        if(haversineValue > 1)
						        {
						            haversineValue = 1;
						        }
						        centralAngle = 2 * haversineValue.sqrt().atan2((1 - haversineValue).sqrt());
						        distanceMiles = 3958.7613 * centralAngle;
						    }
						    return distanceMiles;
						
			}

			void Create_Audit_Log(string moduleName, int recordId, int programId, string actionName, string beforeValue, string afterValue, string detailsText)
			{
			
						    currentProfile = "System";
						    try
						    {
						        currentProfile = thisapp.permissions.loginUserProfile();
						    }
						    catch(profileError)
						    {
						        currentProfile = "System";
						    }
						    if(programId != null && programId > 0)
						    {
						        insert into Audit_Log
						        [
						            Event_Date = zoho.currenttime
						            User_Email = zoho.loginuserid
						            User_Profile = currentProfile
						            Module_Name = ifnull(moduleName, "Unknown")
						            Record_ID = ifnull(recordId, 0)
						            Program = programId
						            Action = ifnull(actionName, "Updated")
						            Before_Value = ifnull(beforeValue, "")
						            After_Value = ifnull(afterValue, "")
						            Details = ifnull(detailsText, "")
						        ];
						    }
						    else
						    {
						        insert into Audit_Log
						        [
						            Event_Date = zoho.currenttime
						            User_Email = zoho.loginuserid
						            User_Profile = currentProfile
						            Module_Name = ifnull(moduleName, "Unknown")
						            Record_ID = ifnull(recordId, 0)
						            Action = ifnull(actionName, "Updated")
						            Before_Value = ifnull(beforeValue, "")
						            After_Value = ifnull(afterValue, "")
						            Details = ifnull(detailsText, "")
						        ];
						    }
						
			}

			void Create_Program_Closeout(int programId)
			{
			
						    programRecord = Programs[ID == programId];
						    if(programRecord.count() > 0)
						    {
						        totalVehicles = Vehicles[Program == programId].count();
						        approvedVehicles = Vehicles[Program == programId && QC_Status == "Approved"].count();
						        if(totalVehicles > 0 && totalVehicles == approvedVehicles)
						        {
						            existingInvoice = Client_Invoices[Program == programId];
						            if(existingInvoice.count() == 0)
						            {
						                approvedQuoteVersion = Quotes[Program == programId && Status == "Approved"].maximum(Version_Number);
						                approvedQuote = Quotes[Program == programId && Status == "Approved" && Version_Number == approvedQuoteVersion];
						                if(approvedQuote.count() > 0)
						                {
						                    pendingInvoice = "PENDING-INV-" + programId;
						                    invoiceId = insert into Client_Invoices
						                    [
						                        Invoice_Number = pendingInvoice
						                        Client_Portal_User = programRecord.Client_Portal_User
						                        Program = programId
						                        Invoice_Date = zoho.currentdate
						                        Payment_Terms = "Net 45"
						                        Due_Date = zoho.currentdate.addDay(45)
						                        Invoice_Amount = approvedQuote.Quote_Total
						                        Payment_Status = "Unpaid"
						                        Notes = "Automatically created during program closeout."
						                    ];
						                    invoiceRecord = Client_Invoices[ID == invoiceId];
						                    sequenceText = "0000" + invoiceRecord.Invoice_Sequence.toString();
						                    invoiceRecord.Invoice_Number = "INV-" + zoho.currentdate.toString("yyyyMM") + "-" + sequenceText.right(4);
						                    thisapp.Create_Audit_Log("Client_Invoices", invoiceId, programId, "Created", "", "Unpaid", "Client invoice created during program closeout.");
						                }
						            }
						            assignedUpfitters = Vehicles[Program == programId && Assigned_Upfitter != null].distinct(Assigned_Upfitter);
						            for each upfitterId in assignedUpfitters
						            {
						                existingPayable = Upfitter_Payables[Program == programId && Upfitter == upfitterId];
						                if(existingPayable.count() == 0)
						                {
						                    upfitterRecord = Upfitters[ID == upfitterId];
						                    assignedCount = Vehicles[Program == programId && Assigned_Upfitter == upfitterId].count();
						                    qcApprovedCount = Vehicles[Program == programId && Assigned_Upfitter == upfitterId && QC_Status == "Approved"].count();
						                    estimateTotal = ifnull(Estimates[Program == programId && Upfitter == upfitterId && Status == "Approved"].sum(Estimate_Total), 0);
						                    perVehicleRate = 0;
						                    if(assignedCount > 0)
						                    {
						                        perVehicleRate = estimateTotal / assignedCount;
						                    }
						                    payableId = insert into Upfitter_Payables
						                    [
						                        Upfitter_Portal_User = upfitterRecord.Portal_User
						                        Program = programId
						                        Upfitter = upfitterId
						                        Completed_Vehicles = qcApprovedCount
						                        Per_Vehicle_Rate = perVehicleRate
						                        Payable_Amount = perVehicleRate * qcApprovedCount
						                        Payment_Terms = upfitterRecord.Payment_Terms
						                        Payment_Status = "Pending Approval"
						                        Notes = "Automatically calculated during program closeout."
						                    ];
						                    thisapp.Create_Audit_Log("Upfitter_Payables", payableId, programId, "Created", "", "Pending Approval", "Upfitter payable created during program closeout.");
						                }
						            }
						            thisapp.Generate_Completion_Report(programId);
						            update Programs[ID == programId]
						            [
						                Program_Status = "Closed"
						            ];
						            thisapp.Generate_Closeout_Document(programId);
						            templateData = Map();
						            templateData.put("service_id", programRecord.Service_ID);
						            templateData.put("program_name", programRecord.Program_Name);
						            templateData.put("vehicle_count", totalVehicles);
						            templateData.put("closeout_date", zoho.currentdate);
						            closeoutKey = "PROGRAM_CLOSEOUT-" + programId;
						            thisapp.Send_Template_Email("PROGRAM_CLOSEOUT", programRecord.Client_Contact, templateData, closeoutKey);
						            thisapp.Create_Audit_Log("Programs", programId, programId, "Closed", "In Execution", "Closed", "Program closeout completed after all vehicles passed QC.");
						        }
						    }
						
			}

			void Generate_Closeout_Document(int programId)
			{
			
						    programRecord = Programs[ID == programId];
						    if(programRecord.count() > 0)
						    {
						        configurationRecord = System_Configuration[ID != 0];
						        companyName = "Fleet Upfit Management";
						        primaryColor = "#6147E5";
						        footerText = "";
						        if(configurationRecord.count() > 0)
						        {
						            companyName = ifnull(configurationRecord.Company_Name, companyName);
						            primaryColor = ifnull(configurationRecord.Primary_Color, primaryColor);
						            footerText = ifnull(configurationRecord.Document_Footer, "");
						        }
						        approvedQuoteVersion = Quotes[Program == programId && Status == "Approved"].maximum(Version_Number);
						        approvedQuote = Quotes[Program == programId && Status == "Approved" && Version_Number == approvedQuoteVersion];
						        invoiceRecord = Client_Invoices[Program == programId];
						        html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937;padding:32px'><div style='border-top:8px solid " + primaryColor + ";padding-top:22px'><h1 style='color:" + primaryColor + "'>" + companyName + "</h1><h2>Program Closeout</h2><p><b>Program:</b> " + programRecord.Service_ID + " - " + programRecord.Program_Name + "</p><p><b>Closed:</b> " + zoho.currentdate + "</p><h3 style='color:" + primaryColor + "'>Summary</h3><p>All " + Vehicles[Program == programId].count() + " vehicles completed final quality control approval.</p><p><b>Approved quote:</b> " + ifnull(approvedQuote.Quote_Number, "") + " &nbsp; <b>Amount:</b> $" + ifnull(approvedQuote.Quote_Total, 0) + "</p><p><b>Client invoice:</b> " + ifnull(invoiceRecord.Invoice_Number, "Pending") + " &nbsp; <b>Terms:</b> Net 45</p><div style='margin-top:36px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#6b7280'>" + footerText + "</div></div></body></html>";
						        pdfFile = zoho.file.convertToPDF(html);
						        programRecord.Closeout_Document = pdfFile;
						    }
						
			}

			void Generate_Completion_Report(int programId)
			{
			
						    programRecord = Programs[ID == programId];
						    if(programRecord.count() > 0)
						    {
						        configurationRecord = System_Configuration[ID != 0];
						        companyName = "Fleet Upfit Management";
						        primaryColor = "#6147E5";
						        footerText = "";
						        if(configurationRecord.count() > 0)
						        {
						            companyName = ifnull(configurationRecord.Company_Name, companyName);
						            primaryColor = ifnull(configurationRecord.Primary_Color, primaryColor);
						            footerText = ifnull(configurationRecord.Document_Footer, "");
						        }
						        vehicleRows = "";
						        for each vehicleRecord in Vehicles[Program == programId]
						        {
						            vehicleRows = vehicleRows + "<tr><td style='padding:7px;border-bottom:1px solid #ddd'>" + vehicleRecord.VIN + "</td><td style='padding:7px;border-bottom:1px solid #ddd'>" + vehicleRecord.Vehicle_Status + "</td><td style='padding:7px;border-bottom:1px solid #ddd'>" + vehicleRecord.QC_Status + "</td><td style='padding:7px;border-bottom:1px solid #ddd'>" + vehicleRecord.QC_Date + "</td></tr>";
						        }
						        html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937;padding:32px'><div style='border-top:8px solid " + primaryColor + ";padding-top:22px'><h1 style='color:" + primaryColor + "'>" + companyName + "</h1><h2>Program Completion Report</h2><p><b>Program:</b> " + programRecord.Service_ID + " - " + programRecord.Program_Name + "</p><p><b>Vehicles:</b> " + Vehicles[Program == programId].count() + " &nbsp; <b>QC Approved:</b> " + Vehicles[Program == programId && QC_Status == "Approved"].count() + "</p><table style='width:100%;border-collapse:collapse'><tr><th style='text-align:left'>VIN</th><th style='text-align:left'>Status</th><th style='text-align:left'>QC</th><th style='text-align:left'>QC Date</th></tr>" + vehicleRows + "</table><div style='margin-top:36px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#6b7280'>" + footerText + "</div></div></body></html>";
						        pdfFile = zoho.file.convertToPDF(html);
						        programRecord.Completion_Report = pdfFile;
						    }
						
			}

			void Generate_PO_Acknowledgement(int poId)
			{
			
						    poRecord = Purchase_Orders[ID == poId];
						    if(poRecord.count() > 0)
						    {
						        programRecord = Programs[ID == poRecord.Program];
						        configurationRecord = System_Configuration[ID != 0];
						        companyName = "Fleet Upfit Management";
						        primaryColor = "#6147E5";
						        footerText = "";
						        if(configurationRecord.count() > 0)
						        {
						            companyName = ifnull(configurationRecord.Company_Name, companyName);
						            primaryColor = ifnull(configurationRecord.Primary_Color, primaryColor);
						            footerText = ifnull(configurationRecord.Document_Footer, "");
						        }
						        html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937;padding:32px'><div style='border-top:8px solid " + primaryColor + ";padding-top:22px'><h1 style='color:" + primaryColor + "'>" + companyName + "</h1><h2>Purchase Order Acknowledgement</h2><p>We acknowledge receipt of the following fleet upfit purchase order.</p><table style='width:100%;border-collapse:collapse'><tr><td style='padding:8px'><b>FMC PO Number</b></td><td>" + poRecord.FMC_PO_Number + "</td></tr><tr><td style='padding:8px'><b>Program</b></td><td>" + ifnull(programRecord.Service_ID, "") + " - " + ifnull(programRecord.Program_Name, "") + "</td></tr><tr><td style='padding:8px'><b>PO Date</b></td><td>" + poRecord.PO_Date + "</td></tr><tr><td style='padding:8px'><b>PO Amount</b></td><td>$" + poRecord.PO_Amount + "</td></tr><tr><td style='padding:8px'><b>Status</b></td><td>" + poRecord.Status + "</td></tr></table><div style='margin-top:28px'>" + ifnull(poRecord.Notes, "") + "</div><div style='margin-top:36px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#6b7280'>" + footerText + "</div></div></body></html>";
						        pdfFile = zoho.file.convertToPDF(html);
						        poRecord.PO_Acknowledgement_Document = pdfFile;
						    }
						
			}

			void Generate_Quote_PDF(int quoteId)
			{
			
						    quoteRecord = Quotes[ID == quoteId];
						    if(quoteRecord.count() > 0)
						    {
						        programRecord = Programs[ID == quoteRecord.Program];
						        configurationRecord = System_Configuration[ID != 0];
						        companyName = "Fleet Upfit Management";
						        primaryColor = "#6147E5";
						        footerText = "";
						        if(configurationRecord.count() > 0)
						        {
						            companyName = ifnull(configurationRecord.Company_Name, companyName);
						            primaryColor = ifnull(configurationRecord.Primary_Color, primaryColor);
						            footerText = ifnull(configurationRecord.Document_Footer, "");
						        }
						        html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937;padding:32px'><div style='border-top:8px solid " + primaryColor + ";padding-top:22px'><h1 style='color:" + primaryColor + ";margin:0'>" + companyName + "</h1><h2>Fleet Upfit Quote</h2><table style='width:100%;border-collapse:collapse'><tr><td><b>Quote</b></td><td>" + ifnull(quoteRecord.Quote_Number, "Draft") + "</td></tr><tr><td><b>Program</b></td><td>" + ifnull(programRecord.Service_ID, "") + " - " + ifnull(programRecord.Program_Name, "") + "</td></tr><tr><td><b>Quote Date</b></td><td>" + quoteRecord.Quote_Date + "</td></tr><tr><td><b>Valid Until</b></td><td>" + quoteRecord.Valid_Until + "</td></tr></table><h3 style='color:" + primaryColor + "'>Pricing</h3><table style='width:100%;border-collapse:collapse'><tr><td style='padding:8px;border-bottom:1px solid #ddd'>Approved estimate subtotal</td><td style='text-align:right'>$" + quoteRecord.Estimate_Subtotal + "</td></tr><tr><td style='padding:8px;border-bottom:1px solid #ddd'>Markup (" + quoteRecord.Markup_Percent + "%)</td><td style='text-align:right'>$" + quoteRecord.Markup_Amount + "</td></tr><tr><td style='padding:12px;font-size:18px'><b>Total</b></td><td style='text-align:right;font-size:18px'><b>$" + quoteRecord.Quote_Total + "</b></td></tr></table><div style='margin-top:28px'>" + ifnull(quoteRecord.FMC_Notes, "") + "</div><div style='margin-top:36px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#6b7280'>" + footerText + "</div></div></body></html>";
						        pdfFile = zoho.file.convertToPDF(html);
						        quoteRecord.Quote_PDF = pdfFile;
						    }
						
			}

			void Generate_Work_Order_Document(int workOrderId)
			{
			
						    workOrderRecord = Work_Orders[ID == workOrderId];
						    if(workOrderRecord.count() > 0)
						    {
						        programRecord = Programs[ID == workOrderRecord.Program];
						        upfitterRecord = Upfitters[ID == workOrderRecord.Upfitter];
						        configurationRecord = System_Configuration[ID != 0];
						        companyName = "Fleet Upfit Management";
						        primaryColor = "#6147E5";
						        footerText = "";
						        if(configurationRecord.count() > 0)
						        {
						            companyName = ifnull(configurationRecord.Company_Name, companyName);
						            primaryColor = ifnull(configurationRecord.Primary_Color, primaryColor);
						            footerText = ifnull(configurationRecord.Document_Footer, "");
						        }
						        vehicleRows = "";
						        for each vehicleRecord in Vehicles[Program == workOrderRecord.Program && Assigned_Upfitter == workOrderRecord.Upfitter]
						        {
						            vehicleRows = vehicleRows + "<tr><td style='padding:7px;border-bottom:1px solid #ddd'>" + vehicleRecord.VIN + "</td><td style='padding:7px;border-bottom:1px solid #ddd'>" + ifnull(vehicleRecord.Year, "") + " " + ifnull(vehicleRecord.Make, "") + " " + ifnull(vehicleRecord.Model, "") + "</td><td style='padding:7px;border-bottom:1px solid #ddd'>" + vehicleRecord.Arrival_Date + "</td></tr>";
						        }
						        html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937;padding:32px'><div style='border-top:8px solid " + primaryColor + ";padding-top:22px'><h1 style='color:" + primaryColor + "'>" + companyName + "</h1><h2>Work Order " + workOrderRecord.Work_Order_Number + "</h2><p><b>Program:</b> " + ifnull(programRecord.Service_ID, "") + " - " + ifnull(programRecord.Program_Name, "") + "</p><p><b>Upfitter:</b> " + ifnull(upfitterRecord.Upfitter_Name, "") + "</p><p><b>Issued:</b> " + workOrderRecord.Issue_Date + " &nbsp; <b>Parts order by:</b> " + workOrderRecord.Parts_Order_By_Date + "</p><h3 style='color:" + primaryColor + "'>Assigned Vehicles</h3><table style='width:100%;border-collapse:collapse'><tr><th style='text-align:left'>VIN</th><th style='text-align:left'>Vehicle</th><th style='text-align:left'>Arrival</th></tr>" + vehicleRows + "</table><div style='margin-top:24px'>" + ifnull(workOrderRecord.Notes, "") + "</div><div style='margin-top:36px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#6b7280'>" + footerText + "</div></div></body></html>";
						        pdfFile = zoho.file.convertToPDF(html);
						        workOrderRecord.Work_Order_Document = pdfFile;
						    }
						
			}

			void Send_Template_Email(string templateCode, string recipient, map dataMap, string dedupeKey)
			{
			
						    alertKey = ifnull(dedupeKey, "").trim();
						    if(alertKey == "")
						    {
						        alertKey = ifnull(templateCode, "UNKNOWN") + "-" + zoho.currenttime.toLong();
						    }
						    existingLog = Notification_Log[Alert_Key == alertKey];
						    if(existingLog.count() == 0)
						    {
						        if(recipient == null || recipient.trim() == "")
						        {
						            insert into Notification_Log
						            [
						                Alert_Key = alertKey
						                Template_Code = templateCode
						                Reference_Type = templateCode
						                Reference_ID = 0
						                Recipient_Email = recipient
						                Sent_Date = zoho.currenttime
						                Delivery_Status = "Failed"
						                Error_Message = "Recipient email is required."
						            ];
						        }
						        else
						        {
						            templateRecord = Notification_Templates[Template_Code == templateCode && Status == "Active"];
						            if(templateRecord.count() == 0)
						            {
						                insert into Notification_Log
						                [
						                    Alert_Key = alertKey
						                    Template_Code = templateCode
						                    Reference_Type = templateCode
						                    Reference_ID = 0
						                    Recipient_Email = recipient
						                    Sent_Date = zoho.currenttime
						                    Delivery_Status = "Failed"
						                    Error_Message = "No active notification template exists for " + templateCode + "."
						                ];
						            }
						            else
						            {
						                try
						                {
						                    subjectText = templateRecord.Subject;
						                    bodyText = templateRecord.HTML_Body;
						                    if(dataMap != null)
						                    {
						                        for each dataKey in dataMap.keys()
						                        {
						                            token = "{{" + dataKey + "}}";
						                            replacementValue = ifnull(dataMap.get(dataKey), "").toString();
						                            subjectText = subjectText.replaceAll(token, replacementValue, true);
						                            bodyText = bodyText.replaceAll(token, replacementValue, true);
						                        }
						                    }
						                    configurationRecord = System_Configuration[ID != 0];
						                    if(configurationRecord.count() > 0)
						                    {
						                        primaryColor = ifnull(configurationRecord.Primary_Color, "#6147E5");
						                        companyName = ifnull(configurationRecord.Company_Name, "Fleet Upfit Management");
						                        footerText = ifnull(configurationRecord.Document_Footer, "");
						                        bodyText = "<div style='font-family:Arial,sans-serif;color:#202124'><div style='border-top:6px solid " + primaryColor + ";padding:20px'><h2 style='color:" + primaryColor + "'>" + companyName + "</h2>" + bodyText + "<div style='margin-top:24px;padding-top:12px;border-top:1px solid #e5e7eb;font-size:12px;color:#6b7280'>" + footerText + "</div></div></div>";
						                    }
						                    sendmail
						                    [
						                        from : zoho.adminuserid
						                        to : recipient
						                        subject : subjectText
						                        message : bodyText
						                    ];
						                    insert into Notification_Log
						                    [
						                        Alert_Key = alertKey
						                        Template_Code = templateCode
						                        Reference_Type = templateCode
						                        Reference_ID = 0
						                        Recipient_Email = recipient
						                        Sent_Date = zoho.currenttime
						                        Delivery_Status = "Sent"
						                        Error_Message = ""
						                    ];
						                }
						                catch(sendError)
						                {
						                    insert into Notification_Log
						                    [
						                        Alert_Key = alertKey
						                        Template_Code = templateCode
						                        Reference_Type = templateCode
						                        Reference_ID = 0
						                        Recipient_Email = recipient
						                        Sent_Date = zoho.currenttime
						                        Delivery_Status = "Failed"
						                        Error_Message = sendError.message
						                    ];
						                }
						            }
						        }
						    }
						
			}
		}
	}

