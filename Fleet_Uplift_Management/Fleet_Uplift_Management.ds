	"Internal_Admin"
	{
	
		    name = "Internal_Admin"
		    type = Users_Permissions
		    permissions = { Chat:true, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:false }
		    description = "Full application administration with immutable system ledgers."
		    ModulePermissions
		    {
		        Capabilities
		        {
