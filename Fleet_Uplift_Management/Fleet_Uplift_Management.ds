			Markup_Percent_On_User_Input as "Recalculate Quote Markup"
			{
			
						    type = form
						    form = Quotes
						    record event = on add or edit
						
						    on user input of Markup_Percent
						    {
						        actions
						        {
						            custom deluge script
						            (
						                input.Markup_Amount = ifnull(input.Estimate_Subtotal, 0.00) * ifnull(input.Markup_Percent, 0.00) / 100;
						                input.Quote_Total = ifnull(input.Estimate_Subtotal, 0.00) + input.Markup_Amount;
						            )
						        }
						    }
						
			}

			Quotes_Program_On_User_Input as "Calculate Quote from Program"
			{
			
						    type = form
						    form = Quotes
						    record event = on add or edit
						
						    on user input of Program
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Program != null)
						                {
						                    programRecord = Programs[ID == input.Program];
						                    if(programRecord.count() > 0)
						                    {
						                        input.Client_Portal_User = programRecord.Client_Portal_User;
						                        input.Markup_Percent = ifnull(programRecord.Markup_Percent, 0.00);
						                        input.Estimate_Subtotal = ifnull(Estimates[Program == input.Program && Status == "Approved"].sum(Estimate_Total), 0.00);
						                        input.Markup_Amount = input.Estimate_Subtotal * input.Markup_Percent / 100;
						                        input.Quote_Total = input.Estimate_Subtotal + input.Markup_Amount;
						                    }
						                }
						            )
						        }
						    }
						
			}

			Quotes_On_Add_Success as "Generate New Quote"
			{
			
						    type = form
						    form = Quotes
						    record event = on add
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                quoteRecord = Quotes[ID == input.ID];
						                sequenceText = "0000" + quoteRecord.Quote_Sequence.toString();
						                generatedQuoteNumber = "QT-" + zoho.currentdate.toString("yyyyMM") + "-" + sequenceText.right(4);
						                quoteRecord.Quote_Number = generatedQuoteNumber;
						                thisapp.Generate_Quote_PDF(input.ID);
						                thisapp.Create_Audit_Log("Quotes", input.ID, input.Program, "Created", "", input.Status, "Quote " + generatedQuoteNumber + " created.");
						            )
						        }
						    }
						
			}

			Quotes_On_Add_Validate as "Prepare New Quote"
			{
			
						    type = form
						    form = Quotes
						    record event = on add
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                programRecord = Programs[ID == input.Program];
						                if(programRecord.count() > 0)
						                {
						                    input.Client_Portal_User = programRecord.Client_Portal_User;
						                    input.Markup_Percent = ifnull(programRecord.Markup_Percent, 0.00);
						                }
						                input.Estimate_Subtotal = ifnull(Estimates[Program == input.Program && Status == "Approved"].sum(Estimate_Total), 0.00);
						                input.Markup_Amount = input.Estimate_Subtotal * ifnull(input.Markup_Percent, 0.00) / 100;
						                input.Quote_Total = input.Estimate_Subtotal + input.Markup_Amount;
						                input.Quote_Date = zoho.currentdate;
						                validityDays = 30;
						                configRecord = System_Configuration[ID != 0];
						                if(configRecord.count() > 0)
						                {
						                    validityDays = configRecord.Quote_Validity_Days;
						                }
						                input.Valid_Until = zoho.currentdate.addDay(validityDays);
						                input.Quote_Number = "PENDING-" + zoho.currenttime.toString("yyyyMMddHHmmss") + "-" + zoho.loginuserid;
						                input.Status = "Draft";
						                input.FMC_Approval_Date = null;
						                input.Version_Number = 1;
						            )
						        }
						    }
						
			}

			Quotes_On_Edit_Success as "Process Quote Status"
			{
			
						    type = form
						    form = Quotes
						    record event = on edit
						
						    on success
						    {
						        actions
						        {
						            custom deluge script
						            (
						                if(input.Status == "Sent to Client")
						                {
						                    thisapp.Generate_Quote_PDF(input.ID);
						                    programRecord = Programs[ID == input.Program];
						                    if(programRecord.count() > 0)
						                    {
						                        templateData = Map();
						                        templateData.put("service_id", programRecord.Service_ID);
						                        templateData.put("quote_number", input.Quote_Number);
						                        templateData.put("quote_total", input.Quote_Total);
						                        templateData.put("valid_until", input.Valid_Until);
						                        quoteSentKey = "QUOTE_SENT-" + input.ID + "-V" + input.Version_Number;
						                        thisapp.Send_Template_Email("QUOTE_SENT", programRecord.Client_Contact, templateData, quoteSentKey);
						                    }
						                }
						                else if(input.Status == "Approved")
						                {
						                    update Programs[ID == input.Program]
						                    [
						                        Program_Status = "Pending Quote Approval"
						                    ];
						                }
						                else if(input.Status == "Revised")
						                {
						                    thisapp.Generate_Quote_PDF(input.ID);
						                }
						                thisapp.Create_Audit_Log("Quotes", input.ID, input.Program, "Updated", "", input.Status, "Quote details updated.");
						            )
						        }
						    }
						
			}

			Quotes_On_Edit_Validate as "Validate Quote Response"
			{
			
						    type = form
						    form = Quotes
						    record event = on edit
						
						    on validate
						    {
						        actions
						        {
						            custom deluge script
						            (
						                programRecord = Programs[ID == input.Program];
						                if(programRecord.count() > 0)
						                {
						                    input.Client_Portal_User = programRecord.Client_Portal_User;
						                }
						                input.Markup_Amount = ifnull(input.Estimate_Subtotal, 0.00) * ifnull(input.Markup_Percent, 0.00) / 100;
						                input.Quote_Total = ifnull(input.Estimate_Subtotal, 0.00) + input.Markup_Amount;
						                if((input.Status == "Declined" || input.Status == "Revised") && ifnull(input.FMC_Notes, "") == "")
						                {
						                    alert(FMC_Notes, "FMC notes are required when declining or revising a quote.");
						                    cancel submit;
						                }
						                if(old.Status != input.Status)
						                {
						                    if(input.Status == "Approved")
						                    {
						                        input.FMC_Approval_Date = zoho.currentdate;
						                    }
						                    else if(input.Status == "Revised")
						                    {
						                        input.FMC_Approval_Date = null;
						                        input.Version_Number = ifnull(old.Version_Number, 1) + 1;
						                    }
						                    else if(input.Status == "Declined")
						                    {
						                        input.FMC_Approval_Date = null;
						                    }
						                    thisapp.Create_Audit_Log("Quotes", input.ID, input.Program, "Status Changed", old.Status, input.Status, "Quote status updated. " + ifnull(input.FMC_Notes, ""));
						                }
						            )
						        }
						    }
						
			}

