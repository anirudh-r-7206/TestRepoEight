void Generate_Quote_PDF(int quoteId)
{

			    quoteRecord = Quotes[ID == quoteId];
			    if(quoteRecord.count() > 0)
			    {
			        programRecord = Programs[ID == quoteRecord.Program];
			        configurationRecord = System_Configuration[ID != 0];
			        companyName = "Fleet Upfit Management";
			        primaryColor = "#6147E5";
			        footerText = "";
			        if(configurationRecord.count() > 0)
			        {
			            companyName = ifnull(configurationRecord.Company_Name, companyName);
			            primaryColor = ifnull(configurationRecord.Primary_Color, primaryColor);
			            footerText = ifnull(configurationRecord.Document_Footer, "");
			        }
			        html = "<html><body style='font-family:Arial,sans-serif;color:#1f2937;padding:32px'><div style='border-top:8px solid " + primaryColor + ";padding-top:22px'><h1 style='color:" + primaryColor + ";margin:0'>" + companyName + "</h1><h2>Fleet Upfit Quote</h2><table style='width:100%;border-collapse:collapse'><tr><td><b>Quote</b></td><td>" + ifnull(quoteRecord.Quote_Number, "Draft") + "</td></tr><tr><td><b>Program</b></td><td>" + ifnull(programRecord.Service_ID, "") + " - " + ifnull(programRecord.Program_Name, "") + "</td></tr><tr><td><b>Quote Date</b></td><td>" + quoteRecord.Quote_Date + "</td></tr><tr><td><b>Valid Until</b></td><td>" + quoteRecord.Valid_Until + "</td></tr></table><h3 style='color:" + primaryColor + "'>Pricing</h3><table style='width:100%;border-collapse:collapse'><tr><td style='padding:8px;border-bottom:1px solid #ddd'>Approved estimate subtotal</td><td style='text-align:right'>$" + quoteRecord.Estimate_Subtotal + "</td></tr><tr><td style='padding:8px;border-bottom:1px solid #ddd'>Markup (" + quoteRecord.Markup_Percent + "%)</td><td style='text-align:right'>$" + quoteRecord.Markup_Amount + "</td></tr><tr><td style='padding:12px;font-size:18px'><b>Total</b></td><td style='text-align:right;font-size:18px'><b>$" + quoteRecord.Quote_Total + "</b></td></tr></table><div style='margin-top:28px'>" + ifnull(quoteRecord.FMC_Notes, "") + "</div><div style='margin-top:36px;padding-top:12px;border-top:1px solid #ddd;font-size:11px;color:#6b7280'>" + footerText + "</div></div></body></html>";
			        pdfFile = zoho.file.convertToPDF(html);
			        quoteRecord.Quote_PDF = pdfFile;
			    }
			
}