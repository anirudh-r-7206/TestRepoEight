form Estimate_Parts_Lines
{

		    title
		    {
		        displayname = "Estimate Parts Lines"
		        on add = "Add Estimate Part Line"
		        on edit = "Edit Estimate Part Line"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Estimate_Part_Line_ID
		    (
		        type = autonumber
		        displayname = "Estimate Part Line ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Line_Details
		    (
		        type = section
		        displayname = "Part Line Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Estimate
		    (
		        type = picklist
		        displayname = "Estimate"
		        values = Estimates.ID
		        bidirectional = Estimate_Parts_Lines
		        displayformat = [Estimate_ID]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Part
		    (
		        type = picklist
		        displayname = "Part"
		        values = Parts[Status == "Active"].ID
		        displayformat = [Part_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Quantity
		    (
		        type = number
		        displayname = "Quantity"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Unit_Price
		    (
		        type = USD
		        displayname = "Unit Price"
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Line_Total
		    (
		        type = USD
		        displayname = "Line Total"
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}