form Notification_Templates
{

		    title
		    {
		        displayname = "Notification Templates"
		        on add = "Add Notification Template"
		        on edit = "Edit Notification Template"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Template_ID
		    (
		        type = autonumber
		        displayname = "Template ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Template
		    (
		        type = section
		        displayname = "Template Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have unique Template_Code
		    (
		        type = text
		        displayname = "Template Code"
		        description [ type = tooltip  message = "Use the approved notification code for this template, such as ESTIMATE_REVIEW, WORK_ORDER_ISSUED, QUOTE_SENT, PO_ACKNOWLEDGED, PROGRAM_CLOSEOUT, ISSUE_ASSIGNED, ISSUE_ALERT, or ACTION_ITEM_REMINDER." ]
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Template_Name
		    (
		        type = text
		        displayname = "Template Name"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Audience
		    (
		        type = picklist
		        displayname = "Audience"
		        values = {"FMC Client","Upfitter","Internal"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Subject
		    (
		        type = text
		        displayname = "Subject"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have HTML_Body
		    (
		        type = richtext
		        displayname = "HTML Body"
		        height = 300px
		        toolbar = enable
		        [
		            style, font-color, background-color, alignment, bullets-and-numbering, indent, remove-formatting, link, table, ruler, html,
		            font-size : {2,3,4,5},
		            font-family : {"Arimo","Lato","Poppins"}
		        ]
		        row = 2
		        column = 1
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}