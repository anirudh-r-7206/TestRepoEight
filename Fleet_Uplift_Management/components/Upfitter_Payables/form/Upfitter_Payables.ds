form Upfitter_Payables
{

		    title
		    {
		        displayname = "Upfitter Payables"
		        on add = "Create Upfitter Payable"
		        on edit = "Edit Upfitter Payable"
		    }
		    record owner = Upfitter_Portal_User
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Payable_ID
		    (
		        type = autonumber
		        displayname = "Payable ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Upfitter_Portal_User
		    (
		        type = picklist
		        displayname = "Upfitter Portal User"
		        module = users
		        displayformat = [name]
		        user type = "portal users"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Payable_Details
		    (
		        type = section
		        displayname = "Payable Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Program
		    (
		        type = picklist
		        displayname = "Program"
		        values = Programs.ID
		        displayformat = [Service_ID]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Upfitter
		    (
		        type = picklist
		        displayname = "Upfitter"
		        values = Upfitters[Status == "Active"].ID
		        displayformat = [Upfitter_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Completed_Vehicles
		    (
		        type = number
		        displayname = "QC Approved Vehicles"
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Per_Vehicle_Rate
		    (
		        type = USD
		        displayname = "Per Vehicle Rate"
		        decimalplace = 2
		        maxchar = 16
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Payable_Amount
		    (
		        type = USD
		        displayname = "Payable Amount"
		        decimalplace = 2
		        maxchar = 16
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Payment_Terms
		    (
		        type = text
		        displayname = "Payment Terms"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Payment_Status
		    (
		        type = picklist
		        displayname = "Payment Status"
		        values = {"Pending Approval","Approved","Paid"}
		        initial value = "Pending Approval"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Payment_Date
		    (
		        type = date
		        displayname = "Payment Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Payment_Reference
		    (
		        type = text
		        displayname = "Payment Reference"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}