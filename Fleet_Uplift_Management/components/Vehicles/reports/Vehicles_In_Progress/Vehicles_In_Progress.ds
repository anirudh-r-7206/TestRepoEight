list Vehicles_In_Progress
{

		    displayName = "Vehicles - In Progress"
		    show all rows from Vehicles [Vehicle_Status == "In Progress"]
		    (
		        Program
		        VIN
		        Year
		        Make
		        Model
		        Arrival_Date
		        Assigned_Upfitter
		        Vehicle_Status
		        QC_Status
		    )
		    filters
		    (
		        Program
		        Assigned_Upfitter
		        Arrival_Date
		        QC_Status
		    )
		    sort by
		    (
		        Arrival_Date ascending
		    )
		
}