default list All_Purchase_Orders
{

		    displayName = "All Purchase Orders"
		    show all rows from Purchase_Orders
		    (
		        PO_Record_ID
		        Program
		        Quote
		        FMC_PO_Number
		        PO_Date
		        PO_Amount
		        Status
		        Green_Light_Date
		        PO_Acknowledgement_Document
		    )
		    filters
		    (
		        Program
		        Quote
		        Status
		        PO_Date
		        Green_Light_Date
		    )
		    sort by
		    (
		        PO_Date descending
		    )
		
}