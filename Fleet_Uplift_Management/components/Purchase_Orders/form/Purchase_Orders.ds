form Purchase_Orders
{

		    title
		    {
		        displayname = "Purchase Orders"
		        on add = "Create Purchase Order"
		        on edit = "Edit Purchase Order"
		    }
		    record owner = Client_Portal_User
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    PO_Record_ID
		    (
		        type = autonumber
		        displayname = "PO Record ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Client_Portal_User
		    (
		        type = picklist
		        displayname = "Client Portal User"
		        module = users
		        displayformat = [name]
		        user type = "portal users"
		        row = 1
		        column = 1
		        width = medium
		    )
		    PO_Details
		    (
		        type = section
		        displayname = "Purchase Order Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Program
		    (
		        type = picklist
		        displayname = "Program"
		        values = Programs.ID
		        displayformat = [Service_ID]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Quote
		    (
		        type = picklist
		        displayname = "Approved Quote"
		        values = Quotes[Status == "Approved"].ID
		        displayformat = [Quote_Number]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have unique FMC_PO_Number
		    (
		        type = text
		        displayname = "FMC PO Number"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have PO_Date
		    (
		        type = date
		        displayname = "PO Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have PO_Amount
		    (
		        type = USD
		        displayname = "PO Amount"
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Received","Acknowledged","Green Light Issued"}
		        initial value = "Received"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Green_Light_Date
		    (
		        type = datetime
		        displayname = "Green Light Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    PO_Acknowledgement_Document
		    (
		        type = upload file
		        displayname = "PO Acknowledgement Document"
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}