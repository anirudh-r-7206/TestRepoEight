form Client_Invoices
{

		    title
		    {
		        displayname = "Client Invoices"
		        on add = "Create Client Invoice"
		        on edit = "Edit Client Invoice"
		    }
		    record owner = Client_Portal_User
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Invoice_Sequence
		    (
		        type = autonumber
		        displayname = "Invoice Sequence"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    unique Invoice_Number
		    (
		        type = text
		        displayname = "Invoice Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Client_Portal_User
		    (
		        type = picklist
		        displayname = "Client Portal User"
		        module = users
		        displayformat = [name]
		        user type = "portal users"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Invoice_Details
		    (
		        type = section
		        displayname = "Invoice Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Program
		    (
		        type = picklist
		        displayname = "Program"
		        values = Programs.ID
		        displayformat = [Service_ID]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Invoice_Date
		    (
		        type = date
		        displayname = "Invoice Date"
		        initial value = "${zoho.currentdate}"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Payment_Terms
		    (
		        type = picklist
		        displayname = "Payment Terms"
		        values = {"Net 45"}
		        initial value = "Net 45"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Invoice_Amount
		    (
		        type = USD
		        displayname = "Invoice Amount"
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Payment_Status
		    (
		        type = picklist
		        displayname = "Payment Status"
		        values = {"Unpaid","Partial","Paid","Overdue"}
		        initial value = "Unpaid"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Payment_Date
		    (
		        type = date
		        displayname = "Payment Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}