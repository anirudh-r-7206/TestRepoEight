form Action_Items
{

		    title
		    {
		        displayname = "Action Items"
		        on add = "Create Action Item"
		        on edit = "Edit Action Item"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Action_Item_ID
		    (
		        type = autonumber
		        displayname = "Action Item ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Action_Details
		    (
		        type = section
		        displayname = "Action Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Action_Type
		    (
		        type = picklist
		        displayname = "Action Type"
		        values = {"Estimate Follow-up","Reassignment","QC Review","Operations Alert"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Program
		    (
		        type = picklist
		        displayname = "Program"
		        values = Programs.ID
		        displayformat = [Service_ID]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Vehicle
		    (
		        type = picklist
		        displayname = "Vehicle"
		        values = Vehicles.ID
		        displayformat = [VIN]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Estimate
		    (
		        type = picklist
		        displayname = "Estimate"
		        values = Estimates.ID
		        displayformat = [Estimate_ID]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Assigned_To
		    (
		        type = picklist
		        displayname = "Assigned To"
		        module = users
		        displayformat = [name]
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Due_Date
		    (
		        type = datetime
		        displayname = "Due Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Priority
		    (
		        type = picklist
		        displayname = "Priority"
		        values = {"High","Medium","Low"}
		        initial value = "Medium"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Open","In Progress","Completed","Cancelled"}
		        initial value = "Open"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Created_Date
		    (
		        type = datetime
		        displayname = "Created Date"
		        initial value = "${zoho.currenttime}"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Completed_Date
		    (
		        type = datetime
		        displayname = "Completed Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}