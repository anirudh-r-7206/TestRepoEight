form Upfitters
{

		    title
		    {
		        displayname = "Upfitters"
		        on add = "Add Upfitter"
		        on edit = "Edit Upfitter"
		    }
		    record owner = Portal_User
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Upfitter_ID
		    (
		        type = autonumber
		        displayname = "Upfitter ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Upfitter_Details
		    (
		        type = section
		        displayname = "Upfitter Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Upfitter_Name
		    (
		        type = text
		        displayname = "Upfitter Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Upfitter_Type
		    (
		        type = picklist
		        displayname = "Upfitter Type"
		        values = {"Member","Contracted"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Portal_User
		    (
		        type = picklist
		        displayname = "Portal User"
		        module = users
		        displayformat = [name]
		        user type = "portal users"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Address
		    (
		        type = address
		        displayname = "Service Address"
		        capture_coordinates = true
		        adjust_using_map = true
		        address_line_1
		        (
		            type = address_line_1
		            displayname = "Street Address"
		        )
		        address_line_2
		        (
		            type = address_line_2
		            displayname = "Suite / Unit"
		        )
		        district_city
		        (
		            type = district_city
		            displayname = "City"
		        )
		        state_province
		        (
		            type = state_province
		            displayname = "State / Province"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "ZIP / Postal Code"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 2
		        column = 1
		        width = medium
		    )
		    City
		    (
		        type = text
		        displayname = "City"
		        row = 2
		        column = 2
		        width = medium
		    )
		    State
		    (
		        type = text
		        displayname = "State"
		        row = 2
		        column = 1
		        width = medium
		    )
		    ZIP
		    (
		        type = text
		        displayname = "ZIP"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Service_Radius_Miles
		    (
		        type = number
		        displayname = "Service Radius (Miles)"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Capabilities
		    (
		        type = list
		        displayname = "Capabilities"
		        values = Capabilities[Status == "Active"].ID
		        displayformat = [Capability_Name]
		        searchable = true
		        height = 120px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Payment_Terms
		    (
		        type = picklist
		        displayname = "Payment Terms"
		        values = {"Net 30","Net 45","Net 60","Other"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Primary_Contact
		    (
		        type = text
		        displayname = "Primary Contact"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        defaultcountry = "us"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Certifications
		    (
		        type = textarea
		        displayname = "Certifications"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Cert_Expiry_Date
		    (
		        type = date
		        displayname = "Certification Expiry Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Internal Notes"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}