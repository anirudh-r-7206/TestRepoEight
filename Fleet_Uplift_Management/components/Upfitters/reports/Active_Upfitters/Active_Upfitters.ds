list Active_Upfitters
{

		    displayName = "Active Upfitters"
		    show all rows from Upfitters [Status == "Active"]
		    (
		        Upfitter_ID
		        Upfitter_Name
		        Upfitter_Type
		        Status
		        City
		        State
		        ZIP
		        Service_Radius_Miles
		        Capabilities
		        Primary_Contact
		        Contact_Email
		        Contact_Phone
		        Cert_Expiry_Date
		    )
		    filters
		    (
		        Upfitter_Type
		        State
		        Capabilities
		    )
		    sort by
		    (
		        Upfitter_Name ascending
		    )
		
}