Programs_On_Add_Validate as "Prepare New Program"
{

			    type = form
			    form = Programs
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clientRecord = FMC_Clients[ID == input.FMC_Client];
			                if(clientRecord.count() > 0)
			                {
			                    input.Client_Portal_User = clientRecord.Portal_User;
			                    input.Client_Contact = clientRecord.Contact_Email;
			                    input.Region_Market = clientRecord.Region_Market;
			                }
			                currentMarkup = Markup_Configurations[Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate)];
			                if(currentMarkup.count() > 0)
			                {
			                    input.Markup_Percent = currentMarkup.Markup_Percent;
			                }
			                input.Program_Status = "Request Intake";
			            )
			        }
			    }
			
}