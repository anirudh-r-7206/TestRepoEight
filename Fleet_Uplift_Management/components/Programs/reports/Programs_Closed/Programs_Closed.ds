list Programs_Closed
{

		    displayName = "Programs - Closed"
		    show all rows from Programs [Program_Status == "Closed"]
		    (
		        Service_ID
		        Program_Name
		        FMC_Client
		        Request_Date
		        Program_Status
		        Vehicle_Count
		        Region_Market
		        Completion_Report
		        Closeout_Document
		    )
		    filters
		    (
		        FMC_Client
		        Region_Market
		        Request_Date
		    )
		    sort by
		    (
		        Request_Date descending
		    )
		
}