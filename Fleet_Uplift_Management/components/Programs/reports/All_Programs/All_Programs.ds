default list All_Programs
{

		    displayName = "All Programs"
		    show all rows from Programs
		    (
		        Service_ID
		        Program_Name
		        FMC_Client
		        Request_Date
		        Program_Status
		        Vehicle_Count
		        Region_Market
		        Markup_Percent
		        Client_Contact
		    )
		    filters
		    (
		        Program_Status
		        FMC_Client
		        Region_Market
		        Request_Date
		    )
		    sort by
		    (
		        Request_Date descending
		        Service_ID ascending
		    )
		
}