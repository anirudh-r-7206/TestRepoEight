form Programs
{

		    title
		    {
		        displayname = "Programs"
		        on add = "Create Program"
		        on edit = "Edit Program"
		    }
		    record owner = Client_Portal_User
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Program_Sequence
		    (
		        type = autonumber
		        displayname = "Program Sequence"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    unique Service_ID
		    (
		        type = text
		        displayname = "Service ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Client_Portal_User
		    (
		        type = picklist
		        displayname = "Client Portal User"
		        module = users
		        displayformat = [name]
		        user type = "portal users"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Client_Contact
		    (
		        type = email
		        displayname = "Client Contact"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Vehicle_Count
		    (
		        type = number
		        displayname = "Vehicle Count"
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Program_Details
		    (
		        type = section
		        displayname = "Program Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Program_Name
		    (
		        type = text
		        displayname = "Program Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have FMC_Client
		    (
		        type = picklist
		        displayname = "FMC Client"
		        values = FMC_Clients[Status == "Active"].ID
		        displayformat = [Client_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Request_Date
		    (
		        type = date
		        displayname = "Request Date"
		        initial value = "${zoho.currentdate}"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Program_Status
		    (
		        type = picklist
		        displayname = "Program Status"
		        values = {"Request Intake","Scope & Source","Upfitter Matching","Pending Estimates","Pending Quote Approval","PO Received","In Execution","Closed"}
		        initial value = "Request Intake"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Region_Market
		    (
		        type = text
		        displayname = "Region / Market"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Markup_Percent
		    (
		        type = decimal
		        displayname = "Markup Percent"
		        decimalplace = 2
		        maxchar = 6
		        row = 2
		        column = 2
		        width = medium
		    )
		    Internal_Notes
		    (
		        type = textarea
		        displayname = "Internal Notes"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Documents
		    (
		        type = section
		        displayname = "Generated Documents"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Completion_Report
		    (
		        type = upload file
		        displayname = "Completion Report"
		        browse = local_drive
		        row = 3
		        column = 1
		        width = medium
		    )
		    Closeout_Document
		    (
		        type = upload file
		        displayname = "Closeout Document"
		        browse = local_drive
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}