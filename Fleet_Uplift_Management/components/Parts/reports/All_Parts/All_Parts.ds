default list All_Parts
{

		    displayName = "All Parts"
		    show all rows from Parts
		    (
		        Part_ID
		        Part_Name
		        Brand
		        Part_Number
		        Sourcing
		        Unit_Price
		        Linked_Capability
		        Lead_Time_Days
		        Status
		    )
		    filters
		    (
		        Brand
		        Sourcing
		        Linked_Capability
		        Status
		    )
		    sort by
		    (
		        Part_Name ascending
		    )
		
}