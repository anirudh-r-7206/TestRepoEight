form Parts
{

		    title
		    {
		        displayname = "Parts"
		        on add = "Add Part"
		        on edit = "Edit Part"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Part_ID
		    (
		        type = autonumber
		        displayname = "Part ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Part_Details
		    (
		        type = section
		        displayname = "Part Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Part_Name
		    (
		        type = text
		        displayname = "Part Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Brand
		    (
		        type = text
		        displayname = "Brand"
		        row = 2
		        column = 2
		        width = medium
		    )
		    unique Part_Number
		    (
		        type = text
		        displayname = "Part Number"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Sourcing
		    (
		        type = picklist
		        displayname = "Sourcing"
		        values = {"Manufacturer","Distributor"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Unit_Price
		    (
		        type = USD
		        displayname = "Unit Price"
		        decimalplace = 2
		        maxchar = 12
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Linked_Capability
		    (
		        type = picklist
		        displayname = "Linked Capability"
		        values = Capabilities[Status == "Active"].ID
		        displayformat = [Capability_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Lead_Time_Days
		    (
		        type = number
		        displayname = "Lead Time (Days)"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Discontinued"}
		        initial value = "Active"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}