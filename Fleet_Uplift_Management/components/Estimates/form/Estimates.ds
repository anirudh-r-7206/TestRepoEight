form Estimates
{

		    title
		    {
		        displayname = "Estimates"
		        on add = "Create Estimate"
		        on edit = "Edit Estimate"
		    }
		    record owner = Upfitter_Portal_User
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Estimate_ID
		    (
		        type = autonumber
		        displayname = "Estimate ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Upfitter_Portal_User
		    (
		        type = picklist
		        displayname = "Upfitter Portal User"
		        module = users
		        displayformat = [name]
		        user type = "portal users"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reassignment_Flag
		    (
		        type = checkbox
		        displayname = "Reassignment Required"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Estimate_Details
		    (
		        type = section
		        displayname = "Estimate Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Program
		    (
		        type = picklist
		        displayname = "Program"
		        values = Programs.ID
		        displayformat = [Service_ID]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Upfitter
		    (
		        type = picklist
		        displayname = "Upfitter"
		        values = Upfitters[Status == "Active"].ID
		        displayformat = [Upfitter_Name]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Vehicles_In_Scope
		    (
		        type = list
		        displayname = "Vehicles in Scope"
		        values = Vehicles.ID
		        displayformat = [VIN]
		        searchable = true
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Estimate_Parts_Section
		    (
		        type = section
		        displayname = "Parts"
		        visibility = false
		        row = 3
		        column = 1
		    )
		    Estimate_Parts_Lines
		    (
		        type = grid
		        displayname = "Parts Lines"
		        values = Estimate_Parts_Lines.ID
		        bidirectional = Estimate
		        defaultrow = 1
		        maxrow = 100
		        row = 3
		        column = 1
		        width = medium
		    )
		    Estimate_Labor_Section
		    (
		        type = section
		        displayname = "Labor"
		        visibility = false
		        row = 4
		        column = 1
		    )
		    Estimate_Labor_Lines
		    (
		        type = grid
		        displayname = "Labor Lines"
		        values = Estimate_Labor_Lines.ID
		        bidirectional = Estimate
		        defaultrow = 1
		        maxrow = 100
		        row = 4
		        column = 1
		        width = medium
		    )
		    Totals
		    (
		        type = section
		        displayname = "Estimate Totals"
		        visibility = true
		        row = 5
		        column = 1
		    )
		    Parts_Total
		    (
		        type = USD
		        displayname = "Parts Total"
		        initial value = 0.00
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 1
		        width = medium
		    )
		    Labor_Total
		    (
		        type = USD
		        displayname = "Labor Total"
		        initial value = 0.00
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 2
		        width = medium
		    )
		    Estimate_Total
		    (
		        type = USD
		        displayname = "Estimate Total"
		        initial value = 0.00
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 1
		        width = medium
		    )
		    Response
		    (
		        type = section
		        displayname = "Upfitter Response"
		        visibility = true
		        row = 6
		        column = 1
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Pending Upfitter Review","Approved","Declined","Revision Requested"}
		        initial value = "Pending Upfitter Review"
		        row = 6
		        column = 1
		        width = medium
		    )
		    Upfitter_Response
		    (
		        type = textarea
		        displayname = "Upfitter Response"
		        height = 100px
		        row = 6
		        column = 2
		        width = medium
		    )
		    Response_Date
		    (
		        type = datetime
		        displayname = "Response Date"
		        row = 6
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}