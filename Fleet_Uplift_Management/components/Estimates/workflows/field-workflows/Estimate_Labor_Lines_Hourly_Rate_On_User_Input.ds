Estimate_Labor_Lines_Hourly_Rate_On_User_Input as "Calculate Labor from Rate"
{

			    type = form
			    form = Estimates
			    record event = on add or edit
			
			    on user input of Estimate_Labor_Lines.Hourly_Rate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                row.Line_Total = ifnull(row.Hours, 0.00) * ifnull(row.Hourly_Rate, 0.00);
			                laborTotal = 0.00;
			                for each laborRow in input.Estimate_Labor_Lines
			                {
			                    laborTotal = laborTotal + ifnull(laborRow.Line_Total, 0.00);
			                }
			                input.Labor_Total = laborTotal;
			                input.Estimate_Total = ifnull(input.Parts_Total, 0.00) + laborTotal;
			            )
			        }
			    }
			
}