form Estimate_Labor_Lines
{

		    title
		    {
		        displayname = "Estimate Labor Lines"
		        on add = "Add Estimate Labor Line"
		        on edit = "Edit Estimate Labor Line"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Estimate_Labor_Line_ID
		    (
		        type = autonumber
		        displayname = "Estimate Labor Line ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Line_Details
		    (
		        type = section
		        displayname = "Labor Line Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Estimate
		    (
		        type = picklist
		        displayname = "Estimate"
		        values = Estimates.ID
		        bidirectional = Estimate_Labor_Lines
		        displayformat = [Estimate_ID]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Description
		    (
		        type = text
		        displayname = "Description"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Hours
		    (
		        type = decimal
		        displayname = "Hours"
		        decimalplace = 2
		        maxchar = 10
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Hourly_Rate
		    (
		        type = USD
		        displayname = "Hourly Rate"
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Line_Total
		    (
		        type = USD
		        displayname = "Line Total"
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}