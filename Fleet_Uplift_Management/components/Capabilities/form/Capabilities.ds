form Capabilities
{

		    title
		    {
		        displayname = "Capabilities"
		        on add = "Add Capability"
		        on edit = "Edit Capability"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Capability_ID
		    (
		        type = autonumber
		        displayname = "Capability ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Details
		    (
		        type = section
		        displayname = "Capability Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have unique Capability_Name
		    (
		        type = text
		        displayname = "Capability Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}