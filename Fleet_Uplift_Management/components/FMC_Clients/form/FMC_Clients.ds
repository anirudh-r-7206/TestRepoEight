form FMC_Clients
{

		    title
		    {
		        displayname = "FMC Clients"
		        on add = "Add FMC Client"
		        on edit = "Edit FMC Client"
		    }
		    record owner = Portal_User
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Client_ID
		    (
		        type = autonumber
		        displayname = "Client ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Client_Details
		    (
		        type = section
		        displayname = "Client Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Client_Name
		    (
		        type = text
		        displayname = "Client Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have unique Client_Code
		    (
		        type = text
		        displayname = "Client Code"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Primary_Contact
		    (
		        type = text
		        displayname = "Primary Contact"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Portal_User
		    (
		        type = picklist
		        displayname = "Portal User"
		        module = users
		        displayformat = [name]
		        user type = "portal users"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have unique Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        defaultcountry = "us"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Billing_Address
		    (
		        type = address
		        displayname = "Billing Address"
		        capture_coordinates = false
		        adjust_using_map = false
		        address_line_1
		        (
		            type = address_line_1
		            displayname = "Street Address"
		        )
		        address_line_2
		        (
		            type = address_line_2
		            displayname = "Suite / Unit"
		        )
		        district_city
		        (
		            type = district_city
		            displayname = "City"
		        )
		        state_province
		        (
		            type = state_province
		            displayname = "State / Province"
		        )
		        postal_Code
		        (
		            type = postal_Code
		            displayname = "Postal Code"
		        )
		        country
		        (
		            type = country
		            displayname = "Country"
		        )
		        latitude
		        (
		            type = latitude
		            displayname = "Latitude"
		            visibility = false
		        )
		        longitude
		        (
		            type = longitude
		            displayname = "Longitude"
		            visibility = false
		        )
		        row = 2
		        column = 2
		        width = medium
		    )
		    Region_Market
		    (
		        type = text
		        displayname = "Region / Market"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Payment_Terms
		    (
		        type = picklist
		        displayname = "Payment Terms"
		        values = {"Net 45"}
		        initial value = "Net 45"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Internal Notes"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}