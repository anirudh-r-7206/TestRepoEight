form System_Configuration
{

		    title
		    {
		        displayname = "System Configuration"
		        on add = "Configure Platform"
		        on edit = "Edit Platform Configuration"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Configuration_ID
		    (
		        type = autonumber
		        displayname = "Configuration ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Branding
		    (
		        type = section
		        displayname = "Branding"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Company_Name
		    (
		        type = text
		        displayname = "Company Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    FMC_Logo
		    (
		        type = image
		        displayname = "FMC Logo"
		        source = file
		        aspect ratio = original
		        row = 2
		        column = 2
		        width = medium
		    )
		    Primary_Color
		    (
		        type = text
		        displayname = "Primary Color"
		        initial value = "#6147E5"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Document_Footer
		    (
		        type = richtext
		        displayname = "Document Footer"
		        height = 150px
		        toolbar = enable
		        [
		            style, font-color, alignment, link, html,
		            font-size : {2,3,4},
		            font-family : {"Arimo","Lato","Poppins"}
		        ]
		        row = 2
		        column = 2
		        width = medium
		    )
		    Process_Settings
		    (
		        type = section
		        displayname = "Process Settings"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Quote_Validity_Days
		    (
		        type = number
		        displayname = "Quote Validity Days"
		        initial value = 30
		        row = 3
		        column = 1
		        width = medium
		    )
		    Weekly_Digest_Enabled
		    (
		        type = checkbox
		        displayname = "Weekly Digest Enabled"
		        initial value = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    Digest_Day
		    (
		        type = picklist
		        displayname = "Digest Day"
		        values = {"Monday","Tuesday","Wednesday","Thursday","Friday"}
		        initial value = "Monday"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Default_Currency
		    (
		        type = text
		        displayname = "Default Currency"
		        initial value = "USD"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Configuration"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Configuration"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		    properties
		    {
		        total entries
		        {
		            allowed count = 1
		            exceed message = "Only one platform configuration record is allowed."
		        }
		    }
		
}