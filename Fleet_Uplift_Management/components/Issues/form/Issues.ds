form Issues
{

		    title
		    {
		        displayname = "Issues"
		        on add = "Create Issue"
		        on edit = "Edit Issue"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Issue_ID
		    (
		        type = autonumber
		        displayname = "Issue ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Alert_Sent
		    (
		        type = checkbox
		        displayname = "Alert Sent"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Issue_Details
		    (
		        type = section
		        displayname = "Issue Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Program
		    (
		        type = picklist
		        displayname = "Program"
		        values = Programs.ID
		        displayformat = [Service_ID]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Vehicle
		    (
		        type = picklist
		        displayname = "Vehicle"
		        values = Vehicles.ID
		        displayformat = [VIN]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Issue_Type
		    (
		        type = picklist
		        displayname = "Issue Type"
		        values = {"Estimate Decline","Schedule Delay","Scope Question","QC Fail","Coverage Gap","Other"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Priority
		    (
		        type = picklist
		        displayname = "Priority"
		        values = {"High","Medium","Low"}
		        initial value = "Medium"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Open","In Progress","Resolved","Closed"}
		        initial value = "Open"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Assigned_To
		    (
		        type = picklist
		        displayname = "Assigned To"
		        module = users
		        displayformat = [name]
		        row = 2
		        column = 1
		        width = medium
		    )
		    Resolution
		    (
		        type = textarea
		        displayname = "Resolution"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Opened_Date
		    (
		        type = datetime
		        displayname = "Opened Date"
		        initial value = "${zoho.currenttime}"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Closed_Date
		    (
		        type = datetime
		        displayname = "Closed Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}