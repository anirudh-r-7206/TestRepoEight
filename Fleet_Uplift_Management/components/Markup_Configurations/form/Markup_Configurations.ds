form Markup_Configurations
{

		    title
		    {
		        displayname = "Markup Configurations"
		        on add = "Add Markup Configuration"
		        on edit = "Edit Markup Configuration"
		    }
		    Hidden_Section
		    (
		        type = section
		        displayname = "System Information"
		        row = 1
		        column = 0
		    )
		    Markup_Config_ID
		    (
		        type = autonumber
		        displayname = "Markup Configuration ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Configuration
		    (
		        type = section
		        displayname = "Markup Configuration"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Configuration_Name
		    (
		        type = text
		        displayname = "Configuration Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Markup_Percent
		    (
		        type = decimal
		        displayname = "Markup Percent"
		        decimalplace = 2
		        maxchar = 6
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Effective_From
		    (
		        type = date
		        displayname = "Effective From"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Effective_To
		    (
		        type = date
		        displayname = "Effective To"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}