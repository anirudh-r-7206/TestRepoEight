default list All_Markup_Configurations
{

		    displayName = "All Markup Configurations"
		    show all rows from Markup_Configurations
		    (
		        Markup_Config_ID
		        Configuration_Name
		        Markup_Percent
		        Effective_From
		        Effective_To
		        Status
		        Notes
		    )
		    filters
		    (
		        Status
		        Effective_From
		        Effective_To
		    )
		    sort by
		    (
		        Effective_From descending
		    )
		
}