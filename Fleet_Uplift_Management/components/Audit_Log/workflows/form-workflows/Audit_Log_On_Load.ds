Audit_Log_On_Load as "Lock Audit Log"
{

			    type = form
			    form = Audit_Log
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Hidden_Section;
			                disable Event_Date, User_Email, User_Profile, Module_Name, Record_ID, Program, Action, Before_Value, After_Value, Details;
			            )
			        }
			    }
			
}