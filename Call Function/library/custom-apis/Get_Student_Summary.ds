api Get_Student_Summary
{
    display name = "Get Student Summary"
    description = "Returns a readable student summary and age category for the supplied student name and age."
    method = POST
    content type = application/json
    argument type = Key-Value
    authentication = OAuth2
    scope = "All users"
    actions
    (
        Call_Function.Students.Build_Student_Summary(student_name, age);
    )
}
