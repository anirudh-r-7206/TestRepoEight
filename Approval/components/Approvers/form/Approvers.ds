form Approvers
{
    success message = "Approver saved successfully."

    Approver_Details
    (
        type = section
        displayname = "Approver Details"
        row = 1
        column = 0
    )
    must have Approver_Name
    (
        type = text
        displayname = "Approver Name"
        maxchar = 255
        row = 1
        column = 1
        width = medium
    )
    must have unique Email_ID
    (
        type = email
        displayname = "Email ID"
        personal data = true
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
