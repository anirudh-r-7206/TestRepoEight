	workflow
	{
		form
		{
			Items_Menu_Item_On_User_Input as "Items Menu Item On User Input"
			{
			    type = form
			    form = Orders
			    record event = on add or edit
			    description = "Fills the unit price from the menu and recomputes totals"
			
			    on user input of Items.Menu_Item
			    {
			        actions
			        {
			            custom deluge script
			            (
			                price = 0;
			                if(row.Menu_Item != null)
			                {
			                    itemRec = Menu_Items[ID == row.Menu_Item];
			                    if(itemRec.count() > 0)
			                    {
			                        price = ifnull(itemRec.Price,0);
			                    }
			                }
			                row.Unit_Price = price;
			                row.Line_Total = price * ifnull(row.Quantity,0);
			                total = 0;
			                for each r in input.Items
			                {
			                    total = total + ifnull(r.Line_Total,0);
			                }
			                input.Total_Amount = total;
			            )
			        }
			    }
			}

			Items_Quantity_On_User_Input as "Items Quantity On User Input"
			{
			    type = form
			    form = Orders
			    record event = on add or edit
			    description = "Recomputes the line total and the order total"
			
			    on user input of Items.Quantity
			    {
			        actions
			        {
			            custom deluge script
			            (
			                row.Line_Total = ifnull(row.Unit_Price,0) * ifnull(row.Quantity,0);
			                total = 0;
			                for each r in input.Items
			                {
			                    total = total + ifnull(r.Line_Total,0);
			                }
			                input.Total_Amount = total;
			            )
			        }
			    }
			}

			Orders_On_Load as "Orders On Load"
			{
			    type = form
			    form = Orders
			    record event = on add or edit
			    description = "Total and line prices are computed, so lock them"
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Total_Amount;
			                disable Items.Unit_Price;
			                disable Items.Line_Total;
			            )
			        }
			    }
			}

			Orders_On_Success as "Orders On Success"
			{
			    type = form
			    form = Orders
			    record event = on add or edit
			    description = "Marks the table occupied while an order is open and frees it once paid"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                tableRec = Dining_Tables[ID == input.Dining_Table];
			                if(tableRec.count() > 0)
			                {
			                    if(input.Order_Status == "Open" || input.Order_Status == "Served")
			                    {
			                        tableRec.Status = "Occupied";
			                    }
			                    else
			                    {
			                        otherOpen = Orders[Dining_Table == input.Dining_Table && ID != input.ID && (Order_Status == "Open" || Order_Status == "Served")].count();
			                        seatedRes = Reservations[Dining_Table == input.Dining_Table && Status == "Seated"];
			                        for each res in seatedRes
			                        {
			                            res.Status = "Completed";
			                        }
			                        bookedCount = Reservations[Dining_Table == input.Dining_Table && Status == "Booked" && Reservation_Time >= zoho.currenttime].count();
			                        if(otherOpen > 0)
			                        {
			                            tableRec.Status = "Occupied";
			                        }
			                        else if(bookedCount > 0)
			                        {
			                            tableRec.Status = "Reserved";
			                        }
			                        else
			                        {
			                            tableRec.Status = "Available";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Orders_On_Validate as "Orders On Validate"
			{
			    type = form
			    form = Orders
			    record event = on add or edit
			    description = "Requires at least one item and recomputes the total from the menu prices"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Items.count() == 0)
			                {
			                    alert "Add at least one menu item to the order.";
			                    cancel submit;
			                }
			                if(input.Order_Status == "Paid" && input.Payment_Mode == null)
			                {
			                    alert "Select a payment mode before marking the order as paid.";
			                    cancel submit;
			                }
			                total = 0;
			                for each r in input.Items
			                {
			                    total = total + ifnull(r.Unit_Price,0) * ifnull(r.Quantity,0);
			                }
			                input.Total_Amount = total;
			            )
			        }
			    }
			}

			Reservations_On_Success as "Reservations On Success"
			{
			    type = form
			    form = Reservations
			    record event = on add or edit
			    description = "Keeps the table status in sync with the reservation status"
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                tableRec = Dining_Tables[ID == input.Dining_Table];
			                if(tableRec.count() > 0)
			                {
			                    if(input.Status == "Seated")
			                    {
			                        tableRec.Status = "Occupied";
			                    }
			                    else if(input.Status == "Booked")
			                    {
			                        if(tableRec.Status == "Available")
			                        {
			                            tableRec.Status = "Reserved";
			                        }
			                    }
			                    else
			                    {
			                        seatedCount = Reservations[Dining_Table == input.Dining_Table && ID != input.ID && Status == "Seated"].count();
			                        openOrders = Orders[Dining_Table == input.Dining_Table && Order_Status != "Paid" && Order_Status != "Cancelled"].count();
			                        bookedCount = Reservations[Dining_Table == input.Dining_Table && ID != input.ID && Status == "Booked"].count();
			                        if(seatedCount > 0 || openOrders > 0)
			                        {
			                            tableRec.Status = "Occupied";
			                        }
			                        else if(bookedCount > 0)
			                        {
			                            tableRec.Status = "Reserved";
			                        }
			                        else
			                        {
			                            tableRec.Status = "Available";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Reservations_On_Validate as "Reservations On Validate"
			{
			    type = form
			    form = Reservations
			    record event = on add or edit
			    description = "Rejects bookings that exceed table capacity or clash with another booking"
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Booked" || input.Status == "Seated")
			                {
			                    tableRec = Dining_Tables[ID == input.Dining_Table];
			                    if(tableRec.count() > 0)
			                    {
			                        if(ifnull(input.Party_Size,0) > tableRec.Seats)
			                        {
			                            alert "Table " + tableRec.Table_Number + " seats only " + tableRec.Seats + " guests. Pick a larger table.";
			                            cancel submit;
			                        }
			                        currentId = ifnull(input.ID,0);
			                        slotStart = input.Reservation_Time.subHour(2);
			                        slotEnd = input.Reservation_Time.addHour(2);
			                        if(input.Status == "Booked" && tableRec.Status == "Occupied" && input.Reservation_Time < zoho.currenttime.addHour(2))
			                        {
			                            alert "Table " + tableRec.Table_Number + " is occupied right now. Pick another table or a later time.";
			                            cancel submit;
			                        }
			                        clashCount = Reservations[Dining_Table == input.Dining_Table && ID != currentId && (Status == "Booked" || Status == "Seated") && Reservation_Time > slotStart && Reservation_Time < slotEnd].count();
			                        if(clashCount > 0)
			                        {
			                            alert "Table " + tableRec.Table_Number + " already has a booking within 2 hours of this time.";
			                            cancel submit;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}
		}
	}

	share_settings
	{
	"Restaurant_Staff"
	{
	    name        = "Restaurant_Staff"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
	    description = "Front-of-house staff: hosts and waiters who seat guests, take reservations and orders"
	
	    ModulePermissions
	    {
	        Dining_Tables
	        {
	            enabled          = Viewall,Modifyall,Tab,View,Edit,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                All_Tables={"View","Edit"}
	                Tables_Kanban={"View","Edit"}
	            }
	            FieldPermissions
	            {
	                Table_Number{visibility:true,readonly:true}
	                Seats{visibility:true,readonly:true}
	                Area{visibility:true,readonly:true}
	                Status{visibility:true,readonly:false}
	                Notes{visibility:true,readonly:false}
	            }
	        }
	        Menu_Items
	        {
	            enabled          = Viewall,Tab,View,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Menu_Items={"View"}
	            }
	        }
	        Reservations
	        {
	            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Reservations={"View","Edit"}
	                Reservation_Calendar={"View","Edit"}
	                Todays_Reservations={"View","Edit"}
	            }
	        }
	        Orders
	        {
	            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Orders={"View","Edit"}
	                Open_Orders={"View","Edit"}
	                Orders_Kanban={"View","Edit"}
	            }
	        }
	
	        Table_Floor
	        {
	            enabled = tab
	        }
	        Restaurant_Dashboard
	        {
	            enabled = tab
	        }
	    }
	}
	}

