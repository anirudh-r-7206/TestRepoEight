report Reservation_Calendar
{
    quickview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -1
                fields
                (
                    Guest_Name
                    Party_Size
                    Reservation_Time
                    Dining_Table.Table_Number as "Table"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Guest_Name
                    Party_Size
                    Reservation_Time
                    Dining_Table.Table_Number as "Table"
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
