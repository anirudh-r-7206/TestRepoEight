report All_Orders
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Order_No
                    Dining_Table as "Table"
                    Guests
                    Order_Time
                    Items
                    Total_Amount
                    Order_Status
                    Payment_Mode
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Order_No
                    Dining_Table as "Table"
                    Guests
                    Order_Time
                    Items
                    Total_Amount
                    Order_Status
                    Payment_Mode
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
