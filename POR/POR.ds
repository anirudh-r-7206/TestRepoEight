		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Vendor_ID Vendor_Name Contact_Name Contact_Email Contact_Phone Payment_Terms Currency Active ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
