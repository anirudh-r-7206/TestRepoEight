		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Invoice_Number Purchase_Order Vendor Invoice_Date Due_Date Invoice_Total Match_Status Amount_Variance ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Invoice_Number Purchase_Order Vendor Invoice_Date Due_Date Invoice_Total Match_Status Amount_Variance ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
