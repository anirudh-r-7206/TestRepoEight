		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Invoice_Number Purchase_Order Vendor Invoice_Date Due_Date Invoice_Total Match_Status Amount_Variance Exception_Details ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
