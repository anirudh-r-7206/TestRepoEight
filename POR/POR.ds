	                Purchase_Approval_Queue={"View","Edit","Delete"}
	                Finance_Approval_Queue={"View","Edit","Delete"}
	                Purchase_Order_Register={"View","Edit","Delete"}
	                Purchase_Request_Board={"View","Edit","Delete"}
	            }
	        }
	        Invoice_Lines
	        {
	            enabled = Create,Viewall,Modifyall,Import,Export,View,Edit,Delete,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                Invoice_Line_Register={"View","Edit","Delete"}
	            }
	        }
	        Invoices
	        {
	            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                Invoice_Register={"View","Edit","Delete"}
	                Match_Exceptions={"View","Edit","Delete"}
	                Unpaid_or_Open_Invoices={"View","Edit","Delete"}
	            }
	        }
	        Audit_Log
	        {
	            enabled = Viewall,Export,Tab,View,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                Audit_Trail={"View"}
	            }
	            FieldPermissions
	            {
	                Event_Time{visibility:true,readonly:true}
	                User_Email{visibility:true,readonly:true}
	                User_Profile{visibility:true,readonly:true}
	                Action{visibility:true,readonly:true}
	                Component{visibility:true,readonly:true}
	                Record_ID{visibility:true,readonly:true}
	                Reference_Number{visibility:true,readonly:true}
	                Before_Value{visibility:true,readonly:true}
	                After_Value{visibility:true,readonly:true}
	                Notes{visibility:true,readonly:true}
	            }
	        }
	        Purchase_Finance_Dashboard
	        {
	            enabled = tab
	        }
	        Invoice_Match_Status
	        {
	            enabled = tab
	        }
	    }
	}
	"Purchase_Approver"
	{
	    name = "Purchase_Approver"
	    type = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
	    description = "Approvers review assigned purchase requests and execute manager approval decisions."
	
	    ModulePermissions
	    {
	        Vendors
	        {
	            enabled = View,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                Active_Vendors={"View"}
	            }
	            FieldPermissions
	            {
	                Vendor_ID{visibility:true,readonly:true}
	                Vendor_Name{visibility:true,readonly:true}
	                Tax_Registration_Number{visibility:true,readonly:true}
	                Contact_Name{visibility:true,readonly:true}
	                Contact_Email{visibility:true,readonly:true}
	                Contact_Phone{visibility:true,readonly:true}
	                Payment_Terms{visibility:true,readonly:true}
	                Currency{visibility:true,readonly:true}
	                Active{visibility:true,readonly:true}
	                Notes{visibility:false}
	            }
	        }
	        Vendor_Items
	        {
	            enabled = View,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                Vendor_Catalog={"View"}
	            }
	            FieldPermissions
	            {
	                Item_Code{visibility:true,readonly:true}
	                Vendor{visibility:true,readonly:true}
	                Item_Name{visibility:true,readonly:true}
	                Item_Description{visibility:true,readonly:true}
	                Unit_Of_Measure{visibility:true,readonly:true}
	                Unit_Price{visibility:true,readonly:true}
	                Tax_Rate{visibility:true,readonly:true}
	                Active{visibility:true,readonly:true}
	                Effective_From{visibility:true,readonly:true}
	                Effective_To{visibility:true,readonly:true}
	            }
	        }
	        Purchase_Request_Lines
	        {
	            enabled = View,Search
	            allFieldsVisible = false
	            FieldPermissions
	            {
	                Catalog_Item{visibility:true,readonly:true}
	                Item_Description{visibility:true,readonly:true}
	                Quantity{visibility:true,readonly:true}
	                Unit_Of_Measure{visibility:true,readonly:true}
	                Unit_Price{visibility:true,readonly:true}
	                Tax_Rate{visibility:true,readonly:true}
	                Line_Subtotal{visibility:true,readonly:true}
	                Tax_Amount{visibility:true,readonly:true}
	                Line_Total{visibility:true,readonly:true}
	            }
	        }
	        Purchase_Requests
	        {
	            enabled = View,Edit,Search,Tab
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                Purchase_Approval_Queue={"View","Edit"}
	            }
	            FieldPermissions
	            {
	                Request_Number{visibility:true,readonly:true}
	                Requester{visibility:true,readonly:true}
	                Department{visibility:true,readonly:true}
	                Request_Date{visibility:true,readonly:true}
	                Needed_By{visibility:true,readonly:true}
	                Vendor{visibility:true,readonly:true}
	                Assigned_Approver{visibility:true,readonly:true}
	                Business_Justification{visibility:true,readonly:true}
	                Quote_Attachment{visibility:true,readonly:true}
	                Requested_Items{visibility:true,readonly:true}
	                Subtotal{visibility:true,readonly:true}
	                Tax_Total{visibility:true,readonly:true}
	                Request_Total{visibility:true,readonly:true}
	                Status{visibility:true,readonly:true}
	                Rejection_Reason{visibility:true,readonly:false}
	                PO_Number{visibility:true,readonly:true}
	                PO_Date{visibility:true,readonly:true}
	                PO_Total{visibility:true,readonly:true}
	                Invoiced_Total{visibility:true,readonly:true}
	                Remaining_To_Invoice{visibility:true,readonly:true}
	                Last_Match_Date{visibility:true,readonly:true}
	            }
	        }
	        Invoice_Lines
	        {
	            enabled = View,Search
	            allFieldsVisible = false
	            FieldPermissions
	            {
	                Catalog_Item{visibility:true,readonly:true}
	                Description{visibility:true,readonly:true}
	                Invoiced_Quantity{visibility:true,readonly:true}
	                Unit_Price{visibility:true,readonly:true}
	                Tax_Rate{visibility:true,readonly:true}
	                Line_Subtotal{visibility:true,readonly:true}
	                Tax_Amount{visibility:true,readonly:true}
	                Line_Total{visibility:true,readonly:true}
	            }
	        }
	        Invoices
	        {
	            enabled = View,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                Invoice_Register={"View"}
	            }
	            FieldPermissions
	            {
	                Invoice_Number{visibility:true,readonly:true}
