		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Item_Code Vendor Item_Name Unit_Of_Measure Unit_Price Tax_Rate Active Effective_From Effective_To ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
