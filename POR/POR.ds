	web
	{
	forms
	{
	    form Vendors { label placement = top }
	    form Vendor_Items { label placement = top }
	    form Purchase_Requests { label placement = top }
	    form Purchase_Request_Lines { label placement = top }
	    form Invoices { label placement = top }
	    form Invoice_Lines { label placement = top }
	    form Audit_Log { label placement = top }
	}
	reports
	{
		report Audit_Trail
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Event_Time as "Event Time" User_Email as "User" User_Profile as "Profile" Action Component Reference_Number as "Reference" Notes ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Event_Time as "Event Time" User_Email as "User" User_Profile as "Profile" Action Component Reference_Number as "Reference" Notes ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Invoice_Line_Register
		{
		 quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Catalog_Item Invoiced_Quantity Unit_Price Tax_Rate Line_Subtotal Tax_Amount Line_Total ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Catalog_Item Invoiced_Quantity Unit_Price Tax_Rate Line_Subtotal Tax_Amount Line_Total ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
