		 detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Catalog_Item Quantity Unit_Of_Measure Unit_Price Tax_Rate Line_Subtotal Tax_Amount Line_Total ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
