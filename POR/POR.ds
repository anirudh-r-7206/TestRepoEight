		    sort by
		    (
		        Vendor_Name ascending
		    )
		}
	}

	pages
	{
		page Invoice_Match_Status
		{
					displayname = "Invoice Match Status"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dspZml id='Invoice_Match_Status_Snippet' elementName='Invoice_Match_Status_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Invoice_Match_Status_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\tpendingInvoices = Invoices[Match_Status == &quot;Pending Match&quot;];\n\tpendingCount = pendingInvoices.count();\n\tpendingTotal = ifnull(pendingInvoices.sum(Invoice_Total),0);\n\n\tpartialInvoices = Invoices[Match_Status == &quot;Partial Match&quot;];\n\tpartialCount = partialInvoices.count();\n\tpartialTotal = ifnull(partialInvoices.sum(Invoice_Total),0);\n\n\tmatchedInvoices = Invoices[Match_Status == &quot;Matched&quot;];\n\tmatchedCount = matchedInvoices.count();\n\tmatchedTotal = ifnull(matchedInvoices.sum(Invoice_Total),0);\n\n\texceptionInvoices = Invoices[Match_Status == &quot;Exception&quot;];\n\texceptionCount = exceptionInvoices.count();\n\texceptionTotal = ifnull(exceptionInvoices.sum(Invoice_Total),0);\n%&gt;\n&lt;panel elementName=&apos;Invoice_Match_Status_Grouped_Panel&apos;&gt;\n\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t&lt;pc padding=&apos;22px&apos; bgColor=&apos;#F8FAFC&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos; cornerRadius=&apos;14px&apos;&gt;\n\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t\t\t&lt;pc width=&apos;8%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t\t\t&lt;image margin=&apos;0px&apos; color=&apos;#FFFFFF&apos; bgColor=&apos;#3157D5&apos; width=&apos;48px&apos; height=&apos;48px&apos; type=&apos;icon&apos; value=&apos;zc-li-outline business-chart-bar-33&apos; size=&apos;24px&apos; cornerRadius=&apos;12px&apos;/&gt;\n\t\t\t\t&lt;/pc&gt;\n\t\t\t\t&lt;pc padding=&apos;5px&apos; width=&apos;92%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;24px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;Invoice Match Status&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text marginTop=&apos;5px&apos; padding=&apos;0px&apos; color=&apos;#64748B&apos; size=&apos;14px&apos; type=&apos;Text&apos; value=&apos;Invoice volume and value grouped by current matching outcome.&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t&lt;/pc&gt;\n\t\t\t&lt;/pr&gt;\n\t\t&lt;/pc&gt;\n\t&lt;/pr&gt;\n\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t&lt;pc padding=&apos;20px&apos; bgColor=&apos;#FFF8E6&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos; cornerRadius=&apos;14px&apos; borderColor=&apos;#F7D57A&apos; borderWidth=&apos;1px&apos;&gt;\n\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t\t\t&lt;pc width=&apos;18%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;center&apos; vAlign=&apos;middle&apos;&gt;&lt;image margin=&apos;0px&apos; color=&apos;#9A6700&apos; bgColor=&apos;#FFEDB5&apos; width=&apos;52px&apos; height=&apos;52px&apos; type=&apos;icon&apos; value=&apos;zc-li-outline ui-2-time&apos; size=&apos;25px&apos; cornerRadius=&apos;26px&apos;/&gt;&lt;/pc&gt;\n\t\t\t\t&lt;pc padding=&apos;5px&apos; width=&apos;82%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#7A5200&apos; size=&apos;16px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;Pending Match&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc width=&apos;45%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;30px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=pendingCount%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#7A6850&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoices&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;pc width=&apos;55%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;right&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;22px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=pendingTotal%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#7A6850&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoice total&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t&lt;/pc&gt;\n\t\t\t&lt;/pr&gt;\n\t\t&lt;/pc&gt;\n\t&lt;/pr&gt;\n\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t&lt;pc padding=&apos;20px&apos; bgColor=&apos;#EFF6FF&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos; cornerRadius=&apos;14px&apos; borderColor=&apos;#93C5FD&apos; borderWidth=&apos;1px&apos;&gt;\n\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t\t\t&lt;pc width=&apos;18%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;center&apos; vAlign=&apos;middle&apos;&gt;&lt;image margin=&apos;0px&apos; color=&apos;#1D4ED8&apos; bgColor=&apos;#DBEAFE&apos; width=&apos;52px&apos; height=&apos;52px&apos; type=&apos;icon&apos; value=&apos;zc-li-outline arrows-1-refresh-69&apos; size=&apos;25px&apos; cornerRadius=&apos;26px&apos;/&gt;&lt;/pc&gt;\n\t\t\t\t&lt;pc padding=&apos;5px&apos; width=&apos;82%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#1E40AF&apos; size=&apos;16px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;Partial Match&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc width=&apos;45%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;30px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=partialCount%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#5D6B82&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoices&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;pc width=&apos;55%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;right&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;22px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=partialTotal%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#5D6B82&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoice total&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t&lt;/pc&gt;\n\t\t\t&lt;/pr&gt;\n\t\t&lt;/pc&gt;\n\t&lt;/pr&gt;\n\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t&lt;pc padding=&apos;20px&apos; bgColor=&apos;#ECFDF5&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos; cornerRadius=&apos;14px&apos; borderColor=&apos;#86EFAC&apos; borderWidth=&apos;1px&apos;&gt;\n\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t\t\t&lt;pc width=&apos;18%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;center&apos; vAlign=&apos;middle&apos;&gt;&lt;image margin=&apos;0px&apos; color=&apos;#047857&apos; bgColor=&apos;#D1FAE5&apos; width=&apos;52px&apos; height=&apos;52px&apos; type=&apos;icon&apos; value=&apos;zc-li-outline ui-1-check-circle-08&apos; size=&apos;25px&apos; cornerRadius=&apos;26px&apos;/&gt;&lt;/pc&gt;\n\t\t\t\t&lt;pc padding=&apos;5px&apos; width=&apos;82%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#047857&apos; size=&apos;16px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;Matched&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc width=&apos;45%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;30px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=matchedCount%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#587064&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoices&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;pc width=&apos;55%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;right&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;22px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=matchedTotal%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#587064&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoice total&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t&lt;/pc&gt;\n\t\t\t&lt;/pr&gt;\n\t\t&lt;/pc&gt;\n\t&lt;/pr&gt;\n\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t&lt;pc padding=&apos;20px&apos; bgColor=&apos;#FFF1F2&apos; width=&apos;100%&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos; cornerRadius=&apos;14px&apos; borderColor=&apos;#FDA4AF&apos; borderWidth=&apos;1px&apos;&gt;\n\t\t\t&lt;pr width=&apos;fill&apos; height=&apos;auto&apos;&gt;\n\t\t\t\t&lt;pc width=&apos;18%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;center&apos; vAlign=&apos;middle&apos;&gt;&lt;image margin=&apos;0px&apos; color=&apos;#BE123C&apos; bgColor=&apos;#FFE4E6&apos; width=&apos;52px&apos; height=&apos;52px&apos; type=&apos;icon&apos; value=&apos;zc-li-outline ui-1-alert-circle&apos; size=&apos;25px&apos; cornerRadius=&apos;26px&apos;/&gt;&lt;/pc&gt;\n\t\t\t\t&lt;pc padding=&apos;5px&apos; width=&apos;82%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos; vAlign=&apos;middle&apos;&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text margin=&apos;0px&apos; padding=&apos;0px&apos; color=&apos;#BE123C&apos; size=&apos;16px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;Exception&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t\t&lt;pr&gt;&lt;pc width=&apos;45%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;left&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;30px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=exceptionCount%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#775A62&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoices&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;pc width=&apos;55%&apos; bgColor=&apos;transparent&apos; hAlign=&apos;right&apos;&gt;&lt;text marginTop=&apos;8px&apos; padding=&apos;0px&apos; color=&apos;#172033&apos; size=&apos;22px&apos; bold=&apos;true&apos; type=&apos;Text&apos; value=&apos;&lt;%=exceptionTotal%&gt;&apos;&gt; &lt;/text&gt;&lt;text marginLeft=&apos;6px&apos; padding=&apos;0px&apos; color=&apos;#775A62&apos; size=&apos;13px&apos; type=&apos;Text&apos; value=&apos;invoice total&apos;&gt; &lt;/text&gt;&lt;/pc&gt;&lt;/pr&gt;\n\t\t\t\t&lt;/pc&gt;\n\t\t\t&lt;/pr&gt;\n\t\t&lt;/pc&gt;\n\t&lt;/pr&gt;\n&lt;/panel&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dspZml>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Purchase_Finance_Dashboard
		{
					displayname = "Purchase Finance Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Purchase_Finance_Dashboard_UI' elementName='Purchase_Finance_Dashboard_UI'>\n\t\t\t\t\t<![CDATA[htmlpage Purchase_Finance_Dashboard_UI()\ncontent\n&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\nmanagerPending = Purchase_Requests[Status == &quot;Pending Manager Approval&quot;].count();\nfinancePending = Purchase_Requests[Status == &quot;Pending Finance Approval&quot;].count();\nopenPOs = Purchase_Requests[Status == &quot;PO Issued&quot; || Status == &quot;Partially Invoiced&quot; || Status == &quot;Match Exception&quot;];\nopenPOValue = ifnull(openPOs.sum(PO_Total),0);\nremainingValue = ifnull(openPOs.sum(Remaining_To_Invoice),0);\nexceptions = Invoices[Match_Status == &quot;Exception&quot;];\nexceptionCount = exceptions.count();\nmatchedInvoiceValue = ifnull(Invoices[Match_Status == &quot;Matched&quot;].sum(Invoice_Total),0);\nallRequests = Purchase_Requests[ID != 0];\nallRequestCount = allRequests.count();\nissuedCount = Purchase_Requests[PO_Number is not null].count();\nmatchedCount = Invoices[Match_Status == &quot;Matched&quot;].count();\nstatusTotal = managerPending + financePending + issuedCount + exceptionCount + matchedCount;\nif(statusTotal == 0)\n{\n statusTotal = 1;\n}\nmanagerPct = (managerPending * 100.0 / statusTotal).round(1);\nfinancePct = (financePending * 100.0 / statusTotal).round(1);\nissuedPct = (issuedCount * 100.0 / statusTotal).round(1);\nexceptionPct = (exceptionCount * 100.0 / statusTotal).round(1);\nmatchedPct = (matchedCount * 100.0 / statusTotal).round(1);\ntrendRows = List();\ntrendMax = 1;\nfor each offset in {5,4,3,2,1,0}\n{\n monthStart = zoho.currentdate.addMonth(0 - offset).toStartOfMonth();\n monthEnd = monthStart.addMonth(1).addDay(-1);\n requestedAmount = ifnull(Purchase_Requests[Request_Date &gt;= monthStart &amp;&amp; Request_Date &lt;= monthEnd].sum(Request_Total),0);\n invoicedAmount = ifnull(Invoices[Invoice_Date &gt;= monthStart &amp;&amp; Invoice_Date &lt;= monthEnd].sum(Invoice_Total),0);\n if(requestedAmount &gt; trendMax)\n {\n\ttrendMax = requestedAmount;\n }\n if(invoicedAmount &gt; trendMax)\n {\n\ttrendMax = invoicedAmount;\n }\n trendRows.add({&quot;label&quot;:monthStart.toString(&quot;MMM&quot;),&quot;requested&quot;:requestedAmount,&quot;invoiced&quot;:invoicedAmount});\n}\nvendorRows = List();\nfor each vendor in Vendors[Active == true]\n{\n vendorPOValue = ifnull(Purchase_Requests[Vendor == vendor.ID &amp;&amp; PO_Number is not null].sum(PO_Total),0);\n if(vendorPOValue &gt; 0)\n {\n\tvendorRows.add({&quot;name&quot;:vendor.Vendor_Name,&quot;value&quot;:vendorPOValue});\n }\n}\nvendorRows.sort(false);\nrecentLogs = Audit_Log[ID != 0] sort by Event_Time desc range from 0 to 5;\nexceptionRows = Invoices[Match_Status == &quot;Exception&quot;] sort by Invoice_Date asc range from 0 to 7;\n%&gt;\n&lt;style&gt;\n/* zcs-global.css: included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-surface:#fff;--zcs-bg:#f4f6f8;--zcs-text-1:var(--zcs_primary_text_color);--zcs-text-2:var(--zcs_secondary_text_color);--zcs-text-3:var(--zcs_tertiary_text_color);--zcs-radius:12px;--zcs-shadow:0 2px 12px rgba(20,25,40,.07)}\n.zcs-flex{display:flex}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-color-blue{color:#09598e}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#b8770d}.zcs-page{font-family:var(--zcs-font,Arial,sans-serif);background:var(--zcs-bg);min-height:100vh;padding:24px;box-sizing:border-box;color:var(--zcs-text-1)}\n.zcs-page-header{margin-bottom:24px}.zcs-page-header__title{font-size:22px;font-weight:600;color:var(--zcs-text-1);margin:0 0 4px}.zcs-page-header__sub{font-size:14px;color:var(--zcs-text-2);margin:0}.pf-date{font-size:13px;color:var(--zcs-text-2);white-space:nowrap}.zcs-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin-bottom:24px}.zcs-kpi-card{background:var(--zcs-surface);border-radius:var(--zcs-radius);box-shadow:var(--zcs-shadow);padding:20px 24px}.zcs-kpi-card__label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--zcs-text-2)}.zcs-kpi-card__value{font-size:30px;font-weight:700;margin:6px 0 4px;line-height:1}.zcs-kpi-card__sub{font-size:12px;color:var(--zcs-text-3)}\n.pf-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px;margin-bottom:16px}.pf-card{background:var(--zcs-surface);border:1px solid var(--zcs-border-color);border-radius:12px;padding:18px;box-shadow:var(--zcs-shadow);box-sizing:border-box}.pf-card h2{font-size:16px;margin:0 0 16px}.pf-span-4{grid-column:span 4}.pf-span-5{grid-column:span 5}.pf-span-7{grid-column:span 7}.pf-span-8{grid-column:span 8}.pf-span-12{grid-column:span 12}\n.pf-donut{width:170px;height:170px;border-radius:50%;margin:auto;background:conic-gradient(#f0b429 0 &lt;%=managerPct%&gt;%,#2a6ffc &lt;%=managerPct%&gt;% &lt;%=managerPct + financePct%&gt;%,#1094c5 &lt;%=managerPct + financePct%&gt;% &lt;%=managerPct + financePct + issuedPct%&gt;%,#fe455d &lt;%=managerPct + financePct + issuedPct%&gt;% &lt;%=managerPct + financePct + issuedPct + exceptionPct%&gt;%,#179e6c &lt;%=managerPct + financePct + issuedPct + exceptionPct%&gt;% 100%);display:grid;place-items:center}.pf-donut:after{content:&apos;&lt;%=statusTotal%&gt;&apos;;width:105px;height:105px;background:#fff;border-radius:50%;display:grid;place-items:center;font-size:25px;font-weight:700}.pf-legend{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:15px;font-size:12px;color:var(--zcs-text-2)}.pf-dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:6px}.pf-trend{height:220px;display:flex;align-items:flex-end;gap:12px;border-bottom:1px solid var(--zcs-border-color);padding:12px 6px 0}.pf-month{height:100%;flex:1;display:flex;align-items:flex-end;justify-content:center;gap:4px;position:relative}.pf-bar{width:18px;min-height:2px;border-radius:5px 5px 0 0}.pf-requested{background:var(--zcs_brand_color)}.pf-invoiced{background:#179e6c}.pf-month-label{position:absolute;bottom:-24px;font-size:11px;color:var(--zcs-text-2)}.pf-chart-legend{margin:30px 0 0;font-size:12px;color:var(--zcs-text-2)}\n.pf-vendor{margin:12px 0}.pf-vendor-head{display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px}.pf-track{height:8px;background:#edf0f4;border-radius:10px;overflow:hidden}.pf-fill{height:100%;background:var(--zcs_brand_color);border-radius:10px}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);border-radius:6px;background:#fff;overflow:auto}.zcs-table-wrapper table{width:100%;border-collapse:collapse}.zcs-table-wrapper th{background:#f9fafe;font-size:12px;text-align:left;padding:10px 14px;white-space:nowrap}.zcs-table-wrapper td{border-top:1px solid var(--zcs-border-color);font-size:13px;padding:11px 14px}.zcs-badge{display:inline-flex;padding:3px 8px;border-radius:10px;font-size:11px;font-weight:600}.pf-danger{background:#fff0f2;color:#b42335}.pf-warning{background:#fff5df;color:#8c5a00}.pf-neutral{background:#edf4ff;color:#09598e}\n.zcs-timeline-wrapper ul,.zcs-quick-actions-wrapper ul{list-style:none;padding:0;margin:0}.zcs-tl-li{position:relative;padding:0 0 16px 20px;border-left:1px solid var(--zcs-border-color)}.zcs-tl-li:before{content:&apos;&apos;;position:absolute;left:-5px;top:3px;width:9px;height:9px;border-radius:50%;background:var(--zcs_brand_color)}.pf-log-title{font-size:13px;font-weight:600}.pf-log-meta{font-size:11px;color:var(--zcs-text-2);margin-top:3px}.zcs-quick-actions-wrapper{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}.zcs-quick-action-item{list-style:none;border:1px solid var(--zcs-border-color);border-radius:10px}.zcs-quick-action-link{display:flex;align-items:center;gap:9px;padding:12px;color:var(--zcs-text-1);font-size:13px;text-decoration:none}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover a{color:var(--zcs_brand_color)}\n@media(max-width:900px){.pf-span-4,.pf-span-5,.pf-span-7,.pf-span-8{grid-column:span 12}.pf-head{align-items:flex-start;gap:12px}.pf-date{white-space:normal}}@media(max-width:600px){.zcs-page{padding:14px}.pf-legend{grid-template-columns:1fr}.pf-bar{width:10px}.zcs-page-header__title{font-size:19px}}\n&lt;/style&gt;\n&lt;div class=&quot;zcs-page&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header pf-head zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;\n\t\t&lt;div&gt;&lt;h1 class=&quot;zcs-page-header__title&quot;&gt;Purchase Finance Dashboard&lt;/h1&gt;&lt;p class=&quot;zcs-page-header__sub&quot;&gt;Track requests through approval, PO issue, invoice capture and three-way match resolution.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;pf-date&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt; &lt;%=zoho.currentdate.toString(&quot;dd MMM yyyy&quot;)%&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;zcs-kpi-grid&quot;&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Pending Manager Approval&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value zcs-color-yellow&quot;&gt;&lt;%=managerPending%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Awaiting operational approval&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Pending Finance Approval&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value zcs-color-blue&quot;&gt;&lt;%=financePending%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Awaiting budget validation&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Open PO Value&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value zcs-color-blue&quot;&gt;&lt;%=openPOValue.round(2)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Issued and not fully closed&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Remaining to Invoice&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value zcs-color-yellow&quot;&gt;&lt;%=remainingValue.round(2)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Open PO commitment&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Match Exceptions&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value zcs-color-red&quot;&gt;&lt;%=exceptionCount%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Require finance review&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Matched Invoice Value&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value zcs-color-green&quot;&gt;&lt;%=matchedInvoiceValue.round(2)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Successfully matched&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;pf-grid&quot;&gt;\n\t\t&lt;section class=&quot;pf-card pf-span-4&quot;&gt;&lt;h2&gt;Status distribution&lt;/h2&gt;&lt;div class=&quot;pf-donut&quot;&gt;&lt;/div&gt;&lt;div class=&quot;pf-legend&quot;&gt;&lt;span&gt;&lt;i class=&quot;pf-dot&quot; style=&quot;background:#f0b429&quot;&gt;&lt;/i&gt;Manager &lt;%=managerPending%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;pf-dot&quot; style=&quot;background:#2a6ffc&quot;&gt;&lt;/i&gt;Finance &lt;%=financePending%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;pf-dot&quot; style=&quot;background:#1094c5&quot;&gt;&lt;/i&gt;PO issued &lt;%=issuedCount%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;pf-dot&quot; style=&quot;background:#fe455d&quot;&gt;&lt;/i&gt;Exception &lt;%=exceptionCount%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;pf-dot&quot; style=&quot;background:#179e6c&quot;&gt;&lt;/i&gt;Matched &lt;%=matchedCount%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/section&gt;\n\t\t&lt;section class=&quot;pf-card pf-span-8&quot;&gt;&lt;h2&gt;Monthly requested vs invoiced&lt;/h2&gt;&lt;div class=&quot;pf-trend&quot;&gt;&lt;% for each trend in trendRows { requestedHeight = (trend.get(&quot;requested&quot;) * 100.0 / trendMax).round(0); invoicedHeight = (trend.get(&quot;invoiced&quot;) * 100.0 / trendMax).round(0); %&gt;&lt;div class=&quot;pf-month&quot;&gt;&lt;div class=&quot;pf-bar pf-requested&quot; style=&quot;height:&lt;%=requestedHeight%&gt;%&quot; title=&quot;Requested &lt;%=trend.get(&quot;requested&quot;)%&gt;&quot;&gt;&lt;/div&gt;&lt;div class=&quot;pf-bar pf-invoiced&quot; style=&quot;height:&lt;%=invoicedHeight%&gt;%&quot; title=&quot;Invoiced &lt;%=trend.get(&quot;invoiced&quot;)%&gt;&quot;&gt;&lt;/div&gt;&lt;span class=&quot;pf-month-label&quot;&gt;&lt;%=trend.get(&quot;label&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;% } %&gt;&lt;/div&gt;&lt;div class=&quot;pf-chart-legend&quot;&gt;&lt;i class=&quot;pf-dot&quot; style=&quot;background:var(--zcs_brand_color)&quot;&gt;&lt;/i&gt;Requested value &amp;nbsp; &lt;i class=&quot;pf-dot&quot; style=&quot;background:#179e6c&quot;&gt;&lt;/i&gt;Invoiced value&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;pf-grid&quot;&gt;\n\t\t&lt;section class=&quot;pf-card pf-span-5&quot;&gt;&lt;h2&gt;Top vendors by PO value&lt;/h2&gt;&lt;% vendorIndex = 0; topVendorValue = 1; if(vendorRows.size() &gt; 0){ topVendorValue = vendorRows.get(0).get(&quot;value&quot;); } for each vendorRow in vendorRows { if(vendorIndex &lt; 5){ vendorWidth = (vendorRow.get(&quot;value&quot;) * 100.0 / topVendorValue).round(0); %&gt;&lt;div class=&quot;pf-vendor&quot;&gt;&lt;div class=&quot;pf-vendor-head&quot;&gt;&lt;span&gt;&lt;%=vendorRow.get(&quot;name&quot;)%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=vendorRow.get(&quot;value&quot;).round(2)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;pf-track&quot;&gt;&lt;div class=&quot;pf-fill&quot; style=&quot;width:&lt;%=vendorWidth%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } vendorIndex = vendorIndex + 1; } if(vendorRows.size() == 0){ %&gt;&lt;p class=&quot;zcs-page-header__sub&quot;&gt;No issued purchase orders yet.&lt;/p&gt;&lt;% } %&gt;&lt;/section&gt;\n\t\t&lt;section class=&quot;pf-card pf-span-7&quot;&gt;&lt;h2&gt;Recent activity&lt;/h2&gt;&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;&lt;ul&gt;&lt;% for each log in recentLogs { %&gt;&lt;li class=&quot;zcs-tl-li&quot;&gt;&lt;div class=&quot;pf-log-title&quot;&gt;&lt;%=log.Action%&gt; · &lt;%=log.Reference_Number%&gt;&lt;/div&gt;&lt;div class=&quot;pf-log-meta&quot;&gt;&lt;%=log.Component%&gt; by &lt;%=log.User_Email%&gt; · &lt;%=log.Event_Time.toString(&quot;dd MMM, HH:mm&quot;)%&gt;&lt;/div&gt;&lt;/li&gt;&lt;% } %&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;/div&gt;\n\t&lt;section class=&quot;pf-card&quot; style=&quot;margin-bottom:16px&quot;&gt;&lt;h2&gt;Exception queue&lt;/h2&gt;&lt;div class=&quot;zcs-table-wrapper&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Invoice&lt;/th&gt;&lt;th&gt;PO&lt;/th&gt;&lt;th&gt;Vendor&lt;/th&gt;&lt;th&gt;Variance&lt;/th&gt;&lt;th&gt;Age&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;% for each inv in exceptionRows { ageDays = inv.Invoice_Date.daysBetween(zoho.currentdate); ageClass = &quot;pf-neutral&quot;; ageLabel = &quot;New&quot;; if(ageDays &gt; 14){ageClass=&quot;pf-danger&quot;;ageLabel=&quot;Overdue&quot;;} else if(ageDays &gt; 7){ageClass=&quot;pf-warning&quot;;ageLabel=&quot;Aging&quot;;} %&gt;&lt;tr&gt;&lt;td&gt;&lt;%=inv.Invoice_Number%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=inv.Purchase_Order.PO_Number%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=inv.Vendor.Vendor_Name%&gt;&lt;/td&gt;&lt;td&gt;&lt;%=ifnull(inv.Amount_Variance,0).round(2)%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&quot;zcs-badge &lt;%=ageClass%&gt;&quot;&gt;&lt;%=ageDays%&gt; days&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&quot;zcs-badge pf-danger&quot;&gt;&lt;%=ageLabel%&gt; · Exception&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;% } if(exceptionCount == 0){ %&gt;&lt;tr&gt;&lt;td colspan=&quot;6&quot;&gt;No match exceptions are currently open.&lt;/td&gt;&lt;/tr&gt;&lt;% } %&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/section&gt;\n\t&lt;section class=&quot;pf-card&quot;&gt;&lt;h2&gt;Quick links&lt;/h2&gt;&lt;div class=&quot;zcs-quick-actions-wrapper&quot;&gt;\n\t\t&lt;div class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link&quot; href=&quot;#Form:Purchase_Requests&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span&gt;Create purchase request&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link&quot; href=&quot;#Report:Purchase_Approval_Queue&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Manager approval queue&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link&quot; href=&quot;#Report:Finance_Approval_Queue&quot;&gt;&lt;i class=&quot;zc-li-outline business-coins&quot;&gt;&lt;/i&gt;&lt;span&gt;Finance approval queue&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link&quot; href=&quot;#Report:Purchase_Order_Register&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span&gt;PO register&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link&quot; href=&quot;#Form:Invoices&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-file-add&quot;&gt;&lt;/i&gt;&lt;span&gt;Invoice entry&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link&quot; href=&quot;#Report:Match_Exceptions&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span&gt;Match exceptions&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t&lt;/div&gt;&lt;/section&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Invoice_Line_Catalog_Item_On_User_Input as "Invoice Line Catalog Item On User Input"
			{
			    type = form
			    form = Invoice_Lines
			    record event = on add or edit
			
			    on user input of Catalog_Item
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Catalog_Item != null)
			                {
			                    catalog_item = Vendor_Items[ID == input.Catalog_Item];
			                    input.Description = catalog_item.Item_Description;
			                    input.Unit_Price = catalog_item.Unit_Price;
			                    input.Tax_Rate = ifNull(catalog_item.Tax_Rate, 0);
			                }
			            )
			        }
			    }
			}

			Invoice_Lines_On_Validate as "Invoice Lines On Validate"
			{
			    type = form
			    form = Invoice_Lines
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Invoiced_Quantity == null || input.Invoiced_Quantity <= 0)
			                {
			                    alert(Invoiced_Quantity, "Invoiced quantity must be greater than zero.");
			                    cancel submit;
			                }
			                if(input.Unit_Price == null || input.Unit_Price < 0)
			                {
			                    alert(Unit_Price, "Unit price cannot be negative.");
			                    cancel submit;
			                }
			                if(input.Tax_Rate != null && input.Tax_Rate < 0)
			                {
			                    alert(Tax_Rate, "Tax rate cannot be negative.");
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Purchase_Order_On_User_Input as "Purchase Order On User Input"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on user input of Purchase_Order
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Vendor = null;
			                input.Invoice_Lines.clear();
			                if(input.Purchase_Order != null)
			                {
			                    poRecord = Purchase_Requests[ID == input.Purchase_Order];
			                    if(poRecord.ID != null)
			                    {
			                        input.Vendor = poRecord.Vendor;
			                        alert "Remaining PO amount: " + ifnull(poRecord.Remaining_To_Invoice,poRecord.PO_Total);
			                    }
			                }
			            )
			        }
			    }
			}

			Invoices_On_Load as "Invoices On Load"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Match_Status, Amount_Variance, Exception_Details, Matched_On, Matched_By;
			                profileName = thisapp.permissions.loginUserProfile();
			                if(profileName == "Finance" || profileName == "Procurement_Admin")
			                {
			                    enable Match_Status, Amount_Variance, Exception_Details, Matched_On, Matched_By;
			                }
			            )
			        }
			    }
			}

			Invoices_On_Success as "Invoices On Success"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                poRecord = Purchase_Requests[ID == input.Purchase_Order];
			                priorTotal = Invoices[Purchase_Order == input.Purchase_Order && Match_Status != "Exception" && ID != input.ID].sum(Invoice_Total);
			                priorTotal = ifnull(priorTotal,0);
			                cumulativeTotal = priorTotal + ifnull(input.Invoice_Total,0);
			                varianceValue = cumulativeTotal - ifnull(poRecord.PO_Total,0);
			                exceptionText = ifnull(input.Exception_Details,"");
			                hasException = exceptionText != "";
			                allQuantitiesSatisfied = true;
			
			                for each poLine in poRecord.Requested_Items
			                {
			                    orderedQty = ifnull(poLine.Quantity,0);
			                    billedQty = 0.0;
			                    relatedInvoices = Invoices[Purchase_Order == input.Purchase_Order && ID != input.ID];
			                    for each relatedInvoice in relatedInvoices
			                    {
			                        if(relatedInvoice.Match_Status != "Exception")
			                        {
			                            for each relatedLine in relatedInvoice.Invoice_Lines
			                            {
			                                if(relatedLine.Catalog_Item == poLine.Catalog_Item)
			                                {
			                                    billedQty = billedQty + ifnull(relatedLine.Invoiced_Quantity,0);
			                                }
			                            }
			                        }
			                    }
			                    for each currentLine in input.Invoice_Lines
			                    {
			                        if(currentLine.Catalog_Item == poLine.Catalog_Item)
			                        {
			                            billedQty = billedQty + ifnull(currentLine.Invoiced_Quantity,0);
			                        }
			                    }
			                    if(billedQty - orderedQty > 0.01 || orderedQty - billedQty > 0.01)
			                    {
			                        allQuantitiesSatisfied = false;
			                    }
			                }
			
			                matchStatusValue = "Partial Match";
			                poStatusValue = "Partially Invoiced";
			                if(hasException || varianceValue > 0.01 || (varianceValue < -0.01 && allQuantitiesSatisfied))
			                {
			                    matchStatusValue = "Exception";
			                    poStatusValue = "Match Exception";
			                    if(exceptionText == "")
			                    {
			                        exceptionText = "Cumulative invoice total or line-level match differs from the PO.";
			                    }
			                }
			                else if(allQuantitiesSatisfied && varianceValue <= 0.01 && varianceValue >= -0.01)
			                {
			                    matchStatusValue = "Matched";
			                    poStatusValue = "Matched";
			                }
			
			                update Invoices[ID == input.ID]
			                [
			                    Match_Status = matchStatusValue
			                    Amount_Variance = varianceValue
			                    Exception_Details = exceptionText
			                    Matched_On = zoho.currentdate
			                    Matched_By = zoho.loginuser
			                ];
			                acceptedTotal = cumulativeTotal;
			                if(matchStatusValue == "Exception")
			                {
			                    acceptedTotal = priorTotal;
			                }
			                remainingValue = ifnull(poRecord.PO_Total,0) - acceptedTotal;
			                update Purchase_Requests[ID == input.Purchase_Order]
			                [
			                    Invoiced_Total = acceptedTotal
			                    Remaining_To_Invoice = remainingValue
			                    Last_Match_Date = zoho.currentdate
			                    Status = poStatusValue
			                ];
			
			                profileName = thisapp.permissions.loginUserProfile();
			                captureAuditId = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    User_Email = zoho.loginuserid
			                    User_Profile = profileName
			                    Action = "Invoice Captured"
			                    Component = "Invoices"
			                    Record_ID = input.ID
			                    Reference_Number = input.Invoice_Number
			                    After_Value = "Total: " + input.Invoice_Total
			                    Notes = "Invoice captured against PO " + poRecord.PO_Number
			                ];
			                matchAuditId = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    User_Email = zoho.loginuserid
			                    User_Profile = profileName
			                    Action = "Invoice Match Result"
			                    Component = "Invoices"
			                    Record_ID = input.ID
			                    Reference_Number = input.Invoice_Number
			                    After_Value = "Status: " + matchStatusValue + ", Variance: " + varianceValue
			                    Notes = exceptionText
			                ];
			            )
			        }
			    }
			}

			Invoices_On_Validate as "Invoices On Validate"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                duplicateInvoices = Invoices[Invoice_Number == input.Invoice_Number && Vendor == input.Vendor && ID != input.ID];
			                if(duplicateInvoices.count() > 0)
			                {
			                    alert "This invoice number already exists for the selected vendor.";
			                    cancel submit;
			                }
			                poRecord = Purchase_Requests[ID == input.Purchase_Order];
			                if(poRecord.ID == null)
			                {
			                    alert "Select a valid issued purchase order.";
			                    cancel submit;
			                }
			                if(input.Vendor != poRecord.Vendor)
			                {
			                    alert "Invoice vendor must match the purchase order vendor.";
			                    cancel submit;
			                }
			                if(input.Invoice_Lines == null || input.Invoice_Lines.isEmpty())
			                {
			                    alert "Add at least one invoice line.";
			                    cancel submit;
			                }
			
			                subtotalValue = 0.0;
			                taxValue = 0.0;
			                exceptionText = "";
			                for each invoiceLine in input.Invoice_Lines
			                {
			                    if(invoiceLine.Catalog_Item == null || invoiceLine.Invoiced_Quantity == null || invoiceLine.Invoiced_Quantity <= 0)
			                    {
			                        alert "Every invoice line requires an item and positive quantity.";
			                        cancel submit;
			                    }
			                    lineSubtotalValue = invoiceLine.Invoiced_Quantity * ifnull(invoiceLine.Unit_Price,0);
			                    lineTaxValue = lineSubtotalValue * ifnull(invoiceLine.Tax_Rate,0) / 100;
			                    subtotalValue = subtotalValue + lineSubtotalValue;
			                    taxValue = taxValue + lineTaxValue;
			
			                    orderedQty = 0.0;
			                    expectedPrice = 0.0;
			                    expectedTax = 0.0;
			                    itemFoundOnPO = false;
			                    for each poLine in poRecord.Requested_Items
			                    {
			                        if(poLine.Catalog_Item == invoiceLine.Catalog_Item)
			                        {
			                            itemFoundOnPO = true;
			                            orderedQty = orderedQty + ifnull(poLine.Quantity,0);
			                            expectedPrice = ifnull(poLine.Unit_Price,0);
			                            expectedTax = ifnull(poLine.Tax_Rate,0);
			                        }
			                    }
			                    priorQty = 0.0;
			                    priorInvoices = Invoices[Purchase_Order == input.Purchase_Order && Match_Status != "Exception" && ID != input.ID];
			                    for each priorInvoice in priorInvoices
			                    {
			                        for each priorLine in priorInvoice.Invoice_Lines
			                        {
			                            if(priorLine.Catalog_Item == invoiceLine.Catalog_Item)
			                            {
			                                priorQty = priorQty + ifnull(priorLine.Invoiced_Quantity,0);
			                            }
			                        }
			                    }
			                    if(!itemFoundOnPO)
			                    {
			                        exceptionText = exceptionText + "Item not present on PO; ";
			                    }
			                    if(priorQty + invoiceLine.Invoiced_Quantity > orderedQty + 0.01)
			                    {
			                        exceptionText = exceptionText + "Quantity exceeds remaining PO quantity; ";
			                    }
			                    if(itemFoundOnPO && (ifnull(invoiceLine.Unit_Price,0) - expectedPrice > 0.01 || ifnull(invoiceLine.Unit_Price,0) - expectedPrice < -0.01))
			                    {
			                        exceptionText = exceptionText + "Unit price differs from PO; ";
			                    }
			                    if(itemFoundOnPO && (ifnull(invoiceLine.Tax_Rate,0) - expectedTax > 0.01 || ifnull(invoiceLine.Tax_Rate,0) - expectedTax < -0.01))
			                    {
			                        exceptionText = exceptionText + "Tax rate differs from PO; ";
			                    }
			                }
			                input.Invoice_Subtotal = subtotalValue;
			                input.Invoice_Tax = taxValue;
			                input.Invoice_Total = subtotalValue + taxValue;
			                priorTotal = Invoices[Purchase_Order == input.Purchase_Order && Match_Status != "Exception" && ID != input.ID].sum(Invoice_Total);
			                priorTotal = ifnull(priorTotal,0);
			                cumulativeTotal = priorTotal + input.Invoice_Total;
			                input.Amount_Variance = cumulativeTotal - ifnull(poRecord.PO_Total,0);
			                if(cumulativeTotal > ifnull(poRecord.PO_Total,0) + 0.01)
			                {
			                    exceptionText = exceptionText + "Cumulative invoice total exceeds PO total; ";
			                }
			                input.Match_Status = "Pending Match";
			                input.Exception_Details = exceptionText;
			            )
			        }
			    }
			}

			Catalog_Item_On_User_Input as "Catalog Item On User Input"
			{
			    type = form
			    form = Purchase_Request_Lines
			    record event = on add or edit
			
			    on user input of Catalog_Item
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Catalog_Item != null)
			                {
			                    catalog_item = Vendor_Items[ID == input.Catalog_Item];
			                    input.Item_Description = catalog_item.Item_Description;
			                    input.Unit_Of_Measure = catalog_item.Unit_Of_Measure;
			                    input.Unit_Price = catalog_item.Unit_Price;
			                    input.Tax_Rate = catalog_item.Tax_Rate;
			                }
			                else
			                {
			                    input.Item_Description = null;
			                    input.Unit_Of_Measure = null;
			                    input.Unit_Price = null;
			                    input.Tax_Rate = 0;
			                }
			            )
			        }
			    }
			}

			Purchase_Request_Lines_On_Validate as "Purchase Request Lines On Validate"
			{
			    type = form
			    form = Purchase_Request_Lines
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Quantity <= 0)
			                {
			                    alert(Quantity, "Quantity must be greater than zero.");
			                    cancel submit;
			                }
			                if(input.Unit_Price < 0)
			                {
			                    alert(Unit_Price, "Unit Price cannot be negative.");
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Vendor_On_User_Input as "Vendor On User Input"
			{
			    type = form
			    form = Purchase_Requests
			    record event = on add or edit
			
			    on user input of Vendor
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Requested_Items.clear();
			            )
			        }
			    }
			}

			Purchase_Requests_On_Load as "Purchase Requests On Load"
			{
			    type = form
			    form = Purchase_Requests
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                profileName = thisapp.permissions.loginUserProfile();
			                if(input.Requester == null)
			                {
			                    input.Requester = zoho.loginuser;
			                }
			                hide Rejection_Reason;
			                disable Status, Subtotal, Tax_Total, Request_Total, PO_Number, PO_Date, PO_Total, Invoiced_Total, Remaining_To_Invoice, Last_Match_Date;
			                if(input.Status == "Rejected")
			                {
			                    show Rejection_Reason;
			                }
			                if(profileName == "Employee")
			                {
			                    disable Requester;
			                    if(input.Status != null && input.Status != "Draft")
			                    {
			                        disable Department, Request_Date, Needed_By, Vendor, Assigned_Approver, Business_Justification, Quote_Attachment;
			                        hide Requested_Items;
			                    }
			                }
			                if(profileName == "Finance" || profileName == "Procurement_Admin")
			                {
			                    enable Rejection_Reason, PO_Number, PO_Date, PO_Total, Invoiced_Total, Remaining_To_Invoice, Last_Match_Date;
			                }
			            )
			        }
			    }
			}

			Purchase_Requests_On_Success as "Purchase Requests On Success"
			{
			    type = form
			    form = Purchase_Requests
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                actionName = "Purchase Request Updated";
			                if(input.Added_Time == input.Modified_Time)
			                {
			                    actionName = "Purchase Request Created";
			                }
			                profileName = thisapp.permissions.loginUserProfile();
			                auditId = insert into Audit_Log
			                [
			                    Event_Time = zoho.currenttime
			                    User_Email = zoho.loginuserid
			                    User_Profile = profileName
			                    Action = actionName
			                    Component = "Purchase_Requests"
			                    Record_ID = input.ID
			                    Reference_Number = input.Request_Number.toString()
			                    After_Value = "Status: " + input.Status + ", Total: " + input.Request_Total
			                    Notes = "Purchase request saved."
			                ];
			            )
			        }
			    }
			}

			Purchase_Requests_On_Validate as "Purchase Requests On Validate"
			{
			    type = form
			    form = Purchase_Requests
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Needed_By < input.Request_Date)
			                {
			                    alert "Needed By must be on or after the Request Date.";
			                    cancel submit;
			                }
			                if(input.Requested_Items == null || input.Requested_Items.isEmpty())
			                {
			                    alert "Add at least one requested item.";
			                    cancel submit;
			                }
			                subtotalValue = 0.0;
			                taxValue = 0.0;
			                for each line in input.Requested_Items
			                {
			                    if(line.Catalog_Item == null)
			                    {
			                        alert "Every requested line must have a catalog item.";
			                        cancel submit;
			                    }
			                    catalogRecord = Vendor_Items[ID == line.Catalog_Item];
			                    if(catalogRecord.ID == null || catalogRecord.Active != true || catalogRecord.Vendor != input.Vendor)
			                    {
			                        alert "Every catalog item must be active and belong to the selected vendor.";
			                        cancel submit;
			                    }
			                    if(line.Quantity == null || line.Quantity <= 0)
			                    {
			                        alert "Every requested line must have a positive quantity.";
			                        cancel submit;
			                    }
			                    lineSubtotalValue = line.Quantity * line.Unit_Price;
			                    lineTaxValue = lineSubtotalValue * ifnull(line.Tax_Rate,0) / 100;
			                    subtotalValue = subtotalValue + lineSubtotalValue;
			                    taxValue = taxValue + lineTaxValue;
			                }
			                input.Subtotal = subtotalValue;
			                input.Tax_Total = taxValue;
			                input.Request_Total = subtotalValue + taxValue;
			            )
			        }
			    }
			}

			Vendor_Items_On_Validate as "Vendor Items On Validate"
			{
			    type = form
			    form = Vendor_Items
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Unit_Price < 0)
			                {
			                    alert(Unit_Price, "Unit Price must be zero or greater.");
			                    cancel submit;
			                }
			                if (input.Tax_Rate < 0)
			                {
			                    alert(Tax_Rate, "Tax Rate must be zero or greater.");
			                    cancel submit;
			                }
			                if (input.Effective_From != null && input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert(Effective_To, "Effective To cannot be before Effective From.");
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

		blueprint
		{
			Purchase_Request_Approval as "Purchase Request Approval"
			{
			    type = blueprint
			    form = Purchase_Requests
			
			    start
			    {
			        start stage = "Draft"
			    }
			
			    stages
			    {
			        "Draft" { }
			        "Pending Manager Approval" { }
			        "Pending Finance Approval" { }
			        "Rejected" { }
			        "PO Issued" { }
			        "Partially Invoiced" { }
			        "Matched" { }
			        "Match Exception" { }
			    }
			
			    transitions
			    {
			        Submit_Request as "Submit Request"
			        {
			            type = normal
			            from stage = "Draft"
			            to stage = "Pending Manager Approval"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Employee"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = thisapp.permissions.loginUserProfile()
			                            Action = "Submitted Request"
			                            Component = "Purchase_Requests"
			                            Record_ID = input.ID
			                            Reference_Number = input.Request_Number.toString()
			                            Notes = "Submitted for manager approval."
			                        ];
			                    )
			                }
			            }
			        }
			
			        Manager_Approve as "Manager Approve"
			        {
			            type = normal
			            from stage = "Pending Manager Approval"
			            to stage = "Pending Finance Approval"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Purchase_Approver"}
			                    userfields = {Assigned_Approver}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = thisapp.permissions.loginUserProfile()
			                            Action = "Manager Approved"
			                            Component = "Purchase_Requests"
			                            Record_ID = input.ID
			                            Reference_Number = input.Request_Number.toString()
			                            Notes = "Approved for Finance review."
			                        ];
			                    )
			                }
			            }
			        }
			
			        Manager_Reject as "Manager Reject"
			        {
			            type = normal
			            from stage = "Pending Manager Approval"
			            to stage = "Rejected"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Purchase_Approver"}
			                    userfields = {Assigned_Approver}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Rejection_Reason, Status]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = thisapp.permissions.loginUserProfile()
			                            Action = "Manager Rejected"
			                            Component = "Purchase_Requests"
			                            Record_ID = input.ID
			                            Reference_Number = input.Request_Number.toString()
			                            Notes = input.Rejection_Reason
			                        ];
			                    )
			                }
			            }
			        }
			
			        Finance_Issue_PO as "Finance Issue PO"
			        {
			            type = normal
			            from stage = "Pending Finance Approval"
			            to stage = "PO Issued"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Finance","Procurement_Admin"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        input.PO_Number = "PO-" + input.ID.toString();
			                        input.PO_Date = zoho.currentdate;
			                        input.PO_Total = input.Request_Total;
			                        input.Remaining_To_Invoice = input.PO_Total;
			                        insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = thisapp.permissions.loginUserProfile()
			                            Action = "PO Issued"
			                            Component = "Purchase_Requests"
			                            Record_ID = input.ID
			                            Reference_Number = input.PO_Number
			                            After_Value = "PO Total: " + input.PO_Total
			                            Notes = "Purchase order issued by Finance."
			                        ];
			                    )
			                }
			            }
			        }
			
			        Finance_Reject as "Finance Reject"
			        {
			            type = normal
			            from stage = "Pending Finance Approval"
			            to stage = "Rejected"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Finance","Procurement_Admin"}
			                )
			            }
			            during
			            {
			                action = update_fields
			                workflow status = true
			                visible fields = [Rejection_Reason, Status]
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                        insert into Audit_Log
			                        [
			                            Event_Time = zoho.currenttime
			                            User_Email = zoho.loginuserid
			                            User_Profile = thisapp.permissions.loginUserProfile()
			                            Action = "Finance Rejected"
			                            Component = "Purchase_Requests"
			                            Record_ID = input.ID
			                            Reference_Number = input.Request_Number.toString()
			                            Notes = input.Rejection_Reason
			                        ];
			                    )
			                }
			            }
			        }
			    }
			}
		}
	}

