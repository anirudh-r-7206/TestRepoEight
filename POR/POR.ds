application "POR"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Audit_Log
		{
		    displayname = "Audit Log"
		
		    Audit_Details
		    (
		        type = section
		        displayname = "Audit Details"
		        row = 1
		        column = 0
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have User_Email
		    (
		        type = email
		        displayname = "User Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    User_Profile
		    (
		        type = text
		        displayname = "User Profile"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Action
		    (
		        type = text
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Component
		    (
		        type = text
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Record_ID
		    (
		        type = number
		        displayname = "Record ID"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Reference_Number
		    (
		        type = text
		        displayname = "Reference Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Before_Value
		    (
		        type = textarea
		        displayname = "Before Value"
		        row = 1
		        column = 2
		        width = medium
		    )
		    After_Value
		    (
		        type = textarea
		        displayname = "After Value"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		        }
		    }
		}

		form Invoice_Lines
		{
		    title
		    {
		        displayname = "Invoice Lines"
		        on add = "Add Invoice Line"
		        on edit = "Edit Invoice Line"
		    }
		
		    Invoice_Line_Details
		    (
		        type = section
		        displayname = "Invoice Line Details"
		        row = 1
		        column = 0
		    )
		    must have Catalog_Item
		    (
		        type = picklist
		        displayname = "Catalog Item"
		        values = Vendor_Items.ID
		        displayformat = [Item_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Invoiced_Quantity
		    (
		        type = decimal
		        displayname = "Invoiced Quantity"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Unit_Price
		    (
		        type = decimal
		        displayname = "Unit Price"
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    Tax_Rate
		    (
		        type = decimal
		        displayname = "Tax Rate"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Line_Subtotal
		    (
		        type = formula
		        displayname = "Line Subtotal"
		        value = Invoiced_Quantity * Unit_Price
		        visibility = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Tax_Amount
		    (
		        type = formula
		        displayname = "Tax Amount"
		        value = Invoiced_Quantity * Unit_Price * Tax_Rate / 100
		        visibility = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Line_Total
		    (
		        type = formula
		        displayname = "Line Total"
		        value = (Invoiced_Quantity * Unit_Price) + (Invoiced_Quantity * Unit_Price * Tax_Rate / 100)
		        visibility = true
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Invoices
		{
		    title
		    {
		        displayname = "Invoices"
		        on add = "Capture Invoice"
		        on edit = "Edit Invoice"
		    }
		
		    Invoice_Details
		    (
		        type = section
		        displayname = "Invoice Details"
		        row = 1
		        column = 0
		    )
		    must have Invoice_Number
		    (
		        type = text
		        displayname = "Invoice Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Purchase_Order
		    (
		        type = picklist
		        displayname = "Purchase Order"
		        values = Purchase_Requests[Status == "PO Issued" || Status == "Partially Invoiced" || Status == "Match Exception"].ID
		        displayformat = [PO_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Invoice_Date
		    (
		        type = date
		        displayname = "Invoice Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Invoice_File
		    (
		        type = upload file
		        displayname = "Invoice File"
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Invoice_Lines_Section
		    (
		        type = section
		        displayname = "Invoice Lines"
		        visibility = false
		        row = 2
		        column = 1
		    )
		    must have Invoice_Lines
		    (
		        type = grid
		        displayname = "Invoice Lines"
		        values = Invoice_Lines.ID
		        defaultrow = 1
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Amounts
		    (
		        type = section
		        displayname = "Amounts"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Invoice_Subtotal
		    (
		        type = decimal
		        displayname = "Invoice Subtotal"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    Invoice_Tax
		    (
		        type = decimal
		        displayname = "Invoice Tax"
		        decimalplace = 2
		        row = 3
		        column = 2
		        width = medium
		    )
		    Invoice_Total
		    (
		        type = decimal
		        displayname = "Invoice Total"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Match_Result
		    (
		        type = section
		        displayname = "Match Result"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    must have Match_Status
		    (
		        type = picklist
		        displayname = "Match Status"
		        values = {"Pending Match","Matched","Partial Match","Exception"}
		        initial value = "Pending Match"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Amount_Variance
		    (
		        type = decimal
		        displayname = "Amount Variance"
		        decimalplace = 2
		        row = 4
		        column = 2
		        width = medium
		    )
		    Exception_Details
		    (
		        type = textarea
		        displayname = "Exception Details"
		        height = 100px
		        row = 4
		        column = 1
		        width = medium
		    )
		    Matched_On
		    (
		        type = date
		        displayname = "Matched On"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Matched_By
		    (
		        type = users
		        displayname = "Matched By"
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Purchase_Request_Lines
		{
		    displayname = "Purchase Request Lines"
		
		    Line_Details
		    (
		        type = section
		        displayname = "Line Details"
		        row = 1
		        column = 0
		    )
		    must have Catalog_Item
		    (
		        type = picklist
		        displayname = "Catalog Item"
		        values = Vendor_Items.ID
		        displayformat = [Item_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Item_Description
		    (
		        type = textarea
		        displayname = "Item Description"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Quantity
		    (
		        type = decimal
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Unit_Of_Measure
		    (
		        type = text
		        displayname = "Unit Of Measure"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Unit_Price
		    (
		        type = decimal
		        displayname = "Unit Price"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Tax_Rate
		    (
		        type = decimal
		        displayname = "Tax Rate"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Line_Subtotal
		    (
		        type = formula
		        displayname = "Line Subtotal"
		        value = Quantity * Unit_Price
		        visibility = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Tax_Amount
		    (
		        type = formula
		        displayname = "Tax Amount"
		        value = Quantity * Unit_Price * Tax_Rate / 100
		        visibility = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Line_Total
		    (
		        type = formula
		        displayname = "Line Total"
		        value = Quantity * Unit_Price + Quantity * Unit_Price * Tax_Rate / 100
		        visibility = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Purchase_Requests
		{
		    record owner = Added_User
		
		    Request_Details
		    (
		        type = section
		        displayname = "Request Details"
		        row = 1
		        column = 0
		    )
		    Request_Number
		    (
		        type = autonumber
		        displayname = "Request Number"
		        start index = 10000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Requester
		    (
		        type = users
		        displayname = "Requester"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Department
		    (
		        type = text
		        displayname = "Department"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Request_Date
		    (
		        type = date
		        displayname = "Request Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Needed_By
		    (
		        type = date
		        displayname = "Needed By"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Assigned_Approver
		    (
		        type = users
		        displayname = "Assigned Approver"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Business_Justification
		    (
		        type = textarea
		        displayname = "Business Justification"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Quote_Attachment
		    (
		        type = upload file
		        displayname = "Quote Attachment"
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Requested_Items_Section
		    (
		        type = section
		        displayname = "Requested Items"
		        visibility = false
		        row = 2
		        column = 1
		    )
		    must have Requested_Items
		    (
		        type = grid
		        displayname = "Requested Items"
		        values = Purchase_Request_Lines.ID
		        defaultrow = 1
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Financial_Summary
		    (
		        type = section
		        displayname = "Financial Summary"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Subtotal
		    (
		        type = decimal
		        displayname = "Subtotal"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    Tax_Total
		    (
		        type = decimal
		        displayname = "Tax Total"
		        decimalplace = 2
		        row = 3
		        column = 2
		        width = medium
		    )
		    Request_Total
		    (
		        type = decimal
		        displayname = "Request Total"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Workflow_Details
		    (
		        type = section
		        displayname = "Workflow Details"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Draft","Pending Manager Approval","Pending Finance Approval","Rejected","PO Issued","Partially Invoiced","Matched","Match Exception"}
		        initial value = "Draft"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Rejection_Reason
		    (
		        type = textarea
		        displayname = "Rejection Reason"
		        height = 100px
		        row = 4
		        column = 2
		        width = medium
		    )
		    unique PO_Number
		    (
		        type = text
		        displayname = "PO Number"
		        row = 4
		        column = 1
		        width = medium
		    )
		    PO_Date
		    (
		        type = date
		        displayname = "PO Date"
		        row = 4
		        column = 2
		        width = medium
		    )
		    PO_Total
		    (
		        type = decimal
		        displayname = "PO Total"
		        decimalplace = 2
		        row = 4
		        column = 1
		        width = medium
		    )
		    Invoiced_Total
		    (
		        type = decimal
		        displayname = "Invoiced Total"
		        decimalplace = 2
		        initial value = 0
		        row = 4
		        column = 2
		        width = medium
		    )
		    Remaining_To_Invoice
		    (
		        type = decimal
		        displayname = "Remaining To Invoice"
		        decimalplace = 2
		        row = 4
		        column = 1
		        width = medium
		    )
		    Last_Match_Date
		    (
		        type = date
		        displayname = "Last Match Date"
		        row = 4
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Save Draft"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
		    blueprint components
		    {
		        stages = {"Draft","Pending Manager Approval","Pending Finance Approval","Rejected","PO Issued","Partially Invoiced","Matched","Match Exception"}
		    }
		}

		form Vendor_Items
		{
		    Item_Details
		    (
		        type = section
		        displayname = "Item Details"
		        row = 1
		        column = 0
		    )
		    must have unique Item_Code
		    (
		        type = text
		        displayname = "Item Code"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Item_Name
		    (
		        type = text
		        displayname = "Item Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Item_Description
		    (
		        type = textarea
		        displayname = "Item Description"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Unit_Of_Measure
		    (
		        type = picklist
		        displayname = "Unit Of Measure"
		        values = {"Each", "Box", "Pack", "Case", "Hour", "Day", "Month"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Unit_Price
		    (
		        type = decimal
		        displayname = "Unit Price"
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    Tax_Rate
		    (
		        type = decimal
		        displayname = "Tax Rate"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Effective_From
		    (
		        type = date
		        displayname = "Effective From"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Effective_To
		    (
		        type = date
		        displayname = "Effective To"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Vendors
		{
		    Vendor_Details
		    (
		        type = section
		        displayname = "Vendor Details"
		        row = 1
		        column = 0
		    )
		    Vendor_ID
		    (
		        type = autonumber
		        displayname = "Vendor ID"
		        start index = 1000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Vendor_Name
		    (
		        type = text
		        displayname = "Vendor Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Tax_Registration_Number
		    (
		        type = text
		        displayname = "Tax Registration Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contact_Name
		    (
		        type = text
		        displayname = "Contact Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Payment_Terms
		    (
		        type = picklist
		        displayname = "Payment Terms"
		        values = {"Net 15", "Net 30", "Net 45", "Net 60", "Due on Receipt"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Currency
		    (
		        type = picklist
		        displayname = "Currency"
		        values = {"USD", "EUR", "GBP", "INR", "CAD", "AUD"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list Audit_Trail
		{
		    displayName = "Audit Trail"
		    show all rows from Audit_Log
		    (
		        Event_Time as "Event Time"
		        User_Email as "User"
		        User_Profile as "Profile"
		        Action
		        Component
		        Reference_Number as "Reference"
		        Notes
		    )
		    sort by
		    (
		        Event_Time descending
		    )
		}

		default list Invoice_Line_Register
		{
		    displayName = "Invoice Line Register"
		    show all rows from Invoice_Lines
		    (
		        Catalog_Item
		        Invoiced_Quantity
		        Unit_Price
		        Tax_Rate
		        Line_Subtotal
		        Tax_Amount
		        Line_Total
		    )
		}

		default list Invoice_Register
		{
		    displayName = "Invoice Register"
		    show all rows from Invoices
		    (
		        Invoice_Number
		        Purchase_Order
		        Vendor
		        Invoice_Date
		        Due_Date
		        Invoice_Total
		        Match_Status
		        Amount_Variance
		    )
		    filters
		    (
		        Vendor
		        Match_Status
		        Invoice_Date
		    )
		    sort by
		    (
		        Invoice_Date descending
		    )
		}

		list Match_Exceptions
		{
		    displayName = "Match Exceptions"
		    show all rows from Invoices [Match_Status == "Exception"]
		    (
		        Invoice_Number
		        Purchase_Order
		        Vendor
		        Invoice_Date
		        Due_Date
		        Invoice_Total
		        Match_Status
		        Amount_Variance
		        Exception_Details
		    )
		    filters
		    (
		        Vendor
		        Invoice_Date
		    )
		    sort by
		    (
		        Invoice_Date descending
		    )
		}

		list Unpaid_or_Open_Invoices
		{
		    displayName = "Unpaid or Open Invoices"
		    show all rows from Invoices [Match_Status == "Partial Match" || Match_Status == "Exception" || Match_Status == "Pending Match"]
		    (
		        Invoice_Number
		        Purchase_Order
		        Vendor
		        Invoice_Date
		        Due_Date
		        Invoice_Total
		        Match_Status
		        Amount_Variance
		    )
		    filters
		    (
		        Vendor
		        Match_Status
		        Due_Date
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		default list Purchase_Request_Line_Register
		{
		    displayName = "Purchase Request Line Register"
		    show all rows from Purchase_Request_Lines
		    (
		        Catalog_Item
		        Quantity
		        Unit_Of_Measure
		        Unit_Price
		        Tax_Rate
		        Line_Subtotal
		        Tax_Amount
		        Line_Total
		    )
		}

		list Finance_Approval_Queue
		{
		    displayName = "Finance Approval Queue"
		    show all rows from Purchase_Requests [Status == "Pending Finance Approval"]
		    (
		        Request_Number
		        Requester
		        Request_Date
		        Vendor
		        Request_Total
		        Needed_By
		        Status
		    )
		    filters
		    (
		        Vendor
		        Status
		    )
		    sort by
		    (
		        Needed_By ascending
		    )
		    conditional formatting
		    (
		        "Pending Finance Approval"
		        {
		            condition = (Status == "Pending Finance Approval")
		            fields = [Request_Number, Request_Total, Status]
		            format = "background-color:#FFF7E0;color:#8A5700"
		        }
		    )
		}

		default list My_Purchase_Requests
		{
		    displayName = "My Purchase Requests"
		    show all rows from Purchase_Requests [Added_User == zoho.loginuser]
		    (
		        Request_Number
		        Request_Date
		        Vendor
		        Request_Total
		        Needed_By
		        Status
		        PO_Number
		    )
		    filters
		    (
		        Status
		        Vendor
		    )
		    sort by
		    (
		        Request_Date descending
		    )
		    conditional formatting
		    (
		        "Rejected"
		        {
		            condition = (Status == "Rejected")
		            fields = [Request_Number, Status]
		            format = "background-color:#FDE8E8;color:#B42318"
		        }
		        "Match Exception"
		        {
		            condition = (Status == "Match Exception")
		            fields = [Request_Number, Status]
		            format = "background-color:#FFF1F0;color:#C62828;font-weight:bold"
		        }
		        "Pending"
		        {
		            condition = (Status == "Pending Manager Approval" || Status == "Pending Finance Approval")
		            fields = [Request_Number, Status]
		            format = "background-color:#FFF7E0;color:#8A5700"
		        }
		        "Matched"
		        {
		            condition = (Status == "Matched")
		            fields = [Request_Number, Status]
		            format = "background-color:#E7F6EC;color:#137333"
		        }
		    )
		}

		list Purchase_Approval_Queue
		{
		    displayName = "Purchase Approval Queue"
		    show all rows from Purchase_Requests [Status == "Pending Manager Approval"]
		    (
		        Request_Number
		        Requester
		        Request_Date
		        Vendor
		        Request_Total
		        Needed_By
		        Assigned_Approver
		        Status
		    )
		    filters
		    (
		        Assigned_Approver
		        Vendor
		        Status
		    )
		    sort by
		    (
		        Needed_By ascending
		    )
		    conditional formatting
		    (
		        "Pending Manager Approval"
		        {
		            condition = (Status == "Pending Manager Approval")
		            fields = [Request_Number, Needed_By, Status]
		            format = "background-color:#FFF7E0;color:#8A5700"
		        }
		    )
		}

		list Purchase_Order_Register
		{
		    displayName = "Purchase Order Register"
		    show all rows from Purchase_Requests [PO_Number is not null]
		    (
		        PO_Number
		        PO_Date
		        Vendor
		        PO_Total
		        Invoiced_Total
		        Remaining_To_Invoice
		        Status
		    )
		    filters
		    (
		        Vendor
		        Status
		        PO_Date
		    )
		    sort by
		    (
		        PO_Date descending
		    )
		    conditional formatting
		    (
		        "Match Exception"
		        {
		            condition = (Status == "Match Exception")
		            fields = [PO_Number, Remaining_To_Invoice, Status]
		            format = "background-color:#FFF1F0;color:#C62828;font-weight:bold"
		        }
		        "Matched"
		        {
		            condition = (Status == "Matched")
		            fields = [PO_Number, Remaining_To_Invoice, Status]
		            format = "background-color:#E7F6EC;color:#137333"
		        }
		        "Pending Invoice"
		        {
		            condition = (Status == "PO Issued" || Status == "Partially Invoiced")
		            fields = [PO_Number, Remaining_To_Invoice, Status]
		            format = "background-color:#FFF7E0;color:#8A5700"
		        }
		    )
		}

		kanban Purchase_Request_Board
		{
		    displayName = "Purchase Request Board"
		    show all rows from Purchase_Requests
		    (
		        Request_Number
		        Requester
		        Vendor
		        Request_Total
		        Needed_By
		        Assigned_Approver
		        Status
		    )
		    filters
		    (
		        Vendor
		        Assigned_Approver
		        Status
		    )
		    sort by
		    (
		        Needed_By ascending
		    )
		    options
		    (
		        display field = Status
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		    conditional formatting
		    (
		        "Rejected"
		        {
		            condition = (Status == "Rejected")
		            fields = [Request_Number, Status]
		            format = "background-color:#FDE8E8;color:#B42318"
		        }
		        "Match Exception"
		        {
		            condition = (Status == "Match Exception")
		            fields = [Request_Number, Status]
		            format = "background-color:#FFF1F0;color:#C62828;font-weight:bold"
		        }
		        "Pending"
		        {
		            condition = (Status == "Pending Manager Approval" || Status == "Pending Finance Approval")
		            fields = [Request_Number, Status]
		            format = "background-color:#FFF7E0;color:#7A4D00"
		        }
		        "Matched"
		        {
		            condition = (Status == "Matched")
		            fields = [Request_Number, Status]
		            format = "background-color:#E7F6EC;color:#137333"
		        }
		    )
		}

		spreadsheet Catalog_Price_Maintenance
		{
		    displayName = "Catalog Price Maintenance"
		    show all rows from Vendor_Items
		    (
		        Item_Code
		        Vendor
		        Item_Name
		        Item_Description
		        Unit_Of_Measure
		        Unit_Price
		        Tax_Rate
		        Active
		        Effective_From
		        Effective_To
		    )
		    filters
		    (
		        Vendor
		        Active
		    )
		    sort by
		    (
		        Vendor ascending
		        Item_Name ascending
		    )
		}

