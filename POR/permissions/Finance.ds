"Finance"
{
    name = "Finance"
    type = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Finance controls PO issuance, invoice capture and matching, reporting, and audit review without financial-record deletion."

    ModulePermissions
    {
        Vendors
        {
            enabled = Viewall,View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                All_Vendors={"View"}
                Active_Vendors={"View"}
            }
            FieldPermissions
            {
                Vendor_ID{visibility:true,readonly:true}
