"Employee"
{
    name = "Employee"
    type = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Employees create and maintain only their own draft purchase requests and use approved lookup data."

    ModulePermissions
    {
        Vendors
        {
            enabled = View,Search
            allFieldsVisible = false
            ReportPermissions
            {
                Active_Vendors={"View"}
            }
            FieldPermissions
            {
                Vendor_ID{visibility:true,readonly:true}
                Vendor_Name{visibility:true,readonly:true}
                Tax_Registration_Number{visibility:true,readonly:true}
                Contact_Name{visibility:true,readonly:true}
                Contact_Email{visibility:true,readonly:true}
                Contact_Phone{visibility:true,readonly:true}
                Payment_Terms{visibility:true,readonly:true}
                Currency{visibility:true,readonly:true}
                Active{visibility:true,readonly:true}
                Notes{visibility:false}
            }
        }
        Vendor_Items
        {
            enabled = View,Search
            allFieldsVisible = false
            ReportPermissions
            {
                Vendor_Catalog={"View"}
            }
            FieldPermissions
            {
                Item_Code{visibility:true,readonly:true}
                Vendor{visibility:true,readonly:true}
                Item_Name{visibility:true,readonly:true}
                Item_Description{visibility:true,readonly:true}
                Unit_Of_Measure{visibility:true,readonly:true}
                Unit_Price{visibility:true,readonly:true}
                Tax_Rate{visibility:true,readonly:true}
                Active{visibility:true,readonly:true}
                Effective_From{visibility:true,readonly:true}
                Effective_To{visibility:true,readonly:true}
            }
        }
        Purchase_Requests
        {
            enabled = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                My_Purchase_Requests={"View","Edit"}
            }
            FieldPermissions
            {
                Request_Number{visibility:true,readonly:true}
                Requester{visibility:true,readonly:true}
                Department{visibility:true,readonly:false}
                Request_Date{visibility:true,readonly:false}
                Needed_By{visibility:true,readonly:false}
                Vendor{visibility:true,readonly:false}
                Assigned_Approver{visibility:true,readonly:false}
                Business_Justification{visibility:true,readonly:false}
                Quote_Attachment{visibility:true,readonly:false}
                Requested_Items{visibility:true,readonly:false}
                Subtotal{visibility:true,readonly:true}
                Tax_Total{visibility:true,readonly:true}
                Request_Total{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Rejection_Reason{visibility:true,readonly:true}
                PO_Number{visibility:true,readonly:true}
                PO_Date{visibility:true,readonly:true}
                PO_Total{visibility:true,readonly:true}
                Invoiced_Total{visibility:true,readonly:true}
                Remaining_To_Invoice{visibility:true,readonly:true}
                Last_Match_Date{visibility:true,readonly:true}
            }
        }
    }
}
