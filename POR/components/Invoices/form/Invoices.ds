form Invoices
{
    title
    {
        displayname = "Invoices"
        on add = "Capture Invoice"
        on edit = "Edit Invoice"
    }

    Invoice_Details
    (
        type = section
        displayname = "Invoice Details"
        row = 1
        column = 0
    )
    must have Invoice_Number
    (
        type = text
        displayname = "Invoice Number"
        row = 1
        column = 1
        width = medium
    )
    must have Purchase_Order
    (
        type = picklist
        displayname = "Purchase Order"
        values = Purchase_Requests[Status == "PO Issued" || Status == "Partially Invoiced" || Status == "Match Exception"].ID
        displayformat = [PO_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Invoice_Date
    (
        type = date
        displayname = "Invoice Date"
        row = 1
        column = 2
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )
    must have Invoice_File
    (
        type = upload file
        displayname = "Invoice File"
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 2
        width = medium
    )

    Invoice_Lines_Section
    (
        type = section
        displayname = "Invoice Lines"
        visibility = false
        row = 2
        column = 1
    )
    must have Invoice_Lines
    (
        type = grid
        displayname = "Invoice Lines"
        values = Invoice_Lines.ID
        defaultrow = 1
        row = 2
        column = 1
        width = medium
    )

    Amounts
    (
        type = section
        displayname = "Amounts"
        visibility = true
        row = 3
        column = 1
    )
    Invoice_Subtotal
    (
        type = decimal
        displayname = "Invoice Subtotal"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Invoice_Tax
    (
        type = decimal
        displayname = "Invoice Tax"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    Invoice_Total
    (
        type = decimal
        displayname = "Invoice Total"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )

    Match_Result
    (
        type = section
        displayname = "Match Result"
        visibility = true
        row = 4
        column = 1
    )
    must have Match_Status
    (
        type = picklist
        displayname = "Match Status"
        values = {"Pending Match","Matched","Partial Match","Exception"}
        initial value = "Pending Match"
        row = 4
        column = 1
        width = medium
    )
    Amount_Variance
    (
        type = decimal
        displayname = "Amount Variance"
        decimalplace = 2
        row = 4
        column = 2
        width = medium
    )
    Exception_Details
    (
        type = textarea
        displayname = "Exception Details"
        height = 100px
        row = 4
        column = 1
        width = medium
    )
    Matched_On
    (
        type = date
        displayname = "Matched On"
        row = 4
        column = 2
        width = medium
    )
    Matched_By
    (
        type = users
        displayname = "Matched By"
        row = 4
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
