form Invoice_Lines
{
    title
    {
        displayname = "Invoice Lines"
        on add = "Add Invoice Line"
        on edit = "Edit Invoice Line"
    }

    Invoice_Line_Details
    (
        type = section
        displayname = "Invoice Line Details"
        row = 1
        column = 0
    )
    must have Catalog_Item
    (
        type = picklist
        displayname = "Catalog Item"
        values = Vendor_Items.ID
        displayformat = [Item_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        row = 1
        column = 2
        width = medium
    )
    must have Invoiced_Quantity
    (
        type = decimal
        displayname = "Invoiced Quantity"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    must have Unit_Price
    (
        type = decimal
        displayname = "Unit Price"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Tax_Rate
    (
        type = decimal
        displayname = "Tax Rate"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Line_Subtotal
    (
        type = formula
        displayname = "Line Subtotal"
        value = Invoiced_Quantity * Unit_Price
        visibility = true
        row = 1
        column = 2
        width = medium
    )
    Tax_Amount
    (
        type = formula
        displayname = "Tax Amount"
        value = Invoiced_Quantity * Unit_Price * Tax_Rate / 100
        visibility = true
        row = 1
        column = 1
        width = medium
    )
    Line_Total
    (
        type = formula
        displayname = "Line Total"
        value = (Invoiced_Quantity * Unit_Price) + (Invoiced_Quantity * Unit_Price * Tax_Rate / 100)
        visibility = true
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
