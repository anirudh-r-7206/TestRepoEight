Invoice_Line_Catalog_Item_On_User_Input as "Invoice Line Catalog Item On User Input"
{
    type = form
    form = Invoice_Lines
    record event = on add or edit

    on user input of Catalog_Item
    {
        actions
        {
            custom deluge script
            (
                if(input.Catalog_Item != null)
                {
                    catalog_item = Vendor_Items[ID == input.Catalog_Item];
                    input.Description = catalog_item.Item_Description;
                    input.Unit_Price = catalog_item.Unit_Price;
                    input.Tax_Rate = ifNull(catalog_item.Tax_Rate, 0);
                }
            )
        }
    }
}
