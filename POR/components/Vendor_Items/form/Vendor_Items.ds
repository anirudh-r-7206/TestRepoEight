form Vendor_Items
{
    Item_Details
    (
        type = section
        displayname = "Item Details"
        row = 1
        column = 0
    )
    must have unique Item_Code
    (
        type = text
        displayname = "Item Code"
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Item_Name
    (
        type = text
        displayname = "Item Name"
        row = 1
        column = 1
        width = medium
    )
    Item_Description
    (
        type = textarea
        displayname = "Item Description"
        row = 1
        column = 2
        width = medium
    )
    must have Unit_Of_Measure
    (
        type = picklist
        displayname = "Unit Of Measure"
        values = {"Each", "Box", "Pack", "Case", "Hour", "Day", "Month"}
        row = 1
        column = 1
        width = medium
    )
    must have Unit_Price
    (
        type = decimal
        displayname = "Unit Price"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Tax_Rate
    (
        type = decimal
        displayname = "Tax Rate"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Effective_From
    (
        type = date
        displayname = "Effective From"
        row = 1
        column = 1
        width = medium
    )
    Effective_To
    (
        type = date
        displayname = "Effective To"
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
