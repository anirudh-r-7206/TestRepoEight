application "Simple-To-Do"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Tasks
		{
		    success message = "Task saved successfully."
		
		    Task_Details
		    (
		        type = section
		        displayname = "Task Details"
		        row = 1
		        column = 0
		    )
		    must have Title
		    (
		        type = text
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Priority
		    (
		        type = picklist
		        values = {"Low", "Medium", "High"}
		        initial value = "Medium"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"To Do", "In Progress", "Done"}
		        initial value = "To Do"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Tasks
		{
		    displayName = "All Tasks"
		    show all rows from Tasks
		    (
		        Title
		        Priority
		        Status
		        Due_Date
		        Description
		    )
		    filters
		    (
		        Priority
		        Status
		        Due_Date
		    )
		    sort by
		    (
		        Due_Date ascending
		        Priority descending
		    )
		}

		kanban Task_Board
		{
		    displayName = "Task Board"
		    show all rows from Tasks
		    (
		        Title
		        Priority
		        Status
		        Due_Date
		        Description
		    )
		    filters
		    (
		        Priority
		        Status
		        Due_Date
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		    options
		    (
		        display field = Status
		        filter type = manual
		        sort order = ascending
		        record count = enable
		    )
		}
	}

	pages
	{
		page To_Do_Overview
		{
					displayname = "To-Do Overview"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Overview' elementName='Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Overview()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttotalTasks = Tasks.count();\n\ttoDoTasks = Tasks[Status == &quot;To Do&quot;].count();\n\tinProgressTasks = Tasks[Status == &quot;In Progress&quot;].count();\n\tdoneTasks = Tasks[Status == &quot;Done&quot;].count();\n\toverdueTasks = Tasks[Status != &quot;Done&quot; &amp;&amp; Due_Date != null &amp;&amp; Due_Date &lt; zoho.currentdate].count();\n\tlowPriority = Tasks[Priority == &quot;Low&quot;].count();\n\tmediumPriority = Tasks[Priority == &quot;Medium&quot;].count();\n\thighPriority = Tasks[Priority == &quot;High&quot;].count();\n\tcompletionPercent = 0;\n\tif(totalTasks &gt; 0)\n\t{\n\t\tcompletionPercent = ((doneTasks * 100.0) / totalTasks).round(0);\n\t}\n\tupcomingTasks = Tasks[Status != &quot;Done&quot;] sort by Due_Date asc range from 1 to 8;\n%&gt;\n&lt;style&gt;\n:root {\n\t--zcs-bg: var(--zcs_page_bg_color, #f5f6f8);\n\t--zcs-surface: var(--zcs_component_bg_color, #ffffff);\n\t--zcs-text-1: var(--zcs_primary_text_color, #1f2937);\n\t--zcs-text-2: var(--zcs_secondary_text_color, #667085);\n\t--zcs-text-3: var(--zcs_tertiary_text_color, #98a2b3);\n\t--zcs-border: var(--zcs_tertiary_border_color, #e4e7ec);\n\t--zcs-radius: 12px;\n\t--zcs-shadow: 0 1px 3px rgba(16,24,40,.08), 0 1px 2px rgba(16,24,40,.04);\n\t--zcs-green: #067647; --zcs-green-bg: #ecfdf3;\n\t--zcs-red: #b42318; --zcs-red-bg: #fef3f2;\n\t--zcs-orange: #b54708; --zcs-orange-bg: #fffaeb;\n\t--zcs-blue: #175cd3; --zcs-blue-bg: #eff8ff;\n}\n* { box-sizing: border-box; }\n.zcs-page { font-family: var(--zcs-font, Arial, sans-serif); background: var(--zcs-bg); min-height: 100vh; padding: 24px; color: var(--zcs-text-1); }\n.zcs-page-header { margin-bottom: 24px; }\n.zcs-page-header__title { font-size: 22px; font-weight: 600; color: var(--zcs-text-1); margin: 0 0 4px; }\n.zcs-page-header__sub { font-size: 14px; color: var(--zcs-text-2); margin: 0; }\n.zcs-kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px; }\n.zcs-kpi-card { background: var(--zcs-surface); border: 1px solid var(--zcs-border); border-radius: var(--zcs-radius); box-shadow: var(--zcs-shadow); padding: 20px 22px; min-width: 0; }\n.zcs-kpi-card__top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }\n.zcs-kpi-card__icon { color: var(--zcs_brand_color, #4263eb); font-size: 20px; }\n.zcs-kpi-card__label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .6px; color: var(--zcs-text-2); }\n.zcs-kpi-card__value { font-size: 32px; font-weight: 700; margin: 8px 0 4px; line-height: 1; color: var(--zcs-text-1); }\n.zcs-kpi-card__sub { font-size: 12px; color: var(--zcs-text-3); }\n.zcs-kpi-card--danger .zcs-kpi-card__value, .zcs-kpi-card--danger .zcs-kpi-card__icon { color: var(--zcs-red); }\n.zcs-kpi-card--success .zcs-kpi-card__value, .zcs-kpi-card--success .zcs-kpi-card__icon { color: var(--zcs-green); }\n.overview-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); gap: 16px; margin-bottom: 8px; }\n.zcs-section { background: var(--zcs-surface); border: 1px solid var(--zcs-border); border-radius: var(--zcs-radius); box-shadow: var(--zcs-shadow); padding: 20px 24px; margin-bottom: 16px; }\n.zcs-section__heading { font-size: 15px; font-weight: 600; color: var(--zcs-text-1); margin: 0 0 6px; }\n.section-sub { color: var(--zcs-text-3); font-size: 12px; margin: 0 0 18px; }\n.progress-summary { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 12px; }\n.progress-value { font-size: 28px; font-weight: 700; color: var(--zcs-text-1); }\n.progress-copy { font-size: 13px; color: var(--zcs-text-2); }\n.zcs-progress-bar { height: 10px; overflow: hidden; background-color: var(--zcs_component_hover_color, #eaecf0); border-radius: 6px; }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color, #4263eb); }\n.priority-list { display: grid; gap: 14px; }\n.priority-row { display: grid; grid-template-columns: 92px 1fr 36px; align-items: center; gap: 12px; font-size: 13px; }\n.priority-label { display: flex; align-items: center; gap: 8px; color: var(--zcs-text-2); }\n.priority-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--zcs-blue); }\n.priority-row--medium .priority-dot, .priority-row--medium .priority-fill { background: #f79009; }\n.priority-row--high .priority-dot, .priority-row--high .priority-fill { background: #f04438; }\n.priority-track { height: 7px; overflow: hidden; border-radius: 5px; background: #eaecf0; }\n.priority-fill { height: 100%; background: var(--zcs-blue); border-radius: inherit; }\n.priority-count { text-align: right; font-weight: 600; color: var(--zcs-text-1); }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border); background: var(--zcs-surface); border-radius: 8px; overflow: auto; }\n.zcs-table-wrapper table { width: 100%; min-width: 620px; border-collapse: collapse; }\n.zcs-table-wrapper th { padding: 10px 16px; background: #f9fafe; border-bottom: 1px solid var(--zcs-border); color: var(--zcs-text-2); font-size: 12px; font-weight: 600; text-align: left; white-space: nowrap; }\n.zcs-table-wrapper td { padding: 12px 16px; border-top: 1px solid var(--zcs-border); color: var(--zcs-text-1); font-size: 13px; text-align: left; }\n.zcs-table-wrapper tbody tr:first-child td { border-top: 0; }\n.zcs-table-wrapper tbody tr:hover td { background: #f9fafe; }\n.task-title { font-weight: 600; max-width: 420px; }\n.due-overdue { color: var(--zcs-red); font-weight: 600; }\n.zcs-badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 20px; line-height: 1.4; white-space: nowrap; }\n.zcs-badge--success { background: var(--zcs-green-bg); color: var(--zcs-green); }\n.zcs-badge--danger { background: var(--zcs-red-bg); color: var(--zcs-red); }\n.zcs-badge--warning { background: var(--zcs-orange-bg); color: var(--zcs-orange); }\n.zcs-badge--info { background: var(--zcs-blue-bg); color: var(--zcs-blue); }\n.zcs-badge--neutral { background: #f3f4f6; color: var(--zcs-text-2); }\n.zcs-empty-state { text-align: center; padding: 40px 24px; }\n.zcs-empty-state i { display: block; margin-bottom: 10px; font-size: 26px; color: var(--zcs-text-3); }\n.zcs-empty-state__title { font-size: 16px; font-weight: 600; color: var(--zcs-text-2); margin: 0 0 6px; }\n.zcs-empty-state__body { font-size: 14px; color: var(--zcs-text-3); }\n@media (max-width: 1100px) { .zcs-kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n@media (max-width: 760px) { .zcs-page { padding: 16px; } .zcs-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .overview-grid { grid-template-columns: 1fr; } }\n@media (max-width: 460px) { .zcs-kpi-grid { grid-template-columns: 1fr; } .zcs-section, .zcs-kpi-card { padding: 18px; } .progress-summary { align-items: flex-start; flex-direction: column; gap: 4px; } }\n&lt;/style&gt;\n&lt;div class=&quot;zcs-page&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header&quot;&gt;\n\t\t&lt;h1 class=&quot;zcs-page-header__title&quot;&gt;To-Do Overview&lt;/h1&gt;\n\t\t&lt;p class=&quot;zcs-page-header__sub&quot;&gt;A clear view of workload, progress, priorities, and approaching deadlines.&lt;/p&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;zcs-kpi-grid&quot;&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__top&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Total Tasks&lt;/div&gt;&lt;i class=&quot;zcs-kpi-card__icon zc-li-outline files-3-task-list&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value&quot;&gt;&lt;%=totalTasks%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;All recorded work&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__top&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;To Do&lt;/div&gt;&lt;i class=&quot;zcs-kpi-card__icon zc-li-outline ui-1-circle-add&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value&quot;&gt;&lt;%=toDoTasks%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Ready to begin&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card&quot;&gt;&lt;div class=&quot;zcs-kpi-card__top&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;In Progress&lt;/div&gt;&lt;i class=&quot;zcs-kpi-card__icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value&quot;&gt;&lt;%=inProgressTasks%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Currently active&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card zcs-kpi-card--success&quot;&gt;&lt;div class=&quot;zcs-kpi-card__top&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Done&lt;/div&gt;&lt;i class=&quot;zcs-kpi-card__icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value&quot;&gt;&lt;%=doneTasks%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Completed work&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-kpi-card zcs-kpi-card--danger&quot;&gt;&lt;div class=&quot;zcs-kpi-card__top&quot;&gt;&lt;div class=&quot;zcs-kpi-card__label&quot;&gt;Overdue&lt;/div&gt;&lt;i class=&quot;zcs-kpi-card__icon zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__value&quot;&gt;&lt;%=overdueTasks%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-kpi-card__sub&quot;&gt;Open past due date&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;overview-grid&quot;&gt;\n\t\t&lt;div class=&quot;zcs-section&quot;&gt;\n\t\t\t&lt;h2 class=&quot;zcs-section__heading&quot;&gt;Completion progress&lt;/h2&gt;\n\t\t\t&lt;p class=&quot;section-sub&quot;&gt;Completed tasks compared with all tasks.&lt;/p&gt;\n\t\t\t&lt;div class=&quot;progress-summary&quot;&gt;&lt;span class=&quot;progress-value&quot;&gt;&lt;%=completionPercent%&gt;%&lt;/span&gt;&lt;span class=&quot;progress-copy&quot;&gt;&lt;%=doneTasks%&gt; of &lt;%=totalTasks%&gt; tasks complete&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper&quot;&gt;&lt;div class=&quot;zcs-progress-bar&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=completionPercent%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-section&quot;&gt;\n\t\t\t&lt;h2 class=&quot;zcs-section__heading&quot;&gt;Priority distribution&lt;/h2&gt;\n\t\t\t&lt;p class=&quot;section-sub&quot;&gt;All tasks grouped by urgency.&lt;/p&gt;\n\t\t\t&lt;% if(totalTasks == 0) { %&gt;\n\t\t\t\t&lt;div class=&quot;zcs-empty-state&quot;&gt;&lt;div class=&quot;zcs-empty-state__title&quot;&gt;No priority data yet&lt;/div&gt;&lt;div class=&quot;zcs-empty-state__body&quot;&gt;Priority totals will appear after tasks are added.&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;% } else { %&gt;\n\t\t\t\t&lt;div class=&quot;priority-list&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;priority-row&quot;&gt;&lt;span class=&quot;priority-label&quot;&gt;&lt;span class=&quot;priority-dot&quot;&gt;&lt;/span&gt;Low&lt;/span&gt;&lt;div class=&quot;priority-track&quot;&gt;&lt;div class=&quot;priority-fill&quot; style=&quot;width:&lt;%=((lowPriority * 100.0) / totalTasks).round(0)%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;priority-count&quot;&gt;&lt;%=lowPriority%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;priority-row priority-row--medium&quot;&gt;&lt;span class=&quot;priority-label&quot;&gt;&lt;span class=&quot;priority-dot&quot;&gt;&lt;/span&gt;Medium&lt;/span&gt;&lt;div class=&quot;priority-track&quot;&gt;&lt;div class=&quot;priority-fill&quot; style=&quot;width:&lt;%=((mediumPriority * 100.0) / totalTasks).round(0)%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;priority-count&quot;&gt;&lt;%=mediumPriority%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;priority-row priority-row--high&quot;&gt;&lt;span class=&quot;priority-label&quot;&gt;&lt;span class=&quot;priority-dot&quot;&gt;&lt;/span&gt;High&lt;/span&gt;&lt;div class=&quot;priority-track&quot;&gt;&lt;div class=&quot;priority-fill&quot; style=&quot;width:&lt;%=((highPriority * 100.0) / totalTasks).round(0)%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;priority-count&quot;&gt;&lt;%=highPriority%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;zcs-section&quot;&gt;\n\t\t&lt;h2 class=&quot;zcs-section__heading&quot;&gt;Upcoming tasks&lt;/h2&gt;\n\t\t&lt;p class=&quot;section-sub&quot;&gt;The next open tasks, ordered by due date.&lt;/p&gt;\n\t\t&lt;% if(upcomingTasks.count() == 0) { %&gt;\n\t\t\t&lt;div class=&quot;zcs-empty-state&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-empty-state__title&quot;&gt;No open tasks&lt;/div&gt;&lt;div class=&quot;zcs-empty-state__body&quot;&gt;All tasks are complete, or no tasks have been added yet.&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;% } else { %&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;\n\t\t\t\t&lt;table&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Title&lt;/th&gt;&lt;th&gt;Priority&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Due date&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;% for each task in upcomingTasks { \n\t\t\t\t\t\t\t priorityClass = &quot;zcs-badge--neutral&quot;;\n\t\t\t\t\t\t\t if(task.Priority == &quot;Medium&quot;) { priorityClass = &quot;zcs-badge--warning&quot;; }\n\t\t\t\t\t\t\t if(task.Priority == &quot;High&quot;) { priorityClass = &quot;zcs-badge--danger&quot;; }\n\t\t\t\t\t\t\t statusClass = &quot;zcs-badge--neutral&quot;;\n\t\t\t\t\t\t\t if(task.Status == &quot;In Progress&quot;) { statusClass = &quot;zcs-badge--info&quot;; }\n\t\t\t\t\t\t\t dueText = &quot;No due date&quot;;\n\t\t\t\t\t\t\t dueClass = &quot;&quot;;\n\t\t\t\t\t\t\t if(task.Due_Date != null) {\n\t\t\t\t\t\t\t\t dueText = task.Due_Date.toString(&quot;dd MMM yyyy&quot;);\n\t\t\t\t\t\t\t\t if(task.Due_Date &lt; zoho.currentdate) { dueClass = &quot;due-overdue&quot;; }\n\t\t\t\t\t\t\t }\n\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;task-title&quot;&gt;&lt;%=task.Title%&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&quot;zcs-badge &lt;%=priorityClass%&gt;&quot;&gt;&lt;%=task.Priority%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span class=&quot;zcs-badge &lt;%=statusClass%&gt;&quot;&gt;&lt;%=task.Status%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;&lt;%=dueClass%&gt;&quot;&gt;&lt;%=dueText%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	customize
	{
	    icon
	    {
	        icon = "zc-ab-project-mgmt1"
	        background color = "#5051F9"
	        foreground color = "#ffffff"
	    }
	}

	web
	{
	forms
	{
	    form Tasks
	    {
	        label placement = left
	    }
	}
	reports
	{
		report All_Tasks
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Title
		                    Priority
		                    Status
		                    Due_Date
		                    Description
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Title
		                    Priority
		                    Status
		                    Due_Date
		                    Description
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	
		report Task_Board
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Title
		                    Priority
		                    Status
		                    Due_Date
		                    Description
		                )
		            )
		        )
		        menu
		        (
		            header
