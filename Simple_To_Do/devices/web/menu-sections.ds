menu
{
    space Main_Space
    {
        displayname = "To-Do Workspace"
        icon = "business-agenda"

        section Tasks_Section
        {
            displayname = "Tasks"
            icon = "business-progress"

            page To_Do_Overview
            {
                icon = "business-chart"
            }
            form Tasks
            {
                icon = "files-add"
            }
            report All_Tasks
            {
                icon = "text-list-bullet"
            }
            report Task_Board
            {
                icon = "business-board-27"
            }
        }

        section SharedAnalytics_Section
        {
            type = shared_user_report_section
            displayname = "Reports"
            icon = "business-chart-bar-33"
        }
    }

    preference
    {
        icon
        {
            style = outline
            show = {space,section,component}
        }
    }
}
