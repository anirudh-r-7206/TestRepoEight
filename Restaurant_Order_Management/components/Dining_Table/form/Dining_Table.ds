form Dining_Table
{
	displayname = "Dining Table"
	success message = "Table saved."

	Table_Details
	(
		type = section
		displayname = "Table Details"
		row = 1
		column = 0
	)
	must have unique Table_Number
	(
		type = text
		displayname = "Table Number"
		row = 1
		column = 1
		width = medium
	)
	must have Dining_Area
	(
		type = picklist
		displayname = "Dining Area"
		values = {"Indoor", "Outdoor", "Rooftop", "Private"}
		initial value = "Indoor"
		row = 1
		column = 2
		width = medium
	)
	must have Seats
	(
		type = number
		displayname = "Seats"
		initial value = 4
		row = 1
		column = 1
		width = medium
	)
	must have Status
	(
		type = picklist
		displayname = "Status"
		values = {"Available", "Reserved", "Occupied"}
		initial value = "Available"
		row = 1
		column = 2
		width = medium
	)
	Notes
	(
		type = textarea
		displayname = "Notes"
		row = 1
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}
