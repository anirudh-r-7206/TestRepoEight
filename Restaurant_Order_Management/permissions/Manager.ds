"Manager"
{
	name = "Manager"
	type = Users_Permissions
	permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
	description = "Full access to tables, menu, reservations and orders"
	ModulePermissions
	{
		Dining_Table
		{
			enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
			allFieldsVisible = true
			ReportPermissions
			{
				All_Tables={"View","Edit","Delete"}
				Tables_By_Status={"View","Edit","Delete"}
			}
		}
		Menu_Item
		{
			enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
			allFieldsVisible = true
			ReportPermissions
			{
				All_Menu_Items={"View","Edit","Delete"}
			}
		}
		Table_Reservation
		{
			enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
			allFieldsVisible = true
			ReportPermissions
			{
				All_Reservations={"View","Edit","Delete"}
				Reservation_Calendar={"View","Edit","Delete"}
			}
		}
		Table_Order
		{
			enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
			allFieldsVisible = true
			ReportPermissions
			{
				All_Orders={"View","Edit","Delete"}
				Open_Orders={"View","Edit","Delete"}
			}
		}
		Table_Floor
		{
			enabled = tab
		}
	}
}
