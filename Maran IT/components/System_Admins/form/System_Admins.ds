form System_Admins
{
    title
    {
        displayname = "System Admins"
        on add = "Add System Admin"
        on edit = "Edit System Admin"
    }
    success message = "System administrator saved successfully."

    Admin_Details
    (
        type = section
        displayname = "Admin Details"
        row = 1
        column = 0
    )
    must have Admin_Name
    (
        type = text
        displayname = "Admin Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have unique Email_ID
    (
        type = email
        displayname = "Email ID"
        personal data = true
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
