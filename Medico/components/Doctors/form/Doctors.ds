form Doctors
{
    title
    {
        displayname = "Doctors"
        on add = "Add Doctor"
        on edit = "Edit Doctor"
    }
    success message = "Doctor saved successfully."

    Doctor_Details
    (
        type = section
        displayname = "Doctor Details"
        row = 1
        column = 0
    )
    must have Doctor_Name
    (
        type = text
        displayname = "Doctor Name"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have unique Email_ID
    (
        type = email
        displayname = "Email ID"
        personal data = true
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
