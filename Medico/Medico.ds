application "Medico"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Doctors
		{
		    title
		    {
		        displayname = "Doctors"
		        on add = "Add Doctor"
		        on edit = "Edit Doctor"
		    }
		    success message = "Doctor saved successfully."
		
		    Doctor_Details
		    (
		        type = section
		        displayname = "Doctor Details"
		        row = 1
		        column = 0
		    )
		    must have Doctor_Name
		    (
		        type = text
		        displayname = "Doctor Name"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Email_ID
		    (
		        type = email
		        displayname = "Email ID"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Doctors
		{
		    displayName = "All Doctors"
		    show all rows from Doctors
		    (
		        Doctor_Name
		        Email_ID
		    )
		    filters
		    (
		        Doctor_Name
		        Email_ID
		    )
		    sort by
		    (
		        Doctor_Name ascending
		    )
		}
	}

	customize
	{
	    layout
	    {
	        theme = "theme_10"
	    }
	    icon
	    {
	        icon = "zc-ab-health-doctor"
	        background color = "#00C1C1"
	        foreground color = "#ffffff"
	    }
	}

	web
	{
	forms
	{
	    form Doctors
	    {
	        label placement = top
	    }
	}
	reports
	{
		report All_Doctors
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Doctor_Name
		                    Email_ID
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Doctor_Name
		                    Email_ID
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	}
	menu
	{
	    space Medical_Directory
	    {
	        displayname = "Medical Directory"
	        icon = "health-hospital-33"
	
	        section Doctors_Section
	        {
	            displayname = "Doctors"
	            icon = "health-doctor"
	
	            form Doctors
	            {
	                icon = "users-add-27"
	            }
	            report All_Doctors
	            {
	                icon = "users-contacts"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = solid
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_10"
	    }
	
	    font = "poppins"
	
	    color options
	    {
	        color = "14"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	}
	}
}
